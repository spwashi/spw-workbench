# Signatures Index
#
# Optional style genotypes. Prefer vibes + domains for new work.
# No default brand pack.

#>spw_signatures_index
#:signature #!catalog
#:layer #!pragmatics

^"intent"{
 ~#goal: "Optional named style locks when a project earns one — not required for kitchen craft or PE."
 ~#taste: "empty by default; add signatures only when multi-surface continuity needs a name"
}

^"roots"{
 @vibes: ~"../vibes/index.spw"
 @culinary: ~"../domains/culinary-fantasy/index.spw"
 @tone: ~"../substrate/tone-anatomy.spw"
}

^"law"{
 default: "none — compose #vibe_* and #voice_* instead of a branded signature"
 when_to_add: "asset_refs + multi-organ hold + explicit project name"
}

~<../vibes/index.spw>
~<../domains/culinary-fantasy/index.spw>
