# Facets Index
#
# Temporary tilts of the kitchen vibes — lighter than branches, heavier than a single axis.

#>spw_prompts_facets_index
#:facet #!catalog
#:layer #!creative

^"intent"{
 ~#goal: "Name composable tilts agents can stack onto a branch without forking a new world file."
 ~#taste: "short-lived, measurable, saga-logged"
}

^"roots"{
 @biome: ~"../biome/underroot.spw"
 @vibes: ~"../vibes/index.spw"
}

^"facets"{
 glaze_morning: .{
  id: #glaze_morning
  tilts: ~[honey:0.6, canopy:0.4]
  organ_bias: [#still_life, #exterior]
  lens_bias: [#sensorial, #hand_scale]
 }

 cellar_hush: .{
  id: #cellar_hush
  tilts: ~[mineral:0.5, spore:0.3, biolume:0.2]
  organ_bias: [#interior, #diagram]
  lens_bias: [#loam_memory, #yeast_time]
 }

 thrift_kitchen: .{
  id: #thrift_kitchen
  tilts: ~[rye:0.4, hand:0.4, sparse:0.2]
  organ_bias: [#process, #portrait]
  lens_bias: [#care_duty, #hand_scale]
 }

 open_door_trade: .{
  id: #open_door_trade
  tilts: ~[market:0.5, honey:0.3, crowded:0.2]
  organ_bias: [#exterior, #portrait]
  lens_bias: [#door_law, #sensorial]
 }

 ember_close: .{
  id: #ember_close
  tilts: ~[smoke:0.4, hearth:0.4, layered:0.2]
  organ_bias: [#process, #interior]
  lens_bias: [#yeast_time, #mythic_soft]
 }
}

^"law"{
 facet_vs_branch: "Facet = session tilt. Branch = sustained fork registered on biome."
 max_stack: 2
 saga: ">>mutate — facet: +glaze_morning"
}

~<../biome/underroot.spw>
