# Handles Index
#
# Stable grab-points. Domains and vibes stay separate from PE tone.

#>spw_prompts_handles_index
#:handle #!catalog
#:layer #!pragmatics

^"intent"{
 ~#goal: "Address tone, vibes, culinary-fantasy, publishing, and labs without a brand default."
 ~#taste: "short ids; paths only; vendor-free"
}

^"roots"{
 @substrate: ~"../substrate/index.spw"
 @tone: ~"../substrate/tone-anatomy.spw"
 @compose: ~"../substrate/compose.spw"
 @vibes: ~"../vibes/index.spw"
 @culinary: ~"../domains/culinary-fantasy/index.spw"
 @publishing: ~"../domains/publishing/index.spw"
 @sagas: ~"../sagas/index.spw"
 @mj: ~"../labs/midjourney.spw"
 @film: ~"../production/film.spw"
 @xp: ~"../labs/experiential.spw"
 @contours: ~"../image/index.spw"
}

^"tone_dimensions"{
 #tone_temperature: @tone
 #tone_density: @tone
 #tone_precision: @tone
 #tone_pace: @tone
 #tone_relation: @tone
 #tone_material: @tone
 #tone_structure: @tone
 #tone_authority: @tone
}

^"voice_registers"{
 #voice_patient_precise: @tone
 #voice_hospitable_craft: @tone
 #voice_kinetic_clear: @tone
 #voice_braided_relation: @tone
 #voice_web_quiet: @tone
}

^"vibes"{
 #vibe_baking: ~"../vibes/baking.spw"
 #vibe_forest: ~"../vibes/forest.spw"
 #vibe_hearth: ~"../vibes/hearth.spw"
 #vibe_market: ~"../vibes/market.spw"
 #vibe_mineral: ~"../vibes/mineral.spw"
}

^"domains"{
 #culinary_fantasy: @culinary
 #publishing: @publishing
 #pub_house: ~"../domains/publishing/templates/house.spw"
 #pub_title: ~"../domains/publishing/templates/title.spw"
 #pub_job: ~"../domains/publishing/templates/job.spw"
}

^"sagas"{
 #saga: @sagas
 #saga_schema: ~"../sagas/schema.spw"
 #saga_macros: ~"../sagas/macros.spw"
 #saga_fractal: ~"../sagas/fractal.spw"
 #saga_optimize: ~"../sagas/optimize.spw"
 #saga_profiles: ~"../sagas/profiles.spw"
 #fractal_merge: "& => {&}"
}

^"substrate"{
 #pe_substrate: @substrate
 #positive_ground: @substrate
 #compose_path: @compose
}

^"image_organs"{
 #portrait: ~"../image/portrait.prompt.spw"
 #interior: ~"../image/interior.prompt.spw"
 #still_life: ~"../image/still-life.prompt.spw"
 #exterior: ~"../image/exterior.prompt.spw"
 #process: ~"../image/process.prompt.spw"
 #diagram: ~"../image/diagram.prompt.spw"
 #sheet: ~"../image/sheet.prompt.spw"
}

^"film"{
 #camera: @film
 #lighting: @film
 #production_design: @film
 #costume: @film
 #sound_design: @film
 #editorial: @film
 #vfx_soft: @film
 #direction: @film
}

^"mj_lab"{
 #phrase_lock: @mj
 #pack_build: @mj
 #neg_bank: @mj
 #param_grid: @mj
 #sref_pipeline: @mj
 #cref_pipeline: @mj
 #ablation: @mj
}

^"law"{
 resolve: "handle → path → frame"
 vendor_free: "no product or engine names in handles"
 vibe_non_bleed: "forest/mushroom life does not auto-spoil baking materials"
}

~<../vibes/index.spw>
~<../substrate/index.spw>
