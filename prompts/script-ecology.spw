# Script Ecology & Anatomy
#
# How prompt surfaces live as a local reference ecology — organs, tissue,
# circulation, mutation sagas. Spw operators are the physiology.

#>spw_prompts_script_ecology
#:prompt #!ecology
#:layer #!pragmatics
#:status #!active

^"intent"{
 ~#goal: "Name the anatomy of the prompt corpus so agents navigate by local refs and evolve style via mutation sagas, not free rewrite."
 ~#taste: "literate physiology — roots, organs, stream, measure"
 ~#status: "active"
}

^"roots"{
 @index: ~"./index.spw"
 @biome: ~"./biome/underroot.spw"
 @metaphysics: ~"./metaphysics/index.spw"
 @signatures: ~"./signatures/index.spw"
 @vibes: ~"./vibes/index.spw"
 @culinary: ~"./domains/culinary-fantasy/index.spw"
 @lenses: ~"./lenses/index.spw"
 @facets: ~"./facets/index.spw"
 @handles: ~"./handles/index.spw"
 @expressions: ~"./expressions/index.spw"
 @mj: ~"./labs/midjourney.spw"
 @experiential: ~"./labs/experiential.spw"
 @film: ~"./production/film.spw"
 @production: ~"./production/index.spw"
 @image: ~"./image.prompt.spw"
 @contours: ~"./image/index.spw"
 @portrait: ~"./image/portrait.prompt.spw"
 @interior: ~"./image/interior.prompt.spw"
 @still_life: ~"./image/still-life.prompt.spw"
 @exterior: ~"./image/exterior.prompt.spw"
 @process: ~"./image/process.prompt.spw"
 @diagram: ~"./image/diagram.prompt.spw"
 @sheet: ~"./image/sheet.prompt.spw"
 @sagas: ~"./sagas/index.spw"
 @templates: ~"./templates/index.spw"
 @math: ~"./math/index.spw"
 @axes: ~"./substrate/axes.spw"
 @literate_ui: ~"../.spw/patterns/literate-ui.spw"
 @form_contours: ~"../docs/theory/spw/form-contours.spw"
}

// ── Anatomy ────────────────────────────────────────────────────

^"anatomy"{
 #:semantics #!organs

 ~#claim: "A prompt ecology is a body: vibes and domains are ground, tone is PE genotype, contours are organs, lenses are optics, emits are utterances, sagas are growth history."

 ground: .{
  // prime biome — worldbuilding begins here (genre unnamed)
  biome: @biome
  metaphysics: @metaphysics
  ~#valence: !bone
 }

 tissue: .{
  // shared material across organs — do not rewrite lightly
  style_anchors: @vibes
  phrase_bank: @mj
  asset_refs: "sref/cref/winning_phrase_lock when earned"
  ~#valence: !bone
 }

 optics: .{
  lenses: @lenses
  facets: @facets
  expressions: @expressions
  handles: @handles
  law: "≤2 lenses; ≤2 facets; handles resolve to paths"
  ~#valence: !boon
 }

 organs: .{
  // specialized function; mutate one organ's contour, not the whole body
  portrait: .{ path: @portrait, script: #character_beat, senses: [#face, #hands, #apron] }
  interior: .{ path: @interior, script: #place_chamber, senses: [#oven, #shelf, #steam] }
  still_life: .{ path: @still_life, script: #inventory_fold, senses: [#crust, #linen, #board] }
  exterior: .{ path: @exterior, script: #threshold_entry, senses: [#door, #path, #canopy] }
  process: .{ path: @process, script: #action_sequence_beat, senses: [#hands, #tool, #dough] }
  diagram: .{ path: @diagram, script: #expository_map, senses: [#zone, #flow, #label_free] }
  sheet: .{ path: @sheet, script: #asset_turnaround, senses: [#proportion, #costume, #view] }
  ~#valence: !bone
 }

 production_body: .{
  film: @film
  experiential: @experiential
  stills_lab: @mj
  ~#valence: !boon
 }

 circulation: .{
  // how change moves through the body
  axes: "flavor  light  density  craft  era_feel on signature"
  branches: "biome.branches sustained forks"
  facets: "session tilts"
  saga: "append-only mutation log with measure"
  lock: "asset_refs when hold proven across organs"
  ~#valence: !boon
 }

 membrane: .{
  // what may cross in/out
  admit: [#axis_pick, #contour_pick, #subject_pick, #lens_pick, #facet_pick, #dept_pick, #emit_override]
  refuse: [#parallel_world_rewrite, #anchor_synonym_churn, #noir_default_relapse, #genre_school_stamp]
  ~#valence: !bane  // membrane is protection
 }

 spirit_path: "?wonder → ~name → @vibes|@culinary → #lens → [organ|dept] → *emit → %hold → ^lock"
}

// ── Local reference grammar ────────────────────────────────────

^"local_refs"{
 #:pragmatics #!navigation

 forms: #[
  @root                 // perspective declared in ^["roots"]
  ~"relative/path"      // tilde path unit
  ~<sibling.prompt.spw> // angle neighbor (compat projection)
  #topic                // concept chip
  ~#trait               // concise property
  ^["frame"]            // structural section
 ]

 law_local_first: "Prefer @roots and ~siblings inside prompts/ before absolute repo paths; keep imagination portable."

 braid: .{
  vibe_to_contour: @vibes → @contours
  contour_to_emit: @portrait → *emit
  saga_to_assets: @sagas → asset_refs
 }

 navigation_sentence: "From @index → @vibes|@culinary → #lens → [organ|dept] → *emit → %hold → >>@sagas"

 research_sentence: "?axis@metaphysics → ~handle → #lens → @branch → *probe_in_medium"
 film_sentence: "#scenelet → dept handles@film → stills_crosswalk@mj"
 experience_sentence: "#dwell@experiential → climate bands@biome.strata → haptic@sensorial"
}

// ── Script contours as form geometry ───────────────────────────

^"script_contours"{
 #:semantics #!form

 ~#claim: "Image kinds are script contours — composition roles analogous to form-ladder rungs, not separate genres."

 contour_to_form_hint: .{
  character_beat: #frame_select          // [subject]
  place_chamber: #body_material          // {place}
  inventory_fold: #fold_inventory        // many→one still
  threshold_entry: #path_extend          // exterior approach
  action_sequence_beat: #process_motion  // hands-tool-dough
  expository_map: #diagram_ground        // teaching section
  asset_turnaround: #sheet_publish       // multi-view seal
 }

 ladder_law: "Climb contours to teach the signature; do not skip to sheet before portrait/still-life hold."
 receipt: "Each contour run should name before/after axis state and hold score — same spirit as form-contour receipts."
}

// ── Mutation sagas ─────────────────────────────────────────────

^"mutation_sagas"{
 #:semantics #!evolution

 definition: "An append-only stream of imagination moves: each entry mutates one coordinate (axis, contour, or subject) and records measure."
 // Full customizable / optimizable / fractal schema:
 //   @sagas → schema, macros, fractal, optimize, profiles
 docs: ~"../../docs/runtime/md/mutation-sagas.md"
 home: @sagas

 coordinates: #[
  #axis_flavor
  #axis_light
  #axis_density
  #axis_craft
  #axis_era
  #tone_dim
  #contour_organ
  #subject_cast
  #style_phrase
  #genre_contract
  #emit_phrasing
  #host_slot
  #ladder_step
  #fractal_depth
  #macro_fill
  #layout_rule
 ]

 step_shape: .{
  mark: ">>[timestamp]"
  type: #observe #mutate #measure #decide #lock #reject #expand #pulse #nest #fold
  body: "what changed + why + pointer to organ or locus"
 }

 law_one_mutation: "One saga step changes exactly one coordinate class. Multi-coordinate leaps require explicit !bonk (accepted chaos) annotation."
 law_macro: "#expand fills holes/templates; not a silent creative multi-axis mutate."
 law_fractal: "Nest self-similar profiles at deeper loci; fold via & / {&}; depth budgeted."

 grades: .{
  S0: "read signature + contour; plan pulse; no emit write"
  S1: "sandbox emit / in-memory pulse; no asset_refs lock"
  S2: "write winning_phrase_lock / style_ref / character_ref / layout --write"
 }

 valence: .{
  !boon: "hold improves or new organ covered under same anchors"
  !bane: "hold collapses; revert axis"
  !bone: "anchor phrase unchanged (stability tissue)"
  !bonk: "intentional multi-axis or deep fractal experiment; quarantine from lock"
  !honk: "surprise win — promote to new default focus/trace"
 }

 fractal_anchor: "& => {&}"   // form ladder op:& preferred product; nest site

 optimize: .{
  objectives: #[ #hold_composite, #signature_composite, #layout_safe, #fractal_hold, #thrift_first ]
  search: #[ #greedy_one, #ablate_matrix, #beam, #ladder_walk, #fractal_dfs ]
  stop: #[ #fixed_point, #objective_plateau, #budget_exhausted, #lock_ready ]
 }

 macros: .{
  holes: #[ _, $_, $name, "${name=default}", &, "{&}" ]
  define: "^macro[\"name\"]{ params body }"
  call: "*macro[name]{ … } | !spell[name]{ … } | ~macro[name]"
 }

 stream_template: `
^["stream"]{
 >>[0] observe — baseline @portrait hearth
 >>[1] expand  — fill $slots
 >>[2] mutate — axis_light: hearth → canopy
 >>[3] measure — %style_hold %objective
 >>[4] decide — !boon keep
 >>[5] nest — locus {&} profile fractal_merge
 >>[6] fold — child via &
 >>[7] lock — when S2 + slots complete
}
 `

 saga_home: @sagas
}

// ── Memory model (wip-shaped) ──────────────────────────────────

^"memory"{
 hot: #[^"roots", ^"anatomy", ^"local_refs", active_saga]
 warm: #[^"stream" on each saga file]
 cache: "derived: current focus/trace, last hold scores, locked refs"
 cold: "^[\"done\"] closed sagas → changelog of style discovery"
}

// ── Measures ───────────────────────────────────────────────────

^"measure"{
 signature_hold: %[style_anchor_reuse * material_clarity * world_coherence]
 organ_coverage: %[contours_with_hold / 7]
 saga_discipline: %[single_coordinate_steps / total_steps]
 craft_truth: %[hands_or_crust_readability]
 wonder: %[useful_surprise_without_anchor_break]
 composite: compute_%[signature_hold * organ_coverage * saga_discipline]
}

// ── Open ───────────────────────────────────────────────────────

^"open"{
 ?[saga_automation]: "Ship spw saga append|expand|optimize, or stay file-authored + emit/pulse bridge?"
 ?[cross_medium]: "When song/design inherit vibes, do they share saga streams or fork per medium?"
 ?[form_ladder_bind]: "How tight should contour_to_form_hint bind to seed form-ladders vocabulary?"
 ?[fractal_depth_default]: "Is max_depth 3 the right default for style-repo nests?"
}

^"falsify"{
 #[
  "Agent rewrites style_anchors every run"
  "Saga step mutates three axes silently"
  "Local refs point outside prompts/ without @repo justification"
  "Contour files invent a brand world instead of stacking vibes"
  "Lock written after single unmeasured emit"
 ]
}

~<./index.spw>
~<./sagas/index.spw>
~<.spw/patterns/literate-ui.spw>
