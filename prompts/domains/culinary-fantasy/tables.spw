# Culinary Fantasy — Tables
#
# Lightweight oracles for homebrew. Roll or pick; stack vibes separately.

#>spw_culinary_fantasy_tables
#:domain #!rpg
#:layer #!creative

^"roots"{
 @anatomy: ~"./anatomy.spw"
 @vibes: ~"../../vibes/index.spw"
}

^"d6_place"{
 1: #hearth_kitchen
 2: #road_kitchen
 3: #market_stall
 4: #cellar_store
 5: #path_forage
 6: #feast_hall
}

^"d6_pressure"{
 1: "supply low — one watch of food left"
 2: "guest of rank arrives unannounced"
 3: "ingredient taboo for a faction present"
 4: "weather against the rise or the road fire"
 5: "rival cook claims the same recipe story"
 6: "a debt meal comes due"
}

^"d6_yield"{
 1: #ration
 2: #fresh
 3: #feast_grade
 4: #offering
 5: #keeps
 6: "empty board — story instead of dish"
}

^"d6_forest_forage"{
 // yields tags — never auto-spoil camp bread
 1: "greens — #fresh"
 2: "nuts — #keeps"
 3: "mushrooms — #fresh forage (flora); cook or dry before store"
 4: "herbs — rumor or remedy tag"
 5: "nothing — path teaches a shortcut"
 6: "watched — animal or person; negotiate"
}

^"vibe_stacks_common"{
 quiet_kitchen: ~[hearth:0.5, baking:0.5]
 camp_under_leaves: ~[forest:0.5, hearth:0.35, baking:0.15]
 market_morning: ~[market:0.6, hearth:0.2, baking:0.2]
 salt_and_stone_store: ~[mineral:0.55, hearth:0.3, baking:0.15]
 road_pot: ~[forest:0.4, hearth:0.4, market:0.2]
}

~<./anatomy.spw>
