# Domain: Culinary Fantasy (homebrew RPG)
#
# General worldbuilding for games and fiction where food, craft, trade,
# and hospitality carry weight. Compose vibes; no required brand pack.

#>spw_domain_culinary_fantasy
#:domain #!rpg
#:layer #!creative
#:status #!active

^"intent"{
 ~#goal: "Playable culinary-fantasy anatomy for homebrew RPG and fiction — places, recipes, tables, vibe stacks."
 ~#taste: "generalizable; thrift; non-bleed vibes; rot is a move not a default"
}

^"roots"{
 @anatomy: ~"./anatomy.spw"
 @tables: ~"./tables.spw"
 @vibes: ~"../../vibes/index.spw"
 @tone: ~"../../substrate/tone-anatomy.spw"
 @compose: ~"../../substrate/compose.spw"
 @handles: ~"../../handles/index.spw"
}

^"dispatch"{
 anatomy: @anatomy
 tables: @tables
 vibes: @vibes
}

^"compose_recipe"{
 1: "Place class from @anatomy"
 2: "≤3 vibes with weights from @vibes"
 3: "Optional #voice_* for prose"
 4: "Fill who / cooks / owed / door"
 5: "Non-bleed check (forest forage ≠ spoiled bread)"
 6: "*emit table text, scene brief, or image pack"
}

^"law"{
 not_a_brand: "No required shop name, mascot, or single kitchen myth."
 spoilage_is_a_move: "Rot is opt-in consequence — never implied by stacking forest or fungi flora vibes with baking."
}

~<./anatomy.spw>
~<./tables.spw>
~<../../vibes/index.spw>
