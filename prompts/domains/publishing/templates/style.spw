# Publishing — Style genotype
#
# Develop a unique style once; propagate it across titles, jobs, and hosts.
# Style is feel-physics + phrase locks + materials — not a school stamp.

#>spw_publishing_style
#:domain #!publishing
#:template #!style
#:layer #!creative

^"intent"{
 ~#goal: "Author a reusable style genotype: phrase bank, material locks, tone bias, asset refs."
 ~#taste: "positive fill; one mutation per saga step; lock only after multi-organ hold"
}

^"roots"{
 @domain: ~"../index.spw"
 @tone: ~"../../../substrate/tone-anatomy.spw"
 @vibes: ~"../../../vibes/index.spw"
 @ecology: ~"../../../script-ecology.spw"
 @signatures: ~"../../../signatures/index.spw"
 @mj: ~"../../../labs/midjourney.spw"
}

// ── Schema ─────────────────────────────────────────────────────

^"style"{
 id: "style_slug"
 display_name: "working style name"
 status: #sandbox | #candidate | #locked | #retired
 // inherit optional vibes as tissue, not as the whole identity
 vibe_stack: []   // ≤3 #vibe_*
 register_bias: #voice_braided_relation
 ~#fill: "one breath of what this style always puts in the room"
 ~#taste: "material adjectives this style prefers"
}

^"phrase_lock"{
 // Winning phrases — travel into mj / copy / brief texture
 // Prefer concrete sensory clauses over genre-school labels.
 materials: [
  // "flour-dusted linen"
 ]
 light: [
  // "warm oven-amber key"
 ]
 craft: [
  // "hand-scale tool focus"
 ]
 voice: [
  // "plain speech, one clear next step"
 ]
 // Combined export for emit extract:
 // style_lock: "phrase a | phrase b | phrase c"
}

^"locks"{
 palette: []      // tag list
 materials: []    // tag list
 era_feel: ""     // soft era hint without school stamp
 camera_feel: ""  // optional production default
 sound_feel: ""
}

^"asset_refs"{
 // Earn these via saga S2 after hold — do not invent early
 style_ref: ""       // external style ref id when host needs it
 character_ref: ""   // only if subject-bound
 winning_phrase_lock: ""  // single best short string
 note: "Empty until %signature_hold proven across ≥2 organs or ≥2 hosts."
}

^"tone_bias"{
 // Optional pole weights (feel-physics)
 // temperature: ~[warm:0.6, cool:0.4]
 // density: ~[sparse:0.55, lush:0.45]
 // material: ~[organic:0.5, fused:0.3, mineral:0.2]
}

^"refuse"{
 // Structural / membrane refuses — not tonal opposite-lists
 #[
  "genre_school_stamp as the only style definition"
  "rewrite phrase_lock every job"
  "lock asset_refs after a single unmeasured emit"
  "vendor or engine names inside style genotype"
 ]
}

^"develop"{
 // How unique style is grown (see script-ecology mutation sagas)
 path: [
  "1. S0 — read existing vibes/tone; draft ~#fill + 3–7 phrase locks"
  "2. S1 — sandbox emit mj + copy; one axis mutate per step"
  "3. %measure — style_hold on phrase reuse across hosts"
  "4. S2 — write winning_phrase_lock / style_ref when hold holds"
  "5. Propagate — jobs reference style id; do not re-author phrases"
 ]
 axes: [ #axis_flavor, #axis_light, #axis_density, #axis_craft, #axis_era ]
 law_one: "One saga step mutates one coordinate class."
}

^"propagate"{
 // What travels when a job binds this style
 into_emit: [
  style_lock          // → slots + mj texture
  ~#fill
  register_bias
  material/light phrases
 ]
 into_measure: "style_hold checks style_lock phrases appear in composed text (soft: majority; strict: all)"
 into_hosts: [ #mj, #copy, #brief, #audio, #social, #plain ]
}

^"emit_slots"{
 style_id: "style_slug"
 style_lock: "phrase | phrase | phrase"
 ~#style: "one-line style fill"
 register: "#voice_* if overriding house"
}

^"instance_shape"{
 example: `
#>style_quiet_press
^"style"{
 id: "quiet_press_ink"
 display_name: "Quiet Press ink"
 status: #candidate
 register_bias: #voice_web_quiet
 ~#fill: "thrift of chrome; letterpress calm; one verb per surface"
 ~#taste: "ink, cream paper, soft graphite edge"
}
^"phrase_lock"{
 materials: [ "cream paper margin", "soft graphite rule" ]
 light: [ "north-window paper light" ]
 voice: [ "one screen, one verb", "thrift of chrome" ]
}
^"emit"{
 style_id = "quiet_press_ink"
 style_lock = "cream paper margin | thrift of chrome | one screen, one verb"
 ~#style: "thrift of chrome; letterpress calm"
 register: #voice_web_quiet
}
`
}

~<../index.spw>
