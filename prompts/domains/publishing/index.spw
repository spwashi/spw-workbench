# Domain: Publishing
#
# Media production as a house: stable house voice, title packs, job packs.
# Compose with substrate PE; emit to brief / copy / audio / social hosts.
# No required brand world — house is a schema, not a named shop.

#>spw_domain_publishing
#:domain #!publishing
#:layer #!creative
#:status #!active

^"intent"{
 ~#goal: "Ship multi-surface media from Spw: house law → title continuity → job brief → host packet."
 ~#taste: "one house voice; title anchors held across channels; thrift of chrome; positive ground"
}

^"roots"{
 @house: ~"./templates/house.spw"
 @title: ~"./templates/title.spw"
 @job: ~"./templates/job.spw"
 @tone: ~"../../substrate/tone-anatomy.spw"
 @compose: ~"../../substrate/compose.spw"
 @handles: ~"../../handles/index.spw"
 @vibes: ~"../../vibes/index.spw"
 @film: ~"../../production/film.spw"
 @image: ~"../../image/index.spw"
}

^"dispatch"{
 house: @house
 title: @title
 job: @job
}

^"pipeline"{
 1: "Load or author house pack — register default, palette law, refuse list"
 2: "Open or create title pack — logline, audience, continuity anchors, vibe stack ≤3"
 3: "Open job pack — deliverable host, register, acceptance"
 4: "Fill ~#traits positive only; hold title anchors"
 5: "*emit host: brief | copy | audio | social | mj | web_copy | eng_note"
 6: "%measure positive_ground + continuity"
}

^"hosts"{
 brief: "structured production brief (goal, audience, claim, acceptance)"
 copy: "long-form copy (headline, dek, body, door)"
 audio: "spoken / song / VO beats (cold open, spine, cta)"
 social: "short channel posts (hook, body, door)"
 mj: "image pack (via labs)"
 web_copy: "claim / proof / door landing shape"
 eng_note: "internal handoff"
}

^"law"{
 house_before_channel: "House register and palette bind before platform fashion."
 title_anchors_travel: "Names, materials, and claim phrases in the title pack must appear in job emits or continuity measure warns."
 no_default_brand: "Publishing domain is a workflow; optional packs may name a house — domain does not require one."
 positive_ground: "Wanted poles only; structural negative slots stay host-side (mj)."
 vibe_optional: "Vibes are opt-in texture; not required for eng_note or plain brief."
}

^"compose_recipe"{
 pe: "#voice_* from house + title anchors + job slots → *emit"
 stills: "title materials + image organ + optional vibe phrase banks"
 film: "title pack + production/film departments + scenelet"
}

~<./templates/house.spw>
~<./templates/title.spw>
~<./templates/job.spw>
