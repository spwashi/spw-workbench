# Publishing — Propagation law
#
# How unique style, subject, and genre travel from genotype → title → job → host.
# Develop in sagas; propagate by reference; measure hold; lock late.

#>spw_publishing_propagate
#:domain #!publishing
#:layer #!pragmatics
#:status #!active

^"intent"{
 ~#goal: "One propagation grammar so agents do not re-author style/subject/genre every surface."
 ~#taste: "reference over rewrite; one mutation coordinate; hold before lock"
}

^"roots"{
 @domain: ~"./index.spw"
 @style: ~"./templates/style.spw"
 @subject: ~"./templates/subject.spw"
 @genre: ~"./templates/genre.spw"
 @house: ~"./templates/house.spw"
 @title: ~"./templates/title.spw"
 @job: ~"./templates/job.spw"
 @ecology: ~"../../script-ecology.spw"
 @compose: ~"../../substrate/compose.spw"
}

// ── Stack (outer → inner) ──────────────────────────────────────

^"stack"{
 // Outer constraints win when conflict is about law;
 // inner fills win when conflict is about local detail.
 order: [
  #house       // voice + refuse membrane
  #genre       // promise + pacing contract
  #style       // phrase locks + materials
  #subject     // names + tells
  #title       // continuity anchors for the property
  #job         // host + acceptance for one deliverable
 ]
 law_conflict: "House refuse and genre promise beat channel fashion. Subject tells beat synonym cleverness. Style phrase_lock beats one-off adjectives."
}

// ── Develop vs propagate ───────────────────────────────────────

^"develop"{
 // Unique invention happens here — sandbox grades S0–S2
 style: @style
 subject: @subject
 genre: @genre
 saga: @ecology
 law: [
  "One coordinate per step (axis, contour, subject, or emit phrasing)"
  "Positive fill only in genotype bodies"
  "No lock until hold across ≥2 hosts or ≥2 image organs"
 ]
}

^"propagate"{
 // Stable reuse — jobs bind ids; emit carries locks
 bind_on_job: [
  style_id
  subject_id
  genre_id
  house_ref
  title_ref
 ]
 carry_strings: [
  style_lock
  subject_lock
  genre_lock
  continuity     // title anchors
 ]
 host_map: .{
  mj: [ style_lock, subject_lock, materials, light ]
  copy: [ style voice phrases, subject name, genre promise ]
  brief: [ genre promise, style fill, subject claim, title continuity ]
  audio: [ subject voice_tells, genre weather, style craft ]
  social: [ subject name or title, one style phrase, genre promise thrift ]
  eng_note: [ ids + acceptance; locks as checklist ]
 }
}

// ── Measures ───────────────────────────────────────────────────

^"measure"{
 positive_ground: "no negation spine"
 continuity: "title anchors in composed text"
 style_hold: "style_lock phrases in composed text"
 subject_hold: "subject name + tells in composed text"
 genre_hold: "genre_lock / promise phrases in composed text"
 composite: "all declared holds — soft warn; --strict-* to fail"
}

// ── Mutation membrane ──────────────────────────────────────────

^"membrane"{
 admit: [
  #axis_pick
  #contour_pick
  #subject_pick
  #style_phrase_add   // additive only after measure
  #genre_contract_nudge
  #emit_override
 ]
 refuse: [
  #parallel_world_rewrite
  #anchor_synonym_churn
  #genre_school_stamp
  #noir_default_relapse
  #rewrite_locks_every_job
 ]
}

// ── Agent protocol ─────────────────────────────────────────────

^"agent_protocol"{
 new_style: [
  "1. Copy templates/style.spw instance_shape → packs/styles/<id>.spw"
  "2. Fill ~#fill + phrase_lock (5–12 phrases)"
  "3. Saga S1: emit mj + copy; mutate one axis; measure style_hold"
  "4. Lock winning_phrase_lock; set status #locked"
 ]
 new_subject: [
  "1. Instance templates/subject.spw"
  "2. Name + 3–5 tells; refuse synonym list"
  "3. Portrait → still_life under one style; measure subject_hold"
  "4. Sheet; lock subject_lock"
 ]
 new_genre: [
  "1. Instance templates/genre.spw — promise, weather, stakes"
  "2. Contract poles; no school stamp as spine"
  "3. Two titles under genre; compare hold"
  "4. Optional market_tags after lock"
 ]
 ship_job: [
  "1. Bind house + genre + style + subject + title ids"
  "2. Fill job host slots; copy locks into emit frame"
  "3. spw emit --host <h> --measure [--strict-continuity] [--strict-style] …"
 ]
}

^"falsify"{
 #[
  "Job rewrites style_lock instead of referencing style_id"
  "Subject renamed mid-title without saga"
  "Genre defined only as a market school tag"
  "Lock written after single unmeasured emit"
 ]
}

~<./index.spw>
