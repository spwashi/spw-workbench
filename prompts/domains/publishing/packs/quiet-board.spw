# Sample title + job surfaces for publishing emit smoke.
# Vendor-free; no required house brand beyond the working name.

#>spw_pack_quiet_board
#:domain #!publishing
#:pack #!sample
#:layer #!creative

^"intent"{
 ~#goal: "Demonstrate house → title → job → emit for Quiet Board."
 ~#taste: "thrift of chrome; plain speech"
}

^"roots"{
 @domain: ~"../index.spw"
 @house: ~"../templates/house.spw"
 @title: ~"../templates/title.spw"
 @job: ~"../templates/job.spw"
}

^"house"{
 id: "quiet_press"
 display_name: "Quiet Press"
 register_default: #voice_web_quiet
 ~#claim: "Small tools that keep craft readable."
 ~#taste: "thrift of chrome; plain speech; one clear next step"
}

^"title"{
 id: "quiet_board"
 working_title: "Quiet Board"
 logline: "A small tool keeps craft visible on one screen."
 ~#claim: "Keep the work visible."
 ~#audience: "makers who ship small surfaces"
}

^"continuity"{
 anchors: [ "Quiet Board", "one screen", "one verb" ]
}

^"emit"{
 register: #voice_web_quiet
 ~#title: "Quiet Board"
 ~#claim: "Keep the work visible."
 ~#proof: "one screen, one verb"
 ~#door: "Open the board"
 ~#audience: "makers who ship small surfaces"
 ~#goal: "Hero and social for Quiet Board launch."
 ~#acceptance: "Title anchors appear; claim and door are clear."
 ~#taste: "thrift of chrome"
 continuity: "Quiet Board | one screen | one verb"
 headline = "Keep the work visible."
 dek = "Quiet Board: one screen, one verb."
 hook = "One screen. One verb."
 cold_open = "Quiet Board opens on a single surface — no parade of chrome."
 short_prompt = "Quiet Board, one screen, one verb, thrift of chrome."
 final_prompt = "Quiet Board keeps craft readable. One screen. One verb. One clear next step. Open the board."
 body = "Quiet Board keeps craft readable. One screen. One verb. One clear next step."
 cta = "Open the board"
 duration = "30s"
}

~<../index.spw>
