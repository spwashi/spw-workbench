# Sample line: style + subject + genre bound for Quiet Board
# Demonstrates develop-once, propagate-many.

#>spw_pack_quiet_craft_line
#:domain #!publishing
#:pack #!sample
#:layer #!creative

^"intent"{
 ~#goal: "One style, one subject, one genre — propagated into multi-host emit."
 ~#taste: "thrift; hold locks; no school stamp"
}

^"roots"{
 @propagate: ~"../propagate.spw"
 @style_t: ~"../templates/style.spw"
 @subject_t: ~"../templates/subject.spw"
 @genre_t: ~"../templates/genre.spw"
}

^"style"{
 id: "quiet_press_ink"
 display_name: "Quiet Press ink"
 status: #candidate
 register_bias: #voice_web_quiet
 ~#fill: "thrift of chrome; letterpress calm; one verb per surface"
 ~#taste: "ink, cream paper, soft graphite"
}

^"subject"{
 id: "board_keeper"
 kind: #character
 display_name: "board-keeper"
 ~#claim: "Keeps one screen honest."
}

^"genre"{
 id: "quiet_craft"
 display_name: "quiet craft"
 ~#promise: "Competence and care stay visible."
 ~#weather: "hospitable focus; soft moral clarity"
 ~#stakes: "clarity lost to clutter; restored by one verb"
}

^"title"{
 id: "quiet_board"
 working_title: "Quiet Board"
 ~#claim: "Keep the work visible."
 ~#audience: "makers who ship small surfaces"
}

^"emit"{
 register: #voice_web_quiet
 style_id = "quiet_press_ink"
 subject_id = "board_keeper"
 genre_id = "quiet_craft"
 style_lock = "thrift of chrome | cream paper margin | one verb per surface"
 subject_lock = "board-keeper | one clear board | soft charcoal sleeves"
 genre_lock = "care stays visible | thrift of chrome | one verb"
 continuity = "Quiet Board | one screen | one verb"
 ~#title: "Quiet Board"
 ~#subject: "Keeps one screen honest."
 ~#style: "thrift of chrome; letterpress calm"
 ~#promise: "Competence and care stay visible."
 ~#weather: "hospitable focus"
 ~#claim: "Keep the work visible."
 ~#proof: "one screen, one verb"
 ~#door: "Open the board"
 ~#goal: "Propagate quiet craft line across hosts."
 ~#acceptance: "Style, subject, genre, and title locks hold."
 ~#audience: "makers who ship small surfaces"
 headline = "Keep the work visible."
 dek = "Quiet Board for the board-keeper: thrift of chrome, one verb."
 hook = "One screen. One verb."
 cold_open = "The board-keeper sets one clear board — thrift of chrome, cream paper margin."
 body = "Quiet Board keeps craft readable for the board-keeper. One screen. One verb. Care stays visible. Thrift of chrome."
 short_prompt = "board-keeper at one clear board, cream paper margin, thrift of chrome, soft charcoal sleeves, one verb per surface"
 final_prompt = "Quiet Board, board-keeper, one clear board, cream paper margin, thrift of chrome, soft charcoal sleeves, care stays visible, one verb per surface, one screen, one verb"
 cta = "Open the board"
 duration = "30s"
}

~<../propagate.spw>
