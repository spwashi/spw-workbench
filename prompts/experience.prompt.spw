#>experience_generation_prompt
#:spatial_computing
#:generation
#:prompt
#:layer #!creative

^"experience_generation" {
  identity: .{
    title = working_title
    subtitle = none
    version = v1
    status = draft
    intent = generate_complete_spatial_blueprint

    variants: .{
      v_embodied = "Physical physics, room-scale, tactile"
      v_dreamstate = "Non-euclidean, flying, surreal scale"
      v_arcade = "Gamified, neon, haptic snapping"
    }

    focus = *v_dreamstate
    trace = ~[v_dreamstate:0.6, v_embodied:0.3, v_arcade:0.1]
  }

  format: .{
    headset_target = !meta_quest_3_and_apple_vision_pro
    degrees_of_freedom = 6dof
    input_paradigm = !direct_hand_tracking_and_eye_gaze
    framerate_target = 90hz
    persistence = !session_based_volatility
  }

  concept: .{
    premise = one_sentence_experience_hook
    thesis_moment = the_jaw_drop_reveal
    
    emotional_core[*]: .{
      v_embodied = #grounded_presence
      v_dreamstate = #ego_dissolution
      v_arcade = #adrenaline_flow
    }
    
    transformation = user_state_before_and_after
  }

  spatial_architecture: .{
    scale_manipulation = !alice_in_wonderland_shifts
    skybox = !volumetric_clouds_animated

    environment_bounds: .{
      layout = !infinite_procedural_halls
      ceiling_height = !soaring_cathedral_scale
    }
    
    locomotion[*]: .{
      v_embodied = !physical_walking_only_1_to_1
      v_dreamstate = !smooth_flight_and_teleport_arc
      v_arcade = !dashing_and_grappling_hook
    }
    
    comfort_and_safety: .{
      boundary_handling = !fade_to_passthrough_on_edge
      vignette_on_move = !dynamic_fov_reduction_tunneling
      horizon_stabilization = !locked_artificial_horizon
      height_adjustment = !seated_mode_scaling
    }
    
    passthrough_blending: .{
      mix_ratio = !additive_holographic_overlay
      occlusion_mapping = !dynamic_depth_mesh_occlusion
      real_world_lighting_estimation = !active_probe_matching
    }
  }

  interaction_design: .{
    physics[*]: .{
      v_embodied = !heavy_newtonian_kinematics
      v_dreamstate = !low_gravity_fluid_resistance
      v_arcade = !exaggerated_snap_and_bounce
    }
    
    avatar_embodiment: .{
      ik_rigging_fidelity = !full_body_estimation_from_head_hands
      hand_presence = !ghosted_on_occlusion_or_clipping
      foot_ik = !predictive_stepping
      mirror_presence = !reflective_surfaces_show_avatar
    }

    haptic_feedback = ~[v_embodied:0.9, v_dreamstate:0.1]
    
    hand_tracking_gestures: .{
      pinch_to_select = !primary_action_with_haptic_click
      palm_up_menu = !summon_system_palette
      two_hand_scaling = !pinch_and_pull_world_zoom
    }

    eye_tracking_foveation: .{
      gaze_interaction = !highlight_on_dwell
      rendering_priority = !dynamic_foveated_rendering_center
    }
    
    diegetic_ui: .{
      menus = !embedded_in_wrist_watch_or_surfaces
      tooltips = !floating_text_anchored_to_objects
      health_bars = !vignette_blood_or_damage_cracks
      inventory = !physical_backpack_pull
    }
  }

  sensory_system: .{
    lighting_model[*]: .{
      v_embodied = !natural_global_illumination_baking
      v_dreamstate = !bioluminescent_sources_unlit_shaders
      v_arcade = !strobe_and_laser_bloom_heavy
    }
    
    render_pipeline[*]: .{
      v_embodied = !physically_based_rendering_metallic_roughness
      v_dreamstate = !volumetric_raymarching_clouds
      v_arcade = !cel_shaded_outlines_unlit
    }

    audio_spatialization = !binaural_hrtf_ambisonics
    acoustic_occlusion = !physically_modeled_materials_muffling
    ambient_soundbed = ~[v_dreamstate:0.7, v_embodied:0.3]
    music_system = !adaptive_stem_layering_linked_to_motion
    
    geometry_lod: .{
      close_range = !highly_tessellated_displacement_maps
      mid_range = !normal_maps_only
      far_range = !imposter_sprites
    }
  }

  multiplayer_and_networking: .{
    presence = !asynchronous_ghosts
    voice_chat = !spatial_proximity_fade
    shared_anchors = !azure_spatial_anchors_cloud_sync
    physics_sync = !client_predicted_server_authoritative
  }

  npc_and_ai_logic: .{
    gaze_awareness = !npcs_make_eye_contact_when_looked_at
    pathfinding = !navmesh_avoidance_of_player_space
    dialogue_system = !spatial_audio_interruptible
  }

  boonhonk: .{
    definition = "The observable field of wonder; naming taste, posture, and quality."
    combinatorics: .{
      instruction = "Use the % operator to quantify the spatial gravity."
      formulas: [
        %[sensory_system.lighting_model * 1.5] + %[interaction_design.avatar_embodiment.hand_presence] = physical_presence
        %[spatial_architecture.locomotion] * %[interaction_design.physics] = kinetic_valence
        %[interaction_design.diegetic_ui.menus] * %[sensory_system.audio_spatialization] = immersion_depth
        %[concept.thesis_moment] / (1 + %[negatives.ux]) = transportive_flow
        %[focus * trace] = variant_resonance
      ]
      execution = compute_%[physical_presence * kinetic_valence * immersion_depth * transportive_flow * variant_resonance]
    }
  }

  negatives: .{
    design: [ 
      #flat_2d_menus_in_space
      #text_too_small_to_read
      #clipping_through_walls
      #uncanny_valley_avatars
      #laser_pointers_everywhere
    ]
    ux: [ 
      #motion_sickness_yaw_turns
      #frame_drops_stutter
      #unclear_interactables
      #arm_fatigue_gorilla_arms
      #forced_unskippable_tutorials
    ]
    performance: [ 
      #overdraw_alpha_blending
      #draw_calls_over_200
      #uncompressed_textures
      #realtime_shadows_on_everything
    ]
  }
}
