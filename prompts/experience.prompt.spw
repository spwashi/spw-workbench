#>experience_generation_prompt
#:spatial
#:generation
#:prompt
#:layer #!creative

^"experience_generation" {
  identity: .{
    title = working_title
    subtitle = none
    version = v1
    status = draft
    intent = generate_complete_spatial_blueprint

    variants: .{
      v_embodied = "Physical physics, room-scale, tactile"
      v_dreamstate = "Non-euclidean, flying, surreal scale"
      v_arcade = "Gamified, neon, haptic snapping"
    }

    focus = *v_dreamstate
    trace = ~[v_dreamstate:0.6, v_embodied:0.3, v_arcade:0.1]
  }

  format: .{
    platform[*]: .{
      v_embodied = !mixed_reality_headset
      v_dreamstate = !fully_immersive_vr
      v_arcade = !desktop_or_console
    }

    session_length = !twenty_minutes
    multiplayer_state = !asynchronous_traces
  }

  concept: .{
    premise = one_sentence_experience_premise
    thesis_moment = central_climax_or_reveal
    
    emotional_core[*]: .{
      v_embodied = #grounded_tactility
      v_dreamstate = #boundless_awe
      v_arcade = #adrenaline_flow
    }
    
    emotional_arc: [
      #curiosity_on_spawn
      #tactile_discovery
      #scale_shift_awe
      #lucid_mastery
    ]
    transformation = user_state_before_and_after
  }

  narrative: .{
    perspective = !first_person
    voice = !environmental_storytelling
    narrative_flow: [
      !spawn_in_safe_zone
      !threshold_crossing
      !core_loop_introduced
      !environmental_climax
      !quiet_extraction
    ]
    tension: .{
      problem = what_is_broken_in_the_world
      desire = what_user_must_find_or_do
      solution = core_mechanic_provided
      objection = what_stands_in_the_way
    }
  }

  spatial_architecture: .{
    world_structure[*]: .{
      v_embodied = !room_scale_tabletop
      v_dreamstate = !non_euclidean_void
      v_arcade = !linear_corridor_arena
    }

    locomotion[*]: .{
      v_embodied = !physical_walking_only
      v_dreamstate = !smooth_flight_and_teleport
      v_arcade = !dashing_and_grappling
    }
    
    comfort_and_safety: .{
      boundary_handling = !fade_to_passthrough
      vignette_on_move = !dynamic_fov_reduction
    }
    
    scale_manipulation = !alice_in_wonderland_shifts
    skybox = !volumetric_clouds
  }

  interaction_design: .{
    input_paradigm[*]: .{
      v_embodied = !bare_hand_tracking
      v_dreamstate = !gaze_and_pinch
      v_arcade = !haptic_controllers
    }

    physics[*]: .{
      v_embodied = !heavy_newtonian
      v_dreamstate = !low_gravity_fluid
      v_arcade = !exaggerated_snap
    }
    
    avatar_embodiment: .{
      ik_rigging_fidelity = !full_body_estimation
      hand_presence = !ghosted_on_occlusion
    }

    haptic_feedback = ~[v_embodied:0.9, v_dreamstate:0.1]
    
    affordances: [
      #grabbable_handles
      #glowing_interactables
      #proximity_audio_cues
    ]
  }

  sensory_system: .{
    visual_fidelity[*]: .{
      v_embodied = !photogrammetry_scans
      v_dreamstate = !stylized_watercolor
      v_arcade = !neon_wireframe
    }

    lighting_model[*]: .{
      v_embodied = !natural_global_illumination
      v_dreamstate = !bioluminescent_sources
      v_arcade = !strobe_and_laser
    }
    
    render_pipeline[*]: .{
      v_embodied = !foveated_dynamic_resolution
      v_dreamstate = !volumetric_raymarching
      v_arcade = !baked_lighting_unlit_shaders
    }

    audio_spatialization = !binaural_hrtf
    acoustic_occlusion = !physically_modeled_materials
    ambient_soundbed = ~[v_dreamstate:0.7, v_embodied:0.3]
    music_system = !adaptive_stems_linked_to_motion
  }

  materiality: .{
    surface_language = ~[v_embodied:0.8, v_dreamstate:0.2]
    tactile_priority = !hand_colliders_and_friction
    particle_systems: [
      #dust_motes_in_light
      #sparks_on_collision
    ]
  }

  ui_and_diegetics: .{
    interface_style[*]: .{
      v_embodied = !fully_diegetic_objects
      v_dreamstate = !spatial_floating_menus
      v_arcade = !helmet_hud
    }
    onboarding = !invisible_tutorial
    wayfinding = !light_and_sound_breadcrumbs
  }

  boonhonk: .{
    definition = "The observable field of wonder; naming taste, posture, and quality."
    combinatorics: .{
      instruction = "Use the % operator to quantify the experience's bodily and spatial gravity."
      formulas: [
        %[sensory_system.lighting_model * 1.5] + %[materiality.tactile_priority] = physical_presence
        %[spatial_architecture.locomotion] * %[interaction_design.physics] = kinetic_valence
        %[concept.thesis_moment] / (1 + %[negatives.ux]) = transportive_flow
        %[focus * trace] = variant_resonance
      ]
      execution = compute_%[physical_presence * kinetic_valence * transportive_flow * variant_resonance]
    }
  }

  negatives: .{
    design: [
      #flat_lighting
      #floating_hands_clipping
      #uncanny_valley_avatars
      #low_res_textures_up_close
    ]
    ux: [
      #motion_sickness_triggers
      #unclear_grab_points
      #text_too_small_to_read
      #forced_camera_movement
    ]
    performance: [
      #dropped_frames
      #hitch_on_asset_load
      #physics_jitter
    ]
  }
}
