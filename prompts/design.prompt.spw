#>design_generation_prompt
#:visual_design
#:generation
#:prompt
#:layer #!creative

^"design_generation" {
  identity: .{
    title = working_title
    subtitle = none
    version = v1
    status = draft
    intent = generate_complete_design_system_blueprint

    variants: .{
      v_brutalist = "Raw, systemic, unvarnished"
      v_minimalist = "Breathable, typographically driven, reductive"
      v_expressive = "Lush, motion-heavy, narrative"
    }

    focus = *v_minimalist
    trace = ~[v_minimalist:0.7, v_brutalist:0.2, v_expressive:0.1]
  }

  format: .{
    deliverable = !brand_guidelines
    fidelity = !high_fidelity_comps
    output_target = !figma_component_library
    documentation_level = !exhaustive_token_mapping
    theme_support = !light_and_dark_modes
  }

  concept: .{
    core_thesis = main_design_premise
    emotional_core[*]: .{
      v_brutalist = #authoritative
      v_minimalist = #calm
      v_expressive = #joyful
    }
    
    brand_archetype[*]: .{
      v_brutalist = !the_ruler
      v_minimalist = !the_sage
      v_expressive = !the_creator
    }

    metaphorical_anchor = the_visual_concept
    personality_traits: [
      #trait_1
      #trait_2
      #trait_3
    ]
  }

  typography: .{
    scale: .{
      ratio = !golden_ratio_1_618
      base_size_desktop = 16px
      base_size_mobile = 14px
      fluid_type_equation = !clamp_logic
    }
    
    typefaces: .{
      heading_face[*]: .{
        v_brutalist = !monospaced_heavy_geometric
        v_minimalist = !neo_grotesque_light_swiss
        v_expressive = !high_contrast_serif_display
      }
      body_face = !functional_humanist_sans
      caption_face = !mono_utilitarian_dense
      code_face = !fira_code_ligatures
    }

    opentype_features: .{
      ligatures = !contextual_and_standard
      numerals[*]: .{
        v_brutalist = !tabular_lining_fixed
        v_minimalist = !proportional_oldstyle_relaxed
        v_expressive = !proportional_lining_variable
      }
      stylistic_sets: [
        #ss01_alternate_a
        #ss02_slashed_zero
        #ss03_straight_quotes
      ]
      swashes = !heading_only
    }

    metrics: .{
      tracking[*]: .{
        v_brutalist = !tight_negative_fifty
        v_minimalist = !loose_positive_thirty
        v_expressive = !optical_zero
      }
      leading_body = !relaxed_1_5
      leading_heading = !tight_1_1
      kerning_pairs = !optical_override
      word_spacing = !standard_em
    }
    
    roles: .{
      display_1 = !hero_weight_variable_80px
      display_2 = !subtitle_weight_medium_64px
      heading_1 = !page_title_48px
      heading_2 = !section_title_32px
      heading_3 = !card_title_24px
      subheading = !all_caps_kearned_14px
      body_large = !article_intro_20px
      body_base = !default_reading_16px
      body_small = !metadata_14px
      caption = !legal_disclaimer_12px
      pull_quote = !italic_indented_24px
      code_block = !background_tinted_14px
    }
  }

  color_system: .{
    contrast_requirements = !wcag_aaa_strict
    lightness_distribution = !perceptually_uniform_oklch
    
    palette[*]: .{
      v_brutalist = .{
        primary = #black_000000
        secondary = #white_FFFFFF
        accent = #safety_orange_FF4500
        surface = #concrete_D3D3D3
        border = #graphite_333333
      }
      v_minimalist = .{
        primary = #warm_charcoal_2A2A2A
        secondary = #stone_8B8C89
        accent = #sage_green_9CAF88
        surface = #off_white_F5F5F0
        border = #light_ash_E5E5E5
      }
      v_expressive = .{
        primary = #ultramarine_120A8F
        secondary = #neon_pink_FF107A
        accent = #deep_purple_4A0E4E
        surface = #warm_cream_FFFDD0
        border = #vivid_cyan_00FFFF
      }
    }

    themes: .{
      light_mode = !vibrant_and_crisp
      dark_mode[*]: .{
        v_brutalist = !pure_black_bg_high_conrast
        v_minimalist = !deep_indigo_bg_low_contrast
        v_expressive = !midnight_blue_bg_neon_accents
      }
      high_contrast_mode = !forced_monochrome_yellow
    }

    surface_semantics: .{
      surface_base = !app_background_canvas
      surface_raised_1 = !card_background_floating
      surface_raised_2 = !modal_background_top_layer
      surface_sunken = !input_well_depressed
      surface_overlay = !scrim_wash_80_opacity
      surface_tooltip = !inverted_dark_matter
    }

    text_semantics: .{
      text_high_contrast = !primary_reading_bold
      text_medium_contrast = !secondary_labels_meta
      text_low_contrast = !disabled_states_placeholder
      text_inverse = !on_dark_surfaces_white
      text_brand = !hyperlink_blue
    }

    system_states: .{
      error_bg = !desaturated_red_wash
      error_text = !crimson_bold
      warning_bg = !amber_yellow_wash
      warning_text = !burnt_orange_bold
      success_bg = !muted_green_wash
      success_text = !forest_green_bold
      focus_ring = !accessible_blue_3px_solid
    }
  }

  layout_and_grid: .{
    grid_system = !12_column_fluid_flex
    max_width_container = 1440px
    alignment_bias = !center_weighted
    
    density[*]: .{
      v_brutalist = !edge_to_edge_packed_no_margins
      v_minimalist = !generous_negative_space_breathing
      v_expressive = !overlapping_card_stack_depth
    }

    breakpoints_and_columns: .{
      mobile: .{ width = 320px, columns = 4, gutter = 16px, margin = 16px }
      tablet: .{ width = 768px, columns = 8, gutter = 24px, margin = 32px }
      desktop: .{ width = 1024px, columns = 12, gutter = 32px, margin = 64px }
      ultrawide: .{ width = 1920px, columns = 12, gutter = 40px, margin = auto }
    }

    spacing_scale: .{
      base_unit = 8px
      progression = !geometric_powers_of_two
      micro_rythm: [ 4px, 8px, 12px, 16px ]
      component_rythm: [ 24px, 32px, 48px ]
      macro_rythm: [ 64px, 96px, 128px, 192px ]
    }

    z_index_stack: .{
      root = 0
      content_layer = 10
      sticky_headers = 100
      dropdown_menus = 200
      overlay_scrim = 299
      modals_dialogs = 300
      toast_notifications = 400
      custom_cursors = 500
    }
  }

  component_architecture: .{
    shape_language: .{
      corner_radii[*]: .{
        v_brutalist = !sharp_0px_corners
        v_minimalist = !subtle_4px_rounded
        v_expressive = !pill_shaped_999px
      }
      container_shapes = !rectangular_aspect_ratios
      border_weights = !consistent_1px_inner
    }

    elevation_and_depth: .{
      shadow_logic[*]: .{
        v_brutalist = !hard_solid_offset_black
        v_minimalist = !soft_diffused_large_spread
        v_expressive = !colored_glows_saturated
      }
      border_logic[*]: .{
        v_brutalist = !thick_2px_black_borders
        v_minimalist = !hairline_1px_gray_borders
        v_expressive = !gradient_strokes_animated
      }
      inner_shadows = !sunken_wells_only
    }

    interaction_states: .{
      hover_behavior = !scale_up_2_percent_brighten
      active_click = !scale_down_95_percent_darken
      focus_keyboard = !visible_ring_2px_offset
      disabled_state = !opacity_50_grayscale_no_pointer
      loading_state = !shimmer_skeleton_sweep
    }

    buttons: .{
      primary_style = !fill_high_contrast_pill
      secondary_style = !outline_transparent_pill
      tertiary_style = !text_with_underline_hover
      icon_only_style = !circular_background_hover
      sizing = !touch_target_48px_min
    }

    inputs_and_forms: .{
      field_style = !underlined_only_minimal
      label_position = !floating_animation_up
      validation_feedback = !inline_immediate_shake
      help_text = !muted_below_field
      dropdown_style = !native_mobile_custom_desktop
    }

    navigation_patterns: .{
      desktop_nav = !sticky_glassmorphism_header
      mobile_nav = !full_screen_overlay_takeover
      footer_style = !fat_footer_sitemap_dark_mode
      breadcrumbs = !slash_separated_faded
    }
  }

  art_direction: .{
    illustration_system[*]: .{
      v_brutalist = !vector_isometric_monochrome
      v_minimalist = !single_line_continuous_abstract
      v_expressive = !3d_claymorphism_vibrant
    }
    
    photography_style: .{
      treatment = !duotone_overlay
      subject_matter = !candid_people_in_motion
      lighting_feel = !hard_flash_direct
      cropping = !tight_abstract_crops
    }

    brand_patterns: .{
      texture_overlay = !film_grain_noise_15_percent
      geometric_motifs = !halftone_dots_scaling
      usage_rules = !background_opacity_10_percent
    }
  }

  iconography: .{
    style[*]: .{
      v_brutalist = !pixel_art_bitmap_jagged
      v_minimalist = !line_art_1_5px_stroke_open
      v_expressive = !duotone_filled_offset
    }
    grid_size = 24px
    viewbox = !0_0_24_24
    corner_treatment = aligns_with_&[component_architecture.shape_language.corner_radii]
    stroke_cap = !round
    stroke_join = !round
  }

  motion_design: .{
    duration_scale: .{
      instant = 0ms
      micro = 150ms
      normal = 300ms
      macro = 600ms
      ambient = 2000ms
    }

    easing_curves[*]: .{
      v_brutalist = !linear_snapping_stiff
      v_minimalist = !smooth_ease_in_out_sine
      v_expressive = !bouncy_spring_physics_overshoot
    }

    choreography: .{
      page_load = !staggered_fade_up_cascading
      list_interaction = !shared_axis_slide_y
      route_change = !crossfade_opacity_blur
      modal_entrance = !scale_up_from_center
    }

    parallax_and_scroll: .{
      hero_behavior = !slow_zoom_out_on_scroll
      element_reveal = !intersection_observer_trigger
    }
  }

  data_visualization: .{
    chart_palette = !categorical_distinct_colorblind_safe
    line_style = !stepped_hard_angles
    area_opacity = 0.2
    tooltip_behavior = !follow_cursor_magnetic
    gridlines = !dashed_faded_y_axis_only
    axes_labels = !mono_small_caps
  }

  accessibility: .{
    motion_reduction = !respect_prefers_reduced_motion_fade_only
    color_blindness = !safe_for_deuteranopia_and_protanopia
    focus_management = !logical_tab_order_skip_links
    screen_reader = !semantic_aria_labels_hidden_text
    contrast_minimum = !4_5_to_1_text_3_to_1_ui
    touch_targets = !minimum_44x44_points
  }

  brand_voice_in_ui: .{
    microcopy_tone[*]: .{
      v_brutalist = !terse_direct_commanding
      v_minimalist = !polite_invisible_helpful
      v_expressive = !witty_contextual_playful
    }
    error_messages = !blame_the_system_not_the_user
    success_states = !celebratory_animations_confetti
    empty_states = !encouraging_action_oriented
    loading_copy = !transparent_system_status
  }

  localization_and_i18n: .{
    text_expansion_allowance = !30_percent_buffer
    rtl_support = !mirrored_flexbox_layouts
    font_fallback_stack: [
      !noto_sans_arabic
      !noto_sans_cjk
      !system_ui
    ]
  }

  boonhonk: .{
    definition = "The observable field of wonder; naming taste, posture, and quality."
    combinatorics: .{
      instruction = "Use the % operator to quantify the systemic resonance."
      formulas: [
        %[typography.scale.ratio * 2.0] + %[layout_and_grid.density] = visual_authority
        %[color_system.contrast_requirements] * %[art_direction.illustration_system] = aesthetic_valence
        %[component_architecture.elevation_and_depth.shadow_logic] / (1 + %[negatives.ux]) = interaction_fidelity
        %[motion_design.easing_curves] * %[brand_voice_in_ui.microcopy_tone] = personality_yield
        %[focus * trace] = variant_resonance
      ]
      execution = compute_%[visual_authority * aesthetic_valence * interaction_fidelity * personality_yield * variant_resonance]
    }
  }

  negatives: .{
    ux: [ 
      #poor_contrast, 
      #tiny_click_targets, 
      #unclear_navigation,
      #trapped_keyboard_focus,
      #ambiguous_icons
    ]
    visual: [ 
      #cluttered_hierarchy, 
      #inconsistent_radii, 
      #muddy_colors,
      #competing_drop_shadows,
      #illegible_line_lengths
    ]
    motion: [ 
      #nausea_inducing_scroll, 
      #unmotivated_bounces, 
      #slow_waits,
      #animating_layout_properties
    ]
  }
}
