# Expressions Index
#
# Named utterance shapes — how a world moment is said across media.

#>spw_prompts_expressions_index
#:expression #!catalog
#:layer #!creative

^"intent"{
 ~#goal: "Reusable expression templates: still, motion, prose, sound, embodied — same Underroot, different mouth."
 ~#taste: "form first; content plugs from biome/signature"
}

^"roots"{
 @biome: ~"../biome/underroot.spw"
 @mj: ~"../labs/midjourney.spw"
 @film: ~"../production/film.spw"
}

^"expressions"{
 still_hero: .{
  id: #still_hero
  media: #image
  shape: "subject + light + materials + one secondary prop"
  mj_pack: #pack_build
 }

 env_wide: .{
  id: #env_wide
  media: #image
  shape: "place as character; figure optional scale"
 }

 process_beat: .{
  id: #process_beat
  media: [#image, #film]
  shape: "hands-tool-material triad"
 }

 threshold_cross: .{
  id: #threshold_cross
  media: [#image, #film, #experience]
  shape: "path → lintel → interior light delta"
 }

 inventory_fold: .{
  id: #inventory_fold
  media: #image
  shape: "many care-objects → one board"
 }

 turnaround_sheet: .{
  id: #turnaround_sheet
  media: #image
  shape: "multi-view costume lock"
 }

 section_teach: .{
  id: #section_teach
  media: [#image, #diagram]
  shape: "zones of house as cutaway"
 }

 lyric_crumb: .{
  id: #lyric_crumb
  media: #song
  shape: "sensory couplet + craft verb"
 }

 scenelet: .{
  id: #scenelet
  media: #film
  shape: "30–90s dramatic unit with dept handles"
 }

 dwell: .{
  id: #dwell
  media: #experience
  shape: "room-scale stay with climate + haptic"
 }
}

^"bind"{
 law: "expression + organ + lens + facet → emit"
 example: "#still_hero & #portrait & #care_duty & #glaze_morning"
}

~<../handles/index.spw>
