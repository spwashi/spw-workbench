# Biome: Underroot
#
# Prime imaginative ground — a living understory of soil, oven-warmth, soft law,
# and hush. Worldbuilding begins here. Do not name genre; let materials speak.

#>spw_biome_underroot
#:biome #!prime
#:layer #!creative
#:status #!active

^"intent"{
 ~#goal: "A naturally prime biome for unique worldbuilding — hospitable, patterned, slightly enchanted through craft and ecology rather than declared genre."
 ~#taste: "loam, yeast, canopy filter, copper, hush; wonder as weather"
 ~#status: "active"
 ~#not: "do not label as fairytale, high fantasy, or portal-quest in emit text unless an agent deliberately breaks the membrane"
}

^"roots"{
 @ecology: ~"../script-ecology.spw"
 @vibes: ~"../vibes/index.spw"
 @culinary: ~"../domains/culinary-fantasy/index.spw"
 @metaphysics: ~"../metaphysics/index.spw"
 @lenses: ~"../lenses/index.spw"
 @facets: ~"../facets/index.spw"
 @handles: ~"../handles/index.spw"
 @expressions: ~"../expressions/index.spw"
 @mj: ~"../labs/midjourney.spw"
 @film: ~"../production/film.spw"
 @experiential: ~"../labs/experiential.spw"
 @sagas: ~"../sagas/index.spw"
}

^"identity"{
 name = underroot
 epithet = the_soft_dark_that_feeds
 breath = "soil exhales warm bread-steam; roots keep house; light arrives as permission, not conquest"
 prime_qualities: [
  #hospitable_pattern   // rooms and paths feel intended for care
  #material_magic       // enchantment is yeast, mycelium, score marks
  #scaled_to_hands      // wonder fits a loaf, a jar, a doorway
  #moral_weather        // kindness and thrift change the light
  #threshold_ordinary   // doors matter more than armies
 ]
 anti_qualities: [
  #empire_spectacle
  #neon_metropolis
  #grimdark_only
  #chosen_one_billboard
 ]
}

// ── Biome strata (vertical ecology) ────────────────────────────

^"strata"{
 canopy: .{
  ~#sense: light_filter
  stuff: [ #oak_and_elder, #leaf_caustics, #bird_quiet, #rain_held_above ]
  mood: #permission_of_day
 }
 threshold: .{
  ~#sense: entry
  stuff: [ #path_of_moss, #carved_lintel, #steam_at_door, #bell_or_none ]
  mood: #invited_step
 }
 hearth_band: .{
  ~#sense: craft_warmth
  stuff: [ #oven_mouth, #shelf_of_loaves, #linen, #copper, #flour_weather ]
  mood: #work_as_devotion
 }
 loam: .{
  ~#sense: living_structure
  stuff: [ #mycelium_ribs, #packed_earth_arch, #root_plumbing, #clay_jars ]
  mood: #body_of_the_house
 }
 dark_water: .{
  ~#sense: memory_cool
  stuff: [ #spring_seep, #slate, #salt_crust, #quiet_drip ]
  mood: #old_patience
 }
}

// ── Beings & relations (cast without tropes) ───────────────────

^"relations"{
 makers: [ #baker, #miller, #jar_keeper, #path_mender ]
 kin_of_place: [ #shelf_mycelium, #oven_breath, #starter_culture ]
 visitors: [ #morning_buyer, #lost_walker, #child_with_seed ]
 law: "Beings are defined by care-duties and materials they handle, not by titles of power."
}

// ── Local reference atlas ──────────────────────────────────────

^"atlas"{
 places: #[
  ~#spore_cellar
  ~#oven_chamber
  ~#flour_loft
  ~#front_shop
  ~#forest_path
  ~#millstone_nook
  ~#honey_ledge
 ]
 objects: #[
  ~#scored_boule
  ~#clay_starter
  ~#banneton
  ~#lame
  ~#peel
  ~#seed_scatter
 ]
 times: #[
  ~#pre_dawn_proof
  ~#first_peel
  ~#market_hour
  ~#ember_night
 ]
}

// ── Branches of the biome (story/world forks) ──────────────────

^"branches"{
 ~#protocol: "A branch is a sustained fork of Underroot; facets are temporary tilts. Register branches here before multi-file expansion."

 main: .{
  id: #hearthwood_main
  bias: ~[honey:0.5, rye:0.3, canopy:0.2]
  use: "default hearth + baking craft"
 }

 night_seep: .{
  id: #night_seep
  bias: ~[mineral:0.4, spore:0.4, biolume:0.2]
  use: "cooler metaphysics, cellar memory, soft otherworld without horror"
 }

 market_day: .{
  id: #market_day
  bias: ~[honey:0.4, smoke:0.2, market:0.4]
  use: "social density, trade, baskets, daylight honesty"
 }

 storm_held: .{
  id: #storm_held
  bias: ~[smoke:0.3, rye:0.3, hearth:0.4]
  use: "closed door, thicker steam, moral weather high"
 }
}

^"open"{
 ?[name_discipline]: "When may emit text use storybook words without breaking the no-genre-label membrane?"
 ?[branch_file]: "Promote night_seep to its own signature when asset_refs stabilize?"
}

~<../vibes/index.spw>
~<../domains/culinary-fantasy/index.spw>
~<../metaphysics/index.spw>
~<../script-ecology.spw>
