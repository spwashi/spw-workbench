# Compose — substrate → emit
#
# How to assemble a host-facing prompt from Spw anatomy without
# naming engines or reciting opposites.

#>spw_prompt_compose
#:prompt #!compose
#:layer #!pragmatics

^"roots"{
 @substrate: ~"./index.spw"
 @tone: ~"./tone-anatomy.spw"
 @handles: ~"../handles/index.spw"
}

^"intent"{
 ~#goal: "One compose path: register → domain → optics → positive traits → *emit → %measure."
 ~#taste: "short path; one mutation when retuning"
}

^"path"{
 1: "Load #voice_* register from @tone (or build ~ blends per dimension)"
 2: "Bind domain root — @website  @design  @mj  @film  task-local"
 3: "Optional: ≤2 #lens, ≤2 facets"
 4: "Write ~#traits as positive fill only"
 5: "Optional =bias constraints in positive form"
 6: "*emit host packet (prose / MJ string / UI copy / code scaffold)"
 7: "%measure hold; if fail, >>mutate one tone dimension"
}

^"emit_shapes"{
 prose_brief: .{
  sections: [ #intent, #register, #must_fill, #acceptance ]
  must_fill: "bullet positive traits — no 'avoid X' spine"
 }

 mj_pack: .{
  via: ~"../labs/midjourney.spw"
  inject: "tone material + temperature phrases into light/material banks"
  negatives: "structural only (anatomy, chrome UI) — not tonal insults"
 }

 web_copy: .{
  via: ~"../website.prompt.spw"
  register_default: #voice_web_quiet
  fill: "one hero claim, one proof, one door (CTA)"
 }

 eng_note: .{
  register_default: #voice_patient_precise
  fill: "context, constraint, acceptance, path refs"
 }

 // publishing hosts (see domains/publishing)
 brief: .{
  via: ~"../domains/publishing/templates/job.spw"
  fill: "goal, audience, claim, acceptance; hold title anchors"
 }

 copy: .{
  fill: "headline, dek, body, door"
 }

 audio: .{
  fill: "cold_open, spine, cta, duration"
 }

 social: .{
  fill: "hook, body, door — thrift"
 }
}

^"positive_examples"{
 web_hero: `
^["emit"]{
 register: #voice_web_quiet
 ~#claim: "A small tool that keeps craft readable."
 ~#proof: "one screen, one verb, thrift of chrome"
 ~#door: "Open the board"
 *copy: "Keep the work visible. One screen. One clear next step."
}
 `

 retune: `
>>[t] measure — density too lush for docs
>>[t] mutate — #tone_density sparse:0.8
>>[t] emit — same intent, thinner clauses
`
}

^"anti_patterns"{
 #[
  "Opposite-list as the brief ('not X, not Y, not Z')"
  "Vendor/engine names inside register definitions"
  "Mutating three tone dimensions in one step"
  "Empty register name with no pole fill"
 ]
}

~<./tone-anatomy.spw>
~<./index.spw>
