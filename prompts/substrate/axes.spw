# Substrate Axes — dimensional relationship cache
#
# Portable cache of abstract axes for PE, sagas, and emit.
# Theory law: docs/theory/spw/dimensional-axes.spw
# Machine twin: packages/spw-cli/src/emit/axes.ts
#
# Math first; subjective hooks for play; ops for CLI/saga binding.
# Context-sensitive salience reweights attention — never genotype text.

#>spw_prompt_axes
#:prompt #!axes
#:layer #!pragmatics
#:status #!active

^"intent"{
 ~#goal: "Cache dimensional relationships so agents and tools share one axis vocabulary with context salience."
 ~#taste: "short ids; named formulas; hooks that invite literacy without moralizing"
}

^"roots"{
 @theory: ~"../../docs/theory/spw/dimensional-axes.spw"
 @tone: ~"./tone-anatomy.spw"
 @compose: ~"./compose.spw"
 @optimize: ~"../sagas/optimize.spw"
 @profiles: ~"../sagas/profiles.spw"
 @publish: ~"../domains/publishing/propagate.spw"
 @expressions: ~"../expressions/index.spw"
 @wonder: ~"../../docs/library/spw/wonder-calculus.spw"
}

// ── Axis catalog (ids only; math in theory + axes.ts) ──────────

^"families"{
 tempo: #[ #tempo.production, #tempo.product, #tempo.language ]
 literacy: #[ #literacy.form, #literacy.agency, #literacy.evidence, #literacy.memory ]
 hold: #[ #hold.positive, #hold.continuity, #hold.style, #hold.subject, #hold.genre, #hold.thrift ]
 search: #[ #search.coordinate, #search.budget, #search.grade, #search.objective ]
 valence: #[ #valence.quality ]
 circulation: #[ #circulation.channel, #circulation.scarcity, #circulation.continuity, #circulation.spectacle ]
 play: #[ #play.intrigue, #play.expression, #play.motif ]
 language: #[ #language.id, #language.reading, #language.alias, #language.dual_read ]
}

// ── PE mutate coordinates (operational expressiveness) ─────────

^"pe_coordinates"{
 // Maps saga/fractal coordinates → axis families they primarily touch
 axis_light: #literacy.form
 axis_density: #literacy.form
 axis_craft: #literacy.form
 axis_flavor: #literacy.form
 axis_era: #literacy.form
 tone_dim: #literacy.form
 style_phrase: #hold.style
 subject_cast: #hold.subject
 genre_contract: #hold.genre
 host_slot: #circulation.channel
 emit_phrasing: #hold.positive
 ladder_step: #search.coordinate
 fractal_depth: #search.budget
 macro_fill: #play.intrigue
}

// ── Context salience (authoring defaults) ──────────────────────
// Boost lists are priority order; machine normalizes to ŵ.

^"contexts"{
 #production: .{
  boost: #[ #hold.positive, #hold.continuity, #play.intrigue, #tempo.production, #circulation.channel ]
  damp: #[ #tempo.language, #circulation.scarcity ]
  default_profiles: #[ pe_style_lock, pe_thrift_social, fractal_merge ]
  grade_hint: "effect.l1.memory"
 }

 #canon: .{
  boost: #[ #literacy.evidence, #literacy.memory, #hold.style, #hold.subject, #hold.genre ]
  damp: #[ #play.intrigue, #tempo.production ]
  default_profiles: #[ line_propagate ]
  grade_hint: "effect.l2.workspace"
  gate: "Hold≥θ ∧ multi-host evidence ∧ episode"
 }

 #research: .{
  boost: #[ #search.coordinate, #search.budget, #literacy.agency, #tempo.language, #valence.quality ]
  damp: #[ #circulation.scarcity ]
  default_profiles: #[ fractal_style_repo, hybrid_organ_ladder ]
  grade_hint: "effect.l0.measure"
 }

 #pedagogy: .{
  boost: #[ #literacy.form, #literacy.agency, #literacy.evidence, #literacy.memory, #play.expression, #valence.quality ]
  damp: #[ #circulation.spectacle ]
  default_profiles: #[ pe_style_lock ]
  grade_hint: "effect.l1.memory"
  spine: "Y1 form → Y2 duals → Y3 search → Y4 circulation"
 }

 #merch: .{
  boost: #[ #play.motif, #circulation.scarcity, #language.reading, #hold.continuity, #tempo.product ]
  damp: #[ #tempo.production ]
  law: "SKU = expression × motif × profile_revision; market tags after genotype"
 }

 #layout: .{
  boost: #[ #search.grade, #literacy.form ]
  damp: #[ #hold.genre ]
  default_profiles: #[ layout_canonical, layout_equiv_preview ]
 }

 #thrift: .{
  boost: #[ #hold.positive, #hold.thrift, #hold.continuity, #circulation.channel ]
  damp: #[ #hold.genre, #play.motif ]
  default_profiles: #[ pe_thrift_social ]
 }
}

// ── Formulas (hooks for humans; exact in theory/axes.ts) ───────

^"formulas"{
 F1_packet: "Packet = Emit(register, traits+, locks, host)"
 F2_hold: "Hold = product of hold.* raised to salience α(c)"
 F3_step: "one coordinate per mutate unless !bonk"
 F4_promote: "Canonize iff Hold≥θ and evidence and episode"
 F5_share: "Shared toys + layered depth (intergenerational)"
 F6_live: "Meaning = stable id + reading + alias + dual-read"
 F7_valence: "boon|bane|bone|bonk|honk — not pass/fail"
 F8_literacy: "L = Form · Agency · Evidence · Memory"
}

// ── Relationship edges (cache for agents) ──────────────────────

^"relations"{
 // from → to : rel
 "tempo.production → tempo.product": #feeds_faster
 "tempo.product → tempo.language": #feeds_faster
 "literacy.evidence → hold.*": #implements
 "hold.* → circulation.channel": #feeds
 "search.coordinate → literacy.agency": #implements
 "play.expression → play.motif": #feeds
 "language.reading → circulation.scarcity": #gates
 "F4_promote → tempo.product|tempo.language": #gates
 "valence.quality ↔ literacy.form": #dual
}

// ── Subjective hooks (play / pedagogy only) ────────────────────

^"hooks"{
 #hold.positive: "Want what you want — do not build the brief from 'not X'."
 #literacy.agency: "One deliberate move beats three vibes in a trenchcoat."
 #tempo.language: "New operators are decades; packets are lunch."
 #play.intrigue: "Leave a hole `_` so the next generation can fill it."
 #circulation.scarcity: "Pin the revision before the poster leaves the press."
 #valence.quality: "Constraint is not failure; glow is not victory."
 #F8_literacy: "If memory is zero, you are performing, not teaching."
}

// ── Compose recipe ─────────────────────────────────────────────

^"compose_with_axes"{
 1: "Pick context (#production default for jobs)"
 2: "Pick profile whose default_profiles includes context (or override)"
 3: "Mutate one pe_coordinate; measure hold family"
 4: "Reweight via context salience only for score/UI — locks stay text"
 5: "Promote (#canon) only through F4 gate"
 6: "Merch only after language.reading pin + expression/motif ids"
}

~<./tone-anatomy.spw>
~<./compose.spw>
