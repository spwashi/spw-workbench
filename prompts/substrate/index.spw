# Spw as Prompt Engineering Substrate
#
# .spw surfaces are not only creative briefs. They are addressable tone,
# register, and constraint anatomy for any generation task — image, prose,
# code, UI copy, research — without naming engines or vendors.

#>spw_prompt_substrate
#:prompt #!substrate
#:layer #!pragmatics
#:status #!active

^"intent"{
 ~#goal: "Use Spw constructs as the engineering layer for prompts: dimensions, handles, positive anchors, compose paths, measure."
 ~#taste: "speak toward the wanted field; ground the opposite by presence, not by reciting absence"
 ~#status: "active"
}

^"roots"{
 @tone: ~"./tone-anatomy.spw"
 @compose: ~"./compose.spw"
 @axes: ~"./axes.spw"
 @theory_axes: ~"../../docs/theory/spw/dimensional-axes.spw"
 @handles: ~"../handles/index.spw"
 @ecology: ~"../script-ecology.spw"
 @lenses: ~"../lenses/index.spw"
 @expressions: ~"../expressions/index.spw"
 @mj: ~"../labs/midjourney.spw"
 @website: ~"../website.prompt.spw"
 @design: ~"../design.prompt.spw"
}

^"thesis"{
 claim: "A prompt is a navigable Spw document: axes hold nuance, handles address dimensions, *emit collapses to the host medium, %measure checks hold."
 claim_positive: "Desired tone is stated as material presence. Undesired tone is not listed; it is displaced by a full positive field."
 claim_agnostic: "Registers name feel-physics, not products or vendors. Swap hosts without rewriting the substrate."
 claim_context: "Preserving tone is valuable whenever a task has a felt register (web craft, research, image, outreach) — recognition can be sudden and practical."
}

// ── Spw constructs → PE roles ──────────────────────────────────

^"construct_map"{
 ^frame: "section of prompt anatomy (identity, constraints, emit)"
 @root: "named perspective / load path into another surface"
 ~path: "file or asset reference (portable)"
 ~#trait: "concise property the generator must honor"
 #topic: "membership chip / conceptual class"
 ?probe: "open research or design question (non-closing)"
 *collapse: "emit packet for the host (string, JSON, code scaffold)"
 %measure: "hold checks — clarity, warmth, precision, …"
 =bias: "forcing constraint (positive form preferred)"
 !act: "valence or kinetic posture (boon/bane as quality, not insult)"
 [select]: "choose one organ, facet, or register"
 .{facet}: "local property bag"
 >>stream: "mutation saga of tone experiments"
}

// ── Positive grounding law ─────────────────────────────────────

^"positive_ground"{
 #:semantics #!boon_first

 law: "State the wanted field completely enough that the opposite has no room. Do not summon the opposite by name in the emit body."

 boon_form: "warm, patient, material, specific, hospitable, … (present nouns and verbs)"
 refuse_form: "do not write 'not cold', 'not corporate', 'not slangy' as the primary method — instead write the warm/patient/plain-precise field until it occupies the channel"

 when_negatives_allowed: .{
  media: "image/video hosts that require a separate negative channel"
  placement: "neg_bank or host-negative field only — never as the spine of the brief"
  content: "structural failure modes (extra fingers, unreadable UI) not tonal insults"
 }

 examples: #[
  .{
   weak: "not stiff, not robotic, not generic"
   strong: "plain speech, specific nouns, one clear next step, human scale"
  }
  .{
   weak: "don't make it look like a casino or crypto landing"
   strong: "quiet craft UI, thrift of chrome, loam-and-linen palette, one primary action"
  }
  .{
   weak: "avoid sounding like model A or model B"
   strong: "register: #voice_patient_precise — short sentences, evidence first, no flourish tax"
  }
 ]
}

// ── Layers of a substrate prompt ───────────────────────────────

^"anatomy_layers"{
 1_intent: "^[\"intent\"] ~#goal ~#taste — why this generation exists"
 2_register: "tone handles from @tone — how it should feel"
 3_domain: "task surface (web, image, research, …) with local roots"
 4_optics: "optional #lens + facet (≤2 each)"
 5_constraints: "positive =bias and ~#traits; structural neg only if host needs"
 6_emit: "*collapse to host packet"
 7_measure: "%hold axes after generation"
 8_saga: ">>mutate one dimension if retuning"
}

^"agent_protocol"{
 steps: [
  "1. Load @tone — pick register blend ~[a:w, b:w]"
  "2. Name domain root (@website, @mj, …)"
  "3. Attach ≤2 lenses; set positive ~#traits"
  "4. *emit without opposite-lists in body"
  "5. %measure; if miss, >>mutate one tone dimension only"
 ]
}

~<./tone-anatomy.spw>
~<./compose.spw>
~<../handles/index.spw>
