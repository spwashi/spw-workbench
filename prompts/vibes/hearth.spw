# Vibe: Hearth
#
# Indoor warmth, invitation, moral weather of shelter — not a brand.

#>spw_vibe_hearth
#:vibe #!hearth
#:layer #!creative

^"vibe"{
 id: #vibe_hearth
 ~#fill: "ember light, closed-door safety, shared table, thrift of fire"
 ~#tone_bias: .{
  temperature: ~[warm:0.75, cool:0.25]
  relation: ~[companion:0.6, sovereign:0.4]
  pace: ~[patient:0.6, kinetic:0.4]
 }
}

^"phrase_bank"{
 materials: [
  "ember glow"
  "shared table"
  "iron pot"
  "smoke-thrift"
  "door closed against weather"
 ]
}

^"non_bleed"{
 never_implies: [
  #conquest_hall
  #throne_room_default
  #uncontrolled_burn
 ]
}

^"rpg"{
 move_examples: [
  "Offer seat: gain trust or obligation"
  "Bank the fire: spend supply, gain shelter tag"
 ]
}

~<./index.spw>
