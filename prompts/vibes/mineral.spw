# Vibe: Mineral
#
# Crystal, slate, salt, cool aperture — structure without sterile lab.

#>spw_vibe_mineral
#:vibe #!mineral
#:layer #!creative

^"vibe"{
 id: #vibe_mineral
 ~#fill: "cut faces, salt, stone cool, rigid mouth of a frame, particle dust"
 ~#tone_bias: .{
  temperature: ~[cool:0.7, warm:0.3]
  material: ~[mineral:0.7, fused:0.2, organic:0.1]
  precision: ~[exact:0.7, suggestive:0.3]
 }
}

^"phrase_bank"{
 materials: [
  "slate counter"
  "salt crust"
  "cut crystal rim light"
  "stone cool"
  "rigid aperture"
 ]
}

^"non_bleed"{
 never_implies: [
  #chrome_lab
  #inedible_food_as_sculpture_default
  #cold_cruelty
 ]
 baking_stack_rule: "Salt and stone support cuisine; they do not replace bread with crystal props unless the scene asks."
}

^"rpg"{
 move_examples: [
  "Salt the threshold: ward or flavor, declare which"
  "Read the grain of stone: find a seam or a shelf"
 ]
}

~<./index.spw>
