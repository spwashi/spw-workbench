# Vibe: Forest
#
# Understory, path, canopy filter, living quiet — ecology without forcing cuisine.

#>spw_vibe_forest
#:vibe #!forest
#:layer #!creative

^"vibe"{
 id: #vibe_forest
 ~#fill: "leaf light, path invitation, moss, damp earth, hush, scaled wonder"
 ~#tone_bias: .{
  temperature: ~[cool:0.55, warm:0.45]
  pace: ~[patient:0.7, kinetic:0.3]
  structure: ~[spatial:0.65, linear:0.35]
  material: ~[organic:0.6, mineral:0.25, fused:0.15]
 }
}

^"phrase_bank"{
 materials: [
  "dappled canopy light"
  "moss path"
  "leaf caustics"
  "damp earth scent-hint"
  "root-rib shadow"
  "soft biolume fleck optional"
 ]
 places: [ #path, #clearing, #threshold_tree, #understory ]
 props: [ #basket, #seed, #walking_stick, #mushroom_as_flora ]
}

^"non_bleed"{
 never_implies: [
  #body_horror_fungi
  #spoiled_food
  #grimdark_wood
  #lost_forever_maze_as_default
 ]
 baking_stack_rule: "Forest mushrooms are flora or forage — they do not auto-corrupt bread, kitchens, or clean heat."
}

^"rpg"{
 move_examples: [
  "Follow a path token; the canopy answers with light or hush"
  "Forage: gain ingredient tag without spoiling camp stores"
  "Camp under leaf-filter; recover if watch is kept"
 ]
}

~<./index.spw>
