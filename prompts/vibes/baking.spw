# Vibe: Baking
#
# Craft of dough, heat, timing, and thrift — not a single shop mythology.

#>spw_vibe_baking
#:vibe #!baking
#:layer #!creative

^"vibe"{
 id: #vibe_baking
 ~#fill: "yeast-time, clean heat, scored surfaces, flour as weather, tools with jobs"
 ~#tone_bias: .{
  pace: ~[patient:0.65, kinetic:0.35]
  material: ~[organic:0.55, fused:0.3, mineral:0.15]
  authority: ~[evidenced:0.55, confiding:0.45]
 }
}

^"phrase_bank"{
 materials: [
  "flour-dusted board"
  "scored crust"
  "proofing stillness"
  "oven-amber heat"
  "linen couche"
  "salt and steam"
 ]
 actions: [
  "knead"
  "score"
  "peel"
  "wait the rise"
  "share the loaf"
 ]
 props: [ #dough, #loaf, #starter_jar, #peel, #banneton, #lame ]
}

^"non_bleed"{
 // What this vibe must NOT impose on co-stacked vibes
 never_implies: [
  #spoilage_as_default
  #mold_on_food
  #inedible_prop_bread
  #industrial_plant_line
 ]
 forest_stack_rule: "If #vibe_forest is present, mushrooms stay garnish/ecology — not rot on the loaf."
}

^"rpg"{
 move_examples: [
  "Spend a watch: tend the oven or lose the rise"
  "Trade a loaf for a true name at the counter"
  "Fail forward: dense crumb, still nourishing"
 ]
}

~<./index.spw>
