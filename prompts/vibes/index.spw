# Vibes Index
#
# Orthogonal feel-packs. Compose freely; do not fuse into one overfitted world.
# Law: mushroom soup must not cause moldy bread.

#>spw_vibes_index
#:vibe #!catalog
#:layer #!pragmatics
#:status #!active

^"intent"{
 ~#goal: "Reusable vibe handles for fantasy, culinary homebrew, web, and image — each vibe adds only its fill."
 ~#taste: "orthogonal; positive fill; no bleed of failure modes across vibes"
}

^"roots"{
 @baking: ~"./baking.spw"
 @forest: ~"./forest.spw"
 @hearth: ~"./hearth.spw"
 @market: ~"./market.spw"
 @mineral: ~"./mineral.spw"
 @tone: ~"../substrate/tone-anatomy.spw"
 @culinary: ~"../domains/culinary-fantasy/index.spw"
}

^"dispatch"{
 baking: @baking
 forest: @forest
 hearth: @hearth
 market: @market
 mineral: @mineral
}

// ── Composition law ────────────────────────────────────────────

^"compose"{
 law_orthogonal: "A vibe contributes phrase banks, tone biases, and prop classes. It does not rewrite another vibe's materials."
 law_non_bleed: "Failure and rot of one vibe never auto-apply to another. Mushroom/forest life ≠ spoiled bread. Smoke ≠ burnt failure unless chosen."
 law_stack: "Stack ≤3 vibes. Name them as handles. If conflict, keep both fills; do not invent a hybrid failure."
 law_positive: "Displace unwanted tone by filling the wanted vibe — do not spine the brief with opposite-lists."
 blend: "~[baking:0.5, forest:0.35, hearth:0.15] means weights of presence, not a new fused mythology."
}

^"non_bleed_examples"{
 #[
  .{pair: "forest + baking", ok: "canopy light on a clean loaf", refuse: "forest mold on edible bread"}
  .{pair: "mineral + baking", ok: "slate counter, salt crust", refuse: "crystal loaf as inedible prop by default"}
  .{pair: "market + forest", ok: "baskets, leaf shade, trade path", refuse: "wild hunt violence as default market beat"}
  .{pair: "hearth + mineral", ok: "ember on stone", refuse: "cold lab chrome"}
 ]
}

^"use"{
 culinary_rpg: @culinary
 pe_only: "attach vibes to #voice_* without loading a world pack"
 image: "inject vibe phrase banks into material/light lines"
}

~<./baking.spw>
~<./forest.spw>
~<../domains/culinary-fantasy/index.spw>
