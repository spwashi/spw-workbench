# Vibe: Market
#
# Trade, baskets, daylight honesty, many hands — social density without carnival default.

#>spw_vibe_market
#:vibe #!market
#:layer #!creative

^"vibe"{
 id: #vibe_market
 ~#fill: "stall light, fair measure, spoken prices, thrift of chrome, path between baskets"
 ~#tone_bias: .{
  density: ~[lush:0.55, sparse:0.45]
  pace: ~[kinetic:0.55, patient:0.45]
  authority: ~[evidenced:0.6, confiding:0.4]
  relation: ~[companion:0.5, sovereign:0.5]
 }
}

^"phrase_bank"{
 materials: [
  "linen awning"
  "honest daylight"
  "stacked baskets"
  "chalk tally"
  "copper weight"
 ]
}

^"non_bleed"{
 never_implies: [
  #casino_glare
  #scam_as_default_tone
  #military_recruitment_fair
 ]
}

^"rpg"{
 move_examples: [
  "Haggle: risk reputation for better rate"
  "Read the stall: learn a rumor ingredient"
 ]
}

~<./index.spw>
