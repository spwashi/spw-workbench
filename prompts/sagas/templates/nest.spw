# Saga template — fractal nest/fold
#
# Copy to runs/; expand; append stream.

#>spw_saga_nest_template
#:saga #!template
#:layer #!creative

^"intent"{
 ~#goal: "Ready nest/fold saga under fractal_merge or fractal_style_repo."
 ~#taste: "& => {&}; one child coordinate; fold with valence"
}

^"roots"{
 @schema: ~"../schema.spw"
 @fractal: ~"../fractal.spw"
 @math_search: ~"../../math/search.spw"
 @hold: ~"../../math/hold.spw"
}

^"saga"{
 id: $saga_id
 kind: #fractal
 profile: ${profile=fractal_merge}
 grade_cap: ${grade=effect.l1.memory}
 objective: #fractal_hold
 parent: ${parent=}
 depth: 0
 status: #open
}

^"bindings"{
 style_id: ${style_id=_}
 organ: ${organ=#portrait}
 host: ${host=mj}
 locus: ${locus={&}}
 max_depth: ${max_depth=2}
 seed: ${seed=& => {&}}
}

^"stream"{
 >>[0] observe — seed & @${organ} host $host
 >>[1] expand  — fill bindings; seed ${seed}
 >>[2] pulse   — ladder op:& wrap → {&}
 >>[3] nest    — depth+1 locus ${locus} profile $profile
 // child mutates one coordinate inside nest
 >>[4] measure — %fractal_hold w(d)
 >>[5] decide  — !boon keep | !bane revert
 >>[6] fold    — child via & → {&} valence !boon
 >>[7] emit    — hosts via emit fractal --profile $profile
}

~<../schema.spw>
