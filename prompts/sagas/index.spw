# Mutation Sagas Index
#
# Customizable / optimizable / fractal saga home.
# Append-only streams; macros for thrift; profiles for process packs.

#>spw_prompts_sagas_index
#:prompt #!saga
#:layer #!pragmatics
#:status #!active

^"intent"{
 ~#goal: "Navigate saga schema, macros, fractal law, optimize loop, and profiles."
 ~#taste: "one coordinate per mutate; & => {&} for nests; measure before lock"
}

^"roots"{
 @schema: ~"./schema.spw"
 @macros: ~"./macros.spw"
 @fractal: ~"./fractal.spw"
 @optimize: ~"./optimize.spw"
 @profiles: ~"./profiles.spw"
 @template: ~"./templates/stream.spw"
 @template_nest: ~"./templates/nest.spw"
 @template_line: ~"./templates/line.spw"
 @templates_tree: ~"../templates/index.spw"
 @math: ~"../math/index.spw"
 @example: ~"./runs/quiet-craft-light.spw"
 @ecology: ~"../script-ecology.spw"
 @publish: ~"../domains/publishing/propagate.spw"
 @docs: ~"../../docs/runtime/md/mutation-sagas.md"
}

^"dispatch"{
 schema: @schema
 macros: @macros
 fractal: @fractal
 optimize: @optimize
 profiles: @profiles
 template: @template
 template_nest: @template_nest
 template_line: @template_line
 templates_tree: @templates_tree
 math: @math
 example_run: @example
}

^"law"{
 from: @schema
 stream: ">>[time] type — content"
 types: #[
  #observe, #mutate, #measure, #decide, #lock, #reject,
  #expand, #pulse, #nest, #fold
 ]
 fractal_anchor: "& => {&}"
 optimize: @optimize
}

^"quickstart"{
 1: "Copy templates/stream.spw|nest.spw|line.spw → runs/<id>.spw"
 2: "emit expand runs/<id>.spw --bind … or fill ^bindings by hand"
 3: "Pick profile from profiles.spw"
 4: "Append >> mutate one coordinate; measure; decide"
 5: "Optional nest at {&}; fold with valence"
 6: "Lock only at effect.l2.workspace when slots complete + objective holds"
 7: "Medium experts: prompts/templates/media/* + math includes"
}

~<./schema.spw>
~<./macros.spw>
~<./fractal.spw>
~<./optimize.spw>
~<./profiles.spw>
