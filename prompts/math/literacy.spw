# Include: Literacy product (F8)
#
# Intergenerational + pedagogy spine.

#>spw_math_literacy
#:math #!literacy
#:layer #!semantics

^"form"{
 id: #F8_literacy
 latex: "L = Form · Agency · Evidence · Memory"
 domain: "each ∈ [0,1]; any zero collapses L"
}

^"factors"{
 Form: "register + traits+ + syntax integrity (proxy: emit complete)"
 Agency: "single_coordinate_steps / total_mutate"
 Evidence: "Hold_c (F2)"
 Memory: "locks bound + revision pin (+ inject flags in emit snapshot)"
}

^"hooks"{
 pedagogy: "Y1 form → Y2 duals → Y3 search → Y4 circulation"
 play: "open holes raise intrigue; filled locks raise memory"
 expert: "report L alongside Hold on fractal --measure"
}

^"zero_law"{
 "L=0 if mute consumption (Form), thrash (Agency), unproven (Evidence), or amnesia (Memory)"
}
