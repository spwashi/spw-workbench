# Include: Search ethics (F3) + budgets
#
# One coordinate; budgets; grade caps.

#>spw_math_search
#:math #!search
#:layer #!semantics

^"form"{
 id: #F3_step
 law: "Δ_step ∈ one coordinate class unless !bonk"
}

^"budgets"{
 max_steps: 24
 max_mutate: 12
 max_bonk: 2
 max_depth: 3
 grade_cap: "effect.l0.measure" | "effect.l1.memory" | "effect.l2.workspace"
}

^"search_kinds"{
 greedy_one: "best single-coordinate candidate"
 ablate_matrix: "vary one $slot across grid"
 beam: "keep k partial fills"
 fractal_dfs: "nest depth-first; fold measured arms"
 ladder_walk: "form ladder / pulse only"
}

^"hooks"{
 expand: "template fill is #expand — not a creative leap"
 mutate: "after expand, one coordinate retune"
 nest: "& => {&} then child profile"
 expert: "medium scripts declare allowed search_kinds + grade_cap"
}
