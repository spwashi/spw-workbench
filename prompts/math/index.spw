# Math includes — portable algorithmic hooks for PE / sagas / media experts
#
# Include by path ref; do not fork formulas silently.
# Machine twin for Hold/literacy: packages/spw-cli/src/emit/axes.ts

#>spw_math_index
#:math #!catalog
#:layer #!semantics
#:status #!active

^"intent"{
 ~#goal: "Named formulas agents and medium experts include instead of inventing scores."
 ~#taste: "short includes; no opaque AI judgment; context α(c) is attention not law"
}

^"roots"{
 @hold: ~"./hold.spw"
 @literacy: ~"./literacy.spw"
 @thrift: ~"./thrift.spw"
 @search: ~"./search.spw"
 @graph: ~"./graph.spw"
 @loop: ~"./loop.spw"
 @equation: ~"./equation.spw"
 @field: ~"./field.spw"
 @axes: ~"../substrate/axes.spw"
 @theory: ~"../../docs/theory/spw/dimensional-axes.spw"
 @math_model: ~"../../docs/theory/spw/math-modeling.spw"
 @hardware: ~"../../docs/plans/md/math-hardware-roadmap.md"
 @optimize: ~"../sagas/optimize.spw"
 @kernel: "packages/spw-seed/src/math/"
}

^"dispatch"{
 hold: @hold
 literacy: @literacy
 thrift: @thrift
 search: @search
 graph: @graph
 loop: @loop
 equation: @equation
 field: @field
 axes: @axes
 math_model: @math_model
}

^"include_law"{
 path_ref: `~"./hold.spw" or ~"prompts/math/hold.spw"`
 no_silent_fork: "Fork only with derivative lineage + episode"
 machine_parity: "F2/F8 scores in emit/axes.ts must match these forms; graph/loop/equation match seed math tests"
}

^"test"{
 command: "npx vitest run packages/spw-seed/src/math/math.test.ts"
 law: "New include without a failing/passing test is thrash"
}

~<./hold.spw>
~<./literacy.spw>
~<./thrift.spw>
~<./search.spw>
~<./graph.spw>
~<./loop.spw>
~<./equation.spw>
~<./field.spw>
