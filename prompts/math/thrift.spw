# Include: Thrift (channel density)
#
# Social / web short hosts; spectacle inverse.

#>spw_math_thrift
#:math #!thrift
#:layer #!semantics

^"form"{
 id: #thrift
 latex: "thrift = 1 / max(1, sentence_estimate)"
 optional: "channel_norm · thrift  (host-specific ceiling)"
}

^"hooks"{
 objective: #thrift_first
 context: #thrift
 profiles: #[ pe_thrift_social ]
 hosts: #[ #social, #web_copy ]
 refuse: "spectacle scale as default thrift fix"
}

^"compose_with_hold"{
 thrift_first: "Hold under α(#thrift) emphasizing positive · thrift · continuity"
}
