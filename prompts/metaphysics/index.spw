# Metaphysics Index
#
# Research handles for Underroot — not dogma; probeable claims.

#>spw_prompts_metaphysics_index
#:metaphysics #!research
#:layer #!creative

^"intent"{
 ~#goal: "Enable metaphysical research as navigable Spw surfaces: questions, lenses, measures, counterexamples."
 ~#taste: "rigor without academic cosplay; wonder with falsifiers"
}

^"roots"{
 @biome: ~"../biome/underroot.spw"
 @research: ~"./research.spw"
 @lenses: ~"../lenses/index.spw"
 @ecology: ~"../script-ecology.spw"
}

^"dispatch"{
 biome: @biome
 research: @research
 lenses: @lenses
}

^"law"{
 claim_status: [#proposed, #interpretive, #measured, #implemented]
 no_hidden_axiom: "Every soft law ships with a falsify line or open probe."
}

~<./research.spw>
~<../biome/underroot.spw>
