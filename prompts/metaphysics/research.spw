# Metaphysical Research — Underroot
#
# Axes of inquiry for world, craft, and image. Agents append probes; do not
# collapse into lore dump without measure.

#>spw_metaphysics_underroot
#:metaphysics #!research
#:layer #!creative
#:status #!proposed

^"roots"{
 @biome: ~"../biome/underroot.spw"
 @culinary_fantasy: ~"../vibes/index.spw"
 @lenses: ~"../lenses/index.spw"
 @saga: ~"../sagas/index.spw"
}

^"intent"{
 ~#goal: "Treat Underroot as a research field — hospitality, material agency, threshold ethics, time-of-proof."
 ~#taste: "questions that change a Midjourney axis or a story choice"
}

// ── Research axes ──────────────────────────────────────────────

^"axes"{
 hospitality: .{
  question: ?["What must a stranger do to be fed without becoming plot furniture?"]
  handle: #hospitality
  lens: #care_duty
  image_test: "door open + steam; no military frame"
  status: #proposed
 }

 material_agency: .{
  question: ?["Where does the dough's will end and the baker's begin?"]
  handle: #material_agency
  lens: #yeast_time
  image_test: "hands listen; loaf has silhouette dignity"
  status: #proposed
 }

 threshold_ethics: .{
  question: ?["What may cross a lintel without changing the room's moral weather?"]
  handle: #threshold
  lens: #door_law
  image_test: "path→door composition; invitation over invasion"
  status: #proposed
 }

 soft_law: .{
  question: ?["Which patterns feel like custom rather than magic system?"]
  handle: #soft_law
  lens: #pattern_hospitality
  image_test: "repeated shelf geometry, thrift of props"
  status: #interpretive
 }

 time_of_proof: .{
  question: ?["How does waiting become visible without clocks?"]
  handle: #proof_time
  lens: #yeast_time
  image_test: "steam density, ember color, dough volume"
  status: #proposed
 }

 understory_mind: .{
  question: ?["What does the house remember that people forget?"]
  handle: #place_memory
  lens: #loam_memory
  image_test: "wear on boards, jar labels as patina not text"
  status: #proposed
 }

 scale_of_wonder: .{
  question: ?["How small can the marvelous be and still reorganize attention?"]
  handle: #scaled_wonder
  lens: #hand_scale
  image_test: "seed, score mark, single biolume fleck"
  status: #proposed
 }
}

// ── Method ─────────────────────────────────────────────────────

^"method"{
 steps: [
  "? open a research axis"
  "~ name a handle and bind a lens"
  "@ rotate biome branch or signature axis"
  "[ select ] an image organ or film department"
  "* emit (MJ / experiential / prose)"
  "% measure coherence against biome anti_qualities"
  ">> saga append observemutatemeasure"
 ]

 falsify_global: #[
  "Research produces only adjective stacks"
  "Magic system tables replace soft law"
  "Wonder requires conquest or chosen-one framing"
  "Genre label appears in emit without deliberate !bonk"
 ]
}

^"open"{
 ?[publish]: "Which axis deserves a standalone paper-surface in docs/theory?"
 ?[film_bind]: "Map threshold_ethics to production design vs camera first?"
}

~<../biome/underroot.spw>
~<../lenses/index.spw>
