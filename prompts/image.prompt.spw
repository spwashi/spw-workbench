# Image Generation Prompt (default projection)
#
# Default still-image surface for kitchen craft vibes. Contour kinds live under prompts/image/.
# Agents: load signature -> pick contour -> mutate one axis -> emit Midjourney text.

#>image_generation_prompt
#:image
#:generation
#:prompt
#:layer #!creative

^"roots"{
 @ecology: ~"./script-ecology.spw"
 @vibes: ~"./vibes/index.spw"
 @contours: ~"./image/index.spw"
 @portrait: ~"./image/portrait.prompt.spw"
 @saga: ~"./sagas/index.spw"
}

^"meta"{
 vibes: @vibes
 contours: @contours
 default_contour: @portrait
 saga: @saga
 ~#goal: "Stable stylistic signature projected into Midjourney-ready stills; many contours, one world."
 ~#taste: "earthy mycelial bakery fantasy — tactile, warm, restrained wonder"
 ~#status: "active"
 ~#ecology: @ecology
}

^"identity"{
 title = default
 subtitle = portrait_projection_of_signature
 version = v2
 status = draft
 intent = generate_midjourney_image_from_signature

 // Flavor-board versatility (not noir locks)
 variants: .{
  v_hearth = "Oven amber, steam, intimate craft"
  v_canopy = "Forest window light, dappled leaf caustics"
  v_biolume = "Soft cap-glow, lilac flour dust accents"
 }

 focus = *v_hearth
 trace = ~[v_hearth:0.55, v_canopy:0.3, v_biolume:0.15]
 axis_blend = ~[honey:0.5, spore:0.3, rye:0.2]
}

^"format"{
 medium = !digital_illustration
 orientation = !portrait_preferred_for_default
 aspect_ratio = 3:4
 resolution_target = 4k
 fidelity = !painterly_storybook_realism
 engine = #midjourney
 priority = !tactile_clarity_and_style_lock
}

^"brief"{
 // Inherits lore from signature; this packet is the default portrait contour
 concept: .{
  premise = a careful baker of the underroot shapes living dough while flour hangs like pollen in oven-warm air
  thesis_image = "maker and material — hands, crust, earth light"
  emotional_core[*]: .{
   v_hearth = #quiet_devotion
   v_canopy = #open_morning_ease
   v_biolume = #soft_otherworld_awe
  }
  emotional_mix: [ #quiet_devotion, #tactile_joy, #earth_belonging ]
  transformation = from raw dough uncertainty to scored loaf resolve
 }

 subject: .{
  primary_subject = #spore_baker
  subject_count = 1
  details: .{
   silhouette = clear_and_soft
   wardrobe_or_surface = !linen_apron_flour_earth_tones
   gesture = !hands_with_dough
  }
  anatomy_and_posing: .{
   eye_contact = !soft_down_or_off
   posture = !forward_careful
   hand_placement = !on_board_with_boule
  }
 }

 scene: .{
  environment_type = !fantasy_bakery_interior_shallow
  environmental_story = "the room grows from soil and timber; bread is the local weather"
  location = #underroot_oven_chamber_background
 }

 design_system: .{
  color: .{
   palette = [ #warm_ochre, #crust_brown, #cream_flour, #moss_green, #honey_amber ]
   contrast = !soft_sculptural_not_crushed_noir
  }
 }

 lighting_and_materiality: .{
  primary_source[*]: .{
   v_hearth = !oven_glow_key
   v_canopy = !window_dappled
   v_biolume = !cap_rim_cool_accent
  }
  surface_language = !flour_linen_crust_wood_mycelium_soft
 }
}

^"renderer_profile"{
 generative_engine: .{
  target = #midjourney
  sampler_notes = !engine_default_ok
  style_lock: .{
   anchors: ~"./vibes/index.spw"  // reuse style_anchors
   stylize = 150
   weird = 0
   seed = !lock_when_comparing_axes
  }
  asset_refs: .{
   style_ref = _
   character_ref = _
   winning_phrase_lock = _
  }
 }
}

^"boonhonk"{
 definition = "Wonder field for this image run."
 combinatorics: .{
  instruction = "Measure style stability against signature anchors, not novelty."
  formulas: [
   %[style_anchor_reuse] * %[tactile_material_clarity] = signature_hold
   %[hands_readability] + %[loaf_readability] = craft_truth
   %[axis_change_count_inverse] * %[wonder_ratio] = useful_imagination
  ]
  execution = compute_%[signature_hold * craft_truth * useful_imagination]
 }
}

^"resolved_brief"{
 selected_variant = *v_hearth
 working_summary = "kitchen cook portrait — flour hands, hearth light, mycelial bakery shallow background"
 contour = #portrait
 non_negotiables: [
  #single_subject
  #hands_readable
  #warm_earth_palette
  #restrained_fantasy
  #no_noir_city
 ]
}

^"emit"{
 short_prompt = "Portrait of a gentle fantasy baker with flour-dusted linen apron and readable hands shaping a scored boule on wood, warm oven-amber light, cream flour crust-brown moss honey palette, soft steam, painterly storybook realism, tactile texture, restrained woodland mycelial bakery fantasy, clear silhouette, shallow bakery interior"

 final_prompt = "Create a Midjourney-ready portrait for the culinary fantasy signature: a soft-featured baker in a flour-dusted linen apron, hands clearly dusted and working a scored boule on a worn board. Warm hearth key light, optional soft window fill. Shallow bakery interior with wood, steam, and hint of mycelium shelves — background secondary. Painterly storybook realism; materials first (flour, linen, crust, wood). Palette: warm ochre, cream, crust brown, moss, honey amber. Restrained fantasy only. Not noir, not neon city, not body-horror mushrooms, not generic warrior fantasy."

 negative_prompt = "extra fingers, melted hands, body horror fungi, glowing evil eyes, neon city, rain noir streets, chrome, plastic AI skin, watermark, text logos, crowded faces, cyberpunk, blood dark fantasy, empty spectacle"

 midjourney_flags = "--ar 3:4 --stylize 150"
 model_notes = .{
  guidance = "Load signature style_anchors; use this emit for default portrait contour. For other subjects/scripts open prompts/image/*.prompt.spw. When a run holds, write asset_refs on the signature."
  next_contours: [
   ~"./image/interior.prompt.spw",
   ~"./image/still-life.prompt.spw",
   ~"./image/exterior.prompt.spw",
   ~"./image/process.prompt.spw",
   ~"./image/diagram.prompt.spw",
   ~"./image/sheet.prompt.spw",
  ]
 }
}

^"negatives"{
 anatomy: [ #extra_fingers, #melted_hands, #warped_limbs ]
 composition: [ #cropped_hands, #busy_face_crowd, #lost_silhouette ]
 style: [ #noir_city, #neon_cyberpunk, #portfolio_dark_fantasy_default, #plastic_ai_gloss, #horror_mushroom ]
}

~<./script-ecology.spw>
~<./vibes/index.spw>
~<./sagas/index.spw>
~<./image/index.spw>
~<./image/portrait.prompt.spw>
