#>media_generation_prompt
#:video
#:generation
#:prompt
#:layer #!creative

^"media_generation" {
  identity: .{
    title = working_title
    subtitle = none
    version = v1
    status = draft
    intent = generate_dynamic_media_blueprint

    variants: .{
      v_kinetic = "Fast-paced typography, rhythm-driven cuts"
      v_documentary = "Slow pacing, b-roll heavy, ambient"
      v_abstract = "3D motion design, fluid, surreal"
    }

    focus = *v_kinetic
    trace = ~[v_kinetic:0.7, v_abstract:0.2, v_documentary:0.1]
  }

  format: .{
    aspect_ratio = !9_16_vertical
    duration = !15_seconds
    framerate = 60fps
    resolution = 4k_uhd
    color_space = !rec_709_gamma_2_4
    bitrate_target = !high_40mbps
  }

  brief: .{
    concept: .{
      core_thesis = main_video_goal
      emotional_core[*]: .{
        v_kinetic = #urgent_energy
        v_documentary = #grounded_truth
        v_abstract = #hypnotic_wonder
      }
      
      narrative_arc: .{
        hook_0_to_3s = !pattern_interrupt
        build_3_to_10s = !rapid_escalation
        payoff_10_to_15s = !logo_reveal_and_cta
      }
    }

    camera_and_rigging: .{
      motion_logic[*]: .{
        v_kinetic = !whip_pans_and_crash_zooms
        v_documentary = !handheld_organic_breathing
        v_abstract = !smooth_spline_paths_infinite
      }
      
      camera_type = !large_format_digital_cinema_camera
      
      lens_choice[*]: .{
        v_kinetic = !ultra_macro_probe_lens
        v_documentary = !vintage_character_spherical_35mm
        v_abstract = !virtual_orthographic_camera
      }
      
      stabilization = !three_axis_brushless_gimbal
      height = !chest_level
      focal_distance = !dynamic_pull
    }

    lighting_and_grip: .{
      key_light = !high_output_cob_led_through_heavy_diffusion
      fill_light = !negative_fill_flagged
      backlight = !rgb_tube_colored_rim
      
      lighting_rhythm[*]: .{
        v_kinetic = !strobing_synced_to_kick_drum_120bpm
        v_documentary = !available_window_light_motivatd
        v_abstract = !moving_gobos_and_caustics
      }
    }

    art_direction: .{
      set_design: .{
        location = !cyclorama_infinity_wall
        props = !minimal_hero_objects_only
        texture_palette = !glossy_acrylic_and_matte_rubber
      }
      
      wardrobe: .{
        style = !techwear_monochrome
        movement = !flowing_fabric_wind_machine
      }
      
      color_grading: .{
        lut_profile = !daylight_balanced_motion_picture_film
        contrast[*]: .{
          v_kinetic = !crushed_blacks_high_saturation
          v_documentary = !lifted_shadows_desaturated_greens
          v_abstract = !neon_false_color_mapping
        }
        grain = !35mm_overlay_40_opacity
        halation = !red_fringe_on_highlights
      }
    }
  }

  renderer_profile: .{
    visual_engine_and_editing: .{
      editing_rhythm[*]: .{
        v_kinetic = !on_the_snare_whip_pans
        v_documentary = !lingering_crossfades_and_holds_J_cuts
        v_abstract = !continuous_camera_morphs_match_cuts
      }
      
      transition_library: [
        #luma_fade
        #hyper_zoom
        #film_burn_overlay
        #data_moshing
      ]
      
      typography: .{
        kinetic_behavior = !scale_and_snap_overshoot
        safe_zones = !center_weighted_1080x1080_square
        typeface = !heavy_extended_grotesk
        blend_mode = !difference_or_exclusion
      }

      vfx_and_compositing: .{
        tracking = !advanced_planar_tracking
        particle_systems = !dust_motes_floating
        chromatic_aberration = !edges_only_2px
        lens_distortion = !barrel_distortion_anamorphic
      }
    }

    audio_bed: .{
      sound_design[*]: .{
        v_kinetic = !heavy_sub_impacts_and_risers
        v_documentary = !authentic_room_tone_and_cloth_movement
        v_abstract = !granular_synth_swells_and_chimes
      }
      
      music_sync = !hard_sync_to_transients_and_kicks
      
      foley_layers: [
        #whoosh_pans
        #fabric_rustle
        #sub_booms
        #glitch_stutters
      ]
      
      voiceover: .{
        presence = !dry_center_compression_heavy
        pacing = !rapid_fire_no_breaths
        eq_profile = !radio_broadcast_proximity_effect
      }

      spatial_mixing = !stereo_width_widened_on_chorus
    }

    platform_optimizations: .{
      short_form_algorithmic_feed: .{
        safe_zones = !account_for_right_side_icons_and_bottom_caption
        hook = !start_mid_sentence
        looping_logic = !seamless_visual_match_cut_end_to_start
      }
      
      short_form_social_graph_feed: .{
        cover_image = !high_contrast_frame_with_bold_text
        compression_handling = !sharpen_in_post_to_survive_platform_compression
      }
    }
  }

  boonhonk: .{
    definition = "The observable field of wonder; naming taste, posture, and quality."
    combinatorics: .{
      instruction = "Use the % operator to quantify the kinetic resonance."
      formulas: [
        %[renderer_profile.visual_engine_and_editing.editing_rhythm * 1.5] + %[renderer_profile.audio_bed.sound_design] = kinetic_gravity
        %[brief.camera_and_rigging.lens_choice] * %[brief.camera_and_rigging.motion_logic] = optical_valence
        %[renderer_profile.visual_engine_and_editing.typography.kinetic_behavior] * %[brief.concept.emotional_core] = typographical_impact
        %[renderer_profile.platform_optimizations.short_form_algorithmic_feed.looping_logic] / (1 + %[negatives.visual]) = retention_coefficient
        %[focus * trace] = variant_resonance
      ]
      execution = compute_%[kinetic_gravity * optical_valence * typographical_impact * retention_coefficient * variant_resonance]
    }
  }

  emit: .{
    output_contract = .{
      semantic_source = brief
      renderer_source = renderer_profile
      primary_deliverable = !video_blueprint
    }
    handoff_notes = "Use the brief layer for narrative, camera, lighting, and art direction, the renderer_profile layer for editing, audio, and platform handling, and negatives as anti-pattern constraints."
  }

  negatives: .{
    visual: [ 
      #jump_cuts_without_punches
      #unmotivated_camera_shake
      #text_outside_safe_zone
      #muddy_log_footage
      #default_nle_transitions
      #overused_light_leaks
      #bad_green_screen_spill
    ]
    audio: [ 
      #clipping_levels
      #dry_voiceover
      #unmixed_stock_music_volume
      #missing_room_tone
      #harsh_ess_sounds
    ]
    pacing: [
      #slow_intro_logo_reveal
      #dead_air
      #unearned_dramatic_pauses
    ]
  }
}
