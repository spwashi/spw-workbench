#>lens_sensorial
#:lens #!sense
#:layer #!creative

^"lens"{
 id: #sensorial
 ~#goal: "Cross-modal cues — scent, heat, sound implied in still image and sound design."
 channels: .{
  scent: [ #yeast, #honey, #woodsmoke, #damp_earth ]
  thermal: [ #oven_face_heat, #cool_cellar, #hand_warmth ]
  sonic: [ #dough_thud, #hiss_steam, #soft_cut_score, #distant_canopy ]
  tactile: [ #flour_dust, #crust_crack, #linen, #bark ]
 }
 mj_boost: "implied warmth and aroma through steam, glaze, moisture on crust"
 film_dept: #sound_design
 experiential: #haptic_and_climate
}

~<./index.spw>
