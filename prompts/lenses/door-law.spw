#>lens_door_law
#:lens #!threshold
#:layer #!creative

^"lens"{
 id: #door_law
 ~#goal: "Composition and ethics of entry — invitation geometry."
 biases_emit: [
  "path leads to lintel"
  "light difference inside/outside"
  "one clear crossing choice"
 ]
 suppress: [ #breached_fortress, #swarm_entry ]
 mj_boost: "threshold, open door steam, forest path to entrance"
 film_dept: #production_design
}

~<./index.spw>
