#>lens_mythic_soft
#:lens #!mythos
#:layer #!creative

^"lens"{
 id: #mythic_soft
 ~#goal: "Prime-story pressure without genre labels — pattern, hush, moral weather."
 biases_emit: [
  "custom and thrift as power"
  "small luminous details"
  "rooms that feel intended"
 ]
 suppress: [
  #fairytale_word_in_prompt   // the point: feel it, don't stamp it
  #dragon_billboard
  #prophecy_scroll_ui
 ]
 mj_boost: "storybook painterly hush, hospitable pattern, restrained wonder"
 note: "Emit may feel like old tales; copy must not say the school name unless !bonk."
 film_dept: #direction
}

~<./index.spw>
