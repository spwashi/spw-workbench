# Lenses Index
#
# Optical / interpretive instruments. A lens reframes without rewriting the biome.

#>spw_prompts_lenses_index
#:lens #!catalog
#:layer #!creative

^"intent"{
 ~#goal: "Swappable perspectives for research, MJ development, film, and experience."
 ~#taste: "named optics; compose two max unless !bonk"
}

^"roots"{
 @biome: ~"../biome/underroot.spw"
 @care: ~"./care-duty.spw"
 @yeast: ~"./yeast-time.spw"
 @door: ~"./door-law.spw"
 @hand: ~"./hand-scale.spw"
 @loam: ~"./loam-memory.spw"
 @sensorial: ~"./sensorial.spw"
 @mythic_soft: ~"./mythic-soft.spw"
}

^"dispatch"{
 care_duty: @care
 yeast_time: @yeast
 door_law: @door
 hand_scale: @hand
 loam_memory: @loam
 sensorial: @sensorial
 mythic_soft: @mythic_soft
}

^"compose"{
 law: "Primary lens + optional secondary. Third requires !bonk and saga note."
 example: "@care & @hand → portrait emit favors duty-in-fingers"
}

~<./care-duty.spw>
~<./yeast-time.spw>
~<./door-law.spw>
~<./hand-scale.spw>
~<./loam-memory.spw>
~<./sensorial.spw>
~<./mythic-soft.spw>
