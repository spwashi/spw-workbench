#>lens_care_duty
#:lens #!ethics
#:layer #!creative

^"lens"{
 id: #care_duty
 ~#goal: "See beings by what they keep alive."
 biases_emit: [
  "hands occupied with maintenance"
  "props that imply ongoing care"
  "soft hierarchy — skill not crown"
 ]
 suppress: [ #heroic_power_pose, #weapon_as_identity ]
 mj_boost: "careful hands, attended tools, quiet competence"
 film_dept: #direction_of_performance
}

~<./index.spw>
