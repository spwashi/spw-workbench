#>lens_loam_memory
#:lens #!memory
#:layer #!creative

^"lens"{
 id: #loam_memory
 ~#goal: "Place as archive — wear, residue, shelves as history."
 biases_emit: [
  "patina and thrift"
  "repeated forms (jars, scores, shelves)"
  "cool cellar notes against warm hearth"
 ]
 suppress: [ #showroom_newness, #empty_minimal_white ]
 mj_boost: "worn wood, clay jars, flour ghost-handprints, lived-in shelves"
 film_dept: #production_design
}

~<./index.spw>
