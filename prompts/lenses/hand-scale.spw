#>lens_hand_scale
#:lens #!scale
#:layer #!creative

^"lens"{
 id: #hand_scale
 ~#goal: "Wonder sized to palm, knife, loaf — not sky-empire."
 biases_emit: [
  "macro-capable detail"
  "tool grip readable"
  "face secondary to craft when needed"
 ]
 suppress: [ #city_scale_only, #army_establishing ]
 mj_boost: "tactile close detail, readable hands, loaf as landmark"
 film_dept: #camera_closeup
}

~<./index.spw>
