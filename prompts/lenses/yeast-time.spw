#>lens_yeast_time
#:lens #!temporality
#:layer #!creative

^"lens"{
 id: #yeast_time
 ~#goal: "Make duration legible through rise, steam, ember, and hush."
 biases_emit: [
  "process moments over frozen triumph"
  "volume change implied in dough"
  "warmth as clock"
 ]
 suppress: [ #explosive_action, #clock_ui_overlay ]
 mj_boost: "gentle steam, proofing stillness, oven glow as hour"
 film_dept: #editorial_rhythm
}

~<./index.spw>
