# Production ensemble model — linguistic constructs for multi-locus shows & templates
#
# Seeds nuanced multi-agent / multi-beat development without requiring
# story-domain nouns. Uses field dynamics: carriers, sites, affinity, beats.
#
# Math: prompts/math/field.spw
# Publish: domains/publishing/propagate.spw
# Feature: spw.production.ensemble-model@v0.1

#>spw_production_ensemble
#:production #!ensemble
#:layer #!creative
#:status #!active

^"intent"{
 ~#goal: "Model show lines and template fills as ensembles on sites with conserved continuity and capacity-limited slots."
 ~#taste: "reference over rewrite; measure before lock; declare messy-desk when intricate"
}

^"roots"{
 @field: ~"../math/field.spw"
 @graph: ~"../math/graph.spw"
 @loop: ~"../math/loop.spw"
 @hold: ~"../math/hold.spw"
 @propagate: ~"../domains/publishing/propagate.spw"
 @templates: ~"../templates/index.spw"
 @film: ~"./film.spw"
 @styles: ~"../../.spw/conventions/styles.spw"
 @theory: ~"../../docs/theory/spw/field-dynamics.spw"
}

# ── Construct inventory (linguistic, abstract) ─────────────────

^"constructs"{
 site: .{
  meaning: "beat index, host channel, organ, department, or template slot"
  examples: #[ #beat_t, #host_brief, #organ_portrait, #dept_camera, #slot_claim ]
 }

 carrier: .{
  meaning: "genotype mass that binds — style_id, subject_id, voice, promise phrase"
  free: "unallocated inventiveness (messy-desk OK)"
  affinity: "preference over sites (host_map, organ ladder)"
 }

 field: .{
  meaning: "amplitude of a continuity charge or trait at each site"
  conserved: "title anchors / named tells as mass that should not vanish under transfer"
 }

 trajectory: .{
  meaning: "orbit of a field under fieldBeat steps"
  stop: "fixedPoint on Hold or budget"
 }

 ensemble: .{
  meaning: "set of carriers mixed under weights (vibe stack, multi-lock line)"
  law: "≤3 vibes; locks by reference"
 }

 membrane: .{
  meaning: "house refuse + grade_cap — what may not cross into emit"
 }
}

# ── Show production line ───────────────────────────────────────

^"show_line"{
 # Multi-beat, multi-host without story jargon
 pipeline: [
  "1. Sites: beats × hosts (or depts)"
  "2. Carriers: locked genotypes + free experimental mass"
  "3. Affinity: host_map + organ law from propagate / film"
  "4. IC field: inject continuity charge on title sites"
  "5. For each beat: fieldBeat (decay thrift, diffuse relation, inject event)"
  "6. Measure: productConstraint / Hold on anchors; graph cycle check on deps"
  "7. Emit packs; warm-cache field snapshot; cold genotype untouched"
 ]
 cache: .{
  cold: "house/title/style/subject/genre packs"
  warm: "field:{show_id}:rev{n}:beat{t}"
  generated: "host packets"
 }
}

# ── Template production ────────────────────────────────────────

^"template_production"{
 pipeline: [
  "1. Template sites = must-fill slots (capacity 1 or N)"
  "2. Carriers = phrase banks / register / user binds"
  "3. emit holes → free capacity report"
  "4. emit expand = affinityAllocate-like fill (bindings)"
  "5. Residual open holes = incomplete; strict-holes fails"
  "6. Cascade stages: expand → validate → emit multi-host"
  "7. Derivative lineage stamps fork/overlay for ensemble variants"
 ]
 feature: "spw.production.template-fill@v0.1"
 math: #[ @field, cascadeChain, affinityAllocate, productConstraint ]
}

# ── Nuance without stereotypes ─────────────────────────────────

^"nuance"{
 law: [
  "Prefer soft affinity scores over exclusive one-hot assignment"
  "Keep free mass after allocate — leftover inventiveness is allowed"
  "Evolve trajectories with small κ and decay; avoid single-step total rewrite"
  "Complex relation graphs: detectCycle before claiming a single timeline order"
 ]
}

# ── Feature registration (names only; registry owns versions) ──

^"features"{
 #[
  "spw.production.ensemble-model@v0.1:preview"
  "spw.lang.field-dynamics@v0.1:preview"
  "spw.math.field-probes@v0.1:stable"
 ]
}

~<../math/field.spw>
~<./film.spw>
