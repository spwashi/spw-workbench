# Production Index
#
# Film and cross-media production handles for Underroot worldbuilding.

#>spw_prompts_production_index
#:production #!catalog
#:layer #!creative

^"intent"{
 ~#goal: "Department-shaped handles so agents can brief film/TV/anim without collapsing to still-image only."
}

^"roots"{
 @film: ~"./film.spw"
 @biome: ~"../biome/underroot.spw"
 @mj: ~"../labs/midjourney.spw"
 @xp: ~"../labs/experiential.spw"
}

^"dispatch"{
 film: @film
 stills_lab: @mj
 experiential: @xp
}

~<./film.spw>
