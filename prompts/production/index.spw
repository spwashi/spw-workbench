# Production Index
#
# Film and cross-media production handles for Underroot worldbuilding.

#>spw_prompts_production_index
#:production #!catalog
#:layer #!creative

^"intent"{
 ~#goal: "Department-shaped handles so agents can brief film/TV/anim without collapsing to still-image only."
}

^"roots"{
 @film: ~"./film.spw"
 @ensemble: ~"./ensemble.spw"
 @field: ~"../math/field.spw"
 @biome: ~"../biome/underroot.spw"
 @mj: ~"../labs/midjourney.spw"
 @xp: ~"../labs/experiential.spw"
 @templates_show: ~"../templates/show/line-field.spw"
}

^"dispatch"{
 film: @film
 ensemble: @ensemble
 field: @field
 stills_lab: @mj
 experiential: @xp
 show_template: @templates_show
}

^"features"{
 #[
  "spw.production.ensemble-model@v0.1:preview"
  "spw.lang.field-dynamics@v0.1:preview"
 ]
}

~<./film.spw>
~<./ensemble.spw>
