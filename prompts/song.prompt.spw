# Song Generation Prompt
#
# Audio projection of the kitchen (earthy bakery fantasy). Mutate groove/flavor axes,
# keep world anchors stable. Visual signature: ~"./vibes/index.spw"

##>song_generation_prompt
#:audio
#:generation
#:prompt
#:layer #!creative

^"meta"{
 signature: ~"./vibes/index.spw"
 ~#goal: "Song as flavor-board of the kitchen — yeast, earth, oven, quiet wonder"
 ~#taste: "organic body; honey warmth with rye depth; not industrial noir"
}

^"song_generation" {
  identity: .{
    title = honey_in_the_starter
    subtitle = morning_song_for_the_underroot_oven
    version = v2
    status = draft
    intent = generate_complete_song_blueprint

    variants: .{
      v_acoustic = "Intimate, organic, woody — cottage hearth"
      v_spore = "Soft crackle, forest-floor hush, lilac dust"
      v_cinematic = "Wide oven reverb, low strings like rising dough"
    }

    focus = *v_acoustic
    trace = ~[v_acoustic:0.5, v_spore:0.3, v_cinematic:0.2]
    axis_blend = ~[honey:0.5, rye:0.3, spore:0.2]
  }

  format: .{
    type = !full_song
    target_length = 3:45
    explicit_level = !clean
    mixing_target = !streaming_lufs_14
  }

  brief: .{
    concept: .{
      premise = a baker sings the quiet hours before the first peel of bread, when flour still looks like fog and the oven is a sleeping animal
      thesis_line = "let the dough teach the hands what morning means"
      emotional_core = #warm_earth_devotion
      emotional_arc: [
        #arrival
        #knead_pressure
        #proof_wait
        #score_lift
        #oven_release
        #crumb_afterglow
      ]
      transformation = from restless night mind to patient craft body
    }

    narrative: .{
      perspective = !first_person
      relationship_frame = !craft_myth
      setting: .{
        time = !pre_dawn_to_first_light
        location = !underroot_bakery
        season = #early_autumn
        weather = !cool_outside_warm_inside
        atmosphere = !intimate_earth
      }
      tension: .{
        wound = sleepless_overthinking
        desire = &[brief.concept.emotional_core]
        obstacle = dough_that_will_not_yet_rise
        risk = wasting_the_starter_and_the_morning
      }
      reveal: .{
        bridge_truth = the_wait_is_the_work
        ending_state = crust_song_and_shared_loaf
      }
    }

    imagery: .{
      visual_motifs: [
        #flour_as_fog
        #scored_loaf_map
        #mycelium_shelf
      ]
      tactile_motifs: [
        #elastic_dough
        #warm_wood
        #linen_dust
      ]
      color_palette = [ #honey_amber, #crust_brown, #cream_flour, #moss ]
      symbolic_objects: [
        #clay_starter_jar
        #baker_lame
      ]
      forbidden_cliches: [
        #heart_of_gold
        #set_me_free
        #burning_desire
      ]
    }

    style: .{
      genre_blend: [
        #indie_folk
        #chamber_pop
      ]
      era_flavor: [
        #era_1
        #era_2
      ]
      mood_words: [
        #mood_1
        #mood_2
        #mood_3
      ]
      texture_words: [
        #warm
        #wide
        #intimate
        #detailed
      ]
      artist_adjacency: [
        #artist_ref_1
        #artist_ref_2
      ]
      ~#originality: high
    }

    music: .{
      rhythm: .{
        bpm = 120
        meter = 4/4
        groove = &[focus.groove]
        pocket = !centered
        swing = !none
      }

      harmony: .{
        key_center = #c_minor
        harmonic_mood = driven_by_&[brief.concept.emotional_core]
        chord_behavior = !cinematic_lift
        verse_palette: [
          #i_minor
          #vi_major
        ]
        chorus_palette: [
          #iv_major
          #v_major
        ]
        bridge_palette: [
          #ii_dim
          #v_alt
        ]
      }

      melody: .{
        contour = !rising_open
        range = !wide
        motif_strategy = !variation
        hook_shape = !repeating_phrase
        leap_usage = !strategic
      }
    }

    instrumentation: .{
      lead: .{
        primary_voice = &[brief.voice.lead.profile]
        signature_instrument = !synth_lead
        foreground_hook: !main_riff
      }

      rhythm_section: .{
        drums[*]: .{
          v_acoustic = !vintage_acoustic_kit_brushed
          v_industrial = !analog_drum_machine_and_foley
          v_cinematic = !taikos_and_sub_booms
        }
        bass = !sub_heavy
        percussion = ~[v_acoustic:0.7, v_industrial:0.3]
      }

      harmonic_bed: .{
        pads = !analog_wash
        keys = !Rhodes
        strings_or_guitars = !muted_electric
      }

      detail: .{
        ear_candy: [
          #reverse_fx
          #vocal_chop
        ]
        acoustic_vs_synthetic = ~[v_acoustic:0.3, v_industrial:0.7]
        low_end_shape = !round
        high_end_shape = !silky
      }
    }

    arrangement: .{
      intro: .{
        duration = 0:10
        job = !establish_world
        elements: [
          #ambient_pad
          #rhythmic_tick
        ]
      }

      verse_1: .{
        job = &[brief.lyrics.section_jobs.verse]
        focus = !lived_detail
        energy = !restrained
      }

      pre_chorus: .{
        job = &[brief.lyrics.section_jobs.pre_chorus]
        harmony = !widen
        drums = !open_slightly
      }

      chorus_1: .{
        job = &[brief.lyrics.section_jobs.chorus]
        energy = !full
      }

      verse_2: .{
        job = !add_specificity
        variation = !new_instrument_layer
      }

      bridge: .{
        job = &[brief.lyrics.section_jobs.bridge]
        texture = !ambient_lift
        function = !perspective_shift
      }

      final_chorus: .{
        job = !maximum_payoff
        additions: [
          #adlibs
          #vocal_stack
        ]
      }

      outro: .{
        job = &[brief.lyrics.section_jobs.outro]
        final_image = !residue
      }
    }

    voice: .{
      lead: .{
        profile = &[focus.voice_treatment]
        phrasing = !floating
        register_motion: !low_to_high
        diction = !intelligible
      }

      stacking: .{
        doubles = #chorus
        harmonies = #final_chorus
        whispers = #outro
        adlibs = !sparse
      }
    }

    lyrics: .{
      engine: .{
        density = &[focus.lyric_density]
        rhyme_style = !near_rhyme
        line_length = !mixed
        repetition_strategy: [
          #repeat_thesis
          #echo_outro
        ]
        preferred_devices: [
          #sensory_images
          #double_meanings
        ]
      }

      section_jobs: .{
        verse = !specificity
        pre_chorus = !lift
        chorus = !thesis_delivery
        bridge = !admission
        outro = !afterimage
      }

      seed_lines: .{
        hook_line = &[brief.concept.thesis_line]
        bridge_reveal = &[brief.narrative.reveal.bridge_truth]
        closing_line = &[brief.narrative.reveal.ending_state]
      }
    }
  }

  renderer_profile: .{
    production: .{
      mix: .{
        priority: [
          #lead_vocal
          #hook_clarity
          #chorus_width
        ]
        vocal_space = !dry_to_wide
        color: .{
          saturation = !tape_warmth
          transients = !softened
          reverb_algorithm[*]: .{
            v_acoustic = !small_plate
            v_industrial = !gated_nonlinear
            v_cinematic = !pitch_shifted_granular_reverb
          }
        }
        loudness = !dynamic_master
      }

      motion: .{
        transitions: [ #riser, #reverse_cymbal ]
        automation = ~[v_acoustic:0.4, v_industrial:0.3, v_cinematic:0.3]
        bus_compression[*]: .{
          v_acoustic = !vca_master_bus_compression_light
          v_industrial = !multiband_pumping
          v_cinematic = !parallel_orchestral_lift
        }
      }
    }
  }

  boonhonk: .{
    definition = "The observable field of wonder; naming taste, posture, and quality."
    combinatorics: .{
      instruction = "Use the % operator to quantify the song's musical and lyrical gravity."
      formulas: [
        %[brief.music.rhythm.groove * 1.5] + %[brief.lyrics.engine.density] = rhythmic_tension
        %[brief.voice.lead.profile] * %[renderer_profile.production.mix.color.reverb_algorithm] = vocal_valence
        %[brief.lyrics.engine.density] / (1 + %[negatives.production]) = narrative_friction
        %[focus * trace] = variant_resonance
      ]
      execution = compute_%[rhythmic_tension * vocal_valence * narrative_friction * variant_resonance]
    }
  }

  emit: .{
    output_contract = .{
      semantic_source = brief
      renderer_source = renderer_profile
      primary_deliverable = !song_blueprint
    }
    handoff_notes = "Use the brief layer for lyrical, harmonic, structural, and vocal intent, the renderer_profile layer for mix and motion treatment, and negatives as writing and production anti-patterns."
  }

  negatives: .{
    writing: [
      #summary_language
      #cliche_metaphors
      #empty_choruses
    ]
    production: [
      #over-compressed
      #muddy_low_end
      #jarring_transitions
    ]
  }
}
