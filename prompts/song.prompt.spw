# Song Generation Prompt
#
# Temporary root-level working file for structured song ideation and generation.

##>song_generation_prompt
#:audio
#:generation
#:prompt
#:layer #!creative

^"song_generation" {
  identity: .{
    title = working_title
    subtitle = none
    version = v1
    status = draft
    intent = generate_complete_song_blueprint

    variants: .{
      v_acoustic = "Intimate, organic, woody"
      v_industrial = "Harsh, grid-locked, metallic"
      v_cinematic = "Expansive, orchestral, lush"
    }

    focus = *v_acoustic
    trace = ~[v_acoustic:0.5, v_industrial:0.3, v_cinematic:0.2]
  }

  format: .{
    type = !full_song
    target_length = 3:45
    explicit_level = !clean
    mixing_target = !streaming_lufs_14
  }

  concept: .{
    premise = one_sentence_premise
    thesis_line = central_lyrical_anchor
    emotional_core = primary_feeling
    emotional_arc: [
      #arrival
      #temptation
      #pressure
      #lift
      #release
      #afterglow
    ]
    transformation = what_changes_by_end
  }

  narrative: .{
    perspective = !first_person
    relationship_frame = !myth
    setting: .{
      time = !late_night
      location = !dream_space
      season = #autumn
      weather = !rain
      atmosphere = !intimate
    }
    tension: .{
      wound = what_hurts
      desire = &[concept.emotional_core]
      obstacle = what_blocks_it
      risk = what_could_be_lost
    }
    reveal: .{
      bridge_truth = bridge_admission
      ending_state = final_understanding
    }
  }

  imagery: .{
    visual_motifs: [
      #motif_1
      #motif_2
      #motif_3
    ]
    tactile_motifs: [
      &[focus.texture]
      #texture_2
    ]
    color_palette = &[focus.dominant_colors]
    symbolic_objects: [
      #object_1
      #object_2
    ]
    forbidden_cliches: [
      #heart_of_gold
      #set_me_free
      #burning_desire
    ]
  }

  style: .{
    genre_blend: [
      #genre_1
      #genre_2
    ]
    era_flavor: [
      #era_1
      #era_2
    ]
    mood_words: [
      #mood_1
      #mood_2
      #mood_3
    ]
    texture_words: [
      #warm
      #wide
      #intimate
      #detailed
    ]
    artist_adjacency: [
      #artist_ref_1
      #artist_ref_2
    ]
    ~#originality: high
  }

  music: .{
    rhythm: .{
      bpm = 120
      meter = 4/4
      groove = &[focus.groove]
      pocket = !centered
      swing = !none
    }

    harmony: .{
      key_center = #c_minor
      harmonic_mood = driven_by_&[concept.emotional_core]
      chord_behavior = !cinematic_lift
      verse_palette: [
        #i_minor
        #vi_major
      ]
      chorus_palette: [
        #iv_major
        #v_major
      ]
      bridge_palette: [
        #ii_dim
        #v_alt
      ]
    }

    melody: .{
      contour = !rising_open
      range = !wide
      motif_strategy = !variation
      hook_shape = !repeating_phrase
      leap_usage = !strategic
    }
  }

  instrumentation: .{
    lead: .{
      primary_voice = &[voice.lead.profile]
      signature_instrument = !synth_lead
      foreground_hook: !main_riff
    }

    rhythm_section: .{
      drums = &[focus.drum_kit]
      bass = !sub_heavy
      percussion = ~[v_acoustic:0.7, v_industrial:0.3]
    }

    harmonic_bed: .{
      pads = !analog_wash
      keys = ! Rhodes
      strings_or_guitars = !muted_electric
    }

    detail: .{
      ear_candy: [
        #reverse_fx
        #vocal_chop
      ]
      acoustic_vs_synthetic = ~[v_acoustic:0.3, v_industrial:0.7]
      low_end_shape = !round
      high_end_shape = !silky
    }
  }

  arrangement: .{
    intro: .{
      duration = 0:10
      job = !establish_world
      elements: [
        #ambient_pad
        #rhythmic_tick
      ]
    }

    verse_1: .{
      job = &[lyrics.section_jobs.verse]
      focus = !lived_detail
      energy = !restrained
    }

    pre_chorus: .{
      job = &[lyrics.section_jobs.pre_chorus]
      harmony = !widen
      drums = !open_slightly
    }

    chorus_1: .{
      job = &[lyrics.section_jobs.chorus]
      energy = !full
    }

    verse_2: .{
      job = !add_specificity
      variation = !new_instrument_layer
    }

    bridge: .{
      job = &[lyrics.section_jobs.bridge]
      texture = !ambient_lift
      function = !perspective_shift
    }

    final_chorus: .{
      job = !maximum_payoff
      additions: [
        #adlibs
        #vocal_stack
      ]
    }

    outro: .{
      job = &[lyrics.section_jobs.outro]
      final_image = !residue
    }
  }

  voice: .{
    lead: .{
      profile = &[focus.voice_treatment]
      phrasing = !floating
      register_motion: !low_to_high
      diction = !intelligible
    }

    stacking: .{
      doubles = #chorus
      harmonies = #final_chorus
      whispers = #outro
      adlibs = !sparse
    }
  }

  lyrics: .{
    engine: .{
      density = &[focus.lyric_density]
      rhyme_style = !near_rhyme
      line_length = !mixed
      repetition_strategy: [
        #repeat_thesis
        #echo_outro
      ]
      preferred_devices: [
        #sensory_images
        #double_meanings
      ]
    }

    section_jobs: .{
      verse = !specificity
      pre_chorus = !lift
      chorus = !thesis_delivery
      bridge = !admission
      outro = !afterimage
    }

    seed_lines: .{
      hook_line = &[concept.thesis_line]
      bridge_reveal = &[narrative.reveal.bridge_truth]
      closing_line = &[narrative.reveal.ending_state]
    }
  }

  production: .{
    mix: .{
      priority: [
        #lead_vocal
        #hook_clarity
        #chorus_width
      ]
      vocal_space = !dry_to_wide
      saturation = !tape_grit
      loudness = !dynamic_master
    }

    motion: .{
      transitions: [
        #riser
        #drop
      ]
      automation = ~[v_acoustic:0.2, v_industrial:0.8]
    }
  }

  boonhonk: .{
    definition = "The observable field of wonder; naming taste, posture, and quality."
    combinatorics: .{
      instruction = "Use the % operator to quantify the song's musical and lyrical gravity."
      formulas: [
        %[music.rhythm.groove * 1.5] + %[lyrics.engine.density] = rhythmic_tension
        %[voice.lead.profile] * %[production.color.reverb_algorithm] = vocal_valence
        %[lyrics.engine.density] / (1 + %[negatives.mix]) = narrative_friction
        %[focus * trace] = variant_resonance
      ]
      execution = compute_%[rhythmic_tension * valence_shift * hook_gravity * variant_resonance]
    }
  }

  negatives: .{
    writing: [
      #summary_language
      #cliche_metaphors
      #empty_choruses
    ]
    production: [
      #over-compressed
      #muddy_low_end
      #jarring_transitions
    ]
  }
}
