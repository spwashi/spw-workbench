# Modality — embodied / experiential

#>spw_template_modality_embodied
#:template #!modality
#:modality #!embodied
#:layer #!creative

^"intent"{
 ~#goal: "Hand-scale, care-duty, process triad for lived craft."
 ~#taste: "hands-tool-material; refuse spectacle default"
}

^"roots"{
 @hold: ~"../../math/hold.spw"
 @process: ~"../../image/process.prompt.spw"
 @lenses: ~"../../lenses/hand-scale.spw"
 @xp: ~"../../labs/experiential.spw"
}

^"shape"{
 id: #embodied
 media: #[ #image, #experience, #film ]
 formula: "hands ⊗ tool ⊗ material → care_visible"
}

^"algo"{
 axes: #[ #axis_craft, #subject_cast, #axis_density ]
 include: #[ @hold ]
 refuse: "empire scale as default"
 lenses_max: 2
}

^"script_holes"{
 hands: $hands
 tool: $tool
 material: $material
 care: ${care=_}
 place: ${place=_}
}
