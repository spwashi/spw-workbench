# Derivatives — in-place updates, forks, overlays
#
# Mind-diverse script architecture: many minds update without erasing provenance.
# Machine: stampDerivative / parseLineage in template-fill.ts

#>spw_templates_derivatives
#:prompt #!derivatives
#:layer #!pragmatics
#:status #!active

^"intent"{
 ~#goal: "Allow parallel script evolution: patch in place, fork for experiments, overlay for session tilts."
 ~#taste: "lineage explicit; cold history append-only; hot may thrash under grade"
}

^"modes"{
 #in_place: .{
  meaning: "Revise the same path; revision++ ; prior cold archive optional"
  use: "canon retune after F4 promote; typo/fill completion"
  risk: "high — requires episode if semantic"
 }
 #fork: .{
  meaning: "New path; parent + base refs; independent stream"
  use: "effect.l0–l1 experiments; A/B style; student copies"
  risk: "low — default for play"
 }
 #overlay: .{
  meaning: "Session/local tilt over stable base without rewriting base"
  use: "one-job host retune; pedagogy demo; thrift overlay"
  risk: "medium — must not claim base identity"
 }
}

^"lineage_block"{
 // Stamp near top of derivative scripts
 shape: `
^"lineage"{
 mode: #fork
 base: ~"prompts/templates/publish/job-instance.spw"
 revision: 1
 parent: ""
 derivative_id: "job.quiet_board.social.v1"
 note: "optional human why"
}
 `
 law: "Fork/overlay always set base. In-place always increment revision."
}

^"update_protocol"{
 in_place: [
  "1. emit holes — know open slots"
  "2. expand fills (not lock rewrites)"
  "3. one #mutate coordinate if retuning"
  "4. measure Hold"
  "5. revision++; episode if semantic"
 ]
 fork: [
  "1. Copy template → new path"
  "2. Stamp lineage #fork"
  "3. Expand bindings"
  "4. Independent saga stream"
 ]
 overlay: [
  "1. Reference base via ~path"
  "2. Local ^overlay{ … } or bind-only file"
  "3. Emit uses merge: base traits then overlay"
  "4. Never write locks into base from overlay"
 ]
}

^"memory"{
 hot: "active bindings + open stream"
 warm: ">> stream on derivative"
 cold: "parent/base frozen; episodes on promote"
 generated: "emit packets — rebuildable"
}

^"refuse"{
 #[
  "Silent path overwrite without lineage"
  "Overlay that rewrites base locks"
  "Fork claiming identical derivative_id as parent"
  "In-place semantic retune without episode when effect.l2.workspace"
 ]
}
