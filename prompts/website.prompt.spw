#>website_generation_prompt
#:web
#:generation
#:prompt
#:layer #!creative

^"website_generation" {
  identity: .{
    title = working_title
    subtitle = none
    version = v1
    status = draft
    intent = generate_complete_website_blueprint

    variants: .{
      v_editorial = "Typographic, photographic, asymmetric"
      v_spatial = "Immersive, WebGL, scroll-bound"
      v_system = "Data-dense, monospaced, brutalist"
    }

    focus = *v_spatial
    trace = ~[v_spatial:0.7, v_editorial:0.2, v_system:0.1]
  }

  format: .{
    type = !interactive_experience
    target_device = !desktop_first_responsive
    
    content_density[*]: .{
      v_editorial = !sparse_but_deep
      v_spatial = !immersive_minimal
      v_system = !data_dense
    }

    scroll_behavior[*]: .{
      v_editorial = !native_smooth
      v_spatial = !custom_lenis_physics
      v_system = !hardware_instant
    }
  }

  concept: .{
    premise = one_sentence_product_premise
    thesis_copy = central_hero_statement
    
    emotional_core[*]: .{
      v_editorial = #measured_authority
      v_spatial = #immersive_ambient
      v_system = #unapologetic
    }
    
    emotional_arc: [
      #intrigue_on_load
      #kinetic_discovery
      #technical_awe
      #conversion_clarity
    ]
    transformation = user_state_before_and_after
  }

  narrative: .{
    perspective = !second_person
    voice = !confident_guide
    content_flow: [
      !hero_claim_or_canvas_reveal
      !social_proof_marquee
      !feature_deep_dive_scroll_bound
      !technical_spec_accordion
      !final_call_to_action
    ]
    tension: .{
      problem = what_is_broken
      desire = what_user_wants
      solution = what_we_provide
      objection = what_they_fear
    }
  }

  architecture: .{
    routing: .{
      strategy = !client_side_spa
      view_transitions_api = !active

      prefetching[*]: .{
        v_editorial = !on_hover
        v_spatial = !eager_in_background
        v_system = !on_intent
      }

      page_transition_style[*]: .{
        v_editorial = !crossfade_routing
        v_spatial = !camera_flythrough
        v_system = !instant_snap
      }
    }
    
    infrastructure[*]: .{
      v_editorial = !static_site_generation_cdn
      v_spatial = !webrtc_peer_mesh
      v_system = !server_rendered_edge_compute
    }
    
    auth_flow = !magic_link_passwordless
    error_handling = !graceful_skeleton_degradation
    
    primary_navigation[*]: .{
      v_editorial = !hidden_menu_trigger
      v_spatial = !sticky_glass_header
      v_system = !dense_top_bar
    }
    
    footer_weight = !maximal_sitemap
    
    layout_strategy[*]: .{
      v_editorial = !offset_masonry
      v_spatial = !floating_z_index
      v_system = !strict_table_rows
    }
  }

  design_system: .{
    typography: .{
      secondary = !clean_sans_serif
      variable_axes: [ #weight, #slant, #optical_size ]

      primary[*]: .{
        v_editorial = !variable_serif
        v_spatial = !geometric_sans
        v_system = !monospaced_code
      }

      scale_ratio[*]: .{
        v_editorial = !fluid_rems
        v_spatial = !fixed_optical
        v_system = !modular_px_strict
      }

      tracking_behavior[*]: .{
        v_editorial = !tight_display
        v_spatial = !loose_airy
        v_system = !tabular_nums
      }
    }
    
    color: .{
      theme_handling = !system_preference_with_toggle
      surface: [ #elevated_card, #inset_well ]
      accent_logic = structurally_encodes_&[concept.transformation]

      palette[*]: .{
        v_editorial: [ #ink_black, #paper_white, #slate_gray ]
        v_spatial: [ #obsidian, #deep_blur, #lucid_cyan, #laser ]
        v_system: [ #terminal_black, #safety_orange, #ghost_white ]
      }
    }
    
    space: .{
      containment = ~[v_spatial:0.8, v_system:0.2]

      density[*]: .{
        v_editorial = !optical_margins
        v_spatial = !continuous_scroll
        v_system = !pixel_perfect_baseline
      }

      grid[*]: .{
        v_editorial = !css_subgrid_asymmetric
        v_spatial = !canvas_absolute
        v_system = !css_grid_12_column
      }
    }
  }

  materiality: .{
    surface_language = ~[v_spatial:0.9, v_editorial:0.1]
    borders = ~[v_editorial:0.1, v_system:0.9]
    tactile_priority = !hover_states_and_focus_rings
    backdrop_filters: [ #blur, #saturate ]
  }

  motion: .{
    physics: .{
      spring_mass = 1
      spring_stiffness = 170
      spring_damping = 26
    }
    scroll_hijack: [ #horizontal_sections, #pinned_elements, #scrub_animations ]
    micro_interactions: [ #magnetic_buttons, #cursor_followers, #skeleton_loaders ]
    reduced_motion = !respect_os_prefs_strip_transforms

    interaction_feel[*]: .{
      v_editorial = !subtle_parallax
      v_spatial = !spring_physics_cursor
      v_system = !instant_snap
    }
  }

  web_capabilities: .{
    apis: [
      #webgl_context
      #intersection_observer
      #web_audio_api
      #css_custom_properties_houdini
    ]
    performance: .{
      lazy_load = !aggressive_intersection_observer
      dom_recycling = !virtualized_lists
      asset_delivery = !avif_and_webp
      caching_layer = !stale_while_revalidate
    }

    rendering[*]: .{
      v_editorial = !high_res_stills
      v_spatial = !realtime_3d_webgl
      v_system = !svg_vector_only
    }

    media_treatment[*]: .{
      v_editorial = !duotone_bleed
      v_spatial = !refractive_distortion
      v_system = !one_pixel_stroke
    }
  }

  content: .{
    copy_engine: .{
      density = !concise
      tone = !authoritative
      preferred_devices: [ #active_verbs, #short_sentences, #scannable_lists ]
    }
    seo_and_a11y: .{
      semantic_html = !strict
      aria_labels = !comprehensive
      meta_graph = !open_graph_and_twitter_cards
    }
  }

  boonhonk: .{
    definition = "The observable field of wonder; naming taste, posture, and quality."
    combinatorics: .{
      instruction = "Use the % operator to quantify the site's interactive and aesthetic gravity."
      formulas: [
        %[design_system.typography.scale_ratio * 2.5] + %[materiality.surface_language] = visual_authority
        %[motion.interaction_feel] * %[web_capabilities.apis] = kinetic_valence
        %[architecture.routing.view_transitions_api] / (1 + %[negatives.performance]) = experiential_flow
        %[focus * trace] = variant_resonance
      ]
      execution = compute_%[visual_authority * kinetic_valence * experiential_flow * variant_resonance]
    }
  }

  negatives: .{
    design: [
      #bootstrap_default
      #low_contrast_text
      #misaligned_baselines
      #unmotivated_animations
      #generic_border_radii
    ]
    ux: [
      #scroll_hijacking_without_escape
      #unclear_buttons
      #hidden_navigation
      #layout_shift_on_load
      #broken_back_button
    ]
    performance: [
      #main_thread_blocking
      #unoptimized_images
      #render_blocking_fonts
    ]
  }
}
