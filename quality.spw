# Quality Annotations
#
# BBBH applied to codebase structure.

^["roots"]{
  @src:  ~"../src"
  @spec: ~"../lib/spw-v0.1.0-alpha"
  @here: ~"."
}

^["boon"]{
  # Clear value, stable, clean
  @src/core/domains/
  @src/core/conventions/
  @src/lib/spw/
}

^["bane"]{
  # Friction points, needs refactor
  @src/platform/main.ts        # Split target
}

^["bone"]{
  # Structural necessity
  @src/core/index.ts
  @src/infra/timing/index.ts
}

^["bonk"]{
  # High-impact if changed
  @src/core/domains/           # Changes ripple
  @src/lib/spw/types.ts        # Breaks consumers
}

^["honk"]{
  # Attention-worthy
  ~"./index.spw"               # This map
  @src/core/tally.ts           # bbbh signature
}

^["split"]{
  # Quality vs Valence
  @src/core/quality.ts         # 4/5 (boon, bane, bone, honk)
  @src/runtime/state/          # 5/5 + null (adds bonk)

  #note: "Partial application creates learnable edge"
}
