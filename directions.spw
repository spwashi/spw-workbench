# Next Directions
#
# Development priorities and opportunities.

^["roots"]{
  @src:  ~"../src"
  @spec: ~"../lib/spw-v0.1.0-alpha"
}

^["immediate"]{
  # Structural debt
  @src/platform/main.ts^bane       # 1222 lines, split into modules
  @src/design/components.ts^bane   # 778 lines, extract patterns

  # Missing hooks
  .. "Runtime hooks (timing) - TODO"
  .. "Debug hooks (timing) - TODO"
  .. "CLI hooks (timing) - TODO"
}

^["short-term"]{
  # Conformance alignment
  ?[Level 1: Parser]{
    @src/lib/spw/lexer/
    @src/lib/spw/parser/
    @src/lib/spw/grammar/
    @spec/infra/CONFORMANCE.md
  }

  # Test coverage
  @src/lib/spw/__tests__/          # Expand fixtures
  @src/runtime/__tests__/          # Interpreter tests
}

^["medium-term"]{
  # Conformance Level 2: Evaluator
  ?[semantic execution]{
    @src/runtime/interpreter/
    @src/runtime/state/            # Valence handling
    @spec/runtime/REGISTERS.md
  }

  # Domain profiles
  ?[domain polymorphism]{
    @spec/domains/PROFILES.md
    @src/semantics/                # Knowledge representation
  }
}

^["long-term"]{
  # Conformance Level 3: Full
  lsp/                             # Language Server Protocol
  wasm/                            # WebAssembly compilation
  collab/                          # Real-time collaboration

  # Ecosystem
  plugins/                         # Extension system
  packages/                        # Extractable modules
}
