# Audits Index
#
# Audit documents capture intentional review lanes: discrepancies, learnability,
# progressive disclosure, and cross-layer coherence.

#:layer #!pragmatics

^["roots"]{
 @here: ~"."
}

^["meta"]{
 !["Guides"]
 .. ~"./spw/audit-guide.spw"
}

^["files"]{
 !["Audit documents"]
 .. ~"./md/audio-shader-alignment-2026-02-16.md"
 .. ~"./spw/attention-behavior-audit.spw"
 .. ~"./md/attention-token-audit-2026-02-06.md"
 .. ~"./md/css-token-semantic-parity-audit.md"
 .. ~"./spw/data-attributes-audit.spw"
 .. ~"./spw/design-mode-audit.spw"
 .. ~"./spw/focus-navigation-audit.spw"
 .. ~"./md/layout-resize-zindex-audit.md"
 .. ~"./spw/localization-events-performance-2026-02-14.spw"
 .. ~"./md/ontological-geometry-audit.md"
 .. ~"./md/performance-audit-2026-02-15.md"
 .. ~"./md/phantom-show-selectors-audit.md"
 .. ~"./spw/spw-garden-audit-2026-02-15.spw"
 .. ~"./md/ux-audit-2026-02-15.md"
 .. ~"./md/ux-dimensions-audit-2026-02-15.md"
 .. ~"./md/vim-keybindings-inconsistencies-audit.md"
}

#>wonder_docs_audits_index_1
?["What is the ecological temperature of reading Audits Index?"]{
  #:depth #!experiential // lens: ecological zone
  $%[line.operator_density, brace.nesting_rhythm] => ~#reading_feel
  ~#structure: "roots → meta → files" // frame flow
  !probe{ "read aloud for 30 seconds; where do you pause? pauses mark biome edges." }
}

#>wonder_docs_audits_index_2
?["What concept is conspicuously absent from Audits Index?"]{
  #:depth #!computational // lens: molecular binding
  ~#present: [#educational, #mathematical]
  ~#expected_but_missing: "?" // the reader fills this gap
  !probe{ "list what IS annotated; list what sibling files annotate; the difference is this file's blind spot or intentional boundary." }
  $%[file.frame_count, file.annotation_density, file.brace_depth_max]
  ~<"docs/index.spw"> ~#neighbor(nearest)
}
