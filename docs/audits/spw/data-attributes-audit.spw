# Data Attributes + Token Surface Audit
#
# Map the state surface for semantic physics, action targets, and theme response.
# Focus: what is exposed, where, and why.

#:layer #!pragmatics

^["roots"]{
 @src: ~"../src"
 @here: ~"."
}

^["intent"]{
 ~#goal: "Make every visible element semantically useful and theme-responsive."
 ~#why: "Registers, targets, and LoD differentials rely on a consistent state surface."
 ~#lens: "Metaphysical optics + semantic photonics; clarity of state → clarity of cognition."
}

^["global-state-surface"]{
 # Attributes set on <html> (root state plane).
 # Sources: @src/styles/state.css, @src/platform/bootstrap/settings.ts, @src/features/keyboard/*

 ~data-mode: "interaction mode (normal/insert/visual/inspect/transform/stepping/command)"
 ~data-lod: "fine | medium | coarse (user LoD)"
 ~data-spw-layer: "syntactic | semantic | pragmatic (layer model)"
 ~data-activation-context: "visual | editing | reporting | debug | design | diagnostic | pedagogical | performance | structural (user-facing interaction frame)"
 ~data-perspective: "source | visual | document | debug | graph (system-facing routing lens derived from activation context)"
 ~data-spw-perspective: "computation | electromagnetism | photonics | cognition | learning | illustration (operant perspective for Spw operator readings)"
 ~data-disclosure: "beginner | intermediate | advanced (disclosure level)"
 ~data-region: "focused region (editor/inspector/sidebar/geology/header/footer)"
 ~data-tab: "active inspector tab id"
 ~data-editor-focused: "true | false"
 ~data-has-selection: "true | false"
 ~data-breakpoint: "compact | medium | expanded | large | xlarge"

 # Action target surface (semantic action plane)
 ~data-spw-action-scope: "fine | medium | coarse (current action target scope)"
 ~data-spw-action-kind: "selection | node | component | panel | region | element"
 ~data-spw-action-anchor: "focus | selection"
 ~data-spw-focus-scope: "scope of focus target"
 ~data-spw-selection-scope: "scope of selection target"

 # Command + leader surface
 ~data-spw-space-leader: "true | false (space leader awaiting next key)"
 ~data-spw-command-prefix: ": | / | etc. (command bar prefix)"

 # Register surface
 ~data-spw-register-active: "\" | 0-9 | a-z"
 ~data-spw-register-kind: "text | node | html | selection | landmark"
 ~data-spw-register-scope: "fine | medium | coarse"
 ~data-spw-register-format: "plain | formatted"

 # Design mode surface
 ~data-spw-design-mode: "true | false (design mode enabled)"
 ~data-spw-design-panel: "true | false (design panel open)"
}

^["component-surface"]{
 # Attributes on visible elements (ontological geometry plane)
 ~data-spw-component: "component identity (primary for design mode + action targets)"
 ~data-region: "region ownership (editor/inspector/sidebar/geology/header/footer)"
 ~data-panel-id: "panel identity"
 ~data-spw-slot: "slot identity for layout wiring"
 ~data-lod-weight: "preferred LoD weight for action targeting (fine/medium/coarse)"
 ~data-spw-tab-scope: "preferred LoD scope for tab navigation (fine/medium/coarse)"
 ~data-spw-tab-index: "optional index hint for tab ordering"
 ~data-spw-action-role: "focus | selection | action (set by action-targets)"
 ~data-spw-action-scope: "computed action scope per target"
 ~data-spw-actionable: "action string(s), e.g. yp"
 ~data-spw-action-flash: "transient pulse on action"
}

^["register-surface"]{
 # Per-register data for nuanced yank/paste and inspection
 ~data-register: "register name"
 ~data-register-kind: "kind label"
 ~data-register-scope: "scope label"
 ~data-register-age: "age (seconds/minutes/hours)"
 ~data-register-format: "plain | formatted"
 ~data-register-inspect: "true | false"
}

^["token-surface"]{
 # Key tokens that must remain stable for theme responsiveness.
 ~--spw-context-accent: "activation context color"
 ~--spw-semantic-selection-bg: "selection fill"
 ~--spw-semantic-selection-color: "selection stroke"
 ~--spw-lod-accent-fine: "LoD fine accent"
 ~--spw-lod-accent-medium: "LoD medium accent"
 ~--spw-lod-accent-coarse: "LoD coarse accent"

 ~--spw-command-leader-accent: "space leader accent"
 ~--spw-command-leader-soft: "space leader background"
 ~--spw-command-leader-border: "space leader border"
 ~--spw-command-leader-glow: "space leader glow"
}

^["gaps"]{
 ~#risk: "Attribute sprawl without a registry; semantics leak across layers."
 ~#risk: "Mixed naming conventions (data-spw-* vs data-*) make design mode weaker."
 ~#risk: "Action-target affordance relies on inferred scopes; missing data-lod-weight in many components."
 ~#risk: "Tokens for action-target UI are not centralized under design tokens."
}

^["recommendations"]{
 1. Create/maintain a canonical registry: @src/core/conventions/data-attributes.ts (typed constants + docs link).
 2. Enforce `data-spw-component` on all key elements; deprecate `data-component`.
 3. Ensure action-target root attrs always set (especially in design mode).
 4. Add `data-lod-weight` to components that define semantic scope (editor, inspector, context, drawers).
 5. Promote command-leader tokens to theme packs so each theme can signal “ninja mode.”
}

^["sources"]{
 @src/styles/state.css
 @src/styles/tokens.css
 @src/features/keyboard/navigation/action-targets.ts
 @src/features/keyboard/keyboard-manager.ts
 @src/features/keyboard/registers/register-bank.ts
 @src/platform/bootstrap/settings.ts
}

#>wonder_docs_audits_spw_dataattributesaudit_1
?["What was Data Attributes + Token Surface Audit before it was this, and what could it become?"]{
  #:depth #!experiential // lens: curated collection
  ~#past: "git log --oneline -- docs/audits/spw/data-attributes-audit.spw | head -3"
  ~#future: "what frame would you add next?"
  !probe{ "the file's git history IS its evolutionary record; the next natural frame reveals the author's trajectory." }
  $%[register.bank_size, register.active_bindings]
}

#>wonder_docs_audits_spw_dataattributesaudit_2
?["How would a biology algorithm express roots?"]{
  #:depth #!computational // lens: living system
  ~#translation_target: "biology"
  ~#source_concept: "roots"
  !probe{ "rewrite the root frame in biology vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[register.bank_size, register.active_bindings]
  ~<docs/audits/spw/attention-behavior-audit.spw>  // nearest neighbor
}
