# docs audit guide
#
# Review checklist for docs/ changes.

#:layer #!pragmatics

^["meta"]{
 @location: docs/
 @description: "Project-level documentation"
}

^["signals"]{
 # Red flags during review:

 !["accuracy"]
 .. Docs diverging from code
 .. Outdated dependency graphs
 .. Stale architecture descriptions
 .. Missing canonicalization guidance while code uses @src/seed/canonical/

 !["structure"]
 .. Missing index entries
 .. Broken cross-references
 .. Orphaned documents
}

^["questions"]{
 # Ask before approving:
 .. "Does this match current implementation?"
 .. "Is this linked from index.spw?"
 .. "Are cross-references valid?"
}

^["index"]{
 # Key documentation files:
 .. index.spw # Master index
 .. toc.spw # Table of contents
 .. dependencies.spw # Dependency graph
 .. architecture.spw # System architecture
 .. domains.spw # Domain descriptions
}

^["sync"]{
 # Keep in sync with:
 .. src/core/domains/index.ts # Domain registry
 .. eslint.config.js # Layer rules
 .. per-domain audit-guide.spw # Review checklists
}

#>wonder_docs_audits_spw_auditguide_1
?["How does this file's voice differ from @location?"]{
  #:depth #!educational // lens: formal structure
  ~<@location> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]@location
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}

#>wonder_docs_audits_spw_auditguide_2
?["What invariant holds across every frame in docs audit guide?"]{
  #:depth #!experiential // lens: material grain
  $^["_"]@here => %[shared.property]
  ~#hypothesis: "all frames in this file share ____"
  !probe{ "extract the property common to meta's frames; if none exists, the file may lack cohesion or may be a deliberate collection." }
  $%[file.frame_count, file.annotation_density, file.brace_depth_max]
  ~<"docs/audits/spw/attention-behavior-audit.spw"> ~#neighbor(nearest)
}
