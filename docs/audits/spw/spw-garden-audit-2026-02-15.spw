# Spw Garden Audit
#
# Date: 2026-02-15
# Scope: .spw documents across docs/, src/*/docs/, and related beds (examples, snapshots).
#
# Metaphor: documents are plants; references are roots; cross-links are pollination;
# audits are pruning notes; knowledge is fruit.

#:layer #!pragmatics

^["roots"]{
  @docs: ~".."
  @src: ~"../../src"
  @examples: ~"../../examples"
  @here: ~"."
}

^["meta"]{
  @domain: docs
  @owner: audits
  @description: "Structural + referential audit of .spw documentation (garden metaphor)"
}

^["inventory"]{
  total_files: 108
  beds: {
    docs: 48
    src_docs: 35
    src_other: 1
    examples: 16
    snapshots: 5
    skills: 1
    root: 2
  }
}

^["growth-model"]{
  # A lightweight heuristic for documentation maturity:
  seed: "no roots/meta scaffolding; mostly prose; references are brittle"
  sprout: "roots present; references become navigable"
  bloom: "roots + meta; the plant has identity (domain/owner/intent)"
  fruit: "roots + meta + explicit file/questions; high navigability and reuse"
}

^["growth-snapshot"]{
  # Applies only to doc-like beds (docs/, src-docs/, root).
  seeds: 32
  sprouts: 45
  blooms: 1
  fruits: 7
}

