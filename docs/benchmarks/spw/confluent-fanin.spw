# Benchmark: Confluent Fan-In
#
# Measures merge performance as source count grows.

#:layer #!semantics

^"benchmark"{ ~#name: "confluent-fanin", ~#metric: "latency_ms" }

^"setup"{
 source_counts: [2, 5, 10, 25, 50, 100]
 value_type: "object" # {key_i: i}
 iterations_per_count: 1000
}

^"run"{
 # For each source count N:
 # 1. Create N registers with object values
 # 2. Call confluent("result", ...sourceNames)
 # 3. Measure latency
 # 4. Verify merged object has all N keys
}

^"baseline"{
 fan_2_ms: 0.01,
 fan_10_ms: 0.05,
 fan_100_ms: 0.5,
 scaling: "should be approximately linear in source count",
 note: "Object.assign on N objects is O(total keys)",
}

#>wonder_docs_benchmarks_spw_confluentfanin_1
?["What happens when you zoom from the concept level to the workspace level in Benchmark: Confluent Fan-In?"]{
  #:depth #!mathematical // lens: material grain
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "benchmark" // this file's atom
  !probe{ "the atom is concept-scale; zoom out: what workspace-level pattern does this concept participate in?" }
  $%[register.bank_size, register.active_bindings]
}

#>wonder_docs_benchmarks_spw_confluentfanin_2
?["What ripples if #confluent_fanin changes in this file?"]{
  #:depth #!stylistic // lens: formal structure
  $#educational@workspace => %[reference.count, depth.downstream]
  ~#downstream: "trace all files that reference this surface"
  !probe{ "imagine renaming #educational to #educational_v2; count broken references; the count reveals how deeply benchmark is woven into the workspace." }
  $%[register.bank_size, register.active_bindings]
  ~<"docs/benchmarks/spw/measure-types.spw"> ~#neighbor(nearest)
}
