# Benchmark: Resonate Immutability
#
# Measures grounded register rejection rate under write pressure.

#:layer #!semantics

^"benchmark"{ ~#name: "resonate-immutability", ~#metric: "ratio" }

^"setup"{
 # Ground N registers:
 grounded_count: 100
 write_attempts: 1000,

 # Each grounded register gets 10 overwrite attempts via set()
}

^"run"{
 ground_phase: {
 call: "registers.resonate(name, value) for 100 names",
 expected: "100 successful groundings",
 }
 overwrite_phase: {
 call: "registers.set(name, newValue) for each grounded name × 10",
 expected: "1000 rejections (all return false)",
 }
}

^"baseline"{
 rejection_rate: 1.0,
 note: "100% of overwrites to grounded registers must be rejected",
 ground_success_rate: 1.0,
 note_2: "re-grounding the same name must also be rejected",
}

#>wonder_docs_benchmarks_spw_resonateimmutability_1
?["What ripples if #resonate_immutability changes in this file?"]{
  #:depth #!mathematical // lens: molecular binding
  $#educational@workspace => %[reference.count, depth.downstream]
  ~#downstream: "trace all files that reference this surface"
  !probe{ "imagine renaming #educational to #educational_v2; count broken references; the count reveals how deeply benchmark is woven into the workspace." }
  $%[register.bank_size, register.active_bindings]
}

#>wonder_docs_benchmarks_spw_resonateimmutability_2
?["What happens when you zoom from the concept level to the workspace level in Benchmark: Resonate Immutability?"]{
  #:depth #!stylistic // lens: ecological zone
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "benchmark" // this file's atom
  !probe{ "the atom is concept-scale; zoom out: what workspace-level pattern does this concept participate in?" }
  $%[register.bank_size, register.active_bindings]
  ~<"docs/benchmarks/spw/confluent-fanin.spw"> ~#neighbor(nearest)
}
