# Benchmark: Register Access
#
# Measures access() latency vs inline property traversal.

#:layer #!semantics

^"benchmark"{ ~#name: "register-access", ~#metric: "latency_ms" }

^"setup"{
  # Create a deeply nested object:
  =[deep, {a: {b: {c: {d: {e: "leaf"}}}}}]

  iterations: 10000
  path: ["a", "b", "c", "d", "e"]
}

^"run"{
  # Via registers.access():
  access_method: {
    call: "registers.access(deep, ['a','b','c','d','e'])",
    expected: "leaf",
  }

  # Via inline traversal:
  inline_method: {
    call: "deep.a.b.c.d.e",
    expected: "leaf",
  }
}

^"baseline"{
  inline_latency_ms: 0.001,
  note: "access() should be within 2x of inline for depth ≤ 10",
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
