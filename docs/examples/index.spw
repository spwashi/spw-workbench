# Examples index
#
# Teachable .spw surfaces under docs/examples/spw/

#:layer #!pragmatics

^["roots"]{
 @here: ~"."
 @learn: ~"../learn"
 @spw: ~"./spw"
}

^["intent"]{
 ~#goal: "Catalog runnable teaching surfaces"
 ~#taste: "small files; one demonstration each"
}

^["catalog"]{
 spirit_cycle: .{
  file: ~"./spw/spirit-cycle.spw"
  teaches: "six-phase spirit walk"
 }
 form_sequence: .{
  file: ~"./spw/form-sequence.spw"
  teaches: "confluence wrap / label / membrane / reduce"
 }
 template_holes: .{
  file: ~"./spw/template-holes.spw"
  teaches: "slots, defaults, expand ≠ mutate"
 }
 sense_loop: .{
  file: ~"./spw/sense-loop.spw"
  teaches: "CLI invent→map→formula→analyze protocol"
 }
 brace_autocomplete: .{
  file: ~"./spw/brace-autocomplete.spw"
  teaches: "brace dyads for editors"
 }
 grounded_register: .{
  file: ~"./spw/grounded-register.spw"
  teaches: "register grounding"
 }
 measure_normalization: .{
  file: ~"./spw/measure-normalization.spw"
  teaches: "% measure in [0,1]"
 }
 merge_provenance: .{
  file: ~"./spw/merge-provenance.spw"
  teaches: "confluent merge lineage"
 }
 substrate_introspection: .{
  file: ~"./spw/substrate-introspection.spw"
  teaches: "substrate events"
 }
}

^["learn"]{
 hub: ~"../learn/README.md"
 path: ~"../learn/path.md"
 worked: ~"../learn/worked-cli.md"
}

^["try"]{
 invent: `npm run spw -- invent docs/examples --role hub`
 skim_form: `npm run spw -- skim docs/examples/spw/form-sequence.spw`
}
