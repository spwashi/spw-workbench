# Example: Merge Provenance
#
# &[a, b, c] merges with tracked source registers.

#:layer #!pragmatics

^"example"{ ~#name: "merge-provenance", ~#demonstrates: "confluent() tracks which sources contributed" }

^"input"{
  # Set up sources:
  =[x, {a: 1}]
  =[y, {b: 2}]
  =[z, {c: 3}]

  # Merge:
  &[x, y, z]
}

^"expected"{
  merged_value: { a: 1, b: 2, c: 3 },
  provenance: "&",
  accessMode: "confluent",
  mergedFrom: ["x", "y", "z"],
}

^"notes"{
  "Object sources are merged via Object.assign.",
  "Array sources are concatenated.",
  "Mixed sources are collected into an array.",
  "mergedFrom field preserves the source register names.",
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
