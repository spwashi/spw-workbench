# Example: Substrate Introspection
#
# $[x] returns RegisterMeta — the register itself, not its value.

#:layer #!pragmatics

^"example"{ ~#name: "substrate-introspection", ~#demonstrates: "materialize() returns register metadata" }

^"input"{
 # Ground a value:
 #[color, "red"]

 # Read it a few times:
 .color
 .color
 .color

 # Introspect:
 $[color]
}

^"expected"{
 meta: {
 name: "color",
 topology: "#",
 accessMode: "category",
 containerAffinity: "[]",
 provenance: "#",
 grounded: true,
 accessCount: 3,
 lastAccessed: "timestamp",
 }
}

^"notes"{
 "$X gives metadata, not the value 'red'.",
 "accessCount tracks how many times get() was called.",
 "lastAccessed is a Date.now() timestamp.",
 "containerAffinity is inferred from the accessMode.",
}

#>wonder_docs_examples_spw_substrateintrospection_1
?["What ripples if #substrate_introspection changes in this file?"]{
  #:depth #!mathematical // lens: molecular binding
  $#educational@workspace => %[reference.count, depth.downstream]
  ~#downstream: "trace all files that reference this surface"
  !probe{ "imagine renaming #educational to #educational_v2; count broken references; the count reveals how deeply example is woven into the workspace." }
  $%[register.bank_size, register.active_bindings]
}

#>wonder_docs_examples_spw_substrateintrospection_2
?["What happens when you zoom from the workflow level to the workspace level in Example: Substrate Introspection?"]{
  #:depth #!stylistic // lens: ecological zone
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "example" // this file's atom
  !probe{ "the atom is workflow-scale; zoom out: what workspace-level pattern does this workflow participate in?" }
  $%[register.bank_size, register.active_bindings]
  ~<"docs/examples/spw/brace-autocomplete.spw"> ~#neighbor(nearest)
}
