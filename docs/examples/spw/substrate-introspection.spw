# Example: Substrate Introspection
#
# $[x] returns RegisterMeta — the register itself, not its value.

#:layer #!pragmatics

^"example"{ ~#name: "substrate-introspection", ~#demonstrates: "materialize() returns register metadata" }

^"input"{
  # Ground a value:
  #[color, "red"]

  # Read it a few times:
  .color
  .color
  .color

  # Introspect:
  $[color]
}

^"expected"{
  meta: {
    name: "color",
    topology: "#",
    accessMode: "category",
    containerAffinity: "[]",
    provenance: "#",
    grounded: true,
    accessCount: 3,
    lastAccessed: "timestamp",
  }
}

^"notes"{
  "$X gives metadata, not the value 'red'.",
  "accessCount tracks how many times get() was called.",
  "lastAccessed is a Date.now() timestamp.",
  "containerAffinity is inferred from the accessMode.",
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
