# Example: Sense loop as a prompt surface
#
# Executable *as documentation* — the steps name CLI acts.
# Run the twin transcript: docs/learn/worked-cli.md

#:layer #!pragmatics
#:status #!active

^["example"]{
 ~#name: "sense-loop"
 ~#demonstrates: "invent → map → formula → analyze → drill"
 ~#effect_default: "effect.l0.measure"
}

^["intent"]{
 ~#goal: "Give agents and humans a single ordered corpus-read protocol"
 ~#taste: "one question per step"
}

^["roots"]{
 @learn: ~"../../learn"
 @examples: ~"."
 @runtime: ~"../../runtime/md"
}

^["loop"]{
 >>[0] invent  — what surfaces exist? warmth/role?
 >>[1] map     — hubs, cycles, broken targets, strands?
 >>[2] formula — named catalog + embedded patterns?
 >>[3] analyze — multi-selector density?
 >>[4] drill   — skim/select/query one hub
 >>[5] pulse   — dry measure (optional)
}

^["commands"]{
 invent: `npm run spw -- invent docs/examples --sort degree -n 15`
 map: `npm run spw -- map docs/examples --hubs 8`
 formula: `npm run spw -- formula docs/theory/spw --family field --top 10`
 analyze: `npm run spw -- analyze docs/examples --quiet`
 drill: `npm run spw -- skim docs/examples/spw/form-sequence.spw`
 pulse: `npm run spw -- pulse docs/examples/spw/form-sequence.spw --check`
}

^["docs"]{
 sense: ~"../../runtime/md/sense-loop.md"
 worked: ~"../../learn/worked-cli.md"
 cheat: ~"../../learn/cheat-sheet.md"
}

^["refuse"]{
 "Skip invent and jump to mass mutate"
 "Treat map JSON as genotype"
 "Elevate to effect.l2.workspace without accept"
}
