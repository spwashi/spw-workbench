# Example: Grounded Register
#
# #[name, value] creates an immutable register via resonate().

#:layer #!pragmatics

^"example"{ ~#name: "grounded-register", ~#demonstrates: "immutable identity binding via resonate()" }

^"input"{
 # Ground a truth:
 #[pi, 3.14159]

 # Attempt to overwrite:
 =[pi, 2.71828]

 # Read the value:
 .pi
}

^"expected"{
 after_ground: {
 register: "pi",
 value: 3.14159,
 grounded: true,
 provenance: "#",
 accessMode: "category",
 }
 after_overwrite_attempt: {
 register: "pi",
 value: 3.14159,
 changed: false,
 reason: "set() returns false for grounded registers",
 }
 after_read: {
 result: 3.14159,
 }
}

^"notes"{
 "resonate() sets grounded=true on the RegisterValue.",
 "set() checks grounded flag and rejects writes to grounded registers.",
 "delete() also rejects deletion of grounded registers.",
}

#>wonder_docs_examples_spw_groundedregister_1
?["How would a biology portfolio express example?"]{
  #:depth #!stylistic ~#lens(living system)
  ~#translation_target: "biology"
  ~#source_concept: "example"
  !probe{ "rewrite the root frame in biology vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[register.bank_size, register.active_bindings]
}

