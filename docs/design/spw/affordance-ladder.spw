# Affordance Ladder
#
# Progressive reveal of capabilities through small, reversible steps.

#:layer #!pragmatics

^["goal"]{
  ~#intent: "Teach the ethos by climbing capability levels."
  ~#rule: "One new affordance per level."
}

^["levels"]{
  observe: "read-only AST + tokens + mapping tethers"
  select: "hover/click mapping between text and structure"
  transform: "safe transforms (format/rename/extract)"
  compose: "chain transforms into recipes"
  author: "create operators/macros/lenses"
}

^["progressive_enhancement"]{
  ~#requirements{
    intermediate_element: "chip/tether/overlay"
    gesture: "single new gesture"
    sandbox: "undoable preview"
  }
}

^["motion_support"]{
  ~#continuity_rules{
    selection_tether: "this maps to that"
    morph_highlight: "same object, different detail"
    replay_cursor: "how you got here"
  }
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
