# Affordance Ladder
#
# Progressive reveal of capabilities through small, reversible steps.

#:layer #!pragmatics

^["goal"]{
 ~#intent: "Teach the ethos by climbing capability levels."
 ~#rule: "One new affordance per level."
 ~#taste: "Each level is reachable from the one below it without a leap the ladder has not already taught."
}

^["levels"]{
 observe: "read-only AST + tokens + mapping tethers"
 select: "hover/click mapping between text and structure"
 transform: "safe transforms (format/rename/extract)"
 compose: "chain transforms into recipes"
 author: "create operators/macros/lenses"
}

^["progressive_enhancement"]{
 ~#requirements{
 intermediate_element: "chip/tether/overlay"
 gesture: "single new gesture"
 sandbox: "undoable preview"
 }
}

^["motion_support"]{
 ~#continuity_rules{
 selection_tether: "this maps to that"
 morph_highlight: "same object, different detail"
 replay_cursor: "how you got here"
 }
}

#>wonder_docs_design_spw_affordanceladder_1
?["What was Affordance Ladder before it was this, and what could it become?"]{
  #:depth #!experiential ~#lens(curated collection)
  ~#past: "git log --oneline -- docs/design/spw/affordance-ladder.spw | head -3"
  ~#future: "what frame would you add next?"
  !probe{ "the file's git history IS its evolutionary record; the next natural frame reveals the author's trajectory." }
  $%[design.component_count, design.theme_coverage]
}

#>wonder_docs_design_spw_affordanceladder_2
?["How would a biology algorithm express spw/affordance-ladder?"]{
  #:depth #!computational // lens: living system
  ~#translation_target: "biology"
  ~#source_concept: "goal"
  !probe{ "rewrite the root frame in biology vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[design.component_count, design.theme_coverage]
  ~<"docs/design/spw/a11y-tree.spw"> ~#neighbor(nearest)
}
