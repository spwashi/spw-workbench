# A11y Tree Preview
#
# Accessibility as a parallel representation.

#:layer #!pragmatics

^["goal"]{
  ~#intent: "Expose the accessibility tree alongside text, AST, context."
  ~#contract: "Accessibility is a first-class state surface."
}

^["exposure"]{
  ~#fields{
    role: "computed role"
    name: "accessible name"
    state: "expanded/selected/disabled"
    focus_path: "tab order path"
    live_announcements: "queued announcements"
  }
}

^["ui"]{
  ~#panel: "Screen Reader Preview"
  ~#behaviors{
    follow_focus: "always show current focus"
    snapshot: "capture tree on major state changes"
    diff: "compare before/after updates"
  }
}

^["implementation"]{
  ~#guidance{
    semantics_first: "use HTML semantics before ARIA"
    shared_state: "derive names from tuple/state"
    focus_visual: "mirror focus in visible UI"
  }
}

?["Does the Cayley table for brace×operator composition close under {FRAME}?"]
  #:depth #!mathematical  // lens: formula
  $^seed[_.sym:D4] => %[register.left, register.right]
  ~<@spec/core/OPERATORS.md>
  !probe{ "construct the group action table; check if .left ↔ .right reflection commutes with ~ → ! operator tense shift" }

?["What orbits emerge when D4 acts on nested brace pairs?"]
  #:depth #!computational  // lens: molecule
  $^[_.sym] => &[orbit.stabilizer]
  ~<@spw/registries/curiosity-brace.spw>
  !probe{ "enumerate fixed points of the dihedral action on {{{}}} nesting depth 3; count distinct register states" }
