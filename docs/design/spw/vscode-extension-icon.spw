# VS Code Extension Icon

# Intent
#:layer #!pragmatics

Capture the semantic and formal rules for the Spw VS Code extension icon.
Keep the production asset legible at small sizes while preserving the workspace / resonance / probe metaphor.

^["production_assets"]{
 @svg: ~"../../../extensions/vscode-spw/icon.svg"
 @png: ~"../../../extensions/vscode-spw/icon.png"

 ~#editable_source: "icon.svg is the editable source."
 ~#package_asset: "icon.png is the marketplace and package asset."
}

^["semantic_parts"]{
 ~#workspace_frame: "Two restrained structural corners imply a container without boxing the mark in."
 ~#resonance_ribbon: "A teal current rises through the frame and carries the icon's main silhouette."
 ~#probe_point: "A small amber ignition mark confirms direction and intent."
}

^["formal_rules"]{
 ~#silhouette: "Prioritize silhouette before texture or detail."
 ~#presentation: "Keep the dark rounded-square field as the primary product presentation."
 ~#palette: "Use a tight palette: midnight navy, teal or sea-glass, restrained amber, optional pale highlight."
 ~#geometry: "Preserve crisp vector edges and simple internal geometry."
 ~#legibility: "Judge every revision at 16px, 32px, and marketplace size before treating it as canonical."
}

^["avoid"]{
 ~#leaf_read: "Avoid leaf, wing, or wellness-brand readings."
 ~#sparkle_read: "Avoid generic sparkle iconography."
 ~#border_weight: "Avoid heavy enclosing borders."
 ~#atmosphere: "Avoid painterly atmospherics, dust, scene lighting, or textured backgrounds."
 ~#palette_sprawl: "Avoid extra colors that blur the core form."
}

^["geometry_notes"]{
 ~#frame: "The frame is suggestive, not complete; it should read as workspace structure, not as a logo box."
 ~#base: "The ribbon base should feel anchored and cut rather than organic or floppy."
 ~#probe: "The probe accent should be asymmetric and precise so it reads as a tool signal, not decoration."
 ~#canon_face: "Transparent exports are optional working aids; the navy rounded-square icon is the canonical extension face."
}

^["evaluation"]{
 ~#ribbon_overreach: "If the ribbon overwhelms the frame, the icon loses workspace meaning."
 ~#frame_overreach: "If the frame overwhelms the ribbon, the icon becomes generic tooling chrome."
 ~#probe_overreach: "If the probe dominates, the icon collapses into a stock sparkle app mark."
 ~#balance: "The best balance is one symbol that reads as instrument first, ornament second."
}

