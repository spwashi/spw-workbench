# Design Index
#
# Visual system, component architecture, themes, and aesthetic balance.

#:layer #!pragmatics

^["roots"]{
 @here: ~"."
}

^["visual"]{
 !["Themes & Progression"]
 .. ~<research>"./spw/design-research.spw" # Phase profiles, lessons
 .. ~<brand>"./spw/vscode-extension-icon.spw" # VS Code icon semantics and form
 .. ~<themes>"./spw/theme-progression.spw" # Theme progression
 .. ~<themes>"./spw/theme-stage-0-snapshots.spw" # Stage 0 snapshots
 .. ~<spirits>"./spw/spirit-sequence.spw" # Spirit sequence
 .. ~<stages>"./spw/stage-scaling-architecture.spw" # Stage scaling architecture
}

^["components"]{
 !["Elements & Web Components"]
 .. ~<adaptation>"./spw/component-adaptation.spw" # Component adaptation rules
 .. ~<wc>"./spw/web-components.spw" # Web component strategy
 .. ~<layout>"./spw/footer-slots.spw" # Footer slot registry
}

^["accessibility"]{
 !["A11y & Affordance"]
 .. ~<a11y>"./spw/a11y-tree.spw" # A11y tree preview
 .. ~<affordance>"./spw/affordance-ladder.spw" # Progressive capability ladder
}

^["protocols"]{
 !["Language and CLI candidates"]
 .. ~<spw_q>"./spw-q-candidate-spec.md" # Pre-v1 structural query contract and promotion gates
 .. ~<cli_cache>"./spw-cli-cache-plan.md" # Proposed content and corpus-generation cache architecture
}

^["rails"]{
 !["Markdown Rails"]
 .. ~<metaphor>"./md/quantum-metaphor.md" # Quantum metaphor research
 .. ~<semantics>"./md/semantic-features-review.md" # Semantic features review
 .. ~<testing>"./md/semantic-features-testing.md" # Semantic features testing
 .. ~<cognitive>"./md/cognitive-hierarchy-visual-theming.md"
 .. ~<interaction>"./md/interaction-semantics-design.md"
 .. ~<keyboard>"./md/keyboard-navigation-design.md"
 .. ~<model>"./md/semantic-features-model.md"
 .. ~<opus>"./md/opus-theory-cache.md"
 .. ~<ux>"./md/ux-dimensions.md"
 .. ~<plan>"./md/phase-3-flow-inspector-plan.md"
 .. ~<plan>"./md/research-episodes-plan.md"
 .. ~<goals>"./md/goals.md"
 .. ~<history>"./md/history.md"
}

#>wonder_docs_design_index_1
?["How would an ecology portfolio express design/index?"]{
  #:depth #!stylistic // lens: ecological zone
  ~#translation_target: "ecology"
  ~#source_concept: "roots"
  !probe{ "rewrite the root frame in ecology vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[design.component_count, design.theme_coverage]
}

#>wonder_docs_design_index_2
?["How does this file's voice differ from design/index (design/index)?"]{
  #:depth #!educational // lens: molecular binding
  ~<@here> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]@here
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}
