#>wonder_docs_toc_1
?["What ripples if #toc changes in this file?"]{
  #:depth #!mathematical // lens: formal structure
  $#educational@workspace => %[reference.count, depth.downstream]
  ~<./features/spw/onboarding.spw> // first downstream dependency
  !probe{ "imagine renaming #educational to #educational_v2; count broken references; the count reveals how deeply roots is woven into the workspace." }
  $%[register.bank_size, register.active_bindings]
}

#>wonder_docs_toc_2
?["What happens when you zoom from the workflow level to the workspace level in Table of Contents?"]{
  #:depth #!stylistic // lens: material grain
  $^["_"]@here => &[@workspace] // local -> global projection
  ~#zoom_in: "roots" // this file's atom
  !probe{ "the atom is workflow-scale; zoom out: what workspace-level pattern does this workflow participate in?" }
  $%[register.bank_size, register.active_bindings]
  ~<"docs/index.spw"> ~#neighbor(nearest)
}
