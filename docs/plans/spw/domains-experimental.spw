# Experimental Domains
#
# Sketches for new Spw domains: Prompt@, Vector@/Tensor@, Sheaf@, Quantum@.
# These are experimental and subject to syntax iteration.

#:layer #!pragmatics

^["roots"]{
 @examples: ~"../examples"
}

^["prompt"]{
 # Purpose: prompt engineering primitives.
 # Syntax ideas:
 Prompt@{
 !persona["assistant"] # persona capsule
 .. !constraints["brief|factual|json"]
 .. !context[{project: "hud"}]
 .. !task["summarize"]{ @input }
 }

 # Tests:
 @examples/experimental/prompt.spw
}

^["vector_tensor"]{
 # Purpose: vector/tensor analysis.
 # Syntax ideas:
 Vector@{
 ^v[1, 0, 0]^vector # typed vector literal
 .. ~normalize[v] # transform
 .. @proj["xy"] # projection
 }

 Tensor@{
 ^T[[[1,0],[0,1]]]^tensor{ # rank/dtype metadata optional
 ~#sym: true
 ~#shape: [2,2]
 ~#dtype: "float32"
 }
 .. ~contract[T, i1=i2]
 }

 # Tests:
 @examples/experimental/vector.spw
 @examples/experimental/tensor.spw
}

^["sheaf"]{
 # Purpose: sheaf manipulation.
 # Syntax ideas:
 Sheaf@{
 <sheaf["cover": "U1,U2"]{ # capsule for sheaf metadata
 ^["section:U1"]{ !["f1"] }
 ^["section:U2"]{ !["f2"] }
 .. <>glue["U1","U2"] # couple + glue
 }>
 }

 # Tests:
 @examples/experimental/sheaf.spw
}

^["quantum"]{
 # Purpose: quantum parsing/semantics.
 # Syntax ideas:
 Quantum@{
 !["|0>"] # state prep
 .. ~superpose["|0>", "|1>"] # wave
 .. ?measure["z"]{ # probe with measurement
 *{ !boon["|0>"] | !bane["|1>"] }
 }
 }

 # Tests:
 @examples/experimental/quantum.spw
}

^["container-physics"]{
 # UAL dialect idea: containers as fundamental particles.
 # Concept (<>), Scene (()), Mode ([]), Definition ({}).
 # Intrinsic labels (optional): {_A ... }_A ; A{} == {_A }_A
 # Streaming (<< >>) = layered concept entry; N-range (( )) = emphasis wrapper.
 # Operators remain explicit in Spw for determinism; UAL normalizer could reduce scripts to container-only plus metadata.
}

#>wonder_docs_plans_spw_domainsexperimental_1
?["What is the curation density of prompt (spw/domains-experimental)?"]{
  #:depth #!computational // lens: curated collection
  $^["roots"]@examples => %[collection.measure]
  ~<docs/plans/spw/domains-experimental.spw> // introspect
  !probe{ "measure: how many distinct concepts does this frame bind? what is the ratio of structural operators to content — and what does that density reveal?" }
  $%[plan.commit_count, plan.phase_progress]
}

#>wonder_docs_plans_spw_domainsexperimental_2
?["What is the metabolic signature of reading Experimental Domains?"]{
  #:depth #!mathematical // lens: living system
  $%[line.operator_density, brace.nesting_rhythm] => ~#reading_feel
  ~#structure: "roots → prompt → vector_tensor" // frame flow
  !probe{ "read aloud for 30 seconds; where do you pause? pauses mark structural joints." }
  ~<"docs/plans/spw/architecture.spw"> ~#neighbor(nearest)
}
