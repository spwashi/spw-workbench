# Domain Registry
#
# Modules and initialization order.
# @see @src/core/domains/

#:layer #!pragmatics

^["roots"]{
 @src: ~"../src"
}

^["domains"]{
 core # 0: primitives
 infra # 1: infrastructure
 design # 2: visual system
 ui # 3: components
 lang # 4: language engine
 viz # 5: visualizations
 features # 6: interactive behaviors
 app # 7: application shell
 runtime # 8: execution engine
 debug # 9: development tools
 cli # 10: command-line interface
 platform # 11: entrypoint wiring
}

^["design"]{
 ~#path: @src/design/

 themes/ # Theme definitions, token bank, bus
 themes/personality/ # Personality trait vectors (warmth, rhythm, grain, ...)
 themes/cognitive-bridge.ts # JS→CSS narrative + cognitive token bridge
 semantics/ # Semantic features (intensity, proximity, clarity)
 tokens.ts # Design token access (--spw-* CSS variables)
 components.ts # Component registry
 mode.ts # Design mode overlay
}

^["core"]{
 ~#path: @src/core/

 domains # WHAT exists
 conventions # HOW named
 layers # Phasor model
 operators # Sigil semantics
 quality # 4/5 BBBH
 tally # Countable structures
}

^["infra"]{
 ~#path: @src/infra/

 timing # WHEN happens (top-down)
 lifecycle # Component states (bottom-up)
 state # Global application state
 accessibility
}

^["lang"]{
 ~#path: @src/lang/
 ~#wraps: @src/seed/

 hooks # Timing integration
 lexer
 parser
 grammar
 types
}

^["viz"]{
 ~#path: @src/viz/

 ast
 tokens
 flow
 steps
 hooks
}

^["runtime"]{
 ~#path: @src/runtime/

 interpreter
 state # Valence (5/5 BBBH)
 document
 repl
}

#>wonder_docs_plans_spw_domains_1
?["What invariant holds across every frame in Domain Registry?"]{
  #:depth #!computational // lens: ecological zone
  $^["_"]@here => %[shared.property]
  ~#hypothesis: "all frames in this file share ____"
  !probe{ "extract the property common to roots's frames; if none exists, the file may lack cohesion or may be a deliberate collection." }
  $%[runtime.stage, runtime.queue_depth]
}

#>wonder_docs_plans_spw_domains_2
?["What was Domain Registry before it was this, and what could it become?"]{
  #:depth #!mathematical // lens: molecular binding
  ~#past: "git log --oneline -- docs/plans/spw/domains.spw | head -3"
  ~#future: "what frame would you add next?"
  !probe{ "the file's git history IS its evolutionary record; the next natural frame reveals the author's trajectory." }
  $%[runtime.stage, runtime.queue_depth]
  ~<docs/plans/spw/architecture.spw>  // nearest neighbor
}
