# Domain Registry
#
# Modules and initialization order.
# @see @src/core/domains/

#:layer #!pragmatics

^["roots"]{
  @src: ~"../src"
}

^["domains"]{
  core        # 0: primitives
  infra       # 1: infrastructure
  design      # 2: visual system
  ui          # 3: components
  lang        # 4: language engine
  viz         # 5: visualizations
  features    # 6: interactive behaviors
  app         # 7: application shell
  runtime     # 8: execution engine
  debug       # 9: development tools
  cli         # 10: command-line interface
  platform    # 11: entrypoint wiring
}

^["design"]{
  ~#path: @src/design/

  themes/             # Theme definitions, token bank, bus
  themes/personality/ # Personality trait vectors (warmth, rhythm, grain, ...)
  themes/cognitive-bridge.ts  # JS→CSS narrative + cognitive token bridge
  semantics/          # Semantic features (intensity, proximity, clarity)
  tokens.ts           # Design token access (--spw-* CSS variables)
  components.ts       # Component registry
  mode.ts             # Design mode overlay
}

^["core"]{
  ~#path: @src/core/

  domains       # WHAT exists
  conventions   # HOW named
  layers        # Phasor model
  operators     # Sigil semantics
  quality       # 4/5 BBBH
  tally         # Countable structures
}

^["infra"]{
  ~#path: @src/infra/

  timing        # WHEN happens (top-down)
  lifecycle     # Component states (bottom-up)
  state         # Global application state
  accessibility
}

^["lang"]{
  ~#path: @src/lang/
  ~#wraps: @src/seed/

  hooks         # Timing integration
  lexer
  parser
  grammar
  types
}

^["viz"]{
  ~#path: @src/viz/

  ast
  tokens
  flow
  steps
  hooks
}

^["runtime"]{
  ~#path: @src/runtime/

  interpreter
  state         # Valence (5/5 BBBH)
  document
  repl
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
