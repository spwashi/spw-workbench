# Dependencies
#
# Module relationships.

#:layer #!pragmatics

^["roots"]{
  @src: ~"../src"
}

^["dependencies"]{
  core > []
  infra > [core]
  lib/spw > []
  design > [core]
  ui > [core, design]
  lang > [core, infra, lib/spw]
  viz > [core, infra, lang]
  runtime > [core, infra, lang]
  features > [core, infra, ui, viz]
  debug > [infra, runtime]
  cli > [infra, lang, runtime]
  app > [core, infra, design, ui, lang, viz, features, runtime]
  platform > [app, core, infra, design, ui, features]
}

^["portability"]{
  @src/seed/^portable
  @src/runtime/interpreter/^portable

  @src/viz/^bound
  @src/design/^bound
  @src/app/^bound
}

^["direction"]{
  timing!       # Top-down
  domains!

  lifecycle?    # Bottom-up
  events?
}

^["wrappers"]{
  lang ~ lib/spw    # lang wraps lib/spw with hooks
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
