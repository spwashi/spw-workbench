# Dependencies
#
# Module relationships.

#:layer #!pragmatics

^["roots"]{
 @src: ~"../src"
}

^["dependencies"]{
 modules: #[
  .{ module: "core", requires: #[] },
  .{ module: "infra", requires: #[core] },
  .{ module: "lib/spw", requires: #[] },
  .{ module: "design", requires: #[core] },
  .{ module: "ui", requires: #[core, design] },
  .{ module: "lang", requires: #[core, infra, "lib/spw"] },
  .{ module: "viz", requires: #[core, infra, lang] },
  .{ module: "runtime", requires: #[core, infra, lang] },
  .{ module: "features", requires: #[core, infra, ui, viz] },
  .{ module: "debug", requires: #[infra, runtime] },
  .{ module: "cli", requires: #[infra, lang, runtime] },
  .{ module: "app", requires: #[core, infra, design, ui, lang, viz, features, runtime] },
  .{ module: "platform", requires: #[app, core, infra, design, ui, features] }
 ]
}

^["portability"]{
 @src/seed/^portable
 @src/runtime/interpreter/^portable

 @src/viz/^bound
 @src/design/^bound
 @src/app/^bound
}

^["direction"]{
 timing! # Top-down
 domains!

 lifecycle? # Bottom-up
 events?
}

^["wrappers"]{
 lang ~ lib/spw # lang wraps lib/spw with hooks
}

#>wonder_docs_plans_spw_dependencies_1
?["What happens when you zoom from the workflow level to the workspace level in Dependencies?"]{
  #:depth #!mathematical // lens: material grain
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "roots" // this file's atom
  !probe{ "the atom is workflow-scale; zoom out: what workspace-level pattern does this workflow participate in?" }
  $%[runtime.stage, runtime.queue_depth]
}

#>wonder_docs_plans_spw_dependencies_2
?["What ripples if #dependencies changes in this file?"]{
  #:depth #!stylistic // lens: formal structure
  $#educational@workspace => %[reference.count, depth.downstream]
  ~#downstream: "trace all files that reference this surface"
  !probe{ "imagine renaming #educational to #educational_v2; count broken references; the count reveals how deeply roots is woven into the workspace." }
  $%[runtime.stage, runtime.queue_depth]
  ~<"docs/plans/spw/architecture.spw"> ~#neighbor(nearest)
}
