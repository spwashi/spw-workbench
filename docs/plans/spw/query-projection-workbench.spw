# Query Projection Workbench
#
# How to query the codebase by operator/brace/label and build structures from projections.

#>query_projection_workbench
#:workbench #!learning
#:layer #!pragmatics

^"intent"{
  ~#goal: "Make operator combinatorics, projection building, and model learning practical."
}

^"workflow"{
  step_1: "snapshot runtime memory lattice"
  command_1: "npm run spw:mem:dump -- --dump-root /tmp/spw-mem-dumps --label pre-loop --include-extra"

  step_2: "query by operator/brace/label perspective"
  command_2: "npm run spw:ls -- --seq '?~@&*^' --probe '?(subject).[' --braces '<>{}' --surface hybrid --mode hybrid --equiv soft --model lattice --root .spw --top 20"

  step_3: "select top-ranked files as projection drivers"
  step_4: "materialize updates through projection owners in @gen/index.spw"
  step_5: "record loaded/considered and consequences in @biome/trace.spw + @spw/consequence.spw"
}

^"intuitive_vs_experimental"{
  intuitive: {
    profile: "stable selectors, grounded refs, warm/hot cache discipline"
    objective: "predictable navigation and reproducible runs"
  }

  experimental: {
    profile: "labeled operators/braces, scoped syntax variants, model sweeps"
    objective: "discover higher-signal structures without destabilizing core semantics"
  }
}

^"material_properties"{
  density: "one dimension of material behavior (concept packing and coupling pressure)"
  viscosity: "resistance to change under hot replacement"
  elasticity: "ability to recover after projection perturbations"
  porosity: "cross-boundary permeability between roots/biomes/phases"
  anisotropy: "directional bias in query traversal and projection flow"
  source: @biome/algos/material.spw
}

^"projection_contract"{
  "query outputs should name spec owner and generator owner",
  "generated surfaces stay under .spw/gen/* and are treated as projections",
  "trace remains reference-first and replayable from snapshot + refs",
}

^"learning_prompts"{
  prompts: [
    "Which operator sequence best predicts stable projection quality?",
    "How does density shift under different model lenses?",
    "Which labels correlate with reusable projection structures?",
    "What is intuitive today but should graduate to experimental tomorrow?",
  ]
}

^"register_jazz"{
  note: "Registers can carry referential jazz by keeping priming and realization distinct."
  metrics: [conceptPriming, realization, collapseGap, deferred, spin, charge, registerDanglingCount]
  prompt: "Which sequences create productive spin without destabilizing material projections?"
}

^"materialization_cycle"{
  priming: "sequence primes a register without forcing body generation"
  concept: "named potential remains probeable and lens-addressable"
  frame: "containerized relation geometry selected by query context"
  body: "projection artifact resolved from frame + ownership rules"
  memory_locations: [".spw/hot.spw", ".spw/harness/memory-surface.spw", ".spw/harness/probes/archive-index.spw", ".spw/gen/*"]
}

^"equivalence_modes"{
  strict: "literal token identity only"
  soft: "exploratory alias graph for liminal/operator equivalence (e.g. # ~ .[/.], . ~ {, @ ~ .})"
  formatter: "npm run spw:format:equiv to increment scripts toward equivalent canonical forms and surface mutation contours"
  envelope_ops: "prefix/postfix wrapper operators for navigable refs: [&,^,*,?,~,!,%,=] on both ~\"path\" and @root/path forms"
}

^profiles[franchise_dev]{
  domain: "game/movie franchise development"
  loop: "operator sequence -> character/world arc probe -> projection drafts -> continuity checks"
  probes: ["tone continuity", "character register drift", "arc collapse viability"]
  output: "episodic scripts + lore projections with traceable semantic contracts"
}

^profiles[materials_journal]{
  domain: "materials science research + chemistry journaling"
  loop: "operator sequence -> hypothesis probe -> measurement archive -> invariant synthesis"
  probes: ["density trend", "phase transition behavior", "reaction pathway confidence"]
  output: "experiment narratives + reproducible query/projection logs for later replay"
}

^profiles[mount_slice]{
  domain: "mount architecture + dialect hardening"
  loop: "init mount surfaces -> run mount validator -> review semicolon/lock diagnostics -> promote scoped grammar changes"
  commands: ["npm run spw:mount:init", "npm run spw:mount", "npm run spw:mount -- --strict --json"]
  output: "parse-safe mount ONF core with explicit experimental syntax queue"
}

?["Under what conditions does cache eviction resemble cellular apoptosis?"]
  #:depth #!experiential  // lens: cell
  $%[cache.tier] => ~#eviction_threshold
  ~<@biome/ocean/algos/material.spw>
  !probe{ "plot decay curves for hot→warm→cold tier transitions; compare with biological half-life λ = ln(2)/t½" }

?["What is the expected cache hit ratio under Zipf-distributed access patterns?"]
  #:depth #!computational  // lens: texture
  $%[cache.hit_rate, cache.miss_rate] => ~#zipf_alpha
  ~<@spw/biome/ocean/algos/cluster.spw>
  !probe{ "model P(hit) = 1 - (1/N)^α for N documents; measure deviation from theoretical optimum" }
