# Plans Index
#
# Roadmaps, Blueprints, Directions, and Architecture Strategy.

#:layer #!pragmatics

^["roots"]{
 @here: ~"."
}

^["strategy"]{
 !["Roadmaps"]
 .. ~<roadmap>"./md/documentation-roadmap.md" # Documentation roadmap
 .. ~<directions>"./spw/directions.spw" # 1-3-6 month priorities
 .. ~<summary>"./md/direction-commit-summary.md" # Direction commit summary
}

^["architecture"]{
 !["System Architecture"]
 .. ~<arch>"./spw/architecture.spw" # Layers and relationships
 .. ~<arch>"./md/architecture-map.md" # Architecture map
 .. ~<domains>"./spw/domains.spw" # Module registry
 .. ~<deps>"./spw/dependencies.spw" # Import graph
}

^["implementation"]{
 !["Execution Plans"]
 .. ~<blueprint>"./md/implementation-blueprint.md" # Implementation blueprint
 .. ~<refactor>"./md/refactor-plan.md" # Refactor plan
 .. ~<demo>"./md/phase-3-demo-guide.md" # Phase 3 demo guide
}

^["patterns"]{
 !["Experimental & Patterns"]
 .. ~<experimental>"./spw/domains-experimental.spw" # Experimental domains
 .. ~<patterns>"./spw/patterns.spw" # Naming conventions
}

#>wonder_docs_plans_index_1
?["How would a biology portfolio express plans/index?"]{
  #:depth #!stylistic // lens: living system
  ~#translation_target: "biology"
  ~#source_concept: "roots"
  !probe{ "rewrite the root frame in biology vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[plan.commit_count, plan.phase_progress]
}

#>wonder_docs_plans_index_2
?["How does this file's voice differ from plans/index (plans/index)?"]{
  #:depth #!educational // lens: curated collection
  ~<@here> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]@here
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}
