# Features Index
#
# User-facing features, interaction models, and learning paths.

#:layer #!pragmatics

^["roots"]{
 @here: ~"."
}

^["learning"]{
 !["Onboarding & Flow"]
 .. ~<onboarding>"./spw/onboarding.spw" # Learning path for devs/LLMs
 .. ~<onboarding>"./spw/onboarding-flow.spw" # Onboarding flow reference
 .. ~<lens>"./spw/lens-walk.spw" # Lens-walk prompting guide
}

^["interaction"]{
 !["Navigation & Input"]
 .. ~<vim>"./md/vim-guide.md" # Vim keybinding guide
 .. ~<keyboard>"./md/keyboard-audit.md" # Keyboard audit
 .. ~<keyboard>"./md/keyboard-navigation-refactor-plan.md" # Refactor plan
 .. ~<nav>"./spw/navigation-probe.spw" # Focus calculus + breadcrumb semantics
}

^["system"]{
 !["Registry & Coherence"]
 .. ~<registry>"./spw/feature-registry.spw" # Feature naming/versioning
 .. ~<coherence>"./spw/feature-coherence.spw" # End-to-end feature coherence
}

#>wonder_docs_features_index_1
?["What is the algebraic closure of learning (features/index)?"]{
  #:depth #!computational // lens: formal structure
  $^["roots"]@here => %[formula.measure]
  ~<docs/features/index.spw> // introspect
  !probe{ "measure: how many distinct concepts does this frame bind? what is the ratio of structural operators to content — and what does that density reveal?" }
  $%[feature.adoption_rate, feature.discovery_index]
}

#>wonder_docs_features_index_2
?["What is the felt rhythm of reading Features Index?"]{
  #:depth #!mathematical // lens: material grain
  $%[line.operator_density, brace.nesting_rhythm] => ~#reading_feel
  ~#structure: "roots → learning → interaction" // frame flow
  !probe{ "read aloud for 30 seconds; where do you pause? pauses mark grain boundaries." }
  ~<docs/index.spw>  // nearest neighbor
}
