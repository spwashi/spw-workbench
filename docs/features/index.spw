# Features Index
#
# User-facing features, interaction models, and learning paths.

#:layer #!pragmatics

^["roots"]{
  @here: ~"."
}

^["learning"]{
  !["Onboarding & Flow"]
  .. ~<onboarding>"./spw/onboarding.spw"              # Learning path for devs/LLMs
  .. ~<onboarding>"./spw/onboarding-flow.spw"          # Onboarding flow reference
  .. ~<lens>"./spw/lens-walk.spw"                      # Lens-walk prompting guide
}

^["interaction"]{
  !["Navigation & Input"]
  .. ~<vim>"./md/vim-guide.md"                        # Vim keybinding guide
  .. ~<keyboard>"./md/keyboard-audit.md"              # Keyboard audit
  .. ~<keyboard>"./md/keyboard-navigation-refactor-plan.md" # Refactor plan
  .. ~<nav>"./spw/navigation-probe.spw"                # Focus calculus + breadcrumb semantics
}

^["system"]{
  !["Registry & Coherence"]
  .. ~<registry>"./spw/feature-registry.spw"           # Feature naming/versioning
  .. ~<coherence>"./spw/feature-coherence.spw"         # End-to-end feature coherence
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
