# Feature Registry
#
# Naming, ownership, and versioning for feature flags.

#:layer #!pragmatics

^["naming"]{
 # Canonical shape
 spw.{layer}.{feature}[.{subfeature}]

 # Reserved layer tags
 layer: core | infra | lang | runtime | viz | ui | design | features | app | platform | dialects

 # Core is for language primitives (operators/modifiers/containers).
 core: spw.core.operators | spw.core.modifiers | spw.core.containers
}

^["versioning"]{
 # Optional suffixes for evolution and stability
 spw.{layer}.{feature}@v{major}.{minor}
 spw.{layer}.{feature}@v{major}.{minor}:{status}

 # Status tags
 status: stable | preview | experimental | deprecated

 # Examples
 example: spw.core.operators@v0.1
 example: spw.runtime.goals@v0.2:preview
}

^["ownership"]{
 # Each feature should live in the layer that owns its behavior.
 core: domains, conventions, layers, operators, quality, tally
 infra: timing, lifecycle, state, accessibility
 lang: grammar, lexer, parser, dialects, field-dynamics
 runtime: interpreter, registers, goals
 viz: tokens, AST, flow, steps
 ui: component registry, stacking
 design: themes, token bank, personality, cognitive bridge, spirits, liminal
 features: keyboard, onboarding, inspector
 app: integrations and orchestration
 platform: bootstrapping and environment wiring
 production: ensemble-model, template-fill, show-line fields
}

^["lang-math-features"]{
 !["Language & math modeling features"]

 ^feature["spw.math.field-probes"]{
 version: "0.1.0"
 status: stable
 description: "Portable field dynamics: decay, diffuse, transfer, cascade, capacity, affinity, beat"
 source: "packages/spw-seed/src/math/field.ts"
 requires: ["spw.math.graph-probes"]
 }

 ^feature["spw.math.graph-probes"]{
 version: "0.1.0"
 status: stable
 description: "Directed graphs: cycle, topo, shortest path, adjacency matrix"
 source: "packages/spw-seed/src/math/graph.ts"
 }

 ^feature["spw.lang.field-dynamics"]{
 version: "0.1.0"
 status: preview
 description: "Linguistic construct map for sites/carriers/ensembles (theory + PE includes)"
 source: "docs/theory/spw/field-dynamics.spw"
 requires: ["spw.math.field-probes"]
 }

 ^feature["spw.lang.relationship-topography"]{
 version: "0.1.0"
 status: preview
 description: "Cross-domain relationship objects + familiarity strands for business/academic/production models"
 source: "docs/theory/spw/relationship-topography.spw"
 requires: ["spw.math.graph-probes"]
 }

 ^feature["spw.tooling.corpus-map"]{
 version: "0.1.0"
 status: preview
 description: "CLI spw map|topo — path/@ graphs, hubs, cycles, layers, compare familiarity"
 source: "packages/spw-cli/src/map.ts"
 requires: ["spw.lang.relationship-topography", "spw.math.graph-probes"]
 cache: "warm report only; genotype packs remain cold"
 }
}

^["production-features"]{
 !["Show & template production modeling"]

 ^feature["spw.production.ensemble-model"]{
 version: "0.1.0"
 status: preview
 description: "Multi-locus show/template ensembles via field beats, affinity, continuity charge"
 source: "prompts/production/ensemble.spw"
 requires: ["spw.lang.field-dynamics", "spw.math.field-probes"]
 cache: "field:{model_id}:rev{n}:beat{t} warm; genotype packs cold"
 }

 ^feature["spw.production.template-fill"]{
 version: "0.1.0"
 status: preview
 description: "Slot capacity + expand fill as affinity-like allocate; cascade to multi-host emit"
 source: "prompts/templates/"
 requires: ["spw.production.ensemble-model"]
 }
}

^["design-features"]{
 !["Design Domain Features"]

 ^feature["spw.design.personality"]{
 version: "0.1.0"
 status: preview
 description: "Theme personality model — cognitively-grounded trait vectors (warmth, rhythm, grain, luminanceCycle, particleDensity, motionCharacter, depth)"
 source: "@src/design/themes/personality/"
 }

 ^feature["spw.design.cognitive-bridge"]{
 version: "0.1.0"
 status: preview
 description: "JS→CSS bridge computing --spw-narrative-* and --spw-cognitive-* custom properties from personality + semantic features"
 source: "@src/design/themes/cognitive-bridge.ts"
 requires: ["spw.design.personality"]
 }

 ^feature["spw.design.spirits"]{
 version: "0.1.0"
 status: preview
 description: "Per-theme ambient @keyframes animations (9 spirits across nebula, atelier, hud families)"
 source: "src/styles/themes/spirits.css"
 requires: ["spw.design.personality", "spw.design.cognitive-bridge"]
 gates: ["prefers-reduced-motion", "data-performance-mode"]
 }

 ^feature["spw.design.liminal"]{
 version: "0.1.0"
 status: preview
 description: "Three-phase theme transitions (dissolve → liminal → crystallize) when switching between themes with personality"
 source: "src/styles/themes/liminal.css"
 requires: ["spw.design.cognitive-bridge"]
 trigger: "html[data-theme-transitioning='true']"
 }

 ^feature["spw.design.echoes"]{
 version: "0.1.0"
 status: preview
 description: "Cognitive-responsive echo opacity and micro-echo decorations on tokens and panel headers"
 source: "src/styles/themes/echoes.css"
 requires: ["spw.design.cognitive-bridge"]
 }
}

^["roots"]{
 @src: ~"../src"
 @here: ~"."
}

^["sources"]{
 # Current feature sets
 @src/runtime/session/state.ts
 @src/app/components/spw-runtime-hud/spw-runtime-hud.ts

 # Related docs
 ~"../../runtime/spw/hud-runtime.spw"
 ~"../../plans/spw/patterns.spw"
}

^["rules"]{
 # Rules of thumb
 1. Only one layer owns a feature ID.
 2. Version bump on behavior change, not just implementation change.
 3. Status tag required for anything not stable.
 4. Deprecated features must list a replacement.
}

#>wonder_docs_features_spw_featureregistry_1
?["What is the felt rhythm of reading Feature Registry?"]{
  #:depth #!experiential // lens: material grain
  $%[line.operator_density, brace.nesting_rhythm] => ~#reading_feel
  ~#structure: "naming → versioning → ownership" // frame flow
  !probe{ "read aloud for 30 seconds; where do you pause? pauses mark grain boundaries." }
}

#>wonder_docs_features_spw_featureregistry_2
?["What concept is conspicuously absent from Feature Registry?"]{
  #:depth #!computational // lens: formal structure
  ~#present: [#educational, #mathematical]
  ~#expected_but_missing: "?" // the reader fills this gap
  !probe{ "list what IS annotated; list what sibling files annotate; the difference is this file's blind spot or intentional boundary." }
  $%[register.bank_size, register.active_bindings]
  ~<docs/features/spw/feature-coherence.spw>  // nearest neighbor
}
