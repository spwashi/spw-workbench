# Onboarding Flow Reference
#
# Progressive disclosure mapped to lens-walk prompts.

#:layer #!pragmatics

^["roots"]{
 @docs: ~"."
 @src: ~"../src"
}

^["purpose"]{
 ~#goal: "Connect onboarding disclosure to the lens-walk guide"
 ~#source: @src/features/onboarding/
}

^["flow"]{
 step-1: "Pick a seed or sample input"
 step-2: "Syntactic views: tokens and AST"
 step-3: "Semantic views: flow and relations"
 step-4: "Pragmatic views: runtime and steps"
 step-5: "Reframe and log"
}

^["levels"]{
 beginner: [editor-input, parse-button, sample-selector, ast-view, token-view, steps-view, basic-keyboard]
 intermediate: [all-operators, modifiers, containers, keyboard-shortcuts, flow-view, detail-drawer, selection-sync]
 advanced: [transform-mode, flow-diagram, repl, themes, coverage-metrics, timing-metrics, inspector-tabs]
 expert: [hmr, custom-themes, cli, source-maps, alchemy-loops, instrumentation, debug-mode]
}

^["events"]{
 onboarding.level-change
 onboarding.hint-shown
 onboarding.tour-started
 onboarding.progress-update
}

^["integration"]{
 @docs/lens-walk.spw
 ~"../../theory/spw/phasor.spw"
 @src/features/onboarding/types.ts
 @src/features/onboarding/disclosure.ts
 @src/features/onboarding/features.ts
 @src/features/onboarding/hints.ts
 @src/features/onboarding/persistence.ts
}

^["surface"]{
 ~#intent: "Lens-walk controls are a reusable footer slot, not a permanent fixture."
 ~#purpose: "Reserve space for novel onboarding, experiment dashboards, or release showcases."
 ~#toggle: "UI can hide this surface via layout.showTourControls (settings)."
 ~#location: "Footer bar (spw-app-tour-controls) near the prompt/intent rail."
}

^["tour-outline"]{
 ~#tour: "Lens Walk Starter"
 ~#step-1: "Parse a sample and view tokens"
 ~#step-2: "Switch to AST view and note nesting"
 ~#step-3: "Open flow view and identify edges"
 ~#step-4: "Step runtime or inspect errors"
 ~#step-5: "Write a one paragraph reframe"
}

#>wonder_docs_features_spw_onboardingflow_1
?["How would an ecology portfolio express spw/onboarding-flow?"]{
  #:depth #!stylistic // lens: ecological zone
  ~#translation_target: "ecology"
  ~#source_concept: "roots"
  !probe{ "rewrite the root frame in ecology vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[runtime.stage, runtime.queue_depth]
}

#>wonder_docs_features_spw_onboardingflow_2
?["How does this file's voice differ from phasor?"]{
  #:depth #!educational // lens: molecular binding
  ~<../../theory/spw/phasor.spw> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]../../theory/spw/phasor.spw
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}
