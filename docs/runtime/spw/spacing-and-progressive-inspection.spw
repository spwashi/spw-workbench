# Spacing and progressive inspection

#:layer #!pragmatics
#:status #!observational
#:dialect Spw.b

^["roots"]{
 @implementation: ~"../../../packages/spw-cli/src/inspect-spacing.ts"
 @source_inspection: ~"../../../packages/spw-cli/src/inspect-source.ts"
 @lexer: ~"../../../packages/spw-seed/src/lexer/gaps.ts"
 @products: ~"../../../packages/spw-seed/src/parser/products.ts"
 @progressive_ir: ~"../../../packages/spw-seed/src/ir/progressive.ts"
 @reader_note: ~"../md/spacing-and-progressive-inspection.md"
 @cli_law: ~"./cli-command-surface.spw"
}

^["reader-legend"]{
 tight: "two forms touch"
 open: "same-line space or comment material"
 cadence: "one line boundary"
 episode: "blank-line boundary"
 ~#law: "the exact surface and span travel with the compact class"
}

^["recognizable-context"]{
 source: `a.b.c`
 segments: #[a ; b ; c]
 neighbor: `a . b . c`
 ~#difference: "tight dotted identifier versus explicit dot operators with open gaps"
 ~#caution: "segmentation is lexical evidence, not a category, path, or filename claim by itself"
}

^["progressive-output"]{
 table: `spw inspect spacing file.spw`
 card: `spw inspect spacing file.spw --spw`
 envelope: `spw inspect spacing file.spw --json`
 ~#claim: "one source-linked product can disclose itself at human, Spw-card, or agent interchange depth"
 ~#status: #observational
}

^["source-products"]{
 protocol: `spw.progressive-product/1`
 depths: #[tokens ; structure ; trace]
 commands: #[
  `spw inspect source file.spw --product tokens`
  `spw inspect source file.spw --product structure --spw`
  `spw inspect source file.spw --product trace --ndjson`
 ]
 ~#law: "tokens stops after lex; structure reuses that lex pass; trace widens disclosure over the same parse"
 ~#receipt: #[product ; revision ; ir ; sequence ; stage ; status ; completeness ; included ; omitted ; deferred ; elapsed_ms]
 ~#future: #[index ; semantic ; incremental_parse ; generator_suppression]
}

^["cost-receipt"]{
 parse_policy: #[none ; diagnostics ; trace]
 runtime_policy: #[none ; stages ; evaluation]
 measure: #[generated ; retained]
 ~#limit: "parse policies currently change retention, not generator construction cost"
}

^["compatibility"]{
 unchanged: #[`a.b.c` ; `a . b` ; runtime_value ; register_semantics]
 clarified: #[`a.` ; `a..b`]
 migration_law: "crossing a gap class is not ordinary formatting"
}

?["Can Spw remain flexible between human and machine language without becoming vague?"]{
 !probe{ "preserve raw source, publish compact classes, and compare AST/runtime invariants across disclosure policies" }
 ~#metaphor: "cartilage carries load while allowing movement"
 ~#refusal: "a metaphor does not become semantics without an inspectable rule and counterexample"
}
