# Runtime Foundation (v0.2.0-alpha)
#
# Release-day bridge from parse output to runtime state.
# @spw:contract:canonical[system=runtime-docs,basis=release-baseline]

#:layer #!semantics

^"intent"{
 goal: "Establish a deterministic runtime baseline while full VM semantics remain in-progress",
 posture: ["incremental", "testable", "portable"],
 release_day: "Ship runtime scaffolding + clear extension seams",
}

^"contract"{
 binding: "This document is the deterministic release-day runtime baseline."
 canonical_phases: ["lex", "parse", "semantic", "optimize", "pragmatic"]
 aliases: "Historical shorthands sem/opt/prag may still parse, but they are not the canonical doc vocabulary."
 falsify: "If this file and src/runtime/state/types.ts disagree, prefer the runtime types and treat other notes as stale."
}

^"source_files"{
 ~<runtime>"../../src/runtime/index.ts"
 ~<state>"../../src/runtime/state/types.ts"
 ~<registers>"../../src/runtime/state/register-bank.ts"
 ~<interpreter>"../../src/runtime/interpreter/interpreter.ts"
 ~<pipeline>"../../src/runtime/pipeline/run-spw.ts"
}

^"flow"{
 lex: "src/seed tokenizes source into the surface stream used by the parser",
 parse: "runSpw() builds deterministic structure from the token stream",
 semantic: "the interpreter normalizes AST output to ONF and records semantic-ready structure",
 optimize: "release-day optimization stays shallow: resonance indexes and cheap reuse hints only",
 pragmatic: "evaluate ONF into RuntimeValue, register deltas, runtime trace, and reported snapshot",
}

^"resonance"{
 operator: "#",
 role: "aggregation/intersection + lens-indexed cache targeting",
 behavior: [
 "single operand: direct resonate write",
 "array operands: strict intersection reduction",
 "record operands: key intersection with equal-value guard"
 ],
 cache_lens: "resonate(name, value, lens) updates lens index for cache optimizers",
}

^"naming"{
 policy: "kebab-case runtime filenames",
 checker: "scripts/analyzers/runtime-filename-check.ts",
 note: "__tests__ and README.md are explicit exceptions",
}

^"release_deferred"{
 deferred: [
 "bytecode/VM execution",
 "UI keyboard binding integration",
 "multi-surface runtime persistence",
 "ambiguity branch tracing",
 "permissive unmatched-brace prompting",
 "natural-language branch previews"
 ]
}

#>wonder_docs_runtime_spw_runtimefoundation_1
?["What is the algebraic closure of source_files (spw/runtime-foundation)?"]{
  #:depth #!computational // lens: formal structure
  $^["intent"]@biome => %[formula.measure]
  ~<docs/runtime/spw/runtime-foundation.spw> // introspect
  !probe{ "measure: how many distinct concepts does this frame bind? what is the ratio of structural operators to content — and what does that density reveal?" }
  $%[register.bank_size, register.active_bindings]
}

#>wonder_docs_runtime_spw_runtimefoundation_2
?["What is the felt rhythm of reading Runtime Foundation (v0.2.0-alpha)?"]{
  #:depth #!mathematical // lens: material grain
  $%[line.operator_density, brace.nesting_rhythm] => ~#reading_feel
  ~#structure: "intent → source_files → flow" // frame flow
  !probe{ "read aloud for 30 seconds; where do you pause? pauses mark grain boundaries." }
  ~<docs/runtime/spw/agent-loop.spw>  // nearest neighbor
}
