# Learn index — progressive disclosure for humans and agents
#
# Machine-readable routing for docs/learn/

#:layer #!pragmatics
#:status #!active

^["roots"]{
 @here: ~"."
 @docs: ~".."
 @examples: ~"../examples"
 @runtime: ~"../runtime/md"
 @theory: ~"../theory/spw"
}

^["intent"]{
 ~#goal: "One learnability spine: path, cheat sheet, worked CLI, agent brief, examples"
 ~#taste: "runnable beats readable; measure before mutate"
}

^["spine"]{
 hub: ~"./README.md"
 path: ~"./path.md"
 cheat: ~"./cheat-sheet.md"
 worked: ~"./worked-cli.md"
 agent: ~"./agent-brief.md"
 quest: ~"./quest.spw"
}

^["timeboxes"]{
 t15: #[ ~"./path.md", ~"./cheat-sheet.md", ~"../lang/md/few-shot.spw.md" ]
 t60: #[ ~"./worked-cli.md", ~"../runtime/md/sense-loop.md", ~"../examples/spw/form-sequence.spw" ]
 t1d: #[ ~"../theory/spw/form-ladders.spw", ~"../runtime/md/lsp-editor-integration.md", ~"../runtime/md/runtime-memory.md" ]
}

^["examples"]{
 form_sequence: ~"../examples/spw/form-sequence.spw"
 template_holes: ~"../examples/spw/template-holes.spw"
 sense_loop: ~"../examples/spw/sense-loop.spw"
 spirit_cycle: ~"../examples/spw/spirit-cycle.spw"
 few_shot: ~"../lang/md/few-shot.spw.md"
}

^["tooling"]{
 sense: ~"../runtime/md/sense-loop.md"
 pulse: ~"../runtime/md/pulse-mutate-beat.md"
 memory: ~"../runtime/md/runtime-memory.md"
 lsp: ~"../runtime/md/lsp-editor-integration.md"
 emit: ~"../runtime/md/spw-emit.md"
 quick: ~"../runtime/md/quick-start.md"
}

^["theory"]{
 ladders: ~"../theory/spw/form-ladders.spw"
 math: ~"../theory/spw/math-modeling.spw"
 topo: ~"../theory/spw/relationship-topography.spw"
 fields: ~"../theory/spw/field-dynamics.spw"
 floor: ~"../theory/spw/exhibit-floor.spw"
}

^["learners"]{
 // Who this spine serves, read from docs/theory/spw/exhibit-floor.spw ^["learners"].
 adults: "Most newcomers are adults with a project (andragogy): start from their problem, use what they already know, let them steer, and say why before how."
 first_visit: "A first visit answers a touch before it names a mark: run one line, change one slot, watch the reading move, then read the name."
 friend_test: "A doorway is ready when a friend can build something with it in an afternoon from the page alone (journal 2026-11-08 extension sockets)."
 civic: "A lesson written as a line can be carried to a library workshop, a classroom or a museum floor; which civic hosts could carry the quest is an open question."
}

^["law"]{
 measure_first: "effect.l0.measure before l1/l2"
 expand_not_mutate: "template expand fills holes; mutate is creative axis"
 docs_must_run: "named commands are runnable via npm run spw --"
 thin_client: "editors call LSP; corpus tooling is CLI"
}
