# Shadow DOM Policy :: Spw

#:layer #!grammar

^["intent"]{
  summary: "Clarify when to use Shadow DOM vs Light DOM for cohesion + theming.",
  goal: "Predictable layout, explicit theming hooks, stable component contracts."
}

^["reference"]{
  file: "./shadow-dom-policy.md",
  note: "Canonical policy document (short, readable).",
  action: "Link from README when ready."
}

^["practice"]{
  rule: "Layout + spatial interaction => Light DOM. Widgets + skin => Shadow DOM.",
  hooks: ["data-spw-component", "parts", "exportparts", "tokens"],
  events: "Always composed + bubbling for cross-boundary coordination."
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
