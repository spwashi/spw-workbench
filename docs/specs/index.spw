# Specifications Index
#
# Normative contracts, strict policies, and formal alignment.

#:layer #!grammar

^["roots"]{
  @here: ~"."
}

^["contracts"]{
  !["Binding Contracts"]
  .. ~<contract>"./md/classname-contract.md"         # CSS classname contract
  .. ~<contract>"./md/ui-state-contract.md"          # UI state surface contract
  .. ~<policy>"./md/shadow-dom-policy.md"            # Shadow DOM policy (markdown rail)
  .. ~<policy>"./spw/shadow-dom-policy.spw"           # Shadow DOM policy (spw index)
}

^["alignment"]{
  !["Alignment & Normalization"]
  .. ~<spec>"./spw/spec-alignment.spw"                # Gap analysis vs spec
  .. ~<spec>"./spw/reference-conventions.spw"         # Reference conventions
  .. ~<spec>"./spw/data-attribute-normalization.spw"   # Perspective/LoD attributes
  .. ~<summary>"./md/formalization-phase-1-summary.md" # Phase 1 formalization summary
}

^["validation"]{
  !["Validation"]
  .. ~<audit>"./md/audit-classnames.md"              # Classname validation audit
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
