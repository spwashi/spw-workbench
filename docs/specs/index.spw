# Specifications Index
#
# Normative contracts, strict policies, and formal alignment.

#:layer #!grammar

^["roots"]{
 @here: ~"."
}

^["contracts"]{
 !["Binding Contracts"]
 .. ~<contract>"./md/classname-contract.md" # CSS classname contract
 .. ~<contract>"./md/ui-state-contract.md" # UI state surface contract
 .. ~<policy>"./md/shadow-dom-policy.md" # Shadow DOM policy (markdown rail)
 .. ~<policy>"./spw/shadow-dom-policy.spw" # Shadow DOM policy (spw index)
}

^["alignment"]{
 !["Alignment & Normalization"]
 .. ~<spec>"./spw/spec-alignment.spw" # Gap analysis vs spec
 .. ~<spec>"./spw/reference-conventions.spw" # Reference conventions
 .. ~<spec>"./spw/data-attribute-normalization.spw" # Perspective/LoD attributes
 .. ~<summary>"./md/formalization-phase-1-summary.md" # Phase 1 formalization summary
}

^["validation"]{
 !["Validation"]
 .. ~<audit>"./md/audit-classnames.md" # Classname validation audit
}

#>wonder_docs_specs_index_1
?["How would a biology portfolio express specs/index?"]{
  #:depth #!stylistic ~#lens(living system)
  ~#translation_target: "biology"
  ~#source_concept: "roots"
  !probe{ "rewrite the root frame in biology vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[spec.rule_count, spec.conformance_coverage]
}

#>wonder_docs_specs_index_2
?["How does this file's voice differ from specs/index (specs/index)?"]{
  #:depth #!educational // lens: curated collection
  ~<@here> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]@here
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}
