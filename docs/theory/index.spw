# Theory Index
#
# Foundations of the Spw worldview: Algebra, Physics, and Calculus.
# @spw:contract:bridge[system=theory-runtime,basis=waveform-to-runtime-fields]

#>theory
#:layer #!semantics

^["roots"]{
 @here: ~"."
 @stack: ~"./spw/syntax-profile-stack.spw"
 @ref_deref: ~"./spw/reference-deref-geometry.spw"
 @brace_charge: ~"./spw/brace-charge-crawl.spw"
 @fixity: ~"./spw/fixity-brace-phrases.spw"
 @operational_field: ~"./spw/operational-field.spw"
 @flow: ~"./spw/mutation-flow-automata.spw"
 @biome: ~"../../.spw/biome/index.spw"
}

^["models"]{
 !["Core Models"] #:foundation
 .. ~<algebra>"./md/lens-algebra.md" # Lens composition algebra
 .. ~<physics>"./md/operational-physics.md" # Operational physics of Spw
 .. ~<algebra>"./md/operator-algebra.md" # Operator algebra formalization
 .. ~<calculus>"./md/probe-calculus.md" # Probe calculus
}

^["spw-models"]{
 !["Spw Specifics"] #:lang
 .. ~<atlas>"./spw/operator-atlas.spw" // Symbol weight atlas
 .. ~<operators>"./spw/operators.spw" // Canonical operator map
 .. ~<coupling>"./spw/coupling-constructors.spw" // Shared boundary/coupling algebra and parser reality
 .. ~<op_brace>"./spw/operator-brace-composition.spw" // Layered operator and paired-boundary composition
 .. ~<topography>"./spw/operational-topography.spw" // Measurable source, layout, orientation, hydration, and evidence contract
 .. ~<devices>"./spw/operational-devices.spw" // Status-tagged differentials, boundary profiles, and wonder-plan candidates
 .. ~<axes>"./spw/dimensional-axes.spw" // Abstract axes, salience kernels, literacy/hold formulas F1–F8
 .. ~<math_model>"./spw/math-modeling.spw" // Testable graphs, loops, equations + hardware plan pointer
 .. ~<field>"./spw/field-dynamics.spw" // Abstract multi-locus fields, carriers, cascades, production ensembles
 .. ~<rel_topo>"./spw/relationship-topography.spw" // Cross-domain relations + corpus map / familiarity
 .. ~<mutation>"./spw/mutation-automata.spw" // Configurable mutation automata, pulse CLI, topography probes
 .. ~<mutation_flow>"./spw/mutation-flow-automata.spw" // Glyph-first mutation-as-flow / cellular diff CA (proposed)
 .. ~<syntax_stack>"./spw/syntax-profile-stack.spw" // Multi-axis dialect × review × format profile stack
 .. ~<range_xform>"./spw/range-transform.spw" // Range address + line/span transforms (indent) — proposed syntax
 .. ~<ot>"./spw/operational-transform.spw" // OT rebase, fold, mutation matrix, operational sequences
 .. ~<form_ladders>"./spw/form-ladders.spw" // Revisioned paired-boundary/operator contours
 .. ~<form_contours>"./spw/form-contours.spw" // Honest reduction, expansion, evidence, and density receipts
 .. ~<form_geometry>"./spw/form-geometry.spw" // Label mobility, liminal shapes, HOF compositional programs
 .. ~<ref_deref>"./spw/reference-deref-geometry.spw" // Ref↔deref dual, dialect fit, dimensional address lift
 .. ~<brace_charge>"./spw/brace-charge-crawl.spw" // Capture/shield, portable charge, crawl verbs, channels
 .. ~<operational_field>"./spw/operational-field.spw" // Field coordinates, clocks, measure landmarks, modes, stances
 .. ~<fixity_phrase>"./spw/fixity-brace-phrases.spw" // Fixity, brace phrases, emergent optimizable grammar
 .. ~<flow_protocol>"./spw/flow-protocol-sigils.spw" // Sigil x brace x adjacency protocol modules
 .. ~<measure_kernel>"./spw/measure-context-kernel.spw" // Generalize mass: scopes, planes, Spw-defined algorithms
 .. ~<swap_grace>"./spw/swap-grace.spw" // Cursor model, alternate forms, and grace-safe swap law
 .. ~<ladders>"./spw/operator-ladders.spw" // Operator plug-ins into form ladders (secondary)
 .. ~<onf>"./spw/onf.spw" // Operator Normal Form
 .. ~<register_geo>"./spw/register-geometry.spw" // Register geometry axes
 .. ~<phasor>"./spw/phasor.spw" // Layer rotation model
 .. ~<quality>"./spw/quality.spw" // BBBH quality annotations
 .. ~<physics>"./spw/semantics-physics.spw" // Semantic physics
 .. ~<valence>"./spw/valence-architecture.spw" // Valence architecture
 .. ~<bridge>"../../lib/spw-v0.3.0/architecture/theory-bridge.spw" // Current bridge; v0.2.0-alpha remains archival
}

^["acoustic_theory"]{
 # The composable physics model extends operator semantics
 # into measurable runtime behavior.
 // Waveform language is explanatory; the release-day runtime only binds
 // liminality, frequency, coupling, and measureDepth directly.
 #:physics #!model

 =principle: "waveform language explains the runtime fields; only named runtime fields are binding today"
 =binding_fields: ["liminality", "frequency", "coupling", "measureDepth"]
 =derived_terms: "amplitude and phase remain explanatory metaphors until explicit runtime fields are added"

 liminality: {
 =definition: "scope-awareness of a memory cell (local → liminal → visible → global)"
 =metaphor: "how far sound carries — local whisper vs. global broadcast"
 policy: "the ordered states are binding; specific promotion/demotion heuristics remain implementation-defined"
 }

 frequency: {
 =definition: "writes per second over a sliding window"
 =metaphor: "how fast a string vibrates — hot cells resonate quickly"
 =window: 10 # circular buffer depth
 =unit: "Hz (writes/sec)"
 }

 coupling: {
 =definition: "normalized count of bidirectional edges to other cells"
 =metaphor: "entanglement — coupled cells co-evolve when either changes"
 =range: "0.0 .. 1.0 (edges / (total_cells - 1))"
 }

 %[measure]{
 =definition: "observation depth — how many times measure() has been called"
 =metaphor: "quantum measurement — observing a cell changes its state"
 =philosophy: "the observer effect: measurement itself is a physical act"
 }

 quality_bridge: {
 =runtime_axis: "runtime quality uses the four-state BBBH quartet: boon, bane, bone, honk"
 =valence_note: "bonk remains a valence-only catalyst and is not part of the base runtime quality axis"
 }
}

^["annotation_system"]{
 // Hash annotations are Spw's metadata layer.
 // They thread through documents like resonant labels.
 #:meta #!annotation

 #topic { read: "plain topic label", outline: "Key" }
 #:lens { read: "categorization / phase", outline: "Enum" }
 #!intent { read: "purpose / action", outline: "Event" }
 #>anchor { read: "jump target / bookmark", outline: "Interface" }

 %[philosophy]{
 "annotations are not comments — they carry computational weight",
 "the outline provider recognizes them as navigable symbols",
 "semantic tokens color them distinctly from # comments",
 "they bridge human intent and machine interpretation",
 }
}

^["lib-scaffolds"]{
 !["v0.2.0 library navigable surfaces"] #:lib
 .. ~<dialects>"../../lib/spw-v0.2.0-alpha/dialects/index.spw"
 .. ~<domains>"../../lib/spw-v0.2.0-alpha/domains/index.spw"
 .. ~<applications>"../../lib/spw-v0.2.0-alpha/applications/index.spw"
 .. ~<architecture>"../../lib/spw-v0.2.0-alpha/architecture/index.spw"
}

#>wonder_docs_theory_index_1
?["What ripples if #foundation changes in this file?"]{
  #:depth #!mathematical // lens: molecular binding
  $#foundation@workspace => %[reference.count, depth.downstream]
  ~#downstream: "trace all files that reference this surface"
  !probe{ "imagine renaming #foundation to #foundation_v2; count broken references; the count reveals how deeply roots is woven into the workspace." }
  $%[register.bank_size, register.active_bindings]
}

#>wonder_docs_theory_index_2
?["What happens when you zoom from the concept level to the workspace level in Theory Index?"]{
  #:depth #!stylistic // lens: ecological zone
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "roots" // this file's atom
  !probe{ "the atom is concept-scale; zoom out: what workspace-level pattern does this concept participate in?" }
  $%[register.bank_size, register.active_bindings]
  ~<"docs/index.spw"> ~#neighbor(nearest)
}
