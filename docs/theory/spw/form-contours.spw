#>form_contours
// Form Contours
#
// Honest density controls for editor, LSP, CLI, and agent projections.
#
// @see packages/spw-seed/src/canonical/form-contours.ts
// @see docs/theory/spw/form-ladders.spw
// @see docs/theory/spw/operational-topography.spw

#:layer #!semantics

^seed[Spw.Form.Contours v:0.1 @profile:research @intent:expressive_density_with_receipts]

^["contour"]{
 definition: `An ordered view of catalog points with stable indices, roles, axes, parser evidence, and separate catalog/evidence/view signatures.`
 separates: .{
  interpretation: #[role, axes, implied_reading]
  observation: #[parse_health, expectation, expectation_met, prose_fallback]
 }
 dimensions: #[visible_point_count, catalog_point_count, role_variety, structured_evidence_count, conceptual_slot_count, failed_expectation_count, axis_coverage, undeclared_axes]
 update_cycle: `Catalog signature includes the profile revision; evidence signature changes when parser observations change; view signature binds both to visible indices.`
 model_cycle: `A more capable agent may select or explain a different contour, but it must retain the producer, profile revision, evidence signature, and omissions instead of rewriting prior observations as though they had always been known.`
}

^["reduction"]{
 operation: `Select a lower-density view under a named policy.`
 policies: .{
  endpoints: `retain first and last catalog points`
  evidence: `retain endpoints, structured observations, and failed expectations`
  axes: `retain endpoints and the first visible anchor for each declared axis`
  balanced: `retain an evenly spaced point budget`
 }
 receipt: #[input_signature, output_signature, omitted_points, omitted_roles, omitted_axes, omitted_structured_evidence]
 law: `A non-identity reduction is a lossy projection and claims no semantic equivalence.`
}

^["expansion"]{
 operation: `Reveal a radius around retained anchors or restore the exact input contour.`
 source: `Expansion reads the reduction receipt; it does not infer omitted surfaces.`
 exactness: `full=true restores the input view signature exactly.`
 progressive_disclosure: `radius expansion supports hover, outline, and agent-context density without changing source.`
}

^["utility"]{
 editor: `render compact outlines with explicit omitted counts and expand-on-demand`
 lsp: `return one portable contour contract to multiple thin clients`
 agent: `budget context while preserving counterevidence and restoration paths`
 teaching: `compare syntactic forms at several densities without teaching a metaphor as grammar`
 research: `record which density aided navigation, recall, edit accuracy, or explanation under a revisioned profile`
}

^["falsify"]{
 #[
  "full restoration does not recover the input view signature",
  "axis coverage is reported without its declared denominator",
  "conceptual slots are counted as structured evidence",
  "expansion guesses a missing surface not retained by the receipt",
  "reduction mutates source"
 ]
}
