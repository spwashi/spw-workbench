# Threshold and Distance
#
# Distance as a design dimension: how many acts separate a reader from a thing, and what a thing is while it crosses an edge.
# From the owner's wonders of 2026-11-09: distance into caches or indices as a way to show thresholds of liminality or ephemerality,
# and the distance to reach a concept or recognize a pattern through the tree, references and comprehension.
# Read beside two interactive hosts and two mounted consumers, and through four lenses: design, synesthesia, engineering runtime, academic.
#
# @see docs/theory/spw/cache-field.spw
# @see docs/theory/spw/exhibit-floor.spw
# @see docs/theory/spw/representational-disclosure.spw
# @see .spw/caches/journal/2026-11-09-distance.spw

#>threshold_distance
#:layer #!semantics
#:status #!seeded

^["contract"]{
 exploratory: "A theory notebook of readings, not runtime or parser law; a claim here binds only once a runtime or parser contract repeats it."
 measured: "Every number comes from the journal entry of 2026-11-09 and is a count on that day, not a constant."
 trials: "Readings that would change what a mark or a field means are held as trial cards in interpretation-trials before any plan acts on them."
 hosts: "Consumers are named by role. What a consumer's canon says is quoted briefly and stays that consumer's."
}

^["roots"]{
 @journal: ~"../../../.spw/caches/journal/2026-11-09-distance.spw"
 @cache_field: ~"./cache-field.spw"
 @floor: ~"./exhibit-floor.spw"
 @disclosure: ~"./representational-disclosure.spw"
 @form_geometry: ~"./form-geometry.spw"
 @ladders: ~"./form-ladders.spw"
 @bridge: ~"../../../packages/spw-runtime/src/state/liminality-bridge.ts"
 @policy: ~"../../../packages/spw-runtime/src/state/memory-policy.ts"
 @trials: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw"
 @receipts: ~"../../../.agents/plans/host-receipts/wip.spw"
}

^["thesis"]{
 ~#claim: "Distance is the number of acts between a reader and a thing: doors opened, lines scrolled, marks learned, beats waited. Each act has a different cost and a different tool."
 ~#claim: "A threshold is where a distance changes kind: the last hop the index reaches, the last beat a cache holds, the first mark a reader does not know."
 ~#claim: "Liminal names a thing at an edge, and an edge has two sides. A surface the index does not reach is arriving or leaving, and distance alone cannot say which."
 ~#law: "A distance is shown only if something can be done about it: followed, scrolled, learned or waited out."
 ~#claim: "Ephemeral is a design, not a decay: the floor returns to rest, a touch answers once, and the visitor keeps one line. What is kept is far from the host and near to the reader."
 ~#refuse: #[
  "depth as a mark of doubt: a far surface may be old and settled",
  "one ladder for every threshold: the ladders below measure different things and cross in few declared places",
  "a fade that hides what a reader still needs: ephemeral means it can be let go, not that it is gone",
 ]
}

^["distances"]{
 # Five distances, each with its unit, what crosses it, and what was counted. Corpora are this repo's caches tree and plans, the site consumer, and a second mounted consumer.
 reach: .{ unit: "reference hops from the canon root", crossed_by: "following", counted: "here 1,122 of 1,276 surfaces are reached, the living tree at 3.4 hops and the dated journal at 4.7; the site consumer reaches 877 of 946 within 4 hops" }
 address: .{ unit: "lines back to the nearest #> anchor", crossed_by: "scrolling", counted: "a median of 6 lines in the caches tree; 54 to 71 lines in plans and in both consumers" }
 depth: .{ unit: "containers enclosing a token", crossed_by: "opening", counted: "a median of 1 or 2 and a ninth decile of 2 or 3 in every corpus; the deepest token sits 7 down" }
 vocabulary: .{ unit: "marks a reader must know before a line reads", crossed_by: "learning", counted: "six marks read 80 to 85% of lines in all four corpora; 9 to 16 marks read 95%; which six differs by host" }
 time: .{ unit: "beats, visits or days since a thing was last held", crossed_by: "waiting or holding", counted: "hot, warm and cold at 8, 64 and 256 beats in the runtime; unreached surfaces last touched 3 days ago in the site consumer and 77 days ago here" }
 reading: "Spw is shallow and wide: nearly everything is within three containers, and most of the way to a thing is sideways, through references. Depth is cheap; reach and address are where a reader gets lost; vocabulary is the only distance no tool can shorten."
}

^["ladders"]{
 # Thresholds already named in code and canon. They are different axes; a crossing between two is law only where a module declares it.
 runtime_liminality: .{ rungs: "local, liminal, visible, global", measures: "how widely a register cell is held", where: "the register bank; promote and demote step it" }
 surface_waypoints: .{ rungs: "exterior, void, chamber, hole, aperture, membrane, published", measures: "where a form sits in source", where: "seed form geometry" }
 retention: .{ rungs: "hot, warm, cold", measures: "beats since a product was used", where: "the hot session cache; cache-field planes" }
 eviction: .{ rungs: "a score, not rungs", measures: "local, cold, seldom used, loosely coupled, shallow in measure", where: "the memory policy" }
 consumer_liminality: .{ rungs: "entry, threshold, settled, nested, projected, deep", measures: "how far a page element has materialized", where: "the site consumer's conventions; 389 of 659 elements counted there sit at entry" }
 consumer_fixity: .{ rungs: "fixed, stable, tending, experimental, volatile, cold", measures: "how settled a surface is declared to be", where: "the site consumer's graph and cache headers" }
 host_memory: .{ rungs: "this visit, this browser, a file", measures: "where a canvas line is kept", where: "factshift.center's stores" }
 reveal: .{ rungs: "its spell always, its meaning once stood on, its use once a loop is walked", measures: "what a reader has earned", where: "a second mounted consumer's projection disk and lanes" }
 discovery: .{ rungs: "veiled, glimpsed, found", measures: "whether a reader has met a wonder", where: "the same consumer's almanac" }
 declared_crossing: "The liminality bridge declares one fixed point, surface published equals runtime global, and calls every other likeness a coincidence. That caution extends here: these nine ladders rhyme, and none is the other."
 rhyme: "Each ladder has an entry rung, a held middle and a far rung that is either canon or cold. The middle is where a thing is liminal, and the far rung is where the two edges part: published and global are far by being kept, cold and deep are far by being let go."
}

^["two_edges"]{
 inner: "arriving: a surface written but not yet routed; fresh, cited by nothing, likely to change"
 outer: "leaving: a surface whose route was dropped; old, perhaps still cited from history, unlikely to change"
 tells: "age since last touch, a declared fixity, inbound citations, and whether a newer surface supersedes it"
 counted: "by reach the site's fresh caches and this repo's archived plans are both unreached; by age they are 3 and 77 days old"
 design: "A reader should see which edge a thing is on. Arriving invites: hold it, route it, try it. Leaving informs: here is what replaced it."
}

^["address"]{
 # An address has five seats, and each is a distance a line travels from the reader. From a mounted consumer's reading of its own hosts, 2026-11-09.
 path: "a verb or a file, read by the server; the nearest seat to the host"
 query: "a short line or a setup, read by the server and kept in the address bar; three hosts cap it at 200, 400 and 1,800 characters"
 fragment: "a whole script the server never reads; it stays with the reader, and five implementations agree it is base64url of the text's UTF-8 bytes"
 accept: "which representation comes back for the same address: a page, plain text, a record"
 method: "whether the address asks or acts"
 as_distance: "The seats order by who holds the line: the host, the address bar, the reader alone. A fragment is the far seat by being kept, which is the ephemeral case done well: the floor forgets and the visitor leaves with the line."
 aloud: "A seat is fit to share when its address can be said aloud. A path and a named key can; a fragment of encoded text cannot, which is why the fragment carries the script and the path carries the verb."
 open_body: "A consumer proposes that a body left open at the end of a line be legal and marked. That is the inner edge written down: a line that is still arriving and says so."
}

^["centre"]{
 # An address read as an abstract thing: the place a reader stands, from which near and far are measured. The canvas host's name says it: a fact, a shift, a centre.
 fact: "the line as written. It is conserved: every edit is a splice, and every picture writes back to it."
 shift: "one change of the line (a pivot), or one change of how it is read (a stratum, an observer), with the fact held still. A wonder is a shift not yet taken."
 centre: "the line or surface a reader holds. It is an origin, not a root: everything else is near or far from it, and it moves when the reader does."
 deictic: "Languages measure this, that and yonder from where the speaker stands, and a story moves that origin into its world. An address is the same origin made writable: holding a line says here, and a relative address says from here."
 two_origins: "The canon root is a fixed origin, and hops from it say how settled a thing is. The centre is a moving origin, and hops from it say what is near the reader now. From a live plan here the rings are 7, 29, 57 and 81 surfaces; the walk costs a fraction of a millisecond."
 facilitates: .{
  anchors: "a #> anchor is a place a centre can be put: the grammar's own name for that aim was deixis"
  references: "a reference is a sight line from the centre, and its length is reach"
  relative_addresses: "from here, up one, the same thing on another material: forms a consumer proposes, each a move of the centre"
  pivots: "the lines one edit away are the centre's first ring in the space of lines, as cited surfaces are its first ring in the space of files"
  frames: "entering a frame moves the centre inside it, and its law becomes the local one"
  stills_and_shares: "a still or a share link is a centre written down: the line, how it was drawn, and where the reader stood"
  wonder: "a wonder's seat is the centre it was asked from, so a reader can stand there again"
 }
 as_a_primitive: "Nothing new is needed to have a centre. A held line, an anchor and a relative reference already are one. What is missing is a name for it that tools share, so reach, pivots and a still all measure from the same place."
}

^["layered_contexts"]{
 # A layer is a distance from the line: how many presses or how much earning stands between a reader and a grain.
 canvas: "factshift.center layers by grain and by stratum: file, frame, line, slot, part, mark as a ladder, and a body drawn as written, by its parts, or as particles. Its plans say part and mark are reachable from one row of one window, and the file from one button, so the ends of its ladder are the far ones."
 story_site: "A second mounted consumer layers by permission and by earning: eight feature layers from ground to maker, where a higher layer may lean on a lower one and never takes it away, and a reveal order that shows syntax first, meaning once stood on, use once walked."
 guide: "spw.quest layers by task: learn, build, pivot, walk, each a room with its own field, and a note kept across them."
 runtime: "The runtime layers by clock: request, beat, session, workspace, file, each with its own retention plane."
 one_reading: "The four are the same move with different currencies: presses, progress, rooms, beats. A context is layered well when each layer costs one act to enter, says what it will show, and leaves the layer below as it was."
 imagination: "A canvas that knows distance can draw it. Its own notes say the physics are constants and not a line, that nothing a visitor does is kept as a story, and that the world is no larger than the stage. Reach gives the stage an outside: what is one hop from the held line sits at the rim, what is three hops away is fog, and what is leaving is drawn as leaving. The story site already draws rings this way, by a hyperbolic distance, and prunes the deepest first."
}

^["hosts"]{
 # factshift.center and the story site, by what each does with one line. Neither is a draft of the other.
 direction: .{ canvas: "turns a line into motion and gives the text back when a body is folded", story: "turns a line into a place with a rule for staying" }
 clock: .{ canvas: "seconds: heat is gone in about two, and a fold lasts the visit", story: "weeks: a chapter, a kept wonder, a brace-box that goes cold in a week unless held" }
 law: .{ canvas: "the mark before a body is a force only that body feels", story: "the mark and the container are a rule: look in, stand a minute, arrive together, go through and never stay" }
 reveal: .{ canvas: "everything arrives open, and a reader folds by hand", story: "everything arrives as its spell, and meaning is earned" }
 wonder: .{ canvas: "a question's body refuses the fold", story: "a wonder is veiled until met, closes when kept or answered, and one is never answered" }
 writing: .{ canvas: "Spw is the material: about twenty verbs rewrite the held line through one hub", story: "Spw is the receipt: a cast, an outcome and a projection are written out as spells a reader can copy or paste back" }
 senses: .{ canvas: "motion first; one sound and a short vibration", story: "sound first: a mark picks a voice, a container picks a timing, a room picks a chord" }
 readers: .{ canvas: "one line reader, shared with seed", story: "a vendored seed bundle beside more than a dozen hand-written readers, several by regular expression" }
 lend: "The story site could lend the canvas an order of reveal, a sense of sound and a memory longer than a visit. The canvas could lend the story site one hub for every rewrite and a way to show a spell by its parts. Both want what neither has: a line that says how far away it is."
}

^["synesthesia"]{
 # Marks and containers already map to other senses on every host. A mapping is a reading when it keeps the structure, and decoration when it does not.
 containers: .{ slot: "mode, body, scene, concept (seed)", timing: "in sequence, held, as a chord, gliding (the story site's sound)", stay: "look in, stand a minute, arrive together, go through (its rooms)", material: "a body is a well, and a folded one a card (the canvas)", speech: "mode care, body: seed, water (the site's spoken twin)" }
 marks: .{ voice: "? a rising fourth left open, ~ a slow pad, * a bell, # a glass ping, % ticks (the story site)", force: "~ drifts, = holds, ^ lifts, . rests, ? opens from the middle (the canvas)", type: "points take weight, threads tracking, events slant, quantities tabular figures (the site)", balloon: "~ thought, ? question, ! burst, . statement (spw.quest)" }
 test: "A mapping keeps the structure when what nests in the line nests in the sense, what pairs still closes, and what is ordered stays ordered. Held and chord for { } and ( ) pass: a body holds its parts over time, and a scene's parts arrive together. A colour per mark passes only if nothing else is using colour to mean something."
 distance_in_each: .{ sight: "size, blur and place on a ring", sound: "volume, reverberation and how late a voice enters", motion: "how slowly a far thing answers", touch: "how long a press must be held", speech: "how many words before the name" }
 open_question: "A question left open is the one mark every host renders the same way across senses: an interval that does not resolve, a body that will not fold, a veil. That agreement is evidence the reading is in the mark and not in the host."
}

^["runtime"]{
 # What exists, what is missing, and what would be one product.
 exists: #[
  "a liminality rank on every register cell, stepped by promote and demote",
  "an eviction score that already prefers the local, the cold, the seldom used and the loosely coupled",
  "three retention tiers with beat clocks, and five named retention planes",
  "a corpus product with population rows, links and topography, memoized by fingerprint",
  "spw graph --spread near, standard, far: distance words already select how much corpus work to do",
 ]
 missing: #[
  "reach: no verb reports hops from a root, so an unreached surface is found only by a script",
  "address: no verb reports how far a line is from an anchor, so nobody sees that a citation lands on a file",
  "edge: nothing says whether an unreached surface is arriving or leaving",
  "fixity is declared on 3 of 1,276 surfaces here, so distance is the only signal",
 ]
 one_product: "A reach product beside the corpus product: per surface, its hops from each declared root, its anchors and the median lines between them, its marks ranked against the corpus, its last touch, and which edge it is on. Census sorts by it, graph draws by it, an editor dims by it, and a host can place by it."
 same_function: "The eviction score is already a distance: far, cold and uncoupled goes first. The same terms rank what an index could let go and what a canvas could fade, so one function with different weights can serve memory, an index and a stage."
 cost: "Reach is a breadth-first walk over refs the corpus product already holds. Address and vocabulary come from one lex per file. None needs a parse."
}

^["lenses"]{
 # The four passes the owner asked for, each read over the same four ideas.
 design: .{
  reach: "show how many doors a thing is behind before a reader opens the first"
  threshold: "draw an edge as an edge, with a side that invites and a side that informs"
  layer: "one act per layer, and the layer below left as it was"
  mapping: "use a sense for one meaning at a time"
 }
 synesthesia: .{
  reach: "far is quieter, smaller, slower and later, on every sense at once"
  threshold: "a crossing is felt: a change of material, a held press, an interval that resolves or does not"
  layer: "each layer has a texture a reader can name without reading"
  mapping: "what nests in the line nests in the sense"
 }
 engineering_runtime: .{
  reach: "a walk over existing refs, kept beside the corpus memo"
  threshold: "a rank and a clock on each plane, with crossings declared in one module each"
  layer: "retention planes that never share a key or a clock"
  mapping: "a host reads marks and containers from one table and one line reader"
 }
 academic: .{
  reach: "information foraging: a reader follows scent and weighs the cost of each hop against what it promises"
  threshold: "the liminal phase of a rite of passage, between separation and incorporation, and the forgetting curve for what is not rehearsed"
  layer: "levels of processing, and the visibility and hidden-dependency dimensions of a notation"
  mapping: "cross-modal correspondence and sound symbolism: pairings people make reliably without being taught"
 }
}

^["grounding"]{
 # Where each reading rests in work outside Spw. Named so a reader can check them; none is cited as proof of a claim about Spw.
 foraging: "Pirolli and Card, information foraging: scent, patches and the cost of moving between them"
 liminality: "van Gennep on rites of passage and Turner on the liminal: a phase with its own rules, not a gap"
 forgetting: "Ebbinghaus on retention over time, and spacing: what is revisited is kept"
 processing: "Craik and Lockhart, levels of processing: what is worked with more deeply is remembered longer"
 notation: "Green and Petre, cognitive dimensions of notations: visibility, hidden dependencies, viscosity, hard mental operations"
 frequency: "Zipf: a few forms carry most of the use, which is what six marks reading four lines in five looks like"
 affordance: "Gibson and Norman: what a form offers a hand before it is explained"
 cross_modal: "Spence on cross-modal correspondences; Köhler and Ramachandran and Hubbard on sound and shape"
 schema: "Johnson and Lakoff on image schemas: container, path, near and far as the body's own grammar"
 epistemic_action: "Kirsh and Maglio: some moves arrange the world in order to think, and others arrange the result; cited by a consumer's cache for the prime-then-commit rule"
 adoption: "Meyerovich and Rabkin on programming language adoption: libraries, existing code and experience outweigh intrinsic features; cited by a consumer's cache, and the reason a line kit outranks a new mark"
 process: "Reas, Process Compendium: the text is the process and the software an interpretation of it; cited by a consumer's cache for a line that outlives its picture"
}

^["falsify"]{
 reach_is_noise: "If declared fixity does not order by hops in a second corpus that declares it, the site's agreement is an accident of how its index was written."
 six_is_an_artifact: "If the six-mark share moves well away from 80% in a corpus written by newcomers, the figure describes these authors and not the notation."
 edges_do_not_part: "If readers shown an arriving and a leaving surface treat them alike, the two-edge reading adds a label and no behaviour."
 mapping_is_decoration: "If a listener cannot tell a body from a scene by sound after hearing five of each, held and chord are ornament."
 depth_matters: "If a reader's errors climb with container depth inside three levels, shallow is not the same as cheap."
}

#>wonder_docs_theory_spw_thresholddistance_1
?["Should an unreached surface say which edge it is on?"]{
 #:depth #!pragmatics ~#lens(choice)
 ~#hypothesis: "A stance on the surface (arriving, leaving) costs one particle and lets every tool stop guessing from age."
 ~#expect: "Unreached surfaces split cleanly by age in both repos: fresh in the site consumer, old here, with few in between."
 !probe{ "list the unreached surfaces in each repo with their last touch; count those between 14 and 45 days old, where age cannot tell" }
 $%[edge.declared, edge.by_age, edge.unknown]
}

#>wonder_docs_theory_spw_thresholddistance_2
?["Do the same six marks read a newcomer's first file?"]{
 #:depth #!semantics ~#lens(comparison)
 ~#hypothesis: "Six marks reading four lines in five is a property of how people write Spw, so it holds for a first file as it holds for a canon."
 ~#expect: "The share holds within ten points, and the six differ again."
 !probe{ "rank marks over the quest's seven panels and over a newcomer's saved note; report the share of lines six marks read, and which six" }
 $%[marks.for_80, marks.first_six]
}

#>wonder_docs_theory_spw_thresholddistance_3
?["Can a host place a line by its reach without a second graph?"]{
 #:depth #!computational ~#lens(projection)
 ~#hypothesis: "The corpus product's links are enough: a host that holds one line asks for the surfaces one, two and three hops from it and draws three rings."
 ~#expect: "The walk over 15,440 refs takes well under a second once the corpus memo is warm."
 !probe{ "time a breadth-first walk from one surface over the memoized links; report surfaces at one, two and three hops" }
 $%[reach.walk_ms, reach.ring_sizes]
}
