# Charge · Valence · Brace — Bridge
#
# Status-tagged map of three vocabularies that currently collide on the word
# "charge" and under-specify how brace physics relates to operational motion
# and material quality. Companion to brace-physics registry, brace-charge-crawl,
# valence-architecture, and operational-field.
#
# @see .spw/registries/brace-physics.spw
# @see docs/theory/spw/brace-charge-crawl.spw
# @see docs/theory/spw/valence-architecture.spw
# @see docs/theory/spw/operational-field.spw
# @see docs/theory/spw/representational-disclosure.spw
# @see packages/spw-runtime/src/session/charge.ts

#:layer #!semantics
#:status #!proposed

#>charge_valence_brace_bridge
^seed[Spw.Theory.Charge.Valence.Brace.Bridge v:0.1 @profile:Spw.b @intent:vocabulary_orthogonalization]

^["roots"]{
 @brace_physics: ~"../../../.spw/registries/brace-physics.spw"
 @charge_crawl: ~"./brace-charge-crawl.spw"
 @valence: ~"./valence-architecture.spw"
 @field: ~"./operational-field.spw"
 @disclosure: ~"./representational-disclosure.spw"
 @coupling: ~"./coupling-constructors.spw"
 @charge_ts: ~"../../../packages/spw-runtime/src/session/charge.ts"
 @crawl_ts: ~"../../../packages/spw-runtime/src/session/crawl.ts"
 @em_fixity: ~"./em-fixity-association.spw"
 @fixity: ~"./fixity-brace-phrases.spw"
}

// ═══════════════════════════════════════════════════════════════
// Problem: one English noun, three field roles
// ═══════════════════════════════════════════════════════════════

^["collision"]{
 ~#claim: "The word charge is used for (1) open/close polarity of braces, (2) portable field packets that crawl, and (3) valence polarity language (positive/negative material feel)."
 ~#taste: "split the nouns before measuring the physics"
 ~#law: "Until renamed or status-tagged, no instrument may treat brace-physics charge_table as runtime ChargePacket law."
}

^["three_senses"]{
 // Prefer these head nouns in new writing.

 brace_polarity: .{
  old_names: #[charge_table, +tension/-discharge, left/right physics]
  proposed_noun: "port_polarity | accumulate_release"
  domain: "paired Bound open/close kinematics + optional render profiles"
  status: interpretive // brace-physics.spw charge_table
  implemented: "delimiter parse + coupling tags only — not polarity evaluation"
  law: "open/close are canonical; left/right is render-only"
 }

 operational_charge: .{
  old_names: #[charge, ChargePacket, crawl charge states]
  proposed_noun: "charge (keep) — field quantity only"
  domain: "portable value · subject · substrate under crawl verbs + channel"
  status: measured // charge.ts + crawl.ts partial
  states: #[latent, potentiated, bound, mobile, discharged, shielded]
  carriers: #[value, subject, substrate]
  law: "charge moves; valence does not move charge"
 }

 material_valence: .{
  old_names: #[boon, bane, bone, bonk, honk, valence charge]
  proposed_noun: "valence (keep) — material quality only"
  domain: "pentad quality lens; BBBH runtime four-state + bonk overlay"
  status: mixed // UI/shader measured-ish; runtime quality four-state; pentad interpretive for components
  law: "valence is charge-neutral quality; do not sum valence into operational charge without a named measure"
 }
}

// ═══════════════════════════════════════════════════════════════
// How braces actually relate (without physics cosplay as law)
// ═══════════════════════════════════════════════════════════════

^["brace_role"]{
 // Operational-field friendly reading of braces.

 product_role: "Bounds structure product identity (kind, occupancy, actPlacement) via coupling"
 disclosure_role: "open/close silhouette is dual-read form; not a force"
 retention_role: "depth and span may correlate with navigation cost under a *declared profile* only"
 attention_role: "tension_gradient / epic frames may rank thrift of disclosure — interpretive until measured"

 capture_vs_shield: .{
  source: @charge_crawl
  capture: "inhabit + hold payload — occupancy rises"
  shield: "membrane / channel / dialect — effect grade limited"
  dual: "same Bound kind may capture and shield depending on occupancy + meta"
 }

 couple_vs_capsule: .{
  law: "digraph <> is Act (couple); <…> is Bound (capsule) — shared glyph in nest alphabet, not shared TokenType"
  original_intent: "not meant to diverge philosophically; implementation stratifies forms"
  polarity: "couple has no open/close polarity; capsule may take accumulate/release *profile*"
 }
}

// ═══════════════════════════════════════════════════════════════
// Gaps that need working out
// ═══════════════════════════════════════════════════════════════

^["gaps"]{
 G1_polarity_vs_packet: .{
  issue: "brace-physics charge_table reads as physics law; runtime ChargePacket is different"
  work: "rename profile columns to polarity/profile; keep charge for packets only"
  status: proposed
 }

 G2_valence_sum: .{
  issue: "valence_composition says frame charge is sum of valence markers — contradicts charge-neutral valence + operational charge"
  work: "replace 'sum of charge' with 'composition of material quality'; optional %valence_mix measure later"
  status: proposed
 }

 G3_saturation_md: .{
  issue: "docs/theory/md/operational-physics.md 'valence saturation' is a third model (operator occupancy) using the word valence"
  work: "retitle to occupancy/saturation of Act×Bound; keep valence for BBBH pentad only"
  status: proposed
 }

 G4_bbbh_vs_pentad: .{
  issue: "runtime four-state quality (boon bane bone honk) vs pentad (+bonk); bonk is catalytic overlay"
  work: "keep bridge note as law; instruments must declare four-state vs pentad"
  status: measured // bridge already in valence-architecture
 }

 G5_accounting_locus: .{
  issue: "charge has state but weak *where* (operand vs inner vs particle) — accounting gap in brace-charge-crawl"
  work: "ChargeProvenance + optional locus (boundary port | named region | particle id)"
  status: proposed
 }

 G6_discharge_homonym: .{
  issue: "discharge means (a) close Bound polarity, (b) ChargeState, (c) effect.l2 write under channel"
  work: "prefer: seal (Bound close profile), discharged (packet state), host_write / precipitate (effect)"
  status: proposed
 }

 G7_depth_budget: .{
  issue: "depth 4/5 thresholds are hypotheses sold as physics"
  work: "keep under tension_gradient with measured status only after experiment"
  status: interpretive
 }

 G8_fixity_vs_polarity: .{
  issue: "prefix/postfix Act×Bound association conflated with open/close brace polarity and with charge discharge"
  work: "fixity = association geometry (+{ } vs { }+); polarity = Bound ports; charge = packet state — see em-fixity-association.spw"
  status: proposed
 }
}

// ═══════════════════════════════════════════════════════════════
// Proposed orthogonal matrix (for new instruments)
// ═══════════════════════════════════════════════════════════════

^["matrix"]{
 // Rows: what you measure. Columns: which vocabulary.

 axes: #[
  .{ axis: structure,     noun: "Bound kind / coupling", source: "seed coupling + brace projection" }
  .{ axis: fixity,        noun: "Act×Bound association (prefix +{ } / postfix { }+ / interior / membrane)", source: "actPlacement + em-fixity-association" }
  .{ axis: polarity,      noun: "open/close Bound port profile (accumulate_release)", source: "brace-physics interpretive" }
  .{ axis: charge,        noun: "packet + state + carrier", source: "charge.ts / crawl" }
  .{ axis: valence,       noun: "boon|bane|bone|bonk|honk quality", source: "valence-architecture / runtime quality" }
  .{ axis: saturation,    noun: "Act×Bound occupancy continuum", source: "operational-physics.md — rename off valence" }
  .{ axis: channel,       noun: "effectCeiling / collate|discharge wall", source: "channels + operational-field" }
  .{ axis: disclosure,    noun: "Spw card under dialect×mode×grain", source: "representational-disclosure" }
 ]

 forbid: "cross-wiring axes without an explicit measure product"
}

// ═══════════════════════════════════════════════════════════════
// Work order (doctrine before meters)
// ═══════════════════════════════════════════════════════════════

^["work"]{
 now: #[
  "status-tag every public use of charge in theory (polarity | packet | metaphor)",
  "edit valence_composition language away from sum-of-charge",
  "link brace-physics charge_table header to this bridge",
 ]
 next: #[
  "retitle operational-physics.md saturation off valence",
  "ChargeProvenance.locus optional field (particle/port/region)",
  "one measured experiment for depth_budget or retire threshold claims",
 ]
 refuse: #[
  "implement brace charge_table as runtime evaluator",
  "merge valence into ChargeState enum",
  "treat left/right as grammar",
 ]
}

#>wonder_charge_valence_brace_1
?["Which sense of charge did the last instrument mean?"]{
  interprets: objective
  considers: #[brace_polarity, operational_charge, material_valence, saturation]
  surfaces: #[theory, runtime, cli, card]
  run: "if two senses appear in one paragraph without status tags, split nouns"
  !probe{ "prefer polarity | charge | valence | occupancy as distinct head nouns." }
}
