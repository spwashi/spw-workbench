#>form_ladders
// Form Ladders
#
// Revisioned, interpretive contours over paired boundaries and operators.
// A ladder orders examples for inspection; it is not biological development,
// a runtime evaluation law, or proof that later points are improvements.
#
// @see packages/spw-seed/src/canonical/form-ladders.ts
// @see packages/spw-seed/src/canonical/form-contours.ts
// @see docs/theory/spw/coupling-constructors.spw
// @see docs/theory/spw/form-contours.spw

#:layer #!semantics

^seed[Spw.Form.Ladders v:0.3 @profile:interpretive @intent:inspectable_form_contours]

^["profile"]{
 id: Spw.Form.Ladders
 revision: 0.3
 status: interpretive
 included_kinds: #[frame, body, scope, capsule, stream, nrange]
 measured_separately: #[parse_health, expectation_met, prose_fallback, normalized_coupling]
 law: `Role and axis labels are hypotheses; parser observations are evidence fields, not confirmation of those labels.`
}

^["vocabulary"]{
 canonical_set: paired_boundary
 local_alias: brace
 alias_rule: `A local brace set may omit Capsule/angle forms; every profile must disclose its included kinds.`
 symmetry: `All paired boundaries share open, interior, close, occupancy, and payload coordinates.`
 distinction: `Frame, Body, Scope, Capsule, Stream, and NRange keep different kind tags and may receive different profile dynamics.`
 adjacent_operator: `<> is a relation operator with operands and arity; it is not an empty Capsule.`
}

^["empty_structure"]{
 common: `occupancy=empty, payload=void`
 not: #[runtime_unit, zero_value, membrane_force, selection_result]
 note: `Selection, material, hold, membrane, channel, and range are interpretive readings layered over the structural state.`
}

^["paired_boundary_contours"]{
 frame: .{
  axes: #[selection, label, path, fold]
  contour: `[] => [x] => [a, b] => [name: x] => x / [y] => #[a, b] => #[a, b, c]`
 }
 body: .{
  axes: #[material, ground, label, fold]
  contour: `{} => {x} => {a b} => .{} => .{k: v} => .{a: 1, b: 2} => ^["name"]{}`
 }
 scope: .{
  axes: #[flow, reference, path, ground]
  contour: `() => (x) => (_) => @() => @(here) => (a / b) => @(a / b)`
 }
 capsule: .{
  axes: #[interface, label, reference]
  contour: `< > => <tag> => <x> => <tag>{body} => ~"<path>"`
  exclusion: `The <> operator is deliberately outside this boundary contour.`
 }
 stream: .{
  axes: #[flow, fold, path, reference]
  contour: `<<>> => <<x>> => <<a, b>> => <<a, b, c>> => <<a, b>> / head => <<x>>@sink`
 }
 nrange: .{
  axes: #[selection, path, fold]
  contour: `(()) => ((x)) => ((a / b)) => ((a .. b))`
 }
}

^["operator_composition"]{
 rule: `An operator may use a paired boundary as an argument or product surface without changing its operator kind.`
 couple_example: .{
  zero: `<> -> kind=couple, form=operator, arity=0`
  operands: `<>["a", "b"] -> couple operator composed with a Frame operand surface`
  invariant: `The surrounding Frame does not retag the operator as kind=frame.`
 }
 preferred_boundary: `A catalog preference records an observed or proposed product surface, not universal evaluation physics.`
}

^["contour_semantics"]{
 arrow: `=> means ordered enrichment or inspection in this catalog only.`
 not: #[file_mutation, historical_evolution, developmental_stage, semantic_entailment]
 roles: #[empty, inhabit, select, materialize, hold, membrane, channel, range, label, path, ref, ground, fold, product]
 axes: #[selection, reference, path, label, ground, fold, flow, interface, material, potential]
}

^["tooling"]{
 full: `npm run spw:pulse -- --ladder frame --contour full`
 axis_projection: `npm run spw:pulse -- --ladder frame --contour axes`
 balanced_projection: `npm run spw:pulse -- --ladder body --contour balanced --contour-points 4 --json`
 boundary_catalog: `npm run spw:pulse -- --ladder boundaries`
 legacy_alias: `--ladder braces remains accepted as a query alias and reports the exact included set.`
}

^["falsify"]{
 #[
  "a reduced contour omits points without reporting loss",
  "a non-identity projection claims semantic equivalence",
  "the <> operator resolves as the Capsule boundary",
  "an empty boundary invents a runtime unit value",
  "a profile uses brace as a universal set name without disclosing whether angle forms are included",
  "an interpretive role is reported as measured parser behavior"
 ]
}
