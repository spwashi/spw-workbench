// Form Ladders
#
// Brace-primary operational sequences. Operators plug into braces; neither
// invents capacitance as law. Meta-arrow `=>` joins enrichment of form.
#
// Axes: selection, reference, path, label, ground, fold, flow, interface, material, potential.
#
// @see packages/spw-seed/src/canonical/form-ladders.ts
// @see docs/theory/spw/operator-brace-composition.spw
// @see docs/theory/spw/coupling-constructors.spw
// @see docs/theory/spw/operators.spw

#:layer #!semantics

^seed[Spw.Form.Ladders v:0.2 @profile:Spw.b @intent:brace_primary_enrichment]

^["status"]{
 implemented: "BRACE_LADDERS + OPERATOR_LADDERS + BRACE_AXIS_IMPLICATIONS + probes"
 vocabulary: "hole `_`, void empty form, selection, path, ref, label, ground, fold — not capacitance"
 not: "runtime auto-walk of ladders; pair labels populated by grammar (still uneven)"
}

^["arrow"]{
 meta: `=>`
 meaning: `form enrichment — occupancy, axis, or Act×Bound product`
 not: #[file mutation sequences, grammar `->`, spirit-sequence identity]
}

// ═══════════════════════════════════════════════════════════════
// Which brace implies which operations
// ═══════════════════════════════════════════════════════════════

^["brace_axes"]{
 frame_[]: .{
  implies: #[selection, label, path, fold]
  empty: `[] → void_selection`
  ladder: `[] => [x] => [a, b] => [name: x] => x / [y] => #[a, b] => #[a, b, c]`
  ops: `preferred by # (set product)`
 }
 body_{}: .{
  implies: #[material, ground, label, fold]
  empty: `{} → void_field`
  ladder: `{} => {x} => {a b} => .{} => .{k: v} => .{a: 1, b: 2} => ^["name"]{}`
  ops: `preferred by . & * ^ =`
 }
 scope_(): .{
  implies: #[flow, reference, path, ground]
  empty: `() → void_hold`
  ladder: `() => (x) => (_) => @() => @(here) => (a / b) => @(a / b)`
  ops: `preferred by @ ~`
 }
 capsule: .{
  implies: #[interface, label, reference]
  empty: `< > → open_membrane (not digraph <>)`
  ladder: `< > => <tag> => <x> => <tag>{body} => ~"path" => <>`
  note: `digraph <> is couple Act; listed last as adjacent phenomenon`
 }
 stream: .{
  implies: #[flow, fold, path]
  empty: `<<>> → empty_channel`
  ladder: `<<>> => <<x>> => <<a, b>> => <<a, b, c>> => <<a, b>> / head => <<x>>@sink`
  ops: `affinity neighbor of ?`
 }
 nrange: .{
  implies: #[selection, path, fold]
  empty: `(()) → empty_range (parse debt: may prose)`
  ladder: `(()) => ((x)) => ((a / b)) => ((a .. b))`
 }
}

^["axes"]{
 selection: `pin / address / params — frame primary`
 reference: `@ standpoint, pathref, couple peer names — scope/capsule`
 path: `/ projection chains — often with scope or after ground`
 label: `Parameter names, facet keys, ^["name"], operator labels !x, capsule tags`
 ground: `. and .{} baseline; empty units as ground cases`
 fold: `many→one — # sets, .{} maps, & confluence, stream reduce`
 flow: `() hold and <<>> channel`
 interface: `<…> membrane and <> couple ports`
 material: `{} definition field`
 potential: `~ defer and ? probe`
}

// ═══════════════════════════════════════════════════════════════
// Labels, grounding, folding (explicit)
// ═══════════════════════════════════════════════════════════════

^["labels"]{
 sources: #[
  `operator label: !x / adjacent id (implemented partial)`,
  `facet key: .{k: v}`,
  `integrate header: ^["name"]{}`,
  `capsule tag: <tag>`,
  `parameter name: [name: x]`,
  `pair open/close labels: proposed — grammar uneven`
 ]
 law: `A label attaches to pair or Act identity; mismatch is evidence, not rename`
}

^["grounding"]{
 ground_act: `.`
 empty_ground: `.{}`
 inhabited_ground: `.{k: v}`
 empty_units: `[] {} () < > <<>> as void_* units — structural ground of each Bound`
 law: `Ground is baseline structure, not electrical metaphor unless a profile says so`
}

^["folding"]{
 form_fold: `ladder step multi → product that reduces (#[a,b,c], .{…}, &)`
 edit_fold: `foldTransforms / serial operational sequences (mutation algebra)`
 stream_fold: `<<a,b,c>> as ordered fold domain (conceptual reduce)`
 law: `Name the fold layer: form | edit | stream | interpret`
}

^["paths_and_refs"]{
 path: `a / b / c — connector ladder; nests in () and after .`
 ref: `@(here), ~"relative/path", <>(a,b) peer names`
 selection_then_path: `#[a] / b or x / [y]`
}

// ═══════════════════════════════════════════════════════════════
// Operator plug-in (secondary)
// ═══════════════════════════════════════════════════════════════

^["operators"]{
 rule: `Each Act names preferredBrace and product; terminals use ground/fold/ref — not capacitance`
 example_confluence: `& => {&} => &[a, b] => {&[describe!]} => &(a, b, c) => .{&: _}`
 note: `{&[describe!]} remains optional annotate; describe is not required law`
}

^["cli"]{
 braces: `npm run spw:pulse -- --ladder braces`
 frame: `npm run spw:pulse -- --ladder frame`
 axes: `npm run spw:pulse -- --ladder braces --matrix`
 op: `npm run spw:pulse -- --ladder "&"`
 all: `npm run spw:pulse -- --ladder all`
}

^["falsify"]{
 #[
  "frame ladder claims flow axis as primary without selection",
  "capsule empty surface written as digraph <> token",
  "ground step uses capacitance vocabulary as required term",
  "fold layer not named when edit-fold and form-fold are conflated"
 ]
}
