# Gloss
#
# A reading laid alongside the thing it reads.

#>spw_gloss
#:layer #!semantics

^"roots"{
 @lexer: ~"../../../packages/spw-seed/src/lexer/matchers/gloss.ts"
 @grammar: ~"../../../packages/spw-seed/src/grammar/references.ts"
 @node: ~"../../../packages/spw-seed/src/types/ast/nodes.ts"
 @tests: ~"../../../src/seed/__tests__/gloss.test.ts"
}

^["intent"]{
 ~#goal: "Give a reading somewhere to live where an instrument can count it."
 ~#taste: "A gloss earns the form only if a selector finds it; a reading no tool can count is the comment it replaced."
 ~#problem: "1642 inline notes carried readings the parser never saw."
}

^["form"]{
 # Three degrees, one operator: the punctuation carries the difference
 '~#(phrase)'      { degree: "anonymous reading", claim: "the text is its whole meaning", key: none }
 '~#name(phrase)'  { degree: "named reading",     claim: "a reading that recurs, so it earns a key", key: queryable }
 '~#name: value'   { degree: "datum",             claim: "a value, not a viewpoint", key: queryable }
}

^["why_parens"]{
 ~#(the container decides the stance, not a convention)
 ~#pairing: "() is the @ container — who is looking"
 ~#consequence: "a parenthesized reading is perspectival by construction"
 ~#tension: "canonically # owns [] and @ owns (); the gloss mixes them deliberately — a part of the reading, seen"
}

^["body_is_prose"]{
 ~#rule: "taken raw to the matching paren"
 ~#reason: "a reading carries an apostrophe, a comma, a percent, an arrow"
 ~#failure_avoided: "lexing the body as tokens makes ordinary phrasing a syntax error — which is what pushed these readings into comments"
 ~#examples: ["it's the root map, 50% done", "local → global projection", "a/b ratio"]
}

^["names_considered"]{
 # The particle aims are grammatical categories (deixis, case, mood, aspect),
 # so a new form in that family wants a grammatical name too.
 'gloss'       { verdict: chosen,   reading: "a note at a different level of representation; interlinear gloss aligns a reading beside text" }
 'apposition'  { verdict: rejected, reading: "a phrase set beside a thing to characterize it — most exact, but long as a token type" }
 'aside'       { verdict: rejected, reading: "said past the scene to a viewer; perspectival, but connotes trivia" }
 'stance'      { verdict: rejected, reading: "accurate to how to hold this, but already means cache stance and brace_stance" }
 'regard'      { verdict: rejected, reading: "in what regard — carries perspective and respect-to, but reads clever" }
 'liminal'     { verdict: rejected, reading: "names where it sits, not what it is; already taken by label geometry" }
}

^["replaces"]{
 # Measured note population, by what each was labeling
 lens_label:        { count: 397, becomes: "~#lens(living system)" }
 ref_role:          { count: 242, becomes: "~#neighbor(nearest)" }
 expression_reading:{ count: 170, becomes: "~#(local → global projection)" }
 mark_gloss:        { count: 142, becomes: "~#name(gloss) on the existing mark" }
 region_header:     { count: 522, becomes: "^[\"name\"]{} — not a label at all" }
 divider_rule:      { count: 44,  becomes: "deleted; a named region makes it redundant" }
 path_description:  { count: 11,  becomes: "~#(…) beside the ref" }
}

^["liminality_ladder"]{
 ~#(the degrees a reading can occupy, from invisible to resolving)
 level-0: "inert text — present in the file, absent from the AST"
 level-1: "prose node — in the AST as text, no semantics"
 level-2: "named datum — queryable, a property of nothing in particular"
 level-3: "gloss — a reading bound to what it sits beside"
 level-4: "structure — participates in resolution"
 ~#diagnostic: "declared vs visible measures level intended against level achieved"
}

^["known_demoters"]{
 # Constructs that silently drop the marks of a frame out of the AST.
 # A gloss inside one of these is as invisible as the comment was.
 # Note: an apostrophe or em dash in a `#` line lexes as tokens, not prose,
 # so this file avoids both, for the same reason the forms below cost what they do.
 backtick_in_frame: { cost: "every ~# mark in that frame", status: open }
 bare_angle_path:   { cost: "80 marks across 42 surfaces", status: open, form: "~<./x.spw> — quote it or name it" }
 block_comment:     { cost: "the rest of the file", status: fixed }
}

^["invariant"]{
 "A gloss is an Annotation node, so every existing selector counts it without being taught."
 "Anonymous for a one-off reading; named the moment it recurs."
}
