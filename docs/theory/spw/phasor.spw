# Phasor Model
#
# Interpretive layers as phase angles.
# @see @src/core/layers/

#:layer #!semantics

^["roots"]{
  @src: ~"../src"
}

^["phasor"]{
  ~#metaphor: "Same phenomenon, different phase angles"
  ~#origin: "ECE phasors: V = |V|e^(jθ)"

  syntactic     # Structure, grammar, tokens
  semantic      # Meaning, types, relations
  pragmatic     # Use, context, effects
}

^["rotation"]{
  # Keyboard: Ctrl+1, Ctrl+2, Ctrl+3
  # Tab cycles views within layer

  ?[Ctrl+1]{ @syntactic }
  ?[Ctrl+2]{ @semantic }
  ?[Ctrl+3]{ @pragmatic }
}

^["views"]{
  syntactic: [tokens, ast, grammar]
  semantic: [types, flow, relations]
  pragmatic: [runtime, effects, output]
}

^["metaphor"]{
  # Like looking at same circuit:
  # - Time domain (syntactic)
  # - Frequency domain (semantic)
  # - Power analysis (pragmatic)

  # Rotate perspective, same content
}

?["At which spirit phase does a concept cross from potential to artifact?"]
  #:depth #!experiential  // lens: biome
  =raw: "?~<#.>@(#.)&[#.]*{#.}^" => $^[_.phase]
  ~<@docs/design/spw/spirit-sequence.spw>
  !probe{ "trace one concept through all 6 phases; find the phase boundary where ~ becomes ^ (materialization instant)" }

?["What is the phenomenology of reading a phase transition in source code?"]
  #:depth #!stylistic  // lens: texture
  ~#before: "~potential => ?wonder"
  ~#after: "!commit => ^artifact"
  !probe{ "capture the felt shift when scanning from ~ to ^; measure time-to-comprehension across 5 readers" }
