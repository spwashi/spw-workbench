# Phasor Model
#
# Interpretive layers as phase angles.
# @see @src/core/layers/

#:layer #!semantics

^["roots"]{
 @src: ~"../src"
}

^["phasor"]{
 ~#metaphor: "Same phenomenon, different phase angles"
 ~#origin: "ECE phasors: V = |V|e^(jθ)"

 syntactic # Structure, grammar, tokens
 semantic # Meaning, types, relations
 pragmatic # Use, context, effects
}

^["rotation"]{
 # Keyboard: Ctrl+1, Ctrl+2, Ctrl+3
 # Tab cycles views within layer

 ?[Ctrl+1]{ @syntactic }
 ?[Ctrl+2]{ @semantic }
 ?[Ctrl+3]{ @pragmatic }
}

^["views"]{
 syntactic: [tokens, ast, grammar]
 semantic: [types, flow, relations]
 pragmatic: [runtime, effects, output]
}

^["metaphor"]{
 # Like looking at same circuit:
 # - Time domain (syntactic)
 # - Frequency domain (semantic)
 # - Power analysis (pragmatic)

 # Rotate perspective, same content
}

#>wonder_docs_theory_spw_phasor_1
?["What ripples if #phasor changes in this file?"]{
  #:depth #!mathematical // lens: molecular binding
  $#experiential@workspace => %[reference.count, depth.downstream]
  ~#downstream: "trace all files that reference this surface"
  !probe{ "imagine renaming #experiential to #experiential_v2; count broken references; the count reveals how deeply roots is woven into the workspace." }
  $%[runtime.stage, runtime.queue_depth]
}

#>wonder_docs_theory_spw_phasor_2
?["What happens when you zoom from the concept level to the workspace level in Phasor Model?"]{
  #:depth #!stylistic // lens: ecological zone
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "roots" // this file's atom
  !probe{ "the atom is concept-scale; zoom out: what workspace-level pattern does this concept participate in?" }
  $%[runtime.stage, runtime.queue_depth]
  ~<"docs/theory/spw/audio-architecture.spw"> ~#neighbor(nearest)
}
