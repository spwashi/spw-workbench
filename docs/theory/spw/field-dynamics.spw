# Field Dynamics — abstract multi-locus modeling
#
# Domain-agnostic primitives for ensembles of carriers on sites with coupling,
# decay, flux, capacity, and cascade. Broad enough for production continuity,
# linguistic construct development, and PE salience — without overfitting to
# any single scientific cluster.
#
# Machine: packages/spw-seed/src/math/field.ts
# PE: prompts/math/field.spw
# Production: prompts/production/ensemble.spw

#:layer #!semantics
#:status #!active

^seed[Spw.Field.Dynamics v:0.1 @profile:research @intent:abstract_fields]
{_field

 status: .{
  implemented = `field.ts probes + vitest; graph coupling via DirectedGraph`
  measured = `mass conservation on transfer/undirected diffuse; capacity approach; affinity caps`
  proposed = `workspace path-ref → field sites; Act-event field inject; cache keys for run snapshots`
  interpretive = `sigil metaphors only — # resonate ≠ document # light`
 }[reg=facet]

 # ── Primitive vocabulary (abstract) ───────────────────────────

 primitives: #[
  .{id=site, meaning=`locus of amplitude (frame, beat, register, host slot)`},
  .{id=field, meaning=`map site → scalar amplitude`},
  .{id=carrier, meaning=`named free mass with affinity over sites`},
  .{id=coupling, meaning=`edge weight / conductance between sites`},
  .{id=decay, meaning=`exponential fade; rate from half-life`},
  .{id=flux, meaning=`permeability × gradient`},
  .{id=cascade, meaning=`ordered gain stages with optional fade`},
  .{id=capacity, meaning=`saturation ceiling; logistic approach`},
  .{id=affinity, meaning=`preferential binding score carrier×site`},
  .{id=ensemble, meaning=`weighted mix of fields or carriers`},
  .{id=beat, meaning=`discrete clock: decay → diffuse → inject`},
  .{id=membrane, meaning=`boundary law: what may cross (refuse list / grade)`},
 ][reg=set]

 # ── Spw linguistic construct map ──────────────────────────────

 construct_map: .{
  site = `^frame id | host slot | beat index | organ`
  field = `~#traits amplitude; continuity charge; salience vector components`
  carrier = `subject_id / style_id / voice register as free mass`
  coupling = `relation graph; path-ref DAG; department adjacency in production`
  cascade = `template expand → job fill → multi-host emit`
  capacity = `slot must-fill ceilings; thrift sentence budget`
  affinity = `genre×style fit; host_map preference in propagate.spw`
  beat = `saga step; fieldBeat; show beat without story nouns`
  ensemble = `cast of carriers; multi-title line; vibe stack ≤3`
 }[reg=facet]

 # ── Production & template use (abstract) ──────────────────────

 production: .{
  show_line = `sites = beats×hosts; carriers = locked genotypes; continuity = conserved charge`
  template = `holes = unfilled capacity; expand = inject; measure = residual vs anchors`
  nuance = `affinityAllocate seeds differentiated bindings without one-hot stereotypes`
  evolve = `fieldBeat over steps; fixedPoint on Hold; cascade for department chain`
 }[reg=facet]

 # ── Feature & cache ───────────────────────────────────────────

 feature_ids: #[
  `spw.lang.field-dynamics@v0.1:preview`
  `spw.production.ensemble-model@v0.1:preview`
  `spw.math.field-probes@v0.1:stable`
 ]

 cache: .{
  cold = `genotype packs (style/subject/genre/house) — rare write`
  warm = `field run snapshots: site amplitudes + carrier free after beat N`
  hot = `active expand bindings / open holes`
  generated = `host packets — rebuild from cold+warm`
  key_shape = `field:{model_id}:rev{n}:beat{t}`
  law = `topology.spw: one cache-key prefix per owner; no silent overwrite of cold`
 }[reg=facet]

 # ── Tests ─────────────────────────────────────────────────────

 test: .{
  command = `npx vitest run packages/spw-seed/src/math/field.test.ts`
  invariants = #[
   `transfer conserves fieldSum`
   `undirected diffuse conserves fieldSum`
   `affinity never exceeds site capacity`
   `capacityStep stays in [0,K] for r,x>0`
  ]
 }[reg=facet]

 refuse: #[
  "Hard-code domain cluster names as required vocabulary"
  "Treat document # prose as runtime field inject"
  "Cache host packets as genotype source of truth"
 ][reg=set]
}
