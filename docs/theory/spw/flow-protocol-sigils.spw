// Flow protocol sigils - prefix/postfix x brace x spacing x adjacency
//
// One lattice of Acts defines flows, routines, strategies, procedures, biases,
// probes, and measures. Runtime + LSP read the same scanFlowProtocol module.
//
// @see packages/spw-seed/src/canonical/flow-protocol.ts
// @see packages/spw-seed/src/canonical/geometric-resonance.ts
// @see packages/spw-runtime/src/session/probe-measure.ts
// @see docs/theory/spw/fixity-brace-phrases.spw
// @see docs/theory/spw/brace-charge-crawl.spw

#:layer #!semantics
#:status #!partial

^seed[Spw.Flow.Protocol.Sigils v:0.1 @profile:Spw.b @intent:protocol_modules]

^["roots"]{
 @impl: ~"../../../packages/spw-seed/src/canonical/flow-protocol.ts"
 @geo: ~"../../../packages/spw-seed/src/canonical/geometric-resonance.ts"
 @probe: ~"../../../packages/spw-runtime/src/session/probe-measure.ts"
 @fixity: ~"./fixity-brace-phrases.spw"
 @charge: ~"./brace-charge-crawl.spw"
 @flow: ~"./mutation-flow-automata.spw"
}

^["thesis"]{
 ~#claim: "Prefix and postfix sigils, paired braces, spacing, and adjacency are enough to name protocol modules - without a second keyword language."
 ~#taste: "one glyph lattice · roles by composition · measure probes honestly"
 ~#law: "Role is inferred from Act x Bound x spacing x schedule; tooling discloses confidence."
}

^["roles"]{
 flow: "ordered schedule << ~ ; ? ; % ; ! ; * ; ^ >> or postfix stitch"
 routine: "^[\"name\"]{…} integrate frames as repeatable unit"
 strategy: "=[axis] / =phi[…] bias-weighted choice"
 procedure: "!…{ } / *…{ } action or collapse discharge"
 bias: "=[axis] anchor { targets }"
 probe: "?[\"…\"]{ } / !probe{ }"
 measure: "$%[…] / %[…]"
 hold: "@(…)"
}

^["composition"]{
 prefix: "Act before Bound - ![] *{ } ^[\"n\"]{ }"
 postfix: "Bound/subject then Act - data~"
 tight: "ActBound no space - high commitment"
 spaced: "Act Bound - softer aperture"
 schedule: "; sequential , || parallel inside <<"
 adjacency: "units within window resonate geometrically"
}

^["examples"]{
 pipeline: |
  @dialect:Spw.f
  =phi[ id: soft ]{ << ~ ; ? ; % ; ! ; ^ >> }
  =ceiling[ l0 ]

 procedure_probe: |
  ?["Does it hold?"]{
    !probe{ =id[p_hold] }
    $%[Hold, thrift]
  }
  !boon{ apply }

 strategy_bias: |
  =[resolve] ~"a.spw" { ~"b.spw" ; ~"c.spw" }

 dual_fixity: |
  // prefix arm then postfix stitch
  ~"mod.spw"
  data~
}

^["lsp"]{
 methods: #[
  spw/flowProtocol
  spw/geometricResonance
  spw/probeMeasure
  spw/surfaceProfile
 ]
}

^["runtime"]{
 HotRuntimeSession.inspect: "includes flow + geometric + probeMeasure"
 measureProbesAndSubstrate: "document + optional Substrate vibration"
 detectResonances: "event-log; geometric is orthogonal form scan"
}

^["open"]{
 ?[role_collision]: "When is !{ procedure vs probe without !probe label?"
 ?[spacing_law]: "Should spaced Act Bound lower confidence in machine dialect?"
 ?[module_id]: "Mint protocol module ids from ^seed header only?"
 ?[geo_vs_event]: "Merge geometric + event resonance in one report or keep dual?"
 ?[plugin_ui]: "Surface flow roles as code lens or only custom request?"
 ?[bias_read]: "Wire scanFlowProtocol biasAxes to readBias AST edges?"
}

#>wonder_flow_protocol_1
?["Can one schedule teach all crawl verbs without English?"]{
  #:depth #!educational
  !probe{ =id[p_sched_teach] }
  << ~ ; ? ; % ; ! ; * ; ^ >>
  $%[literacy.form]
}

#>wonder_flow_protocol_2
?["Where does geometric resonance disagree with substrate resonance?"]{
  #:depth #!computational
  !probe{ =id[p_geo_event] }
  $%[resonance.geometric, resonance.event]
}
