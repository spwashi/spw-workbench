// Dimensional Axes
#
// Abstract axes for PE, publishing, literacy progression, and language evolution.
// Mathematical soundness first; subjective hooks second; operational bindings third.
// Context-sensitive salience reweights attention without rewriting genotype law.
#
// @see prompts/substrate/axes.spw          — PE cache / authoring surface
// @see packages/spw-cli/src/emit/axes.ts   — portable scoring + salience
// @see docs/theory/spw/valence-architecture.spw
// @see docs/library/spw/wonder-calculus.spw
// @see prompts/sagas/optimize.spw

#:layer #!semantics

^seed[Spw.Dimensional.Axes v:0.1 @profile:research @intent:axis_algebra]
{_axes

 // ── Status ────────────────────────────────────────────────────

 status: .{
  implemented = `axes.ts catalog, salience tables, literacy product, fractal composite reweight`
  measured = `hold ratios, thrift, positive_ground, depth weights — recomputable from emit IR`
  proposed = `editor museum dual-read; merch SKU pin; operator provisional scope`
  interpretive = `subjective hooks for teaching and play; not runtime forces`
 }[reg=facet]

 // ── Core law ──────────────────────────────────────────────────

 definition: `An abstract axis is a named one-dimensional quantity with domain, unit-or-ratio, dual subjective hook, and operational binding. Axes compose by named formulas; they do not silently overwrite each other.`

 law: #[
  .{id=id_stable, rule=`Machine ids (axis.*) never rename for fashion; pedagogical and product names may alias.`},
  .{id=clock_isolation, rule=`Tempo axes (production, product, language) reweight salience; they do not change hold metric definitions.`},
  .{id=one_coordinate, rule=`Saga #mutate may touch exactly one PE/search coordinate class unless !bonk — same as schema.spw.`},
  .{id=salience_not_law, rule=`Context salience is a attention kernel w_c(a) ∈ [0,1]; genotype locks and IR fields remain independent of w_c.`},
  .{id=promote_gate, rule=`Canonize only when Hold ≥ θ ∧ evidence ∧ episode — F4 mind formula.`},
  .{id=epistemic_isolation, rule=`Interpretive hooks cannot override measured hold or parser facts (E0).`},
 ][reg=set]

 // ── Tempo clocks (civilizational scale) ───────────────────────

 tempo: #[
  .{
   id=tempo.production
   domain=`[0,∞) rate of jobs/emits`
   math=`ρ_prod = n_packets / Δt`
   hook=`hype volume; thrash freely in hot`
   ops=`emit pack | fractal | job status #draft`
   slower_than=[]
  }
  .{
   id=tempo.product
   domain=`seasonal SKU / motif windows`
   math=`ρ_sku = n_promoted_motifs / season`
   hook=`print, merch, specialty expressions`
   ops=`expression id × motif × profile_revision pin`
   slower_than=[tempo.production]
  }
  .{
   id=tempo.language
   domain=`multi-year operator/reading retune`
   math=`ρ_lang = n_semantic_episodes / years`
   hook=`discovery of operators; naming as culture`
   ops=`provisional glyph → dual-read → canon revision`
   slower_than=[tempo.product, tempo.production]
  }
 ][reg=set]

 // ── Literacy product (mind formula F1) ────────────────────────

 literacy: .{
  id=literacy.product
  form=`L = Form · Agency · Evidence · Memory`
  domain=`each factor ∈ [0,1]; L ∈ [0,1]`
  factors: #[
   .{id=literacy.form, math=`register + traits^+ + syntax integrity`, hook=`can you say what you mean?`},
   .{id=literacy.agency, math=`single_coordinate_steps / total_mutate`, hook=`did you choose one move?`},
   .{id=literacy.evidence, math=`Hold (see hold family)`, hook=`did it survive other mouths?`},
   .{id=literacy.memory, math=`locks bound + revision pinned`, hook=`will the next generation still know?`},
  ]
  zero_law=`If any factor is 0, literacy collapses — mute consumption, thrash, amnesia, or dogma.`
  subjective=`College spine: form (Y1) → duals (Y2) → search (Y3) → circulation (Y4)`
 }[reg=facet]

 // ── Hold family (mind formula F2) ─────────────────────────────

 hold: .{
  id=hold.family
  form=`Hold = ∏_i h_i^{α_i}  with h_i ∈ [0,1], α_i ≥ 0`
  default_α=`salience-normalized weights from context c`
  members: #[
   .{id=hold.positive, h=`1 if no negation spine else 0`, measured=true},
   .{id=hold.continuity, h=`anchors_hit / max(1, anchors_checked)`, measured=true},
   .{id=hold.style, h=`style anchors ratio`, measured=true},
   .{id=hold.subject, h=`subject anchors ratio`, measured=true},
   .{id=hold.genre, h=`genre anchors ratio`, measured=true},
   .{id=hold.thrift, h=`1 / max(1, sentence_estimate)`, measured=true},
  ]
  fractal_form=`score = Σ_k w(k) · Hold_k  / Σ_k w(k)  (k host or depth arm)`
  wonder_link=`symmetry: identity is what survives lens/host change`
 }[reg=facet]

 // ── Search / ethics (mind formula F3) ─────────────────────────

 search: #[
  .{id=search.coordinate, domain=`one PE class per #mutate`, hook=`restraint as craft`},
  .{id=search.budget, domain=`max_mutate, max_depth, max_bonk`, hook=`finite attention`},
  .{id=search.grade, domain=`S0|S1|S2 effect authority`, hook=`what may I risk?`},
  .{id=search.objective, domain=`named formula id`, hook=`what am I optimizing for?`},
 ][reg=set]

 // ── Valence hygiene (anti-binary) ─────────────────────────────

 valence: .{
  id=valence.quality
  domain=`{boon, bane, bone, bonk, honk}`
  math=`discrete charge-neutral material labels — not moral scores`
  hook=`constraint and glow co-present; heals success/fail collapse`
  ops=`fold valence; saga decide; quality CSS vars`
  falsify=`If valence is treated as pass/fail only, hygiene failed.`
 }[reg=facet]

 // ── Circulation (market / studio physics) ─────────────────────

 circulation: #[
  .{id=circulation.channel, domain=`host codecs`, math=`host ∈ Host`, hook=`same IP, different mouth`},
  .{id=circulation.scarcity, domain=`edition/pin rarity`, math=`1 if revision pinned else 0`, hook=`art-market provenance`},
  .{id=circulation.continuity, domain=`franchise anchors`, math=`= hold.continuity`, hook=`Hollywood physics`},
  .{id=circulation.spectacle, domain=`scale pressure`, math=`inverse thrift under genre refuse`, hook=`refuse empire default`},
 ][reg=set]

 // ── Play / intrigue (intergenerational) ───────────────────────

 play: #[
  .{id=play.intrigue, domain=`open holes _ density`, math=`n_holes / n_slots ∈ [0,1]`, hook=`invite without humiliation`},
  .{id=play.expression, domain=`expression template ids`, math=`shared form, layered depth`, hook=`same toy, different theorem`},
  .{id=play.motif, domain=`visual/typographic crystallization`, math=`motif_id × expression_id`, hook=`print later, genotype now`},
 ][reg=set]

 // ── Language evolution ────────────────────────────────────────

 language: #[
  .{id=language.id, domain=`stable machine handle`, hook=`bookmarkable meaning`},
  .{id=language.reading, domain=`profile_revision of semantics`, hook=`living language`},
  .{id=language.alias, domain=`pedagogical / product names`, hook=`culture may rename without breaking ids`},
  .{id=language.dual_read, domain=`window of co-valid readings`, hook=`no amnesia retune`},
 ][reg=set]

 // ── Context → salience kernel ─────────────────────────────────
 // w_c(a) ≥ 0; for scoring, renormalize: ŵ_c(a) = w_c(a) / Σ_b w_c(b) over active factors.

 contexts: #[
  .{
   id=#production
   taste=`high volume jobs; soft measure; thrash hot`
   boost=#[hold.positive, hold.continuity, play.intrigue, tempo.production, circulation.channel]
   damp=#[tempo.language, circulation.scarcity, language.dual_read]
  }
  .{
   id=#canon
   taste=`promote locks; rare writes; episode required`
   boost=#[literacy.evidence, literacy.memory, hold.style, hold.subject, hold.genre, search.grade]
   damp=#[play.intrigue, tempo.production]
  }
  .{
   id=#research
   taste=`provisional operators; S0–S2 sandbox`
   boost=#[search.coordinate, search.budget, literacy.agency, tempo.language, valence.quality]
   damp=#[circulation.scarcity, play.motif]
  }
  .{
   id=#pedagogy
   taste=`college spine; wonder; intergenerational share`
   boost=#[literacy.form, literacy.agency, literacy.evidence, literacy.memory, play.expression, valence.quality]
   damp=#[circulation.spectacle]
  }
  .{
   id=#merch
   taste=`motif × expression × revision pin`
   boost=#[play.motif, circulation.scarcity, language.reading, hold.continuity, tempo.product]
   damp=#[tempo.production, search.budget]
  }
  .{
   id=#layout
   taste=`pulse / form ladders; structure safety`
   boost=#[search.grade, literacy.form]
   damp=#[hold.genre, play.motif]
  }
  .{
   id=#thrift
   taste=`social/web short; positive ground`
   boost=#[hold.positive, hold.thrift, hold.continuity, circulation.channel]
   damp=#[hold.genre, play.motif, tempo.language]
  }
 ][reg=set]

 // ── Relationship cache (typed edges) ──────────────────────────

 relations: #[
  .{from=tempo.production, to=tempo.product, rel=#slower_than_inv, note=`product slower than production`},
  .{from=tempo.product, to=tempo.language, rel=#slower_than_inv},
  .{from=literacy.evidence, to=hold.family, rel=#implements},
  .{from=hold.family, to=circulation.channel, rel=#feeds, note=`multi-host hold`},
  .{from=search.coordinate, to=literacy.agency, rel=#implements},
  .{from=play.expression, to=play.motif, rel=#feeds, note=`form before SKU`},
  .{from=language.reading, to=circulation.scarcity, rel=#gates, note=`pin revision before sell`},
  .{from=valence.quality, to=literacy.form, rel=#dual, note=`anti-binary material grammar`},
  .{from=promote_gate, to=tempo.product, rel=#gates},
  .{from=promote_gate, to=tempo.language, rel=#gates},
 ][reg=set]

 // ── Operational expressiveness ────────────────────────────────

 ops: .{
  pe_mutate_coords=#[axis_light, axis_density, axis_craft, axis_flavor, axis_era, tone_dim, style_phrase, subject_cast, genre_contract, host_slot, emit_phrasing, ladder_step, fractal_depth, macro_fill]
  emit_cli=`npm run spw -- emit fractal <file> --profile … --context production|canon|…`
  measure=`composite.score + composite.salience + composite.literacy`
  pulse=`layout context; brace projection structureMoved`
  cache_path=`prompts/substrate/axes.spw + axes.ts AXIS_CATALOG`
 }[reg=facet]

 // ── Mind formulas (portable) ──────────────────────────────────

 formulas: #[
  .{id=F1_packet, form=`Packet = Emit(register, traits^+, locks, host)`},
  .{id=F2_hold, form=`Hold = ∏ h_i^{α_i(c)}`},
  .{id=F3_step, form=`Δ_step ∈ one coordinate unless !bonk`},
  .{id=F4_promote, form=`Canonize ⇔ Hold≥θ ∧ evidence ∧ episode`},
  .{id=F5_share, form=`Shared = operators+motifs+expressions; Layered = depth of reading`},
  .{id=F6_live, form=`Meaning_t = (id, reading_r, alias, dual_read_window)`},
  .{id=F7_valence, form=`quality ∈ {boon,bane,bone,bonk,honk}`},
  .{id=F8_literacy, form=`L = Form·Agency·Evidence·Memory`},
 ][reg=set]

 falsify: #[
  `Salience rewrite changes style_lock string contents.`,
  `Merch SKU omits profile_revision pin while claiming scarcity.`,
  `Composite score uses opaque AI judgment without named metrics.`,
  `Context #production auto-writes #locked genotype without promote gate.`,
  `Binary pass/fail replaces valence pentad in fold advice.`,
 ][reg=set]
}
