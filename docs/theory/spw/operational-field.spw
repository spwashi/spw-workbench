# Operational Field
#
# Coordinate chart for product identity, retention, projection, charge motion,
# and measure landmarks. Companion to brace-charge-crawl and measure-context-kernel.
# Status advances as rewrite-v2 phases land code.
#
# @see .agents/plans/canon-rewrite-v2/PLAN.md
# @see docs/theory/spw/brace-charge-crawl.spw
# @see docs/theory/spw/measure-context-kernel.spw
# @see .spw/registries/register-bank.spw

#:layer #!semantics
#:status #!measured

#>operational_field
^seed[Spw.Operational.Field v:0.1 @profile:Spw.b @intent:field_coordinates]

^["roots"]{
 @brace_charge: ~"./brace-charge-crawl.spw"
 @measure: ~"./measure-context-kernel.spw"
 @operators: ~"./operators.spw"
 @plan: ~"../../../.agents/plans/canon-rewrite-v2/PLAN.md"
 @ir: ~"../../../packages/spw-seed/src/ir"
 @session: ~"../../../packages/spw-runtime/src/session"
 @cache: ~"../../../.spw/biome/ocean/algos/cache.spw"
}

^["thesis"]{
 ~#claim: "Every durable product sits at field coordinates; retention and projection are orthogonal; collate before discharge."
 ~#taste: "one noun per clock — identity ≠ retention ≠ rank"
 ~#law: "Request epoch, soft tags, resonance rank, and cache tier never enter product identity."
}

// ── Coordinates ───────────────────────────────────────────────

^["coordinates"]{
 identity: #[contentHash, uri, span, revision, dialect, lex_profile, producer_schema, boundary_contract, channel_when_eval]
 retention: #[session_beat, cache_tier_ttl, max_entries, volatility]
 projection: #[grain_depth, grain_plane, follow, disclose, editor_card]
 forbid_in_identity: #[request_epoch, soft_bc_tag, resonance_rank, attention, checkout_path]
}

^["clocks"]{
 request_epoch: "monotonic count of handled LSP JSON-RPC requests — observe only"
 session_beat: "runtime session retention / substrate tick"
 format_pulse: "format rule identity"
 law: "never share names across clocks"
}

// ── Collate / discharge ───────────────────────────────────────

^["collate_discharge"]{
 collate: #[search, census, plan_pulse, pattern_capture, dry_run, cycle_measure, wonder]
 discharge: #[workspace_write, commit, precipitate, hard_follow_eval]
 wall: "channel effectCeiling"
}

// ── Measure landmarks ─────────────────────────────────────────
// %name only — never %objective[name]
// Four landmarks orient every instrument:

^["measure_landmarks"]{
 form: "%name { interprets, considers, surfaces, run }"
 interprets: #[objective, subjective, mixed, interpretive]
 considers: "basis / sample / excluded noise"
 surfaces: #[live, tree, template, card, cli, lsp, test, postings]
 run: "instrument recipe"
 law: "interprets:objective may gate keys and writes; interprets:subjective may rank and disclose only"
}

// ── Modes ─────────────────────────────────────────────────────

^["interpretation_modes"]{
 live: "working-set / registers / partial products — memory lean"
 tree: "full parse/ONF — exact structural truth"
 template: "preprocess + holes + optional validate — pattern and pulse plans"
 law: "live must not claim closed parse; tree stamps path receipts; template blends under dialect"
}

// ── Operator stances (labels, not new glyphs) ─────────────────

^["operator_stances"]{
 form: "<sigil>_<objective|subjective>"
 note: "literacy and gate class only — lexer and runtime glyph meanings stay operators.spw"
 examples: #[~_objective, *_objective, &_objective, ^_objective, #_subjective]
}

// ── Status vocabulary ─────────────────────────────────────────

^["status"]{
 implemented: "observable in parser, runtime, CLI, or LSP"
 measured: "recomputable with published method"
 proposed: "typed contract not yet runtime law"
 interpretive: "teaching profile without gate force"
}

#>wonder_operational_field_clocks
?["Which public surface still confuses request epoch with session beat?"]{
  interprets: objective
  considers: #[request_epoch, session_beat]
  surfaces: #[lsp, cli, card]
  run: "grep public activity and hot-session APIs"
  !probe{ "rename until no shared head noun remains." }
}
