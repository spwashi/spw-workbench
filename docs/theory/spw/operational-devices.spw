// Operational Devices
#
// Formalizing semantic differentials, boundary observations, interpretive flow
// profiles, and previewable wonder plans within the Spw substrate.
#
// @see docs/theory/spw/operational-topography.spw
// @see docs/theory/spw/coupling-constructors.spw
// @see .spw/registries/brace-physics.spw

#:layer #!semantics

^seed[Spw.Operational.Devices v:0.1 @profile:research @intent:device_algebra]
{_devices

 // ── Status Vocabulary ─────────────────────────────────────

 status: .{
 implemented = `directly observable in parser tokens, ONF nodes, CLI instruments, or LSP handlers`
 measured = `recomputable from named inputs using a published metric or scan algorithm`
 proposed = `a typed boundary contract or interaction mode not yet runtime law`
 interpretive = `a physical rendering, linguistic metaphor, or cognitive profile`
 }[reg=facet]

 // ── Semantic Differentials ────────────────────────────────
 // Implemented pulse path: packages/spw-seed/src/canonical/{differential,mutation-automata,topography-probe}.ts
 // CLI: spw pulse | mutate | beat  (see mutation-automata.spw)

 definition: `A semantic differential is a stratified delta vector across source, structural, layout, reference, and operational planes under a declared normalization profile.`

 differential_strata: #[
 .{id=source, delta=`char/byte offsets, whitespace, trivia, formatting`},
 .{id=structure, delta=`AST depth, container nesting, node class, operator arrangement`},
 .{id=layout, delta=`indentation, alignment, blank line cadence, relative spacing`},
 .{id=reference, delta=`@root resolution, incoming/outgoing link hops, anchor bindings`},
 .{id=operation, delta=`ONF lowering, port routing, effect grade, evidence basis/domain/provenance`},
 ][reg=set]

 differential_laws: #[
 .{id=layout_invariance, rule=`A proposal is layout-only only after same-profile reparse preserves a declared semantic projection; AST object or span equality is neither required nor sufficient.`},
 .{id=brace_projection, rule=`BraceProjection (kinds, medials, shells, channels, coupleOps) is the default semantic projection for paired boundaries. Layout-only claims require projection equality after reparse. Implemented: packages/spw-seed/src/canonical/brace-projection.ts; topographyDelta sets structureMoved when projection drifts.`, status=implemented},
 .{id=mutation_usefulness, rule=`classifyMutationUsefulness maps health, brace, and layout evidence to agent advice: noop | layout_safe | review_structure | refuse_health. Pulse --diff annotates hunks with brace severity and use class.`, status=implemented},
 .{id=axis_salience, rule=`Context-sensitive axis salience α(c) reweights Hold products and literacy snapshots (F2/F8) without mutating genotype locks or IR trait text. Catalog: docs/theory/spw/dimensional-axes.spw; PE cache: prompts/substrate/axes.spw; machine: packages/spw-cli/src/emit/axes.ts; CLI: emit fractal --context.`, status=implemented},
 .{id=pair_preservation, rule=`A source-changing boundary edit requires parser-owned open and close spans. Frame, Body, and Scope do not yet retain those tokens, so paired-label edits remain proposed.`},
 .{id=evidence_isolation, rule=`A derived score or attributed report cannot be relabeled as an observed parser result; each contribution retains its basis, domain, method, and source revision.`},
 ][reg=set]

 // Payloads and Boundary Observations

 capacitance_status: interpretive
 definition: `Boundary capacitance is an optional name for a declared vector of span, parsed nesting, reference flow, edit frequency, and task observations. It is not a current semantic quantity or physical force.`

 boundary_ports: #[before_open, open_boundary, inside, close_boundary, after_close]

 capacitance_table: #[
 .{kind=body, surface=`{...}`, optional_profile=`accumulate / release`, current_fact=`Body AST node`},
 .{kind=frame, surface=`[...]`, optional_profile=`select / release`, current_fact=`Frame AST node`},
 .{kind=scope, surface=`(...)`, optional_profile=`contain / emit`, current_fact=`Scope AST node`},
 .{kind=capsule, surface=`<...>`, optional_profile=`interface / delivery`, current_fact=`Capsule AST node`},
 .{kind=stream, surface=`<<...>>@sink`, optional_profile=`ingress / egress`, current_fact=`Stream AST node; current ONF drops sink`},
 .{kind=nrange, surface=`((...))`, optional_profile=`bound / traverse`, current_fact=`NRange AST node`},
 ][reg=set]

 // Flow Profiles and Operator Tenses

 flow_status: interpretive
 definition: `A flow profile may give selected sigils linguistic tense names for teaching or rendering. Current parser, ONF, and runtime behavior remains sigil-specific and does not implement one shared timeline law.`

 flow_markers: #[
 .{sigil=`~`, tense=subjunctive, meaning=`what could be — unresolved potential`, flow=`opens a timeline`},
 .{sigil=`?`, tense=interrogative, meaning=`what is asked — suspended wonder`, flow=`pauses a timeline`},
 .{sigil=`!`, tense=imperative, meaning=`what must happen — committed force`, flow=`advances a timeline`},
 .{sigil=`^`, tense=perfective, meaning=`what was made — crystallized result`, flow=`closes a timeline`},
 .{sigil=`%`, tense=observational, meaning=`what is measured — non-invasive read`, flow=`observes without advancing`},
 ][reg=set]

 candidate_flow_sequence: `~ => ? => ! => ^ (interpretive ordering, not an execution contract)`

 // Operational Devices and Wonder Plans

 definition: `A proposed operational device binds intent, scope, selector expressions, preview, and an effect contract into a typed plan. Current wonder-like source remains ordinary parsed syntax until a named tool recognizes it.`

 wonder_block_device: .{
 status = proposed
 current_reality = `Seed can parse the constituent operators and containers, but no canonical wonder-device AST, advertised LSP request, code lens, or execution contract exists.`
 required = #[question, scope, selector, priming, handle, release]
 anatomy = .{
  question = `?[prompt] - candidate human-readable wonder surface`
  scope = `#:scope - candidate evaluation boundary (#!file, #!frame, #!workspace)`
  selector = `$~"expr" - candidate query selector; not a current execution guarantee`
  priming = `~#var - candidate plan binding`
  handle = `#>anchor - candidate cross-reference handle`
  release = `!release{ effect } - proposed preview and confirmation boundary, not an implicit trigger`
 }
 }[reg=facet]

 falsify: #[
 `A semantic differential reports equivalence when AST structures differ.`,
 `A flow marker alters parsing order without declaring dialect semantics.`,
 `A capacitance profile reports a scalar without named dimensions, method, and corpus.`,
 `An operational device executes an S2 or S3 effect without explicit authority confirmation.`,
 ][reg=set]

}_devices
