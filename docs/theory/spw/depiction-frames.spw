# Depiction and Nested Frames
#
# What a picture of a line owes the line, how that changes when depiction moves from a plane to a volume,
# and what rules a frame inside a frame could keep for binding, reference and charge.
# From the owner's wonders of 2026-11-09: file architecture and expression variety through a canvas host's lens,
# depiction beyond a decade of force graphs in a plane and onto scenes and canvases, denser number and mathematical forms,
# nested frames with physics for binding and reference, what happens when random charged or uncharged nodes are added,
# and what would extend the philosophical value and conceptual ergonomics of the language.
#
# @see docs/theory/spw/semantics-physics.spw
# @see docs/theory/spw/threshold-distance.spw
# @see docs/theory/spw/exhibit-floor.spw
# @see .spw/caches/journal/2026-11-09-registers-valence-numbers.spw

#>depiction_frames
#:layer #!semantics
#:status #!seeded

^["contract"]{
 exploratory: "A theory notebook of readings and proposed rules, not runtime or parser law. Nothing here is built; a rule binds only once a host or a contract repeats it."
 hosts: "The canvas host is named by role. Its physics today are its own; the rules below are proposals a headless run could test."
 renderers: "No renderer is canon. A claim about a plane or a volume is about what each can show, not about a library."
}

^["roots"]{
 @physics: ~"./semantics-physics.spw"
 @distance: ~"./threshold-distance.spw"
 @floor: ~"./exhibit-floor.spw"
 @wonder: ~"./wonder-field.spw"
 @math: ~"./math-modeling.spw"
 @numbers: ~"../../../.spw/caches/journal/2026-11-09-registers-valence-numbers.spw"
 @caches: ~"../../../.spw/caches/journal/2026-11-09-consumer-caches.spw"
 @trials: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw"
 @proposals: ~"../../../.agents/plans/syntax-hardware-alignment/syntax-hardware-alignment.spw"
}

^["thesis"]{
 ~#claim: "The line is conserved and the picture is not. A depiction is a second reading of a line, and it is lawful when the picture can be written back as the line it came from."
 ~#claim: "A closed frame is neutral from outside. What happens inside a body is felt beyond its brace only through a reference, an unclosed pair, or a law the parent shares on purpose."
 ~#claim: "A binding is a joint and a reference is a sight line. A joint moves what it holds; a sight line shows how far away a thing is and moves nothing."
 ~#law: "Every picture has a rest state, and adding or removing a node that the line does not write changes no reading."
 ~#refuse: #[
  "a depiction that needs a second file to say what it shows",
  "a force that crosses a brace without a reference to carry it",
  "depth used as ornament: if far does not mean something, the scene is a plane with a tilt",
 ]
}

^["plane_to_volume"]{
 # What a decade of force graphs in a plane taught, and what a scene and a canvas change.
 plane_taught: "one simulation, one stage: every node repels, links are springs, heat decays, and the layout is whatever is left. It made a line physical and made every line one flat frame."
 plane_limits: "no inside: a body is a hull drawn around nodes that still feel the whole stage; no depth: nearness means similarity and distance at once; a few hundred nodes before a document tree slows; physics as constants in code"
 volume_gives: .{
  depth: "a third axis that can mean one thing: reach. What is one hop from the held line is near, three hops is far, and what is leaving recedes."
  instances: "one shape drawn thousands of times: a corpus as a field of its shapes, so five shapes covering most lines is something a reader sees"
  material: "a mark's law as a material and not only a force: how a body takes light says which mark leads it, and a reader who cannot read the glyph still reads the well"
  observer: "a camera is an observer with a place: a scene seen from a keeper is a line read from a perspective, which a postfix observer already writes"
  portals: "a frame drawn inside a frame as a scene of its own: a body is a world with its own law and clock, and a reference is a window onto another one"
  text: "a canvas keeps the line as type, painted, beside the scene, so the as-written reading never leaves the screen"
 }
 same_duty: "A volume raises the debt. The more a picture can show, the more it can show that the line does not say. The test stays the one a mounted consumer wrote: an effect that cannot be written back as a line has left the language."
 scheme: "A depiction is itself a line: an observer, a channel, a ground and a body. One consumer proposes that as a single node, so a room's keeper, an address's @ and a camera read alike. Held as wonder_trial_depiction."
}

^["frame_rules"]{
 # Proposed rules for a frame inside a frame. Each names what a headless run would measure.
 frame: "a body with the mark that leads it. The mark is the frame's law; only its own parts feel it; a nested frame feels a share of its parent's (a consumer tunes that share at 1, 0.6 or 0.3)."
 clock: "each frame cools on its own. A touch heats the frame it lands in and, by the share, its children; never its siblings."
 binding: "key: value is a joint with a rest length. The value moves with its key, inside one frame. Measure: after any perturbation the pair's distance returns to rest."
 bias: "a tight =x is a lean: a joint with a direction, pulling its body toward its anchor and never the anchor toward the body."
 reference: "@name and a path are sight lines across frames. Following one brings a ghost of the referent into view; the referent does not move. Its length is the reach between the two. Measure: perturbing either end moves neither."
 charge: "an opener carries the charge of what it holds and its closer gives it back, so a closed pair is neutral. A valence word is a sign written on a noun: the same charge, said aloud."
 neutral_outside: "a closed frame is a dipole from outside and falls away fast. Its inside is felt beyond the brace only by a reference into it, a pair left open, or a shared law."
 open_pair: "a line that still owes a closer is an ion: its frame leaks charge to the parent until the closer is written. This is the one honest way an unfinished thought pulls on what surrounds it."
 conserved: "the line's bytes, a closed line's neutrality, and each body's part count"
 not_conserved: "position, heat, and which way a reader turned the scene"
}

^["random_nodes"]{
 # What should happen when a node the line did not write is dropped into a frame. A test of the rules, and a way to play.
 uncharged: "a bare word with no mark has mass and no sign. It settles under the frame's law, displaces neighbours by contact only, and leaves every joint at rest length. Dropped and removed, the frame returns to where it was: the reset that changes no meaning."
 charged: "a marked word, or one carrying a valence sign, polarizes the frame: parts with the same mark give it room, parts its mark acts on lean toward it. Inside a closed frame the parent feels nothing. Dropped into an open frame, the parent feels the sum."
 into_a_joint: "a node dropped between a key and its value stretches the joint and is pushed out; a joint is not a place to stand"
 onto_a_sight_line: "a node dropped on a reference passes through it; a sight line holds nothing"
 kept: "a dropped node becomes part of the line only by an edit that writes it: a part added to a body, with its mark. Until then it is a visitor."
 measures: "settle time, largest displacement of a bound pair, displacement of a referent, and charge seen from the parent; each should be zero or return to zero when the node is uncharged or the frame is closed"
 play: "Random charged nodes are a question asked with the hands: which mark does this body make room for? A frame that answers the same way each time has a law a reader can learn without reading it."
}

^["field_vocabulary"]{
 # Six words for what a frame holds and what moves in it, each tied to something Spw already has and to what the word would add.
 atom: .{ is: "a word, with at most one mark and one bracket: the smallest thing that reads alone", has_today: "an identifier; a slot hash component; what a consumer calls a collectible expression", adds: "a unit of keeping and of instancing: what a reader collects, and what a scene draws ten thousand of" }
 component: .{ is: "a shape with named holes and a law: a line of holes that is filled, and a mark that says how it behaves", has_today: "a line's slots; a shape written with _; a frame led by a mark", adds: "reuse with a contract: the same shape filled twice is the same component, and a host can check a filling against its holes" }
 edge: .{ is: "a relation between two things, of a kind that says what it carries", has_today: "a binding (a joint), a reference (a sight line), a tight = (a lean with a direction), and the join marks", adds: "a kind on every tie, so a host knows whether a drag carries, shows or leans, and reach can count only the edges that matter to a question" }
 gradient: .{ is: "a quantity that changes smoothly with distance from a centre", has_today: "rings of reach, retention tiers, fixity words, heat that decays, a range written a..b", adds: "the space between rungs: a ladder says hot, warm, cold, and a gradient says how warm; a host can fade, and a lean can have a strength that falls off" }
 ephemeral_bias: .{ is: "a lean that expires: toward something, for a while, and then gone unless kept", has_today: "a prime that bleeds charge in one host, a quick touch whose transient is taken back in another, a register cell at local liminality, the ~ mark for potential", adds: "attention as data that is not yet the line: touch without keep. It is where a visitor's interest lives before they write anything." }
 eddy: .{ is: "a circulation that does not settle: things that keep reaching each other", has_today: "cycles in the reference graph; a loop a plan names for its own improvement; a rest state that is a walk and not a point", adds: "a name for what stays alive: here the living caches tree is one eddy of 361 surfaces and a journal entry is in none, which is exactly the difference between a thing kept true and a thing recorded" }
 as_a_set: "Atoms and components are what there is. Edges are how they hold. Gradients are how far a hold reaches. An ephemeral bias is a hold that has not been written. An eddy is a hold that feeds itself. A frame's physics is these five kinds of hold over one kind of thing."
 against_charge: "A charged random node is an ephemeral bias made visible: it leans its frame for as long as it is there. An uncharged one tests whether the eddies and joints return to where they were."
 measure_each: "atoms: distinct words per frame. components: shapes per file. edges: ties by kind. gradients: how reach from the centre falls ring by ring. ephemeral biases: leans that end without an edit. eddies: groups of surfaces that all reach each other."
}

^["file_architecture"]{
 # A file read as a canvas host reads it: a world of frames.
 frame_is_a_room: "a top-level frame is a stage a reader can hold at once. Nine tokens in ten sit within three containers, so a frame is rarely deeper than a hand can open."
 mark_is_the_plan: "the marks that lead a file's top-level frames are its architecture: what is grounded, what is questioned, what is gathered. A reader should be able to see them without a word."
 anchor_is_a_door: "a citation lands on a claim only where anchors are six lines apart; at sixty it lands on a file. A file written for a canvas puts a door on every frame."
 variety: "five line shapes cover most of one consumer's expression lines. A file of one shape is a table and can be drawn as one; a file of many shapes is a garden and wants a map. Neither is wrong; a file should know which it is."
 one_law_per_frame: "a frame that mixes marks at its top level has no law to feel. Splitting it by mark is the same move as splitting a module by its reason to change."
}

^["numbers_and_math"]{
 # From the forms table in the journal. Two gaps, kept apart.
 the_number: "one token kind reads digits with a decimal part. A sign, an exponent, a unit, a percent, a date, a time and a version each split or err. A number should be one token whose shape says what it is, as a digit-led word should (p12)."
 the_scope: "^ * ~ = < are roles in Spw and operations in arithmetic. A dense formula needs a place where they are operations: a scope that says so, opened by the measure mark, inside which a line is read as arithmetic and outside which nothing changes."
 already_here: "a gap strands a vector, a semicolon stacks a matrix, a range has bounds, a frame carries an index, and seed's math module solves small systems. Dense notation can lean on structure Spw has before it borrows any symbol."
 symbols: "π, ∞, ∈ and ± are not lexed at all, and two of them drop a whole surface to prose. Reading them as words is a small change; giving them meaning is not needed for that."
 why_it_matters: "a physics written as a line needs numbers with signs, units and ranges. Without them a host keeps its constants in code, which is the complaint each canvas already makes."
}

^["ergonomics"]{
 # What would extend the language's philosophical value and make its concepts easier to hold.
 one_word_one_job: "register has six readings, valence five, frame four, the dot two, the equals two, the angle four. Each trial card is a homonym. A concept is easy to hold when its word has one job, or when a gap or a bracket says which job it is doing."
 honest_reading: "a reader that stops says where. A fallback that reports success teaches a writer to distrust the grammar."
 conservation: "every edit is a splice, every picture writes back, every reset changes no meaning. These are one law said three times, and it is the law that lets a line be shared."
 distance_shown: "how far a thing is, in hops, lines, marks or beats, is information a reader can act on. Showing it turns a corpus into a place."
 wonder_closes: "a question with a seat, a probe and three outcomes can end. A language that can end its own questions accumulates understanding and not only notes."
 hosts_as_readings: "a canvas, a guide and a story site are three readings of one line: as motion, as text, as a place. The philosophical claim is that meaning is what survives all three."
 charge_and_register: "the two changes of this day are that claim in small: valence is one thing, a charge sign, and a register is whatever the bracket cannot say. Each word now has one job to grow into."
}

^["falsify"]{
 neutrality_fails: "If a closed frame's inside must be felt outside for a picture to read, encapsulation by brace is the wrong unit and scope belongs to something else."
 depth_is_tilt: "If readers shown reach as depth find things no faster than on a plane with a list, the volume adds cost and no meaning."
 joints_and_sight_lines_merge: "If a host cannot make a binding and a reference feel different under a drag, the two rules are one rule with two names."
 scope_is_not_enough: "If formulas written in an arithmetic scope are still rewritten as strings by the people who need them, the gap is in the number or the symbols and not in the marks."
}

#>wonder_docs_theory_spw_depictionframes_1
?["When an uncharged node is dropped into a closed frame and removed, does every bound pair return to rest?"]{
 #:depth #!computational ~#lens(comparison)
 ~#hypothesis: "A canvas whose joints have a rest length returns to it; one whose layout is whatever heat left behind does not."
 ~#expect: "On the canvas host today a dropped node leaves parts displaced, since its layout seats pairs and its physics keep them closed without a rest length for a binding."
 !probe{ "headless: hold garden[care]{seed: water, sun}; record each pair's distance; add a bare node inside the body; settle; remove it; settle; compare distances" }
 $%[rest.returns, rest.drifts, rest.no_joint_to_measure]
}

#>wonder_docs_theory_spw_depictionframes_2
?["Does a reference feel different from a binding under a drag?"]{
 #:depth #!experiential ~#lens(comparison)
 ~#hypothesis: "Dragging a key carries its value; dragging one end of a reference stretches a line and moves nothing, and a reader can say which is which without being told."
 ~#expect: "Ties are drawn alike today; a tie pulls when both ends share a colour."
 !probe{ "show five readers two pairs, one bound and one referenced, unlabeled; let each drag one end; ask which pair belongs together" }
 $%[felt.different, felt.same, felt.reversed]
}

#>wonder_docs_theory_spw_depictionframes_3
?["How many number forms does a physics written as a line need before a host stops keeping constants in code?"]{
 #:depth #!syntax ~#lens(choice)
 ~#hypothesis: "Four: a sign, a unit, a range and an exponent. A date and a ratio are wanted by other writers and not by physics."
 ~#expect: "Of 42 forms probed, a sign errs, an exponent and a unit split silently, and a range reads."
 ~#probe(run)
 !probe{ "npm run -s analyze:trials -- --card number_forms" }
 $%[needs.four, needs.more, needs.a_scope_first]
}

#>wonder_docs_theory_spw_depictionframes_4
?["Is depth worth a third axis: does reach drawn as distance help a reader find a thing?"]{
 #:depth #!experiential ~#lens(projection)
 ~#hypothesis: "Depth helps when it means exactly one thing and hurts when it also means similarity."
 ~#expect: "No host draws reach today; one draws rings by a hyperbolic distance and prunes the deepest first."
 !probe{ "give a reader one held line and thirty surfaces at one to three hops; time finding a named one on a plane with a list, and in a scene where hops are depth" }
 $%[depth.faster, depth.no_difference, depth.slower]
}

#>wonder_docs_theory_spw_depictionframes_5
?["Which homonym costs a newcomer most?"]{
 #:depth #!pragmatics ~#lens(comparison)
 ~#hypothesis: "The equals, since it is the most written mark on one host and reads two ways by a gap."
 ~#expect: "The trial cards hold one homonym each; none has been ranked by confusions observed."
 ~#probe(run)
 !probe{ "npm run -s analyze:trials -- --parted" }
 $%[costliest.equals, costliest.dot, costliest.angle, costliest.other]
}
