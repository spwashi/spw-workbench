# Quality Annotations (BBBH Runtime Axis)
#
# BBBH is the four-state runtime quality quartet: boon, bane, bone, honk.
# bonk remains a catalytic valence overlay rather than a base runtime quality coordinate.
# @spw:contract:canonical[system=runtime-quality,basis=bbbh-axis-with-bonk-overlay]

#:layer #!semantics

^["roots"]{
 @src: ~"../src"
 @spec: ~"../lib/spw-v0.1.0-alpha"
 @here: ~"."
}

^["contract"]{
 runtime_quality: ["boon", "bane", "bone", "honk"]
 valence_overlay: "bonk is catalytic and remains outside the base runtime quality axis."
 timing: "BBBH names the measurable runtime quartet; timing passes may traverse it differently, and bonk can be layered as an overlay."
 falsify: "If runtime types promote bonk into the base quality axis, this file must be rewritten."
}

^["boon"]{
 # Materials Science: High ductility, low defect density, favorable thermodynamic state (annealed).
 # Learning Science: Germane cognitive load (effort that actively constructs schemas). Flow state.
 # Measurable Metrics:
 # - High test coverage
 # - Clean extensibility without breaking changes
 # - Predictable pure functions and stable domain types
 @src/core/domains/
 @src/core/conventions/
 @src/seed/
}

^["bane"]{
 # Materials Science: Fatigue, corrosion, stress concentrations, parasitic spontaneous reactions.
 # Learning Science: Extraneous cognitive load (effort wasted on noise and poor presentation).
 # Measurable Metrics:
 # - High file churn rate / Git hotspots
 # - Cyclic or tangled dependencies
 # - Fragmented, imperative, or side-effect-heavy logic
 @src/platform/bootstrap.ts # Split target: Too many responsibilities in one file
}

^["bone"]{
 # Materials Science: Stiffness, load-bearing capacity, yield strength, skeletal lattice.
 # Learning Science: Intrinsic cognitive load (effort required by the inherent complexity of the material).
 # Measurable Metrics:
 # - Foundational abstractions and interfaces
 # - High referential fan-out (many dependents) but low fan-in (few dependencies)
 # - Rarely changes, high penalty for refactoring
 @src/core/index.ts
 @src/infra/timing/index.ts
}

^["bonk_overlay"]{
 # Materials Science: Phase transition thresholds, brittle fracture mechanics (if this breaks, it shatters).
 # Learning Science: Threshold concepts or cognitive dissonance peaks (permanent alterations in understanding).
 # Measurable Metrics:
 # - High blast radius for any API change
 # - SemVer major bumps
 # - Type boundary crossings (e.g. parser to AST)
 # Overlay status: catalytic valence only, not part of the base runtime quality quartet.
 @src/core/domains/
 @src/seed/types.ts
}

^["honk"]{
 # Materials Science: Acoustic emission testing, detectable indicator states, fluorescence anomalies.
 # Learning Science: Orienting responses, salience cues, focus anchors.
 # Measurable Metrics:
 # - Warning logs, telemetry spikes
 # - Performance hotspots (measured by APM)
 # - Visual debugging overlays or `// @spw:todo` markers
 ~"../index.spw"
 @src/core/tally.ts
}

^["timing"]{
 # BBBH names the four-state runtime quality quartet.
 # Timing passes may emphasize different traversals through boon/bane/bone/honk.
 # bonk remains a catalytic overlay from the broader valence model.
 @src/infra/timing/bbbh-pass.ts
}

^["split"]{
 # Intersections of runtime Quality vs Valence
 @src/core/quality.ts
 @src/runtime/state/
}

#>wonder_docs_theory_spw_quality_1
?["How does this file's voice differ from index — spw/quality?"]{
  #:depth #!educational // lens: formal structure
  ~<"../index.spw"> ~#neighbor(nearest)
  $%[op.distribution]@here vs $%[op.distribution]../index.spw
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}

#>wonder_docs_theory_spw_quality_2
?["What invariant holds across every frame in Quality Annotations (BBBH Runtime Axis)?"]{
  #:depth #!experiential // lens: material grain
  $^["_"]@here => %[shared.property]
  ~#hypothesis: "all frames in this file share ____"
  !probe{ "extract the property common to roots's frames; if none exists, the file may lack cohesion or may be a deliberate collection." }
  $%[runtime.stage, runtime.queue_depth]
  ~<"docs/theory/spw/audio-architecture.spw"> ~#neighbor(nearest)
}
