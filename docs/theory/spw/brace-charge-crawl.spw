// Brace - charge - crawl
//
// Capturing/shielding braces; portable charge (value - subject - substrate);
// potentiation & vibration; labeled operators; channels; dialect projections;
// regional dialect + local id cache crawls with mutating lenses; crawl verbs.
//
// @see docs/theory/spw/reference-deref-geometry.spw
// @see docs/theory/spw/form-ladders.spw
// @see docs/theory/spw/valence-architecture.spw
// @see docs/theory/spw/syntax-profile-stack.spw
// @see docs/theory/spw/field-dynamics.spw
// @see .spw/biome/ocean/algos/cache.spw
// @see packages/spw-runtime/src/session/*

#:layer #!semantics
#:status #!proposed

^seed[Spw.Brace.Charge.Crawl v:0.1 @profile:Spw.b @intent:portable_field]

^["roots"]{
 @ref_deref: ~"./reference-deref-geometry.spw"
 @fixity: ~"./fixity-brace-phrases.spw"
 @form_ladders: ~"./form-ladders.spw"
 @valence: ~"./valence-architecture.spw"
 @stack: ~"./syntax-profile-stack.spw"
 @field: ~"./field-dynamics.spw"
 @cache: ~"../../../.spw/biome/ocean/algos/cache.spw"
 @session: ~"../../../packages/spw-runtime/src/session"
 @channels: ~"../../../packages/spw-runtime/src/session/channels.ts"
 @crawl: ~"../../../packages/spw-runtime/src/session/crawl.ts"
 @charge: ~"../../../packages/spw-runtime/src/session/charge.ts"
 @brace_physics: ~"../../../.spw/registries/brace-physics.spw"
 @bridge: ~"./charge-valence-brace-bridge.spw"
 @register_geometry: ~"./register-geometry.spw"
 @range_transform: ~"./range-transform.spw"
}

^["thesis"]{
 ~#claim: "Braces capture or shield charge; value/subject/substrate make charge portable across hosts; crawls are field maneuvers under a channel with a mutating lens at each depth-not neutral tree walks."
 ~#taste: "shape-first - channel-honest - biome-extensible - graduate experiment -> core"
 ~#law: "Projection differs by dialect; cache keys include dialectxchannelxlens; crawl verb names the charge motion (potentiate, accumulate, distribute, confluence, collate, discharge)."
}

^["ascii_lex"]{
 // Seed lexer accepts schedule ASCII (v0.3):
 //   ;   sequential connector (streams / CA pipelines)
 //   ||  parallel connector digraph
 //   #   + space  hash-prose line comment (narrative titles)
 // Structural # forms without space stay operators/particles/sets.
 note: "packages/spw-seed/src/lexer - profiles connectors + matchHashLineProse"
}

// ── 1. Braces: capture vs shield ───────────────────────────────

^["braces"]{
 law: "Paired boundaries are material shells. Capture *takes charge in*; shield *keeps charge out or in*."

 capture: .{
  sense: "inhabit + hold interior as addressable payload"
  forms: #[
   `[x]`          // frame select-capture
   `{x}`          // body material-capture
   `(x)`          // scope hold-capture
   `<<x>>`        // stream order-capture
   `?name:$atom`  // selector capture (query)
  ]
  silhouette: "interior occupancy rises empty -> inhabited"
  charge_effect: "binds charge to interior locus"
 }

 shield: .{
  sense: "membrane / ceiling / channel wall - isolates effect grade"
  forms: #[
   `<tag>{...}`     // capsule membrane
   `=ceiling[l0]` // effect shield (Spw.x / flow)
   `@dialect:...`   // dialect shield (metasyntax region)
   `=channel[...]`  // stability channel wall (proposed)
   `//` prose / `#:` layers as soft shields in authoring
  ]
  silhouette: "shell tag or metasyntax mark outside interior"
  charge_effect: "limits which crawl/effect may cross"
 }

 dual: .{
  note: "Same Bound kind can capture *and* shield depending on occupancy + meta"
  example: "`{}` empty shields void; `{ charge }` captures material"
  form_ladder: "empty(shield-void) -> inhabit(capture) -> label -> path/ref -> fold"
 }

 ports: .{
  open: "capture aperture (ingress)"
  close: "shield seal (egress control)"
  medial: "charge flow along couple/path"
 }
}

// ── 2. Portable charge: value - subject - substrate ────────────

^["charge"]{
 // Valence is quality of material (boon/bane/bone/bonk/honk) - charge-neutral labels.
 // Here *charge* means portable field quantity: what moves under crawl verbs.

 carriers: .{
  value: .{
   mark: `*` | RuntimeValue
   role: "collapsed product - portable packet"
   portability: "high across hosts if schema disclosed"
   cache: "hot when focus; key includes contentHash"
  }
  subject: .{
   mark: `$` | focus | SelectionIR uri
   role: "addressed locus - who/what the field is about"
   portability: "medium - needs root/mount resolve"
   cache: "warm; invalidate on path move"
  }
  substrate: .{
   mark: `$` reg | Substrate event log | RegisterBank
   role: "processing surface - where events and resonance live"
   portability: "low unless snapshot/precipitate sealed"
   cache: "session-local; BeatCache tiers"
  }
 }

 make_portable: #[
  "value: crystallize (*) stream window -> sealed Spw.l/x record"
  "subject: pathref ~\"...\" + @root bind under ConsumerContext"
  "substrate: precipitateToSpw / EnvelopeIR / KbIR export"
 ]

 charge_states: #[
  latent      // not yet pointed
  potentiated // primed (see §3)
  bound       // captured in brace
  mobile      // following path / crawl
  discharged  // written, measured, or folded
  shielded    // channel forbids motion
 ]

 law: "Portability without subject+substrate provenance is a leaky packet."
}

// ── 2b. Accounting: where charge sits (operand, inner, overlap) ─

^["accounting"]{
 status: proposed
 law: "Charge needs a *where*, not just a *what-state* - naming vocabulary that already exists elsewhere, no new glyphs."

 operand_vs_inner: .{
  operator_ports: "before_operator, operand, after_operator (brace-physics.spw coupling_extension) - Act-relative"
  boundary_ports: "before_open, open_boundary, inside, close_boundary, after_close (same block) - Bound-relative"
  named_regions: "inner|around|scope|capsule|stream|range (register-geometry.spw empty_forms) - identity-relative"
  law: "one locus carries a value at all three simultaneously - views, not competing addresses"
 }

 overlap: .{
  status: "gap - not addressed anywhere in the corpus"
  missing: "register-geometry + range-transform model nesting and disjoint spans, never overlap-without-containment"
  hypothesis: "paired-boundary grammar likely forbids it for raw Bound spans; derived regions (two ResonanceIR feature windows, two AttentionIR trails) could still overlap - unverified, see ?[overlap_regions]"
 }

 particle_locus: .{
  particle: "the token itself - <stance>#<aim>name (types/ast/nodes.ts); #:layer and #>anchor are both Particle, distinguished by aim"
  anchor: "the bookmark a deixis particle (aim='>') leaves - #>id is a particle, the id it names becomes an anchor"
  accounting_gap: "ChargeProvenance has no particle-level field - coarser than 'which #>anchor produced this', see ?[particle_accounting]"
 }
}

// ── 3. Potentiation and vibration ──────────────────────────────

^["potentiation"]{
 ~ : "potential / path / defer - classical potentiation glyph"
 ? : "wonder / probe - epistemic potentiation"
 =bias : "axis preference - directional potentiation"

 sense: "raise readiness of a locus without full discharge"
 forms: #[
  `~"path"`           // path potential
  `?probe{...}`         // wonder heat
  `=[axis] a { b }`   // bias pole
  AttentionIR seed    // crawl prior
 ]

 vibration: .{
  sense: "frequency of write/access - runtime field (Hz metaphor)"
  runtime: "Register frequency window; BeatCache promote on hits"
  shape: "hot trail along S-lattice (AttentionIR)"
  relation: "potentiation raises amplitude; vibration is observed rate"
 }

 dual: "potentiate (arm) vs vibrate (measure) - do not collapse into one verb"

 ex_nihilo_check: .{
  feeling: "an empty Bound reads as creation from nothing - first mark in a fresh {}"
  correction: "not literally nothing - register-geometry.spw's law says a Bound keeps its register identity (inner|around|scope|capsule|stream|range) through empty occupancy; charge_states.latent is a real state, not an absent one. It's potential resolving to actual, same as empty -> inhabit, never nothing -> something."
  law: "keep the feeling as pedagogy; correct the physics under it"
 }
}

// ── 4. Operators with labels ───────────────────────────────────

^["labeled_ops"]{
 law: "Operator silhouette stays the Act; label is aperture enrichment (form geometry ingress.operator_label)."

 forms: #[
  `!boon{...}`     // action + valence label
  `*boon{...}`     // collapse + quality
  `?~`           // probe+potential digraph (ocean trial)
  `^["name"]`    // integrate + frame label
  `=φ[ id: soft ]` // config + named profile
 ]

 literacy: "label does not change operator kind - only enriches meta (valence, reg, semanticFrames)"
 channel: "trial labels may be channel-gated; stable channel soft-lints unknown labels"
 crawl: "labels seed lens mutations (e.g. !boon prefers growth poles)"
}

// ── 5. Channels ────────────────────────────────────────────────

^["channels"]{
 // Stability / effect / consumer walls - orthogonal to dialect id.

 ids: #[ stable , trial , draft , live , experimental , consumer , ocean ]

 fields: .{
  allowDialects: "which Spw.* may parse under channel"
  allowCrawlVerbs: "which charge motions permitted"
  effectCeiling: "l0 plan ... l2 host"
  cacheDefaultTier: "hot|warm|cold"
  graduate: "path for experiment -> core"
 }

 relation_to_braces: "channel is a *shield* at session/file scale; Bound shields at form scale"
 relation_to_charge: "channel decides if charge may discharge to host"
 relation_to_dialect: "dialect = geometry; channel = permission"
 key: "cacheKey({ dialect, channel, fileHash, lens })"
}

// ── 6. Dialect projections (perf) ──────────────────────────────

^["projections"]{
 law: "Same IR, different *views* and *preprocess cost* per dialect."

 table: #[
  .{ d: Spw.b , proj: "sparse block" , cost: "baseline lex/parse" , cache: warm }
  .{ d: Spw.l , proj: "line-collapsed" , cost: "preprocess newlineAsSpace" , cache: hot packs }
  .{ d: Spw.q , proj: "selector AST" , cost: "high-context sugar" , cache: hot select }
  .{ d: Spw.m , proj: "ONF-lean" , cost: "machineLint pass" , cache: cold CI }
  .{ d: Spw.x , proj: "hot live" , cost: "ceilings+measure" , cache: hot session }
  .{ d: Spw.f , proj: "flow glyphs" , cost: "flowGlyph scan" , cache: trial }
  .{ d: Spw.p , proj: "stream lines" , cost: "planStream" , cache: warm plans }
  .{ d: Spw.t , proj: "template" , cost: "expand later" , cache: cold }
  .{ d: Spw.o , proj: "ocean dense regional" , cost: "biome-local; not core" , cache: cold ocean }
 ]

 perf_rules: #[
  "preprocess is part of cache key (dialect)"
  "projection view must not claim parse equivalence across dialects without receipt"
  "regional Spw.o never shadows Spw.b without channel=ocean|experimental"
  "mutating lens at crawl depth re-keys local id cache - never reuse wrong lens"
 ]
}

// ── 7. Regional dialect + local identifier cache crawl ─────────

^["regional"]{
 regional_dialect: .{
  sense: "biome- or consumer-scoped geometry (ocean Spw.o, consumer packs)"
  law: "graduates to core dialect id only with probe evidence + episode"
  scope: ".spw/biome/** or consumer .spw/biome/**"
 }

 local_id_cache: .{
  sense: "identifier -> locus map for a crawl region"
  key: "#{ region, dialect, channel, lensId, contentHash }"
  invalidate: "hash prefix + lens change + channel change"
 }

 mutating_lens: .{
  sense: "at each crawl depth, lens may change what 'id' means"
  levels: #[
   file     // surface stack lens
   frame    // selection lens
   body     // material lens
   reg      // substrate lens
   graph    // ego / hub lens
  ]
  law: "lens mutation is disclosed in CrawlIR step; silent lens = bug"
 }

 crawl_loop: |
  attend(seed)
  -> open channel
  -> for depth in path:
       lens := mutate_lens(depth, labels, bias)
       ids  := local_id_cache.get_or_build(region, lens)
       charge := apply_verb(verb, charge, ids)
       CacheIR.set(key(dialect,channel,lens), ...)
  -> project Envelope under dialect projection
}

// ── 8. Crawl verbs (charge motion) ─────────────────────────────

^["crawl_verbs"]{
 potentiate: .{
  glyph_hint: `~` | `?`
  motion: "prime without write"
  use: "warm pathRefs; seed AttentionIR; open probes"
 }
 accumulate: .{
  glyph_hint: `^` | `#[]`
  motion: "gather charge into set/buffer"
  use: "census table; stream window; mass claims"
 }
 distribute: .{
  glyph_hint: `!` | path out-edges
  motion: "send charge along out-edges / emits"
  use: "broadcast roots; fan-out measure"
 }
 confluence: .{
  glyph_hint: `&`
  motion: "merge streams of charge"
  use: "multi-root join; &[@a,@b] idiom"
 }
 collate: .{
  glyph_hint: `.` | facet
  motion: "order and index without merging identity"
  use: "KbIR build; dialect histogram; sort census"
 }
 discharge: .{
  glyph_hint: `*` | `%` write
  motion: "collapse or measure write under ceiling"
  use: "crystallize; mass --write; host apply"
 }

 composition: "verbs compose on StreamIR/SelectionIR; channel may forbid discharge"
 falsify: "crawl that claims confluence but only lists paths without & or join receipt"
}

// ── 8b. Fixity - brace phrases - optimizable grammar ───────────

^["fixity_phrases"]{
 @theory: ~"./fixity-brace-phrases.spw"
 law: "Fixity = Act placement on Bound; brace phrase = stable ActxBound silhouette; optimizable iff schemaxfixityxmeasurexrewritexcache."

 fixity_charge: .{
  prefix: "potentiate / arm before capture — form +{ }"
  postfix: "discharge after inhabit (pipeline stitch) — form { }+"
  membrane: "shield ports"
  infix: "confluence / path between poles (gated)"
  em: ~"./em-fixity-association.spw"
  law: "fixity is association geometry, not Bound open/close polarity and not ChargeState"
 }

 phrase_crawl: .{
  collate: "index phrase families (FormIR fingerprint)"
  accumulate: "phrase bank / materials[]"
  distribute: "emit packs / dialect projection"
  discharge: "graduate to catalog or seed law"
 }

 opt: "see fixity-brace-phrases ^optimize - OptCacheIR key includes fixity"
}

// ── 9. Syntax development preparation ──────────────────────────

^["syntax_dev"]{
 runway: #[
  "1. silhouette sketch in theory (this file + ref-deref + fixity-phrases)"
  "2. =exp[ id ] catalog entry (proposed, hook=none|lint|parse|lower)"
  "3. ocean/biome trial under channel=experimental"
  "4. dual-read AST + geometry inspect + fixity stamp"
  "5. dialect projection + perf key in cache"
  "6. partial runtime (session channel, crawl verb enum, phrase opt sketch)"
  "7. graduate to seed parse only with status->partial + tests"
 ]

 experiments_now: #[
  brace.capture_vs_shield
  charge.portable_triple
  crawl.verb_set
  channel.stability
  dialect.projection_cost
  regional.ocean_o
  lens.mutating_depth
  op.labeled_aperture
  fixity.prefix_postfix_dual
  phrase.brace_family
  phrase.opt_cache
 ]
}

// ── 10. Runtime enhancements (greenfield hooks) ────────────────

^["runtime"]{
 modules: #[
  "packages/spw-runtime/src/session/channels.ts"
  "packages/spw-runtime/src/session/charge.ts"
  "packages/spw-runtime/src/session/crawl.ts"
 ]
 behaviors: #[
  "StabilityChannel policy map"
  "ChargeCarrier value|subject|substrate"
  "CrawlVerb + CrawlStep lens disclosure"
  "cacheKey includes channel + lens"
  "ConsumerContext roots for subject resolve"
 ]
 not_yet: "full interpreter rewrite - session is the seam"
}

// ── 11. Biome consumer extensibility ───────────────────────────

^["biome"]{
 problem: "ocean is workbench-local experimental mass; consumers need extensible biomes without forking core"
 remodel: #{
  contract: ".spw/biome/index.spw - biome registry + channel + graduate rules"
  ocean: "reference experimental biome (Spw.o regional)"
  consumer: "consumer may mount .spw/biome/<name>/ with same module shape"
  core: "stable features graduate to packages/* + lib/spw-v*"
 }
 modules_shape: #[ intent , modules , algorithms , query , experiments , runtime ]
 cache_strategy: "layout/algo warm; expr/query hot; experiments cold - per ocean index"
 law: "consumer biome never writes workbench infrastructure; channel=consumer"
}

^["falsify"]{
 #[
  "capture brace treated as always shield"
  "value exported without subject/substrate provenance"
  "potentiation claimed after discharge"
  "operator label changes Act kind in tooling"
  "channel omitted from cache key"
  "dialect projection claims free equivalence"
  "crawl reuses local id cache across lens mutations"
  "ocean Spw.o treated as core dialect without channel"
  "consumer biome imports @/ workbench paths"
 ]
}

// ── Worked examples ────────────────────────────────────────────

^["examples"]{
 capture_vs_shield: |
  // capture - inhabit
  { charge: mobile }
  [ select_me ]
  << a ; b ; c >>
  // shield - membrane / channel / ceiling
  <tag>{ interior }
  =ceiling[ l0 ]
  @dialect:Spw.x

 portable_charge: |
  // value packet with provenance (not leaky)
  *{ =id[snap] , $: ~"mod.spw" , d: Spw.b , ch: trial }
  // subject address
  $~"mod.spw"
  // substrate - session id (runtime HotRuntimeSession)

 crawl_schedule: |
  // sequential CA / stream schedule (lexer: ; and ||)
  << ~ ; ? ; % ; ! ; * ; ^ >>
  << prep ; ( a || b ) ; seal >>

 crawl_verbs_story: |
  // potentiate: warm pathRefs without write
  // accumulate: census table / stream window
  // distribute: fan-out along out-edges
  // confluence: &[@a, @b]
  // collate: sort / index without merge
  // discharge: crystallize or measure --write under ceiling

 channel_gate: |
  // stable: no Spw.o
  // experimental|ocean: regional nursery ok
  // live: hot tier, Spw.x preferred
  // consumer: mount authority, no workbench write

 hot_session: |
  // prepareSource then HotRuntimeSession.evaluate
  // cache key: hash x dialect x channel
}

^["decisions"]{
 // Grounded against source, not folklore. Proposed until repeated in a
 // canonical contract (runtime-foundation.spw's own falsify rule).

 valence_vs_charge: .{
  q: "valence (quality) vs charge (portable field) - how to teach without collision?"
  a: "name the collision, don't paper over it - three distinct 'charge' senses live in this corpus; disambiguate on sight by which one's active."
  senses: #[
   "(1) portable field quantity - value|subject|substrate, this file, real types in charge.ts"
   "(2) per-container open/close polarity metaphor - brace-physics.spw charge_table, #!interpretive"
   "(3) valence-as-electron-charge metaphor - valence-architecture.spw + brace-physics.spw valence_composition ('sum of valence markers')"
  ]
  because: "this file's own law already draws the line - valence is charge-neutral quality, charge here is what moves under crawl verbs; only (1) has load-bearing types, (2)/(3) are self-declared metaphor"
  cite: ~"../../../.spw/registries/brace-physics.spw"
 }

 discharge_l0: .{
  q: "is crystallize to Spw.l record l0 measure or l1 memory?"
  a: "l1.memory - crystallize produces a new sealed in-memory value (bound -> discharged), not a report on existing state."
  because: "mutation-automata.spw: l0.measure never rewrites returned source, l1.memory is in-memory apply of a differential; crystallize is exactly that - a new artifact exists after the call"
  cite: ~"./mutation-automata.spw"
 }

 soft_resonance: .{
  q: "should soft resonance edges enter GraphIR, or stay ResonanceIR-only?"
  a: "stay ResonanceIR-only - promotion into GraphIR needs an explicit graduate step, same discipline as regional dialect graduation, never a silent merge."
  because: "geometric-resonance.ts only edges among uris already in the caller's selection, never invents one; letting soft edges leak into GraphIR repeats this file's own falsify entry on English paths without ~"
  cite: ~"./reference-deref-geometry.spw"
 }
}

^["open"]{
 ?[capture_default]: "Is empty Bound always shield-void, or sometimes latent capture?"
 ?[vibration_measure]: "Is vibration only runtime frequency, or also AttentionIR trail?"
 ?[crawl_compose]: "May two crawl verbs compose on one SelectionIR pass, or always one verb per plan?"
 ?[lens_mute]: "Who may mutate lens mid-crawl - human only, or probe heat?"
 ?[biome_module]: "Minimum modules_shape for consumer biome graduate?"
 ?[line_charge_bridge]: "tension_gradient's line-span rhythm is a separate interpretive axis from this file's charge - ever bridge them, or stay orthogonal on purpose?"
 ?[overlap_regions]: "register-geometry + range-transform model nesting and disjoint spans - is overlap-without-containment a real case here, or does paired-boundary law forbid it by construction?"
 ?[particle_accounting]: "would per-particle charge accounting (which #>anchor discharged which value) be worth the bookkeeping, or does substrate-level provenance already cover it?"
}

#>wonder_brace_charge_1
?["Where does capture become shield without changing Bound kind?"]{
  #:depth #!semantics
  !probe{ =id[p_cap_shield] }
  $%[occupancy, metasyntax, channel]
}

#>wonder_brace_charge_2
?["Can a leaky value packet ever be honest on a consumer mount?"]{
  #:depth #!pragmatics
  !probe{ =id[p_leaky] }
  $%[portability, provenance]
}

#>wonder_brace_charge_3
?["What fails first when channel is omitted from cache key?"]{
  #:depth #!computational
  !probe{ =id[p_cache_key] }
  $%[correctness, thrash]
}
