#>pattern_ecology_tooling
^seed[Spw.Pattern.Ecology.Tooling v:0.1 @profile:Spw.b @intent:future_tooling_map]

^["metaphor_gate"]{
 law: "unit cell, lattice, spectrum, mask, doping, band gap, photolithography are interpretive labels for tooling UX"
 refuse: "physical force claims without declared instruments"
 maps: .{
  unit_cell: "apposition envelope or pattern hole site"
  lattice: "ordered cells on a surface revision"
  spectrum: "population census by name/class"
  mask: "content hash of envelope for transfer/reuse"
  doping: "intentional local deviation (comment interstitial, remask)"
  band_gap: "declared non-propagation (channel refuse, layout gate)"
  photolithography: "template pattern transfer under trial channel"
  substrate: "source revision / session id"
 }
}

^["shipped"]{
 lattice_cli: "spw lattice | readings — apposition spectrum"
 scanAppositions: "parse-free unit cells + mask + lattice delta"
}

^["next"]{
 comment_interstitial: "classify // and #; promote to unit cells or strip"
 combinator_skeleton_index: "phrase/sigil×brace postings"
 change_report: "lex/ast delta for stale readings"
 mutate_mask: "pulse rules that rewrite by mask/handle not only bytes"
 pattern_catalog_ecology: "capture / find / apply / retire"
 photolithography_apply: "template instantiate → ChangeReport → ceiling"
}

^["cli_sense_path"]{
