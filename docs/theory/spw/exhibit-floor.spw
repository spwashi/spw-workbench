# Exhibit Floor
#
# What a children's museum floor teaches interactive models and intermediate forms.
# From the owner's account (2026-11-08): volunteering on such a floor during high school, they reset
# exhibits between visitors and cleaned their parts, watched how children play, tried the exhibits'
# physics as a student, and noticed light, texture and art. Each vantage is a reading of the same floor.
#
# @see docs/theory/spw/representational-disclosure.spw
# @see docs/theory/spw/semantics-physics.spw
# @see .agents/plans/interpretation-trials/interpretation-trials.spw

#>exhibit_floor
#:layer #!semantics
#:status #!seeded

^["contract"]{
 exploratory: "A theory notebook of readings, not runtime or parser law; a claim here binds only once a runtime or parser contract repeats it."
 trials: "Readings that would change how a mark is read are held as trial cards in interpretation-trials before any plan acts on them."
 privacy: "The floor is named by its role. Personal history beyond the owner's account stays on the owner's own site."
}

^["roots"]{
 @disclosure: ~"./representational-disclosure.spw"
 @physics: ~"./semantics-physics.spw"
 @materials: ~"./materials-ontology.spw"
 @ladders: ~"./form-ladders.spw"
 @onf: ~"./onf.spw"
 @learn: ~"../../learn/index.spw"
 @trials: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw"
 @line_kit: ~"../../../.agents/plans/line-kit/wip.spw"
 @receipts: ~"../../../.agents/plans/host-receipts/wip.spw"
 @sockets: ~"../../../.spw/caches/journal/2026-11-08-extension-sockets.spw"
}

^["thesis"]{
 ~#claim: "An interactive model is an exhibit: it is learned by touch before it is named, it returns to rest for the next visitor, and its intermediate forms are the parts a hand can move."
 ~#law: "A reset changes no meaning. A touch answers once, where it is seen. A part that cannot be reset cannot be shared."
 ~#refuse: #[
  "an exhibit that explains before it responds",
  "a reset that erases a visitor's work instead of returning the floor to rest",
  "motion that marks no change",
 ]
}

^["vantages"]{
 // Four ways of standing on one floor. Each reads as a claim about Spw hosts, held as a reading.
 steward: .{
  act: "reset exhibits between visitors and clean their parts"
  sees: "the rest state, the residue play leaves, and which parts wear or go missing"
  reads_as: "a line's rest state is the form tools return it to; formatting and write-back are the reset, and a reset that moves a reading is a broken exhibit"
  ties: #[reading-drift line_reading_fingerprint, line-kit kit_laws, wonder_trial_rest_state]
  status: reading
 }
 observer: .{
  act: "watch how children play"
  sees: "repeated patterns of action, unexpected uses, play beside and with others, and an adult who joins instead of directing"
  reads_as: "a host learns what its marks afford from what people do with them, not from their labels; a receipt counts use on the floor"
  ties: #[host-receipts, wonder_trial_play_schemas, wonder_trial_guided_wonder]
  status: reading
 }
 participant: .{
  act: "try the exhibits' physics as a student"
  sees: "gravity on a ramp, flow in a channel, pressure in a tube, learned by changing one thing and watching"
  reads_as: "an intermediate form teaches when a change to it answers at once, answers the same way each time, and can be undone"
  ties: #[exhibit_physics, wonder_trial_intermediate_forms, wonder_trial_stages]
  status: reading
 }
 noticer: .{
  act: "notice light, texture and art"
  sees: "light through colored pegs and bubble film, surfaces worn by hands and cleaned again, children's work shown on a wall"
  reads_as: "light is attention (what is lit is in focus), texture is material (how a surface has been handled), and art is authorship (a visitor's line kept and shown)"
  ties: #[spatial-model focal_hierarchy, valence as material quality, wonder_trial_register voice]
  status: reading
 }
}

^["exhibit_physics"]{
 // What an exhibit's physics asks of any interactive model, and where Spw already answers.
 immediate: .{ law: "the response arrives within the touch, so cause and effect stay one event", spw: "a slot edit returns its new reading in the same call (line-kit slot_edits)" }
 consistent: .{ law: "the same act gives the same response, so a guess can be tested", spw: "one line reads the same in every host (brace-slot-reading, trial_bench)" }
 reversible: .{ law: "every act can be undone and the floor set again, so trying costs nothing", spw: "write-back identity and one-span edits (line-kit kit_laws)" }
 conserved: .{ law: "what goes in comes out (water, balls, bytes), so a child can follow it", spw: "a canvas edit keeps every byte but the one place changed" }
 legible: .{ law: "the mechanism is seen or felt, not hidden behind a label", spw: "source products at three depths, opened on request (inspect --through)" }
 open_ended: .{ law: "no single right answer; the exhibit invites the next move instead of a finish", spw: "an open question stays a value and its options stay in view until one is taken" }
}

^["intermediate_forms"]{
 claim: "An exhibit is an intermediate form: not the river and not the textbook, but a channel a hand can dam. Spw's intermediate forms (tokens, slots, features, trace, normal form) earn their place the same way, when a person can move a part and watch the reading change."
 label_after: "The label card comes after the touch: a host names a reading after the reader has moved it, not before."
 rest_as_example: "A floor set for the next visitor is a worked example; a faded example leaves one part out and invites the visitor to place it, as a hole does in a line."
 steward_view: "What a steward sees between visitors is a disclosure layer of its own: what moved, what is unread, what wore. Residue is a receipt."
 normal_form: "Normal form already keeps how a node was built ([reg=construction], [reg=proj], [reg=hydrate]), the way a reset exhibit keeps its design while its parts move."
}

^["play_schemas"]{
 // A reading to test (wonder_trial_play_schemas), not a claim. Schemas after Athey (1990), building on Piaget.
 source: "Early-childhood educators describe repeated patterns of action through which children build concepts: trajectory, transporting, enclosing, enveloping, connecting, positioning, rotating, transforming."
 trajectory: "connectors and flows (->, ~>), as a ball takes a ramp"
 transporting: "a line carried between hosts by its address (#spw64=)"
 enclosing: "the containers { } [ ] ( ) < > around a word"
 enveloping: "a capsule or frame that wraps a whole reading"
 connecting: "joins and bonds between lines"
 positioning: "slot order: a pair before or after its word"
 transforming: "operators that change a state: ~ primes, ! actualizes, ^ integrates"
 rotating: "one line turned through several readings (stages)"
}

^["learners"]{
 // Pedagogy and andragogy on one floor. Linked from docs/learn.
 children: "Play is the foundation, and the adult partner joins instead of directing; a host for a first visit answers a touch before it offers a word."
 teens: "A volunteer learns by stewarding: resetting, greeting, noticing. Service hours give a reason, and the floor gives the problem."
 adults: "Andragogy (Knowles): experience is the material, problems come before subjects, learners steer, and reasons are their own. A newcomer to Spw is usually an adult with a project, so a doorway starts from their problem."
 rubric: "Self-determination (autonomy, competence, relatedness) checks a doorway: can a newcomer act alone, succeed, and build with someone else? (journal 2026-11-08 friend_test)"
}

^["community"]{
 claim: "A municipality can keep what one person cannot: a floor, a schedule and a public. Park districts, public libraries and children's museums give play and practice a place that is set again each day."
 lessons: #[
  "children: exhibits, story times, nature programs and field trips, with an adult beside them",
  "teens: volunteer hours, junior roles and service learning, where keeping a place is the lesson",
  "adults: workshops, open labs, boards and public meetings, mentoring, and the volunteering that keeps the rest running",
 ]
 spw: "A lesson written as a line can be held, carried and repeated across hosts; a civic program is a host with a calendar and a public. Which lessons a civic host could carry as lines is an open question for the quest."
}

^["falsify"]{
 #[
  "formatting or write-back moves a line's reading",
  "readers learn a mark as well when a host explains it before they can move it",
  "a touch answers twice, or out of view",
  "the play-schema mapping predicts no order a trial can check",
  "motion is spent where nothing changed",
 ]
}

#>wonder_docs_theory_spw_exhibitfloor_1
?["What does a host's floor look like between visitors?"]{
  interprets: objective
  considers: #[rest_state, residue, wear]
  surfaces: #[lsp, canvas, cli]
  run: "after a session, list what moved, what reads as prose, and which parts were touched most"
  !probe{ "format every touched line; no reading fingerprint may move." }
}

#>wonder_docs_theory_spw_exhibitfloor_2
?["Which mark does a newcomer reach for first, and is it a schema?"]{
  interprets: mixed
  considers: #[first_mark, schema_order, quest_sessions]
  surfaces: #[quest, canvas]
  run: "count the first mark each newcomer writes in a quest session and compare with play-schema order"
  !probe{ "if first marks follow no schema order, play_schemas stays a gloss." }
}
