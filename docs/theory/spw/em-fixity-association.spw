# Electromagnetic Fixity · Brace Association
#
# Interpretive field model for Act×Bound placement. Canonical law remains
# coupling actPlacement (prefix|postfix|interior|membrane|none) — not Maxwell.
#
# Pedagogical dual:
#   +{ }   prefix Act — source leads, Bound captures
#   { }+   postfix Act — Bound leads, Act associates after inhabit
#
# Status: interpretive profile over measured structure (actPlacement / ONF).
# Does not implement EM in runtime. Does not rename operational ChargePacket.
#
# @see docs/theory/spw/fixity-brace-phrases.spw
# @see docs/theory/spw/charge-valence-brace-bridge.spw
# @see docs/theory/spw/brace-charge-crawl.spw
# @see .spw/registries/brace-physics.spw
# @see packages/spw-seed/src/types/coupling.ts  ActPlacement

#:layer #!semantics
#:status #!proposed

#>em_fixity_association
^seed[Spw.Theory.EM.Fixity.Association v:0.1 @profile:Spw.b @intent:fixity_as_brace_association]

^["roots"]{
 @fixity: ~"./fixity-brace-phrases.spw"
 @bridge: ~"./charge-valence-brace-bridge.spw"
 @charge_crawl: ~"./brace-charge-crawl.spw"
 @brace_physics: ~"../../../.spw/registries/brace-physics.spw"
 @op_brace: ~"./operator-brace-composition.spw"
 @coupling: ~"../../../packages/spw-seed/src/types/coupling.ts"
 @normalize: ~"../../../packages/spw-seed/src/normalize.ts"
 @phrases: ~"../../../packages/spw-runtime/src/session/phrases.ts"
}

// ═══════════════════════════════════════════════════════════════
// Thesis
// ═══════════════════════════════════════════════════════════════

^["thesis"]{
 ~#claim: "Fixity is the association geometry of an Act relative to a Bound — how the operator couples to the shell — not a second kind of charge and not left/right grammar."
 ~#taste: "prefix-honest today; postfix as dual literacy; EM as silhouette language"
 ~#law: "prefix/postfix/interior/membrane are canonical; left/right and E/B diagrams are render profiles only."
 ~#glyph: "+ stands for any Act ( ! ^ ~ * = @ # . & $ % and labeled forms ); { } stands for any Bound body (also [] () <> <<>> (()) )."
}

// ═══════════════════════════════════════════════════════════════
// Electromagnetic reading (interpretive)
// ═══════════════════════════════════════════════════════════════

^["em_map"]{
 status: interpretive
 gate: "metaphor for literacy and dual-read; instruments must still stamp actPlacement"

 bound_as_structure: .{
  body: "{} — cavity / capacitance volume — holds interior occupancy"
  frame: "[] — selection aperture / pin"
  scope: "() — flow cup / soft containment"
  capsule: "<…> — membrane / interface channel"
  stream: "<<>> — guided path / waveguide"
  note: "Bound kind is structure (coupling.kind); EM labels are profile"
 }

 act_as_drive: .{
  sense: "Act is the driven association — current / source term that orients the field around a Bound"
  not: "not operational ChargePacket by itself; packet may *ride* after collapse"
 }

 open_close_polarity: .{
  // from brace-physics port polarity — orthogonal to fixity
  open: "accumulate / tension port — ingress"
  close: "seal / release port — egress"
  law: "open/close is Bound-internal polarity; fixity is Act–Bound external association"
 }

 valence_as_medium: .{
  // dielectric / material quality — not free charge
  sense: "boon/bane/bone/bonk/honk shape *how* the association feels (ε of material), not which fixity applies"
  law: "valence multiplies quality of disclosure; fixity orients association"
 }
}

// ═══════════════════════════════════════════════════════════════
// Core dual: +{ } vs { }+
// ═══════════════════════════════════════════════════════════════

^["association_dual"]{
 // Primary literacy pair. Status of grammar ≠ status of dual-read claim.

 prefix: .{
  form: `+{ }`   // e.g. !{}  *{}  ^["n"]{}  ~#cell: …
  placement: prefix
  em_read: "source leads — drive applied before volume is fully inhabited"
  field: "Act orients capture; Bound opens already under that orientation"
  charge_crawl: "potentiate / arm before capture (brace-charge fixity_charge.prefix)"
  operational: "Act owns Bound product; ONF often stamps actPlacement=prefix (normalize)"
  status: implemented_primary
  examples: #[`![]`, `*{…}`, `^["n"]{}`, `?{…}`, `~"p"`]
  dual_read: "point · arm · seed intent · authoring default"
 }

 postfix: .{
  form: `{ }+`   // e.g. data~  x!  {}!  []! (when owned as postfix)
  placement: postfix
  em_read: "volume leads — inhabit first, then induced association / stitch"
  field: "Bound holds material; Act closes pipeline or discharges after"
  charge_crawl: "discharge after inhabit / pipeline stitch (fixity_charge.postfix)"
  operational: "today often sequence juxtaposition; Operation.position=postfix proposed"
  status: partial_proposed
  examples: #[`data~`, `x!`, `.!` / `.?` equiv_dot_postfix]
  dual_read: "follow · stitch · subject-first · pipeline feel"
  assoc: "left-to-right chains: x~! ≈ !(~(x)) under declared assoc (fixity dual)"
 }

 literacy: .{
  rule: "fixity must stay silhouette-visible — invisible default kills dual-read"
  refuse: "treating +{ } and { }+ as the same product without placement stamp"
  refuse_em: "claiming different Maxwell force laws in the evaluator"
 }
}

// ═══════════════════════════════════════════════════════════════
// Full fixity as association classes
// ═══════════════════════════════════════════════════════════════

^["fixity_classes"]{
 // Aligns ActPlacement — EM column is interpretive only.

 prefix: .{
  placement: prefix
  association: "Act → Bound (drive then shell)"
  em: "series source before capacitance"
  silhouette: `+[]` `+{}` `+()`
 }

 postfix: .{
  placement: postfix
  association: "Bound → Act (shell then drive)"
  em: "capacitance then induced current / load"
  silhouette: `[]+` `{}+` `()+`
 }

 interior: .{
  placement: interior
  association: "Act ∈ Bound payload"
  em: "source embedded in volume — free charge *inside* cavity"
  silhouette: `[+]` `{+}` (Act as material, not aperture)
  status: implemented_structural
 }

 membrane: .{
  placement: membrane
  association: "Act on Bound interface (capsule / medial)"
  em: "surface current / interface condition"
  silhouette: capsule tag, medial `left<ch>right`
  status: implemented_partial
 }

 infix: .{
  placement: none // conceptual until owned
  association: "Act between two poles"
  em: "transmission line / couple between terminals"
  silhouette: `a & b` `a / b` `<>[a,b]`
  status: proposed_dialect_gated
 }

 none: .{
  placement: none
  association: "bare Bound or bare Act seed"
  em: "unassembled parts — no dipole yet"
 }
}

// ═══════════════════════════════════════════════════════════════
// Relation to operational charge (do not merge)
// ═══════════════════════════════════════════════════════════════

^["with_operational_charge"]{
 // ChargePacket states are field *quantity* motion; fixity is *geometry*.

 table: #[
  .{ fixity: prefix,  charge_hint: "potentiate then bind — latent→potentiated→bound under capture" }
  .{ fixity: postfix, charge_hint: "bind then mobile/discharged stitch — bound→mobile→discharged" }
  .{ fixity: interior, charge_hint: "Act as payload value inside Bound" }
  .{ fixity: membrane, charge_hint: "shielded or port-limited motion" }
 ]

 law: "fixity never becomes ChargeState; ChargeState never implies fixity without a product stamp"
 channel: "postfix pipeline may still be collate-only; discharge to host is channel ceiling, not postfix glyph"
}

// ═══════════════════════════════════════════════════════════════
// Relation to open/close polarity (do not merge)
// ═══════════════════════════════════════════════════════════════

^["with_port_polarity"]{
 // Brace-physics accumulate/release is *inside* Bound ports.

 law: "+{ } does not mean open-port polarity; { }+ does not mean close-port polarity"
 diagram: .{
  prefix: "Act sits on before_open / aperture side of the *phrase*, not as { token physics"
  postfix: "Act sits after_close of the *phrase* association"
  ports: "open_boundary / close_boundary remain Bound-internal"
 }

 // Phrase-level association ports (literacy, not lexer tokens)
 phrase_ports: #[
  before_act,   // only for postfix subject material
  act,
  before_bound,
  open_bound,
  inside,
  close_bound,
  after_act,    // only for prefix-owned follow material
 ]
}

// ═══════════════════════════════════════════════════════════════
// Occupancy / saturation (Act×Bound continuum)
// ═══════════════════════════════════════════════════════════════

^["with_saturation"]{
 // From operational-physics.md — rename off "valence saturation"

 sense: "how fully Act and Bound are co-specified (probe → resonant → saturated)"
 orthogonal: "saturation is continuum on one association; fixity is *which* association class"
 examples: #[
  `![]`     // prefix + empty frame — high silhouette, low occupancy → probe/select
  `!{body}` // prefix + inhabited — more saturated collapse
  `data~`   // postfix potential — subject occupied, Act deferred
 ]
}

// ═══════════════════════════════════════════════════════════════
// Disclosure & optimization
// ═══════════════════════════════════════════════════════════════

^["disclosure"]{
 // Representational-disclosure: product stamps placement; card shows silhouette.

 product_fields: #[actPlacement, frames.fixity, Operation.position]
 card_form: `^["phrase"]{ ~#fixity: prefix|postfix|…  ~#form: "+{}" | "{}+" }`
 nest_path: "Bound skeleton without Act; fixity is Act association *on* that skeleton"
 measure: "%fixity{ interprets: objective, considers: #[prefix, postfix, interior], surfaces: #[card, inspect], run: countFixity / phrase census }"
}

^["optimize"]{
 law: "rewrites only under declared fixity + phrase schema + channel (fixity-brace-phrases)"
 refuse: "free glyph shuffle +{ } ↔ { }+ as 'style' without product change"
 opt_key: "includes fixity in phrase opt / cache keys when product-grade"
}

// ═══════════════════════════════════════════════════════════════
// Implementation posture
// ═══════════════════════════════════════════════════════════════

^["implementation"]{
 measured: #[
  "ActPlacement type + ONF coupling actPlacement",
  "prefix-primary parse; countFixity / phraseKeys on inspect",
 ]
 partial: #[
  "postfix Operation.position",
  "paired open/close labels on Bounds",
 ]
 proposed: #[
  "dual-read fixity group on ChangeReport / inspect cards",
  "explicit assoc law for postfix chains in seed",
  "EM profile as optional disclosure theme — never evaluator law",
 ]
 refuse: #[
  "Maxwell solver in runtime",
  "merge fixity into ChargeState or valence enums",
  "left/right as grammar",
 ]
}

#>wonder_em_fixity_1
?["Does this phrase read +{ } or { }+ under reparse?"]{
  interprets: objective
  considers: #[actPlacement, Operation.position, sequence_juxtaposition]
  surfaces: #[tree, card, test]
  run: "stamp placement; if only juxtaposition, mark postfix as proposed not measured"
  !probe{ "dual-read must not claim postfix ownership until grammar stamps it." }
}

#>wonder_em_fixity_2
?["Is the EM story helping literacy or inventing force?"]{
  interprets: interpretive
  considers: #[em_map, charge_packet, port_polarity]
  surfaces: #[theory, teaching]
  run: "if a sentence implies force without actPlacement stamp, demote to profile"
  !probe{ "keep EM as association silhouette language." }
}
