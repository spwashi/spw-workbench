# Representational Disclosure
#
# How intermediate products become legible without becoming the product.
# Dialect, mode, grain, and channel shape *disclosure*; contentHash and
# producer schema shape *identity*; session beat and tier shape *retention*;
# weights and resonance shape *attention* only.
#
# Companion to operational-field (coordinates) and brace-charge-crawl (charge +
# dialect projections). Not a host pretty-printer doctrine.
#
# @see docs/theory/spw/operational-field.spw
# @see docs/theory/spw/brace-charge-crawl.spw
# @see docs/theory/spw/mutation-flow-automata.spw
# @see docs/theory/spw/measure-context-kernel.spw
# @see docs/theory/spw/pattern-ecology-tooling.spw
# @see packages/spw-seed/src/ir
# @see .agents/plans/canon-rewrite-v2/PLAN.md

#:layer #!semantics
#:status #!proposed

#>representational_disclosure
^seed[Spw.Theory.Representational.Disclosure v:0.1 @profile:Spw.b @intent:product_legibility_under_context]

^["roots"]{
 @field: ~"./operational-field.spw"
 @charge: ~"./brace-charge-crawl.spw"
 @mutation: ~"./mutation-flow-automata.spw"
 @measure: ~"./measure-context-kernel.spw"
 @ecology: ~"./pattern-ecology-tooling.spw"
 @topography: ~"./operational-topography.spw"
 @ir: ~"../../../packages/spw-seed/src/ir"
 @session: ~"../../../packages/spw-runtime/src/session"
 @delta: ~"../../../packages/spw-cli/src/delta.ts"
 @plan: ~"../../../.agents/plans/canon-rewrite-v2/PLAN.md"
}

// ═══════════════════════════════════════════════════════════════
// Thesis
// ═══════════════════════════════════════════════════════════════

^["thesis"]{
 ~#claim: "A product is field material; a reading is that material disclosed under dialect×mode×grain×channel."
 ~#taste: "Spw dual-read is the native legibility language — not a host DualReadView ontology."
 ~#law: "Disclosure never renames identity. Cache tier never renames the product. Weight never seals truth."
 ~#refuse: #[
  "pretty-print as product contract",
  "JSON as default dual-read for agents",
  "padding/alignment as semantic law",
  "resonance rank in irRefKey",
 ]
}

// ═══════════════════════════════════════════════════════════════
// Four layers of “representing information”
// ═══════════════════════════════════════════════════════════════

^["layers"]{
 // Keep these orthogonal — the rewrite fails when they collapse.

 product: .{
  role: "what is true in the field"
  holds: #[contentHash, uri, span, dialect_of_cut, producer_schema, boundary, channel_when_eval]
  examples: #[ChangeReport, Patch, NestPathLattice, PathReceipt, AppositionLattice, SourceDifferential]
  status: proposed
 }

 disclosure: .{
  role: "how that truth is made legible now"
  holds: #[grain_depth, grain_plane, follow, disclose, interpretation_mode, dialect_projection, card_profile]
  form: "Spw surface — frames, ~# cells, %measure, nested ^[\"group\"]"
  examples: #[delta_card, patch_card, nest_path_card, cite_card, medium_card]
  status: proposed
 }

 retention: .{
  role: "how long and where the product (or a disclosure) may be kept"
  holds: #[session_beat, cache_tier, store_memory_ir_file, volatility]
  examples: #[BeatCache, PatchMemoryBank, cli_session_cache, hot_inspect_plane]
  status: measured // partial — session caches exist; doctrine still densifying
 }

 attention: .{
  role: "what opens first under thrift"
  holds: #[resonance_rank, weight_scheme, probe_heat, hub_pull]
  law: "schedules disclosure and crawl; never keys durable products"
  status: measured // schemes exist; keep out of identity
 }
}

// ═══════════════════════════════════════════════════════════════
// Context: dialect × mode × grain × channel
// ═══════════════════════════════════════════════════════════════

^["context"]{
 // “Context” is not ambient vibes — it is a declared stack.

 dialect: .{
  role: "geometry / metasyntax of the cut (subject)"
  note: "preprocess and projection cost enter path receipts; see brace-charge projections"
  table_ref: @charge
 }

 mode: .{
  live: "working-set / partial products — lean memory; no closed-parse claim"
  tree: "full parse/ONF — exact structure; path receipts"
  template: "holes + expand later — pulse/pattern plans"
  law: "same product may disclose differently per mode without changing identity"
 }

 grain: .{
  depth: #[point, card, surface, …]
  plane: #[form, eval, interconnect, …]
  follow: #[point, soft, hard]
  note: "aperture of materialization — RuntimeMedium composes channel×dialect defaults"
 }

 channel: .{
  role: "agency wall — who may run / discharge"
  collate: "sense, delta, lattice, dry-run, session cache list/show"
  discharge: "apply Patch, pulse --write, mutate under ceiling"
 }
}

// ═══════════════════════════════════════════════════════════════
// Expression: Spw as the dual-read language
// ═══════════════════════════════════════════════════════════════

^["expression"]{
 // Prefer Spw structure over host column alignment.

 form: .{
  card: `^["product_kind"]{ … }`
  group: `^["lex"]{ … }  ^["form"]{ … }` // nested frames = sections
  cell: `~#name: value` // apposition-as-facet
  flag: `~#layoutOnly: #yes | #no`
  state: `~#nest: #eq | #moved`
  path: `~"relative/path"`
  list: `#[ a ; b ]`
  measure: `%name{ interprets, considers, surfaces, run }`
 }

 law: #[
  "groups are nested frames, not comment banners with pad spaces",
  "facet keys are stable product nouns (layoutOnly, nest, labels) — loc may gloss later",
  "empty is _ ; booleans are #yes/#no — host true/false stays off dual-read",
  "one card per product disclosure; compose cards rather than megafields",
 ]

 thrift: .{
  point: "mask + kind only"
  card: "grouped facets under current grain"
  surface: "card + optional nested products (nest lattice, lex sample)"
 }
}

// ═══════════════════════════════════════════════════════════════
// Memory architecture & interpretability
// ═══════════════════════════════════════════════════════════════

^["memory"]{
 planes: .{
  evaluate: "interpret products — discharge-adjacent under channel"
  inspect: "form / resonance / bytecode cards — collate-heavy"
  session_cli: ".spw/gen/session/** — tooling memory, not authored canon"
 }

 address: .{
  product: "IrRef / irRefKey — schema+producer in; bornBeat out"
  disclosure: "may cite product ref; must not invent a second identity"
  receipt: "PathReceipt stamps dialect cut on prepare"
 }

 interpretability: .{
  means: "a reader can recompute *why* a card looks this way from product + context"
  requires: #[producer_schema, dialect_or_receipt, mode_or_grain, status_tag]
  refuse: "opaque JSON dumps as the only memory of a sense step"
 }

 registers: .{
  note: "live mode leans on RegisterBank / working set; tree mode rehydrates from source+hash"
  law: "live disclosure must declare partiality"
 }
}

// ═══════════════════════════════════════════════════════════════
// Mutation rules & differentials
// ═══════════════════════════════════════════════════════════════

^["mutation"]{
 // Rules plan *edits*; disclosure narrates *difference*; Patch freezes *apply*.

 plan: .{
  semantic: "selector-addressed SemanticPlan — collate conflicts"
  range: "span transforms — layout-adjacent"
  automata: "mutation flow — intermediate buffers, effect grades"
 }

 differential: .{
  role: "ordered SourceEdit[] + hashes — apply payload"
  stratum: #[source, structure, layout, reference, operation, script]
 }

 products: .{
  ChangeReport: "sense narrative — lex LCS + brace + nest path + labels"
  Patch: "frozen apply unit — selection + differential + ceiling + store"
  law: "delta discloses; patch discharges under channel (when applied)"
 }

 layout_only: .{
  law: "brace equal ∧ nest skeleton equal ∧ labels equal ∧ lex triviaOnly"
  note: "topography/brace projection remains the structural gate for format writes"
 }
}

// ═══════════════════════════════════════════════════════════════
// Caches & weights
// ═══════════════════════════════════════════════════════════════

^["cache"]{
 kinds: .{
  product_cache: "IrRef-keyed products — retention tier only"
  disclosure_cache: "session dual-read cards for inspect (cli-cache, cite handles)"
  id_cache: "regional identifier maps — lens-keyed (brace-charge crawl)"
 }

 law: #[
  "tier (hot/warm/cold) is retention, never product identity",
  "dialect preprocess is part of cut identity (path receipt)",
  "disclosure cache may miss and re-project from product without shame",
  "gen/session is tooling memory — invent/map skip",
 ]
}

^["weights"]{
 role: "attention and thrift — which disclosures open, which edges rank"
 instruments: #[resonance_scheme, weight_scheme, probe_heat, SearchTuning]
 law: "weights schedule; they do not seal. Never enter irRefKey."
 relation_to_disclosure: "high rank may prefer card grain; low rank may stay point/mask"
}

// ═══════════════════════════════════════════════════════════════
// Worked map: current rewrite products
// ═══════════════════════════════════════════════════════════════

^["product_map"]{
 status: proposed // densify as phases land

 ~#ChangeReport: .{
  product: "two-revision narrative"
  disclose: `^["delta"]{ ^["identity"]{…} ^["lex"]{…} ^["form"]{…} }`
  cli: "spw delta"
  cache: "--cache → session disclosure memory"
 }

 ~#Patch: .{
  product: "selection + differential + ceiling"
  disclose: `^["patch"]{ ^["product"]{…} ^["payload"]{…} ^["selection"]{…} }`
  cli: "spw delta --patch"
  apply: "applyPatch* under channel — discharge"
 }

 ~#NestPath: .{
  product: "container nest forest over <>(){}[]"
  disclose: `^["nest_path"]{ skeleton, labeled, cluster }`
  couple_capsule: "shared glyph in alphabet; not doctrine split"
 }

 ~#PathReceipt: .{
  product: "prepare cut stamp"
  disclose: "inspect card path_receipt group"
 }

 ~#RuntimeMedium: .{
  product: "channel × dialect policy cell"
  disclose: "medium card on inspect"
 }
}

// ═══════════════════════════════════════════════════════════════
// Implementation posture (code follows doctrine)
// ═══════════════════════════════════════════════════════════════

^["implementation"]{
 preferred: #[
  "products are typed field material (TS/IR)",
  "disclosure is Spw expression projected under context",
  "one projection path per product family — nested frames for groups",
  "CLI chrome uses in-module defineLoc; facet keys stay product nouns",
  "session --cache retains products or re-projectable disclosure, not layout-as-law",
 ]

 deferred: #[
  "full Spw pretty-printer / host DualReadView type as ontology",
  "per-dialect card profiles as separate dialects (start as profiles on Spw.b)",
  "weight-driven auto grain without explicit user/agent choice",
 ]

 next_code: #[
  "ChangeReport/Patch disclose via nested-frame Spw (groups as ^[\"lex\"] not // pads)",
  "cli-cache index as Spw surface; JSON only behind --json",
  "path_receipt + medium already on inspect — align group vocabulary",
 ]

 shipped: #[
  "formatSpwCard nested groups — seed/canonical/spw-card.ts",
  "formatChangeReportSpw / formatPatchSpw / formatNestPathSpw nested frames",
  "cli-cache: index.spw + id.spw disclosure; id.product.json rehydrate only",
  "spw delta --list default Spw index (not host table)",
 ]
}

// ═══════════════════════════════════════════════════════════════
// Wonders
// ═══════════════════════════════════════════════════════════════

#>wonder_representational_disclosure_1
?["When does a card lie about the product?"]{
  interprets: objective
  considers: #[missing_receipt, wrong_mode, tier_as_identity, weight_as_truth]
  surfaces: #[cli, card, lsp]
  run: "check path receipt + schema + mode claim on every intermediate"
  !probe{ "if re-project from product under declared context, card must match." }
}

#>wonder_representational_disclosure_2
?["Is this memory or truth?"]{
  interprets: mixed
  considers: #[session_cache, BeatCache, authored_corpus]
  surfaces: #[cli, gen_session, tree]
  run: "classify each store as retention of product vs disclosure vs canon"
  !probe{ "gen/session never claims canon; product cache never claims attention." }
}
