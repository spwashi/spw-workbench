// Measure context kernel — generalizing overspecified mass
//
// Mass was a sharp product (exact lines/bytes vs @self) and became overloaded
// as if it were the whole measure story. The kernel is: declared metrics under
// schemes, file-level context from Spw operator+identifier definitions,
// algorithms over attentional scopes / perceptive planes / representational forms.
//
// @see .spw/registries/measure-context.spw
// @see packages/spw-seed/src/canonical/measure-protocol.ts
// @see packages/spw-seed/src/canonical/self-mass.ts
// @see packages/spw-seed/src/ir
// @see .agents/plans/measure-invariant-generalization/PLAN.md

#:layer #!semantics
#:status #!partial

^seed[Spw.Measure.Context.Kernel v:0.1 @profile:Spw.b @intent:generalize_mass]

^["roots"]{
 @registry: ~"../../../.spw/registries/measure-context.spw"
 @protocol: ~"../../../packages/spw-seed/src/canonical/measure-protocol.ts"
 @mass: ~"../../../packages/spw-seed/src/canonical/self-mass.ts"
 @ir: ~"../../../packages/spw-seed/src/ir"
 @plan: ~"../../../.agents/plans/measure-invariant-generalization/PLAN.md"
}

^["thesis"]{
 ~#claim: "A scalable language kernel grows by Spw-defined families and algorithms, not by special-casing each compelling demo (mass) into CLI law."
 ~#taste: "declare · scheme · scope · plane · form · host observe · seed reconcile"
 ~#law: "Operator+identifier products carry context; hosts implement observation; schemes decide verdicts."
}

// ── Why mass felt overspecified ────────────────────────────────

^["mass_critique"]{
 sharp: #[
  "span-local digit rewrite"
  "portable seed (no fs)"
  "honest unmeasurable"
  "@self pairing composition"
 ]
 overspecified: #[
  "only lines/bytes as if thrift were all of measure"
  "exact-only equality as if schemes did not exist"
  "CLI knowledge of %mass instead of registry context"
  "conflation risk with runtime % register measure"
 ]
 move: "keep mass as thrift.file_physics family; open registry for planes"
}

// ── File-level syntactic context (example) ─────────────────────

^["syntactic_context_example"]{
 // Given Spw definition:
 //   operator % , identifier mass , subject self , scope subject_file
 // When a surface writes:
 example: |
  ^["module"]{
   @self: ~"../src/foo.ts"
   %mass{ lines: 100, bytes: 3200 }
  }
 // The kernel assumes (from definition, not mass.ts folklore):
 assume: #[
  "facet product is % + mass"
  "subject bind is nearest @self in body"
  "attentional scope is that subject file"
  "perceptive plane is thrift"
  "representational form is vector of keys"
  "algorithm thrift.file_physics observes host"
  "scheme default exact unless surface overrides"
 ]
}

// ── Scalable kernel growth ─────────────────────────────────────

^["kernel"]{
 layers: #[
  "1. Grammar: Act x Bound for declare facets (% family id)"
  "2. Registry: MeasureFamilyDef + MeasureAlgorithmDef in Spw"
  "3. Portable reconcile: schemes + verdicts in seed"
  "4. Host extractors: fs, geometry, authority, substrate"
  "5. Session walk: attention.scope_walk over SelectionIR"
  "6. IR: MeasureIR nodes in interconnect graph"
  "7. Editors: diagnostics from same reconcile (no client re-measure)"
 ]
 growth: "new plane = new family + algorithm entry + host adapter — not a new CLI verb"
}

// ── Algorithms over scopes, planes, forms ──────────────────────

^["algorithms"]{
 attention_scope_walk: |
  // Spw-described (registry algorithm attention.scope_walk)
  // 1 select attentional scope (selection, ego, window)
  // 2 apply lens + channel
  // 3 for each locus open perceptive plane
  // 4 run family algorithm
  // 5 precipitate MeasureIR / StreamIR
  // 6 optional crystallize

 plane_matrix: .{
  thrift: "subject_file physics"
  syntax: "surface FormIR"
  graph: "ego / corpus topology"
  flow: "protocol roles"
  probe: "wonder density"
  runtime: "substrate vibration"
 }

 form_matrix: .{
  scalar: "single Hold-like score"
  vector: "named metrics"
  table: "authority-like rows"
  stream: "ND measure frames (Spw.l/x)"
  ir_slice: "graph-attached measure node"
 }
}

^["examples"]{
 mass_only: |
  // specialization remains valid
  spw measure mass path.spw

 density_future: |
  ^["s"]{ %density{ ops: 10, depth: 4, frames: 6 } }
  // algorithm syntax.form_density

 multi_plane_walk: |
  // scope: prompts/**
  // families: mass on modules with @self, density on .spw surfaces
  // one walk, many planes
}

^["open"]{
 ?[surface_scheme]: "Inline scheme next to keys: lines: 100 ~tol{abs:5} ?"
 ?[family_dispatch]: "CLI measure density before host adapter exists — soft unmeasurable?"
 ?[runtime_percent]: "Document polarity: surface %family vs register % measure"
 ?[spw_executable_steps]: "When do algorithm steps become Spw.x runnable?"
 ?[percept_plugin]: "Third-party planes via consumer biome registry?"
}

#>wonder_measure_kernel_1
?["What is the smallest registry that still generalizes mass?"]{
  !probe{ =id[p_min_reg] }
  $%[family, algorithm, scheme]
}

#>wonder_measure_kernel_2
?["Can a perceptive plane exist without a CLI verb?"]{
  !probe{ =id[p_plane_no_verb] }
  // free: yes — family + algorithm + host adapter
}
