# Relationship Topography — complex relations for many purposes
#
# Model dependency, coupling, and familiarity without overfitting to one
# industry noun-set. Same primitives serve business lines, academic corpora,
# production ensembles, and onboarding to novel Spw (or Spw-like) trees.
#
# Tooling: spw map | spw topo
# Kernel: packages/spw-seed/src/math/corpus.ts
# Fields: docs/theory/spw/field-dynamics.spw

#:layer #!semantics
#:status #!active

#>relationship_topography
^seed[Spw.Relationship.Topography v:0.1 @profile:research @intent:cross_domain_relations]
{_rel

 intent: .{
  goal = `Represent and inspect complex relationship systems for diverse ends`
  learn = `Enter a new codebase and read its topography via shared strands`
 }[reg=facet]

 # ── Cross-domain uses (abstract) ──────────────────────────────

 purposes: #[
  .{id=operations, reading=`who depends on whom; critical path; orphan inventory`},
  .{id=research, reading=`citation-like path graphs; cluster hubs; layer depth`},
  .{id=production, reading=`ensemble carriers × sites; continuity conservation`},
  .{id=governance, reading=`cache ownership; membrane refuse; promote gates`},
  .{id=pedagogy, reading=`familiarity strands as curriculum from known → novel`},
 ][reg=set]

 # ── Topography objects ────────────────────────────────────────

 objects: #[
  .{id=node, forms=`file | pack | frame | root shelf | logical agent`},
  .{id=edge, forms=`~path | @root | labeled couple | field coupling`},
  .{id=hub, meaning=`high degree — warm cache / attention candidate`},
  .{id=layer, meaning=`topo freelist generation — dependency stack`},
  .{id=cycle, meaning=`mutual dependency — needs SCC break or intentional loop`},
  .{id=orphan, meaning=`no edges — archive, entry, or dead weight`},
  .{id=strand, meaning=`shared vocabulary wire (basename, sigil rhythm, shelf)`},
 ][reg=set]

 # ── Familiarity (novel + known) ───────────────────────────────

 familiarity: .{
  idea = `A novel tree is legible when enough strands match a known corpus`
  measures = #[
   `path basename Jaccard / overlap`
   `sigil histogram cosine`
   `frame density affinity`
   `root shelf overlap`
  ]
  workflow = [
   `spw map <novel> --compare <known>`
   `skim hubs on both sides`
   `query pathRefs where basename matches shared strand`
   `field/ensemble models bind ids; cold genotype stays stable`
  ]
  cache = `map reports are warm; do not write into cold packs without promote`
 }[reg=facet]

 # ── Tooling contract ──────────────────────────────────────────

 tooling: .{
  invent = `spw invent [paths] [--sort degree|lines|refs] [--role hub|orphan|leaf|source|node]`
  map = `spw map [paths] [--compare other] [--json] [--hubs N]`
  formula = `spw formula [paths] [--catalog] [--family field|hold|…]`
  analyze = `spw analyze [paths] [--selectors pathRefs,ops:frame,…]`
  alias = `spw topo | spw inv | spw stats`
  kernel = `analyzeTopography + compareFamiliarity + formula-scan + corpus-scan`
  sense_loop = ~"../../runtime/md/sense-loop.md"
  pair = #[`spw tree`, `spw invent`, `spw formula`, `spw analyze`, `spw skim`, `spw query --skim`]
 }[reg=facet]

 features: #[
  `spw.tooling.corpus-map@v0.1:preview`
  `spw.lang.relationship-topography@v0.1:preview`
  `spw.math.field-probes@v0.1:stable`
 ]

 refuse: #[
  "Assume novel codebase has zero shared strands without measuring"
  "Treat map JSON as genotype source of truth"
  "Require domain-specific nouns to use relationship models"
 ][reg=set]
}
