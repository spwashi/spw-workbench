# Semantics & Physics Notes
#
# How sigils behave as particles/regions, and modes for experimental parsing.
# @spw:contract:exploratory[system=physics-corpus,basis=parser-ideas]

#:layer #!semantics

^["contract_split"]{
 canonical: "Binding runtime semantics live in docs/runtime/spw/runtime-foundation.spw and src/runtime/state/types.ts."
 exploratory: "This file is a theory notebook for surface mnemonics, parser experiments, and semantic probes."
 falsify: "If a claim here changes release execution or parser acceptance, it is non-binding until repeated in the runtime contract."
}

^["roles"]{
 # Base containers in the register algebra are [] {} <> ().
 # Wrapper forms such as << >> and (( )) are layered surface forms, not extra base axes.
 # Region atoms:
 "<>": "concept/capsule (definition of what)"
 "()": "scene/context (where)"
 "[]": "mode/params (how/config)"
 "{}": "definition/apply-context (do)"
 "<< >>": "layered concept / stream wrapper"
 "(( ))": "emphasis/hedge wrapper"

 # Operator layering:
 # 1) enter/exit regions (containers)
 # 2) modifiers (valence)
 # 3) operators (! ^ ~ <> ? * = @ and extensions)
 # 4) connectors (.. -> / & | :)
}

^["container_bridge"]{
 base_algebra: "docs/theory/spw/register-geometry.spw owns the reduced container algebra."
 surface_mnemonics: "The roles above are reader-facing mnemonics, not the canonical base-axis names."
 bracket_note: "`[]` reads as mode/params at the surface and as individuation/categorical view in the register algebra."
 wrapper_note: "`<< >>` and `(( ))` remain wrappers around the four base containers, not additional container atoms."
}

^["whitespace_modes"]{
 default: "inert whitespace; tokens bound explicitly"
 dense: "collapse whitespace; prefer tighter binding"
 poetic: "allow adjacency binding; lower precedence than explicit connectors"
}

^["locality"]{
 # Per-region frames; entering a container pushes locality.
 # Operators act on top frame, then outer frames for resolution.
 # Registers per frame: concept, scene, mode, definition.
}

^["multipass_parsing"]{
 status: "exploratory — ambiguity tracing for research, not a release parser contract"
 # Passes:
 # - lex
 # - coarse parse (structure)
 # - semantic refinement (modes/locality/labels)
 # Controls:
 # - lookahead: number of tokens to peek
 # - rewind: allow backtracking for ambiguity testing
 # - granularity: coarse | fine
 # Outputs:
 # - branch traces for ambiguous sections
}

^["topological_prompting"]{
 status: "exploratory — prompt-mode tolerance only; not accepted for deterministic execution"
 # Permissive mode for mismatched braces:
 # - Treat unmatched regions as open fields (record, don't fail)
 # - Clustering rules: nearest neighbor by label; record gaps
 # - Useful for cognitive/semiotic prompts; not for execution
 # Brace perturbation (e.g., replace '}' with '>'):
 # - Use diff analyzer to report semantic drift vs canonical AST
}

^["intrinsics"]{
 # "_" sugar: "?_query" -> "?(query)" (normalize to explicit form)
 # Labels: A{} == {_A }_A ; labels are metadata; semantics unchanged
 # Physical properties: encode as annotations (~#color, ~#material)
}

^["nl_preview"]{
 status: "exploratory — branch narration for research threads, not runtime output"
 # For ambiguous parses, emit NL previews per branch:
 # - "Interpretation A: probe over concept region"
 # - "Interpretation B: apply mode to scene"
 # Enables parallel LLM threads on finer-grained semantics.
}

#>wonder_docs_theory_spw_semanticsphysics_1
?["What ripples if #semantics_physics changes in this file?"]{
  #:depth #!mathematical // lens: formal structure
  $#educational@workspace => %[reference.count, depth.downstream]
  ~#downstream: "trace all files that reference this surface"
  !probe{ "imagine renaming #educational to #educational_v2; count broken references; the count reveals how deeply roles is woven into the workspace." }
  $%[register.bank_size, register.active_bindings]
}

#>wonder_docs_theory_spw_semanticsphysics_2
?["What happens when you zoom from the concept level to the workspace level in Semantics & Physics Notes?"]{
  #:depth #!stylistic // lens: material grain
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "roles" // this file's atom
  !probe{ "the atom is concept-scale; zoom out: what workspace-level pattern does this concept participate in?" }
  $%[register.bank_size, register.active_bindings]
  ~<"docs/theory/spw/audio-architecture.spw"> ~#neighbor(nearest)
}
