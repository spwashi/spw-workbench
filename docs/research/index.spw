# Research Index
#
# Exploratory logs, experimental methodologies, and protocols.

#:layer #!semantics

^["roots"]{
 @here: ~"."
 @probes: ~"./probes/index.spw"
}

^["intent"]{
 ~#goal: "Route to exploratory logs, protocols, and the probe corpus"
 ~#taste: "logs record what happened; probes record what a reader did with it"
}

^["logs"]{
 !["Exploration Logs"]
 .. ~"./spw/exploration-log.spw"
 .. ~"./spw/research.spw"
}

^["probes"]{
 !["Probe Corpus"]
 .. ~"./probes/index.spw"
 ~#note: "seed/response pairs versioned on both the language and model axes"
}

^["experiments"]{
 !["Experimentation & Protocols"]
 .. ~"./spw/experimentation.spw"
 .. ~"./spw/pilot-matrices.spw"
 .. ~"./spw/lens-walk-research.spw"
 .. ~"./spw/screenshot-protocol.spw"
}

#>wonder_docs_research_index_1
?["What ripples if #index changes in this file?"]{
  #:depth #!mathematical // lens: formal structure
  $#educational@workspace => %[reference.count, depth.downstream]
  ~<./spw/exploration-log.spw> // first downstream dependency
  !probe{ "imagine renaming #educational to #educational_v2; count broken references; the count reveals how deeply roots is woven into the workspace." }
  $%[research.hypothesis_count, research.evidence_ratio]
}

#>wonder_docs_research_index_2
?["What happens when you zoom from the concept level to the workspace level in Research Index?"]{
  #:depth #!stylistic // lens: material grain
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "roots" // this file's atom
  !probe{ "the atom is concept-scale; zoom out: what workspace-level pattern does this concept participate in?" }
  $%[research.hypothesis_count, research.evidence_ratio]
  ~<docs/index.spw>  // nearest neighbor
}
