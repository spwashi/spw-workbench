# Exploration Log
#
# A replayable, diffable log of probes and outcomes.

#:layer #!semantics

^["goal"]{
 ~#intent: "Turn exploration into a versioned artifact."
 ~#contract: "Every run is traceable to inputs, context, and outputs."
 ~#taste: "An entry that cannot be re-run from what it records is a memory, not a log."
}

^["units"]{
 probe: "question or action that initiates a run"
 result: "captured outputs (text/image/AST/trace)"
 surprise: "unexpected behavior or mismatch"
 hypothesis: "testable explanation"
 next: "smallest follow-up experiment"
}

^["inputs"]{
 ~#required{
 timestamp: "ISO 8601"
 model: "name + version"
 prompt: "primary instruction"
 screenshot: "file reference or hash"
 ui_state_hash: "hash of tuple + selection + layout"
 settings: "disclosure/lod/genre/posture/theme"
 seed: "optional seed/context"
 }
 ~#optional{
 lens: "active lens or panel"
 selection_anchor: "token/node anchor"
 run_group: "experiment batch id"
 }
}

^["outputs"]{
 ~#required{
 text: "generated response text"
 }
 ~#optional{
 image: "image outputs or references"
 ast_delta: "diff summary"
 interaction_trace: "gesture sequence"
 a11y_notes: "accessibility tree snapshot"
 }
}

^["schema"]{
 ~#storage: "JSONL or per-run JSON with stable ids."
 ~#keys{
 id: "run id"
 batch: "experiment group"
 probe: "probe text"
 result: "result payload"
 surprise: "surprise notes"
 hypothesis: "testable claim"
 next: "next run plan"
 }
}

^["ui"]{
 ~#panel: "Exploration Log panel"
 ~#behaviors{
 diff: "compare runs side-by-side"
 replay: "re-open state snapshot"
 tag: "label surprises and hypotheses"
 }
}

#>wonder_docs_research_spw_explorationlog_1
?["How would an ecology portfolio express goal?"]{
  #:depth #!stylistic // lens: ecological zone
  ~#translation_target: "ecology"
  ~#source_concept: "goal"
  !probe{ "rewrite the root frame in ecology vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[research.hypothesis_count, research.evidence_ratio]
}

#>wonder_docs_research_spw_explorationlog_2
?["How does this file's voice differ from spw/exploration-log (spw/exploration-log)?"]{
  #:depth #!educational // lens: molecular binding
  ~<@_> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]@_
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}
