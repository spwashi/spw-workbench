# Experimentation Loop
#
# Operating loop for experimentation and discovery.

#:layer #!semantics

^["goal"]{
  ~#intent: "Make exploration a first-class, versioned artifact."
  ~#ethos: "Wonder remains playful; experiments are replayable and diffable."
}

^["artifacts"]{
  ~#exploration_log: ~"./exploration-log.spw"
  ~#operator_atlas: ~"../../theory/spw/operator-atlas.spw"
  ~#screenshot_protocol: ~"./screenshot-protocol.spw"
  ~#affordance_ladder: ~"../../design/spw/affordance-ladder.spw"
  ~#a11y_tree: ~"../../design/spw/a11y-tree.spw"
  ~#agent_loop: ~"../../runtime/spw/agent-loop.spw"
}

^["workflow"]{
  ~#probe: "Capture inputs + context (screenshots, prompts, model, UI state)."
  ~#result: "Persist outputs (text, images, AST deltas, interaction traces)."
  ~#surprise: "Tag misalignments or unexpected behaviors."
  ~#hypothesis: "Describe the testable intuition."
  ~#next: "Plan the smallest next run."
}

^["integration"]{
  ~#linkage: "All experiments write into the Exploration Log schema."
  ~#ui: "Workbench surfaces are reversible and diffable."
  ~#state: "Snapshots include tuple + selection anchors."
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
