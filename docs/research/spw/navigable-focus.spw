# Navigable Focus
# Proposed portable selection: keep source, change context, return.

#:layer #!pragmatics
#:status #!proposed
#:dialect Spw.b

^["roots"]{
 @topography: ~"../../../.agents/plans/operational-topography/operational-topography.spw"
 @disclosure: ~"../../theory/spw/representational-disclosure.spw"
 @stack: ~"../../../packages/spw-seed/src/dialect/types.ts"
 @cite: ~"../../../packages/spw-cli/src/cite.ts"
 @inspect: ~"../../../packages/spw-cli/src/inspect.ts"
 @query_profile: ~"../../../.agents/plans/query-profile/query-profile.spw"
 @worlds: ~"./construction-worlds.spw"
}

^["intent"]{
 ~#goal: "Move from reading to inquiry to making without dropping source, context, or consequence."
 ~#taste: "Navigation is a small language; devices change the surface, not the grammar."
}

^["axes"]{
 dialect: "forms and operational laws"
 analysis: "grammar, annotation scheme, constructed-language version, or model reading"
 lens: "ordinary reading, inspection, experiment, play, or source review"
 surface: "space, writing direction, input, private or shared use"
 authority: "observe, local experiment, or applied change"
 law: "a quieter phone reader must not silently select a different grammar"
}

^["focus_record"]{
 subject: "resource identity, revision or content hash, typed anchor"
 anchor: #[text_span, media_interval, region, graph_entity]
 analysis: "dialect and analysis revisions, producer schema, completeness"
 context: "declared sources, inherited settings, and derived suggestions kept separate"
 navigation: "origin, visited relation, return anchor; layout coordinates stay apart"
 view: "reading depth, lens, comparison set"
 draft: "optional unsaved variant with its source link"
 stale: "exact anchors revalidate; outdated or ambiguous is an explicit state"
 refuse: "pixel position as identity; device type as expertise"
}

^["moves"]{
 vocabulary: ?<select, inspect, relate, instantiate, compare, retain>
 first_relations: #[enclosing_construction, explicit_reference, source_evidence, prior_revision, derived_variant]
 power: "a clicked relation can disclose the selector that produced it"
 graph_table_text: "spatial view is never the only route"
}

^["domains"]{
 natural: "time-aligned transcripts, overlapping analyses, import of established corpora"
 constructed: "versioned lexicon, paradigm, constraint, sound-change replay"
 ai_mediated: "source, candidate, model id, configuration, retrieved context, human edits"
 shared_experiment: "hold the words, change the context; then the complement"
 alignments: "annotated claims, not presumed equivalence"
}

^["surfaces"]{
 watch: "pinned phrase, one relation, a short question, handoff"
 phone: "one focus, persistent return, local reversible variation"
 tablet: "pen annotation, interlinear pair"
 table: "personal selections; joining comparison is an explicit act"
 desktop: "synchronized source / analysis / trace; composable query"
 scroll: "semantic bookmark; restore by source anchor, not pixel"
 writing_mode: "visual orientation ≠ semantic operand order"
 proximity: "arrangement is not a semantic edge until named"
}

^["releases"]{
 find_place: .{
  accomplishment: "follow a phrase and return to its source"
  prove: "selection survives reflow, reopen, and a second host"
 }
 see_reading: .{
  accomplishment: "compare interpretations without losing the original"
  prove: "shared source, explicit differences, recoverable evidence"
 }
 make_world: .{
  accomplishment: "instantiate and vary a bounded linguistic system"
  prove: "declared bindings, traceable changes, bounded replay"
  handoff: @worlds
 }
 law: "each release ships one exhibit and the fixtures behind it"
}

^["first_patch"]{
 name: "revision-addressed focus on inspect, cite, and follow"
 tests: #[stale_revision, unicode_offset, round_trip_return]
 preserves: "stable query and reference semantics"
 owner: @topography
}

^["measure"]{
 recovery: "can the person find the source again?"
 provenance: "can they say how a reading arose?"
 relation_error: "wrong-target rate on follow"
 transfer: "does a learned move work on a second specimen?"
 refuse: "dwell time as comprehension; age or device as skill"
}
