# Screenshot Prompt Protocol
#
# Make screenshot-driven prompting explicit and testable.

#:layer #!semantics

^["goal"]{
 ~#intent: "Convert implicit visual cues into structured prompts."
 ~#contract: "Screenshots are treated as structured inputs."
 ~#taste: "A capture without its anchor and intent fields is an image, not an input."
}

^["protocol"]{
 ~#fields{
 anchor: "primary subject (editor/inspector/context)"
 task: "critique/redesign/extract/summarize/generate"
 constraints: "preserve layout/motion/a11y/etc"
 output_mode: "narrative/spec/component plan/SVG/CSS tokens"
 }
}

^["experiment_design"]{
 ~#ablation{
 anchor: "vary anchor only"
 task: "vary task only"
 output: "vary output mode only"
 }
 ~#compare{
 focus: "what the model fixates on"
 omissions: "what is ignored"
 hallucinations: "what is invented"
 }
}

^["ui"]{
 ~#feature: "Prompt from Screenshot"
 ~#panel_fields: ["anchor", "task", "constraints", "output_mode"]
 ~#storage: "write each run into the Exploration Log"
}

#>wonder_docs_research_spw_screenshotprotocol_1
?["What was Screenshot Prompt Protocol before it was this, and what could it become?"]{
  #:depth #!experiential // lens: curated collection
  ~#past: "git log --oneline -- docs/research/spw/screenshot-protocol.spw | head -3"
  ~#future: "what frame would you add next?"
  !probe{ "the file's git history IS its evolutionary record; the next natural frame reveals the author's trajectory." }
  $%[research.hypothesis_count, research.evidence_ratio]
}

#>wonder_docs_research_spw_screenshotprotocol_2
?["How would a biology algorithm express spw/screenshot-protocol?"]{
  #:depth #!computational // lens: living system
  ~#translation_target: "biology"
  ~#source_concept: "goal"
  !probe{ "rewrite the root frame in biology vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[research.hypothesis_count, research.evidence_ratio]
  ~<docs/research/spw/experimentation.spw>  // nearest neighbor
}
