# Wonder Probes
#
# Standard introspection questions ($) and measurements (%) for system self-analysis.
# These probes answer: "What am I? How big am I? How deep am I?"

#:layer #!semantics

^"roots"{
 @here: ~"."
}

^"catalog"{
 # Identity Probes
 # Answer "What is this?"

 $["topology"]{
 probe: "$[x].topology"
 returns: "'#' | '.' | '@' | '&' | etc"
 meaning: "The operator that created this register"
 }

 $["provenance"]{
 probe: "$[x].provenance"
 returns: "'#' | '&' | '@'"
 meaning: "How this value came to be (grounded, merged, observed)"
 }

 $["stability"]{
 probe: "$[x].grounded"
 returns: "boolean"
 meaning: "Is this immutable? (Safe to link/bookmark)"
 }

 $["affinity"]{
 probe: "$[x].containerAffinity"
 returns: "'[]' | '{}' | '<>' | '()'"
 meaning: "What shape of container does this naturally inhabit?"
 }
}

^"measures"{
 # Magnitude Probes
 # Answer "How much is this?"

 %["intensity"]{
 probe: "%[x]"
 returns: "0..1"
 meaning: "Normalized magnitude (length/count/value)"
 }

 %["popularity"]{
 probe: "%[x.accessCount, 100]"
 returns: "0..1"
 meaning: "Usage frequency relative to 100 accesses"
 }

 %["complexity"]{
 probe: "%[x.depth, 10]"
 returns: "0..1"
 meaning: "Nesting depth relative to 10 levels"
 }
}

^"usage"{
 # The library uses these probes to auto-classify entries:

 auto_tag: "If $[x].grounded, tag ~#stable"
 auto_rank: "Sort search results by %[x.accessCount]"
 auto_warn: "If %[x.complexity] > 0.8, flag for refactor (~#prune)"
}

#>wonder_docs_library_spw_wonderprobes_1
?["How does this file's voice differ from spw/wonder-probes (spw/wonder-probes)?"]{
  #:depth #!educational // lens: molecular binding
  ~<@here> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]@here
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}

#>wonder_docs_library_spw_wonderprobes_2
?["What invariant holds across every frame in Wonder Probes?"]{
  #:depth #!experiential // lens: ecological zone
  $^["_"]@here => %[shared.property]
  ~#hypothesis: "all frames in this file share ____"
  !probe{ "extract the property common to roots's frames; if none exists, the file may lack cohesion or may be a deliberate collection." }
  $%[register.bank_size, register.active_bindings]
  ~<docs/library/spw/git-concordance.spw>  // nearest neighbor
}
