# Waypoints Index
#
# Major release anchors and architectural milestones.

#:layer #!pragmatics

^["roots"]{
  @here: ~"."
}

^["releases"]{
  !["Releases"]
  .. ~"./spw/alpha-v020.spw"
  .. ~"./spw/release-v010.spw"
}

^["milestones"]{
  !["Milestones"]
  .. ~"./spw/architecture.spw"
  .. ~"./spw/design-stage-system.spw"
  .. ~"./spw/infra-hardening.spw"
  .. ~"./spw/keyboard-field-guide.spw"
  .. ~"./spw/publishing-atlas.spw"
  .. ~"./spw/runtime-anatomy.spw"
}

?["How does this surface orient the developer's attention or workflow?"]
  #:scope #!file
  ~#probe: "trace which claims or conventions reference this surface"

