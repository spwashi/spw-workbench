# Waypoints Index
#
# Major release anchors and architectural milestones.

#:layer #!pragmatics

^["roots"]{
 @here: ~"."
}

^["releases"]{
 !["Releases"]
 .. ~"./spw/alpha-v020.spw"
 .. ~"./spw/release-v010.spw"
}

^["milestones"]{
 !["Milestones"]
 .. ~"./spw/architecture.spw"
 .. ~"./spw/design-stage-system.spw"
 .. ~"./spw/infra-hardening.spw"
 .. ~"./spw/keyboard-field-guide.spw"
 .. ~"./spw/publishing-atlas.spw"
 .. ~"./spw/runtime-anatomy.spw"
}

#>wonder_docs_waypoints_index_1
?["How would a biology portfolio express waypoints/index?"]{
  #:depth #!stylistic // lens: living system
  ~#translation_target: "biology"
  ~#source_concept: "roots"
  !probe{ "rewrite the root frame in biology vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[runtime.stage, runtime.queue_depth]
}

#>wonder_docs_waypoints_index_2
?["How does this file's voice differ from alpha-v020?"]{
  #:depth #!educational // lens: curated collection
  ~<./spw/alpha-v020.spw> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]./spw/alpha-v020.spw
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}
