# design/STAGE-SYSTEM — Atmospheric Stages Orientation
#
# After commits 27–33. The UI has depth stages now.

#:layer #!pragmatics

^["stage progression"]{
  ^["stage-0"]{
    ~"minimal contract — bare elements, no atmosphere"
    ~"key hints dimmed, badges hidden"
  }
  ^["stage-1"]{
    ~"atmospheric noise — grain, subtle motion"
    ~"ambient effects begin to breathe"
  }
  ^["stage-2"]{
    ~"full atmosphere — SVG echoes, spirit animations, liminal transitions"
    ~"atelier transition scaffold active"
  }
}

^["what arrived since v0.1.0"]{
  27-viz         — ~"SVG flow renderer, AppComponent base class, prompting rail"
  28-keyboard    — ~"register bank, command bar, selection overlays"
  29-design-mode — ~"three overlay lenses: text, run, ref"
  30-context     — ~"LoD gating, section state cues, 5 more AppComponent migrations"
  31-themes      — ~"per-family interaction tokens, prompt rail tuning"
  32-contracts   — ~"component contract registry, web components strategy"
  33-stages      — ~"stage 0→1→2 progression + badge presets"
}

^["component contracts"]{
  @app/components/_shared/component-contracts.ts   — ~"component declares what it needs"
  @platform/bootstrap/init.ts                      — ~"registry provides at startup"

  #[principle]: "contracts replace implicit assumptions with explicit declarations"
}

^["AppComponent pattern"]{
  ~"prompting-rail, context-badges, genre-selector, intent-bar, + 5 more"
  ~"all migrated to shared rootObserver base class"
}

?["How does this surface orient the developer's attention or workflow?"]
  #:scope #!file
  ~#probe: "trace which claims or conventions reference this surface"

