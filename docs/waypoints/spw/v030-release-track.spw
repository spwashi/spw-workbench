# RELEASE TRACK — v0.3.0
#
# March 2026 recovery cadence for the end-of-month release push.
# This surface records what already landed in-repo and keeps the remaining
# public gates explicit instead of implying the tag is done.

#:layer #!pragmatics

^["release identity"]{
 version: "v0.3.0"
 theme: "monorepo workspace + structural decoupling"
 framing: "v0.3.0 is the structural milestone where the repo became a workspace; install, governance, and discoverability gates are now explicit, and the remaining question is whether they agree cleanly enough for the month-end tag"
}

^["already landed"]{
 .[workspace]: "workspace topology exists in the repo and the root is no longer a single flat app"
 .[packages]: "seed, runtime, LSP, and CLI are represented as package-owned surfaces"
 .[editor]: "VS Code work now routes through typed client composition instead of ad hoc transport seams"
 .[tools]: "agent tooling and release checks live in canonical repo surfaces rather than implied conventions"
}

^["pending public gates"]{
 .[install]: "site-install truth is now explicit in quick-start, migration, and release-story surfaces; the remaining gate is final agreement with runtime, CLI, and editor behavior"
 .[governance]: "surface readiness and launch admission now route through registry-backed installable and readiness metadata; the remaining gate is release-copy agreement with that registry"
 .[discoverability]: "release notes, waypoint copy, and extension-facing claims are now explicitly preview-scoped where needed; the remaining gate is keeping startup truth narrower than marketplace ambition"
}

^["release rule"]{
 ~#must_be_true: [
   "public language only names what is already true in the repo",
   "install, governance, and discoverability gates are called out as explicit but not complete until the final cross-surface verification passes",
   "release claims do not outrun the current workspace and extension surfaces",
 ]
}

^["release gate — 2026-03-31"]{
 ~#must_be_true: [
   "the changelog, waypoint index, and implementation plan agree about what v0.3.0 means",
   "install truth is explicit enough for external sites to mount the workbench without guesswork",
   "governance and discoverability language match the actual repo admission state",
 ]
}

^["recovery note"]{
 ~#truth: "a missed alpha checkpoint is not failure by itself; it becomes failure only if the repo keeps speaking as though the checkpoint happened"
 ~#method: "compress the cycle without compressing the truth"
}

?["where next — spw/v030-release-track?"]{
 ~"run the final release-prep verification pass before tagging"
 ~"treat discoverability as a gate, not an assumption"
 ~"use the gate list to decide whether 2026-03-31 is a real v0.3.0 tag or a delay point"
}

