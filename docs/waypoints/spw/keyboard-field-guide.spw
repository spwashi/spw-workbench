# keyboard/FIELD-GUIDE — Keyboard Geology Orientation
#
# After commits 15–19. The keyboard is no longer a flat list.

#:layer #!pragmatics

^["geology model"]{
 #[strata]: "keybindings are geological layers, not a shortcut table"

 ^["layers"]{
 @features/keyboard/geology/ — ~"strata rendering + key capture"
 @features/keyboard/vim/vim-ast-motions.ts — ~"operator-aware AST navigation"
 @features/keyboard/shortcuts-data.ts — ~"discoverable modal shortcuts"
 }

 ^["interaction model"]{
 .[key-capture]: "dormant bindings displayed until activated"
 .[context-hints]: "bindings adapt to current editing context"
 .[navigable-topography]: "browse key layers like terrain"
 .[learnability]: "walkthrough introduces one stratum at a time"
 }
}

^["what changed since genesis"]{
 15-roadmap — ~"seed extracted as portable module"
 16-onboarding — ~"tour renderer + disclosure gate"
 17-refactor — ~"BoonHonk: CSS namespacing (.spw-ui-*, .spw-viz-*)"
 18-ux — ~"a11y: screen readers, container queries, RovingTabindex"
 19-keyboard — ~"vim motions + geology panel + dotted modifier chains"
}

#[resonance]: "keys are instruments, not shortcuts"

#>wonder_docs_waypoints_spw_keyboardfieldguide_1
?["How would an ecology portfolio express geology model?"]{
  #:depth #!stylistic ~#lens(ecological zone)
  ~#translation_target: "ecology"
  ~#source_concept: "geology model"
  !probe{ "rewrite the root frame in ecology vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[waypoint.completion_ratio, waypoint.blocking_count]
}

#>wonder_docs_waypoints_spw_keyboardfieldguide_2
?["How does this file's voice differ from @features?"]{
  #:depth #!educational // lens: molecular binding
  ~<@features> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]@features
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}
