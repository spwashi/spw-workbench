# The post-release epoch is complete.
# What follows (41–51) is the post-alpha hardening epoch.

#:layer #!pragmatics

^["what shipped since v0.1.0"]{
 .[viz]: "SVG flow renderer, cognitive axis indicators"
 .[keyboard]: "register bank, command bar, editor overlays"
 .[design]: "design mode lenses, stage 0→2, per-family tokens"
 .[contracts]: "component registry, web components strategy"
 .[subsystems]: "workers (DAP/LSP), audio (sfx), shaders (WebGL)"
 .[attention]: "attention economy model, event pipeline, debug overlay"
 .[composition]: "CSS co-location, SVG namespacing, personality echoes"
}

^["alpha vs release"]{
 v0.1.0 — ~"feature birth: themes, publishing, authoring, navigation"
 v0.2.0-alpha — ~"feature refinement: contracts, stages, attention, hardening"
}

^["composition pass"]{
 38-navigator — ~"document navigator → first-class, symbol navigation"
 39-themes — ~"canonical theme IDs, shader schemas, scope lifecycle"
 40-composition — ~"CSS in semantic groups, SVG motifs near consumers"

 &[merge]: "the final composition brings layers into alignment"
}

?["where next — spw/alpha-v020?"]{
 ~"post-alpha (41–51): keyboard domains, SpwFrame, env modes,"
 ~"Spw v0.2 spec, operant perspectives, design system audit,"
 ~"shader safety, component contracts, performance, PUSH_LONG"
 ~"— the history ends with a bytecode fix that proves the VM works."
}

