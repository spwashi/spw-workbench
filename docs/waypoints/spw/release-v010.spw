# RELEASE — v0.1.0 Orientation
#
# Commit 26-themes. Tagged v0.1.0. 703 files.
# Everything before this point is pre-release genesis + feature build.
# Everything after is post-release refinement toward alpha.

#:layer #!pragmatics

^["theme personality system"]{
  ^["four families"]{
    @design/themes/core/nebula-dark.ts   — ~"cosmic glow, breath rhythms"
    @design/themes/core/nebula-light.ts  — ~"soft cosmic, gentle pulse"
    @design/themes/core/atelier-dark.ts  — ~"workshop precision, motion easing"
    @design/themes/core/atelier-light.ts — ~"craft warmth, focus envelope"
  }

  ^["personality bridge"]{
    @design/themes/cognitive-bridge.ts   — ~"JS→CSS: 7-trait personality → custom properties"
    @styles/themes/spirits.css           — ~"9 ambient @keyframes animations"
    @styles/themes/motifs/               — ~"SVG echo leitmotifs per family"
  }

  ^["liminal transitions"]{
    ~"three-phase theme metamorphosis"
    ~"magic numbers replaced with narrative token vars"
    ~"fractal echo deepening across spirit layers"
  }
}

^["release inventory"]{
  .[spec]:        "Spw v0.1.0-alpha specification complete"
  .[seed]:        "portable parser + lexer extracted"
  .[workbench]:   "editor, panels, keyboard geology, onboarding tours"
  .[design]:      "4 theme families, token system, personality bridge"
  .[publishing]:  "genre system, prism universe, authoring editor"
  .[navigation]:  "LoD layers, activation contexts, breadcrumbs"
  .[a11y]:        "screen reader announcements, RovingTabindex"
}

?["where next"]{
  ~"post-release (27–40): viz, contracts, stages, attention, hardening"
  ~"ends with v0.2.0-alpha"
}

?["At which spirit phase does a concept cross from potential to artifact?"]
  #:depth #!experiential  // lens: biome
  =raw: "?~<#.>@(#.)&[#.]*{#.}^" => $^[_.phase]
  ~<@docs/design/spw/spirit-sequence.spw>
  !probe{ "trace one concept through all 6 phases; find the phase boundary where ~ becomes ^ (materialization instant)" }

?["What is the phenomenology of reading a phase transition in source code?"]
  #:depth #!stylistic  // lens: texture
  ~#before: "~potential => ?wonder"
  ~#after: "!commit => ^artifact"
  !probe{ "capture the felt shift when scanning from ~ to ^; measure time-to-comprehension across 5 readers" }
