# infra/HARDENING — Pre-Alpha Hardening Checkpoint
#
# After commits 34–37. Three subsystems scaffolded and hardened.

#:layer #!pragmatics

^["subsystems"]{
  ^["workers"]{
    @platform/workers/           — ~"DAP/LSP protocol stubs + toggle"
    ~"dormant until user opts in"
  }
  ^["audio"]{
    @features/audio/             — ~"opt-in UI sound effects"
    ~"refined sfx envelopes, localized to active region"
  }
  ^["shaders"]{
    @features/shaders/           — ~"WebGL shader reactions"
    ~"localized to active region, theme-aware selection"
  }
}

^["attention model"]{
  @infra/context/focus-trail.ts   — ~"ancestry of focused elements"

  ?["Is attention binary?"]{
    ~"No. You exist at a point in a continuous field."
    ~"Intensity, proximity, and clarity are continuous coordinates."
  }

  ^["pipeline"]{
    .. local attention events + debug overlay
    .. tokens wired into panels and geology
    .. per-theme attention semantics
    .. staging controls in settings
  }
}

^["hardening pass"]{
  34-infra       — ~"transient UI registry, dock handle fix, build simplification"
  35-scaffolding — ~"workers + audio + shaders scaffolded"
  36-attention   — ~"attention economy unified with stage optics"
  37-hardening   — ~"cross-subsystem stabilization: a11y, PWA, operators canonized"
}

~#status: "all subsystems hardened — alpha-ready"

?["Which operator pairs are most frequently adjacent? What does proximity imply?"]
  #:depth #!educational  // lens: collection
  $%[op.bigram] => &[frequency.sort]
  ~<@docs/theory/spw/operator-atlas.spw>
  !probe{ "count all operator bigrams (~!, !^, ?~, etc.); the most frequent reveals the language's natural cadence" }

?["Do the 9 sigils form a monoid under concatenation with the tense ordering?"]
  #:depth #!mathematical  // lens: formula
  ~#sigil_set: [~, ?, <, #, ., >, @, &, *, !, %, =, ^]
  ~#identity: "?"  // interrogative as neutral element?
  !probe{ "check: is ? ∘ x = x ∘ ? = x for all sigils x? does the operation associate? if not, what algebraic structure IS it?" }
