# ARCHITECTURE — Genesis Checkpoint
#
# You have just completed the genesis epoch (01–14).
# This is what exists and why.

#:layer #!pragmatics

^["what exists"]{
  @src/seed/         — ~"lexer, parser, types — the extractable core"
  @src/app/          — ~"workbench shell, editor, panels"
  @src/core/         — ~"domain conventions, operators, events"
  @src/design/       — ~"tokens, token-migration, component coupling"
  @src/features/     — ~"keyboard manager, onboarding (scaffolded)"
  @src/infra/        — ~"timing hooks, state management"
  @src/lang/         — ~"semantic analyzer, canonical printer"
  @src/runtime/      — ~"session state, config loader, interpreter"
  @src/ui/           — ~"runtime HUD, component registry"
  @src/styles/       — ~"CSS token system (migrated from hardcoded)"
  @src/viz/          — ~"visualization domain (scaffolded)"
}

^["what protects it"]{
  @scripts/eslint-plugin-spw/  — ~"8 rules: async-safe, bonk, debt, internal, lens, portable, pure, typed"
  @scripts/analyzers/          — ~"pattern-learner (517 lines), perturbation fuzzer"
  @scripts/generators/         — ~"domain scaffolder (375 lines)"
}

^["what documents it"]{
  @docs/index.spw              — ~"root navigation map"
  @docs/plans/spw/architecture.spw       — ~"layer stack"
  @docs/features/spw/onboarding.spw      — ~"guided reading order"
  @docs/contributing/          — ~"4 contributor personas: engineer, hobby, researcher, common"
  @lib/spw-v0.1.0-alpha/      — ~"language specification (SPEC, CONTAINERS, OPERATORS…)"
}

^["principles established"]{
  .[layer-purity]: "imports flow inward only"
  .[seed-portability]: "seed/ has zero workbench deps"
  .[token-migration]: "hardcoded → token → variable → theme"
  .[single-responsibility]: "each file has one reason to change"
}

?["where next"]{
  ~"the next epoch (15–26) adds features: keyboard geology,"
  ~"onboarding tours, CSS namespacing, navigation layers,"
  ~"publishing, authoring, and theme personality."
  ~"it ends with v0.1.0."
}
