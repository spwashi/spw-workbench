# runtime/ANATOMY — Runtime System Orientation
#
# After commits 20–22. The runtime has three new dimensions.

#:layer #!pragmatics

^["semantic features"]{
  @design/semantics/features.ts  — ~"intensity, proximity, clarity manifold"
  @viz/flow/                     — ~"unified visual language for flow nodes"

  #[manifold]: "a point in semantic space has coordinates, not categories"
}

^["operational physics"]{
  @docs/theory/md/operational-physics.md   — ~"saturation-based semantics"
  @docs/theory/spw/operators.spw          — ~"operator, lens, probe, container algebras"

  ~#axiom: "Personality lives in perspective. Determinism lives in structure."
}

^["navigation layers"]{
  @core/layers/layers.ts         — ~"fine, medium, coarse — LoD as first-class concept"
  @infra/state/activation-contexts.ts — ~"9 activation contexts with relevance maps"
  @platform/bootstrap/           — ~"split into modular components"

  ?[three questions]{
    ~"What is it made of?"
    ~"What does it group into?"
    ~"Where should attention move?"
  }
}

^["what changed"]{
  20-design      — ~"semantic features + breadcrumbs + projection indicators"
  21-physics     — ~"operational physics + saturation semantics + algebra specs"
  22-navigation  — ~"LoD layers + activation contexts + modular bootstrap"
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
