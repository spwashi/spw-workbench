# Features Index
#
# User-facing features, interaction models, and learning paths.

^["roots"]{
  @here: ~"."
}

^["learning"]{
  !["Onboarding & Flow"]
  .. ~<onboarding>"./onboarding.spw"              # Learning path for devs/LLMs
  .. ~<onboarding>"./onboarding-flow.spw"          # Onboarding flow reference
  .. ~<lens>"./lens-walk.spw"                      # Lens-walk prompting guide
}

^["interaction"]{
  !["Navigation & Input"]
  .. ~<vim>"./vim-guide.md"                        # Vim keybinding guide
  .. ~<keyboard>"./keyboard-audit.md"              # Keyboard audit
  .. ~<keyboard>"./keyboard-navigation-refactor-plan.md" # Refactor plan
  .. ~<nav>"./navigation-probe.spw"                # Focus calculus + breadcrumb semantics
}

^["system"]{
  !["Registry & Coherence"]
  .. ~<registry>"./feature-registry.spw"           # Feature naming/versioning
  .. ~<coherence>"./feature-coherence.spw"         # End-to-end feature coherence
}
