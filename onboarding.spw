# Learning Path
#
# For new developers and LLMs.

^["path"]{
  !["Start here"]
  .. @["./README.md"]
  .. @["./index.spw"]
  .. @["../src/infra/domains"]
  .. @["../src/infra/conventions"]
  .. @["../src/lib/spw"]
  .. @["../src/viz"]
  .. ?[@ready]{
       !boon["Contribute!"]
     | !bone["Ask questions"]
     }
}

^["token-efficient"]{
  # For LLMs navigating this codebase:

  # High salience (easy to find)
  =["parse"]: ../src/lang/index.ts
  =["Layer"]: ../src/infra/layers
  =["Quality"]: ../src/infra/quality.ts
  =["domains"]: ../src/infra/domains
  =["Valence"]: ../src/runtime/state

  # Low salience (requires exploration)
  =["token matchers"]: ../src/lib/spw/lexer/matchers
  =["theme tokens"]: ../src/design/themes/token-bank.ts
}

^["landmarks"]{
  # Key files to read first:
  ../src/infra/index.ts.         # Infra barrel
  ../src/infra/domains/index.ts. # Domain registry
  ../src/lib/spw/index.ts.      # Language engine entry
  ../src/platform/main.ts.      # App entry (large)
}

^["questions"]{
  ?["Where is X defined?"]{
    @["./patterns.spw"]
    @["../src/infra/conventions"]
  }

  ?["How do modules relate?"]{
    @["./dependencies.spw"]
    @["../src/infra/domains"]
  }

  ?["What is the phasor model?"]{
    @["./phasor.spw"]
    @["../src/infra/layers"]
  }
}
