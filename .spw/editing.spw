# Editing
#
# Subroot-oriented raw-text editing heuristics.

#>spw_editing
#:editor #!heuristics
#:layer #!pragmatics

^"intent"{
 ~#goal: "Orient editing behavior by subroot category."
 ~#source: @spw/shelves.spw
}

^category[macro]{
 subroots: [@biome/spells, @biome/expr, @biome/query]
 heuristics: {
 prefer_symbol_refs: true
 auto_quote: false
 preserve_container_adjacency: true
 prioritize_macro_folding: true
 }
}

^category[measurement]{
 subroots: [@harness/probes, @harness/evals, @biome/trace]
 heuristics: {
 prefer_structured_fields: true
 enforce_measure_keys: true
 suggest_aggregation_axes: true
 auto_quote: false
 }
}

^category[prose]{
 subroots: [@spw/literate, @spw/reflection, @docs]
 heuristics: {
 allow_raw_text: true
 preserve_line_rhythm: true
 semantic_anchor_prompts: true
 auto_quote: selective
 }
}

^category[runtime]{
 subroots: [@hot, @biome/algos, @biome/ops]
 heuristics: {
 prioritize_selector_resolution: true
 show_projection_owner: true
 highlight_generated_targets: true
 auto_quote: false
 }
}

#>wonder_spw_editing_1
?["What invariant holds across every frame in Editing?"]{
  #:depth #!computational // lens: material grain
  $^["_"]@here => %[shared.property]
  ~#hypothesis: "all frames in this file share ____"
  !probe{ "extract the property common to every frame in this file; if none exists, the file may lack cohesion or may be a deliberate collection." }
  $%[runtime.stage, runtime.queue_depth]
}

#>wonder_spw_editing_2
?["What was Editing before it was this, and what could it become?"]{
  #:depth #!mathematical // lens: formal structure
  ~#past: "git log --oneline -- .spw/editing.spw | head -3"
  ~#future: "what frame would you add next?"
  !probe{ "the file's git history IS its evolutionary record; the next natural frame reveals the author's trajectory." }
  $%[runtime.stage, runtime.queue_depth]
  ~<.spw/agents.spw>  // nearest neighbor
}
