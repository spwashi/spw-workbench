# Surface Archetypes
#
# Identity-free qualities that may be projected into future surfaces.

#>spw_surface_archetypes
#:registry #!surfaces
#:layer #!pragmatics

^["intent"]{
 goal: "Preserve reusable interaction and governance qualities without binding them to a domain, owner, route, or predicted deployment form."
 rule: "An archetype names what a surface does to attention and participation, not where it will be published."
}

^["archetypes"]{
 orienting_hub: .{
  function: [#welcome, #route, #context, #handoff]
  cadence: #steady_guiding
  evidence: [#entry_action, #route_success, #return_path]
 }
 guided_curriculum: .{
  function: [#teach, #sequence, #exercise, #reflect]
  cadence: #guided_escalation
  evidence: [#learning_goal, #exercise_result, #transfer]
 }
 exploratory_biome: .{
  function: [#wonder, #variation, #collision, #emergence]
  cadence: #metastable_spiral
  evidence: [#probe, #negative_control, #surviving_pattern]
 }
 installable_book: .{
  function: [#chapter, #continuity, #offline_reading, #annotation]
  cadence: #serial_chaptered
  evidence: [#navigation, #offline_truth, #revision_provenance]
 }
 analytic_engine: .{
  function: [#transform, #compare, #model, #explain]
  cadence: #analytic_turn
  evidence: [#input, #transformation, #falsifiable_output]
 }
 observatory: .{
  function: [#measure, #aggregate, #trace, #compare]
  cadence: #periodic_refresh
  evidence: [#source, #timestamp, #metric, #uncertainty]
 }
 reflective_feedback: .{
  function: [#signal, #response, #adjustment, #learning]
  cadence: #reflective_latency
  evidence: [#initial_state, #feedback, #changed_state]
 }
 coordination_protocol: .{
  function: [#claim, #wait, #handoff, #release]
  cadence: #serialized_turn_taking
  evidence: [#owner, #queue, #resolution, #failure_recovery]
 }
 artifact_exchange: .{
  function: [#materialize, #attribute, #transfer, #retain]
  cadence: #deliberate_exchange
  evidence: [#provenance, #consent, #ownership, #reversibility]
 }
 publication_press: .{
  function: [#draft, #edition, #release, #afterlife]
  cadence: #slow_durable
  evidence: [#source_revision, #editorial_gate, #published_artifact]
 }
 ephemeral_portal: .{
  function: [#invite, #reveal, #redirect, #close]
  cadence: #single_beat
  evidence: [#entry, #destination, #expiry]
 }
 seasonal_exhibit: .{
  function: [#occasion, #surprise, #participation, #memory]
  cadence: #bounded_cycle
  evidence: [#opening, #interaction, #closing, #archive]
 }
}

^["governance"]{
 status: [#idea, #internal_literature, #internal_tool, #installable, #public_beta, #governed, #retired]
 required: [#function, #audience, #entry_action, #artifact, #feedback_loop, #maintenance_owner]
 sensitive: [#privacy_mode, #review_gate, #retention, #discretion]
 rule: "Archetypes may combine, but each deployed surface declares its own identity and ownership outside this registry."
}

^["projection"]{
 input: [#archetype, #consumer_context, #constraints, #evidence]
 output: [#component, #page, #service, #exhibit, #publication]
 negative_controls: [#no_domain_assumption, #no_ownership_claim, #no_fixed_route, #no_required_host]
}

^["invariants"]{
 "An archetype is reusable and does not imply an owned domain.",
 "Future deployment remains unspecified until a consumer repository declares it.",
 "Retired identifiers are not retained as aliases, examples, or fixture names.",
}
