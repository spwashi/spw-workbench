# Pipeline Routing

^"routing"{
  #:pipeline #!dispatch
  ~#convention: "each domain maps to a named pipeline defined in publish.spw"
  ~#dormant_policy: "dormant surfaces remain intentionally unrouted until promoted."
  ~#blocked_by: {
    "sexymath4adults.com": "sensitive pipeline and review gate not yet in place"
  }

  "spwashi.com":           { pipeline: "default",  format: "html", ~#selector: "$^[\"_\"]@docs" }
  "spwashi.dev":           { pipeline: "default",  format: "html", ~#selector: "$^[\"_\"]@docs" }
  "spwashi.ink":           { pipeline: "exhibits", format: "html", ~#selector: "$^[\"_\"]@literate" }
  "spwashi.design":        { pipeline: "exhibits", format: "html", ~#selector: "$^[\"_\"]@docs/design" }
  "spwashi.ai":            { pipeline: "default",  format: "html", ~#selector: "$^[\"_\"]@docs/research" }
  "boonhonk.ing":          { pipeline: "exhibits", format: "html", ~#selector: "$^[\"_\"]@biome" }
  "factshift.com":         { pipeline: "api",      format: "json", ~#selector: "$^[\"_\"]@registries" }
  "factshift.center":      { pipeline: "default",  format: "html", ~#selector: "$^[\"_\"]@runtime" }
  "boon.land":             { pipeline: "exhibits", format: "html", ~#selector: "$^[\"_\"]@biome" }
  "bane.land":             { pipeline: "exhibits", format: "html", ~#selector: "$^[\"_\"]@biome" }
  "bone.land":             { pipeline: "exhibits", format: "html", ~#selector: "$^[\"_\"]@biome" }
  "bonk.land":             { pipeline: "exhibits", format: "html", ~#selector: "$^[\"_\"]@biome" }
  "honk.land":             { pipeline: "exhibits", format: "html", ~#selector: "$^[\"_\"]@biome" }
  "boof.land":             { pipeline: "exhibits", format: "html", ~#selector: "$^[\"_\"]@docs/features" }
  "lore.land":             { pipeline: "default",  format: "html", ~#selector: "$^[\"_\"]@docs" }
  "trope.wiki":            { pipeline: "default",  format: "html", ~#selector: "$^[\"_\"]@docs/theory" }
  "spw.quest":             { pipeline: "default",  format: "html", ~#selector: "$?[\"_\"]@spw" }
  "wap.christmas":         { pipeline: "exhibits", format: "html", ~#selector: "$^[\"wonder\"]@spw" }
  "wap.mom":               { pipeline: "exhibits", format: "html", ~#selector: "$^[\"wonder\"]@spw" }
  "brainstorm.monster":    { pipeline: "exhibits", format: "html", ~#selector: "$^[\"_\"]@docs/research" }
  "clit.video":            { pipeline: "default",  format: "html", ~#selector: "$^[\"_\"]@docs/features" }
  "smut.today":            { pipeline: "default",  format: "html", ~#selector: "$^[\"_\"]@docs/research" }
  "rpgwednesday.shop":     { pipeline: "default",  format: "html", ~#selector: "$^[\"_\"]@docs/features" }
  "attention.productions": { pipeline: "default",  format: "html", ~#selector: "$^[\"_\"]@docs/runtime" }
  "mutex.buzz":            { pipeline: "default",  format: "html", ~#selector: "$^[\"_\"]@runtime" }
  "autonomous.feedback":   { pipeline: "default",  format: "html", ~#selector: "$^[\"_\"]@docs/specs" }
}

#>wonder_spw_surfaces_domains_1
?["Which domain would be the strongest candidate for a first public surface?"]{
  #:depth #!computational
  ~#criteria: "content readiness x audience clarity x production feasibility x privacy burden"
  ~<./publish.spw>
  !probe{ "audit the selector for each routed domain. the best first launch candidate is the one whose selector already yields coherent material without forcing premature product promises." }
  $%[file.frame_count, file.annotation_density]
}

#>wonder_spw_surfaces_domains_2
?["What publication format emerges when Spw frames are the authoring primitive?"]{
  #:depth #!experiential
  ~#conventional: "EPUB packages XHTML chapters behind an OPF manifest and NCX navigation table"
  ~#native: "frames as chapters, layers as reading modes, wonder blocks as interactive marginalia, metrics as live annotations, and PWA installability as bookbinding"
  !probe{ "draft the OPF manifest for a three-chapter ebook where each chapter is a .spw file. which parts should remain EPUB-like, which should become PWA-native, and which belong only to the live web?" }
  $%[file.frame_count, file.annotation_density]
}
