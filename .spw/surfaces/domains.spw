# Domain Portfolio
#
# Forty domains comprising a publishing network for generative literature.
# Each domain anchors a distinct editorial voice within a shared
# infrastructure — the way imprints within a press house serve
# different readerships from a common production backbone.
#
# Producer: Spwashi
# Medium:   Generative ebooks and interactive publications
# Thesis:   Human creativity flourishes when structure invites play.

#>spw_surfaces_domains
#:registry #!domains
#:layer #!pragmatics

^"editorial_position"{
  ~#producer: "Spwashi"
  ~#medium: "extended ebooks — publications that evolve with their readers"
  ~#commitments: [
    "prioritize human creative agency over algorithmic convenience",
    "treat grammatical structure as a site of genuine intellectual pleasure",
    "hold irony and earnestness simultaneously without collapsing either",
    "design for decades of development, not quarters of growth",
  ]
}

# ── Spwashi Imprints ─────────────────────────────────────────────
#
# The producer's own surfaces. Sixteen domains forming a
# professional presence — from workshop tooling to retail editions.

^"imprints.spwashi"{
  #:cluster #!identity

  "spwashi.com":     { role: "hub",       ~#brief: "Central landing and editorial desk" }
  "spwashi.ink":     { role: "press",     ~#brief: "Publishing imprint — ebooks, limited editions, manuscripts" }
  "spwashi.art":     { role: "gallery",   ~#brief: "Visual and interactive art exhibitions" }
  "spwashi.media":   { role: "broadcast", ~#brief: "Audio, video, and long-form media production" }
  "spwashi.dev":     { role: "workshop",  ~#brief: "Developer tools — the Spw workbench, LSP, and parser ecosystem" }
  "spwashi.ai":      { role: "lab",       ~#brief: "Research prototypes and AI-assisted generative instruments" }
  "spwashi.design":  { role: "studio",    ~#brief: "Design systems, typographic exploration, interface craft" }
  "spwashi.college": { role: "academy",   ~#brief: "Structured curricula and self-directed learning paths" }
  "spwashi.org":     { role: "commons",   ~#brief: "Open-source governance, contributor onboarding, shared standards" }
  "spwashi.network": { role: "consortium", ~#brief: "Collaborator directory and cross-project coordination" }
  "spwashi.pro":     { role: "services",  ~#brief: "Consulting, commissioned work, and production partnerships" }
  "spwashi.biz":     { role: "operations", ~#brief: "Business administration, licensing, and distribution agreements" }
  "spwashi.store":   { role: "retail",    ~#brief: "Printed editions, merchandise, and collectible artifacts" }
  "spwashi.work":    { role: "folio",     ~#brief: "Selected works, case studies, and project documentation" }
  "spwashi.space":   { role: "sandbox",   ~#brief: "Public drafts, experiments, and works in progress" }
  "spwashi.click":   { role: "portal",    ~#brief: "Single-interaction entry points and curated first impressions" }
}

# ── Boonhonk Combinatorics ───────────────────────────────────────
#
# A genre built on five semantic primitives. Boonhonk treats
# language as a combinatoric material — words as atoms,
# sentences as molecules, grammars as bonds.

^"genre.boonhonk"{
  #:cluster #!combinatorics

  "boonhonk.ing":     { role: "engine",    ~#brief: "The genre itself — combinatoric text generation and grammatical play" }
  "boon.land":        { role: "benefit",   ~#brief: "The positive charge — advantage, gift, windfall" }
  "bane.land":        { role: "cost",      ~#brief: "The negative charge — obstacle, tax, friction" }
  "bone.land":        { role: "structure", ~#brief: "The invariant — skeleton, scaffold, load-bearing form" }
  "bonk.land":        { role: "event",     ~#brief: "The collision — consequence, contact, phase transition" }
  "honk.land":        { role: "signal",    ~#brief: "The interrupt — attention, announcement, pattern break" }
  "boonbanebone.com": { role: "triad",     ~#brief: "The three-body system: benefit, cost, and the structure that holds them" }
}

# ── Factshift ─────────────────────────────────────────────────────
#
# A physics engine for narrative and rhetoric. Facts have
# valence, momentum, and frame — Factshift models what happens
# when they change.

^"engine.factshift"{
  #:cluster #!dynamics

  "factshift.com": {
    role: "engine",
    ~#brief: "Models the dynamics of facts under transformation — valence shifts, frame rotations, interpretation drift"
    ~#flavoring: "each .land domain supplies a physics flavor: boon (thermodynamics of advantage), bane (friction and drag), bone (structural mechanics), bonk (collision dynamics), honk (signal propagation)"
  }
  "factshift.center": {
    role: "observatory",
    ~#brief: "Dashboard and analytical center — observe fact dynamics in aggregate, track shifts across domains"
  }
}

# ── Wonder & Mathematical Culture ─────────────────────────────────
#
# Five domains that use surprise, provocation, and humor to
# lower the barrier to genuine mathematical engagement.
# The strategy: irony is the surface; wonder is the payload.

^"wonder.mathematics"{
  #:cluster #!pedagogy

  "spw.quest":           { role: "guided",     ~#brief: "Structured explorations through Spw concepts — narrative-driven learning" }
  "brainstorm.monster":  { role: "ideation",   ~#brief: "High-energy creative sessions — structured divergence with monstrous enthusiasm" }
  "sexymath4adults.com": { role: "reclamation", ~#brief: "Reclaiming adult mathematical confidence — arithmetic shame has no place here" }
  "wap.christmas": {
    role: "seasonal",
    ~#brief: "Wonder About Pi — postironic seasonal math celebration"
    ~#arc: "initial Cardi B familiarity shock resolves into absurdly earnest engagement with π, e, and the rest of the transcendentals"
    ~#orientation: "asexual parody that spirals upward into sincerity"
  }
  "wap.mom": {
    role: "nurture",
    ~#brief: "Wonder About Pi — math wonder framed through care, patience, and parental encouragement"
    ~#orientation: "the same postironic arc as wap.christmas, grounded in domestic warmth"
  }
}

# ── Narrative & World-Building ────────────────────────────────────
#
# Tools for collaborative fiction, trope analysis, and the
# kind of imaginative prompts that give characters agency.

^"narrative.worldbuilding"{
  #:cluster #!fiction

  "lore.land":   { role: "encyclopedia", ~#brief: "Collaborative world-building — structured lore management for shared fictional universes" }
  "trope.wiki":  { role: "taxonomy",     ~#brief: "Narrative pattern catalog — identification, subversion, and recombination of storytelling conventions" }
  "clit.video": {
    role: "prompt",
    ~#brief: "Abstract creative prompt surface — a title that asks authors what their characters would do with the idea"
    ~#editorial_note: "the domain name IS the creative exercise; content is conceptual, not explicit"
  }
}

# ── Social & Cultural Practice ────────────────────────────────────
#
# Domains oriented toward cultural commentary, ritual design,
# and aesthetic community formation.

^"culture.social"{
  #:cluster #!practice

  "smut.today":           { role: "commentary",  ~#brief: "Cultural criticism through provocative framing — sincerity beneath a tabloid surface" }
  "newyear.life":         { role: "ritual",      ~#brief: "Annual renewal practice — intention architecture, reflective writing, generative resolutions" }
  "tealstripesvibes.com": { role: "aesthetic",   ~#brief: "A visual identity system — teal stripes as mood, palette, and design philosophy" }
  "tealstripesvibes.org": { role: "collective",  ~#brief: "Community organized around the teal stripes aesthetic and its cultural values" }
}

# ── Production Infrastructure ─────────────────────────────────────
#
# The operational backbone — attention management and
# collaborative synchronization for multi-author workflows.

^"infrastructure.production"{
  #:cluster #!operations

  "attention.productions": { role: "studio",       ~#brief: "The production company — attention as both the medium and the primary constraint" }
  "mutex.buzz":            { role: "coordination", ~#brief: "Collaborative locking and authorial turn-taking — mutual exclusion for creative processes" }
}

# ── Topology ──────────────────────────────────────────────────────

^"topology"{
  #:architecture #!connections

  hub_model: {
    ~#center: "spwashi.com"
    ~#principle: "every spwashi.* domain links back to .com; .com links forward to each imprint by role"
  }

  genre_engine: {
    ~#center: "boonhonk.ing"
    ~#primitives: ["boon.land", "bane.land", "bone.land", "bonk.land", "honk.land"]
    ~#composite: "boonbanebone.com"
    ~#application: "factshift.com"
  }

  wonder_spiral: {
    ~#entry: "wap.christmas or wap.mom"
    ~#arc: "familiarity shock → curiosity → sexymath4adults.com → spw.quest → spwashi.college"
    ~#design_principle: "irony lowers the threshold; wonder sustains the engagement"
  }

  publishing_chain: {
    ~#creation: "spwashi.dev → spwashi.ai → spwashi.design"
    ~#publication: "spwashi.ink → spwashi.store → spwashi.media"
    ~#community: "spwashi.org → spwashi.network → spwashi.college"
  }
}

# ── Pipeline Routing ──────────────────────────────────────────────

^"routing"{
  #:pipeline #!dispatch
  ~#convention: "each domain maps to a named pipeline defined in publish.spw"

  "spwashi.dev":      { pipeline: "default",  format: "html",  ~#selector: "$^[\"_\"]@docs" }
  "spwashi.ink":      { pipeline: "exhibits", format: "html",  ~#selector: "$^[\"_\"]@literate" }
  "boonhonk.ing":     { pipeline: "exhibits", format: "html",  ~#selector: "$^[\"_\"]@biome" }
  "factshift.com":    { pipeline: "api",      format: "json",  ~#selector: "$^[\"_\"]@registries" }
  "spw.quest":        { pipeline: "default",  format: "html",  ~#selector: "$?[\"_\"]@spw" }
  "trope.wiki":       { pipeline: "default",  format: "html",  ~#selector: "$^[\"_\"]@docs/theory" }
  "lore.land":        { pipeline: "default",  format: "html",  ~#selector: "$^[\"_\"]@docs" }
  "wap.christmas":    { pipeline: "exhibits", format: "html",  ~#selector: "$^[\"wonder\"]@spw" }
  "brainstorm.monster": { pipeline: "exhibits", format: "html", ~#selector: "$^[\"_\"]@docs/research" }
}

#>wonder_spw_surfaces_domains_1
?["Which domain would be the strongest candidate for a first public surface?"]{
  #:depth #!computational
  ~#criteria: "content readiness × audience clarity × production feasibility"
  ~<./publish.spw>
  !probe{ "audit the selector for each domain in the routing table. the domain whose selector returns the most frames today is the natural launch candidate." }
  $%[file.frame_count, file.annotation_density]
}

#>wonder_spw_surfaces_domains_2
?["What publication format emerges when Spw frames are the authoring primitive?"]{
  #:depth #!experiential
  ~#conventional: "EPUB packages XHTML chapters behind an OPF manifest and NCX navigation table"
  ~#native: "frames as chapters, layers as reading modes, wonder blocks as interactive marginalia, metrics as live annotations"
  !probe{ "draft the OPF manifest for a three-chapter ebook where each chapter is a .spw file. which elements have no EPUB equivalent?" }
  $%[file.frame_count, file.annotation_density]
}
