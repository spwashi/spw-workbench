# Topology

^"topology"{
  #:architecture #!connections

  hub_model: {
    ~#center: "spwashi.com"
    ~#principle: "every spwashi.* domain links back to the starting room; the hub routes by role, audience, and current phase"
  }

  hub_segmentation: {
    newcomers: {
      ~#entry: "spwashi.com"
      ~#phase: "governed-surface"
      ~#surfaces: ["spwashi.com", "spw.quest", "wap.christmas", "wap.mom"]
    }
    builders: {
      ~#entry: "spwashi.dev"
      ~#phase: "public-beta"
      ~#surfaces: ["spwashi.dev", "factshift.com", "mutex.buzz"]
    }
    readers: {
      ~#entry: "spwashi.ink"
      ~#phase: "public-beta"
      ~#surfaces: ["spwashi.ink", "lore.land", "trope.wiki", "rpgwednesday.shop"]
    }
    researchers_and_designers: {
      ~#entry: "spwashi.ai"
      ~#phase: "public-beta"
      ~#surfaces: ["spwashi.ai", "spwashi.design", "autonomous.feedback", "brainstorm.monster"]
    }
  }

  factshift_family: {
    ~#engine: "factshift.com"
    ~#realms: ["boon.land", "bane.land", "bone.land", "bonk.land", "honk.land"]
    ~#companion: "boonhonk.ing"
    ~#composite: "boonbanebone.com"
    ~#reading: "factshift explains the physics; the realms make it habitable -- gift, drag, scaffold, impact, signal"
  }

  wonder_spiral: {
    ~#entry: "wap.christmas or wap.mom"
    ~#arc: "familiarity shock -> curiosity -> recipes, puzzles, and wonder -> spw.quest -> spwashi.college"
    ~#design_principle: "irony lowers the threshold; wonder sustains it; fulfillment makes the idea something you can hold"
  }

  lore_constellation: {
    ~#center: "lore.land"
    ~#companions: ["trope.wiki", "boof.land", "clit.video"]
    ~#reading: "world-building, story patterns, a protagonist you follow, and a place to participate -- one ecology"
  }

  sensitive_surfaces: {
    ~#domains: ["clit.video", "smut.today", "sexymath4adults.com"]
    ~#requirement: "privacy by default, discretion by design, decentralization as a viable path"
    ~#pipeline: "sensitive -- requires dedicated pipeline in publish.spw before these surfaces go live"
  }

  publishing_chain: {
    ~#creation: "spwashi.dev -> spwashi.ai -> spwashi.design"
    ~#publication: "spwashi.ink -> spwashi.store -> spwashi.media"
    ~#community: "spwashi.org -> spwashi.network -> spwashi.college"
  }
}

