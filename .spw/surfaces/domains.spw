# Wonder And Math Culture

^"wonder.mathematics"{
  #:cluster #!pedagogy

  "spw.quest": {
    role: "guided"
    ~#status: "active"
    ~#brief: "Progression surface through abstract linguistics, the metaphysics of Spw, and the typography of the language itself"
    ~#marketing: "learning paths paced by invitation, not intimidation -- from abstract linguistic structure to typographic force and animation-universe physics novelty"
    ~#curriculum_arc: "abstract linguistics -> metaphysics of language -> typography as semantic physics -> animation-universe novelty -> biome entry through the boonhonk realms"
    ~#capstone_realm: "bonk.land"
    ~#capstone_reading: "bonk.land is the realm blessed by coincidence, where impact, comic timing, and abrupt phase change make animation-universe physics feel native rather than ornamental"
    ~#utility_loop: "guide readers from concept study into authored Spw snippets, then into reusable biome-facing exercises"
    ~#spw_usage: ["frames introduce concepts", "inline snippets demonstrate syntax", "probes ask reflective questions", "selectors unlock next-stage readings"]
  }
  "sexymath4adults.com": {
    role: "reclamation"
    ~#status: "sensitive-pending"
    ~#brief: "Adult mathematical confidence-building without shame"
    ~#marketing: "you wanted math once, or you want it now -- this is the surface that wants you back"
    ~#sensitivity_tier: "sensitive"
  }
  "wap.christmas": {
    role: "seasonal"
    ~#status: "active"
    ~#brief: "Wondering About Pi with a holiday-facing, absurdly earnest outer shell"
    ~#marketing: "the name gets you in the door; the wonder keeps you -- pi, pie, and seasonal generosity"
    ~#arc: "familiarity shock -> curiosity -> sincere engagement with pi, e, and neighboring wonders"
  }
  "wap.mom": {
    role: "nurture"
    ~#status: "active"
    ~#brief: "Wondering About Pi through care, patience, and domestic encouragement"
    ~#marketing: "the warmer sibling -- wonder, recipes, patience, and practical paths into the math underneath"
    ~#arc: "gentle entry -> sustained encouragement -> recipes, puzzles, and fulfillment that makes the abstract tangible"
  }
  "brainstorm.monster": {
    role: "collective-ideation"
    ~#status: "active"
    ~#brief: "Collective and local development of concepts with strong return-to-ground-state behavior"
    ~#marketing: "think loud, think together, then let it rest -- an ideation lab that knows when to hibernate"
    ~#interaction_model: "supports active divergence, local incubation, and hibernating storage without losing conceptual continuity"
  }
}

# Narrative And World-Building

^"narrative.worldbuilding"{
  #:cluster #!fiction

  "lore.land": {
    role: "installable-book"
    ~#status: "active"
    ~#brief: "Collaborative world-building and lore management for shared fictional universes"
    ~#marketing: "a living book you can install, carry, annotate, and resume -- world-building as portable practice"
    ~#platform: "installable book PWA"
    ~#connection: "home terrain for Boof as protagonist"
  }
  "trope.wiki": {
    role: "taxonomy"
    ~#status: "active"
    ~#brief: "Narrative structure reference and long-term probe into funky transrealism"
    ~#marketing: "a living index of story patterns and reality moves -- used to seed, tag, and stress-test creative work across the network"
    ~#practice: "treat trope structure as an ongoing design instrument, not a dead encyclopedia"
    ~#probe_function: "tests how trope language, physics metaphors, and transreal narrative mechanics can inform biome construction without collapsing into empty jargon"
    ~#utility_loop: "tag patterns, compare trope families, and feed the results into design, lore, and snippet-ready concept inventories"
    ~#spw_usage: ["frames hold trope entries", "tag-like snippet refs connect concepts across surfaces", "selectors assemble comparative trope sets", "projection targets publish lore and design views"]
  }
  "clit.video": {
    role: "ugc-hub"
    ~#status: "active"
    ~#brief: "User-generated content hub built around provocative conceptual prompts"
    ~#marketing: "the title does the provoking; the platform does the thinking -- participatory publishing, user-generated ecology"
    ~#policy: "adult-adjacent participation requires privacy, discretion, and decentralized publication options"
    ~#sensitivity_tier: "sensitive"
  }
}

^"research_hooks"{
  boonhonk_timing: {
    ~#surfaces: ["boonhonk.ing", "bonk.land", "spw.quest", "trope.wiki"]
    ~#focus: "timing signatures for coincidence, collision, and transreal readability"
    ~#measures: ["token cadence", "operator density", "phase-shift markers", "probe completion lag"]
    ~#control: "flat explanatory passages with no timing-sensitive turn"
  }
  snippet_tokenization: {
    ~#surfaces: ["spw.quest", "trope.wiki", "boonhonk.ing"]
    ~#focus: "whether tags, snippets, and concept refs become reusable without losing semantic identity"
    ~#measures: ["snippet reuse count", "tag propagation", "concept stability across projections", "token novelty"]
    ~#control: "unstructured prose references to the same concepts"
  }
  orientation_entry: {
    ~#surfaces: ["spwashi.com", "spwashi.dev", "spwashi.ink", "spwashi.design", "spwashi.click"]
    ~#focus: "how quickly different entry surfaces establish stance, route, and confidence"
    ~#measures: ["route recognition lag", "token contrast", "handoff clarity", "operator density by first screen"]
    ~#control: "generic landing-page prose with no route-specific fingerprints"
  }
  collective_feedback: {
    ~#surfaces: ["autonomous.feedback", "mutex.buzz", "brainstorm.monster", "spwashi.org", "spwashi.network"]
    ~#focus: "whether collaborative and governance surfaces preserve agency under feedback, locking, and divergence"
    ~#measures: ["response latency", "turn-taking clarity", "divergence recovery", "critique uptake without drift"]
    ~#control: "single-author update flows with no collective interaction"
  }
  collectible_materialization: {
    ~#surfaces: ["spwashi.ink", "spwashi.store", "rpgwednesday.shop", "lore.land"]
    ~#focus: "when language, lore, and collectibles become ownable without losing conceptual coherence"
    ~#measures: ["artifact legibility", "edition-to-object continuity", "badge readability", "ownership token stability"]
    ~#control: "download-only distribution with no collectible semantics"
  }
  discretion_readability: {
    ~#surfaces: ["clit.video", "smut.today", "sexymath4adults.com", "spw.rest"]
    ~#focus: "how privacy, discretion, and pacing alter timing and token readability"
    ~#measures: ["consent clarity", "attention calm", "privacy-default comprehension", "exit safety perception"]
    ~#control: "ordinary public-facing flows with no discretion tuning"
  }
}

#>wonder_spw_surfaces_domains_3
?["What timing profile makes bonk feel like revelation instead of random noise?"]{
  #:depth #!computational // lens: measured coincidence
  $^["_"]@here => %[shared.property]
  ~#surfaces: ["bonk.land", "spw.quest", "boonhonk.ing"]
  ~#hypothesis: "bonk becomes legible when abrupt transitions arrive with recognizable cadence and recover into stable structure quickly enough to teach"
  !probe{ "compare a collision exercise, a quest lesson, and a biome exhibit. where do token cadence and phase markers distinguish productive bonk from empty interruption?" }
  $%[file.token_count, file.operator_density]
}

#>wonder_spw_surfaces_domains_4
?["When do snippet tags start acting like instantiable concepts rather than decorative labels?"]{
  #:depth #!educational // lens: concept exchange
  $^["_"]@here => %[shared.property]
  ~#surfaces: ["spw.quest", "trope.wiki", "boonhonk.ing"]
  ~#hypothesis: "snippet tags become useful once they preserve identity across reference, instantiation, and projection"
  !probe{ "trace one concept through authored snippet, trope index entry, and biome exhibit. what token or tag structures preserve recognizability across all three?" }
  $%[file.token_count, file.frame_count]
}

#>wonder_spw_surfaces_domains_5
?["Which sites collapse into each other once their fingerprints are normalized?"]{
  #:depth #!mathematical // lens: normalized difference
  $^["_"]@here => %[shared.property]
  ~#surfaces: ["spwashi.com", "spwashi.dev", "spwashi.ink", "boonhonk.ing", "trope.wiki", "rpgwednesday.shop", "autonomous.feedback"]
  ~#hypothesis: "a healthy portfolio keeps cross-site kinship without allowing two supposedly different domains to normalize to the same token/timing posture"
  !probe{ "compare the fingerprint index against actual site copy and snippet behavior. which pair looks distinct in naming but collapses under token cadence, lead operator, and concept refs?" }
  $%[file.token_count, file.operator_density]
}

#>wonder_spw_surfaces_domains_6
?["Where should a token-timing research loop start if you want the whole ecosystem to benefit?"]{
  #:depth #!experiential // lens: portfolio instrumentation
  $^["_"]@here => %[shared.property]
  ~#surfaces: ["spwashi.com", "spw.quest", "boonhonk.ing", "trope.wiki", "autonomous.feedback", "rpgwednesday.shop"]
  ~#hypothesis: "the best first research loop touches orientation, learning, biome semantics, social reflection, and materialization together"
  !probe{ "pick the smallest cross-site token/timing study that would improve onboarding, snippet identity, and collectible semantics at the same time." }
  $%[file.frame_count, file.annotation_density]
}

