# Domain Portfolio
#
# Portfolio registry for the publishing, software, learning, and
# community surfaces that orbit the Spw workbench.
# Each domain is a public surface with its own editorial stance,
# product direction, and infrastructure needs, while still drawing
# from shared publishing and runtime machinery.
#
# Producer: Spwashi
# Medium:   generative books, interactive publications, tools, and social surfaces
# Thesis:   human creativity flourishes when structure invites play

#>spw_surfaces_domains
#:registry #!domains
#:layer #!pragmatics

^"editorial_position"{
  ~#producer: "Spwashi"
  ~#medium: "books, tools, exhibits, learning systems, and collaborative publishing surfaces"
  ~#tone: "fearless, precise, warm without being soft -- every sentence should sound like something you'd say aloud to someone you respect"
  ~#commitments: [
    "human creative agency is the point, not a constraint to route around",
    "grammatical structure is a genuine source of pleasure and should feel like one",
    "irony and earnestness live together here; neither wins by default",
    "this is built for decades of development, not quarters of growth",
    "each domain carries its own voice; the publishing machinery stays shared",
    "sensitive and adult surfaces ship with privacy, discretion, and decentralization from day one",
  ]
}

^"portfolio_invariants"{
  ~#count: 44
  ~#scope: "all listed domains are intended as full surfaces, regardless of current implementation maturity"
  ~#shared_stack: "select -> transform -> validate -> emit, with domain-specific framing layered on top"
  ~#shared_question: "does this surface want to be read, used, joined, or navigated -- and when does it want to be more than one of those?"
  ~#status_vocabulary: ["active", "dormant", "sensitive-pending"]
  ~#launch_ladder: ["idea", "internal-literature", "internal-tool", "public-beta", "governed-surface", "sensitive-surface"]
  ~#routing_rule: "active surfaces need a route or an explicit blocked-by note; dormant surfaces can remain listed but intentionally unrouted"
}

^"platform_constraints"{
  ~#branding_anchor: "spwashi.com has existing branding and remains the canonical public anchor"
  ~#existing_codebases: [
    "factshift.com already has a codebase",
    "boon.land / bane.land / bone.land / bonk.land / honk.land extend the factshift.com codebase and should read as realms",
    "lore.land has precedent but can restart as an installable book PWA",
  ]
  ~#sensitive_surface_policy: [
    "privacy-preserving analytics by default -- no opt-in required",
    "discretion-first architecture: identity, preferences, and participation trails stay invisible unless a person chooses otherwise",
    "decentralized publishing and storage remain viable paths, especially where trust is personal",
  ]
}

^"launch_governance"{
  ~#active_rule: "active surfaces require audience, launch phase, QA gate, and a routing entry."
  ~#dormant_rule: "dormant surfaces remain in portfolio memory but do not consume routing or launch attention."
  ~#sensitive_pending_rule: "sensitive-pending surfaces require dedicated pipeline + discretion review before activation."
  ~#spiritual_testing_path: [
    "literature claim",
    "seed or selector expression",
    "runtime or telemetry behavior",
    "editor/workbench legibility",
    "publish projection",
    "public surface fit",
  ]
}

# Spwashi Network

^"network.spwashi"{
  #:cluster #!identity

  "spwashi.com": {
    role: "hub"
    ~#status: "active"
    ~#brief: "Primary branded anchor for the whole network"
    ~#marketing: "the starting room -- portfolio, orientation, and a clear path into whatever you came here looking for"
  }
  "spwashi.dev": {
    role: "workshop"
    ~#status: "active"
    ~#brief: "Developer-facing home for the workbench, parser, LSP, and publishing infrastructure"
    ~#marketing: "language tools you can read all the way through -- parser, runtime, and editor in the open"
  }
  "spwashi.ai": {
    role: "lab"
    ~#status: "active"
    ~#brief: "Research and instrument design for AI-assisted generative systems"
    ~#marketing: "structured co-creation with machines -- prompting, assistance, and generative instruments"
