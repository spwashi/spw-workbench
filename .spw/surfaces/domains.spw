# Boonhonk Realms

^"realm.boonhonk"{
  #:cluster #!combinatorics

  "boonhonk.ing": {
    role: "engine"
    ~#status: "active"
    ~#brief: "The genre engine and public conceptual center for multidimensional production wonder"
    ~#marketing: "recursively developmental linguistics, performative reflection, physical chemistry models, and genre hybridization as live biome construction"
    ~#guiding_principles: ["recursively developmental linguistics", "performative reflection", "physical chemistry models", "genre hybridization targets", "long-term expansion capacity"]
    ~#biome_model: "developmental physics for culture, where concepts accrete, react, condense, and phase-shift across narrative and operational surfaces"
    ~#reality_posture: "supports narrative realities, quantum-like interpretive branching, and transreal crossings when the governing metaphor stays legible"
  }
  "boon.land": {
    role: "realm"
    ~#status: "active"
    ~#brief: "Realm of advantage, gift, uplift, and positive charge"
    ~#marketing: "where benefit has weight, cost, and story -- the gift that knows what it costs"
    ~#inheritance: "extends factshift.com codebase"
  }
  "bane.land": {
    role: "realm"
    ~#status: "active"
    ~#brief: "Realm of drag, friction, obstacle, and cost"
    ~#marketing: "the weight that makes choices real -- friction, drag, and the price of moving"
    ~#inheritance: "extends factshift.com codebase"
  }
  "bone.land": {
    role: "realm"
    ~#status: "active"
    ~#brief: "Realm of structure, scaffold, and invariance"
    ~#marketing: "what remains after you strip everything else away -- scaffold, load, invariance"
    ~#inheritance: "extends factshift.com codebase"
  }
  "bonk.land": {
    role: "realm"
    ~#status: "active"
    ~#brief: "Realm of collision, event, consequence, and abrupt phase transition"
    ~#marketing: "impact -- what happens when systems and stories actually hit something"
    ~#inheritance: "extends factshift.com codebase"
    ~#coincidence_blessing: "blessed by coincidence; a realm where slapstick timing, phase transition, and improbable contact can reveal hidden structure"
  }
  "honk.land": {
    role: "realm"
    ~#status: "active"
    ~#brief: "Realm of signal, interruption, pattern break, and announcement"
    ~#marketing: "alarm. invitation. noise on purpose. attention as event."
    ~#inheritance: "extends factshift.com codebase"
  }
  "boof.land": {
    role: "character-realm"
    ~#status: "active"
    ~#brief: "A realm organized around Boof, a dog and protagonist who carries lore wherever he goes"
    ~#marketing: "a dog, a world, and a way in -- character-driven entry through affection and motion"
    ~#connection: "Boof is a protagonist of lore.land"
  }
  "boonbanebone.com": {
    role: "triad"
    ~#status: "dormant"
    ~#brief: "Composite surface for benefit, cost, and structure held in dynamic relation"
    ~#marketing: "gift, drag, scaffold -- the three forces explained together for newcomers"
  }
}

# Factshift Engine

^"engine.factshift"{
  #:cluster #!dynamics

  "factshift.com": {
    role: "engine"
    ~#status: "active"
    ~#brief: "Physics engine for narrative and rhetoric under transformation"
    ~#marketing: "fact dynamics -- how frames rotate, interpretations drift, and valence moves"
    ~#relationship: "base code lineage for the boon/bane/bone/bonk/honk realm family"
  }
  "factshift.center": {
    role: "observatory"
    ~#status: "active"
    ~#brief: "Analytical center for observing fact dynamics in aggregate"
    ~#marketing: "the field station -- dashboard and atlas for watching changes propagate"
  }
}

# Wonder And Math Culture

^"wonder.mathematics"{
  #:cluster #!pedagogy

  "spw.quest": {
    role: "guided"
    ~#status: "active"
    ~#brief: "Progression surface through abstract linguistics, the metaphysics of Spw, and the typography of the language itself"
    ~#marketing: "learning paths paced by invitation, not intimidation -- from abstract linguistic structure to typographic force and animation-universe physics novelty"
    ~#curriculum_arc: "abstract linguistics -> metaphysics of language -> typography as semantic physics -> animation-universe novelty -> biome entry through the boonhonk realms"
    ~#capstone_realm: "bonk.land"
    ~#capstone_reading: "bonk.land is the realm blessed by coincidence, where impact, comic timing, and abrupt phase change make animation-universe physics feel native rather than ornamental"
  }
  "sexymath4adults.com": {
    role: "reclamation"
    ~#status: "sensitive-pending"
    ~#brief: "Adult mathematical confidence-building without shame"
    ~#marketing: "you wanted math once, or you want it now -- this is the surface that wants you back"
    ~#sensitivity_tier: "sensitive"
  }
  "wap.christmas": {
    role: "seasonal"
    ~#status: "active"
    ~#brief: "Wondering About Pi with a holiday-facing, absurdly earnest outer shell"
    ~#marketing: "the name gets you in the door; the wonder keeps you -- pi, pie, and seasonal generosity"
    ~#arc: "familiarity shock -> curiosity -> sincere engagement with pi, e, and neighboring wonders"
  }
  "wap.mom": {
    role: "nurture"
    ~#status: "active"
    ~#brief: "Wondering About Pi through care, patience, and domestic encouragement"
    ~#marketing: "the warmer sibling -- wonder, recipes, patience, and practical paths into the math underneath"
    ~#arc: "gentle entry -> sustained encouragement -> recipes, puzzles, and fulfillment that makes the abstract tangible"
  }
  "brainstorm.monster": {
    role: "collective-ideation"
    ~#status: "active"
    ~#brief: "Collective and local development of concepts with strong return-to-ground-state behavior"
    ~#marketing: "think loud, think together, then let it rest -- an ideation lab that knows when to hibernate"
    ~#interaction_model: "supports active divergence, local incubation, and hibernating storage without losing conceptual continuity"
  }
}

# Narrative And World-Building

^"narrative.worldbuilding"{
  #:cluster #!fiction

  "lore.land": {
    role: "installable-book"
    ~#status: "active"
    ~#brief: "Collaborative world-building and lore management for shared fictional universes"
    ~#marketing: "a living book you can install, carry, annotate, and resume -- world-building as portable practice"
    ~#platform: "installable book PWA"
    ~#connection: "home terrain for Boof as protagonist"
  }
  "trope.wiki": {
    role: "taxonomy"
    ~#status: "active"
    ~#brief: "Narrative structure reference and long-term probe into funky transrealism"
    ~#marketing: "a living index of story patterns and reality moves -- used to seed, tag, and stress-test creative work across the network"
    ~#practice: "treat trope structure as an ongoing design instrument, not a dead encyclopedia"
    ~#probe_function: "tests how trope language, physics metaphors, and transreal narrative mechanics can inform biome construction without collapsing into empty jargon"
  }
  "clit.video": {
    role: "ugc-hub"
    ~#status: "active"
    ~#brief: "User-generated content hub built around provocative conceptual prompts"
    ~#marketing: "the title does the provoking; the platform does the thinking -- participatory publishing, user-generated ecology"
    ~#policy: "adult-adjacent participation requires privacy, discretion, and decentralized publication options"
    ~#sensitivity_tier: "sensitive"
  }
}

