# Plugins Surface Stub
#
# Bootstrap catalog for plugin surface entries.
# Concrete plugins live as sibling `.spw` files and register themselves with
# `^"plugin"` frames when they are ready to participate in discovery.

#>spw_surfaces_plugins_index
#:registry #!plugins
#:layer #!pragmatics

^"plugins"{
  ~#status: "stub"
  ~#scan: ".spw/surfaces/plugins/*.spw"
  ~#registration_frame: "^\"plugin\""
  ~#note: "keep this file as catalog glue; add concrete plugin files beside it"
}

^"next_steps"{
  ~#create: "one .spw file per plugin entry"
  ~#validate: "selectors and outputs should satisfy surfaces/plugin-protocol.spw"
  ~#publish: "surface-specific transforms live outside the stub"
}
