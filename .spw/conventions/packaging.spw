# Packaging Conventions
#
# Canon contract for how the workbench relates source TypeScript, dist artifacts,
# installers, and release bundles.

#>spw_packaging_conventions
#:convention #!packaging
#:layer #!pragmatics

^"workspace_contract"{
 repo_runtime: "source-first"
 checkout_entrypoints: ["scripts/*.ts", "packages/*/src/*.ts"]
 installer_bias: "prefer native TypeScript execution from a checkout or cloned workspace"
 dist_role: "derived release artifact, never the canonical authoring surface"
 version_truth: "root package.json is the single source of truth for versioning"
}

^"artifact_contract"{
 jsdist_build: "npm run build:jsdist"
 jsdist_pack_check: "npm run pack:jsdist:dry"
 release_bundle: "npm run bundle:release"
 dist_contents: ["runtime js", "cli js", "declaration facades", "dist/types tree", "derived package manifest"]
}

^"invariant"{
  "The repo stays runnable from source TypeScript for local development, installers, and checkout-native workflows.",
  "dist/ is disposable and reproducible; deleting it must never delete authoring truth.",
  "Release artifacts derive metadata from the root manifest rather than inventing a second version ledger.",
  "Changing publish mechanics must not silently change the workspace's default execution model.",
}

#>wonder_spw_conventions_packaging_1
?["What asymmetry does Packaging Conventions preserve on purpose?"]{
  #:depth #!educational // lens: ecological zone
  ~#hint: "source truth vs derived artifact"
  !probe{ "list which surfaces are editable, which are generated, and which are publishable; the asymmetry is the point." }
  $%[convention.adherence_score, convention.violation_sites]
}
