# Submodule Conventions
#
# Canon contract for mounting the workbench into consumer-owned .spw surfaces.

#>spw_submodule_conventions
#:convention #!installation
#:layer #!pragmatics

^"boundary_contract"{
 consumer_root: ".spw/"
 consumer_owns: [".spw/index.spw", ".spw/workspace.spw", ".spw/mount.spw", ".spw/conventions/*", ".spw/claims/*", ".spw/audits/*"]
 workbench_root: ".spw/_workbench"
 workbench_provides: ["parser", "runtime", "LSP", "CLI", "spec library", "agent tooling"]
 prefix_rule: "\"_\" marks infrastructure roots; they are mounted, versioned, and queryable without masquerading as consumer-authored canon content"
}

^"orientation_contract"{
 prompt_entry: ".spw/README.md"
 first_reads: [".spw/README.md", ".spw/index.spw", ".spw/workspace.spw", ".spw/mount.spw"]
 command_ladder: ["spw doctor .", "spw roots", "spw tree @spw --depth 3", "spw select .spw/index.spw --selector navigable --summary"]
 model_rule: "state consumer authority, exclude _workbench from the consumer corpus, name one bounded question, and keep evidence revision-aware"
 working_references: [".spw/_workbench/docs/runtime/md/mounted-workbench.md", ".spw/_workbench/.agents/skills/spw-mounted-consumer-review/SKILL.md"]
 portability: "orientation text uses mount-relative references and contains no repository identity assumptions"
}

^"mount_protocol"{
 location: ".spw/mount.spw"
 tracks: ["workbench commit or release tag", "engaged surfaces", "resolution paths"]
 engages: ["spec subsystems", "conventions", "patterns", "tooling entrypoints"]
 resolves: [
  "~\"_workbench/lib/spw-v0.3.0/\"",
  "~\"_workbench/packages/spw-cli/\"",
  "~\"_workbench/packages/spw-lsp/\"",
 ]
 rule: "consumer-owned mount.spw declares how local canon engages workbench infrastructure; it does not turn _workbench into consumer content"
}

^"resolution_contract"{
 install: "git submodule add <workbench-url> .spw/_workbench"
 cli: "consumer wrappers resolve through .spw/_workbench/packages/spw-cli/"
 lsp: "editor startup resolves through .spw/_workbench/packages/spw-lsp/ or a shared launcher rooted there"
 review: "commit-review tooling may resolve from .spw/_workbench, node_modules/spw-workbench, or SPW_WORKBENCH_ROOT"
}

^"engagement_exchange"{
 engagement: "consumers selectively engage workbench surfaces through mount.spw rather than inheriting the entire workbench canon"
 exchange: "consumers may deliberately contribute distilled protocols, dialects, conventions, or evidence across the mount boundary"
 independence: "removing _workbench leaves the consumer's own .spw canon legible, versionable, and portable"
}

^"review_contract"{
 discovery: [#consumer_root, #mount_manifest, #workbench_root]
 authority_order: [#consumer_canon, #mounted_instruments]
 scan_exclusion: ".spw/_workbench/**"
 provenance: [#consumer_revision, #workbench_revision, #review_profile, #commands]
 output: "consumer-owned relative path"
 forbidden: [#specific_domain, #consumer_identifier, #machine_local_absolute_path, #automatic_upstream_write]
}

^"invariant"{
  "The consumer owns its .spw canon; the workbench owns .spw/_workbench.",
  "mount.spw records version, engagement, and resolution explicitly rather than relying on undocumented path folklore.",
  "_workbench is infrastructure and should not be enumerated as consumer content in indexes, shelves, or publish surfaces.",
}

#>wonder_spw_conventions_submodule_1
?["What asymmetry does the submodule convention preserve on purpose?"]{
  #:depth #!educational // lens: ecological zone
  ~#hint: "consumer canon vs mounted engine"
  !probe{ "list which surfaces remain consumer-authored and which ones stay mounted infrastructure. the asymmetry is the point." }
  $%[convention.adherence_score, convention.violation_sites]
}
