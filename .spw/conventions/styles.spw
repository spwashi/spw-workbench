# Spw Codebase Styles — local anatomy & messy-desk
#
# Two complementary nesting cultures:
#   anatomy   — clean, shallow, one reason to change
#   messy-desk — aware complexity; experiments and challenges
#
# Aim: Spw useful for developing cultures and modeling complex
# metaphysical relationships with rhythms and intricate patterns —
# without confusing thrash for law.

#>spw_conventions_styles
#:convention #!style
#:layer #!pragmatics
#:status #!active

^"intent"{
 ~#goal: "Name nesting and hygiene styles so agents clean, preserve, or challenge complexity on purpose."
 ~#taste: "anatomy by default; messy-desk by declaration; no silent erase of hard patterns"
}

^"roots"{
 @hash: ~"./hash-resonance.spw"
 @physics: ~"./file-physics.spw"
 @naming: ~"./naming.spw"
 @editing: ~"../editing.spw"
 @sagas: ~"../../prompts/sagas/schema.spw"
 @craft: ~"../../.agents/skills/spw-craft-quality/SKILL.md"
}

# ── Anatomy (local, clean) ─────────────────────────────────────

^"anatomy"{
 law: #[
  "One file, one reason to change (craft guard)"
  "Prefer depth ≤ 3 for everyday frames; deeper only with comment light"
  "Leading title-block `#` / `##` names the organ"
  "^\"roots\" then ^\"intent\" then body — navigable skim"
  "Path refs ~\"…\" over absolute lore"
  "Positive ground in PE bodies"
 ]
 nesting: .{
  frame: `^"name"{ … }`
  facets: `.{ key: value }`
  sets: `#[ a, b ]`
  max_daily: 3
 }
 indent: "2 spaces; spw format --profile pretty|layout"
 comments: "Spw light is `#` prose — never default `//` (no `/` lore yet)"
 markers: "#:status #!active   #:layer #!…"
 cleanup: "format culture → holes report → one-coordinate mutate"
}

# ── Messy-desk (declared experiment) ───────────────────────────

^"messy_desk"{
 # Aware mess: complexity with a label and a later fate

 declare: #[
  "#:desk #!experiment"
  "#:desk #!challenge"
  "#:desk #!compost"
  "status: #open | #sandbox in saga/job frames"
  "grade_cap: "effect.l0.measure" | "effect.l1.memory""
 ]

 experiment: .{
  meaning: "try relations, rhythms, nests; Hold not required"
  fate: "promote to anatomy, compost, or archive as challenge"
  format: "may skip pretty until cleanup day"
 }

 challenge: .{
  meaning: "preserve intricate pattern as intentional difficulty"
  fate: "do not auto-simplify; document the hardness in title-block"
  format: "layout-safe only; no prose rewrite that flattens structure"
 }

 compost: .{
  meaning: "decay toward reuse — extract locks, discard thrash"
  fate: "mine style_lock / subject_lock; delete or archive remainder"
 }

 law: #[
  "Undeclared mess is a bug; declared mess is a desk"
  "Never promote messy-desk to print/carve/bake without F4-style gate"
  "Cleanup is a saga: observe → expand → mutate one coordinate → measure"
  "Challenge files keep #:desk #!challenge after cleanup of adjacent thrash"
 ]
}

# ── Nesting conventions ────────────────────────────────────────

^"nesting"{
 local_anatomy: .{
  order: [ title_block, roots, intent, dispatch_or_body, wonder_optional ]
  depth_budget: "effect.l0.measure read any; daily write prefer ≤3; fractal nest under saga only"
 }

 fractal: .{
  seed: "& => {&}"
  law: "one coordinate per child step; fold with valence"
 }

 cross_file: .{
  prefer: "@root and ~path refs"
  avoid: "copy-paste genotype; bind ids instead"
 }
}

# ── Refactor pack (after mutations / working-tree thrash) ─────

^"refactor"{
 # Order of operations for cultural cleanup of a surface cluster

 steps: [
  "1. spw tree <dir> --depth 2 — map mass"
  "2. spw skim <file> — title light + frames"
  "3. spw format <paths> --profile culture --check --diff — see layout/prose/slash drift"
  "4. spw format <paths> --profile culture — apply # light + indent + frames"
  "5. spw select <file> --skim --summary — structure after format"
  "6. Declare remaining complexity #:desk #!challenge or compost"
  "7. Saga one-coordinate retune only if meaning moves"
  "8. pulse --profile layout_canonical if brace projection must hold"
 ]

 profiles: .{
  culture: "pretty + migrate //→# + prose reflow"
  anatomy: "layout (indent, frames, align comments)"
  challenge_safe: "canonical hygiene only — do not flatten challenge nests"
 }

 refuse: #[
  "Pretty-print a #:desk #!challenge into shallow anatomy without human intent"
  "Migrate meaning while migrating // comments in the same unreviewed commit"
  "Delete messy-desk history without episode when it held a cultural pattern"
 ]
}

# ── Cultural aim ───────────────────────────────────────────────

^"culture_aim"{
 claim: "Spw helps people grow shared practices and model complex metaphysical relations."
 rhythms: "sagas and pulses are timekeepers; messy-desk is rehearsal; anatomy is performance"
 patterns: "intricacy is allowed when named; unnamed density is thrash"
 operators: "sigils carry lore; do not borrow // as if / were already sung"
}

~<./hash-resonance.spw>
~<./file-physics.spw>
~<./naming.spw>
