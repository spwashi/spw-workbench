# Conventions Index
#
# Canon conventions for scalable and literate Spw architecture.

#>spw_conventions_index
#:convention #!scale
#:layer #!pragmatics

^"intent"{
  ~#goal: "Keep Spw surfaces composable as the directory grows."
}

^"roots"{
  @selection: ~"./selection.spw"
  @naming: ~"./naming.spw"
  @cli: ~"./cli.spw"
  @workspace: ~"../workspace.spw"
  @index: ~"../index.spw"
}

^"coverage"{
  selection_ergonomics: @selection
  naming_model: @naming
  cli_model: @cli
  ownership_contract: @workspace
}

^"invariant"{
  "Conventions prefer composable short names over one-off abbreviations.",
  "Generated projection bodies stay separate from canonical manifests.",
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
