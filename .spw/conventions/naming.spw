# Naming Conventions
#
# Script and surface naming model for internal cohesion.

#>spw_naming_conventions
#:naming #!cohesion
#:layer #!pragmatics

^"scripts"{
 prefix: "spw-* for CLI executables and composed engines"
 composed_dirs: "packages/spw-cli/src/* for dispatcher internals by concern; scripts/spw-*.ts stay as wrappers"
 command_surface: "npm run spw -- <command> as stable public entrypoint"
 compatibility: "legacy aliases (spw:seq, spwq) remain as wrappers; prefer spw -- ls and spw -- select"
}

^"spw_files"{
 folders_over_hyphen: "prefer folder composition for family growth"
 short_names: "use short stable names once role context is clear"
 anchors: "one #>spw_* anchor per canonical file"
 root_refs: "@root/path for cross-tree, ~\"./sibling\" for local adjacency"
}

^"derived_surfaces"{
 # Generated artifacts, not authored canon. Scanners skip them by default.
 suffix: "<stem>.<kind>.spw names a derived surface (kind: expanded, …)"
 provenance: "sourceSurfaceOf(x.expanded.spw) → x.spw; the source stays the canonical fold"
 excluded: "lint, mount resolve, and the tree walker skip derived surfaces — a projection may frame foreign content that need not re-parse as canon"
 producer: "spw expand --write emits <stem>.expanded.spw; the source is never rewritten"
}

^"invariant"{
 "Naming must expose ownership and composition boundaries.",
 "Public command names stay stable; internals evolve behind composed modules.",
}

#>wonder_spw_conventions_naming_1
?["How does this file's voice differ from @root?"]{
  #:depth #!educational // lens: molecular binding
  ~<@root> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]@root
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}

#>wonder_spw_conventions_naming_2
?["What invariant holds across every frame in Naming Conventions?"]{
  #:depth #!experiential // lens: ecological zone
  $^["_"]@here => %[shared.property]
  ~#hypothesis: "all frames in this file share ____"
  !probe{ "extract the property common to scripts's frames; if none exists, the file may lack cohesion or may be a deliberate collection." }
  $%[convention.adherence_score, convention.violation_sites]
  ~<.spw/conventions/cli.spw>  // nearest neighbor
}
