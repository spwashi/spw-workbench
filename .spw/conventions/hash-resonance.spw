# Hash Resonance — the `#` operator across strata
#
# # is vibration/resonate (operators.spw), not a C-style "comment keyword".
# Document lines that begin with `#` are light inscriptions on a surface.
# They share the sigil with runtime resonance intentionally: both tag what
# should hold as identity when the field is read, executed, or printed.
#
# Do not invent lore for `/` or `//`. Prefer `#` for Spw-native marginalia.
# Lexer may still recognize `//` as borrowed COMMENT for recovery; culture
# and format migrate away from it.

#>spw_conventions_hash_resonance
#:convention #!hash
#:layer #!semantics
#:status #!active

^"intent"{
 ~#goal: "One coherent reading of # from document light through runtime resonate to file-level strata."
 ~#taste: "shared sigil; stratified consequences; no slash-comment culture"
}

^"roots"{
 @operators: ~"../../docs/theory/spw/operators.spw"
 @atlas: ~"../../docs/theory/spw/operator-atlas.spw"
 @styles: ~"./styles.spw"
 @physics: ~"./file-physics.spw"
 @format: ~"../../packages/spw-cli/src/format.ts"
}

# ── Strata (same glyph, different force) ───────────────────────

^"strata"{
 document_light: .{
  surface: "line-leading `#` prose (not #: #! #>)"
  force: "inscription — orients the reader; not evaluated as Act"
  physical: "ink / title light / margin when printed"
  law: "Reflowable as prose; never confuses with directive chips"
 }

 directive_chip: .{
  surface: "#: family  #! force  #> handle"
  force: "annotation / membership / kinetic posture"
  physical: "stamp / seal on the page"
  law: "Never reflow or rewrite as free prose"
 }

 runtime_resonate: .{
  surface: "#name  #key{…}  reduce→registers.resonate"
  force: "identity lock of a reduced value into a register (vibration)"
  physical: "tuning fork struck — the name holds the tone"
  status: "implemented (interpreter case `#`)"
 }

 register_frame: .{
  surface: "#[…] proposed set constructor"
  force: "category / ground-truth set (ONF research)"
  status: "proposed in operators.spw register_frames"
 }
}

# ── Repetition ─────────────────────────────────────────────────

^"repetition"{
 # How stacked or repeated # reads — interpretive + practical law

 bare_line: .{
  form: "`#` alone on a line"
  meaning: "breath / blank resonance / paragraph seam in document light"
  format: "preserved as paragraph break under reflow_prose"
 }

 single_prose: .{
  form: "`# words…`"
  meaning: "one inscription stroke"
 }

 double_hash: .{
  form: "`##` title or tag"
  meaning: "meta-stratum — file or section handle above ordinary prose"
  law: "do not reflow as ordinary prose (format leaves ## alone)"
  runtime: "not auto-resonate; document strata only unless a dialect says otherwise"
 }

 triple_plus: .{
  form: "`###` …"
  meaning: "deeper outline strata (rare; prefer frames ^\"…\" for structure)"
  taste: "use sparingly; frames carry anatomy better than markdown-depth races"
 }

 runtime_chain: .{
  form: "$#  #&  repeated resonate under different keys"
  meaning: "substrate-of-resonance / re-strike — see operator-atlas compounds"
  law: "each # Act is one resonate; repetition is new vibration, not louder same"
 }
}

# ── File-level reading ─────────────────────────────────────────

^"file_level"{
 # The file as a resonant object

 title_block: .{
  form: "leading consecutive `#` / `##` lines before first ^ frame or code"
  meaning: "file light — the name and promise of the surface as artifact"
  continuity: "when emit/print, title-block phrases may travel as anchors if declared"
 }

 body_prose: .{
  form: "`#` lines interleaved with frames"
  meaning: "margin notes; should not outgrow the anatomy they annotate"
 }

 messy_desk: .{
  form: "dense # + deep nest + unfinished holes"
  meaning: "experiment grade — see styles.spw messy_desk"
  cleanup: "format --profile culture then one-coordinate saga mutate"
 }

 refuse: #[
  "Treat `#` only as 'comment syntax from C'"
  "Use `//` as the Spw cultural default for notes"
  "Assume every `#` line is a runtime resonate Act"
  "Silent rewrite of #: #! #> when reflowing prose"
 ]
}

# ── Runtime consequence (implemented kernel) ───────────────────

^"runtime"{
 sigil: `#`
 behavior: "evaluate args eagerly; reduce; registers.resonate(key, reduced, lens)"
 key: "frame string or generated res-N"
 lens: "frames.reg or 'runtime'"
 return: "the reduced value"
 note: "Document `#` lines are NOT this Act unless parsed as Operation nodes"
}

# ── Format / refactor hooks ────────────────────────────────────

^"tooling"{
 reflow: "canonicalize reflowProse — `#` blocks only by default"
 migrate_slash: "spw format --migrate-slash  →  // lines become # prose"
 profile_culture: "pretty + migrate-slash + prose (cultural cleanup)"
 pulse: "layout_full includes reflow_prose after hygiene"
}

~<./styles.spw>
~<./file-physics.spw>
