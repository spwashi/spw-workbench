# File Physics — physical consequences of a Spw surface
#
# A `.spw` file is not only text in a VCS. It is a material candidate:
# light on screen, ink on page, carve in wood, bake in clay, cast in type.
# These readings guide thrift, continuity, and when to promote experiments.

#>spw_conventions_file_physics
#:convention #!physics
#:layer #!pragmatics
#:status #!active

^"intent"{
 ~#goal: "Name how a Spw file behaves as a physical object so culture, print, and runtime share one care grammar."
 ~#taste: "material metaphors with measurable hooks; no pure mysticism"
}

^"roots"{
 @hash: ~"./hash-resonance.spw"
 @styles: ~"./styles.spw"
 @consequence: ~"../consequence.spw"
 @valence: ~"../../docs/theory/spw/valence-architecture.spw"
 @emit: ~"../../docs/runtime/md/spw-emit.md"
}

# ── Material modes ─────────────────────────────────────────────

^"modes"{
 light: .{
  medium: "screen, projection, HUD"
  consequence: "high revision rate; thrift of chrome; soft fail"
  format: "pretty ok; reflow prose freely"
  promote: "rarely pins revision"
 }

 print: .{
  medium: "page, PDF, poster"
  consequence: "title-block + continuity anchors must hold; pin profile_revision"
  format: "layout + prose width for page; no silent // lore"
  promote: "emit hosts brief|copy; merch last"
 }

 carve: .{
  medium: "durable mark — stone, wood, metal type"
  consequence: "few glyphs; high identity cost; mistakes expensive"
  format: "minimal; locks only; dual-read if retuning"
  promote: "F4 only; language.id stable"
 }

 sculpt: .{
  medium: "3d form, relief, cast"
  consequence: "topology of nest/fold matters; projection must be layout-safe"
  format: "indent + brace projection checks (pulse layout)"
  promote: "brace_projection equal under reparse"
 }

 bake: .{
  medium: "heat-set craft — clay, glaze, crust"
  consequence: "time and temperature; once baked, not freely remolded"
  format: "messy-desk allowed before bake; after bake only surface glaze (S0 notes)"
  promote: "status #locked / #shipped; episodes required for semantic retune"
 }

 weave: .{
  medium: "textile, braid, multi-thread narrative"
  consequence: "confluence & and fractal nests; hold across hosts"
  format: "saga streams append-only; fold with valence"
  promote: "multi-host Hold≥θ"
 }
}

# ── File as object ─────────────────────────────────────────────

^"object"{
 mass: "line count + nest depth + open holes (cognitive weight)"
 porosity: "how many `_` / unfinished slots invite fill (play)"
 hardness: "lock density + status #locked|#shipped"
 luminescence: "title-block clarity + positive ground"
 grain: "operator rhythm — density of # ~ ^ & per line"

 measure_hooks: #[
  "spw skim <file> — outline mass"
  "spw select <file> --summary — type/depth"
  "spw format --check — layout drift"
  "spw pulse --profile layout_canonical — brace projection"
 ]
}

# ── Cultural use ───────────────────────────────────────────────

^"culture"{
 develop_rhythms: "messy-desk files are practice rooms; canon files are instruments on stage"
 metaphysical_model: "nested frames model relations; # light names what must still be true when the model is moved"
 intricate_patterns: "preserve complexity challenges under #:desk #!challenge — do not auto-simplify"
 refuse: #[
  "Print a messy-desk draft as if it were baked canon"
  "Carve a reading that still has open required slots"
  "Bake without episode when meaning changed"
 ]
}

~<./hash-resonance.spw>
~<./styles.spw>
