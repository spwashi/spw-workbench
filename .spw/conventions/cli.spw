# CLI Conventions
#
# Public command grammar for a recognizable, composable Spw CLI surface.

#>spw_cli_conventions
#:cli #!convention
#:layer #!pragmatics

^"command_model"{
 entry: "spw <command> [arguments] [options]"
 local_entry: "npm run spw -- <command> [arguments] [options]"
 public_commands: [init, doctor, roots, mount, tree, census, graph, atlas, formula, density, form, lattice, delta, measure, authority, taste, stack, exp, cycle, inspect, cite, follow, query, select, outline, ls, format, expand, snippet, refactor, refresh, emit, pulse, mutate, beat, mem, dev]
 planned_commands: [capabilities, review]
 command_aliases: ["install -> init", "invent|inventory|inv -> census", "map|topo -> graph", "formulas -> formula", "analyze|stats -> density", "geometry|geom -> form", "readings -> lattice", "mass|thrift -> measure", "surface|profile -> stack", "experimental|catalog -> exp", "q -> query", "spwq -> select", "skim|read -> outline", "seq -> ls", "snip -> snippet"]
 entry_aliases: ["spw-workbench <command> ..."]
 registry: "packages/spw-cli/src/commands.ts"
 shared_help: "packages/spw-cli/src/{help,view,corpus-spread}.ts"
 distribution_direction: "publish root spw as the package binary; keep install/spw-workbench as compatibility and DX/bootstrap support"
}

^"claim_status"{
 implemented: [#registry_routes, #root_help_groups, #through, #events, #sample, #spread, #spw_card, #spw_card_roundtrip, #single_source_buffers, #recommendation_card]
 proposed: [#capabilities_command, #review_command, #alias_retirement_boundary]
 interpretive: [#lyrical_handle, #manufacturing_metaphor, #print_metaphor, #photoelectronics_metaphor]
 law: "Implemented names must have a code or output trace; proposed names must not appear as shipped commands; interpretive names need a mapping and counterexample before becoming semantic claims."
}

^"public_voice"{
 order: [#outcome, #cost_or_disclosure, #compatibility]
 summary: "root summaries begin with an observable action or product, not an effect address, IR type, option, or alias"
 help: "command help may add implementation precision after the primary outcome is recognizable"
 recommendation: "purpose states the question answered; cost states additional work, retention, disclosure, or output size"
 refuse: ["effect.l0.measure as the first explanation", "an option before the command outcome", "compatibility routes before canonical examples"]
}

^"output_vocabulary"{
 spw_card: "source-shaped output readable as text and parseable as Spw"
 table: "aligned rows for terminal reading; not promised to parse as Spw"
 json: "structured output for scripts; command help states whether it is enveloped and complete"
 ndjson: "line-delimited JSON emitted as records become available when the producer is progressive"
 legacy_term: "dual-read is not taught in public copy; it describes an ambition, not a recognizable output form"
 counterexample: "a pretty table is readable by two audiences but is not a Spw card"
}

^"metaphor_boundary"{
 through: "implemented motion: execute through one named source stage, then stop"
 spread: "implemented field extent: near->minimal, standard->standard, far->full corpus work"
 lattice: "implemented scan: named and anonymous ~# apposition cells; comments are not interstitial cells"
 law: "manufacturing, print, photoelectronics, and field language may aid memory only beside an observable mapping and a stated limit"
 counterexample: "spread does not measure semantic distance, social proximity, or author affinity"
}

^"mounted_consumer_observability"{
 roots: "spw roots reports declared and fallback roots with consumer-relative paths, path kinds, and authority roles"
 tree: "spw tree selects a declared root or consumer-relative path and renders its .spw files; mounted infrastructure is excluded unless explicit"
 doctor: "spw doctor checks mount presence, revision state, parser/CLI/LSP reachability, and scan exclusions"
 doctor_paths: "doctor uses --paths relative|absolute; relative is the portable default and absolute is an explicit local-disclosure projection"
 planned_capabilities: "spw capabilities should emit advertised and observed CLI/LSP/editor capabilities with owning layers"
 planned_review: "spw review should orchestrate a named review profile and write consumer-owned evidence"
 shipped_formats: [#human, #spw, #json]
 path_policy: "outputs use paths relative to consumer or workbench root by default; doctor serializes machine-local absolute paths only after explicit --paths absolute disclosure"
 exit_policy: "unsupported capability and degraded fallback are distinct from command failure"
 spacing_projection: "spw inspect spacing keeps consumer-relative paths and projects one observational product as a table, Spw card, or JSON envelope"
 source_products: "spw inspect source requests tokens, structure, or trace over one parser kernel; file, --stdin, and --text inputs project the stage records as human, Spw, JSON, or live NDJSON output"
 progressive_protocol: "spw.progressive-product/1 records product, revision, IR, sequence, stage, completeness, elapsed time, included fields, omissions, and deferred depths"
}

^"query_grammar"{
 from: "--from <roots>"
 select: "--select <fields>"
 where: "--where <clauses>"
 limit: "--limit <n>"
 summary: "--summary"
 selector: "--selector <preset> or --expr <selector_expr>"
 single_file_surface: "spw select <file.spw>"
 local_single_file_surface: "npm run spw -- select <file.spw>"
}

^"ergonomics"{
 sql_inspired: "from/select/where/limit composition over query rows"
 css_inspired: "structural selector intuition over references, roots, and adjacency"
 prolog_inspired: "summary outputs support iterative question->goal refinement toward REPL workflows"
}

^"progressive_controls"{
 through: "--through tokens|structure|trace — stop after the named single-source stage"
 events: "--events none|diagnostics|trace — retain the named parser instrumentation"
 sample: "--sample N — bound visible human and Spw examples; exact products stay complete and parser work does not shrink"
 spread: "--spread near|standard|far — corpus work mapped in order to minimal|standard|full index profiles"
 api_mapping: "through -> SourceProductOptions.through; events -> ParserOptions.eventPolicy; sample -> formatter limit; spread -> corpus index"
 input_mapping: "source/spacing accept one file, --stdin stream, or --text literal; the three are mutually exclusive and do not widen corpus commands"
 profile_boundary: "dialect and surface profiles may affect interpretation; performance handles may not"
 bundle_boundary: "package entry points choose shipped or loaded modules; a runtime through value does not promise tree-shaking"
}

^"output_contract"{
 source_exact: [json, ndjson]
 bounded: [human, spw]
 visible_field: "lossy display normalization uses explicit names such as value_visible"
 omission_law: "every bounded product states omitted rows, tokens, events, or fields"
 envelope_law: "new structured products use the versioned CLI envelope; legacy unwrapped JSON requires an explicit migration boundary"
 path_law: "structured products carry relative paths by default; any absolute projection is explicit, command-scoped disclosure; copyable recommendations quote shell arguments"
}

^"recommendation_contract"{
 shape: [command, purpose, cost]
 law: "a next move explains what question it answers and what additional work or disclosure it incurs"
 refuse: "unexplained command strings, hidden fast bundles, or recommendations that confuse display sampling with execution thrift"
}

^"compatibility_boundary"{
 current: ["--product -> --through", "--event-policy -> --events", "--limit -> --sample", "--depth -> --spread"]
 retire: [inventory, machine_notice, first_party_migration, declared_version_boundary, joint_removal]
 law: "an alias is a temporary route to one implementation, not a second semantic surface"
}

^"inspection_social_graces"{
 default: "local, explicit, and read-only"
 data: "source text, exact spans, diagnostics, event traces, and cache receipts may reveal private authored or exploratory material"
 retention: "single-source inspection does not persist a hidden activity log; corpus memo and editor caches disclose their plane and identity"
 authority: "inspection evidence never grants an effect, infers a person-level trait, or becomes an authority-facing score"
 export: "complete structured output is an explicit stdout choice; bounded views disclose loss before sharing"
 correction: "authority-facing projections preserve provenance, uncertainty, and a route to inspect or contest the underlying receipt"
}

^"invariant"{
  "Public command names stay stable as internals evolve.",
  "Public help states outcome before implementation address and compatibility route.",
  "Canonical help prefers spw verbs; aliases exist only to preserve muscle memory or migration paths.",
  "A Spw card is source-shaped and parseable as Spw; dual-read is not a public output name.",
  "At least one source-inspection Spw card round-trips through inspect source --stdin with complete structure and no prose fallback.",
  "CLI output should remain scriptable and human-readable.",
  "Intermediate products disclose generated and retained cost separately when depth is configurable.",
  "Execution horizon, event retention, display sample, corpus spread, syntax profile, and package bundle remain independent axes.",
  "A progressive stream emits each stage when it becomes available; a buffered final bundle is not labeled progressive.",
  "Readable normalization never overwrites the exact recoverable structured product.",
  "Recommendations keep command, purpose, and cost together.",
  "Exploratory syntax, editor activity, and cache warmth never become person-level authority evidence.",
  "Compatibility aliases should point at one package-owned implementation rather than carrying independent behavior.",
  "Mounted-consumer observability is scriptable, revision-aware, and free of repository identity assumptions.",
  "Commands invoked through .spw/_workbench resolve relative consumer inputs from the consumer root.",
}

#>wonder_spw_conventions_cli_1
?["How does this file's voice differ from conventions/cli (conventions/cli)?"]{
  #:depth #!educational // lens: molecular binding
  ~<@_> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]@_
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}

#>wonder_spw_conventions_cli_2
?["What invariant holds across every frame in CLI Conventions?"]{
  #:depth #!experiential // lens: ecological zone
  $^["_"]@here => %[shared.property]
  ~#hypothesis: "all frames in this file share ____"
  !probe{ "extract the property common to command_model's frames; if none exists, the file may lack cohesion or may be a deliberate collection." }
  $%[convention.adherence_score, convention.violation_sites]
  ~<".spw/conventions/index.spw"> ~#neighbor(nearest)
}
