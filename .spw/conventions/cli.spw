# CLI Conventions
#
# Public command grammar for an immaculate Spw CLI surface.

#>spw_cli_conventions
#:cli #!convention
#:layer #!pragmatics

^"command_model"{
  entry: "npm run spw -- <command> [flags]"
  public_commands: [query, ls, seq, mount, mem, format, dev]
  internal_composition: "scripts/spw-cli/{args,query,run,types}.ts"
}

^"query_grammar"{
  from: "--from <roots>"
  select: "--select <fields>"
  where: "--where <clauses>"
  limit: "--limit <n>"
  summary: "--summary"
  selector: "--selector <preset> or --expr <selector_expr>"
}

^"ergonomics"{
  sql_inspired: "from/select/where/limit composition over query rows"
  css_inspired: "structural selector intuition over references, roots, and adjacency"
  prolog_inspired: "summary outputs support iterative question->goal refinement toward REPL workflows"
}

^"invariant"{
  "Public command names stay stable as internals evolve.",
  "CLI output should remain scriptable and human-readable.",
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
