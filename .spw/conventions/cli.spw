# CLI Conventions
#
# Public command grammar for an immaculate Spw CLI surface.

#>spw_cli_conventions
#:cli #!convention
#:layer #!pragmatics

^"command_model"{
 entry: "spw <command> [flags]"
 local_entry: "npm run spw -- <command> [flags]"
 public_commands: [init, query, select, ls, roots, tree, doctor, mount, inspect, mem, format, dev]
 planned_commands: [capabilities, review]
 compatibility_aliases: ["spw install <target>", "spwq <file.spw>", "spw seq ...", "spw-workbench <command> ..."]
 internal_composition: "packages/spw-cli/src/{args,init,query,roots,tree,workspace,select,selectors,run,types}.ts"
 distribution_direction: "publish root spw as the package binary; keep install/spw-workbench as compatibility and DX/bootstrap support"
}

^"mounted_consumer_observability"{
 roots: "spw roots reports declared and fallback roots with consumer-relative paths, path kinds, and authority roles"
 tree: "spw tree selects a declared root or consumer-relative path and renders its .spw files; mounted infrastructure is excluded unless explicit"
 doctor: "spw doctor checks mount presence, revision state, parser/CLI/LSP reachability, and scan exclusions"
 planned_capabilities: "spw capabilities should emit advertised and observed CLI/LSP/editor capabilities with owning layers"
 planned_review: "spw review should orchestrate a named review profile and write consumer-owned evidence"
 shipped_formats: [#human, #spw, #json]
 path_policy: "outputs use paths relative to consumer or workbench root; machine-local absolute paths are never serialized"
 exit_policy: "unsupported capability and degraded fallback are distinct from command failure"
 spacing_projection: "spw inspect spacing keeps consumer-relative paths and projects one observational product as a table, Spw card, or JSON envelope"
}

^"query_grammar"{
 from: "--from <roots>"
 select: "--select <fields>"
 where: "--where <clauses>"
 limit: "--limit <n>"
 summary: "--summary"
 selector: "--selector <preset> or --expr <selector_expr>"
 single_file_surface: "spw select <file.spw>"
 local_single_file_surface: "npm run spw -- select <file.spw>"
}

^"ergonomics"{
 sql_inspired: "from/select/where/limit composition over query rows"
 css_inspired: "structural selector intuition over references, roots, and adjacency"
 prolog_inspired: "summary outputs support iterative question->goal refinement toward REPL workflows"
}

^"invariant"{
  "Public command names stay stable as internals evolve.",
  "Canonical help prefers spw verbs; aliases exist only to preserve muscle memory or migration paths.",
  "CLI output should remain scriptable and human-readable.",
  "Intermediate products disclose generated and retained cost separately when depth is configurable.",
  "Compatibility aliases should point at one package-owned implementation rather than carrying independent behavior.",
  "Mounted-consumer observability is scriptable, revision-aware, and free of repository identity assumptions.",
  "Commands invoked through .spw/_workbench resolve relative consumer inputs from the consumer root.",
}

#>wonder_spw_conventions_cli_1
?["How does this file's voice differ from conventions/cli (conventions/cli)?"]{
  #:depth #!educational // lens: molecular binding
  ~<@_> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]@_
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}

#>wonder_spw_conventions_cli_2
?["What invariant holds across every frame in CLI Conventions?"]{
  #:depth #!experiential // lens: ecological zone
  $^["_"]@here => %[shared.property]
  ~#hypothesis: "all frames in this file share ____"
  !probe{ "extract the property common to command_model's frames; if none exists, the file may lack cohesion or may be a deliberate collection." }
  $%[convention.adherence_score, convention.violation_sites]
  ~<".spw/conventions/index.spw"> ~#neighbor(nearest)
}
