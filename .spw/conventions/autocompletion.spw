# Autocompletion & authoring conventions
#
# Configure completion taste in Spw — not host-domain medial metaphors.
# Grammar still accepts freeform capsule channels; catalogs guide expertise.
#
# @see packages/spw-seed/src/canonical/catalog.ts
# @see docs/theory/spw/inline-composites.spw

@dialect:Spw.b

^seed[Spw.Conventions.Autocompletion v:0.2 @profile:Spw.b @intent:completion_catalog]

^["medial_channels"]{
  couples: "entanglement / resonance relation"
  resonates: "soft geometric or protocol couple"
  depends-on: "dependency graph edge"
  contains: "structural containment"
  bounds: "boundary / constraint envelope"
  maps-to: "functional transformation"
  implements: "specification fulfillment"
  refines: "specification refinement"
  projects: "view / projection of a form"
  cites: "pathref / handle citation"
  scheduled: "stream / schedule timing"
  affects: "mutation vector or state effect"
  note: "Avoid host sensory defaults in catalogs — teach Spw relation physics. Freeform qualitative channels remain legal syntax."
}

^["valence_particles"]{
  !boon: "expansive growth / completed deliverable"
  !bane: "destructive hazard / blocking issue"
  !bone: "structural scaffold / partial implementation"
  !bonk: "boundary collision / interruption"
  !honk: "high-priority signal / telemetry"
}

^["particle_aims"]{
  ##>name: "prompt-root navigation landmark"
  #>name: "structural anchor landmark"
  #:name: "conceptual lens / case"
  #!name: "action orientation / mood"
}

^["dual_read"]{
  point: #[ ~"path" , @id , @bc:hash ]
  follow: #[ $~"path" , $ @id , * @bc ]
  law: "If point-arm and follow-arm are indistinguishable, literacy failed."
}

^["guidelines"]{
  1: "Open entry files with ##>prompt_root when navigable."
  2: "Use ~#traits for status/valence/layer when teaching."
  3: "Medial defaults: left<couples|depends-on|maps-to>right."
  4: "Prefer @root aliases over fragile relative-only paths."
  5: "Disclose intermediates as Spw cards; host JSON is interop only."
}
