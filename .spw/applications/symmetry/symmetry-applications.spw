# Symmetry Applications
#
# Canonical catalog of symmetry group uses (D4, Z4).

#>spw_symmetry_applications
#:symmetry #!explore
#:layer #!semantics

^seed[Symmetry.Applications.Explore v:0.1 @profile:Spw.x~#[ops.register_frames,ops.probe,ops.matrix,ops.symmetry,ops.brace.sides,phrase.inline,surface.hash] @intent:explore-applications]
.symmetry.applications {
 mirror.binding: "brace sides .{sym:D4} — mutation on .left instantly reflects to .right (register bank coupling)"
 spatial.grid: "data .{sym:D4} ?<rotate 90> — 2×2 tile auto-rotates/reflects; UI layouts, pixel art"
 cyclic.process: "state .{sym:Z4} ?<next> — clock-like evolution (0→1→2→3→0) with reflection symmetry"
 register.mirror: "register.bank.acoustic.coupling .{sym:D4} — frequency + liminality mirrored across cells"
 geometric.primitive: "shape #[D4] @ scale(2) — dihedral group actions as native operators"
 query.selector: "probe?left .{sym:D4} — symmetric selectors auto-generate 8 mirrored variants"
 auto.test: "testcase .{sym:D4} ?<assert> — generates reflections/rotations of test data automatically"
 example: "grid .{sym:D4} .left: top-left; .right: bottom-right → all 8 symmetries emerge"
}

#>wonder_spw_applications_symmetry_symmetryapplic_1
?["What ripples if #symmetry changes in this file?"]{
  #:depth #!mathematical // lens: curated collection
  $#symmetry@workspace => %[reference.count, depth.downstream]
  ~#downstream: "trace all files that reference this surface"
  !probe{ "imagine renaming #symmetry to #symmetry_v2; count broken references; the count reveals how deeply symmetry applications is woven into the workspace." }
  $%[app.transform_count, app.symmetry_applications]
}

#>wonder_spw_applications_symmetry_symmetryapplic_2
?["What happens when you zoom from the concept level to the workspace level in Symmetry Applications?"]{
  #:depth #!stylistic // lens: living system
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "Symmetry.Applications.Explore v:0.1 @profile:Spw.x~#[ops.register_frames,ops.probe,ops.matrix,ops.symmetry,ops.brace.sides,phrase.inline,surface.hash" // this file's atom
  !probe{ "the atom is concept-scale; zoom out: what workspace-level pattern does this concept participate in?" }
  $%[app.transform_count, app.symmetry_applications]
  ~<".spw/applications/symmetry/symmetry-cognitive-engine.spw"> ~#neighbor(nearest)
}
