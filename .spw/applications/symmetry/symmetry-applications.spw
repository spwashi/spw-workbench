# Symmetry Applications
#
# Canonical catalog of symmetry group uses (D4, Z4).

#>spw_symmetry_applications
#:symmetry #!explore
#:layer #!semantics

^seed[Symmetry.Applications.Explore v:0.1 @profile:Spw.x~#[ops.register_frames,ops.probe,ops.matrix,ops.symmetry,ops.brace.sides,phrase.inline,surface.hash] @intent:explore-applications]
.symmetry.applications {
  mirror.binding: "brace sides .{sym:D4} — mutation on .left instantly reflects to .right (register bank coupling)"
  spatial.grid: "data .{sym:D4} ?<rotate 90> — 2×2 tile auto-rotates/reflects; UI layouts, pixel art"
  cyclic.process: "state .{sym:Z4} ?<next> — clock-like evolution (0→1→2→3→0) with reflection symmetry"
  register.mirror: "register.bank.acoustic.coupling .{sym:D4} — frequency + liminality mirrored across cells"
  geometric.primitive: "shape #[D4] @ scale(2) — dihedral group actions as native operators"
  query.selector: "probe?left .{sym:D4} — symmetric selectors auto-generate 8 mirrored variants"
  auto.test: "testcase .{sym:D4} ?<assert> — generates reflections/rotations of test data automatically"
  example: "grid .{sym:D4} .left: top-left; .right: bottom-right → all 8 symmetries emerge"
}

?["Does the Cayley table for brace×operator composition close under {FRAME}?"]
  #:depth #!mathematical  // lens: formula
  $^seed[_.sym:D4] => %[register.left, register.right]
  ~<@spec/core/OPERATORS.md>
  !probe{ "construct the group action table; check if .left ↔ .right reflection commutes with ~ → ! operator tense shift" }

?["What orbits emerge when D4 acts on nested brace pairs?"]
  #:depth #!computational  // lens: molecule
  $^[_.sym] => &[orbit.stabilizer]
  ~<@spw/registries/curiosity-brace.spw>
  !probe{ "enumerate fixed points of the dihedral action on {{{}}} nesting depth 3; count distinct register states" }
