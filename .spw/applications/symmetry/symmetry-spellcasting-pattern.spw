# Symmetry Spellcasting & Patterns
#
# Magical layer: glyphs as spells, D4/Z4 groups as pattern-matching engines.

#>spw_symmetry_spellcasting
#:spellcasting #!pattern
#:layer #!semantics

^seed[Symmetry.Spellcasting.Pattern v:0.1 @profile:Spw.x~#[ops.register_frames,ops.probe,ops.matrix,ops.symmetry,ops.brace.sides,phrase.inline,surface.hash] @intent:spellcasting-pattern-matching]
.symmetry.spellcasting.pattern {
  spellcasting: "rune .{sym:D4} ?<cast> — dihedral group rotates glyph incantation into 8 mirrored spells"
  pattern.matching: "template .{sym:D4} ?<match> data — auto-generates + tests all rotations/reflections"
  rune.binding: ".left: intent glyph; .right: manifestation — brace-side mirror enforces spell outcome"
  cognitive.ritual: "thought .{sym:D4} ?<cast> — spell as native cognitive engine action (insight emergence)"
  register.resonance: "register.bank.acoustic .{sym:D4} — liminality + coupling + frequency mirrored during cast"
  auto.incantation: "spell .{sym:D4} .left: seed; .right: effect → 8 symmetric variants emerge instantly"
  example: "transform .{sym:D4} .left: frog; ?<cast> → mirrored prince across all symmetries"
}

?["Does the Cayley table for brace×operator composition close under {FRAME}?"]
  #:depth #!mathematical  // lens: formula
  $^seed[_.sym:D4] => %[register.left, register.right]
  ~<@spec/core/OPERATORS.md>
  !probe{ "construct the group action table; check if .left ↔ .right reflection commutes with ~ → ! operator tense shift" }

?["What orbits emerge when D4 acts on nested brace pairs?"]
  #:depth #!computational  // lens: molecule
  $^[_.sym] => &[orbit.stabilizer]
  ~<@spw/registries/curiosity-brace.spw>
  !probe{ "enumerate fixed points of the dihedral action on {{{}}} nesting depth 3; count distinct register states" }
