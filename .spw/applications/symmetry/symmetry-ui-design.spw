# Symmetry UI Design
#
# Concrete, production-ready UI patterns powered by symmetry.

#>spw_symmetry_ui_design
#:ui #!design
#:layer #!semantics

^seed[Symmetry.UI.Design v:0.1 @profile:Spw.x~#[ops.register_frames,ops.probe,ops.matrix,ops.symmetry,ops.brace.sides,phrase.inline,surface.hash] @intent:ui-applications]
.symmetry.ui.design {
 responsive.grid: "layout .{sym:D4} ?<rotate 90> — 2×2 tile auto-rotates on resize; mobile↔desktop mirroring"
 component.mirror: "nav .{sym:D4} .left: logo; .right: menu → RTL/LTR auto-reflects with register coupling"
 theme.variant: "button .{sym:Z4} ?<next> — cycles 4 symmetric states (hover, focus, active, disabled)"
 animation.cycle: "card .{sym:D4} @ flip(180) — dihedral reflections drive CSS transform + liminality tracking"
 accessibility: "form .{sym:D4} .left: label; .right: input → symmetry enforces balanced spacing + screen-reader parity"
 auto.variant: "ui-kit .{sym:D4} ?<generate> — produces 8 mirrored variants (rotations + flips) from one seed"
 example: "dashboard .{sym:D4} .left: sidebar; .right: content → mutation on sidebar instantly mirrors content layout"
}

#>wonder_spw_applications_symmetry_symmetryuidesi_1
?["What was Symmetry UI Design before it was this, and what could it become?"]{
  #:depth #!experiential // lens: formal structure
  ~#past: "git log --oneline -- .spw/applications/symmetry/symmetry-ui-design.spw | head -3"
  ~#future: "what frame would you add next?"
  !probe{ "the file's git history IS its evolutionary record; the next natural frame reveals the author's trajectory." }
  $%[app.transform_count, app.symmetry_applications]
}

#>wonder_spw_applications_symmetry_symmetryuidesi_2
?["How would a materials science algorithm express Symmetry.UI.Design v:0.1 @profile:Spw.x~#[ops.register_frames,ops.probe,ops.matrix,ops.symmetry,ops.brace.sides,phrase.inline,surface.hash?"]{
  #:depth #!computational // lens: material grain
  ~#translation_target: "materials science"
  ~#source_concept: "Symmetry.UI.Design v:0.1 @profile:Spw.x~#[ops.register_frames,ops.probe,ops.matrix,ops.symmetry,ops.brace.sides,phrase.inline,surface.hash"
  !probe{ "rewrite the root frame in materials science vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[app.transform_count, app.symmetry_applications]
  ~<.spw/applications/symmetry/symmetry-applications.spw>  // nearest neighbor
}
