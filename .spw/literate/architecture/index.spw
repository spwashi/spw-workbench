# Literate Architecture Index
#
# Exhibits for architecture-as-literature in the .spw control plane.

#>spw_literate_architecture_index
#:literate #!architecture
#:layer #!pragmatics

^"roots"{
  @template: ~"./module-template.spw"
  @spec: ~"../literate-spec.spw"
}

^"exhibits"{
  module_template: @template
  literate_contract: @spec
}


?["How does this convention shape the developer's experience?"]
  #:scope #!file
  ~#probe: "trace which workflows or tooling reference this surface"

