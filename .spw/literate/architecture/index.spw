# Literate Architecture Index
#
# Exhibits for architecture-as-literature in the .spw control plane.

#>spw_literate_architecture_index
#:literate #!architecture
#:layer #!pragmatics

^"roots"{
 @template: ~"./module-template.spw"
 @spec: ~"../literate-spec.spw"
}

^"exhibits"{
 module_template: @template
 literate_contract: @spec
}

#>wonder_spw_literate_architecture_index_1
?["What ripples if #literate changes in this file?"]{
  #:depth #!mathematical // lens: formal structure
  $#literate@workspace => %[reference.count, depth.downstream]
  ~<./module-template.spw> // first downstream dependency
  !probe{ "imagine renaming #literate to #literate_v2; count broken references; the count reveals how deeply roots is woven into the workspace." }
  $%[exhibit.prose_ratio, exhibit.tangle_targets]
}

#>wonder_spw_literate_architecture_index_2
?["What happens when you zoom from the workflow level to the workspace level in Literate Architecture Index?"]{
  #:depth #!stylistic // lens: material grain
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "roots" // this file's atom
  !probe{ "the atom is workflow-scale; zoom out: what workspace-level pattern does this workflow participate in?" }
  $%[exhibit.prose_ratio, exhibit.tangle_targets]
  ~<.spw/literate/architecture/module-template.spw>  // nearest neighbor
}
