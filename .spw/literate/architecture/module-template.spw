# Module Exhibit Template
#
# Reusable exhibit shape for concept -> frame -> body materialization.

#>spw_literate_module_template
#:template #!literate
#:layer #!pragmatics

^"exhibit_template"{
  id: "module-name"
  scene: "what motivates this module right now"
  concept: "what potential is being primed"
  frame: {
    roots: ["@spw", "@docs", "@seed"]
    links: ["core refs", "adjacent refs", "projection refs"]
  }
  body: {
    canonical_surface: ".spw/<module>/index.spw"
    generated_surface: ".spw/gen/<module>.spw"
  }
  consequence: {
    probe: ".spw/harness/probes/probe-loop.spw"
    archive: ".spw/harness/probes/archive-index.spw"
    score: ".spw/harness/evals/baseline-evals.spw"
  }
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
