# Ux
#
# Syntax highlighting and expert-familiarity UX contract.

#>spw_ocean_ux
#:layer #!pragmatics

^"intent"{
  ~#goal: "High quality syntax highlighting and reference-driven LSP UX."
}

^"highlight"{
  operators: "distinct hue + shape memory by phase"
  containers: "clear contrast for (), <>, [], {}"
  references: "path refs and root refs highlighted as navigable anchors"
}

^"lsp"{
  links: "definition/documentLink from refs"
  cache: ".spw/biome/ocean/algos/cache.spw#enhancements"
  trace: ".spw/biome/ocean/trace.spw"
}

^"expert_reward"{
  layout: "stable file placement and short composable names"
  registers: "consistent liminality/frequency/coupling/measure_depth semantics"
  fluency: "familiar layout reduces cognitive load over repeated loops"
}

?["Under what conditions does cache eviction resemble cellular apoptosis?"]
  #:depth #!experiential  // lens: cell
  $%[cache.tier] => ~#eviction_threshold
  ~<@biome/ocean/algos/material.spw>
  !probe{ "plot decay curves for hot→warm→cold tier transitions; compare with biological half-life λ = ln(2)/t½" }

?["What is the expected cache hit ratio under Zipf-distributed access patterns?"]
  #:depth #!computational  // lens: texture
  $%[cache.hit_rate, cache.miss_rate] => ~#zipf_alpha
  ~<@spw/biome/ocean/algos/cluster.spw>
  !probe{ "model P(hit) = 1 - (1/N)^α for N documents; measure deviation from theoretical optimum" }
