# Ux
#
# Syntax highlighting and expert-familiarity UX contract.

#>spw_ocean_ux
#:layer #!pragmatics

^"intent"{
 ~#goal: "High quality syntax highlighting and reference-driven LSP UX."
}

^"highlight"{
 operators: "distinct hue + shape memory by phase"
 containers: "clear contrast for (), <>, [], {}"
 references: "path refs and root refs highlighted as navigable anchors"
}

^"lsp"{
 links: "definition/documentLink from refs"
 cache: ".spw/biome/ocean/algos/cache.spw#enhancements"
 trace: ".spw/biome/ocean/trace.spw"
}

^"expert_reward"{
 layout: "stable file placement and short composable names"
 registers: "consistent liminality/frequency/coupling/measure_depth semantics"
 fluency: "familiar layout reduces cognitive load over repeated loops"
}

#>wonder_spw_biome_ocean_ux_1
?["What ripples if #ux changes in this file?"]{
  #:depth #!mathematical // lens: curated collection
  $#experiential@workspace => %[reference.count, depth.downstream]
  ~#downstream: "trace all files that reference this surface"
  !probe{ "imagine renaming #experiential to #experiential_v2; count broken references; the count reveals how deeply intent is woven into the workspace." }
  $%[biome.diversity_index, biome.annotation_density]
}

#>wonder_spw_biome_ocean_ux_2
?["What happens when you zoom from the workflow level to the workspace level in Ux?"]{
  #:depth #!stylistic // lens: living system
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "intent" // this file's atom
  !probe{ "the atom is workflow-scale; zoom out: what workspace-level pattern does this workflow participate in?" }
  $%[biome.diversity_index, biome.annotation_density]
  ~<".spw/biome/ocean/atlas.spw"> ~#neighbor(nearest)
}
