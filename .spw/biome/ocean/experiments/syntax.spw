# Syntax Experiments
#
# Dense Spw.o dialect experiments.

#>spw_ocean_syntax_exp
#:layer #!pragmatics

^"intent"{
 ~#goal: "Explore dense Spw.o forms with scoped evolution and safe rollback."
 ~#channel: "experimental"
}

^"dense_spw_o"{
 ~#dialect_tag: "Spw.o"
 ~#style: "dense, operator-forward, minimal prose"
 ~#scope: [".spw/biome/ocean/**"]
 ~#gate: "probe coverage + cache-aware LSP smoke checks"
}

^"trial_forms"{
 form_a: "?~<#.>@(#.)&[#.]*{#.}^"
 form_b: "$![_]|$^[_]|$~\"_\""
}

^"fixity_phrases"{
 @theory: ~"../../../../docs/theory/spw/fixity-brace-phrases.spw"
 ~#goal: "Nursery for brace phrases under channel=ocean|experimental"
 prefix_bank: #[
  "![]" , "*{...}" , "^[\"n\"]{}" , "~\"p\"" , "?{...}" , "~#goal:"
 ]
 postfix_bank: #[
  "data~" , "x!"
 ]
 phrase_opt: .{
  key: "phraseIdxfixityxdialectxchannelxhash"
  graduate: "Hold + dual-read + episode -> SYNTAX_CATALOG partial"
 }
 =exp[ id: phrase.brace_family , status: proposed ]
 =exp[ id: fixity.prefix_postfix_dual , status: partial ]
 =exp[ id: regional.ocean_o , status: proposed ]
}

^"rollback"{
 ~#trigger: "parse instability or LSP cache mismatch"
 ~#action: "disable Spw.o marker and fall back to baseline selectors"
}

#>wonder_spw_biome_ocean_experiments_syntax_1
?["How does intent teach dense_spw_o?"]{
  #:depth #!educational // lens: material grain
  $^["intent"] => $^["dense_spw_o"] // trace the edge
  &[@biome, @spw] // confluence of references
  !probe{ "draw the relationship: is it containment, reference, or emergent? does reversing the direction change meaning?" }
  $%[biome.diversity_index, biome.annotation_density]
}

#>wonder_spw_biome_ocean_experiments_syntax_2
?["What is the algebraic closure of dense_spw_o (experiments/syntax)?"]{
  #:depth #!experiential // lens: formal structure
  $^["intent"]@biome => %[formula.measure]
  ~<.spw/biome/ocean/experiments/syntax.spw> // introspect
  !probe{ "measure: how many distinct concepts does this frame bind? what is the ratio of structural operators to content - and what does that density reveal?" }
  $%[biome.diversity_index, biome.annotation_density]
}

^["examples"]{
 dense_line: |
  @dialect:Spw.o
  // regional - channel experimental|ocean only
  ?~<#.>@(#.)&[#.]*{#.}^

 schedule_native: |
  // now lex-legal in core too
  << ~ ; ? ; % ; ! ; * ; ^ >>
  << a || b >>

 prefix_vs_postfix: |
  ![]
  *{ x }
  data~

 catalog_cite: |
  =exp[ id: phrase.brace_family , status: proposed ]
  =exp[ id: fixity.prefix_postfix_dual , status: partial ]
  =exp[ id: regional.ocean_o , status: proposed ]
}

^["open"]{
 ?[rollback_trigger]: "Is parse instability enough, or need LSP cache mismatch too?"
 ?[dense_ethos]: "When is dense Spw.o thrift gain worth literacy loss?"
 ?[graduate_form_a]: "Does form_a ever leave ocean, or stay nursery forever?"
 ?[channel_default]: "Default channel for .spw/biome/ocean/** - experimental or ocean?"
 ?[scan_vs_ast]: "May phrase scan promote without FormIR honesty?"
}

#>wonder_ocean_syntax_3
?["Which trial form teaches schedule ; better than English docs?"]{
  #:depth #!educational
  !probe{ =id[p_schedule_teach] }
  $%[literacy.form, thrift]
}

#>wonder_ocean_syntax_4
?["If Spw.o dies tomorrow, what must graduate first?"]{
  #:depth #!pragmatics
  !probe{ =id[p_o_evacuate] }
  $%[catalog, Hold]
}
