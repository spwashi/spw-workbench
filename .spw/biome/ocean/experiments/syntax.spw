# Syntax Experiments
#
# Dense Spw.o dialect experiments.

#>spw_ocean_syntax_exp
#:layer #!pragmatics

^"intent"{
  ~#goal: "Explore dense Spw.o forms with scoped evolution and safe rollback."
  ~#channel: "experimental"
}

^"dense_spw_o"{
  ~#dialect_tag: "Spw.o"
  ~#style: "dense, operator-forward, minimal prose"
  ~#scope: [".spw/biome/ocean/**"]
  ~#gate: "probe coverage + cache-aware LSP smoke checks"
}

^"trial_forms"{
  form_a: "?~<#.>@(#.)&[#.]*{#.}^"
  form_b: "$![_]/$^[_]|$~\"_\""
}

^"rollback"{
  ~#trigger: "parse instability or LSP cache mismatch"
  ~#action: "disable Spw.o marker and fall back to baseline selectors"
}

?["How does this convention shape the developer's experience?"]
  #:scope #!file
  ~#probe: "trace which workflows or tooling reference this surface"

