# Arc
#
# Brace-category transforms for concept arcs.

#>spw_ocean_arc
#:layer #!pragmatics

^"intent"{
 ~#goal: "Support controlled arc transforms for register priming."
}

^"transform"{
 source: "()"
 target: "<>"
 apply_when: {
 register: "liminality|frequency|coupling|measure_depth"
 biome: "reef|pelagic|estuary|benthic|tidal|seagrass"
 phase: "p1..p6"
 }
 effect: "promote arc from scoped observation toward coupling priming"
}

^"invariant"{
 "Transform is reversible and logged in trace before promotion."
}

#>wonder_spw_biome_ocean_expr_arc_1
?["How would an ecology portfolio express expr/arc?"]{
  #:depth #!stylistic // lens: ecological zone
  ~#translation_target: "ecology"
  ~#source_concept: "intent"
  !probe{ "rewrite the root frame in ecology vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[expr.node_count, expr.operator_variety]
}

#>wonder_spw_biome_ocean_expr_arc_2
?["How does this file's voice differ from expr/arc (expr/arc)?"]{
  #:depth #!educational // lens: molecular binding
  ~<@_> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]@_
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}
