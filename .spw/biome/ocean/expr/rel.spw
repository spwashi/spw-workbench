# Rel
#
# Container relationship surface exposed to runtime via .spw.

#>spw_ocean_rel
#:layer #!pragmatics

^"intent"{
 ~#goal: "Model prepositional relationships through container geometry."
 ~#runtime_surface: "Expose relationship choices as measurable interpretation inputs."
}

^"relationships"{
 '<with>' {
 container: "<>"
 preposition: "with"
 register_bias: ["liminality", "coupling"]
 runtime_effect: "prime coupling before deep observation"
 }

 '(in)' {
 container: "()"
 preposition: "in"
 register_bias: ["measure_depth", "frequency"]
 runtime_effect: "scope and observe from bounded perspective"
 }

 '[among]' {
 container: "[]"
 preposition: "among"
 register_bias: ["coupling", "frequency"]
 runtime_effect: "enumerate and compare associations"
 }

 '{of}' {
 container: "{}"
 preposition: "of"
 register_bias: ["measure_depth", "liminality"]
 runtime_effect: "materialize properties as explicit structure"
 }
}

^"exotic"{
 '<with>(in)' {
 pattern: "?~<[_]>@(_)"
 meaning: "prime with relation, then scope observation"
 }

 '[among]{of}' {
 pattern: "&[_]*{_}"
 meaning: "merge among candidates, then materialize properties"
 }

 '<with>[among]{of}' {
 pattern: "~<[_]>&[_]*{_}"
 meaning: "prime coupling, cluster association, then emit structure"
 }
}

^"invariant"{
 "Relationship transforms are reversible and traced per branch."
}

#>wonder_spw_biome_ocean_expr_rel_1
?["What ripples if #rel changes in this file?"]{
  #:depth #!mathematical // lens: molecular binding
  $#educational@workspace => %[reference.count, depth.downstream]
  ~#downstream: "trace all files that reference this surface"
  !probe{ "imagine renaming #educational to #educational_v2; count broken references; the count reveals how deeply intent is woven into the workspace." }
  $%[expr.node_count, expr.operator_variety]
}

#>wonder_spw_biome_ocean_expr_rel_2
?["What happens when you zoom from the workflow level to the workspace level in Rel?"]{
  #:depth #!stylistic // lens: ecological zone
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "intent" // this file's atom
  !probe{ "the atom is workflow-scale; zoom out: what workspace-level pattern does this workflow participate in?" }
  $%[expr.node_count, expr.operator_variety]
  ~<".spw/biome/ocean/expr/arc.spw"> ~#neighbor(nearest)
}
