# Lsp
#
# Modular LSP behavior for ocean biome surfaces.

#>spw_ocean_lsp
#:lsp #!modularity
#:layer #!pragmatics

^"intent"{
  ~#goal: "Separate editor-facing LSP behavior from runtime interpretation behavior."
}

^behavior[open_context]{
  source: [@biome/query/hot.spw#context[on_open], @biome/spells/spells.spw#context[on_open]]
  strength: "apply shelf-aware context on open"
}

^behavior[references]{
  source: @biome/links/links.spw
  strength: "cross-tree root refs + adjacency-aware link jumps"
  enhancement: "prefix/postfix & should stay clickable around refs"
}

^behavior[symbols]{
  source: [@spw/workspace.spw, @biome/index.spw]
  strength: "module shelves + selector/lens/spell symbols for fast navigation"
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
