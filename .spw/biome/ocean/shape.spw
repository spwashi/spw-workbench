# Ocean Shape
#
# Folder and module topology for the ocean biome.

#>spw_ocean_shape
#:layer #!pragmatics

^"folders"{
 root: ".spw/biome/ocean"
 algos: ".spw/biome/ocean/algos"
 query: ".spw/biome/ocean/query"
 template: ".spw/biome/ocean/template"
 ph: ".spw/biome/ocean/ph"
 expr: ".spw/biome/ocean/expr"
 experiments: ".spw/biome/ocean/experiments"
 spells: ".spw/biome/ocean/spells"
 links: ".spw/biome/ocean/links"
 derivatives: ".spw/biome/ocean/derivatives"
 gen: ".spw/gen (projection outputs)"
}

^"modularity_rules"{
 "Each file has one responsibility and explicit refs.",
 "Algorithm files expose cacheable transforms only.",
 "Expression files expose customizable Spw selectors/templates.",
 "Query files expose selector ids and replacement rules.",
 "Generated projection directories are build surfaces (ignored in git).",
 "Experimental syntax lives only under experiments/.",
}

#>wonder_spw_biome_ocean_shape_1
?["How does this file's voice differ from ocean/shape (ocean/shape)?"]{
  #:depth #!educational // lens: molecular binding
  ~<@biome> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]@biome
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}

#>wonder_spw_biome_ocean_shape_2
?["What invariant holds across every frame in Ocean Shape?"]{
  #:depth #!experiential // lens: ecological zone
  $^["_"]@here => %[shared.property]
  ~#hypothesis: "all frames in this file share ____"
  !probe{ "extract the property common to folders's frames; if none exists, the file may lack cohesion or may be a deliberate collection." }
  $%[biome.diversity_index, biome.annotation_density]
  ~<".spw/biome/ocean/atlas.spw"> ~#neighbor(nearest)
}
