# T
#
# Spw.t query template for repeatable biome runs.

#>spw_ocean_t

^"intent"{
  ~#goal: "Template a repeatable query run with probe + invariant checks."
}

^"template"{
  inputs: {
    branch: "branch id"
    selector: "Spw.q selector id"
    dialect: "Spw.q|Spw.t|Spw.l"
    operator_sequence: "optional operator sequence (e.g. ?~@&*^)"
    brace_sequence: "optional brace sequence (e.g. <>{})"
    probe: "optional probe expression (e.g. ?(subject).[)"
    probe_window: "optional probe lookahead window (default 12)"
    label: "optional label disposition (e.g. query)"
    target: "path or biome scope"
    phase: "phase id (p1..p6)"
  }

  steps: [
    "assert clean working tree for target scope",
    "resolve selector id through selector registry",
    "apply optional hot replacement by runtime tier",
    "optionally run sequence/braces/label/probe query by dialect perspective",
    "execute resolved selector against target",
    "record loaded/considered refs in trace",
    "verify updated probes and invariants",
    "emit/update generated lens projections",
    "emit run summary + next action",
  ]

  outputs: {
    trace: ".spw/biome/ocean/trace.spw"
    probes: ".spw/harness/probes/archive-index.spw"
    invariants: ".spw/workspace.spw#invariants"
    projections: ".spw/gen/index.spw"
  }
}
