# Material
#
# Material-property model for query/runtime tuning.

#>spw_ocean_material
#:physics #!tuning

^"intent"{
  ~#goal: "Map physical-material intuition to query/runtime optimization techniques."
}

^property[density]{
  meaning: "how many refs/concepts are packed in the active scope"
  measure: [metric, coupling_density]
  effect: "high density increases merge and interpretation pressure"
  tuning: [cluster_first, narrow_lens, raise_cache_tier]
}

^property[viscosity]{
  meaning: "resistance to change across hot iterations"
  proxy: [cache_hit_rate, replacement_stability]
  effect: "high viscosity stabilizes but can slow adaptation"
  tuning: [hot_replace_guard, phased_invalidation, warm_window]
}

^property[elasticity]{
  meaning: "ability to absorb query/projection perturbation and recover"
  proxy: [rollback_cost, projection_rebuild_time]
  effect: "high elasticity supports experimentation with bounded risk"
  tuning: [scoped_evolution, replayable_dumps, invariant_checks]
}

^property[porosity]{
  meaning: "how permeable boundaries are between biomes, roots, and phases"
  proxy: [cross_root_ref_ratio, adjacency_density]
  effect: "high porosity increases reuse and coupling simultaneously"
  tuning: [root_convention, selector_grounding, projection_owner_clarity]
}

^property[anisotropy]{
  meaning: "directional bias in query traversal and projection flow"
  proxy: [branch_phase_skew, observer_depth_bias]
  effect: "anisotropy can optimize one direction while degrading others"
  tuning: [model_select, axis_balancing, consequence_trace]
}

^model[optimization]{
  fluid: "explore breadth, maximize coverage, tolerate drift"
  lattice: "optimize symmetry/local consistency, minimize coupling spread"
  thermal: "minimize interpretation energy under constrained budget"
  quantum: "defer collapse, preserve alternatives until measurement"
}

^"invariant"{
  "Material properties guide tuning decisions; canonical semantics remain stable."
}
