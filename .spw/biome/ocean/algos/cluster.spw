# Cluster Algorithm
#
# Concept clustering strategy for ocean biome artifacts.

#>spw_ocean_cluster_algo
#:layer #!pragmatics

^"intent"{
 ~#goal: "Group concepts by operator, lens profile, and biome context."
}

^"features"{
 keys: ["operator_focus", "loop_phase", "lens_profile", "biome", "channel"]
 distance: "weighted overlap on keys + ref intersection"
 output: "cluster_id + exemplar refs + cohesion score"
}

^"cache"{
 ~#reuse: "cluster results cached by dataset hash + weights"
 ~#invalidate: "any key-field drift or weight change"
}

^"enhancements"{
 lsp: {
 workspace_symbol: "reuse cluster buckets for symbol grouping"
 semantic_token_hint: "map cluster cohesion to token modifiers"
 }
}

#>wonder_spw_biome_ocean_algos_cluster_1
?["What was Cluster Algorithm before it was this, and what could it become?"]{
  #:depth #!experiential // lens: formal structure
  ~#past: "git log --oneline -- .spw/biome/ocean/algos/cluster.spw | head -3"
  ~#future: "what frame would you add next?"
  !probe{ "the file's git history IS its evolutionary record; the next natural frame reveals the author's trajectory." }
  $%[cluster.centroid_count, cluster.member_drift]
}

#>wonder_spw_biome_ocean_algos_cluster_2
?["How would a materials science algorithm express algos/cluster?"]{
  #:depth #!computational // lens: material grain
  ~#translation_target: "materials science"
  ~#source_concept: "intent"
  !probe{ "rewrite the root frame in materials science vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[cluster.centroid_count, cluster.member_drift]
  ~<.spw/biome/ocean/algos/cache.spw>  // nearest neighbor
}
