# Ocean Biome Atlas
#
# A metaphor layer over the .spw workspace.
# Keeps one cohesive Spw core while allowing expressive biome surfaces.

#>spw_ocean_biome_atlas
#:layer #!pragmatics

^"core"{
 ~#anchor: ".spw/workspace.spw"
 ~#sequence: "?~<#.>@(#.)&[#.]*{#.}^"
 ~#rule: "All biome narratives must preserve core invariants and selector compatibility."
}

^"modules"{
 ~#index: ".spw/biome/ocean/index.spw"
 ~#lit: ".spw/biome/ocean/lit.spw"
 ~#libs: ".spw/biome/ocean/libs.spw"
 ~#phase: ".spw/biome/ocean/phase.spw"
 ~#algos: ".spw/biome/ocean/algos/cache.spw + cluster.spw + geom.spw"
 ~#expr: ".spw/biome/ocean/expr/custom.spw + util.spw + arc.spw + rel.spw"
 ~#spells: ".spw/biome/ocean/spells/spells.spw"
 ~#experiments: ".spw/biome/ocean/experiments/syntax.spw"
 ~#query: ".spw/biome/ocean/query/q.spw + sel.spw + hot.spw + template/t.spw + ops/cycle.spw"
}

^"biomes"{
 reef: {
 role: "literate exhibits and structured storytelling"
 library: ".spw/biome/ocean/libs.spw#reef_lib"
 refs: [".spw/literate/literate-spec.spw", ".spw/biome/ocean/style.spw"]
 }

 pelagic: {
 role: "broad reflective observation and concept clustering"
 library: ".spw/biome/ocean/libs.spw#pelagic_lib"
 refs: [".spw/process/loop-observation.spw", ".spw/harness/memory-surface.spw"]
 }

 estuary: {
 role: "experimental syntax enters and is tested before promotion"
 library: ".spw/biome/ocean/libs.spw#estuary_lib"
 refs: [".spw/process/scoped-evolution.spw", ".spw/harness/probes/probe-loop.spw"]
 }

 benthic: {
 role: "archive floor for completed probes and run evidence"
 library: ".spw/biome/ocean/libs.spw#benthic_lib"
 refs: [".spw/harness/runs/runs-index.spw", ".spw/harness/probes/archive-index.spw"]
 }

 tidal: {
 role: "live iteration and hot-reload beats"
 library: ".spw/biome/ocean/libs.spw#tidal_lib"
 refs: [".spw/process/hot-reload-loop.spw", "scripts/spw-dev.ts"]
 }

 seagrass: {
 role: "cultivated corpus for tuning and style continuity"
 library: ".spw/biome/ocean/libs.spw#seagrass_lib"
 refs: [".spw/tuning/corpus/corpus-policy.spw", ".spw/biome/ocean/style.spw"]
 }
}

^"electrolytes"{
 sodium: "probe conductivity (?~) - rapid local charge"
 potassium: "observation potential (@) - perspective balancing"
 calcium: "merge binding (&) - coupling strength"
 chloride: "materialization stability (*) - grounded outputs"
 magnesium: "integration lift (^) - upward circulation"
}

^"plant_cycles"{
 kelp: "fast growth loops for prototype branches"
 seagrass: "stability loops for baseline contracts"
 mangrove: "boundary filters where experimental syntax meets stable channels"
}

#>wonder_spw_biome_ocean_atlas_1
?["What concept is conspicuously absent from Ocean Biome Atlas?"]{
  #:depth #!stylistic // lens: formal structure
  ~#present: [#experiential, #computational]
  ~#expected_but_missing: "?" // the reader fills this gap
  !probe{ "list what IS annotated; list what sibling files annotate; the difference is this file's blind spot or intentional boundary." }
  $%[biome.diversity_index, biome.annotation_density]
}

#>wonder_spw_biome_ocean_atlas_2
?["How does core teach ~#rule: ?"]{
  #:depth #!educational // lens: material grain
  $^["core"] => $^["
  ~#rule: "] // trace the edge
  &[@biome, @spw] // confluence of references
  !probe{ "draw the relationship: is it containment, reference, or emergent? does reversing the direction change meaning?" }
  $%[biome.diversity_index, biome.annotation_density]
  ~<.spw/biome/ocean/index.spw>  // nearest neighbor
}
