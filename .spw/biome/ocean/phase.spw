# Phase
#
# Composable phase registry for bespoke per-phase config.

#>spw_ocean_phase
#:registry #!composition
#:layer #!pragmatics

^"intent"{
 ~#goal: "Short, composable phase files with optional bespoke config."
}

^"files"{
 p1: ~"./ph/p1.spw"
 p2: ~"./ph/p2.spw"
 p3: ~"./ph/p3.spw"
 p4: ~"./ph/p4.spw"
 p5: ~"./ph/p5.spw"
 p6: ~"./ph/p6.spw"
}

^"invariant"{
 "Each phase file is optional-config only; core semantics remain in spirit sequence."

 %[phase_model]{
 "phases compose into the spirit sequence: ?~ <#.> @(#.) &[#.] *{#.} ^",
 "each phase file adds bespoke config without overriding core semantics",
 "phase config is warm-tier cached — stable between edits, invalidated on save",
 }
}

#>wonder_spw_biome_ocean_phase_1
?["What is the algebraic closure of files (ocean/phase)?"]{
  #:depth #!computational // lens: formal structure
  $^["intent"]@biome => %[formula.measure]
  ~<./ph/p1.spw>
  !probe{ "measure: how many distinct concepts does this frame bind? what is the ratio of structural operators to content — and what does that density reveal?" }
  $%[phase.index, phase.duration_ms, phase.entropy]
}

#>wonder_spw_biome_ocean_phase_2
?["What is the felt rhythm of reading Phase?"]{
  #:depth #!mathematical // lens: material grain
  $%[line.operator_density, brace.nesting_rhythm] => ~#reading_feel
  ~#structure: "intent → files → invariant" // frame flow
  !probe{ "read aloud for 30 seconds; where do you pause? pauses mark grain boundaries." }
  ~<.spw/biome/ocean/atlas.spw>  // nearest neighbor
}
