# Lit
#
# Literature composition patterns by file shape.

#>spw_ocean_lit
#:layer #!pragmatics

^"intent"{
 ~#goal: "Keep files readable, expressive, and uniquely informative by shape."
}

^shape[atlas]{
 composition: [core_anchor, module_map, biome_roles, motif_layer]
 wonder: "broad orientation and narrative coherence"
 interpreter: "human-first, map-aware agents"
}

^shape[algorithm]{
 composition: [intent, inputs, transform, cache, enhancements]
 wonder: "mechanism and performance behavior"
 interpreter: "runtime, LSP, optimization agents"
}

^shape[query]{
 composition: [forms, selector_registry, positionality, aggregation, grounding]
 wonder: "selection semantics and replaceability"
 interpreter: "Spw.q and Spw.t engines"
}

^shape[phase]{
 composition: [token, optional_config, register_bias, update_surface]
 wonder: "phase-local tuning and priming"
 interpreter: "phase scheduler and register model"
}

^shape[trace]{
 composition: [branch_runtime, loaded_refs, considered_refs, aggregates]
 wonder: "what was considered and why"
 interpreter: "profilers, evaluators, niche model updaters"
}

#>wonder_spw_biome_ocean_lit_1
?["What ripples if #lit changes in this file?"]{
  #:depth #!mathematical // lens: curated collection
  $#experiential@workspace => %[reference.count, depth.downstream]
  ~#downstream: "trace all files that reference this surface"
  !probe{ "imagine renaming #experiential to #experiential_v2; count broken references; the count reveals how deeply intent is woven into the workspace." }
  $%[biome.diversity_index, biome.annotation_density]
}

#>wonder_spw_biome_ocean_lit_2
?["What happens when you zoom from the workflow level to the workspace level in Lit?"]{
  #:depth #!stylistic // lens: living system
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "intent" // this file's atom
  !probe{ "the atom is workflow-scale; zoom out: what workspace-level pattern does this workflow participate in?" }
  $%[biome.diversity_index, biome.annotation_density]
  ~<.spw/biome/ocean/atlas.spw>  // nearest neighbor
}
