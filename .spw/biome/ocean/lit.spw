# Lit
#
# Literature composition patterns by file shape.

#>spw_ocean_lit
#:layer #!pragmatics

^"intent"{
  ~#goal: "Keep files readable, expressive, and uniquely informative by shape."
}

^shape[atlas]{
  composition: [core_anchor, module_map, biome_roles, motif_layer]
  wonder: "broad orientation and narrative coherence"
  interpreter: "human-first, map-aware agents"
}

^shape[algorithm]{
  composition: [intent, inputs, transform, cache, enhancements]
  wonder: "mechanism and performance behavior"
  interpreter: "runtime, LSP, optimization agents"
}

^shape[query]{
  composition: [forms, selector_registry, positionality, aggregation, grounding]
  wonder: "selection semantics and replaceability"
  interpreter: "Spw.q and Spw.t engines"
}

^shape[phase]{
  composition: [token, optional_config, register_bias, update_surface]
  wonder: "phase-local tuning and priming"
  interpreter: "phase scheduler and register model"
}

^shape[trace]{
  composition: [branch_runtime, loaded_refs, considered_refs, aggregates]
  wonder: "what was considered and why"
  interpreter: "profilers, evaluators, niche model updaters"
}

?["Under what conditions does cache eviction resemble cellular apoptosis?"]
  #:depth #!experiential  // lens: cell
  $%[cache.tier] => ~#eviction_threshold
  ~<@biome/ocean/algos/material.spw>
  !probe{ "plot decay curves for hot→warm→cold tier transitions; compare with biological half-life λ = ln(2)/t½" }

?["What is the expected cache hit ratio under Zipf-distributed access patterns?"]
  #:depth #!computational  // lens: texture
  $%[cache.hit_rate, cache.miss_rate] => ~#zipf_alpha
  ~<@spw/biome/ocean/algos/cluster.spw>
  !probe{ "model P(hit) = 1 - (1/N)^α for N documents; measure deviation from theoretical optimum" }
