# Runtime
#
# Modular runtime behavior for interpretation and projection.

#>spw_ocean_runtime
#:runtime #!modularity
#:layer #!pragmatics

^"intent"{
 ~#goal: "Keep runtime interpretation logic modular and trace-first."
}

^behavior[selector_resolution]{
 source: [@biome/query/sel.spw, @biome/query/hot.spw]
 stage: "resolve -> hot_replace -> effective_selector"
}

^behavior[projection]{
 source: [@biome/ops/cycle.spw, @spw/gen/index.spw]
 stage: "project -> generate -> trace"
}

^behavior[math_geometry]{
 source: [@biome/algos/geom.spw, @spw/consequence.spw]
 stage: "measure -> aggregate -> consequence"
}

#>wonder_spw_biome_ocean_runtime_1
?["What is the metabolic signature of reading Runtime?"]{
  #:depth #!experiential // lens: living system
  $%[line.operator_density, brace.nesting_rhythm] => ~#reading_feel
  ~#structure: "intent → selector_resolution → projection" // frame flow
  !probe{ "read aloud for 30 seconds; where do you pause? pauses mark structural joints." }
}

#>wonder_spw_biome_ocean_runtime_2
?["What concept is conspicuously absent from Runtime?"]{
  #:depth #!computational // lens: curated collection
  ~#present: [#runtime, #modularity, #educational]
  ~#expected_but_missing: "?" // the reader fills this gap
  !probe{ "list what IS annotated; list what sibling files annotate; the difference is this file's blind spot or intentional boundary." }
  $%[runtime.pipeline_stage, runtime.latency_ms]
  ~<.spw/biome/ocean/atlas.spw>  // nearest neighbor
}
