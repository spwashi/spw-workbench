# Runtime
#
# Modular runtime behavior for interpretation and projection.

#>spw_ocean_runtime
#:runtime #!modularity
#:layer #!pragmatics

^"intent"{
  ~#goal: "Keep runtime interpretation logic modular and trace-first."
}

^behavior[selector_resolution]{
  source: [@biome/query/sel.spw, @biome/query/hot.spw]
  stage: "resolve -> hot_replace -> effective_selector"
}

^behavior[projection]{
  source: [@biome/ops/cycle.spw, @spw/gen/index.spw]
  stage: "project -> generate -> trace"
}

^behavior[math_geometry]{
  source: [@biome/algos/geom.spw, @spw/consequence.spw]
  stage: "measure -> aggregate -> consequence"
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
