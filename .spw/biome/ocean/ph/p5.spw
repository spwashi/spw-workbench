# P5
#
# Phase 5 (*): materialize properties.
# Collapse superposition into concrete output — frames, bodies, or projections.

#>spw_ocean_p5
#:phase #!materialize
#:layer #!pragmatics

^"phase"{
 token: "*{#.}"
 =dialect: "experimental.ocean.phase"
 optional: {
 out_shape: "frame|body|projection"
 canon: "true|false"
 cache_write: "warm|cold"
 }

 %[physics]{
 "liminality: 1 (local) — materialization scopes down to concrete output",
 "frequency: low — one materialize per merge cycle",
 "coupling: collapsing — entangled candidates collapse to one frame",
 "cache: cold tier — materialized results are stable, rarely re-read",
 }

 %[lsp_role]{
 "document symbol outline is a materialized view of the file structure",
 "semantic tokens are materialized render instructions per line",
 "cache: cold tier — symbol outline changes only when document content changes",
 }
}

#>wonder_spw_biome_ocean_ph_p5_1
?["How does phase teach phase — ph/p5?"]{
  #:depth #!educational // lens: material grain
  $^["phase"] => $^["phase"] // trace the edge
  &[@biome, @spw] // confluence of references
  !probe{ "draw the relationship: is it containment, reference, or emergent? does reversing the direction change meaning?" }
  $%[phase.index, phase.duration_ms, phase.entropy]
}

#>wonder_spw_biome_ocean_ph_p5_2
?["What is the algebraic closure of phase?"]{
  #:depth #!experiential // lens: formal structure
  $^["phase"]@biome => %[formula.measure]
  ~<.spw/biome/ocean/ph/p5.spw> // introspect
  !probe{ "measure: how many distinct concepts does this frame bind? what is the ratio of structural operators to content — and what does that density reveal?" }
  $%[phase.index, phase.duration_ms, phase.entropy]
}
