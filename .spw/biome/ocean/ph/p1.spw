# P1
#
# Phase 1 (?~): probe into superposition.

#>spw_ocean_p1
#:phase #!probe

^"phase"{
  token: "?~"
  =dialect: "experimental.ocean.phase"
  optional: {
    selectors: [refs_navigable, phase_config, relation_exotic]
    cache: "hot|warm|cold"
    beat_win: "micro beat window"
    lens: "narrow|balanced|wide"
  }

  %[physics]{
    "liminality: 0 (local) — probes are scoped to the immediate node",
    "frequency: high — many small writes per cycle",
    "coupling: low — probes are independent until named",
    "cache: hot tier — probe results expire in 8 beats",
  }
}
