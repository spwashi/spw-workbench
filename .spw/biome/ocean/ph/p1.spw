# P1
#
# Phase 1 (?~): probe into superposition.

#>spw_ocean_p1
#:phase #!probe
#:layer #!pragmatics

^"phase"{
 token: "?~"
 =dialect: "experimental.ocean.phase"
 optional: {
 selectors: [refs_navigable, phase_config, relation_exotic]
 cache: "hot|warm|cold"
 beat_win: "micro beat window"
 lens: "narrow|balanced|wide"
 }

 %[physics]{
 "liminality: 0 (local) — probes are scoped to the immediate node",
 "frequency: high — many small writes per cycle",
 "coupling: low — probes are independent until named",
 "cache: hot tier — probe results expire in 8 beats",
 }
}

#>wonder_spw_biome_ocean_ph_p1_1
?["What invariant holds across every frame in P1?"]{
  #:depth #!computational // lens: ecological zone
  $^["_"]@here => %[shared.property]
  ~#hypothesis: "all frames in this file share ____"
  !probe{ "extract the property common to phase's frames; if none exists, the file may lack cohesion or may be a deliberate collection." }
  $%[phase.index, phase.duration_ms, phase.entropy]
}

#>wonder_spw_biome_ocean_ph_p1_2
?["What was P1 before it was this, and what could it become?"]{
  #:depth #!mathematical // lens: molecular binding
  ~#past: "git log --oneline -- .spw/biome/ocean/ph/p1.spw | head -3"
  ~#future: "what frame would you add next?"
  !probe{ "the file's git history IS its evolutionary record; the next natural frame reveals the author's trajectory." }
  $%[phase.index, phase.duration_ms, phase.entropy]
  ~<".spw/biome/ocean/ph/p2.spw"> ~#neighbor(nearest)
}
