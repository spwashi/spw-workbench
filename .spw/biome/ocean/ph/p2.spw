# P2
#
# Phase 2 (<#.>): name coupling.
# Assigns names to probed candidates, binding potential into structure.

#>spw_ocean_p2
#:phase #!naming
#:layer #!pragmatics

^"phase"{
  token: "<#.>"
  =dialect: "experimental.ocean.phase"
  optional: {
    name_mode: "strict|fuzzy"
    coupling_floor: "0..1"
    ref_shape: "local|cross"
  }

  %[physics]{
    "liminality: 1 (neighbor) — names bind to the immediate vicinity",
    "frequency: medium — naming happens once per probe candidate",
    "coupling: rising — coupling floor determines how strongly names bind",
    "cache: warm tier — name bindings are stable once established",
  }

  %[lsp_role]{
    "documentLink relies on named refs — p2 is the naming layer",
    "completion provider suggests names from the coupling graph",
    "cache: warm tier — name resolution rarely changes mid-session",
  }
}

?["Under what conditions does cache eviction resemble cellular apoptosis?"]
  #:depth #!experiential  // lens: cell
  $%[cache.tier] => ~#eviction_threshold
  ~<@biome/ocean/algos/material.spw>
  !probe{ "plot decay curves for hot→warm→cold tier transitions; compare with biological half-life λ = ln(2)/t½" }

?["What is the expected cache hit ratio under Zipf-distributed access patterns?"]
  #:depth #!computational  // lens: texture
  $%[cache.hit_rate, cache.miss_rate] => ~#zipf_alpha
  ~<@spw/biome/ocean/algos/cluster.spw>
  !probe{ "model P(hit) = 1 - (1/N)^α for N documents; measure deviation from theoretical optimum" }
