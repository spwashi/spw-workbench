# P6
#
# Phase 6 (^): integrate upward.
# Bind results into parent scope — emission, archival, or corpus gating.

#>spw_ocean_p6
#:phase #!integration
#:layer #!pragmatics

^"phase"{
  token: "^"
  =dialect: "experimental.ocean.phase"
  optional: {
    scope: "local|parent|global"
    archive_probe: "true|false"
    corpus_gate: ~"../../../tuning/corpus/corpus-policy.spw"
  }

  %[physics]{
    "liminality: global — integration emits results beyond current scope",
    "frequency: lowest — one integration per complete cycle",
    "coupling: radiating — results propagate upward through the frame tree",
    "cache: not cached — integration is a write operation, not a read",
  }

  %[lsp_role]{
    "^[] frames in .spw files are p6 products — integrated structure",
    "workspace manifest (workspace.spw) is the outermost p6 frame",
    "CodeLens on ^[] frames shows accumulated annotation density from p4 merge",
  }
}

?["How does this convention shape the developer's experience?"]
  #:scope #!file
  ~#probe: "trace which workflows or tooling reference this surface"

