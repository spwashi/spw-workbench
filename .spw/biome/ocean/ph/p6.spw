# P6
#
# Phase 6 (^): integrate upward.
# Bind results into parent scope — emission, archival, or corpus gating.

#>spw_ocean_p6
#:phase #!integration
#:layer #!pragmatics

^"phase"{
 token: "^"
 =dialect: "experimental.ocean.phase"
 optional: {
 scope: "local|parent|global"
 archive_probe: "true|false"
 corpus_gate: ~"../../../tuning/corpus/corpus-policy.spw"
 }

 %[physics]{
 "liminality: global — integration emits results beyond current scope",
 "frequency: lowest — one integration per complete cycle",
 "coupling: radiating — results propagate upward through the frame tree",
 "cache: not cached — integration is a write operation, not a read",
 }

 %[lsp_role]{
 "^[] frames in .spw files are p6 products — integrated structure",
 "workspace manifest (workspace.spw) is the outermost p6 frame",
 "CodeLens on ^[] frames shows accumulated annotation density from p4 merge",
 }
}

#>wonder_spw_biome_ocean_ph_p6_1
?["What is the curation density of phase?"]{
  #:depth #!computational // lens: curated collection
  $^["phase"]@biome => %[collection.measure]
  ~<../../../tuning/corpus/corpus-policy.spw>
  !probe{ "measure: how many distinct concepts does this frame bind? what is the ratio of structural operators to content — and what does that density reveal?" }
  $%[phase.index, phase.duration_ms, phase.entropy]
}

#>wonder_spw_biome_ocean_ph_p6_2
?["What is the metabolic signature of reading P6?"]{
  #:depth #!mathematical // lens: living system
  $%[line.operator_density, brace.nesting_rhythm] => ~#reading_feel
  ~#shape: "pragmatics layer, 2 frames, 4 annotations"
  !probe{ "read aloud for 30 seconds; where do you pause? pauses mark structural joints." }
  ~<.spw/biome/ocean/ph/p1.spw>  // nearest neighbor
}
