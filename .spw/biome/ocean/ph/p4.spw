# P4
#
# Phase 4 (&): merge categorized truths.
# Combine observations from multiple scopes into one cohesive frame.

#>spw_ocean_p4
#:phase #!merge
#:layer #!pragmatics

^"phase"{
  token: "&[#.]"
  =dialect: "experimental.ocean.phase"
  optional: {
    merge: "strict|soft|clustered"
    couple_min: "0..1"
    cluster_ref: ~"../algos/cluster.spw"
  }

  %[physics]{
    "liminality: 3 (cluster) — merge reaches across module boundaries",
    "frequency: low — merges happen at section/file granularity",
    "coupling: high — merge entangles frames that share annotations",
    "cache: warm tier — merged clusters are stable between saves",
  }

  %[lsp_role]{
    "annotation index clusters are p4 products — concept groups across files",
    "CodeLens annotation counts reflect merge density per frame",
    "cache: warm tier — cluster membership changes on save, not on keystroke",
  }
}

?["Under what conditions does cache eviction resemble cellular apoptosis?"]
  #:depth #!experiential  // lens: cell
  $%[cache.tier] => ~#eviction_threshold
  ~<@biome/ocean/algos/material.spw>
  !probe{ "plot decay curves for hot→warm→cold tier transitions; compare with biological half-life λ = ln(2)/t½" }

?["What is the expected cache hit ratio under Zipf-distributed access patterns?"]
  #:depth #!computational  // lens: texture
  $%[cache.hit_rate, cache.miss_rate] => ~#zipf_alpha
  ~<@spw/biome/ocean/algos/cluster.spw>
  !probe{ "model P(hit) = 1 - (1/N)^α for N documents; measure deviation from theoretical optimum" }
