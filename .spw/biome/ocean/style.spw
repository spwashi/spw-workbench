# Style Currents
#
# Visual-style development surface for Midjourney-like prompts and illustration language.
# Keeps style exploration aligned with Spw loop semantics.

#>spw_style_currents

^"intent"{
  ~#goal: "Develop a recognizable visual style while staying reproducible."
  ~#channels: ["midjourney_frame", "illustration_frame"]
}

^"midjourney_frame"{
  ~#subject: "what is depicted"
  ~#biome: "ocean biome context (reef/pelagic/estuary/tidal/benthic/seagrass)"
  ~#lens: "optical lens profile (focal_depth/aperture/magnification/aberration)"
  ~#materials: "electrolyte + plant motifs for texture and motion"
  ~#lighting: "phase-aware light cues (probe/observe/merge/materialize/integrate)"
  ~#negative_space: "what to avoid"
}

^"illustration_frame"{
  ~#line_language: "contour and stroke behavior"
  ~#shape_grammar: "how forms cluster and flow"
  ~#palette: "temperature and salinity-inspired color logic"
  ~#texture: "paper/grain/water diffusion strategy"
  ~#composition: "foreground-current-background layering"
}

^"style_probe_template"{
  fields: [
    "style_id",
    "channel",
    "prompt_snapshot",
    "reference_refs",
    "output_refs",
    "measures",
    "verdict",
  ]
  measures: ["cohesion", "novelty", "readability", "phase_alignment"]
}

^"invariants"{
  "Style runs reference one biome and one lens profile.",
  "Style prompts are snapshot-based; avoid unbounded transcript carryover.",
  "Accepted style probes can be promoted to tuning corpus with reviewer sign-off.",
}
