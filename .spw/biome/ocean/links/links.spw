# Reference Currents
#
# Linking registry for ocean-biome projections.

#>spw_ocean_reference_currents
#:layer #!pragmatics

^"intent"{
  ~#goal: "Make linking explicit and queryable with Spw selectors."
}

^"roots"{
  @ocean: ~"../"
  @core: ~"../../../"
  @docs: ~"../../../../docs"
  @lib: ~"../../../../lib/spw-v0.2.0-alpha"
}

^"selectors"{
  ~#registry: ".spw/biome/ocean/query/sel.spw"
  ~#navigable: refs_navigable
  ~#fields: phase_config
  ~#positional: positional_scope
  ~#aggregate: aggregate_branch
}

^links[core]{
  refs: [~"../atlas.spw", ~"../index.spw", @core/workspace.spw, @docs/design/spw/spirit-sequence.spw]
}

^links[style]{
  refs: [~"../style.spw", @core/process/loop-observation.spw, ~"../expr/custom.spw"]
}

^links[syntax]{
  refs: [~"../experiments/syntax.spw", @core/process/scoped-evolution.spw]
}

^links[cache]{
  refs: [~"../algos/cache.spw", @lib/applications/QUERY.md]
}

^"adjacency"{
  prepositions: {
    with: "< >"
    in: "( )"
    among: "[ ]"
    of: "{ }"
  }
}

?["Under what conditions does cache eviction resemble cellular apoptosis?"]
  #:depth #!experiential  // lens: cell
  $%[cache.tier] => ~#eviction_threshold
  ~<@biome/ocean/algos/material.spw>
  !probe{ "plot decay curves for hot→warm→cold tier transitions; compare with biological half-life λ = ln(2)/t½" }

?["What is the expected cache hit ratio under Zipf-distributed access patterns?"]
  #:depth #!computational  // lens: texture
  $%[cache.hit_rate, cache.miss_rate] => ~#zipf_alpha
  ~<@spw/biome/ocean/algos/cluster.spw>
  !probe{ "model P(hit) = 1 - (1/N)^α for N documents; measure deviation from theoretical optimum" }
