# Reference Currents
#
# Linking registry for ocean-biome projections.

#>spw_ocean_reference_currents
#:layer #!pragmatics

^"intent"{
 ~#goal: "Make linking explicit and queryable with Spw selectors."
}

^"roots"{
 @ocean: ~"../"
 @core: ~"../../../"
 @docs: ~"../../../../docs"
 @lib: ~"../../../../lib/spw-v0.2.0-alpha"
}

^"selectors"{
 ~#registry: ".spw/biome/ocean/query/sel.spw"
 ~#navigable: refs_navigable
 ~#fields: phase_config
 ~#positional: positional_scope
 ~#aggregate: aggregate_branch
}

^links[core]{
 refs: [~"../atlas.spw", ~"../index.spw", @core/workspace.spw, @docs/design/spw/spirit-sequence.spw]
}

^links[style]{
 refs: [~"../style.spw", @core/process/loop-observation.spw, ~"../expr/custom.spw"]
}

^links[syntax]{
 refs: [~"../experiments/syntax.spw", @core/process/scoped-evolution.spw]
}

^links[cache]{
 refs: [~"../algos/cache.spw", @lib/applications/QUERY.md]
}

^"adjacency"{
 prepositions: {
 with: "< >"
 in: "( )"
 among: "[ ]"
 of: "{ }"
 }
}

#>wonder_spw_biome_ocean_links_links_1
?["What concept is conspicuously absent from Reference Currents?"]{
  #:depth #!stylistic // lens: curated collection
  ~#present: [#experiential, #computational]
  ~#expected_but_missing: "?" // the reader fills this gap
  !probe{ "list what IS annotated; list what sibling files annotate; the difference is this file's blind spot or intentional boundary." }
  $%[biome.diversity_index, biome.annotation_density]
}

#>wonder_spw_biome_ocean_links_links_2
?["How does intent teach roots?"]{
  #:depth #!educational // lens: living system
  $^["intent"] => $^["roots"] // trace the edge
  &[@ocean, @core] // confluence of references
  !probe{ "draw the relationship: is it containment, reference, or emergent? does reversing the direction change meaning?" }
  $%[biome.diversity_index, biome.annotation_density]
  ~<.spw/biome/ocean/atlas.spw>  // nearest neighbor
}
