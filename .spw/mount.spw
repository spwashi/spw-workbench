# Mount
#
# ONF-safe mount source of truth for .spw canon-root behavior.

#>spw_mount
#:mount #!canon
#:layer #!pragmatics

^seed[Workbench.Mount.V01.ONF v:0.1 @profile:Spw.m @intent:mount-slice]
?(
 @(Orchestrator,#[SyntaxEvolver,CanonicalizerHasher,FuzzerAdversary,ParserGrammar,ProjectionMedia]),
 "implement Mount v0.1 slice; treat .spw as canon root and validate mount invariants"
)

^["runtime_contract"]{
 index: ~"./index.spw"
 workspace: ~"./workspace.spw"
 canon_mount: ~"./canon-mount.spw"
 eval: ~"./harness/evals/baseline-evals.spw"
}

^["nutritional_depth"]{
 #:semantics #!nutrition
 gloss_to_apposition: "prose comments transition into formal parser-visible readings and appositions"
 semantic_density: "every mounted block specifies @profile, @intent, and explicit spirit-phase (#!pragmatics, #!semantics, #!physics)"
 valence_tiers: "structural containers establish valence depth without reliance on static host language keywords"
 operator_physics: "combinatorics (^, ~, &, !, %, $, ?, #, @) express binding, reference, introspection, and evaluation"
}

^["organelle_configurability"]{
 #:config #!architecture
 consumer_authority: "the host workspace owns data, git history, and .spw/ manifests; mounted workbench at .spw/_workbench remains pure organelle engine"
 shelves_spw: ".spw/shelves.spw provides dynamic @alias root routing without hardcoded host paths"
 topology_spw: ".spw/topology.spw defines subroot classification (^subroot[name]) and cache-tier routing"
 editing_spw: ".spw/editing.spw defines macro categories (^category[macro]) projected into editor code lenses and statuslines"
 client_degradation: "LSP and editor plugins query self-describing workspace surfaces rather than baking in static keyword tables"
}

^["lock_policy"]{
 @lock: "advisory construct in v0.1 (validated by script, not parser-enforced)"
 semantic_hash: "hash(canonical(Spw.m))"
 surface_hash: "runtime write policy may lock selected .spw payloads"
}

^["experimental_surface"]{
 semicolon_newline_space: "proposed and tracked by diagnostics; not grammar-default in this slice"
 semicolon_prefixed_line: "proposed comment/compress style; diagnostics only in v0.1"
 interpreted_examples: ["example:<>", "example:;", "example:?<>"]
 status: "speculative ergonomics under scoped evolution"
}

^["invariant"]{
 "ONF seed in mount.spw stays parse-clean and hash-stable",
 "experimental syntax remains opt-in until grammar and fuzz gates pass",
 "consumer authority remains untouched when workbench organelle is mounted at .spw/_workbench",
}

#>wonder_spw_mount_1
?["What was Mount before it was this, and what could it become?"]{
  #:depth #!experiential ~#lens(formal structure)
  ~#past: "git log --oneline -- .spw/mount.spw | head -3"
  ~#future: "what frame would you add next?"
  !probe{ "the file's git history IS its evolutionary record; the next natural frame reveals the author's trajectory." }
  $%[runtime.stage, runtime.queue_depth]
}

#>wonder_spw_mount_2
?["How would a materials science algorithm express Workbench.Mount.V01.ONF v:0.1 @profile:Spw.m @intent:mount-slice?"]{
  #:depth #!computational // lens: material grain
  ~#translation_target: "materials science"
  ~#source_concept: "Workbench.Mount.V01.ONF v:0.1 @profile:Spw.m @intent:mount-slice"
  !probe{ "rewrite the root frame in materials science vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[runtime.stage, runtime.queue_depth]
  ~<".spw/agents.spw"> ~#neighbor(nearest)
}
