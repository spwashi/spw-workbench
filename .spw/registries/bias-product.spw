# Bias Product
#
# The verb-polymorphic bias edge: one declaration, many readings.
# `=` leans; what leaning *does* is decided by whoever follows the lean.

#>spw_bias_product
#:registry #!semantics

^"product"{
 ~#goal: "canonicalize `=`+body as a neutral directed edge { anchor, axis, targets, sign } with no verb baked in"
 ~#reader: "readBias (spw-seed, canonical/read-bias) — reports the edge, never acts on it"
 ~#selector: "spw select --selector bias  |  { sigil: '=', product: 'bias' }"
}

^"slots"{
 subject: "anchor — the from-pole; elided = the enclosing node (reflexive bias)"
 frame: "axis — which register is biased, bare identifier: =[depth]{ deep }"
 body: "targets — ranked, first strongest (the register_bias ordered-array convention, promoted)"
 valence: "sign — boon leans forward, bane leans inverse; the pentad is the direction vocabulary"
}

^"forms"{
 reflexive: `={ ~"template.spw" }`
 labeled: `=ref{ ~"registries/dialect-spec.spw#spw_dialect_registry" }`
 anchored: `=@old{ @new }`
 axial: `=[depth]{ deep shallow }`
 signed: `=bane@old{ @new }`
}

^"verbs"{
 # The same edge, read through three consumers. The verb lives in the consumer.
 mount: "resolution — follow the pointer, verify the surface exists (spw mount resolve)"
 mutate: "rewrite — anchored edges are an ordered patch; boon applies, bane reverts (spw mutate --bias)"
 expand: "template — reflexive path edges are provenance; project the unfolded view (spw expand)"
}

^"invariant"{
 "Seed stays verb-neutral: no consumer word may enter normalize or readBias.",
 "A bias edge that predates the product normalizes identically but for the product tag.",
 "Destructive consumers plan by default; only --write touches the workspace.",
 "Derived projections are outputs: <stem>.expanded.spw, scanner-excluded, recoverable to source.",
}

#>wonder_spw_registries_biasproduct_1
?["What else could leaning mean?"]{
  #:depth #!pragmatics // lens: verb polymorphism
  ~<.spw/registries/bias-product.spw> // introspect
  !probe{ "mount follows, mutate rewrites, expand precipitates — which consumer is missing? what would a *scheduler* or a *type-checker* do with the same edge?" }
  $%[edge.consumer_count, edge.verb_diversity]
}

#>wonder_spw_registries_biasproduct_2
?["Is the reflexive form a memory?"]{
  #:depth #!experiential // lens: provenance
  !probe{ "={ ~\"template\" } says 'I was expanded from this.' A surface that remembers its template can be folded back to a seed — is that compression, lineage, or identity?" }
  ~<".spw/runtime/precipitates.spw"> ~#neighbor(nearest)
}
