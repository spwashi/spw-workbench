# Dialect Registry
#
# Single source of truth for all Spw dialect markers.

#>spw_dialect_registry
#:dialect #!specification

^seed[Dialect.Registry.Clean v:0.1 @profile:Spw.b @intent:accurate-useful]
.dialect.registry {
  Spw.b: .{role:"block",      lex:"newline=statement boundary", scope:".spw/ exhibits + specs + architecture", geometry:"author", default:true}
  Spw.l: .{role:"line",       lex:"single-line compact (newline-as-space)", scope:"queries + probes + selectors", geometry:"search"}
  Spw.m: .{role:"mathematical",lex:"pure Operator Normal Form (F2-idempotent)", scope:"hash source + canonical truth", geometry:"machine"}
  Spw.x: .{role:"executable", lex:"@profile:Spw.x~#[flags] + @lock advisory", scope:"live .spw/ + runtime + hot evolution", geometry:"executable"}
}
.extensions #[Spw.o (ocean), Spw.q (query), Spw.t (template)] .{gate:"probe+cache", fallback:"Spw.l"}
.invariants #[
  "exactly one active dialect per .spw file at parse time"
  "absent marker → Spw.b (author geometry in .spw/)"
  "Spw.m is always the semantic ground truth for hash + identity"
  "dialect switching inside file forbidden (F2 stability)"
]
