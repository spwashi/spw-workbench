// Brace Physics Registry
#
// An interpretive physical profile over concrete delimiter behavior.
// Canonical tooling coordinates are open/close; charge, tension, and side
// language remain hypotheses until a named experiment measures them.

#>spw_brace_physics
#:layer #!theory

^"status"{
 implemented: "Seed parses Frame [], Body {}, Scope (), Capsule <…>, Stream <<>>, and NRange (()) forms with uneven delimiter retention. Digraph <> is OPERATOR couple. ONF attaches a discriminated frames.coupling projection to paired Bounds and the digraph."
 partial: "Frame, Body, and Scope expose optional label fields but the grammar does not populate paired labels or preserve their delimiter tokens. Stream ONF still borrows ? sigil; coupling.kind disambiguates."
 interpretive: ["charge", "tension", "feel", "operator tense", "left/right physics", "D4 symmetry"]
 proposed: ["paired source labels", "executable wonders", "query code lenses", "measured depth thresholds", "layout pulses", "runtime couple edges from Bound evaluation"]
}

^"terminology"{
 canonical: "paired boundary"
 profile_name: "brace physics is the historical interpretive profile name"
 rule: "brace/bracket membership is declared by profile; angle boundaries may be excluded without denying Capsule syntax"
}

^"coupling_extension"{
 @composition: ~"docs/theory/spw/operator-brace-composition.spw"
 @coupling_ts: ~"packages/spw-seed/src/types/coupling.ts"
 law: "Digraph <> and every paired Bound participate in one tagged coupling algebra without becoming the same lexical form or evaluator."
 kinds: #[couple, frame, body, scope, capsule, stream, nrange]
 forms: #[operator, boundary]
 operator_ports: #[before_operator, operand, after_operator]
 boundary_ports: #[before_open, open_boundary, inside, close_boundary, after_close]
 orthogonal_axes: #[kind, form, arity, occupancy, payload, act_placement, profile_measurements]
 relative_symmetry: "< ( [ { share open-boundary kinematics; capsule scope frame body retain different profile dynamics."
 runtime: "Only explicit <> may create register peer edges. A Boundary coupling tag records structure and grants no effect."
}

^"operational_contract"{
 @topography: ~"docs/theory/spw/operational-topography.spw"
 @coupling: ~"docs/theory/spw/coupling-constructors.spw"
 canonical_orientation: [open, close, before_open, inside, after_close]
 render_profiles: [left_right, accumulate_release, inward_outward]
 differential_axes: [layout, labels, structure, references, semantics, effects]
 rule: "A physical rendering may change labels, geometry, or emphasis; source mutation requires an exact parser-owned target, preview, source map, and declared effect authority."
 family: "Paired delimiters may share a semantic coupling interface without sharing one lexer token kind."
}

^"charge_table"{
 #:ontology #!brace_physics
 status: "reported interpretive profile; not embedded in Seed CouplingDescriptor or runtime evaluation"
 // Each brace pair carries an asymmetric charge at open/close ports.
 // Canonical coords are open/close; left/right remains render-only.
 // A tool must name this profile and revision before presenting these names.

 curly: {
 open: "{ — tension accumulator — opens a semantic field"
 close: "} — discharge — collapses the field into a unit"
 physics: "gravitational well — everything inside orbits the frame identity"
 charge: "+tension / −discharge"
 coupling_kind: body
 spirit_phase: "materialization boundary"
 }
 square: {
 open: "[ — selection — pins a coordinate in possibility space"
 close: "] — release — lets go of the selection"
 physics: "laser pointer — selects one thing from a continuum"
 charge: "+selection / −release"
 coupling_kind: frame
 spirit_phase: "addressing boundary"
 }
 paren: {
 open: "( — containment — captures flow"
 close: ") — emission — releases captured flow"
 physics: "cupped hands — holds without binding"
 charge: "+containment / −emission"
 coupling_kind: scope
 spirit_phase: "flow boundary"
 }
 angle: {
 open: "< — channel — directs intent into a typed conduit"
 close: "> — delivery — completes the conduit"
 charge: "+channel / −delivery"
 coupling_kind: capsule
 spirit_phase: "projection boundary"
  note: "capsule delimiters; digraph <> couple uses charge invite/bind"
 }
 stream: {
 open: "<< — ingress"
 close: ">> — egress"
 charge: "+ingress / −egress"
 coupling_kind: stream
 }
 couple_act: {
 operator: "<> relation surface"
 possible_profile: "invite / bind may annotate operand positions after a method defines direction"
 charge: "not an open/close polarity because <> is not a paired boundary"
 coupling_kind: couple
 note: "OPERATOR digraph with operand ports, not a Bound with interior ports"
 }

 act_placement: .{
  interior: "Act inside Bound — [!] {!} (!) → payload=act actPlacement=interior"
  prefix: "Act owns Bound — ![] !{} → frames.actPlacement=prefix"
  postfix: "Bound then Act — []! {}! is sequence juxtaposition today; Operation.position postfix proposed"
  law: "prefix/postfix are canonical; left/right is render-only"
 }
}

^"tension_gradient"{
 #:semantics #!brace_tension
 status: "interpretive hypothesis"
 // Line span may influence reported rhythm or navigation cost; it does not
 // create semantic mass merely by being long.

 percussive: {
 pattern: "!deploy{ @prod }"
 lines: 1
 feel: "snap — immediate, decisive"
 reading_speed: "glance"
 }
 sustained: {
 pattern: "^[\"migration\"]{ ... 40 lines ... }"
 lines: "10-50"
 feel: "held note — weight builds until } releases it"
 reading_speed: "scan, then collapse"
 }
 epic: {
 pattern: "^[\"workspace\"]{ ... 200+ lines ... }"
 lines: "50+"
 feel: "gravitational body — has its own internal structure"
 reading_speed: "navigate by sub-frames, never read linearly"
 }

 depth_budget: {
 recommended_max: 4
 warning_threshold: 5
 #!hypothesis: "A profile may warn past depth 4; measure task errors before treating that threshold as useful."
 extraction_rule: "Name the nested frame and reference it; don't inline complexity."
 }
}

^"operator_tenses"{
 #:semantics #!flow_direction
 status: "interpretive linguistic profile"
 // Operators impose temporal direction within a frame.
 // Flow reads left-to-right as time reads past-to-future.

 subjunctive: {
 sigil: "~"
 tense: "what could be — unresolved potential"
 feel: "anticipation, possibility, future"
 flow: "opens a timeline"
 }
 interrogative: {
 sigil: "?"
 tense: "what is asked — suspended between knowing and not"
 feel: "wonder, tension held as question"
 flow: "pauses the timeline"
 }
 imperative: {
 sigil: "!"
 tense: "what must happen — committed force"
 feel: "present, decisive, action"
 flow: "advances the timeline"
 }
 perfective: {
 sigil: "^"
 tense: "what was made — crystallized result"
 feel: "past, settled, artifact"
 flow: "closes the timeline"
 }
 observational: {
 sigil: "%"
 tense: "what is measured — the act of looking"
 feel: "present, receptive, non-invasive"
 flow: "reads the timeline without advancing it"
 }

 canonical_flow: "~ => ? => ! => ^ (potential → wonder → action → result)"
 #!hypothesis: "Some readers may interpret reversing the displayed sequence as intentional time reversal."
}

^"valence_composition"{
 #:semantics #!valence
 status: "interpretive profile"
 // Valence annotations compose within a frame.
 // The frame's overall charge is the sum of its valence markers.

 uniform: {
 pattern: "^[\"success\"]{ !boon ... !boon ... }"
 result: "stable — single polarity, no internal tension"
 feel: "resolved, consonant"
 }
 mixed: {
 pattern: "^[\"integration\"]{ !boon ... !bane ... }"
 result: "tense — holds contradiction"
 feel: "dissonant, intentional — the frame IS the container for conflict"
 }
 neutral: {
 pattern: "^[\"structure\"]{ !bone ... !bone ... }"
 result: "ground state — no charge, resting"
 feel: "skeletal, foundational"
 }
 catalytic: {
 pattern: "^[\"transition\"]{ !bonk ... }"
 result: "phase change — exists only during transformation"
 feel: "flash, ignition, momentary"
 }

 #!profile_rule: "Within this profile, mixed valence may be presented as deliberate tension rather than an error."
}

^"wonder_as_query"{
 #:pragmatics #!wonder_semantics
 status: "proposed interaction contract"
 // ?[...] questions may become executable queries after selector, request,
 // capability, and effect contracts exist. They are currently source forms.

 anatomy: {
 question: "?[\"text\"] — the human-readable prompt"
 scope: "#:scope — what this question ranges over (file, frame, workspace)"
 selector: "$~\"_\" — the selector expression this question expands to"
 priming: "~#var — variables this question primes for downstream use"
 handle: "#>anchor — the anchor name for cross-reference"
 release: "!release — what action resolves this question"
 }

 example_simple: {
 // A wonder question that the LSP can act on

 ?["Which @-roots resolve from this frame?"]
 #:scope #!frame
 $@_ // selector: expand all @-root references
 ~#resolved_roots // priming: populate this variable with results
 #>wonder_roots // handle: reachable by #>wonder_roots
 !release{ "hover or code lens shows resolved list" }
 }

 example_comparison: {
 // A wonder question that compares v0.1.0 and v0.2.0 specs

 ?["How did the operator table change between versions?"]
 #:scope #!workspace
 $^["operators"]@spec // selector: operators frame in v0.2.0
 $^["operators"]@spec/../spw-v0.1.0-alpha // selector: operators frame in v0.1.0
 ~#delta // priming: the diff between them
 !release{ "side-by-side in editor diff" }
 }

 example_hot: {
 // A wonder question that triggers hot-replacement exploration

 ?["What happens if I rename this annotation?"]
 #:scope #!workspace
 $#focus // selector: expand all #focus annotations
 ~#rename_preview // priming: preview of what rename would touch
 !release{ "F2 rename with preview pane" }
 }

 lsp_hooks: {
 status: "proposed; no Run Query capability is currently advertised"
 recognition: "LSP recognizes ?[...] blocks with $-selectors as executable"
 code_lens: "Show 'Run Query' code lens above each ?[...] block"
 hover: "Hover on $-selector shows expansion preview"
 completion: "Inside ?[...], trigger $ completion for available selectors"
 }

 #!target: "A query-enabled wonder declares a selector, scope, evidence packet, and effect grade."
 #!current: "Wonder questions may remain prose whether or not they contain selector-like text."
}

^"brace_side_semantics"{
 #:grammar #!brace_sides
 status: "render-only orientation profile"
 // Extension of curiosity-brace.spw — one optional left/right rendering
 // over canonical open/close boundaries.

 left: {
 role: "intrinsic — the identity, the key, the charge accumulator"
 physics: "what the frame IS before it has content"
 example: "^[\"identity\"]{ — the { carries the frame's name and intent"
 }
 right: {
 role: "extrinsic — the value, the discharge, the materialized content"
 physics: "what the frame PRODUCES when it collapses"
 example: "} — this } releases everything accumulated since {"
 }
 resonance: {
 rule: "a tool may jointly highlight a parser-owned open/close pair"
 visibility: "editor highlights both when cursor touches either"
 symmetry: "D4 reflection is a proposed visualization, not grammar or runtime behavior"
 }
}

^"hypotheses"{
 status: "interpretive or proposed"
 statements: [
  "An accumulate/release rendering may help some readers track open/close pairs.",
  "Line span and nesting may correlate with navigation cost or reported tension under a declared profile.",
  "A potential→wonder→action→result ordering may be a learnable linguistic mnemonic.",
  "Paired labels and layout differentials may make long containers easier to reorient or refactor.",
 ]
 falsifiers: [
  "The rendering changes tokens, parse, normalized projection, references, or effects.",
  "A claimed threshold does not predict a preregistered behavioral or explicit-report metric.",
  "A label or indentation pulse cannot preserve pair identity and reach an idempotent fixed point.",
  "A proposed LSP interaction is described as implemented without an advertised, invoked, observed, and tested capability.",
 ]
}

#>wonder_spw_registries_bracephysics_1
?["What concept is conspicuously absent from Brace Physics Registry?"]{
  #:depth #!stylistic // lens: molecular binding
  ~#present: [#ontology, #brace_physics, #brace_tension]
  ~#expected_but_missing: "?" // the reader fills this gap
  !probe{ "list what IS annotated; list what sibling files annotate; the difference is this file's blind spot or intentional boundary." }
  $%[registry.entry_count, registry.referrer_count]
}

#>wonder_spw_registries_bracephysics_2
?["How does charge_table teach tension_gradient?"]{
  #:depth #!educational // lens: ecological zone
  $^["charge_table"] => $^["tension_gradient"] // trace the edge
  &[@prod, @_] // confluence of references
  !probe{ "draw the relationship: is it containment, reference, or emergent? does reversing the direction change meaning?" }
  $%[registry.entry_count, registry.referrer_count]
  ~<.spw/registries/curiosity-brace.spw>  // nearest neighbor
}
