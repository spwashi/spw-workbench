# Curiosity Brace Registry
#
# Unified brace-side + symmetry ergonomics source of truth.

#>spw_curiosity_brace
#:brace #!registry
#:layer #!grammar

^seed[Curiosity.Brace.Registry v:0.1 @profile:Spw.b @intent:unified-creative-ergonomic]
.curiosity.brace.registry {
 sides: {
 left: "intrinsic/key — bound to opening brace"
 right: "extrinsic/value — bound to closing brace"
 selection: "x.left | x.right | x?left | x: inline"
 splitter: ": = ergonomic key:value side splitter"
 chain: "a.b.c.left propagates left-side selection"
 }
 symmetry: {
 mechanic: "any frame .{sym:D4} or #[D4] auto-applies dihedral group"
 mirror: ".left ↔ .right automatic reflection + mirrored register updates"
 rule: "mutation on one side reflects to the other under symmetry"
 }
 ergonomic: {
 inspection: "x:? | ?@x | x?<inspect>"
 inline: "data: content fills left side"
 composable: "?<> chaining + & confluence + # resonance"
 creative: "glyph probes + backtick phrases + symmetry facets"
 }
}
.invariants #[
 "left always binds to opening brace"
 "symmetry D4 mirrors .left ↔ .right in register bank"
 "all selections desugar to core probe + facet ONF"
 ":inline fills left side (key); right side emerges from value"
]

#>wonder_spw_registries_curiositybrace_1
?["What ripples if #brace changes in this file?"]{
  #:depth #!mathematical // lens: formal structure
  $#brace@workspace => %[reference.count, depth.downstream]
  ~#downstream: "trace all files that reference this surface"
  !probe{ "imagine renaming #brace to #brace_v2; count broken references; the count reveals how deeply intrinsic/key — bound to opening brace is woven into the workspace." }
  $%[registry.entry_count, registry.referrer_count]
}

#>wonder_spw_registries_curiositybrace_2
?["What happens when you zoom from the token level to the workspace level in Curiosity Brace Registry?"]{
  #:depth #!stylistic // lens: material grain
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "Curiosity.Brace.Registry v:0.1 @profile:Spw.b @intent:unified-creative-ergonomic" // this file's atom
  !probe{ "the atom is token-scale; zoom out: what workspace-level pattern does this token participate in?" }
  $%[registry.entry_count, registry.referrer_count]
  ~<".spw/registries/brace-physics.spw"> ~#neighbor(nearest)
}
