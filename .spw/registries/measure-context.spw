// Measure context registry — Spw defines families and algorithms
//
// %mass is one thrift family: operator % + identifier mass, subject_file scope,
// @self bind, thrift.file_physics algorithm. The kernel is measure protocol +
// attentional scopes + perceptive planes + representational forms — not mass.
//
// @see packages/spw-seed/src/canonical/measure-protocol.ts
// @see docs/theory/spw/measure-context-kernel.spw
// @see packages/spw-seed/src/canonical/self-mass.ts

#:layer #!pragmatics
#:status #!partial

^seed[Workbench.Registry.Measure.Context v:0.1 @profile:Spw.b @intent:measure_kernel]

^["roots"]{
 @protocol: ~"../../packages/spw-seed/src/canonical/measure-protocol.ts"
 @mass_impl: ~"../../packages/spw-seed/src/canonical/self-mass.ts"
 @theory: ~"../../docs/theory/spw/measure-context-kernel.spw"
 @ir: ~"../../packages/spw-seed/src/ir"
}

^["thesis"]{
 ~#claim: "File-level syntactic context for a measure is assumed from Spw definitions of operator and identifier products — not from CLI hard-coding alone."
 ~#taste: "mass is thrift specialization · algorithms are named · scopes and planes compose"
}

// ── Operator % product: mass (example of file-level context) ───

^["family"]{
 id: mass
 operator: "%"
 identifier: mass
 plane: thrift
 scope: subject_file
 subject: self
 keys: #[lines, bytes]
 scheme: exact
 algorithm: thrift.file_physics
 form: vector
 note: "Compelling exact reconcile product; not the whole measure kernel"
}

// Example surface grammar this family authorizes:
//   ^["module"]{
//     @self: ~"../src/foo.ts"
//     %mass{ lines: 100, bytes: 3200 }
//   }
// Syntactic context: nearest @self in body; % + mass facet; numeric keys only.

^["family"]{
 id: density
 operator: "%"
 identifier: density
 plane: syntax
 scope: surface
 subject: none
 keys: #[ops, depth, frames]
 scheme: band
 algorithm: syntax.form_density
 form: vector
 note: "Proposed — FormIR / geometry observe"
}

^["family"]{
 id: authority
 operator: "%"
 identifier: authority
 plane: authority
 scope: subject_file
 subject: self
 keys: #[writes, joins, reads]
 scheme: exact
 algorithm: authority.host_extract
 form: table
 note: "Twin to !writes streams; measure-shaped"
}

// ── Algorithms (Spw-described processing recipes) ──────────────

^["algorithm"]{
 id: thrift.file_physics
 plane: thrift
 scope: subject_file
 form: vector
 host: fs
 steps: #[
  "resolve subject from self bind"
  "read host bytes"
  "count lines and bytes"
  "return observations"
 ]
 note: "Host observes; seed reconciles under scheme"
}

^["algorithm"]{
 id: syntax.form_density
 plane: syntax
 scope: surface
 form: vector
 host: seed-geometry
 steps: #[
  "reuse ParseIR or parse surface"
  "inspectGeometry / FormIR"
  "emit ops depth frames"
 ]
}

^["algorithm"]{
 id: attention.scope_walk
 plane: graph
 scope: selection
 form: stream
 host: runtime-session
 steps: #[
  "take AttentionalScope or SelectionIR"
  "apply lens stack and channel"
  "for each uri open perceptive plane"
  "run family algorithm"
  "precipitate MeasureIR"
  "optional crystallize window"
 ]
 note: "Scalable kernel: Spw names the walk; hosts plug plane extractors"
}

// ── Planes · scopes · forms (vocabulary for kernel growth) ─────

^["planes"]{
 thrift: "file physics"
 syntax: "brace and operator form"
 graph: "pathRef topology"
 flow: "protocol roles and schedules"
 authority: "host capability claims"
 probe: "wonder and !probe density"
 runtime: "register and substrate"
}

^["scopes"]{
 subject_file: "one host path from surface bind"
 surface: "the .spw text itself"
 selection: "multi-uri SelectionIR"
 ego: "graph neighborhood"
 window: "stream or line window"
 corpus: "multi-root"
}

^["forms"]{
 scalar: "one number"
 vector: "named metrics map"
 table: "rows of claims"
 stream: "ordered MeasureIR frames"
 ir_slice: "interconnect-attached measure node"
}

^["examples"]{
 mass_surface: |
  ^["module"]{
   @self: ~"packages/spw-seed/src/index.ts"
   %mass{ lines: 100, bytes: 4000 }
  }

 density_surface: |
  ^["surface"]{
   %density{ ops: 12, depth: 3, frames: 8 }
  }

 walk: |
  // algorithm attention.scope_walk
  // scope: selection of prompts/**
  // plane per family: thrift on @self modules, syntax on .spw
}

^["open"]{
 ?[scheme_grammar]: "How is band/tol written next to a key in %mass{ lines: 100 }?"
 ?[multi_family]: "One body with %mass and %density — shared @self or per-facet?"
 ?[kernel_boundary]: "Which algorithms must stay host-only forever?"
 ?[spw_algo]: "Can steps[] themselves be Spw executable later?"
 ?[plane_plugin]: "Editor plugins register new planes without seed releases?"
}

#>wonder_measure_context_1
?["If mass vanished, what still measures truthfully?"]{
  !probe{ =id[p_without_mass] }
  $%[family, plane, algorithm]
}

#>wonder_measure_context_2
?["Who teaches the CLI that %mass means subject_file?"]{
  !probe{ =id[p_context_source] }
  // free: this registry; lock: not mass.ts alone
  ~<.spw/registries/measure-context.spw>
}
