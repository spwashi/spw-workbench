# Agents
#
# Agent-harness shelf mapping for .spw workflows.

#>spw_agents
#:convention #!agents
#:layer #!pragmatics

^"roots"{
 @agents: ~"../.agents"
 @plans: ~"../.agents/plans"
 @plan_index: ~"../.agents/plans/index.spw"
 @plan_schema: ~"../.agents/plans/_schema/wip.spw"
 @state: ~"../.agents/state"
 @skills: ~"../.agents/skills"
}

^"integration"{
 harness: @spw/harness
 memory: @spw/harness/memory-surface.spw
 probes: @spw/harness/probes
}

^"policy"{
 "enter the plan ecology through @plan_index; each row routes to a card, each card to its entry",
 "agent context snapshots should reference @plans and @state, not raw chat logs",
 "agent-derived projections must be marked generated when written under @gen",
}

#>wonder_spw_agents_1
?["How would a biology portfolio express .spw/agents?"]{
  #:depth #!stylistic ~#lens(living system)
  ~#translation_target: "biology"
  ~#source_concept: "roots"
  !probe{ "rewrite the root frame in biology vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[file.frame_count, file.annotation_density, file.brace_depth_max]
}

#>wonder_spw_agents_2
?["How does this file's voice differ from @agents?"]{
  #:depth #!educational // lens: curated collection
  ~<@agents> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]@agents
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}
