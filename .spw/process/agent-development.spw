# Agent Development
# A route from an inherited explanation to a useful, falsifiable next move.
#>agent_development
#:layer #!pragmatics

^["roots"]{
 @agents: ~"../agents.spw"
 @plans: ~"../../.agents/plans/index.spw"
 @direction: ~"../../.agents/plans/plan-ecology-clustering/PLAN.md"
 @theory: ~"../../docs/theory/index.spw"
 @bridge: ~"../../lib/spw-v0.3.0/architecture/theory-bridge.spw"
 @contours: ~"../../docs/theory/spw/form-contours.spw"
 @disclosure: ~"../../docs/theory/spw/representational-disclosure.spw"
 @claims: ~"../harness/claim-protocol.spw"
 @cognitive_surfaces: ~"../tooling/cognitive-surfaces.spw"
 @seeds: ~"../harness/probes/creative-seeds.spw"
 @review: ~"../harness/runs/2026-10-19-theory-direction.spw"
 @runs: ~"../harness/runs/runs-index.spw"
 @cache_care: ~"../caches/extend.spw"
}

^["start"]{
 status: "authored workflow; usefulness awaits door trials"
 purpose: "Spw evolves the language; Boonhonk keeps room for wonder. Leave an exhibit, claim or instrument another agent can question."
 resume: "Read one plan card, its entry and latest stream; inspect recent episode bodies and the affected source before accepting its next move."
 command: "npm run spw:plan:status -- --slug <slug>"
 question: "What should become more useful, and what should become better explained? Name both; either may remain untested."
}

^["read"]{
 route: [@bridge, @theory, @contours, @disclosure]
 distinction: "implemented describes code; measured names a method and result; proposed names a candidate; interpretive names a reading profile"
 task: "Pick one claim and trace its theory, implementation, test and consumer. Missing links are findings, not invitations to invent evidence."
 history: "git log -8 --format=full -- <affected-path>"
 receipt: @review
}

^["probe"]{
 task: "Preserve the current explanation and one awkward example. Write an alternative that predicts a different result, then choose the smallest discriminating probe."
 control: "Name what must remain unchanged and what would refute each explanation before inspecting the result."
 authority: "Evidence basis and effect authority are independent. Reading, sandbox evaluation, workspace edits and external effects retain their own authorization boundaries."
 outcome: "Keep pass, failure, unknown and not-run distinct. A zero requires an observation; a hypothesis requires no invented score."
 creative_route: @seeds
}

^["revise"]{
 task: "Change the owning plan or theory only as far as the evidence supports. Retain counterexamples and failed explanations with their source revision."
 next: "Choose one useful slice after each result. Reorder the queue if a better question emerges; do not turn every seed into a plan."
 placement: "Stable doctrine belongs to its existing theory or canon owner; dated observations belong in a new run; maintained reference leaves follow cache_care."
 stop: "Stop when the bounded result is reviewable, or when the probe cannot distinguish the alternatives; record the missing instrument."
}

^["model_upgrade"]{
 intent: "A stronger model should increase useful capability and explanatory power. It may challenge the framing, not just execute the inherited queue faster."
 retain: "source revision, task, context refs and budget, model identity/settings when available, harness/tool versions, baseline, controls, output and verdict"
 compare: "Use equivalent tasks and conditions; record changes in model and harness separately. If comparison conditions differ, report the observed improvement without attributing it solely to the model."
 negative_result: "A more fluent explanation without a better prediction or useful outcome is not evidence of an advance."
}

^["handoff"]{
 carry: ["question", "owner plan", "claim status", "source revision", "evidence refs", "counterexample", "next bounded action", "stop condition"]
 omit: "Raw chat transcripts, private consumer identity, and repeated full copies of referenced theory."
 check: "Run scoped syntax and link checks; use the owning package tests for behavior changes. A route check is not a usability study."
}

^["cognitive_redesign"]{
 route: @cognitive_surfaces
 opportunity: "IR journeys and memory differences can reveal a better question or interface; preserve current products as a comparison baseline."
 first: "Choose one locate-divergence or explain-invalidation task before designing a new pane."
}
