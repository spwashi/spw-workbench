# Hot Reload Loop
#
# Development server contract for rapid .spw iteration.

#>spw_hot_reload_loop
#:layer #!pragmatics

^"intent"{
  ~#goal: "Provide fast feedback while editing .spw artifacts."
  ~#entry: "npm run spw:dev"
}

^"watch_scope"{
  ~#roots: [".spw", "docs/design/spw", "lib/spw-v0.2.0-alpha"]
  ~#file_types: [".spw"]
}

^"loop"{
  beat_1: "detect changed .spw file"
  beat_2: "canonicalize changed file"
  beat_3: "parse and report syntax health"
  beat_4: "surface probe/evolution impact hints"
}

^"surface"{
  ~#status_fields: ["file", "parse_ok", "error_count", "phase_hint", "next_action"]
  ~#phase_hint_rule: "map watcher events to ?~, @, &, *, ^ when possible"
}

^"invariants"{
  "Hot reload never rewrites unrelated files.",
  "Formatting and validation stay scoped to changed paths.",
  "Errors surface with line/column and operator context.",
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
