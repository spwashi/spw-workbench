# Hot Reload Loop
#
# Development server contract for rapid .spw iteration.

#>spw_hot_reload_loop
#:layer #!pragmatics

^"intent"{
 ~#goal: "Provide fast feedback while editing .spw artifacts."
 ~#entry: "npm run spw:dev"
}

^"watch_scope"{
 ~#roots: [".spw", "docs/design/spw", "lib/spw-v0.2.0-alpha"]
 ~#file_types: [".spw"]
}

^"loop"{
 beat_1: "detect changed .spw file"
 beat_2: "canonicalize changed file"
 beat_3: "parse and report syntax health"
 beat_4: "surface probe/evolution impact hints"
}

^"surface"{
 ~#status_fields: ["file", "parse_ok", "error_count", "phase_hint", "next_action"]
 ~#phase_hint_rule: "map watcher events to ?~, @, &, *, ^ when possible"
}

^"invariants"{
 "Hot reload never rewrites unrelated files.",
 "Formatting and validation stay scoped to changed paths.",
 "Errors surface with line/column and operator context.",
}

#>wonder_spw_process_hotreloadloop_1
?["What is the felt rhythm of reading Hot Reload Loop?"]{
  #:depth #!experiential // lens: material grain
  $%[line.operator_density, brace.nesting_rhythm] => ~#reading_feel
  ~#structure: "intent → watch_scope → loop" // frame flow
  !probe{ "read aloud for 30 seconds; where do you pause? pauses mark grain boundaries." }
}

#>wonder_spw_process_hotreloadloop_2
?["What concept is conspicuously absent from Hot Reload Loop?"]{
  #:depth #!computational // lens: formal structure
  ~#present: [#educational, #mathematical]
  ~#expected_but_missing: "?" // the reader fills this gap
  !probe{ "list what IS annotated; list what sibling files annotate; the difference is this file's blind spot or intentional boundary." }
  $%[process.cycle_time_ms, process.iteration_count]
  ~<.spw/process/loop-observation.spw>  // nearest neighbor
}
