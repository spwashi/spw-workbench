# Tuning Corpus Policy
#
# Curation and admission rules for training/evaluation-ready corpus items.

#>spw_tuning_corpus_policy
#:layer #!pragmatics

^"intent"{
  ~#goal: "Only promote high-signal, reviewed artifacts into tuning corpus."
  ~#ethos: "Traceable provenance over volume."
}

^"admission"{
  ~#required: [
    "item_id",
    "run_id",
    "source_path",
    "reviewer",
    "license",
    "quality_score",
    "verdict",
  ]
  ~#gate: "verdict == accept and quality_score >= 0.9"
}

^"exclusions"{
  "No secrets, credentials, or private tokens.",
  "No PII without explicit redaction + approval record.",
  "No unresolved TODO/FIXME placeholders in training examples.",
}

^"lineage"{
  ~#traceability: "Every corpus item links to one harness run id."
  ~#reproducibility: "Source path and revision hash are required."
}

^"seed_item"{
  item: {
    item_id: "corpus-0001"
    run_id: "run-0001"
    source_path: ".spw/workspace.spw"
    reviewer: "human-required"
    license: "repo-internal"
    quality_score: 1.0
    verdict: "accept"
  }
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
