# Tuning Corpus Policy
#
# Curation and admission rules for training/evaluation-ready corpus items.

#>spw_tuning_corpus_policy
#:layer #!pragmatics

^"intent"{
 ~#goal: "Only promote high-signal, reviewed artifacts into tuning corpus."
 ~#ethos: "Traceable provenance over volume."
}

^"admission"{
 ~#required: [
 "item_id",
 "run_id",
 "source_path",
 "reviewer",
 "license",
 "quality_score",
 "verdict",
 ]
 ~#gate: "verdict == accept and quality_score >= 0.9"
}

^"exclusions"{
 "No secrets, credentials, or private tokens.",
 "No PII without explicit redaction + approval record.",
 "No unresolved TODO/FIXME placeholders in training examples.",
}

^"lineage"{
 ~#traceability: "Every corpus item links to one harness run id."
 ~#reproducibility: "Source path and revision hash are required."
}

^"seed_item"{
 item: {
 item_id: "corpus-0001"
 run_id: "run-0001"
 source_path: ".spw/workspace.spw"
 reviewer: "human-required"
 license: "repo-internal"
 quality_score: 1.0
 verdict: "accept"
 }
}

#>wonder_spw_tuning_corpus_corpuspolicy_1
?["How does intent teach admission?"]{
  #:depth #!educational // lens: material grain
  $^["intent"] => $^["admission"] // trace the edge
  &[@_, @spw] // confluence of references
  !probe{ "draw the relationship: is it containment, reference, or emergent? does reversing the direction change meaning?" }
  $%[file.frame_count, file.annotation_density, file.brace_depth_max]
}

#>wonder_spw_tuning_corpus_corpuspolicy_2
?["What is the algebraic closure of admission (corpus/corpus-policy)?"]{
  #:depth #!experiential // lens: formal structure
  $^["intent"]@_ => %[formula.measure]
  ~<.spw/tuning/corpus/corpus-policy.spw> // introspect
  !probe{ "measure: how many distinct concepts does this frame bind? what is the ratio of structural operators to content — and what does that density reveal?" }
  $%[file.frame_count, file.annotation_density, file.brace_depth_max]
}
