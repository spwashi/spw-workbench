# Spw Index
#
# Canon-root index for .spw surfaces.

#>spw_index
#:index #!canon
#:layer #!pragmatics

^"intent"{
 ~#goal: "Provide one root entrypoint for mount, workspace, biome, harness, conventions, patterns, and projection surfaces."
 ~#taste: "Every root declared here resolves, and no canon surface is reachable only by already knowing where it lives."
}

^"roots"{
 @spw: ~"."
 @workspace: ~"./workspace.spw"
 @mount: ~"./mount.spw"
 @canon_mount: ~"./canon-mount.spw"
 @dialect_registry: ~"./registries/dialect-spec.spw"
 @register_bank_registry: ~"./registries/register-bank.spw"
 @bias_product_registry: ~"./registries/bias-product.spw"
 @curiosity_brace: ~"./registries/curiosity-brace.spw"
 @symmetry_apps: ~"./applications/symmetry/symmetry-applications.spw"
 @symmetry_ui: ~"./applications/symmetry/symmetry-ui-design.spw"
 @symmetry_fps: ~"./applications/symmetry/symmetry-forecast-projection-sound.spw"
 @symmetry_cog: ~"./applications/symmetry/symmetry-cognitive-engine.spw"
 @symmetry_spell: ~"./applications/symmetry/symmetry-spellcasting-pattern.spw"
 @tooling_vscode: ~"./tooling/vscode-spw.spw"
 @tooling_intellij: ~"./tooling/intellij-plugin.spw"
 @tooling_neovim: ~"./tooling/neovim-spw.spw"
 @tooling_instruments: ~"./tooling/editor-instruments.spw"
 @tooling_audit: ~"./tooling/editor-surface-audit.spw"
 @conventions: ~"./conventions/index.spw"
 @selection_conventions: ~"./conventions/selection.spw"
 @naming_conventions: ~"./conventions/naming.spw"
 @cli_conventions: ~"./conventions/cli.spw"
 @submodule_conventions: ~"./conventions/submodule.spw"
 @surface_archetypes: ~"./surfaces/surface-archetypes.spw"
 @patterns: ~"./patterns/index.spw"
 @pattern_literate_architecture: ~"./patterns/literate-architecture.spw"
 @pattern_query_composition: ~"./patterns/query-composition.spw"
 @pattern_literate_ui: ~"./patterns/literate-ui.spw"
 @biome: ~"./biome/ocean/index.spw"
 @literate_architecture: ~"./literate/architecture/index.spw"
 @harness: ~"./harness/evals/baseline-evals.spw"
 @claim_protocol: ~"./harness/claim-protocol.spw"
 @process: ~"./process"
 @gen: ~"./gen/index.spw"
 @hot: ~"./hot.spw"
 @topology: ~"./topology.spw"
}

^"dispatch"{
 mount: @mount
 workspace: @workspace
 biome: @biome
 harness: @harness
 projections: @gen
 runtime_hot: @hot
 routing: @topology
 conventions: @conventions
 conventions_selection: @selection_conventions
 conventions_naming: @naming_conventions
 conventions_cli: @cli_conventions
 conventions_submodule: @submodule_conventions
 surface_archetypes: @surface_archetypes
 patterns: @patterns
 pattern_literate_architecture: @pattern_literate_architecture
 pattern_query_composition: @pattern_query_composition
 pattern_literate_ui: @pattern_literate_ui
 literate_architecture: @literate_architecture
 dialect: @dialect_registry
 registers: @register_bank_registry
 bias: @bias_product_registry
 curiosity: @curiosity_brace
 symmetry_applications: @symmetry_apps
 symmetry_ui: @symmetry_ui
 symmetry_forecast_projection_sound: @symmetry_fps
 symmetry_cognitive: @symmetry_cog
 symmetry_spellcasting_pattern: @symmetry_spell
 tooling_vscode: @tooling_vscode
 tooling_intellij: @tooling_intellij
 tooling_neovim: @tooling_neovim
 tooling_instruments: @tooling_instruments
 tooling_audit: @tooling_audit
 process: @process
 claims: @claim_protocol
}

^"invariant"{
 "index.spw is a stable map, not a high-churn projection body",
 "mount.spw is ONF-safe source of truth for mount slice state",
 "canon-mount.spw may contain richer experimental/literary framing",
}

#>wonder_spw_index_1
?["What invariant holds across every frame in Spw Index?"]{
  #:depth #!computational // lens: living system
  $^["_"]@here => %[shared.property]
  ~#hypothesis: "all frames in this file share ____"
  !probe{ "extract the property common to every frame in this file; if none exists, the file may lack cohesion or may be a deliberate collection." }
  $%[register.bank_size, register.active_bindings]
}

#>wonder_spw_index_2
?["What was Spw Index before it was this, and what could it become?"]{
  #:depth #!mathematical // lens: curated collection
  ~#past: "git log --oneline -- .spw/index.spw | head -3"
  ~#future: "what frame would you add next?"
  !probe{ "the file's git history IS its evolutionary record; the next natural frame reveals the author's trajectory." }
  $%[register.bank_size, register.active_bindings]
  ~<".spw/agents.spw"> ~#neighbor(nearest)
}
