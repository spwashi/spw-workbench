   care: #adversarial, outcome: #pass }
 }
 corrections: #[
  "Picard-Lindelof is now stated as local; y prime equals y squared shows solutions can blow up in finite time",
  "phase-plane classification from linearization now requires hyperbolic equilibria; linear centers can become spirals in the nonlinear system",
  "Fourier series for boundary data now converge in mean square for square-integrable data, with pointwise convergence needing more",
  "the ODE and PDE rows moved here from the pure core so the pure ladder and the engineering ladder each have one home",
  "Fourier no longer introduces trigonometric series; Bernoulli and Euler used them first, and his heat work dates from the 1807 memoir"
 ]
}

^["edges"]{
 needs: [ ~"./calculus-and-linear-algebra.spw#mathematics_calc_eigen" ]
 feeds: [ ~"./transforms-and-complex-methods.spw#mathematics_transforms", ~"./numerical-methods.spw#mathematics_numerics", ~"../../../physical/engineering/transport-phenomena.spw#engineering_transport", ~"../../../physical/engineering/control-and-signals.spw#engineering_control_signals" ]
