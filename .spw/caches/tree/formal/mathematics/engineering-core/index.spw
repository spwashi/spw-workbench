# Engineering Mathematics Core
#
# The six working tools the pure ladder lacked: calculus and matrices, differential equations, probability, transforms, numerics, and optimization.

#>mathematics_engcore_index
#:layer #!reference
#:domain #!mathematics
#:form #!index
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Engineering Mathematics Core"
 ~#claim: "Six tools carry most engineering mathematics, and each leaf names the downstream course that uses it."
 ~#proof: "ABET sets a floor of mathematics and basic science credit; each leaf cites its standard text and links its downstream nodes."
 ~#door: "Start with calculus and linear algebra; take probability early if you head toward data, operations, or economics."
 ~#audience: "engineering, physics, and economics students planning a mathematics sequence"
 continuity: "Engineering Mathematics Core | six tools"
 cold_open: "Six tools carry most engineering mathematics, and each leaf here names the course downstream that will use it."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #pass }
  ^["r5"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #corrected }
 }
 corrections: #[
  "the ABET floor now names the 2026 to 2027 cycle current at as_of, unchanged at 30 hours, and covers accredited programs abroad, not only in the US",
  "the pre-entry coursework clause is recorded as a proposal for 2027 to 2028, not as part of the 2026 to 2027 criteria"
 ]
}

^["tree"]{
 calculus_linear_algebra: ~"./calculus-and-linear-algebra.spw"
 differential_equations: ~"./differential-equations.spw"
 probability_statistics: ~"./probability-and-statistics.spw"
 transforms: ~"./transforms-and-complex-methods.spw"
 numerics: ~"./numerical-methods.spw"
 optimization: ~"./optimization.spw"
}

^["bundle"]{
 ={ ~"./calculus-and-linear-algebra.spw#mathematics_calc_linalg" }
 ={ ~"./differential-equations.spw#mathematics_diffeq" }
 ={ ~"./probability-and-statistics.spw#mathematics_probstat" }
 ={ ~"./transforms-and-complex-methods.spw#mathematics_transforms" }
 ={ ~"./numerical-methods.spw#mathematics_numerics" }
 ={ ~"./optimization.spw#mathematics_optimization" }
}

^["sequence"]{
 typical: << "calculus and linear algebra" ; "differential equations" ; "probability and statistics" ; "transforms" ; "numerical methods" ; "optimization" >>
 note: "probability needs only multivariable calculus, so data and operations students can take it second"
 forms: "curriculum for the three prerequisite graphs, comparison for transforms and optimization, probe_battery for numerics"
}

^["floor"]{
 #>mathematics_engcore_abet
 ^["abet_minimum"]{
  #:claim #!settled
  statement: "ABET EAC Criterion 5 for the 2026 to 2027 cycle, unchanged from 2025 to 2026, requires at least 30 semester credit hours or the equivalent of college-level mathematics and basic sciences."
  reads: %[formal.dated.abet_math_science_credits]
  sources: [ ~"../../../registries/sources/formal.spw#src_formal_abet_2026", ~"../../../registries/sources/formal.spw#src_formal_abet_2025" ]
  as_of: "2026-10-03"
  ^["limits"]{
   holds: "ABET-accredited baccalaureate engineering programs, in the US and abroad; the basic sciences include experimental experience appropriate to the program"
   fails: "the criterion sets a floor and a mix, not which six tools a program teaches"
  }
  #>mathematics_engcore_abet_proposal
  ^["proposed_change"]{
   #:claim #!settled
   statement: "A Criterion 5 change released for comment in October 2025 would let documented pre-entry mathematics and science count; if adopted in fall 2026, it first applies in 2027 to 2028."
   source: ~"../../../registries/sources/formal.spw#src_formal_abet_2026"
   as_of: "2026-10-03"
   verify: "adoption had not been announced on the 2026 to 2027 criteria page on 2026-10-03; check the 2027 to 2028 page before treating the clause as in force"
  }
 }
}

^["gaps"]{
 discrete: "discrete mathematics and graph theory for engineers live in the computing year rows, not here"
 stochastic: "stochastic processes beyond Poisson and Markov chains, such as Brownian motion and filtering, have no leaf"
 complex_variables: "complex variables for engineers are split between the topology and complex core and the transforms matrix"
}
