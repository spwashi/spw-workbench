^["try"]{
 #>mathematics_transforms_try_fan
 ^["film_a_fan"]{
  materials: [ "a desk fan with a speed switch", "a phone camera" ]
  steps: << "film the fan at its lowest speed" ; "film it again at each higher speed" ; "watch the playback for blades that seem slow, frozen, or reversed" ; "count blades and estimate how far each turns between frames" ; "explain the apparent motion as sampling too slowly" >>
  time: .{ n: 15, unit: "minutes" }
  safety: "keep fingers and loose cords away from the blades; leave the guard on"
  shows: ~"./transforms-and-complex-methods.spw#mathematics_transforms_sampling"
 }
}

#>mathematics_transforms_chat_alias_q
?["Can a dashboard that polls a fast chat see trends that are not there?"]{
 #:depth #!computational ~#lens(information flow)
 #:claim #!speculative
 ~#hypothesis: "Polling a chat topic count at a fixed interval will show slow phantom swings when topic bursts recur faster than half the polling rate."
 !probe{ "replay a logged chat, poll topic counts at several intervals, and compare each series with the full-rate count" =id[p_formal_transforms_chat_alias] =kind[sim] }
 breaks: "chat bursts are not bandlimited sinusoids, so the sampling theorem gives a warning about burst periods, not an exact recovery rule"
 $%[formal.transforms.nyquist_rate_factor]
 ~"./transforms-and-complex-methods.spw#mathematics_transforms_sampling" ~#neighbor(nearest)
}
