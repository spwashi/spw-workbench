# Particle Physics Revisit
#
# The owner revisit of the Spw particle system as ordered pressure questions, from the glossary and the lattice through status, address, valence, and measures to stops in semiotics and classification theory.

#>trail_particle_physics
#:layer #!semantics
#:domain #!trail
#:form #!trail
#:level #!intro
#:review #!spot_checked
#:valence #!bonk

^"emit"{
 ~#title: "Particle Physics Revisit"
 ~#claim: "Thirteen stops press on the Spw particle system in order, each with one pressure question, from what a particle binds to what a computed cluster may claim."
 ~#proof: "Every stop is an anchor in the spw, society, or record class; the theory stops are questions for the owner, never canon edits, and each answer stays at its stop."
 ~#door: "Read the particle glossary first, then carry its word and bookmark distinction through every stop."
 ~#audience: "the owner and practitioners who read Spw particles natively"
 continuity: "Particle Physics Revisit | word and bookmark"
 cold_open: "A particle is the word you write and an anchor is the bookmark it leaves; keep that word and bookmark split at every stop."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "stops follow the particle-physics-revisit row of final-plan-v3 trails, with the glossary stops updated to spw_glossary and spw_gloss_particles",
  "every stop anchor was matched against the cut on disk on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["edges"]{
 feeds: [ ~"./editor-truth.spw#trail_editor_truth" ]
 see: [ ~"./spw-circuit.spw#trail_spw_circuit" ]
}

^["concepts"]{
 primary: [ #particle_binding, #silent_failure ]
 transfers: [ #status_drift, #semiotic_charge ]
 tensions: [ #overclaim ]
}

#>trail_particle_glossary
^["word_and_bookmark"]{
 particle: "the word you write: a hash, an aim mark, and a name"
 anchor: "the bookmark a deixis particle leaves on the node that follows it"
 deixis: "the aim that points; its particle is the word, and its anchor is where the bookmark lands"
 see: [ ~"../spw/glossary/particles.spw#spw_gloss_particle_word_bookmark" ]
}

#>trail_particle_stops
^["stops"]{
 classes: #[ spw, society, record ]
 walk: <<
  ~"../spw/glossary/index.spw#spw_glossary" ;
  ~"../spw/glossary/particles.spw#spw_gloss_particles" ;
  ?{ "what does a particle at the end of a frame bind to" } ~<prediction> ;
  ~"../spw/theory/particle-lattice.spw#spw_theory_particle_lattice" ;
  ~"../spw/theory/epistemic-status.spw#spw_theory_epistemic_status" ;
  ~"../spw/theory/address-and-linking.spw#spw_theory_address" ;
  ?{ "where does a link to an anchor land in each tool" } ~<prediction> ;
  ~"../spw/theory/valence-and-charge.spw#spw_theory_valence" ;
  ~"../society/communities/semiotic-charge.spw#communities_semiotic_charge" ;
  ~"../spw/theory/measures-and-handles.spw#spw_theory_measures" ;
  ~"../spw/design-research/spw-position-matrix.spw#lang_design_spw_position" ;
  ~"../spw/hosts/known-defects.spw#editor_hosts_defects" ;
  ?{ "which particle mistake would no tool report" } ~<prediction> ;
  ~"../spw/theory/clustering-hybrid.spw#spw_theory_clustering" ;
  ~"../record/information/taxonomy-cautions.spw#information_science_cautions" ;
  ~"../spw/open-questions.spw#spw_open_questions"
 >>
 ^["pressure"]{
  spw_glossary: "which glossary word do you already use with another meaning"
  spw_gloss_particles: "can you say which node a run of particles binds before you parse it"
  spw_theory_particle_lattice: "if canon names five aims and the lexer makes three, which one is the language"
  spw_theory_epistemic_status: "should a mood particle carry claim status, or should a receipt move it"
  spw_theory_address: "is an anchored link one address, or six readings that happen to agree"
  spw_theory_valence: "if valence names material quality, why do code and palette read it as merit"
  communities_semiotic_charge: "do particle names gain charge the way role words do"
  spw_theory_measures: "can a measure mean anything if its handle is used only once"
  lang_design_spw_position: "which particle shape borrows a habit that misleads a C or Markdown reader"
  editor_hosts_defects: "which editor defects come from a host reading particles on its own"
  spw_theory_clustering: "may a cluster of surfaces that share particles be called a kind"
  information_science_cautions: "does a closed particle set harden the way a fixed taxonomy does"
  spw_open_questions: "which pressure question here belongs in the ranked list, and which is answered"
 }
}

#>trail_particle_provenance
^["labels"]{
 a_canon: "repository canon, such as the lattice list the theory stops cite by path and line"
 a_cut: "rules this cut wrote for itself, such as closed sets and receipts"
 owner_hold: "the owner note, which holds a position for one revision and is not site doctrine"
 rule: "each stop labels its claims with one of these three, and this trail adds no fourth"
}

^["readings"]{
 #>trail_particle_questions_only
 ^["questions_not_edits"]{
  #:claim #!interpretive
  statement: "The theory stops on this walk are questions for the owner, never canon edits, so a pressure question that finds a mismatch records it and leaves canon as it is."
  source: ~"../registries/sources/trails.spw#src_trail_plan_v3"
  label: "a-cut"
 }
 #>trail_particle_silence
 ^["silence_first"]{
  #:claim #!interpretive
  statement: "Most pressure on this walk lands on silence: a name that does not lex, a second anchor ignored, a link that lands on line one, and no tool that says so."
  see: [ ~"../spw/theory/particle-lattice.spw#spw_theory_particle_digit_drop", ~"../spw/theory/particle-lattice.spw#spw_theory_particle_first_wins" ]
 }
}

^["try"]{
 #>trail_particle_try_bind
 ^["bind_by_hand"]{
  materials: [ "a scratch .spw file outside the cut", "a pen and paper", "the spw command line" ]
  steps: <<
   "write five lines that each open with a particle run" ;
   "write on paper which node you expect each run to bind" ;
   "run spw select on the scratch file and read the bindings" ;
   "mark each guess hit or miss and keep the paper for yourself"
  >>
  time: .{ n: 20, unit: "minutes" }
  safety: "no hazard worth naming"
  status: #implemented
  cites: [ "packages/spw-cli/src/commands.ts:330" ]
  shows: ~"./particle-physics-revisit.spw#trail_particle_silence"
 }
}

#>trail_particle_lexed_first_q
?["Does learning the lexed aims before the full lattice reduce binding mistakes?"]{
 #:depth #!educational ~#lens(formal structure)
 #:claim #!speculative
 ~#hypothesis: "A reader who learns the three lexed aims first should mispredict fewer particle bindings than one who learns all five lattice aims at once."
 !probe{ "write ten particle lines and predict each binding before and after reading the lexed aims" =id[p_trail_particle_lexed_first] =kind[build] }
 $%[gloss.lexer.particle_aims_n, gloss.lexer.lattice_aims_n]
 ~"./particle-physics-revisit.spw#trail_particle_silence" ~#neighbor(nearest)
}
