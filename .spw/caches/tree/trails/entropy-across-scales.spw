# Entropy Across Scales
#
# A trail that follows one counted quantity from bonds to engines, ensembles, the price of erasing a bit, abstract computation, food webs, and back to a glass of water.

#>trail_entropy
#:layer #!pragmatics
#:domain #!trail
#:form #!trail
#:level #!intro
#:review #!adversarial_checked
#:valence #!bonk

^"emit"{
 ~#title: "Entropy Across Scales"
 ~#claim: "Eight stops follow entropy from a breaking bond to an engine cycle, a counted ensemble, an erased bit, a computation, and a food web, each at its canonical home."
 ~#proof: "Every stop is an anchor in the physical, formal, or living class; the bridge claims here cite Shannon, Landauer, and Schrodinger, and the stops keep the physics."
 ~#door: "Start at the bonding stop and ask at every stop what is being counted."
 ~#audience: "readers who met entropy in one subject and want to see it in the others"
 continuity: "Entropy Across Scales | counted"
 cold_open: "Ask at every stop what is being counted, from a breaking bond to a food web thinning out."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "stops follow the entropy-across-scales row of final-plan-v3 trails",
  "every stop anchor was matched against the cut on disk on 2026-10-03",
  "Shannon 1948 and Landauer 1961 were matched against Crossref on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "fact-check 2026-10-03: the statmech note said temperature is how entropy changes with energy, which inverts the derivative its stop corrects; it now says inverse temperature, 1/T = dS/dE"
 ]
}

^["edges"]{
 feeds: [ ~"./math-to-control.spw#trail_math_to_control" ]
 grounds: [ ~"../registries/sources/trails.spw#src_trail_shannon_1948" ]
}

^["concepts"]{
 primary: [ #entropy, #arrow_of_time ]
 transfers: [ #exergy, #equilibrium ]
 tensions: [ #false_analogy ]
}

#>trail_entropy_stops
^["stops"]{
 classes: #[ physical, formal, living ]
 walk: <<
  ~"../physical/materials/bonding-and-states-of-matter.spw#materials_bonding" ;
  ~"../physical/physics/classical-thermodynamics.spw#physics_thermo_classical" ;
  ?{ "can any engine turn all of its heat into work" } ~<prediction> ;
  ~"../physical/engineering/mechanical-core.spw#engineering_mechanical" ;
  ~"../physical/physics/statistical-mechanics.spw#physics_statmech" ;
  ~"../physical/physics/nonequilibrium-and-information.spw#physics_nonequilibrium" ;
  ?{ "does erasing a file warm the room, and by how much" } ~<prediction> ;
  ~"../formal/computing/abstract-computation.spw#computing_abstract" ;
  ~"../living/development-and-ecology/ecology-foundations.spw#development_ecology_foundations" ;
  ?{ "why are there fewer wolves than rabbits" } ~<prediction> ;
  ~"../physical/materials/water.spw#materials_water"
 >>
 ^["notes"]{
  materials_bonding: "counted: arrangements of atoms; a phase change trades bond energy against disorder"
  physics_thermo_classical: "counted: nothing yet; the second law limits engines before atoms enter the story"
  engineering_mechanical: "counted: exergy, the work a system could still deliver, lost as a cost"
  physics_statmech: "counted: microstates; inverse temperature is how entropy changes with energy, 1/T = dS/dE"
  physics_nonequilibrium: "counted: bits; erasing one costs at least kT ln 2 of heat on the Landauer account"
  computing_abstract: "counted: steps and states of an abstract machine; physics prices only the irreversible ones"
  development_ecology_foundations: "counted: energy at each trophic step; it thins on a one-way flow while nutrients cycle"
  materials_water: "back to one substance: a large heat capacity is many ways to store energy in a hydrogen-bond network"
 }
}

^["bridges"]{
 #>trail_entropy_shannon
 ^["shannon_form"]{
  #:claim #!settled
  statement: "Shannon defined a measure of information for a source in 1948 and noted that its form is that of entropy in statistical mechanics."
  source: ~"../registries/sources/trails.spw#src_trail_shannon_1948"
  ^["limits"]{
   holds: "the shared mathematical form, a sum of probabilities times their logarithms"
   fails: "physical meaning; a message entropy has no temperature until a device must erase or copy it"
  }
 }
 #>trail_entropy_landauer
 ^["landauer_bridge"]{
  #:claim #!interpretive
  statement: "The nonequilibrium stop is the bridge of this walk: there Landauer prices an erased bit in heat, which ties the information stops back to the engine stops."
  source: ~"../registries/sources/trails.spw#src_trail_landauer_1961"
  see: [ ~"../physical/physics/nonequilibrium-and-information.spw#physics_noneq_landauer_bound" ]
 }
 #>trail_entropy_schrodinger
 ^["living_export"]{
  #:claim #!settled
  statement: "Schrodinger argued in 1944 that living things keep their order by drawing order from their surroundings and exporting entropy, which he called feeding on negative entropy."
  source: ~"../registries/sources/trails.spw#src_trail_schrodinger_1944"
  ^["limits"]{
   holds: "as the argument of a short book that shaped later biophysics"
   fails: "as a measured budget; the ecology stop counts energy flow, not entropy export"
  }
 }
 #>trail_entropy_through_line
 ^["through_line"]{
  #:claim #!interpretive
  statement: "One habit links every stop: count the ways a system can be, and watch which way the count grows; what changes from stop to stop is what is counted."
  see: [ ~"../physical/physics/statistical-mechanics.spw#physics_statmech_boltzmann_entropy" ]
 }
}

^["try"]{
 #>trail_entropy_try_coins
 ^["four_coins"]{
  materials: [ "four coins", "a sheet of paper", "a pen" ]
  steps: <<
   "list every way four coins can land, heads or tails, in order" ;
   "group the list by how many heads it shows" ;
   "guess which group is largest before counting, and write the guess" ;
   "count each group and compare with the guess" ;
   "toss the four coins twenty times and tally the groups"
  >>
  time: .{ n: 20, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"./entropy-across-scales.spw#trail_entropy_through_line"
 }
}

#>trail_entropy_food_web_q
?["Does a food web pay an information cost the way a computer does?"]{
 #:depth #!physical ~#lens(energy budget)
 #:claim #!speculative
 ~#hypothesis: "The Landauer price of the information a food web processes should be negligible next to its respiration losses, so trophic thinning is an energy story, not an information story."
 !probe{ "set the bit-erasure bound beside one measured trophic energy budget" =id[p_trail_entropy_web_bits] =kind[calc] }
 $%[phys.info.landauer_300k_zj, eco.ecosystem.transfer_eff]
 breaks: "the Landauer bound prices erasing a bit in a device at one temperature, while a food web loses energy as heat in respiration at many scales and has no single register to erase"
 ~"./entropy-across-scales.spw#trail_entropy_landauer" ~#neighbor(nearest)
}
