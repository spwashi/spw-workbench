# Matter to Meaning
#
# A short trail from plant fiber to a findable idea: bonds hold the sheet, ink marks it, the press multiplies it, and a shelf and a ranking let someone find it again.

#>trail_matter_to_meaning
#:layer #!pragmatics
#:domain #!trail
#:form #!trail
#:level #!intro
#:review #!spot_checked
#:valence #!boon

^"emit"{
 ~#title: "Matter to Meaning"
 ~#claim: "Seven stops climb from fiber and bond to sheet, mark, and press, then to the shelf and the ranking that make an idea findable again."
 ~#proof: "Each stop is an anchor in the physical or record class; the trail adds only the order and one question to carry between stops."
 ~#door: "Start at the fibers stop and carry one question upward: what has to hold for this to be found later?"
 ~#audience: "readers who like to see a whole chain from material to meaning"
 continuity: "Matter to Meaning | findable"
 cold_open: "Follow a plant fiber up through ink, press, and shelf until an idea becomes findable again."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "stops follow the matter-to-meaning row of final-plan-v3 trails",
  "every stop anchor was matched against the cut on disk on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "fact-check 2026-10-03: the print note gave East Asian printing a press; woodblock and movable-type impressions there were made by hand rubbing, and the screw press is the Mainz contribution"
 ]
}

^["edges"]{
 feeds: [ ~"./reference-library-lineage.spw#trail_reference_lineage" ]
 contrasts: [ ~"./scroll-to-stream.spw#trail_scroll_to_stream" ]
}

^["concepts"]{
 primary: [ #carrier, #faceted_classification ]
 transfers: [ #hydrogen_bond, #ranking ]
 tensions: [ #mass_copy ]
}

#>trail_matter_stops
^["stops"]{
 classes: #[ physical, record ]
 walk: <<
  ~"../physical/materials/fibers-and-textiles.spw#materials_fibers" ;
  ~"../physical/materials/bonding-and-states-of-matter.spw#materials_bonding" ;
  ?{ "what holds a sheet of paper together when no glue is added" } ~<prediction> ;
  ~"../record/inscription/paper-and-pulp-manufacture.spw#inscription_paper" ;
  ~"../record/inscription/inks-and-inscription.spw#inscription_inks" ;
  ~"../record/inscription/print-and-press.spw#inscription_print" ;
  ?{ "once copies are cheap, what becomes the scarce step" } ~<prediction> ;
  ~"../record/information/knowledge-organization.spw#information_science_knowledge_org" ;
  ~"../record/information/retrieval-systems.spw#information_science_retrieval"
 >>
 ^["notes"]{
  materials_fibers: "plant fibers are mostly cellulose, a long-chain polymer; spinning, weaving, and papermaking all start by arranging them"
  materials_bonding: "read the hydrogen bond row; it is the bond that lets wet fibers dry into a sheet"
  inscription_paper: "the hand mould makes one sheet at a time, the Fourdrinier a continuous web, and acid sizing shortens the life of either"
  inscription_inks: "a mark either rests on the fibers or bites into them, and that choice decides how it ages"
  inscription_print: "carved blocks and type with ink multiplied one mark into many first in East Asia, and the Mainz press later mechanized the impression"
  information_science_knowledge_org: "a shelf mark places one copy among many; faceted schemes welcome new subjects"
  information_science_retrieval: "ranking decides which of many findable copies a reader sees first"
 }
}

^["readings"]{
 #>trail_matter_layers
 ^["layers"]{
  #:claim #!interpretive
  statement: "Each stop adds one layer that has to hold before the next can work: bond, sheet, mark, copy, place, and rank."
  see: [ ~"../record/information/retrieval-systems.spw#information_science_retrieval" ]
  ^["limits"]{
   holds: "written records on paper and their library and search descendants"
   fails: "oral and performed knowledge, which stays findable through people rather than layers of material"
  }
 }
 #>trail_matter_scarcity
 ^["scarcity_moves"]{
  #:claim #!interpretive
  statement: "Each time copying gets cheaper, the scarce step moves up the chain, from making a copy to placing it to ranking it."
  see: [ ~"../record/inscription/print-and-press.spw#inscription_print" ]
  ^["limits"]{
   holds: "as a reading of the order of these stops"
   fails: "as a causal history, since libraries ordered scrolls and manuscripts long before print made copies cheap"
  }
 }
}

^["try"]{
 #>trail_matter_try_find
 ^["findable_card"]{
  materials: [ "ten index cards", "a pen", "a friend" ]
  steps: <<
   "write one idea on each card" ;
   "give each card three facet words: subject, form, and place" ;
   "shuffle the cards and file them by the first facet" ;
   "ask a friend to find one idea and time the search" ;
   "refile by a second facet and time the search again"
  >>
  time: .{ n: 20, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"./matter-to-meaning.spw#trail_matter_layers"
 }
}

#>trail_matter_bottleneck_q
?["When copies get cheap, does finding them become the bottleneck?"]{
 #:depth #!historical ~#lens(information flow)
 #:claim #!speculative
 ~#hypothesis: "After a drop in the cost of copying, new finding aids such as catalogs, indexes, and rankings should appear sooner than before it."
 !probe{ "date the first catalogs and printed indexes against print runs in one region" =id[p_trail_matter_bottleneck] =kind[lit] }
 $%[media.print.b42_sort_count, prov.ddc.main_class_count]
 breaks: "copy cost is counted in labor and money while search cost is counted in reader time, and early catalogs served manuscripts too"
 ~"./matter-to-meaning.spw#trail_matter_scarcity" ~#neighbor(nearest)
}
