# Trails
#
# Trails by reader purpose. A trail is a practiced circuit across classes, earned by attention after a first door, never the door itself.

#>trail_index
#:layer #!pragmatics
#:domain #!trail
#:form #!index
#:level #!intro
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Trails"
 ~#claim: "Twenty trails walk ordered stops across at least two subject classes, grouped by what a reader is trying to do, and each writes its predictions down before the checks."
 ~#proof: "The trail form is credited to Bush, who described named trails through a memex in 1945; the contract graph frame sets the stops, the schedule, and the two-class rule."
 ~#door: "Pick the purpose closest to yours, then walk one trail after you have entered by a door."
 ~#audience: "readers who have met one door and want a practiced circuit"
 continuity: "Trails | practiced circuit"
 cold_open: "A trail is a practiced circuit you earn after a first door, so pick one by purpose and walk it in order."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "children follow the trails package of final-plan-v3 writer packages",
  "every child file anchor was matched against the files on disk on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "fact-check 2026-10-03: several trails listed apparatus directories as classes; the grammar now names an apparatus set beside the subject classes"
 ]
}

^["edges"]{
 grounds: [ ~"../contract.spw#cut_contract", ~"../registries/quantities/trails.spw#q_trail_rule" ]
 see: [ ~"../spw/graph-idioms.spw#spw_idiom_trails" ]
}

^["concepts"]{
 primary: [ #walk, #prediction_step ]
 transfers: [ #renvoi ]
 tensions: [ #overclaim ]
}

^["tree"]{
 season_2026_q4: ~"./season-2026-q4.spw"
 clocks_and_cadences: ~"./clocks-and-cadences.spw"
 attention_arcs: ~"./attention-arcs.spw"
 shared_curricula_kit: ~"./shared-curricula-kit.spw"
 streamer_first_contact: ~"./streamer-first-contact.spw"
 novel_to_screen: ~"./novel-to-screen.spw"
 light_to_image: ~"./light-to-image.spw"
 scroll_to_stream: ~"./scroll-to-stream.spw"
 matter_to_meaning: ~"./matter-to-meaning.spw"
 reference_library_lineage: ~"./reference-library-lineage.spw"
 role_words_over_time: ~"./role-words-over-time.spw"
 entropy_across_scales: ~"./entropy-across-scales.spw"
 math_to_control: ~"./math-to-control.spw"
 market_reading: ~"./market-reading.spw"
 corrections: ~"./corrections.spw"
 paired_cases: ~"./paired-cases.spw"
 spw_first_contact: ~"./spw-first-contact.spw"
 spw_circuit: ~"./spw-circuit.spw"
 particle_physics_revisit: ~"./particle-physics-revisit.spw"
 editor_truth: ~"./editor-truth.spw"
}

#>trail_index_purposes
^["purposes"]{
 plan_the_quarter: #[ season_2026_q4, clocks_and_cadences, attention_arcs ]
 teach_and_share: #[ shared_curricula_kit, attention_arcs, role_words_over_time ]
 make_and_show: #[ streamer_first_contact, novel_to_screen, light_to_image ]
 see_how_records_last: #[ scroll_to_stream, matter_to_meaning, reference_library_lineage ]
 see_one_idea_across_fields: #[ entropy_across_scales, math_to_control, clocks_and_cadences ]
 read_a_number: #[ market_reading, corrections ]
 compare_cases: #[ paired_cases, corrections ]
 practice_spw: #[ spw_first_contact, spw_circuit, particle_physics_revisit, editor_truth ]
}

#>trail_index_grammar
^["grammar"]{
 stops: "a stops frame holds one walk schedule of path refs to anchors that exist, in order"
 predictions: "a prediction step is a question body followed by a capsule tagged prediction, written before the next stop"
 notes: "each stop gets one note keyed by its anchor name, saying what to look for, never restating the claim"
 classes: "a trail crosses at least two subject classes and names them in a closed set"
 apparatus: "stops in provenance, panels, season, registries, or the cut root files are named in an apparatus set and never count toward the two"
 readings: "trail claims read the order of the stops; facts stay at the stops"
 kit: "a try kit lets a reader walk part of the trail with hands, voice, or a command"
 exit: "a trail hands off through a feeds edge to the next trail"
}

^["readings"]{
 #>trail_index_memex
 ^["memex"]{
  #:claim #!settled
  statement: "Bush described a memex user who ties items into a named trail, recalls the trail later, and passes a copy of it to a colleague."
  source: ~"../registries/sources/trails.spw#src_trail_bush_1945"
  reads: %[trail.memex.essay_year]
 }
 #>trail_index_two_classes
 ^["two_classes"]{
  #:claim #!settled
  statement: "The contract asks every trail in this cut to list ordered stops in a stops frame with a schedule and to cross at least two classes."
  source: ~"../registries/sources/trails.spw#src_trail_cut_contract"
  reads: %[trail.rule.min_class_crossings]
 }
 #>trail_index_not_door
 ^["not_the_door"]{
  #:claim #!settled
  statement: "The owner note says a newcomer may land on one fragment and a practiced circuit is earned by holding attention; it is not the door."
  source: ~"../registries/sources/trails.spw#src_trail_owner_resume"
  cites: [ ".spw/caches/resume/2026-09-30-direction.spw:30" ]
  label: "owner hold"
 }
}

