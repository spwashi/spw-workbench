# Spw Circuit
#
# A practiced circuit through the Spw class for a reader who already came in by one door: glossary, familiarity, tokens and roles, rendering, transforms, inspection, machine empathy, contraptions, graph idioms, and open questions.

#>trail_spw_circuit
#:layer #!semantics
#:domain #!trail
#:form #!trail
#:level #!intro
#:review #!adversarial_checked
#:valence #!boon

^"emit"{
 ~#title: "Spw Circuit"
 ~#claim: "Eleven stops make a practiced circuit through the Spw class for a reader who already entered by one door, crossing once into archive patterns before the open questions."
 ~#proof: "Every stop is an anchor in the spw or record class; the owner note says a practiced circuit is earned by attention and is not the door, so no door is linked here."
 ~#door: "Walk it after your first door, one stop per sitting, and write one prediction before each."
 ~#audience: "practitioners who have read one Spw door and want to practice reading, transforming, and building"
 continuity: "Spw Circuit | earned"
 cold_open: "This circuit is earned after a first door: walk it one stop per sitting, guessing before you look."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "stops follow the spw-circuit row of final-plan-v3 writer packages, which replaces the spw-first-contact walk",
  "every stop anchor was matched against the cut on disk on 2026-10-03",
  "command rows were read in packages/spw-cli/src/commands.ts on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["edges"]{
 supersedes: [ ~"./spw-first-contact.spw#trail_spw_first_contact_plan" ]
 feeds: [ ~"./attention-arcs.spw#trail_attention_arcs" ]
 see: [ ~"./particle-physics-revisit.spw#trail_particle_physics" ]
}

^["concepts"]{
 primary: [ #false_friend, #care_ladder ]
 transfers: [ #omission, #renvoi ]
 tensions: [ #silent_failure ]
}

#>trail_circuit_stops
^["stops"]{
 classes: #[ spw, record ]
 walk: <<
  ~"../spw/glossary/index.spw#spw_glossary" ;
  ~"../spw/familiarity-matrix.spw#spw_familiarity_matrix" ;
  ?{ "which mark you already type will mean something else here" } ~<prediction> ;
  ~"../spw/tokens-and-roles.spw#spw_tokens_and_roles" ;
  ~"../spw/rendering-and-cli.spw#spw_rendering_and_cli" ;
  ~"../spw/transforms.spw#spw_transforms" ;
  ?{ "what will the brief card drop from the water surface" } ~<prediction> ;
  ~"../spw/inspection-and-ir.spw#spw_inspection_and_ir" ;
  ~"../spw/machine-empathy.spw#spw_machine_empathy" ;
  ~"../spw/contraptions/index.spw#spw_contraptions" ;
  ~"../spw/graph-idioms.spw#spw_graph_idioms" ;
  ~"../record/information/archive-patterns-matrix.spw#information_science_patterns" ;
  ?{ "which question would you add to the open list after this walk" } ~<prediction> ;
  ~"../spw/open-questions.spw#spw_open_questions"
 >>
 ^["notes"]{
  spw_glossary: "look up the marks and words you will meet; the false friends list is the first page to read"
  spw_familiarity_matrix: "a glyph you know can be a false friend; check the parse before the habit"
  spw_tokens_and_roles: "glyphs carry the kinds, and color may add only what the parser derives"
  spw_rendering_and_cli: "each command, card, and error should use one canonical name and say what it left out"
  spw_transforms: "every transform keeps something and drops something; name both"
  spw_inspection_and_ir: "as care rises, read less derived material, and write down what you did not check"
  spw_machine_empathy: "a kind tool honors the context you declare and never guesses who you are"
  spw_contraptions: "small instruments that turn one idea on a field you know, then on Spw itself"
  spw_graph_idioms: "the tree finds, typed edges mean, and registries hold numbers once"
  information_science_patterns: "the crossing: the archive habits these idioms borrowed and the ones they declined"
  spw_open_questions: "most open questions ask about silent failure; leave one of your own"
 }
}

#>trail_circuit_commands
^["commands"]{
 brief_card: .{ command: "spw emit pack", status: #implemented, cites: "packages/spw-cli/src/commands.ts:397" }
 outline: .{ command: "spw outline", status: #implemented, cites: "packages/spw-cli/src/commands.ts:338" }
 select: .{ command: "spw select", status: #implemented, cites: "packages/spw-cli/src/commands.ts:330" }
 rule: "the walk names canonical commands only; aliases and placeholders stay out"
}

^["readings"]{
 #>trail_circuit_earned
 ^["earned_not_door"]{
  #:claim #!settled
  statement: "The owner note says a newcomer may land on one fragment, while a practiced circuit is earned by holding attention and is not the door."
  source: ~"../registries/sources/trails.spw#src_trail_owner_resume"
  cites: [ ".spw/caches/resume/2026-09-30-direction.spw:30" ]
  label: "owner hold"
 }
 #>trail_circuit_order
 ^["read_then_build"]{
  #:claim #!interpretive
  statement: "The order runs from reading marks, to seeing how tools render and transform them, to inspecting what the tools hid, and only then to building with contraptions and graphs."
  see: [ ~"../spw/inspection-and-ir.spw#spw_ir_care_descends" ]
  ^["limits"]{
   holds: "a reader who has already met one door and one false friend"
   fails: "a newcomer, who should land on a single door and stop there"
  }
 }
}

^["try"]{
 #>trail_circuit_try_brief
 ^["predict_the_card"]{
  materials: [ "the water surface", "a pen and paper", "the spw command line" ]
  steps: <<
   "read the water surface once from top to bottom" ;
   "write the five things you expect the brief card to drop" ;
   "run spw emit pack on the water surface with the brief host" ;
   "compare the card with your list and mark each guess" ;
   "write one line on what the card hid that you would want back"
  >>
  time: .{ n: 20, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"./spw-circuit.spw#trail_circuit_order"
 }
}

#>trail_circuit_inspect_first_q
?["Does walking inspection before contraptions change what a reader trusts?"]{
 #:depth #!educational ~#lens(applied attention)
 #:claim #!speculative
 ~#hypothesis: "Readers who meet the care ladder before the contraptions should check a contraption output against its source more often than readers who meet the contraptions first."
 !probe{ "count source checks in two self-kept logs, one per stop order, without naming the reader" =id[p_trail_circuit_inspect_order] =kind[field] }
 $%[hosts.cut.care_audit_count, spw.fam.false_friend]
 ~"./spw-circuit.spw#trail_circuit_order" ~#neighbor(nearest)
}
