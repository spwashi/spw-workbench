# Attention Arcs
#
# Four arc frames for wonder, lesson, live, and family attention, each with a clock, steps said aloud, a prediction written down before the check, counts a tool can keep, and an exit to the next arc.

#>trail_attention_arcs
#:layer #!pragmatics
#:domain #!trail
#:form #!trail
#:level #!intro
#:review #!adversarial_checked
#:valence #!boon

^"emit"{
 ~#title: "Attention Arcs"
 ~#claim: "Four arcs carry one question through a wonder, a lesson, a live session, and a family table, and each writes its prediction down before the check."
 ~#proof: "Predicting before a demonstration helped physics students in Crouch and colleagues, and the order follows predict, observe, explain from White and Gunstone; the stops cross spw, learning, mind, and making."
 ~#door: "Pick the arc that matches the room you are in, and write the prediction step on paper first."
 ~#audience: "teachers, hosts, and families who want one question to become a loop"
 continuity: "Attention Arcs | prediction"
 cold_open: "Pick the arc for your room, write the prediction down before you check, and hand the question on."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "arc shapes follow the render study section 3 sketches and the contract arcs frame",
  "Crouch 2004, Brod 2018, Campbell 1979, and Strathern 1997 were matched against Crossref on 2026-10-03",
  "every stop anchor was matched against the cut on disk on 2026-10-03"
 ]
 ^["receipts"]{
