# Season 2026 Q4
#
# A dated trail from the 1 October reflection to the 4 January reset that reads the season hub beside branch calendars, cadences, living clocks, and the retrospective.

#>trail_season_2026_q4
#:layer #!pragmatics
#:domain #!trail
#:form #!trail
#:level #!intro
#:review #!spot_checked
#:valence #!boon
#:era #!current
#:season #!reflection

^"emit"{
 ~#title: "Season 2026 Q4"
 ~#claim: "Thirteen stops carry a reader from the 1 October reflection to the 4 January reset, each visited in the phase where it matters most."
 ~#proof: "Phase spans come from the season arc; every stop is an anchor in the learning, making, or living class or in the season apparatus, and every date on the walk is read from the season calendar or the stop that sets it."
 ~#door: "Find this week on the dated schedule, visit the stops it names, then come back next phase."
 ~#audience: "makers, teachers, and crews planning October through early January"
 continuity: "Season 2026 Q4 | phase"
 cold_open: "Walk the season one phase at a time, from autumn reflection to the January reset, visiting each stop when it matters."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "stops follow the season-2026-q4 row of final-plan-v3 trails",
  "phase spans were copied from the season arc ladder and their weekdays rechecked with Gregorian arithmetic on 2026-10-03",
  "every stop anchor was matched against the cut on disk on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "fact-check 2026-10-03: the horticulture stop sat in the crescendo leg, after the night-length treatment it describes must begin; it moves to the reflection leg, where the stop dates that treatment from about 1 October",
  "fact-check 2026-10-03: the clocks stop sat in the celebration leg while the rest-planning probe asked about reading it before the crescendo; it moves to the gathering leg beside broadcast cadence",
  "fact-check 2026-10-03: the fiscal note said most fiscal years are a quarter or half spent in October; calendar-year ledgers, common among national governments and companies, enter their last quarter, and the note now names them",
  "fact-check 2026-10-03: season is an apparatus directory, not a subject class, so it is listed apart from the classes"
 ]
}

^["edges"]{
 grounds: [ ~"../season/season-arc.spw#season_arc_span" ]
 feeds: [ ~"./shared-curricula-kit.spw#trail_shared_curricula" ]
 see: [ ~"./clocks-and-cadences.spw#trail_clocks_and_cadences" ]
}

^["concepts"]{
 primary: [ #production_season, #season_cadence ]
 transfers: [ #phenology, #new_year_reset ]
 tensions: [ #southern_hemisphere ]
}

#>trail_season_stops
^["stops"]{
 classes: #[ learning, making, living ]
 apparatus: #[ season ]
 walk: <<
  ~"../season/season-arc.spw#season_arc" ;
  ~"../season/calendar-2026q4.spw#season_calendar_2026q4" ;
  ~"../season/fiscal-and-academic-years.spw#season_fiscal_academic" ;
  ~"../learning/institutions/academic-year-cadence.spw#institutions_academic_year" ;
  ~"../living/plants/horticultural-science.spw#plant_science_horticulture" ;
  ?{ "which of your calendars is furthest along in October" } ~<prediction> ;
  ~"../making/film/film-season-calendar.spw#film_season_calendar" ;
  ~"../making/authorship/author-season-calendar.spw#authorship_season_calendar" ;
  ~"../making/broadcast/broadcast-cadence.spw#broadcast_cadence" ;
  ~"../living/development-and-ecology/biological-clocks.spw#development_ecology_clocks" ;
  ~"../season/production-cadence.spw#season_production_cadence" ;
  ?{ "which week of the crescendo will collide two of your lanes" } ~<prediction> ;
  ~"../season/festivals-and-resets.spw#season_resets" ;
  ?{ "which reset will you actually keep" } ~<prediction> ;
  ~"../season/retrospective-protocol.spw#season_retrospective" ;
  ~"../season/season-journal.spw#season_journal"
 >>
 ^["notes"]{
  season_arc: "fourteen weekly rungs; read which phase you are in before anything else"
  season_calendar_2026q4: "each date is marked fixed, typical, or verify; trust only the fixed ones without checking"
  season_fiscal_academic: "October finds the US federal year restarting, July and April fiscal years a quarter or half spent, and calendar-year ledgers entering their last quarter"
  institutions_academic_year: "midterms in October, registration in November, finals in December"
  plant_science_horticulture: "long nights from about 1 October set the holiday bloom, so this stop comes in the first phase"
  film_season_calendar: "autumn festivals, awards qualifying, and holiday releases"
  authorship_season_calendar: "preorders, November drafting, and holiday promotion"
  broadcast_cadence: "name who carries the rest days before the crescendo, not during it"
  development_ecology_clocks: "a living clock keeps running without a calendar; yours needs light and rest, so read it while rest is still being planned"
  season_production_cadence: "one weekly beat shared by every lane; collisions are named in advance"
  season_resets: "solar, lunar, and lunisolar calendars place their resets at different points"
  season_retrospective: "the chosen reset: look back, celebrate, choose a few things, and close"
  season_journal: "one page a week, so the reset has a record to read"
 }
}

#>trail_season_dated
^["dated_walk"]{
 #>trail_season_leg_reflection
 ^["reflection"]{
  span: "Thu 2026-10-01 to Wed 2026-10-21"
  stops: #[ season_arc, season_calendar_2026q4, season_fiscal_academic, institutions_academic_year, plant_science_horticulture ]
  phase: ~"../season/season-arc.spw#season_arc_reflection"
 }
 #>trail_season_leg_gathering
 ^["gathering"]{
  span: "Thu 2026-10-22 to Wed 2026-11-11"
  stops: #[ film_season_calendar, authorship_season_calendar, broadcast_cadence, development_ecology_clocks ]
  phase: ~"../season/season-arc.spw#season_arc_gathering"
 }
 #>trail_season_leg_crescendo
 ^["crescendo"]{
  span: "Thu 2026-11-12 to Wed 2026-12-16"
  stops: #[ season_production_cadence ]
  phase: ~"../season/season-arc.spw#season_arc_crescendo"
 }
 #>trail_season_leg_celebration
 ^["celebration"]{
  span: "Thu 2026-12-17 to Wed 2026-12-30"
  stops: #[ season_resets ]
  phase: ~"../season/season-arc.spw#season_arc_celebration"
 }
 #>trail_season_leg_reset
 ^["reset"]{
  span: "Thu 2026-12-31 to Mon 2027-01-04"
  stops: #[ season_retrospective, season_journal ]
  phase: ~"../season/season-arc.spw#season_arc_reset"
 }
 phases: << "reflection" ; "gathering" ; "crescendo" ; "celebration" ; "reset" >>
}

^["readings"]{
 #>trail_season_phase_timing
 ^["phase_timing"]{
  #:claim #!interpretive
  statement: "Each stop is placed in the phase where acting on it still helps: long nights for the holiday bloom start in reflection, rest is named before the crescendo, and the retrospective waits for the reset."
  see: [ ~"../season/production-cadence.spw#season_cadence_collisions" ]
  ^["limits"]{
   holds: "a northern production year on a Gregorian calendar"
   fails: "the southern hemisphere and lunar or lunisolar years, where the reset and the long nights fall elsewhere"
  }
 }
 #>trail_season_two_resets
 ^["forced_and_chosen"]{
  #:claim #!interpretive
  statement: "The walk ends with two kinds of reset side by side: the forced one of long nights and the calendar year, and the chosen one of a retrospective and a journal page."
  see: [ ~"../season/festivals-and-resets.spw#season_resets_solar" ]
 }
}

^["try"]{
 #>trail_season_try_one_page
 ^["one_page_quarter"]{
  materials: [ "one sheet of paper turned sideways", "a pen", "the season calendar" ]
  steps: <<
   "draw five columns, one per phase, and copy each span" ;
   "write the stops you will visit in each column" ;
   "circle the week you guess will be hardest and write why" ;
   "pin the page where you will see it on the first day of each phase"
  >>
  time: .{ n: 15, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"./season-2026-q4.spw#trail_season_phase_timing"
 }
}

#>trail_season_clock_first_q
?["Does visiting the clocks stop before the crescendo change how a crew plans rest?"]{
 #:depth #!experiential ~#lens(bodily rhythm)
 #:claim #!speculative
 ~#hypothesis: "Crews who read about free-running body clocks before the crescendo should name rest days earlier than crews who read only the production calendars."
 !probe{ "ask two crews to plan the crescendo, one after the clocks stop, and compare when rest is scheduled" =id[p_trail_season_rest_timing] =kind[field] }
 $%[eco.clock.human_tau_h, season.arc.week_count]
 breaks: "a body clock is entrained by light and cannot opt out, while a crew plans rest by agreement and can choose to skip it"
 ~"./season-2026-q4.spw#trail_season_phase_timing" ~#neighbor(nearest)
}
