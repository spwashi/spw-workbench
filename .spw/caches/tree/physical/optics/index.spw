^"emit"{
 ~#title: "Optics"
 ~#claim: "Optics in this cut follows light from refraction through a corrected lens to the image circle that lands on film or a sensor."
 ~#proof: "The aberration leaf cites Smith, Hecht, Born and Wolf, Kingslake, and Rashed; the format leaf cites the American Cinematographer Manual, Belton, and Smith, all through the registry."
 ~#door: "Read the aberration ledger first, then the format matrix, then cross into the moving-image carriers."
 ~#audience: "photographers, cinematographers, and students of physics who want light made practical"
 continuity: "Optics | image circle"
 cold_open: "Optics here follows light through a lens to the image circle where film or a sensor waits."
}

