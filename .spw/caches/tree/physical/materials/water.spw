 }
 corrections: #[
  "Watt patented the separate condenser in 1769; the sun-and-planet gearing the firm patented for rotary output in 1781 is usually credited to William Murdoch",
  "Wittfogel thesis marked contested; Grand Canal and Indus removed as supporting cases",
  "the raw said sanitation doubled life expectancy; that is dropped, and how much filtration and chlorination cut US urban mortality is marked contested between Cutler and Miller and Anderson, Charles, and Rees",
  "the seawater osmotic pressure of 27 bar had no source; sourced correlations put standard seawater a little lower, so the number is dropped and the correlation is cited",
  "the purification leaf said Anderson, Charles, and Rees find no substantial contribution, the wording of their 2018 working paper; the published 2022 article ties filtration to an 11 to 12 percent drop in infant mortality"
 ]
}

^["edges"]{
 grounds: [ ~"../../registries/quantities/materials-and-engineering.spw#q_mateng_water", ~"../../living/plants/botany-core.spw#plant_science_botany" ]
 see: [ ~"./bonding-and-states-of-matter.spw#materials_bonding_water_diagram" ]
}

^["concepts"]{
 primary: [ #hydrogen_bond, #density_anomaly, #dielectric_screening ]
 transfers: [ #phase_diagram, #hydraulic_state ]
 tensions: [ #iceberg_model ]
}

^["molecule"]{
 ^["geometry"]{
  #>materials_water_geometry
  ^["bent_polar"]{
   #:claim #!settled
   statement: "An isolated water molecule is bent, with an H-O-H angle near 104.5 degrees and a dipole near 1.85 D."
   reads: %[mateng.water.hoh_angle_deg, mateng.water.dipole_debye]
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_eisenberg_kauzmann"
  }
 }
 ^["hydrogen_bonds"]{
  #>materials_water_hbond_network
  ^["network"]{
   #:claim #!settled
   statement: "Each molecule can donate two and accept two hydrogen bonds, so the liquid forms a fluctuating, roughly tetrahedral network whose bonds rearrange on picosecond timescales."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_eisenberg_kauzmann"
   ^["limits"]{
    holds: "bulk liquid near room temperature"
    fails: "confined water, interfaces, and supercooled water need separate models"
   }
  }
 }
}

^["anomalies"]{
 #>materials_water_density_max
 ^["density_maximum"]{
  #:claim #!settled
  statement: "Liquid water is densest near 3.98 C; ice Ih is about 8 percent less dense than that liquid, so ice floats and lakes freeze from the top."
  reads: %[
   mateng.water.t_rho_max_c,
   mateng.water.rho_ice_g_cm3,
   mateng.water.rho_liquid_max_g_cm3
  ]
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_crc_handbook"
 }
 #>materials_water_heat_capacity
 ^["heat_capacity"]{
  #:claim #!settled
  statement: "Water stores about 4.18 J per gram per kelvin, several times more than rock, which is why oceans buffer climate and coasts swing less than interiors."
  reads: %[mateng.water.cp_j_per_g_k]
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_crc_handbook"
 }
 #>materials_water_permittivity
 ^["permittivity"]{
  #:claim #!settled
  statement: "A relative permittivity near 78 at 25 C weakens the attraction between dissolved ions by that factor, so many salts dissolve."
  reads: %[mateng.water.epsilon_r]
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_crc_handbook"
 }
 #>materials_water_hydrophobic
 ^["hydrophobic_effect"]{
  #:claim #!contested
  statement: "Nonpolar solutes cluster in water because separating them costs the surrounding network entropy; the older iceberg picture of ordered cages overstates that ordering."
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_eisenberg_kauzmann"
 }
}

^["uses"]{
 ^["steam"]{
  engine: "the large enthalpy of vaporization lets a Rankine cycle move much heat per kilogram of working fluid"
  reads: %[mateng.water.dh_vap_kj_per_mol]
 }
 ^["desalination"]{
  reverse_osmosis: "reverse-osmosis plants push seawater across polyamide membranes at a pressure above its osmotic pressure, which rises with salinity and temperature"
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_sharqawy_2010"
 }
}

^["history"]{
 #>materials_water_hydraulic_hypothesis
 ^["hydraulic_states"]{
  #:claim #!contested
  statement: "Wittfogel argued that managing large irrigation works produced centralized despotic states; later archaeology finds many large water systems built and run by local or community institutions."
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_wittfogel_1957"
  counter: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_scarborough_2003"
 }
 #>materials_water_steam_engines
 ^["steam_engines"]{
  #:claim #!settled
  statement: "Newcomen engines pumped mine water from 1712; Watt patented the separate condenser in 1769, and in 1781 the firm patented sun-and-planet gearing, usually credited to William Murdoch, for rotary output."
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_hills_1989"
  era: 1712..1781
 }
 #>materials_water_sanitation
 ^["sanitation"]{
  #:claim #!settled
  statement: "Snow traced the 1854 Broad Street cholera cluster in London to a contaminated water pump, evidence that cholera travels in water."
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_snow_1855"
 }
 #>materials_water_purification_mortality
 ^["purification_and_mortality"]{
  #:claim #!contested
  statement: "Cutler and Miller credited filtration and chlorination with nearly half of the 1900 to 1936 mortality decline in major US cities; Anderson, Charles, and Rees find a measurable role only for filtration, in infant mortality."
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_cutler_miller_2005"
  counter: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_anderson_charles_rees_2022"
  counter_finding: "In 25 cities from 1900 to 1940, filtration is associated with an 11 to 12 percent reduction in infant mortality; chlorination, sewage treatment, and milk standards show no detectable contribution."
  ^["limits"]{
   holds: "both studies cover large US cities in the first decades of the twentieth century"
   fails: "the 11 to 12 percent is a drop in the infant mortality rate, not a share of the decline, so it does not compare directly with nearly half"
  }
  see: [ ~"../../registries/sources/materials-and-engineering.spw#src_mateng_cutler_miller_2022" ]
  ~#(Cutler and Miller answered in a 2022 comment, and the authors replied)
 }
}

^["try"]{
 #>materials_water_try_density
 ^["layered_glass"]{
  materials: [ "two clear cups", "ice cubes", "warm tap water", "cold tap water", "food coloring" ]
  steps: << "color the warm water" ; "pour it gently over cold water" ; "watch the layers hold" ; "drop in an ice cube and watch where it sits" >>
  time: .{ n: 15, unit: "minutes" }
  safety: "use warm tap water, not boiling water"
  shows: ~"./water.spw#materials_water_density_max"
 }
}

#>materials_water_ice_sink_q
?["If ice sank, would lakes freeze from the bottom up?"]{
 #:depth #!physical ~#lens(material grain)
 #:claim #!speculative
 ~#hypothesis: "With ice denser than the liquid, winter ice would settle below the summer mixed layer and could accumulate from year to year."
 !probe{ "1-D lake column, ice 5 percent denser, 100 winters" =id[p_mateng_water_ice_sink] =kind[sim] }
 $%[mateng.water.rho_ice_g_cm3, mateng.water.t_rho_max_c]
 ~"./water.spw#materials_water_density_max" ~#neighbor(nearest)
}
