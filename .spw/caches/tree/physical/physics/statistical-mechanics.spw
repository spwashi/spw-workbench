^["edges"]{
 needs: [ ~"./classical-thermodynamics.spw#physics_thermo_classical" ]
 feeds: [ ~"./graduate-topics.spw#physics_graduate_universality", ~"./nonequilibrium-and-information.spw#physics_nonequilibrium" ]
