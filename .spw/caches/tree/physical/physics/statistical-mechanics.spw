# Statistical Mechanics
#
# The canonical home for ensembles, partition functions, quantum gases, fluctuations, and simulation: how counting microscopic states yields temperature, pressure, and phase.

#>physics_statmech
#:layer #!reference
#:domain #!physics
#:form #!ledger
#:level #!advanced
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Statistical Mechanics"
 ~#claim: "By counting states, a partition function yields every equilibrium property, and temperature is defined by how entropy changes with energy, 1/T = dS/dE."
 ~#proof: "Gibbs 1902 for the ensembles; Schroeder and Pathria for the derivations; Onsager 1944 and Metropolis 1953 for the exact and sampled results."
 ~#door: "Do the photon arithmetic, then follow fluctuations into critical phenomena on the graduate ledger."
 ~#audience: "upper-division students in physics, chemistry, and engineering"
 continuity: "Statistical Mechanics | counting states"
 cold_open: "Statistical mechanics gets temperature, pressure, and boiling points by counting states, and the sun pays for it in photons."
}

