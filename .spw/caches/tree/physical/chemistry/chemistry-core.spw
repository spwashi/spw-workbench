# Chemistry Core
#
# The undergraduate chemistry major as a prerequisite graph shaped by the ACS approval guidelines: general, analytical, organic, physical, inorganic, biochemistry, instrumental analysis, and safe bench practice.

#>chemistry_core
#:layer #!reference
#:domain #!chemistry
#:form #!curriculum
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Chemistry Core"
 ~#claim: "The 2015 ACS guidelines shaped a chemistry degree as foundation courses in analytical, biochemistry, inorganic, organic, and physical chemistry, then in-depth courses, lab hours, and research."
 ~#proof: "the 2015 ACS Committee on Professional Training guidelines for program shape, since replaced by a 2023 edition; Harris, Clayden, Atkins, and Miessler for the core; the OSHA laboratory standard for bench safety."
 ~#door: "Make a cabbage indicator, then follow the acid-base node up to physical chemistry."
 ~#audience: "chemistry majors, advisors, and readers mapping what a chemistry degree contains"
 continuity: "Chemistry Core | foundation courses"
 cold_open: "The ACS model of a chemistry degree stacked foundation courses in five areas, then traded recipes for mechanisms and spectra."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/chemistry-and-chemical-engineering/undergrad-chemistry.spw" ]
 method: #revised
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
