# Errata: Life and Mind
#
# Raw claims in the life sciences, cognition, linguistics, and mathematics that the review found wrong, overstated, or missing a condition, with corrections and sources; harms live in the harm register instead.

#>provenance_errata_life_mind
#:layer #!reference
#:domain #!provenance
#:form #!ledger
#:level #!advanced
#:review #!adversarial_checked
#:valence #!bane

^"emit"{
 ~#title: "Errata: Life and Mind"
 ~#claim: "The raw life, mind, language, and mathematics files were mostly right, but dropped theorem conditions and stated contested findings as settled."
 ~#proof: "Each row cites a textbook, a replication, or the primary paper that settles or contests the raw line."
 ~#door: "Find the raw path and line, read whether it was refuted, contested, or missing a condition, then open the corrected surface."
 ~#audience: "students and readers who met a raw science or mathematics claim"
 continuity: "Errata: Life and Mind | missing a condition"
 cold_open: "Most raw science lines were right, and the ones listed here were wrong, overstated, or missing a condition."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #transcribed
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{
   event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #partial
   note: "forward refs to planned files other packages had not written yet"
  }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "Cas9 and OT rows moved to contested; base editor row narrowed to deaminase editors"
  }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "Na inactivation row now gives the allosteric IFM mechanism from cryo-EM; OT row moved to an ambiguous rank outside the error counts"
  }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 checked: "every raw line below was re-read at its path and line on 2026-10-02; corrections follow the scorecard and the cited works"
}

^["edges"]{
 grounds: [ ~"./review-scorecard.spw#provenance_scorecard" ]
 contrasts: [ ~"./harm-register.spw#provenance_harm_register" ]
 see: [ ~"../language-and-mind/cognition/replication-ledger.spw#cognition_replication_ledger" ]
}

^["concepts"]{
 primary: [ #correction, #replication ]
 transfers: [ #hypothesis_drop ]
 tensions: [ #overclaim ]
}

^["ranks"]{
 refuted: "the raw line is wrong"
 contested: "the raw line states as settled a finding that replications or reviews dispute"
 condition: "the raw line states a theorem without a hypothesis it needs; recorded as refuted, since the bare statement is false"
 ambiguous: "the raw wording admits a correct reading; the row records the reading that holds and counts as neither an error nor a contested finding"
}

^["linguistics"]{
 #>provenance_errata_ling_phonology
 ^["phonology_and_semantics"]{
  #:claim #!refuted
  statement: "The raw linguistics files reversed a formant relation, credited feature geometry to SPE, tied Ross islands to a later mechanism, and mistyped determiners; one OT line is ambiguous rather than wrong."
  corrected_in: ~"../language-and-mind/linguistics/phonetics-and-phonology.spw#linguistics_phonology"
  ^["f2"]{ at: ".spw/caches/university-education/linguistics/phonetics-and-phonology.spw:19", rank: #refuted, was: "F2 rises with backness", now: "F2 is highest for front vowels and falls as the tongue moves back", source: ~"../registries/sources/language-and-communities.spw#src_lang_ladefoged_johnson_2015" }
  ^["place_nodes"]{ at: ".spw/caches/university-education/linguistics/phonetics-and-phonology.spw:32", rank: #refuted, was: "SPE place nodes", now: "SPE used flat binary matrices; place nodes come from later feature geometry", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_clements_1985" }
  ^["ot_input"]{ at: ".spw/caches/university-education/linguistics/phonetics-and-phonology.spw:37", rank: #ambiguous, was: "OT maps a universal input", now: "constraints are universal and their ranking is language-particular; by Richness of the Base the input set is the same for every language, while each lexicon stores its own underlying forms", note: "the raw wording can be read correctly, so the row is kept out of the error and contested counts", source: ~"../registries/sources/language-and-communities.spw#src_lang_prince_smolensky_2004" }
  ^["islands"]{ at: ".spw/caches/university-education/linguistics/morphology-and-syntax.spw:38", rank: #refuted, was: "Ross islands are barred by the PIC", now: "Ross named the islands in 1967; the Phase Impenetrability Condition is one later Minimalist account of some of them", sources: [ ~"../registries/sources/language-and-communities.spw#src_lang_ross_1967", ~"../registries/sources/language-and-communities.spw#src_lang_chomsky_2000" ] }
  ^["determiners"]{ at: ".spw/caches/university-education/linguistics/semantics-pragmatics-and-discourse.spw:19", rank: #refuted, was: "every, some, and most have type et-t", now: "a quantified phrase has that type; the determiner relates two sets and takes one more argument", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_heim_kratzer_1998" }
  ^["ngram"]{ at: ".spw/caches/university-education/linguistics/taste.spw:33", rank: #refuted, was: "language models are statistical n-gram predictors", now: "transformer models condition on long contexts through attention, not fixed n-gram windows", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_vaswani_2017" }
 }
}

^["cognition"]{
 #>provenance_errata_cognition
 ^["development_memory_reasoning"]{
  #:claim #!contested
  statement: "The raw cognition files fixed false-belief timing across cultures, called forgetting exponential, misattributed a Wason result, and taught two contested findings as settled."
  corrected_in: ~"../language-and-mind/cognition/replication-ledger.spw#cognition_replication_ledger"
  ^["false_belief"]{ at: ".spw/caches/university-education/cognitive-psychology/cognitive-development-and-language.spw:39", rank: #refuted, was: "children pass false-belief tasks at almost exactly 48 months across cultures", now: "the developmental trajectory is similar across countries, but its timing shifts by country and task", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_wellman_2001" }
  ^["forgetting"]{ at: ".spw/caches/university-education/cognitive-psychology/memory-systems-and-knowledge-representation.spw:33", rank: #refuted, was: "Ebbinghaus exponential forgetting curve", now: "a replication of Ebbinghaus fits a power or logarithmic curve better than a single exponential", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_murre_dros_2015" }
  ^["wason"]{ at: ".spw/caches/university-education/cognitive-psychology/reasoning-decision-making-and-heuristics.spw:18", rank: #refuted, was: "the drinking-age Wason task belongs to Cosmides and Tooby", now: "Griggs and Cox introduced the drinking-age version in 1982; Cosmides later offered the social-contract account", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_griggs_cox_1982" }
  ^["marshmallow"]{ at: ".spw/caches/university-education/cognitive-psychology/cognitive-development-and-language.spw:29", rank: #contested, was: "delay of gratification taught as a stable predictor", now: "a larger conceptual replication found smaller links to later outcomes that shrink further with background controls", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_watts_2018" }
  ^["nudges"]{ at: ".spw/caches/university-education/cognitive-psychology/taste.spw:21", rank: #contested, was: "choice architecture taught as reliably effective", now: "a bias-corrected reanalysis found no evidence for an average nudge effect; defenders dispute the pooling", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_maier_2022" }
 }
}

^["life_sciences"]{
 #>provenance_errata_cells_neuro
 ^["cells_and_neurons"]{
  #:claim #!refuted
  statement: "The raw cell and neuroscience files stated a contested Cas9 search model as settled, gave Na channels a ball and chain, and stated two open questions as settled."
  corrected_in: ~"../living/neuroscience/cellular-neurobiology.spw#neuroscience_cellular"
  ^["cas9"]{ at: ".spw/caches/university-education/molecular-and-cellular-biology/nucleic-acid-mechanics-and-genomics.spw:40", rank: #contested, was: "Cas9 combines 3D collision with rapid one-dimensional sliding along the backbone", now: "Sternberg et al. 2014 saw mainly 3D diffusion with transient PAM sampling; Globyte et al. 2019 reported short-range lateral diffusion near PAMs; the share of each is still debated", sources: [ ~"../registries/sources/provenance-and-reference.spw#src_prov_sternberg_2014", ~"../registries/sources/life-and-mind.spw#src_life_globyte_2019" ] }
  ^["na_inactivation"]{ at: ".spw/caches/university-education/neuroscience/cellular-and-molecular-neurobiology.spw:22", rank: #refuted, was: "Na inactivation by a ball-and-chain peptide", now: "fast inactivation depends on the hydrophobic IFM motif in the III-IV linker; West et al. proposed a hinged lid in 1992, and cryo-EM structures support the motif acting allosterically from a pocket beside the pore, not plugging it", sources: [ ~"../registries/sources/provenance-and-reference.spw#src_prov_west_1992", ~"../registries/sources/provenance-and-reference.spw#src_prov_pan_2018" ] }
  ^["split_brain"]{ at: ".spw/caches/university-education/neuroscience/taste.spw:38", rank: #contested, was: "callosotomy yields two independent conscious streams", now: "perception splits, but at least one study reports a unified agent; the question stays open", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_pinto_2017" }
  ^["neurogenesis"]{ at: ".spw/caches/university-education/neuroscience/taste.spw:24", rank: #contested, was: "adult neurogenesis reshapes the brain until death", now: "two 2018 studies disagree on whether human hippocampal neurogenesis persists in adults", sources: [ ~"../registries/sources/provenance-and-reference.spw#src_prov_sorrells_2018", ~"../registries/sources/provenance-and-reference.spw#src_prov_boldrini_2018" ] }
 }
 #>provenance_errata_plants
 ^["plants"]{
  #:claim #!refuted
  statement: "The raw plant files gave deaminase base editors transversions, plant NLRs a shared ancestry with animal NLRs, and the Casparian strip suberin."
  corrected_in: ~"../living/plants/plant-genomics.spw#plant_science_genomics"
  ^["base_editors"]{ at: ".spw/caches/university-education/horticulture-and-botany/masters-horticulture-and-plant-genomics.spw:33", rank: #refuted, was: "cytidine and adenine deaminase editors install transversions", now: "deaminase cytosine and adenine base editors install transitions; later C-to-G and glycosylase base editors and prime editing can write transversions", sources: [ ~"../registries/sources/provenance-and-reference.spw#src_prov_komor_2016", ~"../registries/sources/plants-ecology-care.spw#src_eco_kurt_2021", ~"../registries/sources/provenance-and-reference.spw#src_prov_zhao_2021", ~"../registries/sources/plants-ecology-care.spw#src_eco_anzalone_2019" ] }
  ^["nlr"]{ at: ".spw/caches/university-education/horticulture-and-botany/masters-horticulture-and-plant-genomics.spw:70", rank: #refuted, was: "plant and animal NLRs share an ancestor a billion years back", now: "the NB-LRR architectures arose independently in plants and animals", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_urbach_ausubel_2017" }
  ^["casparian"]{ at: ".spw/caches/university-education/horticulture-and-botany/undergrad-botany-and-plant-biology.spw:20", rank: #refuted, was: "a suberin Casparian strip", now: "the strip is a lignin barrier that blocks the apoplast and routes water through cells", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_naseer_2012" }
  ^["wood_wide_web"]{ at: ".spw/caches/university-education/horticulture-and-botany/undergrad-botany-and-plant-biology.spw:71", rank: #contested, was: "forests share carbon and warnings through a fungal network", now: "field evidence for network-mediated transfer and signaling is weak and often overcited", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_karst_2023" }
  ^["far_red"]{ at: ".spw/caches/university-education/horticulture-and-botany/undergrad-horticultural-science.spw:98", rank: #refuted, was: "an end-of-day far-red pulse speeds flowering without stretching stems", now: "end-of-day far red drives shade-avoidance elongation; stem stretch is the expected effect", source: ~"../registries/sources/plants-ecology-care.spw#src_eco_franklin_2008" }
 }
}

^["mathematics"]{
 #>provenance_errata_math
 ^["missing_conditions"]{
  #:claim #!refuted
  statement: "The raw mathematics files stated five theorems without a hypothesis each needs, so the bare statements are false."
  corrected_in: ~"../formal/mathematics/graduate-analysis-and-geometry.spw#mathematics_grad_analysis"
  ^["fatou"]{ at: ".spw/caches/university-education/mathematics/graduate-analysis-and-differential-geometry.spw:17", rank: #refuted, was: "Fatou lemma for any sequence", now: "Fatou needs nonnegative functions, or functions bounded below by an integrable one", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_folland_1999" }
  ^["fubini"]{ at: ".spw/caches/university-education/mathematics/graduate-analysis-and-differential-geometry.spw:18", rank: #refuted, was: "Fubini-Tonelli on any product", now: "Tonelli and the product-measure construction need sigma-finite measures", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_folland_1999" }
  ^["van_kampen"]{ at: ".spw/caches/university-education/mathematics/graduate-algebra-and-algebraic-topology.spw:29", rank: #refuted, was: "van Kampen for any union", now: "van Kampen needs open sets with a path-connected intersection containing the basepoint", source: ~"../registries/sources/formal.spw#src_formal_hatcher_2002" }
  ^["coverings"]{ at: ".spw/caches/university-education/mathematics/graduate-algebra-and-algebraic-topology.spw:30", rank: #refuted, was: "coverings match subgroups of the fundamental group", now: "the correspondence needs a path-connected, locally path-connected, semilocally simply connected base", source: ~"../registries/sources/formal.spw#src_formal_hatcher_2002" }
  ^["cauchy_riemann"]{ at: ".spw/caches/university-education/mathematics/undergrad-topology-and-complex-analysis.spw:29", rank: #refuted, was: "Cauchy-Riemann equations if and only if differentiable", now: "the equations plus real differentiability give complex differentiability; conformality needs a nonzero derivative", source: ~"../registries/sources/formal.spw#src_formal_ahlfors_1979" }
 }
 #>provenance_errata_godel
 ^["incompleteness"]{
  #:claim #!refuted
  statement: "The raw mathematics taste file dropped the effective-axiomatization condition from Gödel and presented the Lucas-Penrose argument as its consequence."
  corrected_in: ~"../formal/mathematics/index.spw#mathematics_index"
  ^["condition"]{ at: ".spw/caches/university-education/mathematics/taste.spw:41", rank: #refuted, was: "any consistent system capable of arithmetic", now: "the theorem covers consistent, effectively axiomatized theories that interpret enough arithmetic", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_franzen_2005" }
  ^["minds"]{ at: ".spw/caches/university-education/mathematics/taste.spw:41", rank: #contested, was: "the theorem shows minds exceed machines", now: "the Lucas-Penrose argument is a disputed philosophical reading, not a consequence of the theorem", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_franzen_2005" }
 }
}

^["flagged"]{
 basis: "the review flagged these lines; no correction source was checked in this pass"
 ^["shear"]{ at: ".spw/caches/university-education/bioengineering/biomedical-instrumentation-and-biomechanics.spw:40", gist: "the shear mechanosensor account read as backwards by the reviewer" }
}

#>provenance_errata_life_mind_q
?["Do dropped theorem conditions follow the same pattern as dropped study caveats?"]{
 #:depth #!educational ~#lens(formal structure)
 #:claim #!speculative
 ~#hypothesis: "Both are compression losses: a summary keeps the memorable conclusion and drops the qualifier that makes it true."
 !probe{ "classify every row here as dropped-condition or wrong-fact and compare the two shares across mathematics and psychology" =id[p_prov_errata_compression] =kind[census] }
 $%[prov.review.r2_file_count]
 ~"./errata-life-and-mind.spw#provenance_errata_math" ~#neighbor(nearest)
 breaks: "a theorem without its condition is false, while a finding without its caveat may still hold on average"
}
