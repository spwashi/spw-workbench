  ^[".spw/caches/indie-author-ecosystem/publishing-platforms-and-business-models.spw"]{ d: 3, i: 2, s: 2, t: 3, a: 4, verdict: #keep, note: "Smashwords merged into Draft2Digital in 2022" }
  ^[".spw/caches/indie-author-ecosystem/genre-conventions-and-cultural-trends.spw"]{ d: 3, i: 3, s: 1, t: 3, a: 3, verdict: #fix, note: "LitRPG and cultivation origins uncredited" }
  ^[".spw/caches/indie-author-ecosystem/author-software-and-production-tools.spw"]{ d: 2, i: 2, s: 2, t: 3, a: 3, verdict: #keep, note: "MOBI deprecated" }
  ^[".spw/caches/indie-author-ecosystem/marketing-readers-and-community-traditions.spw"]{ d: 2, i: 2, s: 2, t: 3, a: 3, verdict: #fix, note: "a 30-day cliff is folklore; review copies need disclosure" }
  ^[".spw/caches/community-roles/ (5 files)"]{ d: "1-2", i: 2, s: "1-2", t: 3, a: "2-3", verdict: #[ regen, drop ], join: "or", note: "remediation, test-strip, and doula claims wrong; a stereotype" }
  ^[".spw/caches/physiological-development/common-deficiencies.spw"]{ d: 3, i: 1, s: 2, t: 3, a: 1, verdict: #drop, note: "three harms; see the harm register" }
