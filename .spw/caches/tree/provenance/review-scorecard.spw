# Review Scorecard
#
# The two review rounds of 2026-09-30 as records: depth, independent value, script value, tree fit, and accessibility per raw file, with verdicts and tree-wide measurements.

#>provenance_scorecard
#:layer #!reference
#:domain #!provenance
#:form #!registry
#:level #!practitioner
#:review #!adversarial_checked
#:valence #!bane

^"emit"{
 ~#title: "Review Scorecard"
 ~#claim: "Round one scored 152 raw files on five axes and round two scored or summarized the later files; both found core lists mostly right, with errors concentrated in the taste and wonder layers."
 ~#proof: "Transcribed from the review scorecard kept with the cut plan; editor rows were verified against the extension and LSP sources."
 ~#door: "Find a raw file row, read its verdict, then open the errata ledger for its corrected lines."
 ~#audience: "reviewers deciding what to trust in the raw shelf"
 continuity: "Review Scorecard | five axes"
 cold_open: "Most raw files were scored on five axes, and the scores show where the shelf was solid and where it drifted."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".agents/plans/caches-cut-2026-09-30/references/review/scorecard.md" ]
 method: #transcribed
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "cut reviewers", care: #audit, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #pass }
  ^["r3"]{
   event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #partial
   note: "forward ref to a planned editor-hosts file another package had not written yet"
  }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "round-two coverage restated; life-science count checked against the shelf"
  }
  ^["r5"]{
   event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #partial
   note: "only the forward ref to the planned known-defects surface remains"
  }
  ^["r6"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "claim reworded to errors concentrated in taste and wonder; compound verdicts kept; effect lines recounted by hand at 229aedcf; code-bug lines pinned to 1aa1dc23"
  }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 note: "round one scored a 152-file snapshot on five axes; round two gave five-axis rows to the 9 materials files and group summaries to the rest of a 13:28 snapshot"
}

^["edges"]{
 grounds: [ ~"../registries/quantities/provenance-and-reference.spw#q_prov_review" ]
 feeds: [ ~"./errata-technical.spw#provenance_errata_technical", ~"./errata-life-and-mind.spw#provenance_errata_life_mind", ~"./errata-culture-and-society.spw#provenance_errata_culture", ~"./harm-register.spw#provenance_harm_register" ]
}

^["concepts"]{
 primary: [ #review_record, #correction ]
 transfers: [ #fixity ]
 tensions: [ #overclaim ]
}

^["scale"]{
 axes: .{ d: "depth", i: "independent value", s: "script value", t: "tree fit", a: "accessibility" }
 range: "1 to 5 per axis; a range like 1-3 covers a group of files"
 verdicts: #[ keep, promote, merge, regen, drop, fix, fold, move, rename, routing ]
 compound: "where the scorecard joins two verdicts, the row keeps both in order and names the joiner: plus or arrow for both, or for alternatives, slash as written"
 qualifiers: "a qualifier in parentheses, such as move under physics or split, stays in the note"
 source: ~"../registries/sources/provenance-and-reference.spw#src_prov_scorecard"
}

