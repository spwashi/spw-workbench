  ^[".spw/caches/physiological-development/taste.spw"]{ d: 1, i: 1, s: 1, t: 2, a: 1, verdict: #drop, note: "risk factors recast as adaptive" }
  ^[".spw/caches/physiological-development/developmental-stages.spw"]{ d: 3, i: 2, s: 1, t: 3, a: 2, verdict: #[ drop, regen ], join: "or", note: "invites manipulating the timing of puberty" }
  ^[".spw/caches/physiological-development/circadian-and-metabolic-resilience.spw"]{ d: 3, i: 1, s: 2, t: 3, a: 2, verdict: #[ drop, regen ], join: "or", note: "hydration claim false; ambiguous sun wording" }
 }
}

^["round_two"]{
 basis: "live snapshot at 13:28, which the scorecard header counts as 52 new files, all template B"
 ^["coverage"]{
  five_axis_rows: "every one of the 9 materials files on the shelf has a five-axis row, read directly by the reviewers"
  group_summaries: "the life-science group and the math, cognition, LIS, hospitality, and economics-taste group get summaries and best-file scores, not a row per file"
  shelf_count: "the shelf at 229aedcf holds 207 generated paths; 55 sit in the round-two folders: materials 9, life sciences 22, and math, cognition, LIS, and hospitality 24"
  reconcile: "152 plus the header count of 52 is 204, three short of 207; since every materials path has a row, the gap sits in the summarized groups or in the header count"
  open: "the life summary counts 21 where the shelf holds 22 in those folders, so one life-science path may have been missed or miscounted"
  sources: [ ~"../registries/sources/provenance-and-reference.spw#src_prov_scorecard", ~"../registries/sources/provenance-and-reference.spw#src_prov_raw_shelf" ]
 }
 ^["materials_matter_and_history"]{
  ^[".spw/caches/materials-matter-and-history/water-the-universal-matrix.spw"]{ d: 4, i: 3, s: 2, t: 3, a: 3, note: "constants correct; Wittfogel stated as fact; Watt dates merged" }
  ^[".spw/caches/materials-matter-and-history/steel-and-ferrous-metallurgy.spw"]{ d: 4, i: 3, s: 2, t: 2, a: 3, note: "phase numbers correct; folding and Hittite myths" }
  ^[".spw/caches/materials-matter-and-history/ink-and-inscriptional-technologies.spw"]{ d: 4, i: 4, s: 2, t: 3, a: 3, note: "wicking and corrosion right; gallate misnamed" }
  ^[".spw/caches/materials-matter-and-history/paint-and-color-chemistry.spw"]{ d: 4, i: 4, s: 2, t: 3, a: 3, note: "refractive indices right; Chauvet dates confuse BP and BCE" }
  ^[".spw/caches/materials-matter-and-history/acrylic-and-synthetic-polymers.spw"]{ d: 4, i: 3, s: 2, t: 3, a: 3, note: "PMMA properties right; brand and aircraft history wrong" }
  ^[".spw/caches/materials-matter-and-history/fibers-and-textile-technologies.spw"]{ d: 4, i: 4, s: 2, t: 3, a: 3, note: "cellulose bonding right; silk legend told as law" }
  ^[".spw/caches/materials-matter-and-history/phases-of-matter-and-chemical-bonding.spw"]{ d: 3, i: 3, s: 2, t: 3, a: 3, note: "a hub with no links" }
  ^[".spw/caches/materials-matter-and-history/taste.spw"]{ d: 1, i: 2, s: 1, t: 2, a: 2, note: "oil-paint drying, punched-card origin, and Hollerith inspiration wrong" }
  ^[".spw/caches/materials-matter-and-history/index.spw"]{ d: 2, i: 2, s: 3, t: 3, a: 2, note: "history folded in as a lens" }
 }
 ^["life_sciences"]{
  summary: "21 files by the reviewer count, 22 on the shelf; neuroscience, cell biology, and bioengineering about 95 percent correct; nursing about 88 percent with guideline drift"
  best: [ ".spw/caches/university-education/molecular-and-cellular-biology/protein-structure-and-enzymology.spw", ".spw/caches/university-education/nursing/critical-care-and-evidence-based-informatics.spw" ]
  harms: "six nursing harms; pointers live in the harm register"
 }
 ^["math_cognition_lis_hospitality"]{
  summary: "25 files, the economics taste file among them; about 90 percent core accuracy"
  best: [ ".spw/caches/university-education/cognitive-psychology/perception-attention-and-psychophysics.spw", ".spw/caches/university-education/library-and-information-sciences/knowledge-organization-and-metadata-schemas.spw", ".spw/caches/university-education/library-and-information-sciences/information-retrieval-and-search-systems.spw" ]
  gaps_found: "mathematics pure only; no language acquisition; hospitality lacks overbooking math; LIS lacks RDA, PageRank, CIPA, and FERPA"
  ethical_conflict: "cognitive psychology taste calls pain-of-paying exploitation a dark pattern while a hospitality file recommends it"
 }
}

^["measurements"]{
 #>provenance_scorecard_sourcing
 ^["sourcing"]{
  #:claim #!settled
  statement: "In round one only a small minority of the files declared any source, and none declared a generator, run id, or date."
  reads: %[prov.review.r1_file_count, prov.review.r1_sourced_file_count]
  source: ~"../registries/sources/provenance-and-reference.spw#src_prov_scorecard"
 }
 #>provenance_scorecard_handles
 ^["handles"]{
  #:claim #!settled
  statement: "Every metric handle in round one was unique, so no two files measured the same thing and nothing could aggregate."
  reads: %[prov.review.r1_metric_handle_count]
  source: ~"../registries/sources/provenance-and-reference.spw#src_prov_scorecard"
 }
 #>provenance_scorecard_lenses
 ^["lenses"]{
  #:claim #!settled
  statement: "Lens values almost never recurred in round one, which is why this cut closes the lens set in its vocabulary."
  reads: %[prov.review.r1_lens_value_count, prov.review.r1_lens_use_count]
  source: ~"../registries/sources/provenance-and-reference.spw#src_prov_scorecard"
 }
 #>provenance_scorecard_effects
 ^["invented_effects"]{
  #:claim #!settled
  statement: "Round-one wonder hypotheses carried dozens of effect sizes styled like findings and citing nothing; a recount at the pinned commit finds about fifty such lines, close to the reviewer estimate."
  reads: %[prov.review.r1_invented_effect_count, prov.review.r1_effect_line_recount]
  sources: [ ~"../registries/sources/provenance-and-reference.spw#src_prov_scorecard", ~"../registries/sources/provenance-and-reference.spw#src_prov_raw_shelf" ]
  ^["limits"]{
   holds: "hypothesis lines in the 152 round-one files that state a percentage, multiplier, fold change, or order of magnitude as an outcome"
   fails: "as an exact count of effect sizes: some lines carry two, effects in days or decibels are left out, and no figure was checked against the literature"
  }
 }
 other: [
  "every round-one file parsed; one degraded at .spw/caches/vscode/decorations.spw:100",
  "every round-one file carried the same layer axis value, so the axis said nothing",
  "index and taste files were about a fifth of the round-one lines and carried routing or stance only",
  "the root index duplicated its roots in a dispatch frame",
  "the second generator template, with wonder frames and key-formula facets, was stronger than the first"
 ]
}

^["code_bugs"]{
 basis: "surfaced while verifying the editor rows; independent of the shelf"
 pinned: "lines read at commit 1aa1dc23 and rechecked on 2026-10-03; the working tree has moved, so read one with git show 1aa1dc23:PATH"
 vscode_cache_layers: "1aa1dc23:extensions/vscode-spw/src/lsp/custom-requests.ts:377"
 vscode_trace_setting: "1aa1dc23:extensions/vscode-spw/src/extension.ts:77"
 intellij_fold_comment: "1aa1dc23:extensions/intellij-spw/src/main/kotlin/com/spwashi/spw/SpwFoldingBuilder.kt:121"
 intellij_commenter: "1aa1dc23:extensions/intellij-spw/src/main/kotlin/com/spwashi/spw/SpwCommenter.kt:6"
 intellij_spellcheck: "1aa1dc23:extensions/intellij-spw/src/main/kotlin/com/spwashi/spw/SpwSpellcheckingStrategy.kt:9"
 intellij_gutter_nav: "1aa1dc23:extensions/intellij-spw/src/main/kotlin/com/spwashi/spw/SpwAnnotationLineMarkerProvider.kt:33"
 home: ~"../spw/hosts/known-defects.spw#editor_hosts_defects"
}

#>provenance_scorecard_axes_q
?["Would a score on tree fit predict which raw files needed the fewest corrections?"]{
 #:depth #!computational ~#lens(curated collection)
 #:claim #!speculative
 ~#hypothesis: "Files that fit the tree well were written against a clear neighbor, so they should carry fewer errata rows per hundred lines."
 !probe{ "join scorecard rows to errata rows by raw path and compare correction density across tree-fit scores" =id[p_prov_scorecard_fit] =kind[census] }
 $%[prov.review.r1_file_count, prov.review.r2_file_count]
 ~"./review-scorecard.spw#provenance_scorecard_sourcing" ~#neighbor(nearest)
}
