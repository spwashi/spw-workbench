# Streamers Bench
#
# A bench for live hosts as likely early Spw users: session states, show-note protocol, a chat pipeline, and a prompt deck, all speculative until a session is logged.

#>streaming_index
#:layer #!pragmatics
#:domain #!streaming
#:form #!index
#:level #!practitioner
#:review #!spot_checked
#:valence #!boon

^"emit"{
 ~#title: "Streamers Bench"
 ~#claim: "Live hosts may be among the first everyday Spw users, and this bench holds the tools to test that idea in one logged session."
 ~#proof: "Room mechanics come from the live platforms branch; every practice claim here is marked speculative and names the session log that would test it."
 ~#door: "Start with the session states, then the show-note protocol; draw one prompt from the deck before a practice stream."
 ~#audience: "live hosts, moderators, and Spw maintainers"
 continuity: "Streamers Bench | one logged session"
 cold_open: "Everything on this bench waits for one logged session to test it."
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{
   event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #partial
   pending: "unresolved refs to planned files of other packages: making/streaming/chat-torrent-pipeline.spw and its anchor streaming_chat_torrent"
  }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{
   event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #partial
   pending: "unresolved refs to planned files of other packages: making/streaming/chat-torrent-pipeline.spw and its anchor streaming_chat_torrent"
  }
 }
 corrections: #[
  "fact check 2026-10-02: the r3 gate receipt said pass while refs to planned files of other packages failed; it now records partial and names them"
 ]
}

^["tree"]{
 session: ~"./live-session-craft.spw"
 protocol: ~"./spw-for-streamers.spw"
 chat_torrent: ~"./chat-torrent-pipeline.spw"
 deck: ~"./prompt-deck.spw"
}

^["bundle"]{
 ={
  ~"./live-session-craft.spw#streaming_live_session"
  ~"./spw-for-streamers.spw#streaming_spw_for_streamers"
  ~"./chat-torrent-pipeline.spw#streaming_chat_torrent"
  ~"./prompt-deck.spw#streaming_prompt_deck"
 }
}

^["order"]{
 pmest: "domain streaming; matter session, notes, chat, prompts; energy protocol then probe battery; time current"
 reading: << "session states" ; "show-note protocol" ; "chat-torrent pipeline" ; "prompt deck" >>
}

^["bench_rule"]{
 #>streaming_index_hypothesis
 ^["first_users"]{
  #:claim #!speculative
  statement: "Hosts who already plan segments and recurring bits will find a brace-first show file natural sooner than most other writers."
  test: "one logged session: a pre-show file, state changes with times, a digest, and a host note on what helped"
 }
 #>streaming_index_session_log
 ^["session_log"]{
  shape: "a dated frame per session holding the show file path, state timeline, digest anchor, and receipts"
  privacy: "no viewer handles, no faces, no personal details; topics only"
  promotion: "a practice claim moves from speculative to emerging only when a session log supports it"
 }
}

^["gaps"]{
 observed: "no streamer session has been observed or logged yet"
 platforms: "the bench is written from TikTok LIVE and Twitch mechanics; other platforms are untested"
 audio: "audio-only rooms and podcasts recorded live are not yet covered"
}
