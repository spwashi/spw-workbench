# Visual Arts
#
# The visual arts branch: animation principles, illustration and sequential storytelling, and industrial design, with the stances the raw generation held marked as readings.

#>visual_arts_index
#:layer #!reference
#:domain #!visual_arts
#:form #!index
#:level #!foundation
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Visual Arts"
 ~#claim: "The visual arts branch covers the craft of motion, sequence, and objects: the twelve principles of animation, closure in comics, and continuity and repair in industrial design."
 ~#proof: "Each leaf credits its originators: Thomas and Johnston, McCloud, Eisner, Dow, Dreyfuss, Norman, and Shingo among them."
 ~#door: "Pick motion, sequence, or objects, and start with that leaf."
 ~#audience: "art and design students, animators, illustrators, and makers"
 cold_open: "Drawings move, panels tell stories, and objects meet hands, and this branch shows the craft behind each."
 continuity: "Visual Arts | craft"
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[
  ".spw/caches/university-education/illustration-and-animation/taste.spw",
  ".spw/caches/university-education/design-and-industrial-engineering/taste.spw"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-01", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
  }
 }
 corrections: [
  "the raw stances are reduced to interpretive readings",
  "invented figures in the raw wonders are dropped: 60 percent turnover, ten times fewer defects, 90-second phone repairs, and fps immersion claims"
 ]
}

^["tree"]{
 animation: ~"./animation-principles.spw"
 illustration: ~"./illustration-and-visual-storytelling.spw"
 industrial_design: ~"./industrial-design.spw"
}

^["bundle"]{
 ={ ~"./animation-principles.spw#visual_arts_animation" }
 ={ ~"./illustration-and-visual-storytelling.spw#visual_arts_illustration" }
 ={ ~"./industrial-design.spw#visual_arts_industrial_design" }
}

^["leaves"]{
 animation_principles: .{ domain: #visual_arts, form: #glossary }
 illustration: .{ domain: #visual_arts, form: #comparison }
 industrial_design: .{ domain: #visual_arts, form: #timeline, era: #modern }
}

^["stance"]{
 #>visual_arts_index_mark_stance
 ^["living_mark"]{
  #:claim #!interpretive
  statement: "A hand-drawn line keeps traces of the hand that made it, and many artists value that trace as part of the work."
 }
 #>visual_arts_index_repair_stance
 ^["against_obsolescence"]{
  #:claim #!interpretive
  statement: "Objects built to be opened, repaired, and kept carry a respect for their owners that sealed, short-lived objects lack."
 }
}

^["gaps"]{
 painting_and_print: "painting, printmaking, and photography have no leaf yet"
 game_and_interaction: "game art and interaction design wait for their own leaves"
 graduate_rung: "graduate animation direction lives in the film school sequence until a visual arts graduate leaf exists"
}
