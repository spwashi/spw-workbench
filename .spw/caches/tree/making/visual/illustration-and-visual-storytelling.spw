  }
 }
 corrections: [
  "panel transitions are credited to Scott McCloud, Understanding Comics (1993); the raw named them without credit",
  "notan is credited to its Japanese source as taught by Arthur Wesley Dow",
  "shape-language meanings are marked interpretive conventions, not laws",
  "the raw 45 percent Zorn-palette speedup is removed as invented"
 ]
}

^["edges"]{
 grounds: [ ~"../../registries/quantities/film-stage-visual.spw#q_film_craft" ]
 feeds: [ ~"../authorship/manuscript-to-market-dag.spw#authorship_manuscript_dag" ]
 analog: [ ~"../film/film-school-sequence.spw#film_school_kuleshov" ]
}

^["concepts"]{
 primary: [ #closure, #composition ]
 transfers: [ #key_frame, #rights_chain, #continuity_editing ]
 tensions: [ #generative_ai ]
}

^["transitions"]{
 #>visual_arts_illus_mccloud
 ^["mccloud_six"]{
  #:claim #!settled
  statement: "Scott McCloud's Understanding Comics (1993) names six kinds of panel-to-panel transition and calls the reader's work across the gutter closure."
  reads: %[film.comics.transition_types]
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_mccloud_1993"
 }
 #>visual_arts_illus_manga
 ^["manga_tally"]{
  #:claim #!settled
  statement: "McCloud's tally found aspect-to-aspect transitions far more common in the Japanese comics he sampled than in American or European ones."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_mccloud_1993"
 }
 matrix: .{ columns: "closure asked of the reader, then a typical use" }

 #>visual_arts_illus_moment
 ^["moment_to_moment"]{ closure: "very little", use: "slow time down inside one action" }
 #>visual_arts_illus_action
 ^["action_to_action"]{ closure: "little", use: "one subject through a sequence of actions" }
 #>visual_arts_illus_subject
 ^["subject_to_subject"]{ closure: "moderate", use: "cut between subjects inside one scene" }
 #>visual_arts_illus_scene
 ^["scene_to_scene"]{ closure: "large", use: "jump across time or space" }
 #>visual_arts_illus_aspect
 ^["aspect_to_aspect"]{ closure: "open", use: "wander across aspects of a place or mood" }
 #>visual_arts_illus_non_sequitur
 ^["non_sequitur"]{ closure: "unbounded", use: "panels with no logical link the reader can find" }
 #>visual_arts_illus_eisner
 ^["sequential_art"]{
  #:claim #!settled
  statement: "Will Eisner's Comics and Sequential Art (1985) named comics sequential art and taught panel and page as timing devices."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_eisner_1985"
 }
}

^["composition"]{
 #>visual_arts_illus_notan
 ^["notan"]{
  #:claim #!settled
  statement: "Arthur Wesley Dow's Composition (1899) taught notan, the Japanese idea of massing dark and light, in American art education."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_dow_1899"
 }
 #>visual_arts_illus_bang
 ^["shape_and_feeling"]{
  #:claim #!interpretive
  statement: "Molly Bang argues that horizontal shapes read as calm, diagonals as motion, and pointed shapes as threat; designers treat these as conventions to test."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_bang_1991"
 }
 #>visual_arts_illus_page_turn
 ^["picture_book_pacing"]{
  #:claim #!settled
  statement: "Uri Shulevitz treats the 32-page picture book as the standard format and the page turn as the unit of pacing."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_shulevitz_1985"
 }
}

^["rights"]{
 #>visual_arts_illus_wmfh
 ^["work_made_for_hire"]{
  #:claim #!settled
  statement: "Under US law a commissioned illustration is a work made for hire only if it fits a listed category and both parties sign a written agreement saying so."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_usc_101"
 }
 #>visual_arts_illus_ai
 ^["generated_images"]{
  #:claim #!settled
  statement: "The US Copyright Office's 2025 report holds that copyright needs human authorship and that prompts alone do not make a user the author of a generated image."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_usco_ai_2025"
  as_of: "2026-10-01"
 }
 #>visual_arts_illus_cover_bridge
 ^["cover_bridge"]{
  what: "a book cover is an illustration commission inside the publishing pipeline"
  hands_off: ~"../authorship/manuscript-to-market-dag.spw#authorship_manuscript_dag"
 }
}

^["try"]{
 #>visual_arts_illus_try_six
 ^["six_strips"]{
  materials: [ "paper", "a pen", "a ruler" ]
  steps: <<
   "rule six two-panel strips" ;
   "draw one strip for each McCloud transition" ;
   "show them unlabeled to a friend" ;
   "ask what happened between the panels" ;
   "note which strips needed the most guessing"
  >>
  time: .{ n: 45, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"./illustration-and-visual-storytelling.spw#visual_arts_illus_mccloud"
 }
}

#>visual_arts_illus_closure_q
?["Does reading time across a gutter grow with the closure a transition asks for?"]{
 #:depth #!educational ~#lens(information flow)
 #:claim #!speculative
 ~#hypothesis: "Readers dwell longer on panel pairs that ask more closure, so scene-to-scene pairs take longer than action-to-action pairs."
 !probe{ "time readers across matched panel pairs of each transition type with eye tracking" =id[p_film_illus_closure_time] =kind[field] }
 $%[film.comics.transition_types]
 ~"./illustration-and-visual-storytelling.spw#visual_arts_illus_mccloud" ~#neighbor(nearest)
}

#>visual_arts_illus_cut_q
?["Is the gutter between panels the same thing as a cut between shots?"]{
 #:depth #!stylistic ~#lens(semiotic charge)
 #:claim #!speculative
 ~#hypothesis: "Both ask the viewer to infer what joins two images, so editors and comics artists should share a vocabulary of transitions."
 breaks: "a reader sets the pace across a gutter; a film cut arrives on the editor's clock"
 !probe{ "map McCloud's six transitions onto a sample of film cuts and count the misfits" =id[p_film_illus_gutter_cut] =kind[thought] }
 ~"../film/film-school-sequence.spw#film_school_kuleshov" ~#neighbor(nearest)
}
