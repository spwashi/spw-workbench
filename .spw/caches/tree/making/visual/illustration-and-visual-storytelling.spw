# Illustration and Visual Storytelling
#
# Panel transitions compared as McCloud named them, composition and value from Dow and Bang, picture-book pacing, and the rights an illustrator keeps or sells, with a bridge to book covers.

#>visual_arts_illustration
#:layer #!reference
#:domain #!visual_arts
#:form #!comparison
#:level #!foundation
#:review #!adversarial_checked
#:valence #!boon

^"emit"{
 ~#title: "Illustration and Visual Storytelling"
 ~#claim: "Sequential images work through closure: Scott McCloud names six panel transitions by how much the reader must supply in the gutter, and composition decides where the eye lands first."
 ~#proof: "McCloud's Understanding Comics (1993), Eisner's Comics and Sequential Art (1985), Dow's Composition (1899), and US copyright law on work made for hire."
 ~#door: "Compare the six transitions, then draw one strip for each."
 ~#audience: "illustration and comics students, picture-book makers, and authors commissioning covers"
 cold_open: "A reader fills the gap between two panels, and that act of closure is what turns pictures into a story."
 continuity: "Illustration and Visual Storytelling | closure"
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/illustration-and-animation/undergrad-illustration-and-visual-storytelling.spw" ]
 ^["receipts"]{
