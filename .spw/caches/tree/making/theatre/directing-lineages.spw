# Directing Lineages
#
# A teacher-to-student ladder of modern theatre directing and actor training, from the Moscow Art Theatre to devised and documentary theatre, with branches in Japan, Brazil, Poland, and France.

#>theatre_directing
#:layer #!reference
#:domain #!theatre
#:form #!timeline
#:level #!advanced
#:review #!adversarial_checked
#:valence #!boon
#:era #!modern

^"emit"{
 ~#title: "Directing Lineages"
 ~#claim: "Modern directing grew along teacher-to-student lines from the Moscow Art Theatre through the Group Theatre, and branched through Grotowski, Brook, Lecoq, Boal, Suzuki, and Viewpoints."
 ~#proof: "Benedetti, Clurman, and the practitioners' own books, each cited on its rung."
 ~#door: "Climb the ladder in time order, then follow a feeds link to see who taught whom."
 ~#audience: "directing students and theatre makers tracing where a practice came from"
 cold_open: "Most directing practice passed along teacher-to-student lines, and the lineage shows who carried each idea where."
 continuity: "Directing Lineages | teacher-to-student"
}

