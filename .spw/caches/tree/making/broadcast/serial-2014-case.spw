# Serial 2014
#
# A weekly investigative podcast that premiered on October 3, 2014 showed serialized long-form audio could hold a mass audience, before anyone agreed on how to count it.

#>broadcast_serial_case
#:layer #!reference
#:domain #!broadcast
#:form #!dossier
#:level #!intro
#:review #!adversarial_checked
#:valence #!bonk
#:era #!contemporary

^"emit"{
 ~#title: "Serial 2014"
 ~#claim: "Serial premiered on 2014-10-03 as weekly serialized nonfiction audio, and its record audience arrived before the industry shared a rule for counting downloads."
 ~#proof: "Premiere, makers, release model, and the 2015 Peabody are on the public record; IAB Tech Lab published common podcast measurement rules in 2016 and 2017."
 ~#door: "Set the release model beside the run sheet, and the counting problem beside the market receipts."
 ~#audience: "readers new to podcast history and anyone citing an audience number"
 continuity: "Serial 2014 | weekly serialized"
 cold_open: "A weekly serialized story showed audio could hold a mass audience."
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
