# Broadcast
#
# Long-form audio and video craft: a run sheet for the episode, a cadence for the run, and the Serial case for the form and its counting.

#>broadcast_index
#:layer #!reference
#:domain #!broadcast
#:form #!index
#:level #!practitioner
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Broadcast"
 ~#claim: "Long-form broadcast asks listeners for hours of attention, so the episode needs a run sheet, the run needs a cadence with rest, and every audience number needs its counting rule."
 ~#proof: "The run sheet and cadence are revised from the raw podcast plan with their contradictions fixed; the Serial dossier cites the public record and the IAB guidelines."
 ~#door: "Read the run sheet first, then the cadence, then the Serial case."
 ~#audience: "producers, hosts, and listeners of long-form shows"
 continuity: "Broadcast | hours of attention"
 cold_open: "Long-form shows ask for hours of attention and owe a plan in return."
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5"
 lineage: #[ ".spw/caches/podcasting/taste.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
  }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[ "the taste file is reduced to four interpretive lines; its invariants about quarterly review and a permanently free archive become practices in the cadence" ]
}

^["tree"]{
 run_sheet: ~"./episode-run-sheet.spw"
 cadence: ~"./broadcast-cadence.spw"
 serial: ~"./serial-2014-case.spw"
}

^["bundle"]{
 ={
  ~"./episode-run-sheet.spw#broadcast_run_sheet"
  ~"./broadcast-cadence.spw#broadcast_cadence"
  ~"./serial-2014-case.spw#broadcast_serial_case"
 }
}

^["order"]{
 pmest: "domain broadcast; matter episode then run then case; energy protocol, calendar, dossier; time current then contemporary"
 reading: << "run sheet" ; "cadence" ; "Serial" >>
}

^["stance"]{
 #>broadcast_index_contract
 ^["attention"]{
  #:claim #!interpretive
  statement: "Asking a listener for three hours a day is a contract: the hosts do the hard reading so the listener time is well spent."
 }
 #>broadcast_index_elevation
 ^["elevation"]{
  #:claim #!interpretive
  statement: "Teaching on air is elevation, not performance; honest confusion from the co-host is often the most useful minute of an episode."
 }
 #>broadcast_index_lineage
 ^["lineage"]{
  #:claim #!interpretive
  statement: "Naming the people whose quiet work built a protocol or a compiler is part of explaining it."
 }
 #>broadcast_index_agency
 ^["agency"]{
  #:claim #!interpretive
  statement: "The aim is a listener who feels able to build a better system, not one who only admires the existing one."
 }
}

^["gaps"]{
 loudness: "acoustics and loudness standards have no surface yet; the run sheet and cadence need one"
 music: "music and audio production as a bench with its own release season"
 radio: "broadcast transmission history without carriers, radio and television"
}
