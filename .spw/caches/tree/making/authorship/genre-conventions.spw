# Genre Conventions
#
# A glossary lattice of genres that grew in independent and web publishing, with their origins credited and the promise each makes to readers.

#>authorship_genres
#:layer #!reference
#:domain #!authorship
#:form #!glossary
#:level #!practitioner
#:review #!adversarial_checked
#:valence #!boon
#:era #!contemporary

^"emit"{
 ~#title: "Genre Conventions"
 ~#claim: "LitRPG took its name in Russia, cultivation fiction came from Chinese xianxia, and each genre here is a promise readers hold the author to."
 ~#proof: "Origins cite the record of the LitRPG term, scholarship on wuxia and Chinese internet literature, and the publication history of named works."
 ~#door: "Follow the serial pipeline term into the platforms matrix, then the Kindle Unlimited case."
 ~#audience: "authors, readers, and critics of genre fiction"
 continuity: "Genre Conventions | promise readers"
 cold_open: "Each genre is a promise readers hold the author to, and each began somewhere."
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5"
 lineage: #[ ".spw/caches/indie-author-ecosystem/genre-conventions-and-cultural-trends.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "LitRPG is credited to Russian web fiction and publishing, where the term was coined in 2013, with Japanese, Taiwanese, and Korean parallels",
  "cultivation fiction is credited to Chinese xianxia and web fiction, not to a Western synthesis of Eastern sources",
  "the claim that New York editors were alienated from games is dropped as a stereotype without evidence",
  "cozy fantasy is described as older than Legends and Lattes, which brought it wide attention",
  "the Russian precursor is one 2012 web novel on samizdat.ru, not several; the Taiwanese and Korean parallels are named",
  "fact check 2026-10-02: Cradle ran from Unsouled in 2016 through Waybound in 2023, with Threshold in 2025, not 2016 to 2023 for the whole series",
  "fact check 2026-10-02: romantasy is no longer narrowed to secondary-world fantasy; the source says only romance combined with fantasy"
 ]
}

^["edges"]{
 feeds: [ ~"./platforms-and-business-models.spw#authorship_platforms" ]
 see: [ ~"./readers-and-marketing.spw#authorship_marketing" ]
}

^["concepts"]{
 primary: [ #reader_promise, #serialization ]
 transfers: [ #exclusivity ]
 tensions: [ #trope_packaging ]
}

^["lattice"]{
 ^["game_systems"]{
  #>authorship_genres_gamelit
  ^["gamelit"]{
   gloss: "fiction set in or shaped by games, whether or not the rules show on the page"
   narrower: [ ~"./genre-conventions.spw#authorship_genres_litrpg" ]
  }
  #>authorship_genres_litrpg
  ^["litrpg"]{
   #:claim #!settled
   statement: "The term LitRPG was coined in Russia in late 2013 for an EKSMO book series, after a 2012 Russian web novel had set its story inside a game world."
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_wiki_litrpg"
   gloss: "game-world fiction with visible rules: levels, stats, skills, and loot the reader can audit"
   credit: "Vasily Mahanenko, Dmitry Malkin, and Alex Bobl for the term; Dem Mikhailov for the 2012 web novel on samizdat.ru"
   broader: [ ~"./genre-conventions.spw#authorship_genres_gamelit" ]
   related: [ ~"./genre-conventions.spw#authorship_genres_progression" ]
  }
  #>authorship_genres_litrpg_parallels
  ^["parallels"]{
   #:claim #!settled
   statement: "Game-world fiction has parallel roots in Sword Art Online in Japan, Half Prince in Taiwan, The Legendary Moonlight Sculptor in Korea, and English precursors such as Quag Keep and Dream Park."
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_wiki_litrpg"
   dates: "Quag Keep 1978; Dream Park 1981; Half Prince from 2004; Sword Art Online 2009"
   credit: "Andre Norton; Larry Niven and Steven Barnes; Yu Wo; Reki Kawahara"
  }
 }
 ^["advancement"]{
  #>authorship_genres_wuxia
  ^["wuxia"]{
   #:claim #!settled
   statement: "Wuxia, Chinese martial-arts fiction, became a mass modern genre in print, and Hamm studies Jin Yong as its central twentieth-century author."
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_hamm_2005"
   narrower: [ ~"./genre-conventions.spw#authorship_genres_cultivation" ]
  }
  #>authorship_genres_cultivation
  ^["cultivation"]{
   #:claim #!settled
   statement: "Cultivation fiction comes from xianxia, a Chinese fantasy genre that grew from wuxia and draws on Daoist inner alchemy and Buddhist ideas, in which characters train toward immortality."
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_wiki_xianxia"
   first_novel: "Huanzhulouzhu, Legend of the Swordsmen of the Mountains of Shu, 1932, is widely called the first xianxia novel"
   broader: [ ~"./genre-conventions.spw#authorship_genres_wuxia" ]
   related: [ ~"./genre-conventions.spw#authorship_genres_progression" ]
  }
  #>authorship_genres_web_fiction
  ^["chinese_web_fiction"]{
   #:claim #!settled
   statement: "Chinese internet literature sites built a commercial serial system that carried xianxia to mass readerships, and fan translations later carried it abroad."
   sources: [ ~"../../registries/sources/creators-and-platforms.spw#src_creator_hockx_2015", ~"../../registries/sources/creators-and-platforms.spw#src_creator_wiki_xianxia" ]
  }
  #>authorship_genres_progression
  ^["progression"]{
   #:claim #!settled
   statement: "Progression fantasy centers measurable growth in power; Will Wight self-published Cradle from Unsouled in 2016 through Waybound in 2023, with a further volume in 2025, drawing on cultivation stages."
   sources: [ ~"../../registries/sources/creators-and-platforms.spw#src_creator_wight_cradle", ~"../../registries/sources/creators-and-platforms.spw#src_creator_wiki_wight" ]
   related: [ ~"./genre-conventions.spw#authorship_genres_cultivation", ~"./genre-conventions.spw#authorship_genres_litrpg" ]
  }
 }
 ^["comfort_and_romance"]{
  #>authorship_genres_cozy
  ^["cozy"]{
   #:claim #!settled
   statement: "Travis Baldree self-published Legends and Lattes in February 2022, and Tor Books issued a new edition that November."
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_baldree_2022"
   gloss: "low stakes, found family, small work done well; older than its best-known title"
   reading: "interpretive: the book drew wide attention to the cozy label"
  }
  #>authorship_genres_romantasy
  ^["romantasy"]{
   #:claim #!settled
   statement: "Romantasy combines fantasy with a central romance; A Court of Thorns and Roses and Fourth Wing are among the fantasy titles BookTok carried."
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_wiki_booktok"
   related: [ ~"./genre-conventions.spw#authorship_genres_promise" ]
  }
 }
 ^["reader_contract"]{
  #>authorship_genres_promise
  ^["promise"]{
   #:claim #!interpretive
   statement: "A genre label is a promise: LitRPG promises rules that hold, cultivation promises earned stages, cozy promises safety, romance promises a satisfying ending."
  }
  #>authorship_genres_tropes
  ^["trope_tagging"]{
   #:claim #!interpretive
   statement: "Trope tags in descriptions and videos let readers search by promise rather than by author, which rewards packaging that names the promise plainly."
  }
  #>authorship_genres_serial
  ^["serial_pipeline"]{
   #:claim #!settled
   statement: "A web serial later enrolled in KDP Select must leave free web platforms, because the enrolled eBook must be exclusive to the Kindle Store."
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_kdp_select"
   practice: "authors call removing the free chapters stubbing"
  }
 }
}

#>authorship_genres_feedback_q
?["Do genres with countable progress grow fastest where readers comment chapter by chapter?"]{
 #:depth #!historical ~#lens(historical layer)
 #:claim #!speculative
 ~#hypothesis: "Countable progress gives commenters something to check, so rule-heavy genres gain more from serial feedback than mood-driven ones."
 !probe{ "compare comment density on rule-heavy and mood-driven serials on one platform" =id[p_creator_genres_feedback] =kind[census] }
 ~"./genre-conventions.spw#authorship_genres_serial" ~#neighbor(nearest)
}

#>authorship_genres_stat_sheet_q
?["Is a LitRPG status screen a registry cell the reader audits?"]{
 #:depth #!stylistic ~#lens(formal structure)
 #:claim #!speculative
 ~#hypothesis: "Readers trust a status screen the way they trust a dated cell: by checking that later chapters agree with it."
 breaks: "a status screen answers to the author and may bend for story; a registry cell answers to a source"
 !probe{ "collect reader comments that flag stat inconsistencies in one serial" =id[p_creator_genres_stat_sheet] =kind[census] }
 ~"./genre-conventions.spw#authorship_genres_litrpg" ~#neighbor(nearest)
}
