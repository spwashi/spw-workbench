# Crew Safety and Culture
#
# The industry safety bulletins, fatigue and rest, and two fatal cases read from public findings, kept as a ledger of claims with sources.

#>film_crew_safety
#:layer #!pragmatics
#:domain #!film
#:form #!ledger
#:level #!practitioner
#:review #!adversarial_checked
#:valence #!honk
#:era #!contemporary

^"emit"{
 ~#title: "Crew Safety and Culture"
 ~#claim: "Film set safety rests on written bulletins, rest rules, and clear authority to stop work; the Midnight Rider and Rust deaths show what happens when those fail."
 ~#proof: "Industry Safety Bulletins 1 and 28, the OSHA and New Mexico findings, and court outcomes reported in the trade and national press."
 ~#door: "Start with the firearms bulletin, then read both case frames before the culture claims."
 ~#audience: "crew, students, and producers responsible for a set"
 cold_open: "Safety bulletins set the rules for dangerous work on set, and two fatal cases show why each line in them matters."
 continuity: "Crew Safety and Culture | safety bulletins"
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/film-production-and-industry/crew-morale-safety-and-culture.spw" ]
 ^["receipts"]{
