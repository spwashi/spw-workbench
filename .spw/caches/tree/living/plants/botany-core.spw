^["edges"]{
 grounds: [ ~"../../registries/quantities/plants-ecology-care.spw#q_eco_soil" ]
 needs: [ ~"../../physical/materials/water.spw#materials_water_hbond_network" ]
 feeds: [ ~"./horticultural-science.spw#plant_science_horticulture" ]
}

^["concepts"]{
 primary: [ #cohesion_tension, #casparian_strip, #carbon_fixation ]
 transfers: [ #gradient, #symbiosis, #hydrogen_bond ]
 tensions: [ #overclaim ]
}

^["scope"]{
 #>plant_science_botany_guard
 ^["guard"]{
  #:valence #!honk
  warning: "anatomy here is for understanding; deciding that a wild plant is safe to eat or to use as medicine needs an expert with the plant in hand"
 }
 what: "plant anatomy and physiology for study"
}

^["anatomy"]{
 #>plant_science_botany_meristems
 ^["meristems"]{
  #:claim #!settled
  statement: "Apical meristems at shoot and root tips add length and lateral cambia add girth, so a plant keeps building new organs throughout its life."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_taiz_2015"
 }
 #>plant_science_botany_casparian
 ^["casparian_strip"]{
  #:claim #!settled
  statement: "The endodermal Casparian strip is a lignin band in radial and transverse cell walls; it blocks the wall pathway, so water and ions cross a living membrane to reach the xylem."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_naseer_2012"
  ~#say(a lignin seal makes water pass through a living membrane)
  ^["limits"]{
   holds: "Arabidopsis roots, where the polymer was identified by chemistry and genetics"
   fails: "suberin lamellae laid down later on endodermal surfaces are a second, separate barrier; root anatomy varies across species"
  }
 }
 #>plant_science_botany_stomata
 ^["stomata"]{
  #:claim #!settled
  statement: "Guard cells open a stoma when blue light drives a proton pump, potassium and counter-ions enter, and water follows; abscisic acid closes it under drought."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_taiz_2015"
 }
}

^["transport"]{
 ^["water"]{
  #>plant_science_botany_cohesion_tension
  ^["cohesion_tension"]{
   #:claim #!settled
   statement: "Evaporation from leaves pulls a continuous water column up the xylem under tension; hydrogen bonding keeps the column cohesive from root to leaf."
   sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_dixon_joly_1895", ~"../../registries/sources/plants-ecology-care.spw#src_eco_taiz_2015" ]
   reads: %[eco.soil.pwp_mpa, eco.soil.fc_mpa]
   ^["limits"]{
    holds: "a continuous column with soil water above the wilting point"
    fails: "drought tension can cavitate vessels; how embolized vessels refill is still argued"
   }
  }
 }
 ^["sugar"]{
  #>plant_science_botany_pressure_flow
  ^["pressure_flow"]{
   #:claim #!settled
   statement: "Phloem sap moves by pressure flow: sugar loading at a source draws in water osmotically, and the pressure pushes sap toward sinks such as roots and fruit."
   sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_munch_1930", ~"../../registries/sources/plants-ecology-care.spw#src_eco_taiz_2015" ]
  }
 }
}

^["carbon"]{
 #>plant_science_botany_light_reactions
 ^["light_reactions"]{
  #:claim #!settled
  statement: "Two photosystems in series split water, release oxygen, and build a proton gradient that drives ATP synthesis in the thylakoid."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_taiz_2015"
 }
 #>plant_science_botany_c4_cam
 ^["c4_and_cam"]{
  #:claim #!settled
  statement: "C4 plants such as maize fix carbon first with PEP carboxylase and hand it to Rubisco in another cell; CAM plants split the same steps between night and day."
  sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_hatch_slack_1966", ~"../../registries/sources/plants-ecology-care.spw#src_eco_taiz_2015" ]
 }
 #>plant_science_botany_oxygen_share
 ^["oxygen_share"]{
  #:claim #!settled
  statement: "Land plants supply only part of the oxygen we breathe; marine phytoplankton carry out close to half of global net primary production."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_field_1998"
 }
}

^["hormones"]{
 #>plant_science_botany_auxin
 ^["polar_auxin"]{
  #:claim #!settled
  statement: "Auxin moves cell to cell in one direction through PIN efflux carriers, and that polar flow patterns apical dominance, phototropic bending, and vascular strands."
  sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_galweiler_1998", ~"../../registries/sources/plants-ecology-care.spw#src_eco_taiz_2015" ]
  split: "Galweiler and colleagues 1998 tie AtPIN1 to polar transport in vascular tissue; the roles in apical dominance and in phototropism, where other PIN proteins such as PIN3 also act, rest on the Taiz textbook synthesis"
 }
 #>plant_science_botany_hormone_set
 ^["hormone_set"]{
  #:claim #!settled
  statement: "Cytokinins drive shoot initiation, gibberellins drive stem elongation and germination, abscisic acid signals drought, and ethylene drives ripening and abscission."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_taiz_2015"
 }
}

^["systematics"]{
 #>plant_science_botany_apg
 ^["apg_iv"]{
  #:claim #!settled
  statement: "APG IV, published in 2016, orders flowering plants into clades supported by molecular phylogenies rather than by artificial keys of single traits."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_apg_2016"
  herbarium: "a voucher specimen with collector, date, place, and habitat lets a later reader check the name"
 }
}

^["symbioses"]{
 #>plant_science_botany_mycorrhiza
 ^["mycorrhiza"]{
  #:claim #!settled
  statement: "Most land plants form mycorrhizae, trading carbon to fungi whose hyphae extend the root system and return phosphorus and other nutrients."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_smith_read_2008"
 }
 #>plant_science_botany_nodules
 ^["nodules"]{
  #:claim #!settled
  statement: "Legume roots release flavonoids, rhizobia answer with Nod factors, and the nodule that forms buffers oxygen with leghemoglobin so nitrogenase can fix nitrogen."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_taiz_2015"
 }
 #>plant_science_botany_network
 ^["wood_wide_web"]{
  #:claim #!contested
  statement: "Claims that shared fungal networks move meaningful carbon and warning signals between trees, and that mother trees favor kin, outrun the few field studies behind them."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_karst_2023"
  counter: ~"../../registries/sources/plants-ecology-care.spw#src_eco_simard_1997"
  ^["limits"]{
   holds: "mycorrhizal links between trees exist and some labeled carbon crosses them"
   fails: "the size, direction, and benefit of transfer in mature forests remain unmeasured at scale"
  }
 }
}

^["try"]{
 #>plant_science_botany_try_xylem
 ^["dyed_celery"]{
  materials: [ "one celery stalk with leaves", "a clear glass", "water", "dark food coloring", "a kitchen knife" ]
  steps: << "trim the stalk base under water" ; "stand it in deeply colored water" ; "wait in a warm bright room" ; "cut a thin cross-section and find the colored dots" >>
  time: .{ n: 60, unit: "minutes" }
  safety: "use the knife on a board and cut away from your hand"
  shows: ~"./botany-core.spw#plant_science_botany_cohesion_tension"
 }
}

#>plant_science_botany_wilting_q
?["As soil dries toward the wilting point, where does the water column break first?"]{
 #:depth #!physical ~#lens(material grain)
 #:claim #!speculative
 ~#hypothesis: "Columns fail first in the widest vessels of the most exposed leaves, because wide conduits cavitate at lower tension than narrow ones."
 !probe{ "acoustic emission count on a drying potted shrub, wide and narrow conduits" =id[p_eco_botany_wilting] =kind[field] }
 $%[eco.soil.pwp_mpa, eco.soil.fc_mpa]
 ~"./botany-core.spw#plant_science_botany_cohesion_tension" ~#neighbor(nearest)
}
