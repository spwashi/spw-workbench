# Botany Core
#
# Plant anatomy and physiology as a claim ledger: tissues, water and sugar transport, carbon fixation, hormones, systematics, and symbioses, with the forest-network debate kept in view.

#>plant_science_botany
#:layer #!reference
#:domain #!plant_science
#:form #!ledger
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Botany Core"
 ~#claim: "A plant pulls water up by cohesion-tension, filters it at a lignin Casparian strip, fixes carbon by three routes, and steers growth with mobile hormones."
 ~#proof: "Physiology from Taiz and Zeiger; Casparian strip chemistry from Naseer and colleagues 2012; the network debate from Karst and colleagues 2023."
 ~#door: "Start at the root barrier, follow water up the xylem, then read the contested forest network last."
 ~#audience: "readers with high-school biology"
 continuity: "Botany Core | Casparian strip"
 cold_open: "Water enters a root through living cells, because a lignin seal called the Casparian strip closes the gaps between them."
}

