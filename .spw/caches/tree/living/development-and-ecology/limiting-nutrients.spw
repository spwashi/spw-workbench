 primary: [ #limiting_factor, #nutrient_ratio, #fortification ]
 transfers: [ #trophic_level, #feedback ]
 tensions: [ #co_limitation ]
}

^["scope"]{
 #>development_ecology_limiting_nutrients_guard
 ^["guard"]{
  #:valence #!honk
  warning: "these cases are history and policy; they give no diet, supplement, dose, or test advice for any person"
 }
 what: "ecology of nutrient limits, and the history of how public health learned about deficiency diseases"
 not_advice: "nothing here recommends a food, a supplement, an amount, or a test"
 where_to_ask: "nutrition questions for a person go to a physician or a registered dietitian"
}

^["ecology"]{
 #>development_ecology_limiting_nutrients_minimum
 ^["law_of_minimum"]{
  #:claim #!settled
  statement: "Carl Sprengel stated in 1828 that the scarcest required nutrient limits plant growth; Justus von Liebig popularized the idea, now called the law of the minimum."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_van_der_ploeg_1999"
  ~#say(the shortest stave sets the water level)
 }
 #>development_ecology_limiting_nutrients_colimit
 ^["co_limitation"]{
  #:claim #!settled
  statement: "A global analysis of fertilization experiments found nitrogen and phosphorus limitation similar in strength, and adding both together usually boosted growth more than either alone."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_elser_2007"
  ^["limits"]{
   holds: "freshwater, marine, and terrestrial experiments pooled in one meta-analysis"
   fails: "a single limiting nutrient, as the strict law of the minimum has it, describes only some of them"
  }
 }
 #>development_ecology_limiting_nutrients_redfield
 ^["redfield_ratio"]{
  #:claim #!contested
  statement: "Redfield found marine plankton carry carbon, nitrogen, and phosphorus in a near-constant atomic ratio; later surveys show the ratio shifts with latitude and nutrient supply."
  reads: %[eco.ecosystem.redfield_c_per_p, eco.ecosystem.redfield_n_per_p]
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_redfield_1958"
  counter: ~"../../registries/sources/plants-ecology-care.spw#src_eco_martiny_2013"
 }
 #>development_ecology_limiting_nutrients_lake
 ^["whole_lake"]{
  #:claim #!settled
  statement: "Schindler divided a Canadian lake with a curtain and fertilized both halves; only the half that received phosphorus bloomed with algae, which pointed policy at phosphorus."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_schindler_1974"
 }
}

^["cases"]{
 #>development_ecology_limiting_nutrients_scurvy
 ^["scurvy"]{
  #>development_ecology_limiting_nutrients_lind
  ^["lind_trial"]{
   #:claim #!settled
   statement: "James Lind gave twelve sailors with scurvy six different remedies in pairs; the pair given oranges and lemons recovered fastest, though the cause stayed unclear for over a century."
   sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_lind_1753", ~"../../registries/sources/plants-ecology-care.spw#src_eco_carpenter_1986" ]
  }
  when: "1747 trial, published 1753; navy adoption decades later"
  where: "HMS Salisbury, at sea"
  learned: "a comparison of treatments side by side is an early ancestor of the controlled trial"
 }
 #>development_ecology_limiting_nutrients_pellagra
 ^["pellagra"]{
  #>development_ecology_limiting_nutrients_goldberger
  ^["goldberger"]{
   #:claim #!settled
   statement: "Joseph Goldberger of the US Public Health Service showed that pellagra followed a poor, maize-heavy diet rather than infection; Conrad Elvehjem identified nicotinic acid as the preventive factor in 1937."
   sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_kraut_2003", ~"../../registries/sources/plants-ecology-care.spw#src_eco_bollet_1992" ]
  }
  #>development_ecology_limiting_nutrients_nixtamal
  ^["nixtamalization"]{
   #:claim #!settled
   statement: "Mesoamerican cooks cook and steep maize in alkaline water, nixtamalization, which frees its bound niacin; maize spread abroad without the method, and pellagra followed it."
   source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_katz_1974"
   origins: "nixtamalization is Indigenous Mesoamerican knowledge, still practiced in tortilla and masa making"
  }
  when: "about 1906 to the 1940s in the US South"
  where: "mill villages, orphanages, asylums, and tenant farms"
  learned: "deficiency disease also tracked poverty and crop dependence, which Bollet calls the politics of pellagra"
 }
 #>development_ecology_limiting_nutrients_iodine
 ^["iodine"]{
  #>development_ecology_limiting_nutrients_salt
  ^["iodized_salt"]{
   #:claim #!settled
   statement: "After nineteenth and early twentieth century studies tied endemic goiter to iodine-poor soils and water, Switzerland and Michigan began iodizing table salt in the 1920s."
   source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_zimmermann_2008"
  }
  when: "1920s onward"
  where: "Swiss cantons and the US Great Lakes region, then many countries"
  learned: "a population measure can reach people whose own choices could not have reached the missing element"
 }
 #>development_ecology_limiting_nutrients_folate
 ^["folate"]{
  #>development_ecology_limiting_nutrients_wills
  ^["wills_factor"]{
   #:claim #!settled
   statement: "Lucy Wills found that a yeast extract corrected a severe anemia of pregnancy among women textile workers in Bombay; the active factor was later identified as folate."
   source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_wills_1931"
  }
  #>development_ecology_limiting_nutrients_mrc
  ^["mrc_trial"]{
   #:claim #!settled
   statement: "The Medical Research Council trial of 1991 found folic acid before and early in pregnancy prevented most recurrences of neural tube defects among women with a previously affected pregnancy."
   source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_mrc_1991"
  }
  #>development_ecology_limiting_nutrients_fortify
  ^["fortification"]{
   #:claim #!settled
   statement: "The US Food and Drug Administration required folic acid in enriched grain products from 1998, and neural tube defect births fell afterward."
   sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_fda_1996", ~"../../registries/sources/plants-ecology-care.spw#src_eco_honein_2001" ]
   as_of: "rule as published in 1996; current levels and rules are set by each country, verify before citing"
  }
  when: "1931 to 1998"
  where: "Bombay, then Britain, then the United States"
  learned: "a trial in one high-risk group helped lead to a policy for a whole food supply"
 }
}

^["try"]{
 #>development_ecology_limiting_nutrients_try_jars
 ^["algae_jars"]{
  materials: [ "two clear jars", "pond or rain-barrel water", "a pinch of houseplant fertilizer", "a sunny windowsill", "labels" ]
  steps: << "fill both jars with the same water" ; "add the pinch of fertilizer to one jar only" ; "label both and set them side by side in light" ; "compare the green color each day for a week" >>
  time: .{ n: 10, unit: "minutes of setup, then a week" }
  safety: "pond water carries microbes; wear gloves or wash hands, keep the jars from children and pets, and pour the water onto soil, never into a stream or drain"
  shows: ~"./limiting-nutrients.spw#development_ecology_limiting_nutrients_lake"
 }
}

#>development_ecology_limiting_nutrients_lake_q
?["Does a lake swing between nitrogen and phosphorus limits through the year?"]{
 #:depth #!physical ~#lens(ecological zone)
 #:claim #!speculative
 ~#hypothesis: "Spring mixing should leave phosphorus scarce first, while late-summer blooms that draw down nitrogen tip the lake toward nitrogen limitation, favoring nitrogen-fixing cyanobacteria."
 !probe{ "monthly nutrient ratios and bioassays from one temperate lake across a year" =id[p_eco_nutrients_season] =kind[field] }
 $%[eco.ecosystem.redfield_n_per_p]
 ~"./limiting-nutrients.spw#development_ecology_limiting_nutrients_colimit" ~#neighbor(nearest)
}

#>development_ecology_limiting_nutrients_people_q
?["Is a deficiency epidemic a limiting-nutrient story about people?"]{
 #:depth #!historical ~#lens(historical layer)
 #:claim #!speculative
 ~#hypothesis: "Deficiency epidemics track loss of a food practice or of income more closely than the chemistry of the missing element, as pellagra followed maize without nixtamalization."
 !probe{ "set pellagra and goiter histories beside records of wages, crops, and food processing" =id[p_eco_nutrients_people] =kind[lit] }
 breaks: "a lake has no wages, markets, or cooking traditions; people get sick from scarcity that is social as well as chemical"
 ~"./limiting-nutrients.spw#development_ecology_limiting_nutrients_nixtamal" ~#neighbor(nearest)
}
