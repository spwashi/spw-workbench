# Biological Clocks
#
# A period ladder of living clocks, from tides to days to months to years, described as biology and kept free of any timing advice.

#>development_ecology_clocks
#:layer #!reference
#:domain #!development_ecology
#:form #!calendar
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone
#:season #!reflection

^"emit"{
 ~#title: "Biological Clocks"
 ~#claim: "Living things keep time with internal oscillators that run near a day, a tide, or a year, and the world outside resets them."
 ~#proof: "A three-protein clock running in a test tube from Nakajima and colleagues 2005; the period gene from Konopka and Benzer 1971; the human pacemaker period from Czeisler and colleagues 1999."
 ~#door: "Climb the ladder from tide to year, then watch a bean plant fold its leaves at night."
 ~#audience: "curious readers and biology students"
 continuity: "Biological Clocks | run near a day"
 cold_open: "Inside cells, small clocks run near a day, near a tide, or near a year, and the world keeps nudging them true."
}

