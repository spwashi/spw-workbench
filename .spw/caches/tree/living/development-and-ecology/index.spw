^["edges"]{
 see: [ ~"../../provenance/harm-register.spw#provenance_harm_register" ]
}

^["scope"]{
 #>development_ecology_index_guard
 ^["guard"]{
  #:valence #!honk
  warning: "a parallel between a person and a forest is a teaching device; it licenses no intervention on a person"
 }
 what: "a reference on development as biologists and ecologists model it"
 not_advice: "nothing here is advice on diet, sleep, light, growth, parenting, or health"
 where_to_ask: "questions about a particular child or adult belong with a pediatrician, physician, or other licensed clinician"
 harm: "the harm register lists what the quarantined raw files got wrong and who could have been hurt"
}

^["tree"]{
 foundations: ~"./ecology-foundations.spw"
 parallels: ~"./development-as-succession.spw"
 resilience: ~"./succession-and-resilience.spw"
 sensitive_periods: ~"./sensitive-periods.spw"
 clocks: ~"./biological-clocks.spw"
 limiting_nutrients: ~"./limiting-nutrients.spw"
 life_history: ~"./life-history-and-scaling.spw"
 script_forms: ~"./forms-for-scripts.spw"
}

^["bundle"]{
 ={ ~"./ecology-foundations.spw#development_ecology_foundations" }
 ={ ~"./development-as-succession.spw#development_ecology_parallels" }
 ={ ~"./succession-and-resilience.spw#development_ecology_resilience" }
 ={ ~"./sensitive-periods.spw#development_ecology_sensitive_periods" }
 ={ ~"./biological-clocks.spw#development_ecology_clocks" }
 ={ ~"./limiting-nutrients.spw#development_ecology_limiting_nutrients" }
 ={ ~"./life-history-and-scaling.spw#development_ecology_life_history" }
 ={ ~"./forms-for-scripts.spw#development_ecology_script_forms" }
}

^["ladder"]{
 rungs: << "intro: development as succession" ; "foundation: ecology foundations" ; "foundation: sensitive periods and biological clocks" ; "intro: limiting nutrients" ; "advanced: succession and resilience, life history and scaling" ; "advanced: forms for scripts" >>
 note: "the parallels leaf comes first because it shows the whole idea; the foundations make it rigorous"
}

^["facets"]{
 order: "leaves by model, then the developmental question it lights"
 rows: #[
  .{ leaf: "ecology-foundations", model: "populations to ecosystems", question: "what grows into what" },
  .{ leaf: "development-as-succession", model: "succession, phenology, metamorphosis", question: "what a stage is" },
  .{ leaf: "succession-and-resilience", model: "adaptive cycle", question: "how systems recover or flip" },
  .{ leaf: "sensitive-periods", model: "imprinting, song, vision, vernalization", question: "when experience matters most" },
  .{ leaf: "biological-clocks", model: "tidal, daily, monthly, yearly clocks", question: "how organisms keep time" },
  .{ leaf: "limiting-nutrients", model: "law of the minimum", question: "what one missing thing does" },
  .{ leaf: "life-history-and-scaling", model: "trade-offs and allometry", question: "why lives are long or short" },
  .{ leaf: "forms-for-scripts", model: "living forms as script architectures", question: "what a script can borrow" }
 ]
}

^["stance"]{
 #>development_ecology_index_reading
 ^["parallel_reading"]{
  #:claim #!interpretive
  statement: "Development is easier to see beside models that run on other timescales; this branch keeps each model in its own science and lets the comparison stay a comparison."
  ~#say(compare the forms and keep the sciences apart)
 }
}

^["gaps"]{
 predicted: #[
  "evolution as a canonical home for selection, expected beside life history and scaling",
  "ethology beyond imprinting and song, expected beside sensitive periods",
  "microbial ecology and nutrient cycling by microbes, expected beside limiting nutrients",
  "medicine, public health, and epidemiology beyond nursing, expected as a sibling branch"
 ]
}

^["doors"]{
 student: "ecology foundations, then succession and resilience"
 writer: "development as succession, then forms for scripts"
 reader_of_the_season: "biological clocks, then the horticultural calendar in the plants branch"
}
