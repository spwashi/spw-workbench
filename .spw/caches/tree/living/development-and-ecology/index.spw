# Development and Ecology
#
# Human and organismal development read beside ecological and biological models, each parallel descriptive and each naming where it breaks.

#>development_ecology_index
#:layer #!reference
#:domain #!development_ecology
#:form #!index
#:level #!intro
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Development and Ecology"
 ~#claim: "Growing up, ecological succession, plant phenology, and biological clocks share forms worth comparing, and each comparison names where it breaks."
 ~#proof: "Leaves cite primary ecology and developmental biology in the plants, ecology, and care sources registry; every parallel carries a breaks binding."
 ~#door: "New here: ecology foundations. Curious about growing up: development as succession. Interested in rhythm: biological clocks."
 ~#audience: "curious readers, students, and writers looking for living forms"
 continuity: "Development and Ecology | where it breaks"
 cold_open: "Growing up looks a little like a forest regrowing, and every comparison here says where it breaks."
}

