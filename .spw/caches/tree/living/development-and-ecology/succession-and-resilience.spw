^["edges"]{
 needs: [ ~"./ecology-foundations.spw#development_ecology_foundations" ]
 analog: [ ~"../../season/retrospective-protocol.spw#season_retrospective" ]
 see: [ ~"./development-as-succession.spw#development_ecology_parallels" ]
}

^["concepts"]{
 primary: [ #succession, #resilience, #regime_shift ]
 transfers: [ #state_machine, #new_year_reset, #plasticity ]
 tensions: [ #climax ]
}

^["scope"]{
 #>development_ecology_resilience_guard
 ^["guard"]{
  #:valence #!honk
  warning: "an ecosystem release is a model of forests and lakes; calling a crisis in a life a release phase is a metaphor, never a prescription"
 }
 what: "ecological models of change and recovery, with developmental plasticity as a biological analog"
 not_advice: "nothing here describes personal resilience, therapy, or how a person should recover from hardship"
}

^["models"]{
 #>development_ecology_resilience_mechanisms
 ^["three_mechanisms"]{
  #:claim #!settled
  statement: "Connell and Slatyer proposed three models: early species ease the way for later ones, later ones establish regardless, or early ones hold later arrivals out until they die."
  models: #[ facilitation, tolerance, inhibition ]
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_connell_slatyer_1977"
 }
 #>development_ecology_resilience_holling
 ^["two_resiliences"]{
  #:claim #!settled
  statement: "Holling separated stability, how fast a system returns to equilibrium, from resilience, how much change it absorbs before its relationships reorganize around a different state."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_holling_1973"
  ~#say(fast return is one thing, staying itself is another)
 }
 #>development_ecology_resilience_regime_shift
 ^["regime_shifts"]{
  #:claim #!settled
  statement: "Lakes, coral reefs, woodlands, and drylands can hold alternative stable states; a gradual pressure can tip them, and returning requires reversing it well past the tipping point."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_scheffer_2001"
  ^["limits"]{
   holds: "systems with strong internal feedbacks, such as turbid lakes that keep nutrients cycling"
   fails: "many systems respond smoothly, and telling a true shift from a slow trend needs long records"
  }
 }
 #>development_ecology_resilience_adaptive_cycle
 ^["adaptive_cycle"]{
  #:claim #!interpretive
  statement: "Gunderson and Holling describe four phases, exploitation, conservation, release, and reorganization, nested across scales in what they call panarchy."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_gunderson_holling_2002"
  ^["limits"]{
   holds: "as a heuristic for comparing forests, fisheries, and institutions"
   fails: "the cycle is hard to test, and many systems skip or reverse phases"
  }
 }
 #>development_ecology_resilience_fire
 ^["indigenous_fire"]{
  #:claim #!settled
  statement: "Many Indigenous nations of North America set deliberate fires to tend food, basketry plants, and game; suppressing those fires let fuels build and forests change."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_kimmerer_lake_2001"
  origins: "fire stewardship is Indigenous knowledge carried by many nations across North America and kept in living practice"
 }
 #>development_ecology_resilience_plasticity
 ^["plasticity"]{
  #:claim #!settled
  statement: "One genotype can develop into different forms in different environments, as seasonal butterfly morphs and social insect castes show."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_west_eberhard_2003"
  ^["limits"]{
   holds: "plasticity as a developmental fact"
   fails: "West-Eberhard argues plasticity often leads genetic evolution; that larger claim is debated"
  }
 }
}

^["states"]{
 #>development_ecology_resilience_exploit
 ^["exploitation"]{
  ecology: "pioneers and fast growers claim open ground"
  analog: "a broad window of developmental plasticity"
  done_when: "space and nutrients are mostly taken"
 }
 #>development_ecology_resilience_conserve
 ^["conservation"]{
  ecology: "biomass and connections accumulate; the system grows efficient and rigid"
  analog: "a settled phenotype, efficient in the environment it developed in"
  done_when: "a disturbance exceeds what the system absorbs"
 }
 #>development_ecology_resilience_release
 ^["release"]{
  ecology: "fire, storm, pest outbreak, or drought frees stored nutrients and space"
  analog: "an abrupt change in conditions that the settled form no longer fits"
  done_when: "stored capital is released and connections are broken"
 }
 #>development_ecology_resilience_reorganize
 ^["reorganization"]{
  ecology: "seed banks, survivors, and new arrivals compete for the opening"
  analog: "remaining plasticity lets a new form take hold"
  done_when: "one set of species or one regime begins to dominate"
 }
 #>development_ecology_resilience_transitions
 ^["transitions"]{
  ?match[@signal]{
   "space taken" => { next: "conservation" }
   "disturbance exceeds resilience" => { next: "release" }
   "capital freed" => { next: "reorganization" }
   "old species return" => { next: "exploitation", why: "the same regime regrows" }
   "threshold crossed" => { next: "exploitation", why: "a different regime begins, as in a lake gone turbid" }
   _ => { next: "stay", why: "no signal yet; the current state holds" }
  }
 }
}

^["try"]{
 #>development_ecology_resilience_try_patch
 ^["mowed_and_unmowed"]{
  materials: [ "four sticks and string", "a notebook", "a mowed lawn edge next to an unmowed patch you may visit" ]
  steps: << "mark a square about one arm long in each patch" ; "count how many different kinds of plant you see in each" ; "note which look like fast growers and which look established" ; "return in a month and count again" >>
  time: .{ n: 30, unit: "minutes per visit" }
  safety: "wear gloves, learn to recognize poison ivy or nettles where you live, and ask before entering private land"
  shows: ~"./succession-and-resilience.spw#development_ecology_resilience_mechanisms"
 }
}

#>development_ecology_resilience_reset_q
?["Is a year-end reset a release or a reorganization?"]{
 #:depth #!social ~#lens(production cadence)
 #:claim #!speculative
 ~#hypothesis: "Teams that keep a few owned changes through a reset behave like reorganization, while teams that clear everything behave like release and regrow the same habits."
 !probe{ "compare retrospective notes from two seasons for which habits returned unchanged" =id[p_eco_resilience_reset] =kind[census] }
 breaks: "an ecosystem release is not chosen, while a retrospective is a decision people make together"
 ~"./succession-and-resilience.spw#development_ecology_resilience_transitions" ~#neighbor(nearest)
}
