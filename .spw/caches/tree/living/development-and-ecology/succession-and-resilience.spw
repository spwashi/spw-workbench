# Succession and Resilience
#
# Succession, disturbance, release, and reorganization as a state machine after the adaptive cycle, with developmental plasticity kept as an analog.

#>development_ecology_resilience
#:layer #!reference
#:domain #!development_ecology
#:form #!state_machine
#:level #!advanced
#:review #!adversarial_checked
#:valence #!bonk

^"emit"{
 ~#title: "Succession and Resilience"
 ~#claim: "Ecosystems grow, lock in, release and reorganize; resilience is how much disturbance they absorb before they flip to another state."
 ~#proof: "Succession mechanisms from Connell and Slatyer 1977; resilience from Holling 1973; regime shifts from Scheffer and colleagues 2001; the adaptive cycle from Gunderson and Holling 2002."
 ~#door: "Walk the four states, read the transitions, then compare a mowed patch with an unmowed one."
 ~#audience: "advanced students and systems thinkers"
 continuity: "Succession and Resilience | release and reorganize"
 cold_open: "Forests grow, lock in, burn, release and reorganize, and resilience is how much shock they absorb first."
}

