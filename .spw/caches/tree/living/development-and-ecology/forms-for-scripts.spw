^["edges"]{
 extends: [ ~"../../vocabulary.spw#cut_vocabulary" ]
 feeds: [ ~"../../spw/design-research/script-architectures.spw#lang_design_script_architectures" ]
 see: [ ~"./succession-and-resilience.spw#development_ecology_resilience", ~"./biological-clocks.spw#development_ecology_clocks" ]
}

^["concepts"]{
 primary: [ #metamorphosis, #homeostasis, #symbiosis ]
 transfers: [ #state_machine, #supersession ]
 tensions: [ #false_analogy ]
}

^["scope"]{
 #>development_ecology_script_forms_guard
 ^["guard"]{
  #:valence #!honk
  warning: "every mapping below is an interpretation; it borrows a shape from biology and makes no claim about how organisms work"
 }
 what: "a design study: biological forms read as patterns for script architectures"
}

^["matrix"]{
 #>development_ecology_script_forms_cycle
 ^["cycle"]{
  #>development_ecology_script_forms_cycle_bio
  ^["living"]{
   #:claim #!settled
   statement: "Land plants alternate a spore-making diploid generation with a gamete-making haploid one, so the life cycle returns to its start through two different bodies."
   source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_taiz_2015"
   ~#(Hofmeister described the alternation of generations in the nineteenth century)
  }
  #>development_ecology_script_forms_cycle_map
  ^["mapping"]{
   #:claim #!interpretive
   architecture: "cadence schedule"
   construct: "a << a ; b >> schedule whose last step hands back to the first"
   exemplar: ~"./biological-clocks.spw#development_ecology_clocks"
   ^["breaks"]{ where: "a life cycle changes the body on each turn; a schedule repeats the same steps" }
  }
 }
 #>development_ecology_script_forms_metamorphosis
 ^["metamorphosis"]{
  #>development_ecology_script_forms_meta_bio
  ^["living"]{
   #:claim #!settled
   statement: "In moths and beetles, juvenile hormone falls before the final molts, and the next ecdysone pulse launches a pupa in which adult structures replace larval ones."
   source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_truman_riddiford_1999"
  }
  #>development_ecology_script_forms_meta_map
  ^["mapping"]{
   #:claim #!interpretive
   architecture: "protocol state machine"
   construct: "a ?match transition that moves one way only, with a reorganization state between two stable forms"
   exemplar: ~"./succession-and-resilience.spw#development_ecology_resilience_transitions"
   ^["breaks"]{ where: "metamorphosis keeps one genome through the change; a script migration may rewrite its own rules" }
  }
 }
 #>development_ecology_script_forms_succession
 ^["succession"]{
  #>development_ecology_script_forms_succ_bio
  ^["living"]{
   #:claim #!settled
   statement: "In succession, early species can ease, ignore, or block later ones, so the community that follows depends on who arrived first and what they did."
   source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_connell_slatyer_1977"
  }
  #>development_ecology_script_forms_succ_map
  ^["mapping"]{
   #:claim #!interpretive
   architecture: "supersession ledger"
   construct: "entries joined by supersedes bias edges, the old entry kept and marked superseded"
   exemplar: ~"../nursing/guideline-currency-ledger.spw#nursing_guideline_ledger"
   ^["breaks"]{ where: "a guideline is replaced by deliberate review; species replace one another by arrival and competition" }
  }
 }
 #>development_ecology_script_forms_homeostasis
 ^["homeostasis"]{
  #>development_ecology_script_forms_homeo_bio
  ^["living"]{
   #:claim #!settled
   statement: "Claude Bernard described the stable internal environment of the body, and Walter Cannon set out homeostasis, the feedback that holds blood sugar, temperature, and salts near set levels."
   sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_bernard_1865", ~"../../registries/sources/plants-ecology-care.spw#src_eco_cannon_1932" ]
   ^["limits"]{
    holds: "as the core picture of physiological regulation"
    fails: "Sterling and Eyer proposed allostasis, regulation by prediction with shifting set points, and how far it extends homeostasis is debated"
    source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_sterling_eyer_1988"
   }
  }
  #>development_ecology_script_forms_homeo_map
  ^["mapping"]{
   #:claim #!interpretive
   architecture: "probe battery and gate"
   construct: "a check that compares each surface with its contract and reports drift for a writer to correct"
   exemplar: ~"../../contract.spw#cut_contract"
   ^["breaks"]{ where: "a body corrects itself continuously; a gate fails loudly and waits for a person" }
  }
 }
 #>development_ecology_script_forms_symbiosis
 ^["symbiosis"]{
  #>development_ecology_script_forms_sym_bio
  ^["living"]{
   #:claim #!settled
   statement: "Frank named the lichen partnership Symbiotismus in 1877; de Bary gave the general definition, unlike organisms living together, and spread the term; Sagan, later Margulis, traced mitochondria and plastids to engulfed bacteria."
   sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_frank_1877", ~"../../registries/sources/plants-ecology-care.spw#src_eco_de_bary_1879", ~"../../registries/sources/plants-ecology-care.spw#src_eco_sagan_1967" ]
   ^["limits"]{
    holds: "the bacterial origin of mitochondria and plastids"
    fails: "her proposal that cilia came from spirochetes is not supported"
   }
  }
  #>development_ecology_script_forms_sym_map
  ^["mapping"]{
   #:claim #!interpretive
   architecture: "shared registry and bundle"
   construct: "quantities and sources kept once and cited by many surfaces, digests gathered by ={ } bundles"
   exemplar: ~"../../registries/quantities/plants-ecology-care.spw#registry_qty_plants_ecology_care"
   ^["breaks"]{ where: "an endosymbiont hands its genes to the host; a bundle copies digests while the source keeps its own" }
  }
 }
 columns: #[ living_form, architecture, construct, exemplar, breaks ]
}

^["candidates"]{
 #>development_ecology_script_forms_candidates
 ^["form_values"]{
  #:claim #!interpretive
  statement: "Cycle, metamorphosis, and supersession recur often enough across this cut to be proposed as form values; a proposal joins the vocabulary only when it recurs."
  values: #[ cycle, metamorphosis, supersession ]
 }
}

^["try"]{
 #>development_ecology_script_forms_try_routine
 ^["map_a_routine"]{
  materials: [ "paper and pencil", "one routine you run often, such as a weekly review or a release checklist" ]
  steps: << "write the routine as a list of steps" ; "choose the living form it most resembles" ; "rewrite it as that architecture, a schedule, a state machine, or a ledger" ; "write one line saying where the analogy breaks" >>
  time: .{ n: 20, unit: "minutes" }
  safety: "none worth naming"
  shows: ~"./forms-for-scripts.spw#development_ecology_script_forms_cycle_map"
 }
}

#>development_ecology_script_forms_missing_q
?["Which living form has no script architecture yet?"]{
 #:depth #!stylistic ~#lens(formal structure)
 #:claim #!speculative
 ~#hypothesis: "Dormancy, a state that waits on an outside signal without running, is the living form least represented, because scripts tend to model what runs."
 !probe{ "census the architectures across the cut and list living forms with no match" =id[p_eco_forms_census] =kind[census] }
 $%[file.frame_count, graph.out_degree]
 breaks: "organisms were shaped by selection without a designer; scripts are designed, so a borrowed form carries no evolutionary warrant"
 ~"./forms-for-scripts.spw#development_ecology_script_forms_candidates" ~#neighbor(nearest)
}
