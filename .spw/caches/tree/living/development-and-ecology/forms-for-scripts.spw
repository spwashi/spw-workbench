# Forms for Scripts
#
# Five living forms, cycle, metamorphosis, succession, homeostasis, and symbiosis, mapped to the script architectures this cut uses, each mapping read as interpretation with its break named.

#>development_ecology_script_forms
#:layer #!semantics
#:domain #!development_ecology
#:form #!comparison
#:level #!advanced
#:review #!adversarial_checked
#:valence #!boon

^"emit"{
 ~#title: "Forms for Scripts"
 ~#claim: "Living shapes offer patterns for scripts: cycles become schedules, metamorphosis a one-way state change, succession a supersession ledger, homeostasis a gate, and symbiosis a shared registry."
 ~#proof: "Each biological row cites its source, from Frank and de Bary on symbiosis to Cannon on homeostasis; each mapping is marked interpretive and names where it breaks."
 ~#door: "Pick the living form closest to a routine you run, then read its mapping and its break."
 ~#audience: "writers of Spw surfaces and designers of scripts"
 continuity: "Forms for Scripts | living shapes"
 cold_open: "Living shapes like cycles, metamorphosis, and symbiosis make good patterns for scripts, as long as we say where they break."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
