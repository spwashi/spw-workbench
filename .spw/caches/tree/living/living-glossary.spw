# Living Glossary
#
# The Micropaedia for the living class: seven terms nested by scale, from gene and pathway in the cell to niche and succession in a community, with the leaves that use each one.

#>living_glossary
#:layer #!reference
#:domain #!living
#:form #!glossary
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Living Glossary"
 ~#claim: "Seven terms carry most of the living class: gene and pathway in the cell, homeostasis, clock, and sensitive period in the organism, and niche and succession in the community."
 ~#proof: "Glosses follow Gerstein and colleagues on the gene, Cannon on homeostasis, Konopka and Benzer on clock genes, Knudsen on sensitive periods, Hutchinson on the niche, and Connell and Slatyer on succession."
 ~#door: "Read the term at your own scale first, then follow its see links to the neighbor at the next scale."
 ~#audience: "readers entering any living branch who want the shared words first"
 continuity: "Living Glossary | seven terms"
 cold_open: "Seven terms carry this class, from a gene inside a cell to the slow succession of a whole community."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03",
   agent: "claude-opus-5.5 fact-checker", care: #adversarial, outcome: #pass }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 shared_sources: "five glosses link sources the plants, ecology, and care package already entered, so each work lives once"
}

^["edges"]{
 see: [ ~"../language-and-mind/language-and-mind-glossary.spw#language_and_mind_glossary" ]
 grounds: [ ~"./development-and-ecology/development-as-succession.spw#development_ecology_parallels" ]
}

^["concepts"]{
 primary: [ #gene, #homeostasis, #sensitive_period ]
 transfers: [ #feedback, #oscillator ]
 tensions: [ #gene_definition ]
}

^["lattice"]{
 ^["cell"]{
  #>living_term_gene
  ^["gene"]{
   gloss: "a stretch of genome, or a union of stretches, that encodes one or more related functional products, protein or RNA"
   definition_note: "Gerstein and colleagues proposed defining a gene as a union of genomic sequences encoding a coherent set of potentially overlapping functional products"
   distinct_from: "an allele is one version of a gene; a genome is all of an organism's DNA"
   see: [ ~"./living-glossary.spw#living_term_pathway", ~"./living-glossary.spw#living_term_clock" ]
   used_in: [ ~"./cells/nucleic-acids-and-genomes.spw#cell_biology_nucleic_t2t", ~"./plants/plant-genomics.spw#plant_science_genomics" ]
   source: ~"../registries/sources/life-and-mind.spw#src_life_gerstein_2007"
  }
  #>living_term_pathway
  ^["pathway"]{
   gloss: "an ordered series of molecular steps: enzymes converting one metabolite into the next, or proteins relaying a signal from a receptor toward a response"
   example: "a growth factor activates a receptor tyrosine kinase, then Ras, then a three-kinase cascade into the nucleus"
   see: [ ~"./living-glossary.spw#living_term_gene", ~"./living-glossary.spw#living_term_homeostasis" ]
   used_in: [ ~"./cells/transport-and-signaling.spw#cell_biology_signaling_rtk", ~"./bioengineering/synthetic-and-metabolic.spw#bioengineering_synthetic_fba" ]
   source: ~"../registries/sources/life-and-mind.spw#src_life_alberts_2022"
  }
 }
 ^["organism"]{
  #>living_term_homeostasis
  ^["homeostasis"]{
   gloss: "the coordinated processes that hold an internal variable, such as body temperature or blood glucose, within a range by correcting departures from it"
   credit: "Walter Cannon named and described homeostasis, building on Claude Bernard's idea of a stable internal environment"
   distinct_from: "a clock anticipates a change before it comes; homeostasis corrects a change after it happens"
   see: [ ~"./living-glossary.spw#living_term_clock" ]
   used_in: [ ~"./development-and-ecology/forms-for-scripts.spw#development_ecology_script_forms_homeostasis" ]
   source: ~"../registries/sources/plants-ecology-care.spw#src_eco_cannon_1932"
  }
  #>living_term_clock
  ^["clock"]{
   gloss: "an internal oscillator that keeps time without outside cues and is reset by them, such as a circadian clock whose free-running period is near but not exactly one day"
   example: "mutations in one Drosophila gene, period, shortened, lengthened, or abolished the daily rhythm"
   see: [ ~"./living-glossary.spw#living_term_homeostasis", ~"./living-glossary.spw#living_term_sensitive_period" ]
   used_in: [ ~"./development-and-ecology/biological-clocks.spw#development_ecology_clocks_period_gene" ]
   source: ~"../registries/sources/plants-ecology-care.spw#src_eco_konopka_benzer_1971"
  }
  #>living_term_sensitive_period
  ^["sensitive_period"]{
   gloss: "a window in development when experience shapes a circuit unusually strongly; a critical period is the special case in which the result cannot later be reversed"
   example: "closing one eye early in life reshapes ocular dominance columns, while the same closure in adulthood has little effect"
   see: [ ~"./living-glossary.spw#living_term_clock", ~"./living-glossary.spw#living_term_succession" ]
   used_in: [ ~"./development-and-ecology/sensitive-periods.spw#development_ecology_sensitive_periods", ~"./neuroscience/systems-and-sensory-circuits.spw#neuroscience_systems_ocular" ]
   source: ~"../registries/sources/plants-ecology-care.spw#src_eco_knudsen_2004"
  }
 }
 ^["community"]{
  #>living_term_niche
  ^["niche"]{
   gloss: "the set of conditions and resources in which a species can persist, pictured by Hutchinson as a region in many dimensions; the realized niche is the smaller part it occupies once competitors are present"
   distinct_from: "a habitat is where a species lives; a niche is how it makes a living there"
   see: [ ~"./living-glossary.spw#living_term_succession" ]
   used_in: [ ~"./development-and-ecology/ecology-foundations.spw#development_ecology_foundations_niche" ]
   source: ~"../registries/sources/plants-ecology-care.spw#src_eco_hutchinson_1957"
  }
  #>living_term_succession
  ^["succession"]{
   gloss: "the sequence of change in a community at one site after disturbance or on new ground"
   mechanisms: "Connell and Slatyer separated three models: early species facilitate later ones, tolerate them, or inhibit them"
   see: [ ~"./living-glossary.spw#living_term_niche", ~"./living-glossary.spw#living_term_sensitive_period" ]
   used_in: [ ~"./development-and-ecology/succession-and-resilience.spw#development_ecology_resilience_mechanisms", ~"./development-and-ecology/development-as-succession.spw#development_ecology_parallels_climax" ]
   source: ~"../registries/sources/plants-ecology-care.spw#src_eco_connell_slatyer_1977"
  }
 }
}

#>living_glossary_clock_q
?["Is a clock a kind of homeostasis?"]{
 #:depth #!educational ~#lens(bodily rhythm)
 #:claim #!speculative
 ~#hypothesis: "Both rely on feedback, but a clock acts before a predictable change while homeostasis acts after a deviation, so organisms facing regular days should lean on clocks and organisms facing irregular shocks on correction."
 !probe{ "list physiological variables that rise before waking and variables that only respond after a disturbance, and compare how predictable their triggers are" =id[p_life_glossary_clock_or_correction] =kind[lit] }
 ~"./living-glossary.spw#living_term_clock" ~#neighbor(nearest)
}
