^["edges"]{
 needs: [ ~"./nucleic-acids-and-genomes.spw#cell_biology_nucleic", ~"./transport-and-signaling.spw#cell_biology_signaling" ]
 grounds: [ ~"../../registries/quantities/life-and-mind.spw#q_life_cells" ]
 analog: [ ~"../development-and-ecology/development-as-succession.spw#development_ecology_parallels" ]
