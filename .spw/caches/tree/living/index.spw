# Living Systems
#
# Cells, nervous systems, engineered tissue, plants, development and ecology, and nursing, under one class rule: every surface here is reference, never advice.

#>living_index
#:layer #!reference
#:domain #!living
#:form #!index
#:level #!intro
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Living Systems"
 ~#claim: "Life is studied here at six scales, from molecules in a cell to care at a bedside, and every surface in the class is reference, never advice."
 ~#proof: "Each branch index routes sourced leaves; the class rule below binds every health, nursing, and physiology surface to a scope frame of its own."
 ~#door: "Start with the glossary, then pick a branch by scale: cells, neuroscience, bioengineering, plants, development and ecology, or nursing."
 ~#audience: "curious readers and students entering the life sciences from any direction"
 continuity: "Living Systems | never advice"
 cold_open: "Six branches study life from the molecule to the bedside, and every page here is reference, never advice."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03",
   agent: "claude-opus-5.5 fact-checker", care: #adversarial, outcome: #pass }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 written_for: "the fact-check of 2026-10-02 found no surface carried the class-wide no-advice rule; this index now states it before any clinical-adjacent leaf"
}

^["edges"]{
 grounds: [ ~"../registries/quantities/life-and-mind.spw#q_life_cells" ]
 see: [ ~"../provenance/harm-register.spw#provenance_harm_register", ~"../provenance/errata-life-and-mind.spw#provenance_errata_cells_neuro" ]
}

^["concepts"]{
 primary: [ #cell, #homeostasis, #scale ]
 transfers: [ #feedback, #state_machine ]
 tensions: [ #reference_or_advice ]
}

^["scope"]{
 #>living_index_no_advice
 ^["class_rule"]{
  #:valence #!honk
  rule: "every surface under living is educational reference; none is medical, nursing, dietary, veterinary, or horticultural-safety advice for a particular person, plant, or animal"
  never: #[
   "individual doses",
   "diets or supplements",
   "treatment or remediation steps",
   "judgments about whether a person is developing, aging, or healing normally"
  ]
  health_surfaces: "a surface that touches health carries its own ^[scope] frame, names each guideline body with its version and year, and lists principal contraindications or links where they live"
  population_numbers: "population policy parameters appear only as sourced registry cells with as_of, framed as history or policy"
  harms: "known harms in the raw generation are recorded in the harm register, not repeated in leaves"
 }
 ask_instead: "for any question about a body, a child, a patient, or a garden near people, ask a qualified professional who can examine the case"
}

^["tree"]{
 glossary: ~"./living-glossary.spw"
 cells: ~"./cells/index.spw"
 neuroscience: ~"./neuroscience/index.spw"
 bioengineering: ~"./bioengineering/index.spw"
 plants: ~"./plants/index.spw"
 development_and_ecology: ~"./development-and-ecology/index.spw"
 nursing: ~"./nursing/index.spw"
}

^["bundle"]{
 ={ ~"./living-glossary.spw#living_glossary" }
 ={ ~"./cells/index.spw#cell_biology_index" }
 ={ ~"./neuroscience/index.spw#neuroscience_index" }
 ={ ~"./bioengineering/index.spw#bioengineering_index" }
 ={ ~"./plants/index.spw#plant_science_index" }
 ={ ~"./development-and-ecology/index.spw#development_ecology_index" }
 ={ ~"./nursing/index.spw#nursing_index" }
}

^["ladder"]{
 rungs: << "intro: glossary, development and ecology" ; "foundation: cells, plants, nursing" ; "advanced: neuroscience, bioengineering" >>
 ^["scales"]{
  molecule: "proteins, nucleic acids, and signals in the cells branch"
  cell_and_tissue: "transport, the cell cycle, and engineered tissue in cells and bioengineering"
  organ_and_circuit: "channels, senses, and computation in neuroscience"
  organism: "plants, development, and clocks in plants and development and ecology"
  community: "succession, niches, and resilience in development and ecology"
  care: "the knowledge map of nursing, which never replaces clinical guidance"
 }
 ^["prerequisites"]{
  cells_before_neurons: "spikes and synapses are cell biology first, so cells comes before neuroscience"
  cells_before_engineering: "gene circuits and host responses reuse cell biology, so cells comes before bioengineering"
  glossary_first: "the glossary names the seven terms every branch borrows"
 }
}

^["stance"]{
 #>living_index_cell_theory
 ^["cell_theory"]{
  #:claim #!settled
  statement: "Every organism is made of one or more cells, and every cell arises from a cell that came before it."
  source: ~"../registries/sources/life-and-mind.spw#src_life_alberts_2022"
  credit: "Matthias Schleiden and Theodor Schwann proposed cell theory in 1838 and 1839; Robert Remak and Rudolf Virchow added that cells come only from cells"
  ^["limits"]{
   holds: "for all cellular life"
   fails: "viruses replicate only inside cells and are not cells, and the first cells arose by processes the theory does not describe"
  }
 }
 #>living_index_cells_and_neurons
 ^["counts"]{
  #:claim #!settled
  statement: "An adult human body holds tens of trillions of human cells, while an adult brain holds tens of billions of neurons."
  reads: %[life.cells.human_count_e13_2016, life.brain.neurons_e9]
  sources: [ ~"../registries/sources/life-and-mind.spw#src_life_sender_2016", ~"../registries/sources/life-and-mind.spw#src_life_azevedo_2009" ]
 }
}

^["gaps"]{
 predicted: #[
  "evolution as the canonical home for selection and common descent, expected above every branch",
  "medicine, public health, and epidemiology, expected beside nursing",
  "pharmacy and dietetics, expected beside nursing and kept under the class rule",
  "agriculture and soil science, expected beside plants",
  "ethology and microbial ecology, expected as further development and ecology parallels"
 ]
}

^["doors"]{
 newcomer: "the glossary, then development and ecology"
 laboratory_student: "cells, then neuroscience or bioengineering"
 grower: "plants, then the clocks and sensitive periods in development and ecology"
 caregiver: "nursing, read as a knowledge map under the class rule above"
}

#>living_index_scope_q
?["Why does a page about cells need the same no-advice rule as a page about nursing?"]{
 #:depth #!ethical ~#lens(living system)
 #:claim #!speculative
 ~#hypothesis: "Readers carry facts across scales, so a mechanism read in a cell leaf can be taken as guidance for a body unless every leaf says plainly that it is not."
 !probe{ "list leaves in this class that name a drug, a body outcome, or a dose-like number and check that each carries a scope frame" =id[p_life_living_scope_census] =kind[census] }
 ~"./index.spw#living_index_no_advice" ~#neighbor(nearest)
}

#>living_index_scale_q
?["How many body cells stand behind each neuron?"]{
 #:depth #!mathematical ~#lens(living system)
 #:claim #!speculative
 ~#hypothesis: "Body cells far outnumber neurons, and most of the excess should be red blood cells rather than cells of solid tissue."
 !probe{ "divide the sourced human cell count by the neuron count, then repeat after removing the blood-forming lineage" =id[p_life_living_cells_per_neuron] =kind[calc] }
 $%[life.cells.human_count_e13_2016, life.brain.neurons_e9]
 ~"./index.spw#living_index_cells_and_neurons" ~#neighbor(nearest)
}
