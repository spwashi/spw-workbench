# Society Glossary
#
# The short-entry tier for the society class: market, institution, role, platform, receipt, externality, identification, and the terms they lean on, each with a home leaf.

#>society_glossary
#:layer #!reference
#:domain #!society
#:form #!glossary
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Society Glossary"
 ~#claim: "Eleven terms carry most of the society class; ten cite a registry source, each links related terms in the lattice, and nine name a home leaf."
 ~#proof: "Definitions cite North, Linton, Rochet and Tirole, Pigou, Coase, Koopmans, Manski, Ostrom, and Titmuss through the registry."
 ~#door: "Pick a term, follow its home link, and come back when the leaf uses a word you have not met."
 ~#audience: "newcomers to economics, management, and platform studies"
 continuity: "Society Glossary | home leaf"
 cold_open: "Each word here has a short meaning, a family of related words, and most have a home leaf where they do real work."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #pass }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "fact check: Pigou was credited with versions in the second degree; his second degree is pricing by quantity, and versions come from later screening work",
  "fact check: the card said every term has a source, a home, and lattice links; receipt is interpretive and unsourced, and institution and crowding out have no home leaf; pareto now links externality"
 ]
}

^["edges"]{
 grounds: [ ~"../registries/sources/economy-and-markets.spw#registry_src_economy_and_markets" ]
 see: [ ~"../record/information/knowledge-organization.spw#information_science_knowledge_org" ]
}

^["concepts"]{
 primary: [ #institution, #role, #externality, #identification ]
 transfers: [ #dated_receipt, #two_sided_market ]
 tensions: [ #pareto_efficiency ]
}

^["lattice"]{
 #>society_term_institution
 ^["institution"]{
  #:claim #!settled
  statement: "North defines institutions as the humanly devised constraints that structure political, economic, and social interaction, both formal rules and informal norms."
  source: ~"../registries/sources/economy-and-markets.spw#src_econ_north_1991"
  narrower: [ ~"./society-glossary.spw#society_term_market", ~"./society-glossary.spw#society_term_role", ~"./society-glossary.spw#society_term_commons" ]
 }
 #>society_term_market
 ^["market"]{
  #:claim #!settled
  statement: "A market is an institution where buyers and sellers meet under rules and prices form; Hayek read prices as signals that pool knowledge no single planner holds."
  source: ~"../registries/sources/economy-and-markets.spw#src_econ_hayek_1945"
  counter: ~"../registries/sources/economy-and-markets.spw#src_econ_polanyi_1944"
  broader: [ ~"./society-glossary.spw#society_term_institution" ]
  narrower: [ ~"./society-glossary.spw#society_term_platform", ~"./society-glossary.spw#society_term_price_discrimination" ]
  home: ~"./economics/micro-and-macro-core.spw#economics_core"
  counter_note: "Polanyi argued that markets are embedded in social relations and that a self-regulating market is a political project"
 }
 #>society_term_role
 ^["role"]{
  #:claim #!settled
  statement: "Linton distinguished a status, a position in a social pattern, from a role, the behavior expected of whoever occupies it."
  source: ~"../registries/sources/economy-and-markets.spw#src_econ_linton_1936"
  broader: [ ~"./society-glossary.spw#society_term_institution" ]
  home: ~"./communities/roles-lattice.spw#communities_roles_lattice"
 }
 #>society_term_platform
 ^["platform"]{
  #:claim #!settled
  statement: "Rochet and Tirole model a platform as a two-sided market: it must court two groups at once, and how it splits prices between them shapes volume, not only the total."
  source: ~"../registries/sources/economy-and-markets.spw#src_econ_rochet_tirole_2003"
  broader: [ ~"./society-glossary.spw#society_term_market" ]
  home: ~"./platforms/monetization-receipt.spw#live_platforms_monetization"
 }
 #>society_term_price_discrimination
 ^["price_discrimination"]{
  #:claim #!settled
  statement: "Pigou sorted price discrimination into three degrees: a price for each unit tuned to each buyer, prices that vary with the quantity bought, and prices set by observable group."
  source: ~"../registries/sources/economy-and-markets.spw#src_econ_pigou_1920"
  later: "later screening work, surveyed by Varian, extends the second degree to versions and quality menus that buyers sort themselves into"
  later_source: ~"../registries/sources/economy-and-markets.spw#src_econ_varian_1989"
  broader: [ ~"./society-glossary.spw#society_term_market" ]
  home: ~"./management/revenue-management.spw#management_revenue"
 }
 #>society_term_externality
 ^["externality"]{
  #:claim #!settled
  statement: "An externality is a cost or benefit an action imposes on people outside the exchange; Pigou proposed taxes to correct it, and Coase reframed it as a problem of rights and transaction costs."
  sources: [ ~"../registries/sources/economy-and-markets.spw#src_econ_pigou_1920", ~"../registries/sources/economy-and-markets.spw#src_econ_coase_1960" ]
  related: [ ~"./society-glossary.spw#society_term_commons", ~"./society-glossary.spw#society_term_pareto" ]
  home: ~"./economics/graduate-micro-theory.spw#economics_grad_micro"
 }
 #>society_term_commons
 ^["commons"]{
  #:claim #!settled
  statement: "Ostrom documented communities that govern shared pastures, forests, fisheries, and irrigation for centuries without either private title or central command."
  source: ~"../registries/sources/economy-and-markets.spw#src_econ_ostrom_1990"
  broader: [ ~"./society-glossary.spw#society_term_institution" ]
  home: ~"./communities/commons-roles.spw#communities_commons_roles"
  origins: "her cases include Swiss alpine meadows, Japanese village forests, Spanish huerta irrigation courts, and Philippine zanjera irrigation societies"
 }
 #>society_term_pareto
 ^["pareto"]{
  #:claim #!settled
  statement: "An allocation is Pareto efficient when no one can be made better off without making someone worse off; the definition is silent on how unequal the allocation is."
  source: ~"../registries/sources/economy-and-markets.spw#src_econ_mwg_1995"
  related: [ ~"./society-glossary.spw#society_term_externality" ]
  home: ~"./economics/graduate-micro-theory.spw#economics_grad_micro"
 }
 #>society_term_identification
 ^["identification"]{
  #:claim #!settled
  statement: "A parameter is identified when the assumed model and the distribution of observable data pin down a single value; Koopmans named the problem and Manski made its limits central."
  sources: [ ~"../registries/sources/economy-and-markets.spw#src_econ_koopmans_1949", ~"../registries/sources/economy-and-markets.spw#src_econ_manski_1995" ]
  related: [ ~"./society-glossary.spw#society_term_receipt" ]
  home: ~"./economics/econometrics-and-data.spw#economics_econometrics"
 }
 #>society_term_receipt
 ^["receipt"]{
  #:claim #!interpretive
  statement: "In this cut a receipt is a dated record of a changing fact: value, publisher, period, as_of, and status, kept so a reader can check it before repeating it."
  related: [ ~"./society-glossary.spw#society_term_identification", ~"./society-glossary.spw#society_term_market" ]
  home: ~"./markets/media-market-receipts.spw#markets_media_receipts"
 }
 #>society_term_crowding_out
 ^["crowding_out"]{
  #:claim #!contested
  statement: "Pricing a civic or moral act can backfire: Titmuss argued paid blood lowers supply, a daycare fine raised late pickups, and small payments cut blood donor sign-ups among women."
  sources: [ ~"../registries/sources/economy-and-markets.spw#src_econ_titmuss_1970", ~"../registries/sources/economy-and-markets.spw#src_econ_gneezy_rustichini_2000", ~"../registries/sources/economy-and-markets.spw#src_econ_mellstrom_johannesson_2008" ]
  related: [ ~"./society-glossary.spw#society_term_market" ]
  ^["limits"]{
   holds: "small payments or fines attached to acts people read as civic or moral"
   fails: "in the Swedish blood experiment, letting donors give the payment to charity removed the drop"
  }
 }
}

#>society_glossary_receipt_q
?["Is a market receipt to a number what an anchor is to a claim?"]{
 #:depth #!educational ~#lens(information flow)
 #:claim #!speculative
 ~#hypothesis: "Readers who see as_of and publisher beside a figure repeat it less often without checking than readers who see the figure alone."
 !probe{ "two versions of one market paragraph, with and without receipt fields; count unchecked repeats" =id[p_econ_glossary_receipt] =kind[field] }
 breaks: "an anchor names a place in a file that stays put; a receipt names a moment in a world that keeps moving"
 $%[graph.out_degree, particle.deixis]
 ~"./society-glossary.spw#society_term_receipt" ~#neighbor(nearest)
}

#>society_glossary_commons_q
?["Does a live platform govern a commons or rent a market?"]{
 #:depth #!social ~#lens(social fabric)
 #:claim #!speculative
 ~#hypothesis: "Chat norms on a live stream behave more like an Ostrom commons than a priced market, so moderation by regulars outlasts rules set from above."
 !probe{ "compare moderation logs of host-appointed regulars with platform-wide rule changes across several channels" =id[p_econ_glossary_commons] =kind[field] }
 breaks: "a pasture belongs to its users across generations; a platform owner can rewrite the rules overnight"
 ~"./society-glossary.spw#society_term_commons" ~#neighbor(nearest)
}
