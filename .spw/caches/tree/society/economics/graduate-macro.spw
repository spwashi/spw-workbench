^["edges"]{
 needs: [ ~"./micro-and-macro-core.spw#economics_core_is_lm", ~"./graduate-micro-theory.spw#economics_grad_micro_existence" ]
 feeds: [ ~"./graduate-econometrics.spw#economics_grad_econometrics" ]
 grounds: [ ~"../../registries/quantities/economy-and-markets.spw#q_econ_taylor" ]
 see: [ ~"../../formal/mathematics/engineering-core/differential-equations.spw#mathematics_diffeq" ]
}

^["concepts"]{
 primary: [ #rational_expectations, #steady_state, #nominal_rigidity ]
 transfers: [ #dynamic_programming, #general_equilibrium ]
 tensions: [ #representative_agent ]
}

^["reading_rule"]{
 #>economics_grad_macro_supersedes_rule
 ^["supersedes_meaning"]{
  #:claim #!interpretive
  statement: "Here a rung supersedes another when it replaced it as the default teaching model; older models stay in use as tools and policy shorthand."
  ^["limits"]{
   holds: "graduate teaching in the Anglo-American tradition since about 1970"
   fails: "policy institutions and other traditions weigh the schools differently"
  }
 }
}

^["ladder"]{
 ^["foundations"]{
  #>economics_grad_macro_rung_ramsey
  ^["ramsey_cass_koopmans"]{
   #:era #!modern
   #:claim #!settled
   statement: "Ramsey posed optimal saving as an infinite-horizon problem; Cass and Koopmans placed it in the growth model, giving an Euler equation and a transversality condition."
   sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_ramsey_1928", ~"../../registries/sources/economy-and-markets.spw#src_econ_cass_1965", ~"../../registries/sources/economy-and-markets.spw#src_econ_koopmans_1965" ]
   bellman: "the value of capital today equals the best utility now plus the discounted value of capital tomorrow"
  }
  #>economics_grad_macro_rung_is_lm
  ^["is_lm"]{
   #:era #!modern
   #:claim #!settled
   statement: "Hicks condensed Keynes into IS and LM curves in 1937, and that diagram anchored the neoclassical synthesis taught for decades."
   sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_keynes_1936", ~"../../registries/sources/economy-and-markets.spw#src_econ_hicks_1937" ]
   detail: ~"./micro-and-macro-core.spw#economics_core_is_lm"
  }
 }
 ^["expectations_revolution"]{
  #>economics_grad_macro_rung_ratex
  ^["rational_expectations"]{
   #:era #!modern
   #:claim #!settled
   statement: "Muth proposed that expectations equal the model forecast; Lucas built monetary models on it, and Sargent and Wallace showed systematic policy then has no real effect when prices are flexible."
   sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_muth_1961", ~"../../registries/sources/economy-and-markets.spw#src_econ_lucas_1972", ~"../../registries/sources/economy-and-markets.spw#src_econ_sargent_wallace_1975" ]
  }
  #>economics_grad_macro_rung_critique
  ^["lucas_critique"]{
   #:era #!modern
   #:claim #!settled
   statement: "Lucas argued that estimated relations shift when policy changes because agents reoptimize, so policy evaluation needs parameters of tastes and technology."
   source: ~"../../registries/sources/economy-and-markets.spw#src_econ_lucas_1976"
   feeds: ~"./graduate-econometrics.spw#economics_grad_econometrics"
  }
  #>economics_grad_macro_rung_time_consistency
  ^["rules_vs_discretion"]{
   #:era #!modern
   #:claim #!settled
   statement: "Kydland and Prescott showed that an optimal plan can be time inconsistent, so a policymaker able to reoptimize later does worse than one bound by a rule."
   source: ~"../../registries/sources/economy-and-markets.spw#src_econ_kydland_prescott_1977"
  }
 }
 ^["real_business_cycles"]{
  #>economics_grad_macro_rung_rbc
  ^["rbc"]{
   #:era #!contemporary
   #:claim #!settled
   statement: "Kydland and Prescott modeled fluctuations as efficient responses to productivity shocks in a calibrated growth model with flexible prices."
   source: ~"../../registries/sources/economy-and-markets.spw#src_econ_kydland_prescott_1982"
   supersedes: [ ~"./graduate-macro.spw#economics_grad_macro_rung_is_lm" ]
   ^["limits"]{
    holds: "as a method: calibrated, optimizing, general equilibrium models"
    fails: "as an account of recessions, critics point to money effects and measured productivity that moves with demand"
   }
  }
 }
 ^["new_keynesian"]{
  #>economics_grad_macro_rung_calvo
  ^["calvo_pricing"]{
   #:era #!contemporary
   #:claim #!settled
   statement: "Calvo let each firm reset its price only with a fixed probability each period, which makes the aggregate price level sticky and lets money move output."
   source: ~"../../registries/sources/economy-and-markets.spw#src_econ_calvo_1983"
  }
  #>economics_grad_macro_rung_three_equation
  ^["three_equation_model"]{
   #:era #!contemporary
   #:claim #!settled
   statement: "The textbook New Keynesian model has three parts: a dynamic IS curve, a forward-looking Phillips curve, and an interest rate rule."
   sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_clarida_gali_gertler_1999", ~"../../registries/sources/economy-and-markets.spw#src_econ_woodford_2003", ~"../../registries/sources/economy-and-markets.spw#src_econ_gali_2015" ]
   supersedes: [ ~"./graduate-macro.spw#economics_grad_macro_rung_rbc" ]
  }
  #>economics_grad_macro_rung_taylor
  ^["taylor_rule"]{
   #:era #!contemporary
   #:claim #!settled
   statement: "Taylor described US policy with a rule raising the rate one and a half times any rise in inflation and half of any rise in the output gap."
   reads: %[econ.taylor.inflation_coeff, econ.taylor.output_gap_coeff]
   source: ~"../../registries/sources/economy-and-markets.spw#src_econ_taylor_1993"
  }
  #>economics_grad_macro_rung_determinacy
  ^["taylor_principle"]{
   #:era #!contemporary
   #:claim #!settled
   statement: "In the basic model, a rule that moves the nominal rate more than one for one with inflation gives a unique stable equilibrium."
   sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_blanchard_kahn_1980", ~"../../registries/sources/economy-and-markets.spw#src_econ_bullard_mitra_2002" ]
   ^["limits"]{
    holds: "the standard model with an active rule and passive fiscal policy"
    fails: "at the zero lower bound, and under fiscal theories of the price level"
   }
  }
  #>economics_grad_macro_rung_medium_scale
  ^["medium_scale_dsge"]{
   #:era #!contemporary
   #:claim #!settled
   statement: "Christiano, Eichenbaum, and Evans added habits, wage stickiness, and adjustment costs and fit the model to VAR impulse responses; Smets and Wouters estimated a similar model with Bayesian methods."
   sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_christiano_eichenbaum_evans_2005", ~"../../registries/sources/economy-and-markets.spw#src_econ_smets_wouters_2007" ]
   method: "Christiano, Eichenbaum, and Evans minimized the distance between model and identified VAR impulse responses to a monetary policy shock"
   policy_use: "estimated medium-scale models became policy tools at central banks, as Christiano, Eichenbaum, and Trabandt review"
   policy_source: ~"../../registries/sources/economy-and-markets.spw#src_econ_christiano_eichenbaum_trabandt_2018"
  }
 }
 ^["frictions_and_heterogeneity"]{
  #>economics_grad_macro_rung_search
  ^["search_and_matching"]{
   #:era #!contemporary
   #:claim #!settled
   statement: "Diamond, then Mortensen and Pissarides, modeled unemployment as workers and vacancies meeting through a matching function, with wages set by bargaining."
   sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_diamond_1982_res", ~"../../registries/sources/economy-and-markets.spw#src_econ_mortensen_pissarides_1994" ]
   other_diamond: "Diamond's 1982 JPE paper is a different search model, about trading externalities and multiple equilibria"
   other_source: ~"../../registries/sources/economy-and-markets.spw#src_econ_diamond_1982"
  }
  #>economics_grad_macro_rung_finance
  ^["financial_frictions"]{
   #:era #!contemporary
   #:claim #!settled
   statement: "Kiyotaki and Moore tied credit to collateral values, and Bernanke, Gertler, and Gilchrist added a financial accelerator that amplifies shocks through borrower net worth."
   sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_kiyotaki_moore_1997", ~"../../registries/sources/economy-and-markets.spw#src_econ_bernanke_gertler_gilchrist_1999" ]
  }
  #>economics_grad_macro_rung_incomplete
  ^["incomplete_markets"]{
   #:era #!contemporary
   #:claim #!settled
   statement: "Huggett and Aiyagari modeled households facing uninsurable income risk and borrowing limits, so precautionary saving shapes interest rates and wealth inequality."
   sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_huggett_1993", ~"../../registries/sources/economy-and-markets.spw#src_econ_aiyagari_1994" ]
   aggregate: "Krusell and Smith found that with aggregate shocks, such economies often behave close to a representative agent"
   also: ~"../../registries/sources/economy-and-markets.spw#src_econ_krusell_smith_1998"
  }
  #>economics_grad_macro_rung_hank
  ^["hank"]{
   #:era #!current
   #:claim #!emerging
   statement: "Kaplan, Moll, and Violante found that in a heterogeneous-agent New Keynesian model, monetary policy works mostly through income and jobs rather than through direct intertemporal substitution."
   source: ~"../../registries/sources/economy-and-markets.spw#src_econ_kaplan_moll_violante_2018"
   status_note: "the mechanism holds in the model; how large it is in data is still being measured"
  }
 }
 ^["after_2008"]{
  #>economics_grad_macro_rung_dispute
  ^["model_dispute"]{
   #:era #!current
   #:claim #!contested
   statement: "Blanchard argued that DSGE models should be one class among several; Christiano, Eichenbaum, and Trabandt replied that the models already absorb financial frictions and remain the best tool."
   sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_blanchard_2018", ~"../../registries/sources/economy-and-markets.spw#src_econ_christiano_eichenbaum_trabandt_2018" ]
  }
 }
}

^["try"]{
 #>economics_grad_macro_try_taylor
 ^["taylor_rule_sheet"]{
  materials: [ "a spreadsheet", "public inflation and output gap series for one country", "the policy rate for the same quarters" ]
  steps: << "pick twenty quarters" ; "compute the rule rate from inflation and the gap with the 1993 weights" ; "plot it beside the actual policy rate" ; "mark quarters where they part and look up what happened" >>
  reads: %[econ.taylor.inflation_coeff, econ.taylor.output_gap_coeff]
  time: .{ n: 45, unit: "minutes" }
  safety: "none worth naming"
  shows: ~"./graduate-macro.spw#economics_grad_macro_rung_taylor"
 }
}

#>economics_grad_macro_crisis_q
?["Does a collateral constraint that binds only sometimes change how a crisis looks in the model?"]{
 #:depth #!mathematical ~#lens(energy budget)
 #:claim #!speculative
 ~#hypothesis: "A model solved globally with an occasionally binding borrowing limit shows larger output drops near the limit than the same model linearized around its steady state."
 !probe{ "solve one collateral model both ways and compare responses to the same shock far from and near the limit" =id[p_econ_grad_macro_crisis] =kind[sim] }
 breaks: "an energy budget is conserved; credit can be created and destroyed, which is the point of the model"
 ~"./graduate-macro.spw#economics_grad_macro_rung_finance" ~#neighbor(nearest)
}

#>economics_grad_macro_hank_q
?["Do households with little liquid wealth carry most of a rate cut into spending?"]{
 #:depth #!social ~#lens(market flow)
 #:claim #!speculative
 ~#hypothesis: "After a policy rate change, spending moves more in households with little liquid wealth than in households with ample liquid wealth."
 !probe{ "compare spending responses by liquid wealth in a public household panel around rate changes" =id[p_econ_grad_macro_hank] =kind[lit] }
 ~"./graduate-macro.spw#economics_grad_macro_rung_hank" ~#neighbor(nearest)
}
