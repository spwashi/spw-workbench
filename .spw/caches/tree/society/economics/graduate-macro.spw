# Graduate Macro
#
# Schools of macroeconomics as a dated ladder, from IS-LM through rational expectations, real business cycles, New Keynesian models, and heterogeneous-agent models, with the post-2008 dispute kept open.

#>economics_grad_macro
#:layer #!reference
#:domain #!economics
#:form #!timeline
#:level #!graduate
#:review #!adversarial_checked
#:valence #!bonk
#:era #!modern

^"emit"{
 ~#title: "Graduate Macro"
 ~#claim: "Graduate macro is a ladder of schools, each adding expectations, optimization, frictions, or heterogeneity, and each rung keeps its date and its critics."
 ~#proof: "Rungs cite Hicks, Muth, Lucas, Sargent and Wallace, Kydland and Prescott, Calvo, Taylor, Woodford, Smets and Wouters, Aiyagari, and Kaplan, Moll, and Violante."
 ~#door: "Climb the rungs in order, run the Taylor rule sheet, then read the post-2008 dispute before trusting any one model."
 ~#audience: "first-year graduate students and readers of central bank research"
 continuity: "Graduate Macro | ladder of schools"
 cold_open: "Climb a ladder of schools, from sticky prices to unequal households, and keep each rung dated and argued."
}

