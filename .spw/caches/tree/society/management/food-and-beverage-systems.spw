  ^["r6"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r7"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #pass }
  ^["r8"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 gate_note: "on 2026-10-02 the gate failed only on refs to the replication ledger and reasoning files, then unwritten; on 2026-10-03 both resolve and the gate passes"
 review_note: "raised from sourced to adversarial_checked on 2026-10-03: a second skeptic pass checked every keystone source, it found no error, and the gate passes"
 corrections: #[
  "money priming is recorded as refuted, with the failed replications and meta-analyses cited",
  "the raw advice to remove dollar signs to reduce payment pain is contested and carries an ethics tension; it is no longer a recommendation",
  "the upper-right sweet spot is contested by eye-tracking evidence that diners read menus more like a book",
  "the food cost target of 28 to 34 percent had no source and is dropped",
  "holding and cooling limits now name the FDA Food Code 2022 edition and note that a 2026 edition exists",
  "the raw dollar sign wonder asserted insula activation and a spending increase as fact; it is now a speculative probe",
  "fact check: the money priming row pinned the Many Labs 1 and Rohrer failures on Vohs 2006; those studies tested Caruso and colleagues 2013, which the row now names",
  "fact check: r3 recorded a gate pass while refs to planned cognition files did not resolve; r3 is now partial"
 ]
}

^["edges"]{
 needs: [ ~"../../language-and-mind/cognition/replication-ledger.spw#cognition_replication_ledger" ]
 contrasts: [ ~"../../language-and-mind/cognition/reasoning-and-decision.spw#cognition_reasoning" ]
 grounds: [ ~"../../registries/quantities/economy-and-markets.spw#q_econ_food" ]
 see: [ ~"./service-operations.spw#management_service_ops_poka_yoke" ]
}

^["concepts"]{
 primary: [ #menu_engineering, #critical_control_point, #replication ]
 transfers: [ #guideline_drift, #dated_receipt ]
 tensions: [ #dark_pattern, #overclaim ]
}

^["scope"]{
 frame: "educational reference on how food codes and menu methods are structured; it is not food safety instruction"
 authority: "operators follow the code their regulatory authority has adopted, which may be an older or newer edition with local amendments"
 edition: "values below come from the FDA Food Code 2022; FDA published a 2026 edition, whose change summary was dated 2026-09-17 when read"
}

^["menu"]{
 #>management_fb_menu_matrix
 ^["menu_engineering"]{
  #:claim #!settled
  statement: "Kasavana and Smith sort each item by popularity and contribution margin into stars, plowhorses, puzzles, and dogs."
  reads: %[econ.food.menu_popularity_factor]
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_kasavana_smith_1982"
  ^["axes"]{
   popularity: "an item is popular when its share of items sold reaches 70 percent of an equal share"
   margin: "contribution margin is price minus direct food cost, compared with the menu average weighted by sales"
  }
  ^["quadrants"]{
   stars: "popular and high margin"
   plowhorses: "popular and low margin"
   puzzles: "unpopular and high margin"
   dogs: "unpopular and low margin"
  }
  ^["limits"]{
   holds: "as a sorting tool for one menu period"
   fails: "it ignores labor, prep time, and cross-item effects; Pavesic proposed a cost and margin alternative"
  }
  alternative: ~"../../registries/sources/economy-and-markets.spw#src_econ_pavesic_1983"
 }
 #>management_fb_food_cost
 ^["food_cost"]{
  definition: "food cost percentage is the cost of food sold over food sales; cost of food sold is opening inventory plus purchases minus closing inventory and adjustments"
  target_note: "no benchmark range is carried; targets vary by concept and need a dated industry source"
 }
 practice: [
  "first in, first out rotation uses older stock first",
  "par levels set how much to keep on hand between deliveries",
  "a banquet event order fixes the timeline, setup, menu, allergens, and guaranteed count for one event"
 ]
}

^["safety"]{
 #>management_fb_haccp
 ^["haccp_principles"]{
  #:claim #!settled
  statement: "HACCP has seven principles: hazard analysis, critical control points, critical limits, monitoring, corrective actions, verification, and records."
  reads: %[econ.food.haccp_principles]
  sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_nacmcf_1998", ~"../../registries/sources/economy-and-markets.spw#src_econ_codex_cxc1" ]
  version: "NACMCF adopted the guidelines in August 1997; Codex General Principles of Food Hygiene were revised in 2020"
 }
 #>management_fb_haccp_origin
 ^["haccp_origin"]{
  #:claim #!settled
  statement: "HACCP grew from work by Pillsbury with NASA and Army laboratories in the 1960s to keep food for spaceflight free of pathogens."
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_ross_nazzal_2007"
 }
 #>management_fb_holding
 ^["holding_limits"]{
  #:claim #!settled
  statement: "The FDA Food Code 2022 holds cold food for safety at 5 C or below and hot food at 57 C or above."
  reads: %[econ.food.cold_hold_max_c, econ.food.hot_hold_min_c]
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_fda_food_code_2022"
  as_of: "2026-10-02; check the edition your authority adopted"
 }
 #>management_fb_cooling
 ^["cooling"]{
  #:claim #!settled
  statement: "The 2022 code cools cooked food from 57 C to 21 C within two hours and to 5 C within six hours in total."
  reads: %[econ.food.cool_stage_one_h, econ.food.cool_total_h]
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_fda_food_code_2022"
  newer: "the 2026 change summary amends the cooling methods section; the limits must be checked against the 2026 text before reuse"
  newer_source: ~"../../registries/sources/economy-and-markets.spw#src_econ_fda_food_code_2026"
 }
}

^["menu_psychology"]{
 #>management_fb_money_priming
 ^["money_priming"]{
  #:claim #!refuted
  statement: "Incidental images of money shift attitudes toward free markets and social inequality, as Caruso and colleagues reported in 2013."
  sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_klein_2014", ~"../../registries/sources/economy-and-markets.spw#src_econ_rohrer_pashler_harris_2015" ]
  counter: ~"../../registries/sources/economy-and-markets.spw#src_econ_caruso_2013"
  correction: "Many Labs 1, across dozens of sites, and Rohrer, Pashler, and Harris, in their own experiments, failed to replicate this currency prime"
  menu_link: "the raw menu advice treated a currency sign as this kind of prime; the price format row below holds the separate menu evidence"
  ^["wider_literature"]{
   finding: "a 2019 meta-analysis found no evidence of money priming in preregistered studies and strong signs of publication bias"
   source: ~"../../registries/sources/economy-and-markets.spw#src_econ_lodder_2019"
   selection: "Vadillo, Hardwicke, and Shanks argued that counting significant studies overstates money priming evidence"
   selection_source: ~"../../registries/sources/economy-and-markets.spw#src_econ_vadillo_2016"
   first_claim: "Vohs, Mead, and Goode reported in 2006 that money reminders made people more self-sufficient and less helpful"
   first_source: ~"../../registries/sources/economy-and-markets.spw#src_econ_vohs_mead_goode_2006"
   first_status: "no direct preregistered replication of the 2006 studies is cited here; the meta-analytic null covers the paradigm, not each study"
  }
  ledger: ~"../../language-and-mind/cognition/replication-ledger.spw#cognition_replication_ledger"
 }
 #>management_fb_price_format
 ^["price_format"]{
  #:claim #!contested
  statement: "One restaurant field study reported higher spending when menus showed bare numerals instead of currency signs; the evidence base is small and its mechanism is inferred."
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_yang_kimes_sessarego_2009"
  mechanism: "pain of paying is a mental accounting idea from Prelec and Loewenstein; brain imaging links prices to insula activity but does not show menus change it"
  mechanism_sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_prelec_loewenstein_1998", ~"../../registries/sources/economy-and-markets.spw#src_econ_knutson_2007" ]
  ethics: "a tactic that works by hiding the cost from the buyer is what the cognition branch calls a dark pattern"
  ledger: ~"../../language-and-mind/cognition/replication-ledger.spw#cognition_replication_ledger"
 }
 #>management_fb_sweet_spot
 ^["sweet_spot"]{
  #:claim #!contested
  statement: "The upper-right sweet spot on a two-page menu did not hold up in an eye-tracking study, where diners read menus more like a book, top left first."
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_yang_2012"
 }
}

^["try"]{
 #>management_fb_try_matrix
 ^["practice_menu"]{
  materials: [ "a spreadsheet", "six dishes with practice sales counts and costs you choose" ]
  steps: << "enter price, food cost, and units sold for each dish" ; "compute each margin and the sales-weighted average" ; "compute each share and the 70 percent cut" ; "label each dish star, plowhorse, puzzle, or dog" ; "write one change per label and the risk it carries" >>
  reads: %[econ.food.menu_popularity_factor]
  time: .{ n: 30, unit: "minutes" }
  safety: "none worth naming; the numbers are practice data, not industry benchmarks"
  shows: ~"./food-and-beverage-systems.spw#management_fb_menu_matrix"
 }
}

#>management_fb_disclosure_q
?["Does a menu price trick still work once diners are told about it?"]{
 #:depth #!ethical ~#lens(market flow)
 #:claim #!speculative
 ~#hypothesis: "If a price-format effect exists, telling diners about it at the table shrinks it."
 !probe{ "preregistered field test with three menus: currency signs, bare numerals, bare numerals plus a note explaining the format" =id[p_econ_fb_disclosure] =kind[field] }
 ~"./food-and-beverage-systems.spw#management_fb_price_format" ~#neighbor(nearest)
}

#>management_fb_gate_q
?["Is a human commit gate a critical control point for code?"]{
 #:depth #!computational ~#lens(production cadence)
 #:claim #!speculative
 ~#hypothesis: "A gate with a stated limit and a logged corrective action catches more defects than a gate with only a yes or no."
 !probe{ "classify a sample of past commit gate decisions by whether a limit and a corrective action were recorded" =id[p_econ_fb_gate] =kind[census] }
 breaks: "a food hazard can kill and cannot be rolled back; a code defect can usually be reverted"
 $%[econ.food.haccp_principles]
 ~"./food-and-beverage-systems.spw#management_fb_haccp" ~#neighbor(nearest)
}
