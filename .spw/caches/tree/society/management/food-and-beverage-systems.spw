# Food and Beverage Systems
#
# A claim ledger for the restaurant side of hospitality: menu engineering, cost control, HACCP and holding temperatures by code edition, and menu psychology graded against replication.

#>management_food_beverage
#:layer #!reference
#:domain #!management
#:form #!ledger
#:level #!foundation
#:review #!adversarial_checked
#:valence #!honk

^"emit"{
 ~#title: "Food and Beverage Systems"
 ~#claim: "Menu engineering and HACCP rest on stated methods and dated codes, while popular menu psychology ranges from contested to refuted and must carry its replication status."
 ~#proof: "Kasavana and Smith define the menu matrix; NACMCF and the FDA Food Code 2022 set HACCP and holding limits; Many Labs 1, Rohrer, and Lodder record the money priming failures."
 ~#door: "Classify a practice menu with the kit, check holding limits against the code edition, then read the replication status before using any menu trick."
 ~#audience: "hospitality students, kitchen managers, and readers of menu design advice"
 continuity: "Food and Beverage Systems | replication status"
 cold_open: "Menu math and food codes hold up, but menu tricks need their replication status read before anyone uses them."
}

