# Semiotic Charge of Role Words
#
# Dated attestations for eight role words, steward, organizer, moderator, influencer, streamer, clipper, elder, and doula, each with an interpretive reading of the social charge it carries now.

#>communities_semiotic_charge
#:layer #!reference
#:domain #!communities
#:form #!timeline
#:level #!advanced
#:review #!adversarial_checked
#:valence #!bonk
#:era #!current

^"emit"{
 ~#title: "Semiotic Charge of Role Words"
 ~#claim: "Role words keep an old core while their social charge shifts: steward still manages for someone else, and clipper still cuts an edge, now off a stream."
 ~#proof: "Dated senses from the Online Etymology Dictionary and Wiktionary, read on 2026-10-01 and 2026-10-02 and rechecked on 2026-10-03; readings of charge are marked interpretive."
 ~#door: "Read the cross-term ladder first, then pick one word and compare its oldest rung with its reading."
 ~#audience: "readers of language change, community organizers, and streamers who name their crews"
 continuity: "Semiotic Charge of Role Words | old core"
 cold_open: "Role words keep an old core while their charge shifts, so a clipper still cuts an edge, now off a live stream."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r2"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #corrected
  }
  ^["r7"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #corrected
  }
  ^["r8"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 note: "dictionary pages change without notice; each attestation is as the page read on its access date"
 corrections: [
  "fact check: doula read the modern gloss back onto the coinage and placed Raphael after it; Raphael introduced the word by 1969 for support of a new mother, and the labor sense came with Klaus and Kennell",
  "fact check: Wiktionary quotation years for moderator, streamer, and influencer sat in dated ladders as if they were first uses; they now sit apart as quotation years",
  "fact check: Gladwell 2000 was listed as a source for the advertising sense of influencer; it is now context only",
  "fact check 2026-10-03: the influencer entry named one Wiktionary quotation and glossed the sense as a paid creator; the sense quotes five sources, 2018 to 2025, and is defined by influence on an online audience, often in marketing",
  "fact check 2026-10-03: Alinsky 1971 sat in the organizer ladder as a dated rung; it is a citation year, so it now sits apart as cited usage beside Reveille for Radicals, 1946"
 ]
}

^["edges"]{
 extends: [ ~"../../language-and-mind/linguistics/historical-linguistics.spw#linguistics_historical" ]
 see: [
  ~"../../language-and-mind/linguistics/historical-linguistics.spw#linguistics_historical_semantic_change",
  ~"./roles-lattice.spw#communities_roles_lattice"
 ]
}

^["concepts"]{
 primary: [ #semantic_change, #role, #attestation ]
 transfers: [ #occupational_title ]
 tensions: [ #dictionary_lag ]
}

^["ladder"]{
 #>communities_charge_ladder
 ^["across_terms"]{
  #:claim #!settled
  statement: "Of the eight words, steward and elder reach back to Old English and streamer and clipper to around 1300, while doula from 1969 and influencer online by 2010 carry the youngest dated senses."
  rungs: <<
   "Old English: steward and elder" ;
   "late 13th century: streamer, a flag on a mast" ;
   "around 1300 to late 14th century: clipper, moderator, and elder as authority" ;
   "1660s: influencer, one who influences" ;
   "1795: organizer, one who arranges parts for action" ;
   "1969: doula, in Raphael's anthropology" ;
   "by 2000 in advertising, by 2010 online: influencer"
  >>
  quotation_years: "Wiktionary quotes 2019 for the forum moderator, 2018 to 2025 for the social-media influencer, and 2020 and 2026 for the live streamer; these are quotation years, not first attestations, and stay out of the ladder"
  sources: [
   ~"../../registries/sources/language-and-communities.spw#src_lang_etymonline",
   ~"../../registries/sources/language-and-communities.spw#src_lang_wiki_doula",
   ~"../../registries/sources/language-and-communities.spw#src_lang_wiktionary_moderator",
   ~"../../registries/sources/language-and-communities.spw#src_lang_wiktionary_influencer",
   ~"../../registries/sources/language-and-communities.spw#src_lang_wiktionary_streamer"
  ]
 }
}

^["terms"]{
 #>communities_charge_steward
 ^["steward"]{
  #:claim #!settled
  statement: "Steward names a household officer in Old English, then an overseer of workmen, an estate manager, a ship provisions officer, and by 1703 an arranger of gatherings."
  rungs: <<
   "Old English: household officer" ;
   "c. 1300: overseer of workmen" ;
   "late 14c: estate manager for an employer" ;
   "mid-15c: ship officer" ;
   "1703: arranger of meetings and dinners"
  >>
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_etymonline"
  ^["charge"]{
   #:claim #!interpretive
   reading: "every sense manages what belongs to someone else, so stewardship talk carries an absent owner; community use keeps the care and leaves the owner unnamed"
  }
 }
 #>communities_charge_organizer
 ^["organizer"]{
  #:claim #!settled
  statement: "Organizer is dated to 1795 for one who arranges parts for action and by 1864 for one skilled in arranging and taking responsibility."
  rungs: <<
   "1795: arranger of parts" ;
   "1864: one who takes responsibility"
  >>
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_etymonline"
  cited_usage: "Alinsky's Rules for Radicals, 1971, treats the organizer as a trained vocation; that is a citation year, not a first attestation, and his Reveille for Radicals, 1946, already describes neighborhood organizing work"
  cited_works: [ ~"../../registries/sources/language-and-communities.spw#src_lang_alinsky_1971", ~"../../registries/sources/language-and-communities.spw#src_lang_alinsky_1946" ]
  ^["charge"]{
   #:claim #!interpretive
   reading: "the word moved from arranging things to building power among people, and the title now draws praise or suspicion depending on who is speaking"
  }
 }
 #>communities_charge_moderator
 ^["moderator"]{
  #:claim #!settled
  statement: "Moderator names a regulator of the celestial spheres in the late 14th century, a presider over meetings and disputes from the 1560s, and in Wiktionary an enforcer of forum rules."
  rungs: <<
   "late 14c: regulator of the spheres" ;
   "1560s: arbitrator and presider"
  >>
  quoted: "the forum sense carries one Wiktionary quotation, The Atlantic, 2019-10-23, accessed 2026-10-02; a quotation year, not a first attestation"
  sources: [ ~"../../registries/sources/language-and-communities.spw#src_lang_etymonline", ~"../../registries/sources/language-and-communities.spw#src_lang_wiktionary_moderator" ]
  ^["charge"]{
   #:claim #!interpretive
   reading: "the presider stood between parties; the forum moderator acts for a host and a rulebook, so the word moved from referee toward guardian"
   guardian: ~"./crew-crosswalk.spw#communities_crosswalk_guardian"
  }
 }
 #>communities_charge_influencer
 ^["influencer"]{
  #:claim #!settled
  statement: "Influencer means one who influences from the 1660s; advertising used it for buzz-makers by 2000, and the internet sense dates by 2010."
  rungs: <<
   "1660s: one who influences" ;
   "by 2000: advertising jargon" ;
   "by 2010: internet sense"
  >>
  defined: "Wiktionary defines the social-media sense as a person who influences an online audience's consumption, lifestyle, or political preferences, often within a marketing campaign"
  quoted: [
   "Sapna Maheshwari, The New York Times, 2018-11-11, as quoted by Wiktionary",
   "Sean Stein Smith, Forbes, 2020-08-04, as quoted by Wiktionary",
   "Taylor Lorenz, The New York Times, 2020-12-11, as quoted by Wiktionary",
   "Jesus Mesa, Newsweek, 2025-07-10, as quoted by Wiktionary",
   "Angela Giuffrida, The Guardian, 2025-09-06, as quoted by Wiktionary",
   "all five read on 2026-10-03 from the revision of 2026-08-31; quotation years, not first attestations"
  ]
  sources: [ ~"../../registries/sources/language-and-communities.spw#src_lang_etymonline", ~"../../registries/sources/language-and-communities.spw#src_lang_wiktionary_influencer" ]
  context: "2000 is also the year The Tipping Point appeared; the book is context for the date, not an attestation of the word"
  context_work: ~"../../registries/sources/language-and-communities.spw#src_lang_gladwell_2000"
  ^["charge"]{
   #:claim #!interpretive
   reading: "a property anyone might have became a job title tied to sponsorship, so the label now reads as praise or as a charge of selling out"
  }
 }
 #>communities_charge_streamer
 ^["streamer"]{
  #:claim #!settled
  statement: "Streamer names a flag streaming from a mast from the late 13th century; for a person streaming to a live audience, Wiktionary quotes The New York Times in 2020 and Jacobin in 2026."
  rungs: <<
   "late 13c: flag on a mast that marks a ship" ;
   "mid-15c: general use"
  >>
  quoted: [
   "Taylor Lorenz, The New York Times, 2020-12-18, as quoted by Wiktionary",
   "Sam Kriss, Politics After Literacy, Jacobin, 2026-03-19, as quoted by Wiktionary from its 2026-04-12 revision onward",
   "both are quotation years read on 2026-10-03, not first attestations"
  ]
  sources: [ ~"../../registries/sources/language-and-communities.spw#src_lang_etymonline", ~"../../registries/sources/language-and-communities.spw#src_lang_wiktionary_streamer" ]
  ^["charge"]{
   #:claim #!interpretive
   reading: "the old streamer told distant ships who was coming; the new one tells strangers who someone is, live"
  }
 }
 #>communities_charge_clipper
 ^["clipper"]{
  #:claim #!settled
  statement: "Clipper runs from a surname around 1300 to sheep-shearer, barber, coin clipper in Henry V of 1599, and from 1823 a fast ship; neither dictionary listed a stream-highlights sense on 2026-10-01 or on recheck 2026-10-03."
  rungs: <<
   "c. 1300: surname" ;
   "late 14c: sheep-shearer" ;
   "early 15c: barber" ;
   "1599: clipper of coins, in Shakespeare's Henry V, written 1599 and printed in the 1623 Folio, as Wiktionary quotes it" ;
   "late 18c: coin clipper is the principal sense, per the Online Etymology Dictionary" ;
   "1823: fast sailing ship"
  >>
  sources: [ ~"../../registries/sources/language-and-communities.spw#src_lang_etymonline", ~"../../registries/sources/language-and-communities.spw#src_lang_wiktionary_clipper" ]
  verify: "a person who cuts highlights from live streams is common usage without a dictionary sense; recheck both dictionaries before citing one"
  ^["charge"]{
   #:claim #!interpretive
   reading: "the coin clipper shaved value off money; the stream clipper cuts an edge off a broadcast and, on this reading, can add value by carrying it to new viewers"
   carrier: ~"./crew-crosswalk.spw#communities_crosswalk_carrier"
  }
 }
 #>communities_charge_elder
 ^["elder"]{
  #:claim #!settled
  statement: "Elder comes from Old English eldra, an older person, parent, ancestor, or chief; from the late 14th century it also names one with authority in a community, at first through age."
  rungs: <<
   "Old English: older person, parent, ancestor, chief" ;
   "c. 1200: noun, elderly person" ;
   "late 14c: one with authority in a community"
  >>
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_etymonline"
  ^["charge"]{
   #:claim #!interpretive
   reading: "authority sat beside age in the word by the late Middle Ages; community roles today lean on the authority and treat age as common but not sufficient"
  }
 }
 #>communities_charge_doula
 ^["doula"]{
  #:claim #!settled
  statement: "Doula, Modern Greek for a female slave or woman servant, was Raphael's term by 1969 for a woman who supports a new mother; Klaus and Kennell extended it to labor support around 1980."
  rungs: <<
   "ancient Greek: doulē, female slave or servant-woman, feminine of doulos, slave" ;
   "Modern Greek: doula, female slave or woman servant, the form Raphael borrowed" ;
   "1969 to 1973: Raphael's term for a woman who supports a new mother, chiefly in breastfeeding" ;
   "around 1980: Klaus and Kennell extend it to continuous labor support" ;
   "1992: Doulas of North America founded to train and certify doulas"
  >>
  sources: [
   ~"../../registries/sources/language-and-communities.spw#src_lang_wiki_doula",
   ~"../../registries/sources/language-and-communities.spw#src_lang_raphael_1973",
   ~"../../registries/sources/language-and-communities.spw#src_lang_sosa_1980",
   ~"../../registries/sources/language-and-communities.spw#src_lang_etymonline"
  ]
  dictionary_date: "the Online Etymology Dictionary dates the word by 1972, a latest-by date that names no coiner"
  ^["charge"]{
   #:claim #!interpretive
   reading: "the root names bondage as well as service; the role turned it toward chosen, trained, and often paid support, yet a doula is still defined by staying beside someone, not by clinical tasks"
   role: ~"./care-roles.spw#communities_care_doula_role"
  }
 }
}

#>communities_charge_paid_q
?["Does a role word reach the dictionary after the role gets paid?"]{
 #:depth #!social ~#lens(semiotic charge)
 #:claim #!speculative
 ~#hypothesis: "Role words gain a dictionary sense after the role becomes paid work, as influencer and streamer did, so a clipper sense will follow paid clipping programs."
 !probe{ "recheck the clipper entries each year and log dated reports of platforms paying clippers" =id[p_lang_communities_clipper_sense] =kind[lookup] }
 ~"./semiotic-charge.spw#communities_charge_clipper" ~#neighbor(nearest)
}

#>communities_charge_drift_q
?["Does a role word lose its old core the way a material loses temper?"]{
 #:depth #!historical ~#lens(material grain)
 #:claim #!speculative
 ~#hypothesis: "A role word keeps its oldest core sense as long as the role keeps the same relation to an owner or host, and drifts fastest when that relation changes."
 breaks: "a metal loses temper by heat on a known curve; a word changes by use, and no single speaker controls it"
 !probe{ "for the eight words, mark each dated sense by whom the role serves and check whether core shifts line up with shifts in whom it serves" =id[p_lang_communities_core_drift] =kind[thought] }
 $%[graph.out_degree]
 ~"./semiotic-charge.spw#communities_charge_steward" ~#neighbor(nearest)
}
