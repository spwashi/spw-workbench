 corrections: [
  "the raw file listed sunflower hyperaccumulation as soil remediation for heavy metals; for lead that claim is refuted below with its evidence",
  "the raw file paired brownfield gardens with free produce for families; that pairing is an exposure risk logged in the harm register, and this surface gives no food-safety steps",
  "raw library, bench, and restroom roles are left to other branches; this dossier keeps land, trees, tools, and repair",
  "fact check: the greening claim read 29 percent as greening alone over 38 months; it is a complier-adjusted estimate for greening or cleanup over an 18-month follow-up, with intention-to-treat drops near 10 and 9 percent",
  "fact check: the design principles listed six of Ostrom's eight; recognized rights to organize and nested enterprises are restored",
  "re-gate 2026-10-03: the adjusted estimate was glossed as complier-adjusted; Branas and colleagues call it contamination-adjusted intention-to-treat, which uses random assignment to adjust for noncompliance"
 ]
}

^["scope"]{
 frame: "a dossier of roles and the institutions that sustain them"
 never: "no soil remediation, gardening, planting, or food-safety instructions"
 soil: "a question about soil contamination goes to an accredited laboratory or a public environmental or health agency"
}

^["edges"]{
 grounds: [ ~"../../registries/quantities/language-and-communities.spw#q_lang_neighborhood" ]
 see: [
  ~"../society-glossary.spw#society_term_commons",
  ~"../../provenance/harm-register.spw#provenance_harm_register",
  ~"./roles-lattice.spw#communities_role_garden_steward"
 ]
}

^["concepts"]{
 primary: [ #commons, #reciprocity, #phytoextraction ]
 transfers: [ #monitoring, #urban_heat ]
 tensions: [ #remediation_myth ]
}

^["principles"]{
 #>communities_commons_ostrom
 ^["design_principles"]{
  #:claim #!settled
  statement: "Ostrom found eight design principles in long-lived commons: clear boundaries, rules fitted to place, users who make the rules, accountable monitors, graduated sanctions, cheap conflict resolution, recognized rights to organize, and nested enterprises."
  table: "Governing the Commons, chapter 3, Table 3.1; nested enterprises apply to commons that are parts of larger systems"
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_ostrom_1990"
  origins: "her cases include Swiss alpine meadows at Torbel, village commons in Japan, the huerta irrigation courts of Spain, and zanjera irrigation societies in the Philippines"
  ^["limits"]{
   holds: "small and medium common-pool resources with stable user groups"
   fails: "open-access resources at global scale, where users cannot see or sanction each other"
  }
 }
 #>communities_commons_reciprocity
 ^["honorable_harvest"]{
  #:claim #!settled
  statement: "Robin Wall Kimmerer, a Potawatomi botanist, describes the Honorable Harvest: take only what is given, use it well, share it, and give back in reciprocity."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_kimmerer_2013"
  credit: "Indigenous teachings, written down here by a citizen of the Potawatomi Nation"
 }
}

^["dossiers"]{
 ^["garden_stewards"]{
  #>communities_commons_gardens
  ^["garden_waves"]{
   #:claim #!settled
   statement: "Lawson traces US community gardening in waves tied to crisis: vacant-lot plots in the 1890s depression, war gardens, relief gardens in the 1930s, and neighborhood gardens from the 1970s."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_lawson_2005"
   role: "a garden steward keeps the plot list, the shared tools, the water schedule, and the rules the gardeners agreed on"
  }
  #>communities_commons_sunflower
  ^["sunflower_lead"]{
   #:claim #!refuted
   statement: "Planting sunflowers removes lead from contaminated garden soil."
   correction: "Lead binds tightly in soil and few plants move much of it into their shoots; lead phytoextraction trials needed synthetic chelates such as EDTA, which can carry lead toward groundwater."
   sources: [ ~"../../registries/sources/language-and-communities.spw#src_lang_huang_1997", ~"../../registries/sources/language-and-communities.spw#src_lang_saifullah_2009" ]
   ~#say(no flower pulls lead out of a garden)
   ^["limits"]{
    holds: "lead in soil"
    fails: "other metals, and radionuclides in water, behave differently and are separate research questions"
   }
  }
  #>communities_commons_soil_testing
  ^["soil_testing"]{
   #:claim #!settled
   statement: "The EPA names laboratory analysis as the best way to test soil for lead and points to labs accredited under its National Lead Laboratory Accreditation Program."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_epa_lead_home"
   as_of: "EPA page last updated 2026-08-19, read 2026-10-02"
  }
 }
 ^["vacant_land"]{
  #>communities_commons_greening
  ^["greening_trial"]{
   #:claim #!settled
   statement: "In a Philadelphia trial randomizing vacant lots, gun assaults in neighborhoods below the poverty line fell about 29 percent near lots given either greening or trash cleanup, by a contamination-adjusted analysis over 18 months."
   intention_to_treat: "by intention to treat, the drop was about 10 percent for either treatment and about 9 percent for greening alone"
   reads: %[
    lang.neighborhood.greening_lots_count,
    lang.neighborhood.lot_gun_assault_caitt_drop_pct,
    lang.neighborhood.lot_gun_assault_itt_drop_pct,
    lang.neighborhood.greening_gun_assault_itt_drop_pct
   ]
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_branas_2018"
   design: "18 months of baseline, two months of treatment in spring 2013, and 18 months of follow-up; outcomes are police-reported gun assaults"
   ^["limits"]{
    holds: "a standard greening or cleanup kept up by contracted crews in one city, over 18 months after treatment"
    fails: "volunteer gardens, other cities, and longer horizons were not tested; the 29 percent figure uses random assignment to adjust for lots that missed their assigned treatment"
   }
  }
 }
 ^["urban_foresters"]{
  #>communities_commons_heat
  ^["redlining_heat"]{
   #:claim #!settled
   statement: "In most of the 108 US urban areas studied, neighborhoods graded hazardous on 1930s redlining maps had higher land surface temperatures than non-redlined neighborhoods."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_hoffman_2020"
   role: "an urban forester plans, plants, and keeps street trees; volunteer tree stewards water and watch them"
  }
 }
 ^["tool_librarians"]{
  #>communities_commons_tool_libraries
  ^["tool_libraries"]{
   #:claim #!settled
   statement: "Tool lending libraries date at least to Grosse Pointe, Michigan, in 1943, with a later wave in Columbus in 1976, Seattle in 1978, and Berkeley in 1979."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_wiki_tool_library"
   ^["limits"]{
    holds: "dates as an encyclopedia article gave them on 2026-10-01"
    fails: "local histories may show earlier libraries; verify before quoting a first"
   }
  }
 }
 ^["repair_volunteers"]{
  #>communities_commons_repair
  ^["repair_cafe"]{
   #:claim #!settled
   statement: "Martine Postma started the Repair Cafe in Amsterdam on 18 October 2009: free gatherings where volunteer fixers repair broken items alongside their owners."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_repaircafe_about"
  }
 }
}

#>communities_commons_monitor_q
?["Does a shared garden or tool library last longer when someone holds the keeper role?"]{
 #:depth #!social ~#lens(ecological zone)
 #:claim #!speculative
 ~#hypothesis: "Commons with a named, rotating keeper who reports to users outlast commons that rely on everyone watching, as Ostrom's monitoring principle predicts."
 !probe{ "survey closed and surviving tool libraries and gardens in one region for who kept records and how that role changed hands" =id[p_lang_communities_keeper_survival] =kind[field] }
 ~"./commons-roles.spw#communities_commons_ostrom" ~#neighbor(nearest)
}

#>communities_commons_volunteer_q
?["Would volunteer-kept lots move violence in the same direction as contractor-kept lots?"]{
 #:depth #!social ~#lens(living system)
 #:claim #!speculative
 ~#hypothesis: "Lots greened and kept by neighbors show the same direction of change as contracted greening, with more variation from lot to lot."
 !probe{ "find greening programs that used resident crews and compare their reported outcomes with the Philadelphia trial" =id[p_lang_communities_volunteer_greening] =kind[lit] }
 $%[lang.neighborhood.greening_gun_assault_itt_drop_pct]
 ~"./commons-roles.spw#communities_commons_greening" ~#neighbor(nearest)
}
