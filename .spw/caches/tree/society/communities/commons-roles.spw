# Commons Roles
#
# Role dossiers for garden stewards, urban foresters, tool librarians, and repair volunteers, under the design principles that let shared resources last, with one popular soil claim marked refuted.

#>communities_commons_roles
#:layer #!reference
#:domain #!communities
#:form #!dossier
#:level #!intro
#:review #!adversarial_checked
#:valence #!honk
#:era #!contemporary

^"emit"{
 ~#title: "Commons Roles"
 ~#claim: "Shared land and tools last when their users make and watch the rules; sunflowers do not clean lead from soil, and soil questions belong with accredited labs."
 ~#proof: "Ostrom 1990 for design principles; Huang 1997 and Saifullah 2009 against easy lead phytoextraction; EPA on lead testing; Branas 2018 and Hoffman 2020 on vacant land and heat."
 ~#door: "Read the refuted soil claim first, then the design principles, then the dossier for the commons you use."
 ~#audience: "gardeners, tool library volunteers, and neighbors who share land or equipment"
 continuity: "Commons Roles | make and watch the rules"
 cold_open: "Gardens and tool libraries last when the people who use them make and watch the rules, and no sunflower cleans lead from soil."
}

