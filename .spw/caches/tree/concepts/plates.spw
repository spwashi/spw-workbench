# Plates
#
# Six link-only plates for designers that pin anchors from distant classes side by side, each with one anonymous reading and the line where the likeness breaks.

#>concepts_plates
#:layer #!creative
#:domain #!concepts
#:form #!comparison
#:level #!intro
#:review #!spot_checked
#:valence #!boon

^"emit"{
 ~#title: "Plates"
 ~#claim: "Each plate pins anchors from several classes with one reading and a breaks line, so a designer sees a likeness and its limit pinned side by side."
 ~#proof: "Warburg pinned images from distant times to dark panels to show recurring gestures, as Gombrich and Johnson describe; every pin here resolves to a keystone sourced in its own file."
 ~#door: "Read one plate left to right, then its break, and only then its reading."
 ~#audience: "designers, illustrators, animators, and students who cluster ideas by visual affinity"
 continuity: "Plates | pinned side by side"
 cold_open: "A plate keeps distant things pinned side by side, and the break written beneath it keeps the likeness honest."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new", "persona study tree_amendments[18], designers affinity panel, references/studies/persona-synthesis.json" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the plan tagged this surface form panel, a value no other surface in the cut carries; the contract counts a facet value that never recurs as noise, so it is tagged comparison, the form of the panels it sits beside"
 ]
 rule: "a plate pins links and carries one anonymous reading and one breaks line; it makes no claim, and every fact lives in the pinned keystones"
}

^["edges"]{
 see: [ ~"../panels/affinity-atlas.spw#panel_affinity_atlas", ~"../spw/perspectives/designers.spw#spw_perspectives_designers_clusters" ]
}

^["concepts"]{
 primary: [ #affinity_plate, #false_analogy ]
 transfers: [ #computed_cluster, #composition ]
 tensions: [ #overclaim ]
}

^["plate_form"]{
 origin: "Aby Warburg pinned photographs of images from many periods to panels covered in black cloth for his unfinished Mnemosyne atlas"
 sources: [ ~"../registries/sources/provenance-and-reference.spw#src_prov_gombrich_1970", ~"../registries/sources/concepts.spw#src_concepts_johnson_2012" ]
 parts: "pins, classes, reading, breaks"
 rule: "a plate pins at least two classes, and its breaks line is required"
}

^["plates"]{
 #>concepts_plate_stripes
 ^["stripes_nobody_drew"]{
  pins: [
   ~"../living/cells/cell-cycle-and-stem-cells.spw#cell_biology_cell_cycle_turing",
   ~"../spw/contraptions/automaton-loom.spw#spw_lab_automaton_loom",
   ~"../physical/materials/fibers-and-textiles.spw#materials_fibers_jacquard"
  ]
  classes: #[ living, spw, physical ]
  ~#(a rule applied everywhere at once leaves a pattern nobody drew)
  breaks: "Turing stripes come from chemicals reacting and diffusing, an automaton figure from one table applied in lockstep, and a Jacquard pattern from cards a person punched by design"
 }
 #>concepts_plate_repeat
 ^["the_repeated_cell"]{
  pins: [
   ~"../registries/symmetries.spw#registry_sym_alhambra",
   ~"../physical/materials/materials-core.spw#materials_core_lattices",
   ~"../living/neuroscience/cognitive-and-computational.spw#neuroscience_computational_grid"
  ]
  classes: #[ registry, physical, living ]
  ~#(one cell repeated until the eye stops counting)
  breaks: "a crystal lattice is atoms in place, a grid cell lattice is where one neuron fires as an animal moves, and a tiling is a made design; one group can describe all three and explain none"
 }
 #>concepts_plate_gutter
 ^["gutter_and_cut"]{
  pins: [
   ~"../making/visual/illustration-and-visual-storytelling.spw#visual_arts_illus_mccloud",
   ~"../spw/contraptions/sign-walker.spw#spw_lab_sign_walker_line",
   ~"../making/film/film-school-sequence.spw#film_school_kuleshov"
  ]
  classes: #[ making, spw ]
  ~#(the viewer supplies what happens between two frames)
  breaks: "a comics reader sets the pace across a gutter, while a film cut runs at projection speed, so closure in comics is read and in film is watched"
  see: ~"../making/visual/illustration-and-visual-storytelling.spw#visual_arts_illus_cut_q"
 }
 #>concepts_plate_easing
 ^["easing_at_the_joint"]{
  pins: [
   ~"../making/visual/animation-principles.spw#visual_arts_anim_tangents",
   ~"../making/visual/industrial-design.spw#visual_arts_id_continuity",
   ~"../formal/mathematics/engineering-core/calculus-and-linear-algebra.spw#mathematics_calc_taylor"
  ]
  classes: #[ making, formal ]
  ~#(motion and surface both look smooth when more derivatives agree at the seam)
  breaks: "a flat tangent eases a motion in time, a G2 blend smooths a surface in space, and a Taylor polynomial approximates a function near one point; matching derivatives serves three different ends"
 }
 #>concepts_plate_threshold
 ^["smooth_input_sharp_answer"]{
  pins: [
   ~"../living/cells/transport-and-signaling.spw#cell_biology_signaling_ultrasensitive",
   ~"../language-and-mind/linguistics/phonetics-and-phonology.spw#linguistics_phonology_categorical",
   ~"../living/development-and-ecology/succession-and-resilience.spw#development_ecology_resilience_regime_shift"
  ]
  classes: #[ living, language_and_mind ]
  ~#(a graded push meets an answer with a sharp edge)
  breaks: "a kinase cascade sharpens a chemical signal, a listener learns a category boundary from a language, and a lake tips through feedback; the steepness is shared and the mechanism is not"
 }
 #>concepts_plate_mass
 ^["mass_before_detail"]{
  pins: [
   ~"../making/visual/illustration-and-visual-storytelling.spw#visual_arts_illus_notan",
   ~"../spw/perspectives/designers.spw#spw_perspectives_designers_page",
   ~"../spw/perspectives/designers.spw#spw_perspectives_designers_gestalt"
  ]
  classes: #[ making, spw ]
  ~#(massing dark and light shows the structure before any detail)
  breaks: "notan arranges value inside a picture, a surface outline here is made of indentation and glyphs, and grouping by proximity is a finding about perception, not a layout rule"
 }
}

^["reading_rule"]{
 order: << "pins" ; "breaks" ; "reading" >>
 why: "reading the break before the reading keeps a plate from turning into a claim that the pinned things are the same"
}

^["try"]{
 #>concepts_plates_try_pin
 ^["pin_your_own"]{
  materials: [ "printouts of three surfaces from different classes of this cut", "a sheet of dark paper", "pins or tape", "a pencil" ]
  steps: << "pin the three side by side" ; "write the classes beneath them" ; "write where the likeness breaks" ; "only then write the reading in one line" >>
  time: .{ n: 30, unit: "minutes" }
  safety: "pins are sharp; otherwise no hazard worth naming"
  shows: ~"./plates.spw#concepts_plate_easing"
 }
}

#>concepts_plates_sort_q
?["Do designers sort these plates by gesture where physics students sort them by mechanism?"]{
 #:depth #!stylistic ~#lens(curated collection)
 #:claim #!speculative
 ~#hypothesis: "Designers should group the plates by shared visual gesture and physics students by shared mechanism, so the two sortings should part ways on plates whose likeness is only visual."
 !probe{ "ask a few designers and a few physics students to sort printed plates into piles and name each pile, then compare the piles, never the people" =id[p_concepts_plates_sort] =kind[interview] }
 ~"./plates.spw#concepts_plate_repeat" ~#neighbor(nearest)
 breaks: "a pile is a reading of the plates, not a measure of the reader, and no sorting here ranks anyone"
}
