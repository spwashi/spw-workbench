^["edges"]{
 grounds: [ ~"../registries/quantities/spw-contraptions.spw#q_lab_dim" ]
 contrasts: [ ~"../spw/glossary/terms.spw#spw_term_dimension" ]
 see: [ ~"./symmetry.spw#concepts_symmetry" ]
}

^["concepts"]{
 primary: [ #scale_up, #universality ]
 transfers: [ #measure, #trade_off ]
 tensions: [ #overclaim ]
}

^["fed_by"]{
 tags: [ #scale_up, #universality, #measure, #polymer, #diffusion ]
 rule: "a tag feeds this hub when the concepts frames of at least two surfaces carry it"
}

^["pairings"]{
 #>concepts_scaling_pi_groups
 ^["dimensionless_groups"]{
  ^["edges"]{
   analog: [
    ~"../spw/contraptions/dimension-bench.spw#spw_lab_dimension_bench_pi",
    ~"../physical/engineering/transport-phenomena.spw#engineering_transport_reynolds",
    ~"../physical/physics/core-sequence.spw#physics_core_oscillator"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A law written in dimensionless groups holds unchanged at any size that keeps those groups equal, which is why a small model can stand in for a large machine."
  }
  breaks: "the Pi theorem counts the groups but never says which function joins them, and dimensional homogeneity is not correctness, since torque and energy share dimensions"
  reads: %[contrap.dim.si_base_count, mateng.transport.pipe_laminar_re_max]
  sources: [ ~"../registries/sources/spw-contraptions.spw#src_contrap_buckingham_1914", ~"../registries/sources/spw-contraptions.spw#src_contrap_bridgman_1922" ]
 }
 #>concepts_scaling_square_cube
 ^["square_cube"]{
  ^["edges"]{
   analog: [
    ~"../physical/chemistry/chemical-engineering.spw#chemistry_chemeng_scale_up",
    ~"../living/development-and-ecology/life-history-and-scaling.spw#development_ecology_life_history_allometry",
    ~"../living/development-and-ecology/life-history-and-scaling.spw#development_ecology_life_history_kleiber"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "As size grows, whatever crosses a surface falls behind whatever fills a volume, so a large tank cools poorly and a large animal sheds heat differently from a small one."
  }
  breaks: "the geometric two-thirds is an argument, not a measurement: fitted metabolic exponents mostly fall between about two thirds and one across taxa and activity, with some intraspecific values outside that range, and the three-quarter law is still argued"
  reads: %[eco.scaling.geometric_exp, eco.scaling.kleiber_exp]
  sources: [ ~"../registries/sources/concepts.spw#src_concepts_galileo_1638", ~"../registries/sources/plants-ecology-care.spw#src_eco_thompson_1917", ~"../registries/sources/plants-ecology-care.spw#src_eco_glazier_2005" ]
  see: ~"../living/development-and-ecology/life-history-and-scaling.spw#development_ecology_life_history_wbe"
  ~#(Galileo argued in 1638 that a giant needs disproportionately thick bones)
 }
 #>concepts_scaling_regime_exponents
 ^["regime_exponents"]{
  ^["edges"]{
   analog: [
    ~"../physical/engineering/transport-phenomena.spw#engineering_transport_pumping_power",
    ~"../physical/materials/materials-advanced.spw#materials_advanced_flory",
    ~"../physical/physics/graduate-topics.spw#physics_graduate_rg",
    ~"../language-and-mind/cognition/perception-and-attention.spw#cognition_perception_power_law"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "Each is a power law whose exponent holds across a range and changes only when the regime changes."
  }
  breaks: "pumping exponents come from friction laws inside one flow regime, Flory and critical exponents are universal numbers set by dimension and symmetry, and a sensory exponent is a fit to magnitude estimates that shifts with range and instructions"
  reads: %[
   mateng.transport.pump_power_d_exp_laminar,
   mateng.polymer.flory_nu_3d,
   life.psychophysics.stevens_brightness_exponent
  ]
  sources: [ ~"../registries/sources/concepts.spw#src_concepts_barenblatt_1996", ~"../registries/sources/physical-sciences-and-image.spw#src_phys_wilson_1971", ~"../registries/sources/concepts.spw#src_concepts_poulton_1968" ]
 }
 #>concepts_scaling_handle_units
 ^["units_in_handles"]{
  status: #proposed
  ^["edges"]{
   analog: [
    ~"../physical/physics/core-sequence.spw#physics_core_habits",
    ~"../spw/doors/cell.spw#spw_door_cell_shape",
    ~"../spw/contraptions/dimension-bench.spw#spw_lab_dimension_bench_mirror"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A unit carried with every number lets a reader check a combination before trusting it, in a derivation or in a registry cell."
  }
  breaks: "units in this cut are strings and handle suffixes, and nothing yet checks that a claim reading two cells combines them homogeneously; the dimension bench that would is a proposal, and the seed solver it would reuse takes square float systems only"
  proposal: ~"../spw/contraptions/dimension-bench.spw#spw_lab_dimension_bench_mirror"
  cites: [ "packages/spw-seed/src/math/equation.ts:71-77" ]
  source: ~"../registries/sources/spw-contraptions.spw#src_contrap_code_equation"
 }
}

^["try"]{
 #>concepts_scaling_try_cups
 ^["two_cups"]{
  materials: [ "a small cup and a large jug", "warm tap water", "a kitchen thermometer", "a timer" ]
  steps: << "fill both with the same warm tap water" ; "read both temperatures" ; "read them again every five minutes for half an hour" ; "say which cooled faster and why its surface outran its volume" >>
  time: .{ n: 40, unit: "minutes" }
  safety: "use warm tap water, not boiling water, and set the jug on a stable surface"
  shows: ~"../physical/chemistry/chemical-engineering.spw#chemistry_chemeng_scale_up"
 }
}

#>concepts_scaling_type_q
?["Is the ratio a designer uses to step type sizes a scaling law or a taste?"]{
 #:depth #!stylistic ~#lens(scale and dimension)
 #:claim #!speculative
 ~#hypothesis: "Type ladders built on a fixed ratio should look more evenly stepped than ladders built by adding a fixed amount, because perceived size tracks ratios more than fixed increments."
 !probe{ "print one geometric and one additive type ladder over the same range and ask readers which steps look even" =id[p_concepts_scaling_type_ratio] =kind[field] }
 $%[life.psychophysics.stevens_length_exponent]
 ~"./scaling-and-dimension.spw#concepts_scaling_regime_exponents" ~#neighbor(nearest)
 breaks: "a type ladder is chosen by eye and convention with no dimension to check, so a ratio there is a style before it is a law"
}
