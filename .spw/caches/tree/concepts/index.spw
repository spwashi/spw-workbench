# Concepts
#
# Seven comparison hubs and one panel of plates where physics students and designers browse the cut by what ideas share; every hub is a prompt to compare, never a claim.

#>concepts_index
#:layer #!reference
#:domain #!concepts
#:form #!index
#:level #!intro
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Concepts"
 ~#claim: "Seven hubs and a panel of plates gather keystones from every class by what they share, and each pairing names where each likeness breaks."
 ~#proof: "Every hub links keystones that other surfaces source, and every pairing carries a breaks line; nothing here restates a claim."
 ~#door: "Physics students start at conservation; designers start at the plates."
 ~#audience: "physics students, designers, and readers who cluster ideas across fields"
 continuity: "Concepts | where each likeness breaks"
 cold_open: "Browse ideas by what they share, then read where each likeness breaks before you trust it."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new", "persona study tree_amendments[18], references/studies/persona-synthesis.json" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the leaves frame gave the plates form panel; the plates now carry comparison, since a facet value that never recurs is noise"
 ]
}

^["edges"]{
 grounds: [ ~"../contract.spw#cut_contract" ]
 see: [ ~"../panels/affinity-atlas.spw#panel_affinity_atlas", ~"../panels/gap-table.spw#panel_gap_table" ]
}

^["concepts"]{
 primary: [ #invariant, #affinity_plate ]
 transfers: [ #computed_cluster ]
 tensions: [ #false_analogy ]
}

^["tree"]{
 conservation: ~"./conservation.spw"
 symmetry: ~"./symmetry.spw"
 scaling_and_dimension: ~"./scaling-and-dimension.spw"
 phase_and_transition: ~"./phase-and-transition.spw"
 order_and_schedule: ~"./order-and-schedule.spw"
 sign_and_feedback: ~"./sign-and-feedback.spw"
 gaps_and_prediction: ~"./gaps-and-prediction.spw"
 plates: ~"./plates.spw"
}

^["bundle"]{
 ={ ~"./conservation.spw#concepts_conservation" }
 ={ ~"./symmetry.spw#concepts_symmetry" }
 ={ ~"./scaling-and-dimension.spw#concepts_scaling_and_dimension" }
 ={ ~"./phase-and-transition.spw#concepts_phase_and_transition" }
 ={ ~"./order-and-schedule.spw#concepts_order_and_schedule" }
 ={ ~"./sign-and-feedback.spw#concepts_sign_and_feedback" }
 ={ ~"./gaps-and-prediction.spw#concepts_gaps_and_prediction" }
 ={ ~"./plates.spw#concepts_plates" }
}

^["leaves"]{
 hubs: .{ form: #comparison, level: #foundation }
 conservation: .{ concept: #conservation }
 symmetry: .{ concept: #symmetry }
 scaling_and_dimension: .{ concept: #scale_up }
 phase_and_transition: .{ concept: #phase_diagram }
 order_and_schedule: .{ concept: #ordering }
 sign_and_feedback: .{ concept: #feedback }
 gaps_and_prediction: .{ concept: #visible_gap }
 plates: .{ concept: #affinity_plate, form: #comparison, level: #intro }
}

^["doors"]{
 physics: "conservation first, then symmetry, which explains why some of its balances hold"
 design: "plates first, then symmetry for ornament and scaling for type and size"
 language: "gaps and prediction for the laryngeals, then order and schedule for rule order"
 production: "order and schedule for cue pages, then phase and transition for staged work"
}

^["hub_rule"]{
 #>concepts_index_rule
 ^["prompt_not_claim"]{
  #:claim #!interpretive
  statement: "A hub gathers keystones from at least two classes and pairs each analogy with a breaks line; it ranks nothing, restates nothing, and changes no claim status."
  ^["form"]{
   pairing: "an edges frame with analog links, an interpretive reading, a breaks line, and the sources the break rests on"
   fed_by: "concept tags that at least two surfaces carry in their concepts frames"
   plates: "link-only pins, one anonymous reading, and a required breaks line"
  }
 }
}

^["gaps"]{
 sector_balances: "the conservation hub found no keystone for the sector balance identity and records it as a gap"
 ornament: "the symmetry hub found no making or visual-arts surface on ornament or tiling; its design side rests on the symmetries registry"
 computed: "these hubs are authored; computed clusters wait for the panels package generator and stay prompts when they arrive"
}
