# Phase and Transition
#
# Regions of state and the crossings between them, gathered from water, critical points, ecosystems, cells, productions, children, and claim status, with the state walker limits and each break in view.

#>concepts_phase_and_transition
#:layer #!reference
#:domain #!concepts
#:form #!comparison
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bonk

^"emit"{
 ~#title: "Phase and Transition"
 ~#claim: "A phase is a region of states and a transition a crossing; water, ecosystems, cells, productions, and claims all draw such maps, but only matter has a free energy that sets the borders."
 ~#proof: "Gibbs and Landau for matter, Scheffer and Strogatz for tipping and hysteresis, Bertotti for the magnet loop, Holling and Bordwell for staged work, and the cut status machine for claims."
 ~#door: "Walk the water states with the state walker, then read where each other map breaks."
 ~#audience: "physics and chemistry students, ecologists, producers, teachers, and readers who name stages"
 continuity: "Phase and Transition | a crossing"
 cold_open: "A phase is a region you can rest in, and a transition is a crossing; each map here says what draws its borders."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new", "persona study tree_amendments[18] and [19] and metaphor_limits, references/studies/persona-synthesis.json" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the raw generation put boiling water and magnetizing iron in one universality class; the physics package refuted that, and this hub links the refutation instead of repeating the error",
  "the hysteresis pairing pinned the Ising keystone as an analog and set the magnet's equilibrium against the lake; an equilibrium Ising magnet has no loop, a real magnet's loop comes from metastable states and pinned domains, so the keystone moved to contrasts and the break says so",
  "the stage break restated Piaget's typical ages as plain fact; the cognition keystone ranks that claim contested, and the break now says so"
 ]
 rule: "a hub links keystones and names where each pairing breaks; it never treats a stage of a person as a phase of matter"
}

^["edges"]{
 grounds: [ ~"../physical/materials/bonding-and-states-of-matter.spw#materials_bonding_phase_rule" ]
 see: [ ~"./symmetry.spw#concepts_symmetry_breaking", ~"./sign-and-feedback.spw#concepts_sign_and_feedback" ]
}

^["concepts"]{
 primary: [ #phase_diagram, #state_machine ]
 transfers: [ #regime_limit, #succession ]
 tensions: [ #false_analogy, #overclaim ]
}

^["fed_by"]{
 tags: [ #phase_diagram, #state_machine, #regime_limit, #succession, #equilibrium ]
 rule: "a tag feeds this hub when the concepts frames of at least two surfaces carry it"
}

^["scope"]{
 #>concepts_phase_guard
 ^["guard"]{
  #:valence #!honk
  warning: "stages of children, forests, and productions are descriptions; none sets a standard for a particular child or a person"
 }
}

^["pairings"]{
 #>concepts_phase_water_map
 ^["water_map"]{
  ^["edges"]{
   analog: [
    ~"../physical/materials/bonding-and-states-of-matter.spw#materials_bonding_water_diagram",
    ~"../spw/contraptions/state-walker.spw#spw_lab_state_walker_critical"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "Both draw states as regions and crossings as edges, and both find that a path around the critical point joins liquid and vapour without boiling."
  }
  breaks: "the walker keeps adjacency without pressure or temperature, so it cannot apply the phase rule or say which detour a real sample takes"
  reads: %[mateng.water.triple_point_pa, mateng.water.critical_p_mpa]
  source: ~"../registries/sources/spw-contraptions.spw#src_contrap_code_graph"
  see: ~"../spw/contraptions/state-walker.spw#spw_lab_state_walker_tie"
 }
 #>concepts_phase_hysteresis
 ^["hysteresis"]{
  ^["edges"]{
   analog: [
    ~"../living/development-and-ecology/succession-and-resilience.spw#development_ecology_resilience_regime_shift",
    ~"../living/cells/cell-cycle-and-stem-cells.spw#cell_biology_cell_cycle_bistable"
   ]
   contrasts: [ ~"../physical/physics/statistical-mechanics.spw#physics_statmech_ising" ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "In each the way back differs from the way out: a tipped lake needs its pressure reversed well past the tipping point, and a cell that entered mitosis stays committed."
  }
  breaks: "the ordered Ising magnet is an equilibrium phase with a free energy and an order parameter, and in equilibrium its magnetization jumps at zero field with no loop; a real magnet's hysteresis loop comes from metastable states and pinned domains, while the lake and the mitotic switch are bifurcations of rate equations far from equilibrium, with no free energy to minimize"
  sources: [ ~"../registries/sources/concepts.spw#src_concepts_landau_1937", ~"../registries/sources/concepts.spw#src_concepts_bertotti_1998", ~"../registries/sources/concepts.spw#src_concepts_strogatz_2015", ~"../registries/sources/plants-ecology-care.spw#src_eco_scheffer_2001" ]
 }
 #>concepts_phase_universality
 ^["universality"]{
  ^["edges"]{
   analog: [
    ~"../physical/physics/graduate-topics.spw#physics_graduate_universality",
    ~"../physical/physics/statistical-mechanics.spw#physics_statmech_opalescence"
   ]
   contrasts: [ ~"../physical/physics/graduate-topics.spw#physics_graduate_raw_universality" ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "Near a critical point the microscopic details stop mattering, so very different systems share exponents when they share dimension and order-parameter symmetry."
  }
  breaks: "sharing a transition is not sharing a class: a liquid-gas point orders a scalar density and an isotropic magnet a three-component magnetization, so their exponents differ"
  reads: %[phys.critical.ising3d_nu, phys.critical.heisenberg3d_nu]
  source: ~"../registries/sources/physical-sciences-and-image.spw#src_phys_pelissetto_vicari_2002"
 }
 #>concepts_phase_staged_work
 ^["staged_work"]{
  ^["edges"]{
   analog: [
    ~"../living/development-and-ecology/succession-and-resilience.spw#development_ecology_resilience_adaptive_cycle",
    ~"../making/film/production-state-machine.spw#film_production_phases_claim"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "Each names phases with a way in and a way out, and the last phase hands back to a first one."
  }
  breaks: "a production phase ends when a document is signed, by decision, while a forest release begins with a fire or storm nobody scheduled, and the adaptive cycle is a heuristic model, not a measured law"
  sources: [ ~"../registries/sources/plants-ecology-care.spw#src_eco_gunderson_holling_2002", ~"../registries/sources/film-stage-visual.spw#src_film_bordwell_film_art_2019" ]
 }
 #>concepts_phase_claim_status
 ^["claim_status"]{
  ^["edges"]{
   analog: [
    ~"../spw/theory/epistemic-status.spw#spw_theory_status_transitions",
    ~"../spw/contraptions/state-walker.spw#spw_lab_state_walker_mirror"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A claim moves between statuses only along allowed arms, as a sample moves only between phases that touch."
  }
  breaks: "a status moves when a person files a receipt, with no control parameter, no coexistence line, and no latent heat, and canon calls the bonk valence a phase change without giving it an order parameter"
  cites: [ "docs/theory/spw/valence-architecture.spw:68-75" ]
  source: ~"../registries/sources/spw-design-studies.spw#src_lab_canon_valence"
  see: ~"../spw/theory/epistemic-status.spw#spw_theory_status_no_shortcut"
 }
 #>concepts_phase_stages
 ^["stage_or_continuity"]{
  ^["edges"]{
   analog: [
    ~"../language-and-mind/cognition/cognitive-development.spw#cognition_development_stage_ages",
    ~"../living/development-and-ecology/development-as-succession.spw#development_ecology_parallels_individualistic"
   ]
   contrasts: [ ~"../living/development-and-ecology/development-as-succession.spw#development_ecology_parallels_climax" ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A stage map cuts continuous change into named stretches so people can say where a child or a forest is."
  }
  breaks: "the cognition keystone, itself contested, reads Piaget's stage ages as typical rather than fixed, and Gleason answered Clements that plant communities are loose mixtures, so a stage is a description, not a phase whose border a free energy sets"
  sources: [ ~"../registries/sources/life-and-mind.spw#src_life_spelke_kinzler_2007", ~"../registries/sources/plants-ecology-care.spw#src_eco_gleason_1926" ]
  counter: ~"../registries/sources/life-and-mind.spw#src_life_piaget_1952"
 }
}

#>concepts_phase_status_q
?["Do claim statuses in this cut move in bursts, the way a sample crosses a border, or drift?"]{
 #:depth #!historical ~#lens(historical layer)
 #:claim #!speculative
 ~#hypothesis: "Status changes should cluster around a few receipts, such as a fact-check pass, rather than spread evenly across days."
 !probe{ "list every correction that changes a claim status, group them by the date of the receipt that made them, and see whether a few dates hold most" =id[p_concepts_phase_status_bursts] =kind[census] }
 $%[spw.cut.receipts]
 ~"./phase-and-transition.spw#concepts_phase_claim_status" ~#neighbor(nearest)
 breaks: "a burst of corrections follows when people chose to check, not when a control parameter crossed a threshold"
}

#>concepts_phase_cusp_q
?["Can a lake be walked around its tipping point the way water is walked around its critical point?"]{
 #:depth #!physical ~#lens(ecological zone)
 #:claim #!speculative
 ~#hypothesis: "If a lake model has a cusp, changing two slow pressures in the right order should move it from clear to turbid without a sudden jump."
 !probe{ "in a minimal lake phosphorus model with a cusp, loop nutrient loading and a second parameter around the cusp point and look for a jump" =id[p_concepts_phase_lake_cusp] =kind[sim] }
 $%[mateng.water.critical_t_k, mateng.water.critical_p_mpa]
 ~"./phase-and-transition.spw#concepts_phase_hysteresis" ~#neighbor(nearest)
 breaks: "the critical point of water belongs to one substance at equilibrium, while a lake cusp exists only inside a model whose second parameter may not be controllable"
}
