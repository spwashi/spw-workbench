# Sign and Feedback
#
# The sign of a loop and what it does, gathered from amplifiers, governors, gene circuits, cell cycles, film labs, monetary rules, screen direction, and Spw bias edges, with each pairing naming where it breaks.

#>concepts_sign_and_feedback
#:layer #!reference
#:domain #!concepts
#:form #!comparison
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Sign and Feedback"
 ~#claim: "The sign of a loop is the product of its link signs, so engineers, cell biologists, and film editors all count the inversions, but a sign alone never says how strong or how slow."
 ~#proof: "Maxwell, Black, and Nyquist for governed and amplified loops, Thomas and the synthetic circuits for genes, Cannon for homeostasis, and Arijon for the line across a scene."
 ~#door: "Multiply the signs of one loop by hand, then count the inversions in a film scene and read where each pairing breaks."
 ~#audience: "engineers, biologists, economists, film editors, and Spw readers of bias edges"
 continuity: "Sign and Feedback | count the inversions"
 cold_open: "To read a loop, count the inversions first, then ask how strong and how slow each link is."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new", "persona study tree_amendments[18] and metaphor_limits, references/studies/persona-synthesis.json" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the set-point break said a film lab reads its strips once a shift, far slower than the chemistry it corrects; the linked keystone is an interpretive reading that says each shift, no source gives a frequency, and the loop corrects slow drift, so the break now restates the keystone and names its status",
  "the policy wonder had control engineers reading a gain above one as a risk; high loop gain is the point of negative feedback, and the risk is unity gain at minus 180 degrees, so the hypothesis now says engineers need the phase first"
 ]
 rule: "a hub links keystones and names where each pairing breaks; the policy threshold is read from this package registry"
}

^["edges"]{
 grounds: [ ~"../spw/contraptions/sign-walker.spw#spw_lab_sign_walker_polarity" ]
 see: [ ~"./phase-and-transition.spw#concepts_phase_hysteresis", ~"./symmetry.spw#concepts_symmetry_mirror" ]
}

^["concepts"]{
 primary: [ #feedback, #homeostasis ]
 transfers: [ #oscillator, #signal_path ]
 tensions: [ #overclaim ]
}

^["fed_by"]{
 tags: [ #feedback, #homeostasis, #oscillator, #signal_path, #genetic_circuit ]
 rule: "a tag feeds this hub when the concepts frames of at least two surfaces carry it"
}

^["pairings"]{
 #>concepts_sign_loops
 ^["amplifier_and_gene"]{
  ^["edges"]{
   analog: [
    ~"../physical/engineering/control-and-signals.spw#engineering_control_signals_black",
    ~"../spw/contraptions/sign-walker.spw#spw_lab_sign_walker_circuits",
    ~"../living/cells/cell-cycle-and-stem-cells.spw#cell_biology_cell_cycle_bistable"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "Loops with an odd count of inversions hold a variable near a set point or oscillate, and loops with an even count can make switches that remember."
  }
  breaks: "Nyquist showed that stability needs gain and phase around the whole loop, and a ring of three repressors oscillates only when its links are strong and steep enough, so polarity is necessary and never sufficient"
  sources: [ ~"../registries/sources/materials-and-engineering.spw#src_mateng_nyquist_1932", ~"../registries/sources/life-and-mind.spw#src_life_elowitz_leibler_2000", ~"../registries/sources/spw-contraptions.spw#src_contrap_thomas_1981" ]
  origin: ~"../registries/sources/concepts.spw#src_concepts_maxwell_1868"
  ~#(Maxwell gave governors of steam engines a stability analysis in 1868)
 }
 #>concepts_sign_homeostasis
 ^["set_point"]{
  ^["edges"]{
   analog: [
    ~"../living/living-glossary.spw#living_term_homeostasis",
    ~"../physical/engineering/control-and-signals.spw#engineering_control_signals_pid",
    ~"../record/carriers/moving-image/photographic-processing.spw#media_carriers_processing_control_strip"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A sensor reads a variable, a comparison finds the error, and an action pushes back against it."
  }
  breaks: "Cannon described homeostasis as many regulations working together rather than one controller with one set point, and the film lab keystone, itself an interpretive reading, has control strips read each shift, a sampled loop that catches drift in the chemistry rather than acting continuously"
  sources: [ ~"../registries/sources/concepts.spw#src_concepts_cannon_1932", ~"../registries/sources/materials-and-engineering.spw#src_mateng_black_1934" ]
 }
 #>concepts_sign_policy
 ^["policy_loop"]{
  ^["edges"]{
   analog: [
    ~"../society/economics/graduate-macro.spw#economics_grad_macro_rung_determinacy",
    ~"../physical/engineering/control-and-signals.spw#engineering_control_signals_nyquist"
   ]
   see: [ ~"../physical/engineering/control-and-signals.spw#engineering_control_signals_economy_q" ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A policy rule feeds inflation back into the interest rate, and the size of that response decides whether the model settles."
  }
  breaks: "in the model a response above one picks out a unique stable path of expectations, while in a control loop a gain of one at a phase of minus 180 degrees marks the edge of instability; the same number means different things"
  reads: %[concepts.feedback.taylor_principle_min, econ.taylor.inflation_coeff]
  sources: [ ~"../registries/sources/economy-and-markets.spw#src_econ_bullard_mitra_2002", ~"../registries/sources/materials-and-engineering.spw#src_mateng_nyquist_1932" ]
 }
 #>concepts_sign_screen
 ^["screen_direction"]{
  ^["edges"]{
   analog: [
    ~"../spw/contraptions/sign-walker.spw#spw_lab_sign_walker_parity",
    ~"../making/film/film-school-sequence.spw#film_school_continuity"
   ]
   see: [ ~"../making/film/film-school-sequence.spw#film_school_cutting" ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "Each cut across the line multiplies screen direction by minus one, so an odd count of crossings flips which way the action runs."
  }
  breaks: "screen direction is a convention viewers learn, and editors cross the line on purpose through a shot on the line or a camera move across it, so the parity predicts confusion only when nothing marks the cross"
  sources: [ ~"../registries/sources/spw-contraptions.spw#src_contrap_arijon_1976", ~"../registries/sources/film-stage-visual.spw#src_film_bordwell_film_art_2019" ]
 }
 #>concepts_sign_edges
 ^["edge_sign"]{
  status: #proposed
  ^["edges"]{
   analog: [
    ~"../spw/theory/valence-and-charge.spw#spw_theory_valence_direction",
    ~"../living/cells/transport-and-signaling.spw#cell_biology_signaling_arrestin"
   ]
   see: [ ~"../spw/contraptions/sign-walker.spw#spw_lab_sign_walker_mirror" ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A bias edge can lean forward or inverse, so a loop of edges has a sign a walker could multiply, the way a pathway diagram marks activation and inhibition."
  }
  breaks: "an inverse lean is an author's reading of one relation in one context, with no strength, while arrestin blocks coupling by binding, and the valence word that marks the lean also names material quality"
  sources: [ ~"../registries/sources/spw-design-studies.spw#src_lab_canon_valence", ~"../registries/sources/spw-contraptions.spw#src_contrap_sterman_2000" ]
 }
}

#>concepts_sign_policy_q
?["Would control engineers and macroeconomists agree on whether a response of one and a half is strong?"]{
 #:depth #!social ~#lens(market flow)
 #:claim #!speculative
 ~#hypothesis: "Control engineers should call a gain above one neither safe nor risky until they know the phase, while macroeconomists read a response above one as a safeguard."
 !probe{ "ask a few readers from each field whether a rule raising the rate one and a half times any rise in inflation is aggressive, and why; report reasons, never people" =id[p_concepts_sign_two_readings] =kind[interview] }
 $%[concepts.feedback.taylor_principle_min, econ.taylor.inflation_coeff]
 ~"./sign-and-feedback.spw#concepts_sign_policy" ~#neighbor(nearest)
 breaks: "the Taylor principle concerns uniqueness of an expectations path and a loop gain concerns encirclement of minus one, so a shared number is a coincidence of scale, not a shared law"
}
