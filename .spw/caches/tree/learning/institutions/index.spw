# Institutions
#
# Universities as institutions: who governs them, how research is paid for, how degrees are built, how teaching works, and how the year moves.

#>institutions_index
#:layer #!reference
#:domain #!institutions
#:form #!index
#:level #!foundation
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Institutions"
 ~#claim: "A US university runs on shared governance, federal research funding, a credit-hour degree graph, evidence-based teaching, and a seasonal calendar."
 ~#proof: "Each leaf cites its statute, policy statement, or study in the learning sources registry."
 ~#door: "Start with curricular architecture if you are a student, governance if you work there, funding if you do research."
 ~#audience: "students, families, staff, and new faculty"
 continuity: "Institutions | shared governance"
 cold_open: "A university is shared governance, research money, a degree graph, teaching that works, and a calendar that keeps time."
}

