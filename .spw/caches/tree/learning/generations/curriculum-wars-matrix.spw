# Curriculum Wars Matrix
#
# The US fights over how to teach reading, mathematics, and history, set side by side with the evidence status of each position and the sources on each side.

#>generations_curriculum_wars
#:layer #!reference
#:domain #!generations
#:form #!comparison
#:level #!advanced
#:review #!adversarial_checked
#:valence #!honk
#:era #!modern

^"emit"{
 ~#title: "Curriculum Wars Matrix"
 ~#claim: "Reading research supports systematic phonics inside a broader program; the idea that reading comes naturally is refuted; the math and history fights are mostly about aims, with evidence on parts."
 ~#proof: "The National Reading Panel 2000, Castles, Rastle, and Nation 2018, Gough and Tunmer 1986, the Reading First impact study, NCTM 1989, the 2008 math panel, Nash and colleagues 1997."
 ~#door: "Read each row with its status, decode the nonsense words in the kit, then take one row to a family conversation."
 ~#audience: "parents, teachers, and readers who heard one side of a school debate"
 continuity: "Curriculum Wars Matrix | systematic phonics"
 cold_open: "Systematic phonics has the evidence, natural reading does not, and the math and history wars are mostly about aims."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #corrected }
 }
 corrections: #[ "fact check: the refuted natural-reading row named the refuting review as its source and Goodman as its counter; it now says where the claim came from and holds Castles and colleagues under checked_against" ]
}

^["edges"]{
 needs: [ ~"../../language-and-mind/linguistics/phonetics-and-phonology.spw#linguistics_phonology" ]
 grounds: [ ~"./policy-landmarks-ledger.spw#generations_policy_ccss" ]
 see: [ ~"../intergenerational-kit/difference-probes.spw#generations_kit_probes" ]
}

^["concepts"]{
 primary: [ #phonics, #standards ]
 transfers: [ #curriculum_memory ]
 tensions: [ #accountability ]
}

^["matrix"]{
 columns: #[ era, core_claim, status, sources ]
 status_rule: "each row carries its own claim status; a status rates the evidence for the core claim, not the people who held it"
}

^["reading"]{
 #>generations_wars_phonics
 ^["systematic_phonics"]{
  #:claim #!settled
  statement: "The National Reading Panel found systematic phonics instruction helped children from kindergarten through grade 6, and struggling readers, more than instruction without it."
  sources: [ ~"../../registries/sources/learning-and-generations.spw#src_learn_nrp_2000", ~"../../registries/sources/learning-and-generations.spw#src_learn_chall_1967" ]
  lineage: "Flesch made the popular case in 1955; Chall reviewed the research in 1967"
  popular_case: ~"../../registries/sources/learning-and-generations.spw#src_learn_flesch_1955"
  era: 1955..2000
 }

 #>generations_wars_whole_language
 ^["natural_reading"]{
  #:claim #!refuted
  statement: "Children learn to read naturally, as they learn to speak, by immersion in meaningful text."
  claimed_in: "whole language teaching, which drew on Goodman's account of reading as a psycholinguistic guessing game"
  background: ~"../../registries/sources/learning-and-generations.spw#src_learn_goodman_1967"
  ^["checked_against"]{
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_castles_2018"
   finding: "writing is a recent invention, so the letter-to-sound code must be taught; immersion alone leaves many children without it"
  }
 }

 #>generations_wars_cueing
 ^["three_cueing"]{
  #:claim #!contested
  statement: "Balanced literacy taught readers to identify words from meaning, sentence structure, and visual cues; critics say this trains guessing in place of decoding."
  source: ~"../../registries/sources/learning-and-generations.spw#src_learn_castles_2018"
  counter: ~"../../registries/sources/learning-and-generations.spw#src_learn_clay_2005"
  origin: "the cueing model draws on Goodman psycholinguistic theory and on Marie Clay running records from New Zealand, whose Reading Recovery spread internationally"
  public: ~"../../registries/sources/learning-and-generations.spw#src_learn_hanford_2022"
 }

 #>generations_wars_simple_view
 ^["simple_view"]{
  #:claim #!settled
  statement: "The simple view of reading holds that comprehension needs both decoding and language comprehension, so weakness in either limits reading."
  sources: [ ~"../../registries/sources/learning-and-generations.spw#src_learn_gough_tunmer_1986", ~"../../registries/sources/learning-and-generations.spw#src_learn_castles_2018" ]
 }

 #>generations_wars_reading_first
 ^["reading_first"]{
  #:claim #!settled
  statement: "The federal Reading First impact study found more time spent on core reading components but no significant gain in reading comprehension for grades 1 to 3."
  source: ~"../../registries/sources/learning-and-generations.spw#src_learn_reading_first_2008"
  ^["limits"]{
   holds: "a phonics-heavy federal program as implemented from 2002 to 2008"
   fails: "the result limits claims about one program, not the evidence for phonics itself"
  }
 }
 laws: %[learn.policy.states_reading_laws_count]
}

^["mathematics"]{
 #>generations_wars_new_math
 ^["new_math"]{
  #:claim #!interpretive
  reading: "New Math taught structure, sets, and number bases from the late 1950s and faded in the 1970s amid pushback from parents and teachers"
  sources: [ ~"../../registries/sources/learning-and-generations.spw#src_learn_kline_1973", ~"../../registries/sources/learning-and-generations.spw#src_learn_schoenfeld_2004" ]
  era: 1958..1975
 }

 #>generations_wars_nctm
 ^["nctm_standards"]{
  #:claim #!contested
  statement: "The 1989 NCTM standards stressed problem solving, reasoning, and calculator use; opponents argued they neglected skills and algorithms, starting the 1990s math wars."
  sources: [ ~"../../registries/sources/learning-and-generations.spw#src_learn_nctm_1989", ~"../../registries/sources/learning-and-generations.spw#src_learn_schoenfeld_2004" ]
  disagreement: "reformers weighed understanding and reasoning; critics weighed fluent procedures; the 2008 panel later asked for both"
 }

 #>generations_wars_nmap
 ^["math_panel"]{
  #:claim #!settled
  statement: "The 2008 National Mathematics Advisory Panel named fluency with whole numbers, fluency with fractions, and parts of geometry and measurement as critical foundations for algebra."
  source: ~"../../registries/sources/learning-and-generations.spw#src_learn_nmap_2008"
 }

 #>generations_wars_ccss_algorithms
 ^["standard_algorithms"]{
  #:claim #!settled
  statement: "Common Core expects fluency with standard algorithms: multi-digit addition and subtraction by grade 4, multiplication by grade 5, and division by grade 6."
  source: ~"../../registries/sources/learning-and-generations.spw#src_learn_ccss_2010"
  myth: "Common Core bans the standard algorithm is false; it asks for strategies first and the algorithm later"
 }
}

^["history"]{
 #>generations_wars_history_standards
 ^["national_history_standards"]{
  #:claim #!settled
  statement: "The 1994 national US history standards drew attack from Lynne Cheney; the Senate passed a 99 to 1 resolution against them in 1995, and a revised edition followed in 1996."
  source: ~"../../registries/sources/learning-and-generations.spw#src_learn_nash_1997"
  era: 1994..1996
 }
 later: "disputes over how to teach national history continued into the 2020s; this cut records them only with dated primary sources"
}

^["try"]{
 #>generations_wars_try_decode
 ^["decode_nonsense"]{
  materials: [
   "this list of made-up words: blim, strob, fendle, crumpish, glorp",
   "a willing reader of any age"
  ]
  steps: <<
   "read each word aloud" ;
   "notice that no picture or sentence can help: only the letters can" ;
   "ask how you knew the sound of each part" ;
   "ask an elder how they were taught to read a word they had never seen"
  >>
  time: .{ n: 10, unit: "minutes" }
  safety: "none worth naming; keep it a game, never a test of the reader"
  shows: ~"./curriculum-wars-matrix.spw#generations_wars_phonics"
 }
}

#>generations_wars_pendulum_q
?["Do school curriculum fights swing like a pendulum, once per generation?"]{
 #:depth #!historical ~#lens(historical layer)
 #:claim #!speculative
 ~#hypothesis: "Each reform is resisted most by parents who learned under the reform before it, so debates recur as cohorts become parents."
 !probe{ "date the peaks of press coverage for reading and math fights and compare with cohort parenting ages" =id[p_learn_wars_pendulum] =kind[census] }
 $%[learn.policy.states_reading_laws_count]
 ~"./curriculum-wars-matrix.spw#generations_wars_nctm" ~#neighbor(nearest)
}

#>generations_wars_rename_q
?["Do contested methods survive by changing their names?"]{
 #:depth #!social ~#lens(semiotic charge)
 #:claim #!speculative
 ~#hypothesis: "When a label gathers criticism, practices continue under a new label more often than they stop."
 breaks: "a renamed practice can also really change, so a new name is weak evidence of an unchanged method"
 !probe{ "trace classroom materials under whole language, balanced literacy, and later labels for shared practices" =id[p_learn_wars_rename] =kind[lit] }
 ~"./curriculum-wars-matrix.spw#generations_wars_cueing" ~#neighbor(nearest)
}
