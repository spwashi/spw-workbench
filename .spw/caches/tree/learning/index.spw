# Learning
#
# How US universities and high schools organize learning, what each generation was taught, and a kit for comparing those schoolings across a family.

#>learning_index
#:layer #!reference
#:domain #!learning
#:form #!index
#:level #!intro
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Learning"
 ~#claim: "Schooling is built from institutions, sequences, and laws that change by cohort, so each generation carries a different curriculum memory worth comparing."
 ~#proof: "Leaves cite statutes, regulations, rulings, research reviews, and dated survey series in the learning sources registry."
 ~#door: "Start with the glossary, then choose institutions, secondary schooling, or generations; the kit turns the timeline into conversations."
 ~#audience: "students, families, teachers, and writers curious how US schooling works and changed"
 continuity: "Learning | curriculum memory"
 cold_open: "Every generation carries a different curriculum memory, and this class shows where each one came from."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #pass }
 }
}

^["tree"]{
 glossary: ~"./learning-glossary.spw"
 institutions: ~"./institutions/index.spw"
 secondary: ~"./secondary/index.spw"
 generations: ~"./generations/index.spw"
 kit: ~"./intergenerational-kit/index.spw"
}

^["bundle"]{
 ={ ~"./learning-glossary.spw#learning_glossary" }
 ={ ~"./institutions/index.spw#institutions_index" }
 ={ ~"./secondary/index.spw#secondary_schooling_index" }
 ={ ~"./generations/index.spw#generations_index" }
 ={ ~"./intergenerational-kit/index.spw#generations_kit_index" }
}

^["ladder"]{
 rungs: << "intro" ; "foundation" ; "advanced" ; "graduate" ; "practitioner" >>
 intro: [
  ~"./learning-glossary.spw#learning_glossary",
  ~"./institutions/academic-year-cadence.spw#institutions_academic_year",
  ~"./secondary/advanced-coursework.spw#secondary_schooling_advanced",
  ~"./secondary/secondary-pathways.spw#secondary_schooling_pathways",
  ~"./secondary/student-support.spw#secondary_schooling_support",
  ~"./secondary/family-and-community-wraparound.spw#secondary_schooling_wraparound",
  ~"./generations/us-curricula-by-generation.spw#generations_us_curricula",
  ~"./generations/continuities-matrix.spw#generations_continuities"
 ]
 foundation: [
  ~"./institutions/curricular-architecture.spw#institutions_curricular_architecture",
  ~"./institutions/pedagogical-scaffolding.spw#institutions_pedagogy",
  ~"./generations/policy-landmarks-ledger.spw#generations_policy_ledger",
  ~"./generations/public-worry-hooks.spw#generations_worry_hooks"
 ]
 advanced: [
  ~"./institutions/governance-and-tenure.spw#institutions_governance",
  ~"./institutions/research-funding.spw#institutions_research_funding",
  ~"./generations/curriculum-wars-matrix.spw#generations_curriculum_wars"
 ]
 graduate: "a gap: graduate education, doctoral training, and postdoctoral careers have no leaf yet"
 practitioner: [
  ~"./intergenerational-kit/interview-protocol.spw#generations_kit_interview",
  ~"./intergenerational-kit/artifact-dossier-template.spw#generations_kit_artifact_template"
 ]
}

^["facets"]{
 domains: #[ learning, institutions, secondary_schooling, generations ]
 order: "personality by domain, matter by concept, energy by form, then era"
 scope: "US schooling; the cut has no region axis, so place lives in each leaf scope"
}

^["gaps"]{
 ^["k_8"]{
  missing: "elementary and middle school: early reading instruction in practice, recess, grade retention, the middle school model"
  neighbors: ~"../language-and-mind/cognition/cognitive-development.spw#cognition_development"
 }
 ^["early_childhood"]{
  missing: "preschool, Head Start since 1965, kindergarten history from Froebel"
  neighbors: "living development-and-ecology, for sensitive periods"
 }
 ^["non_us"]{
  missing: "curricula outside the US and international comparisons such as PISA and TIMSS; the generations kit is US-only by design"
  neighbors: "society economics, for returns to schooling across countries"
 }
 ^["other_paths"]{
  missing: "homeschooling, career and technical education, community colleges, adult education"
  neighbors: "institutions, for credit and transfer"
 }
 ^["institutions_by_mission"]{
  missing: "historically Black colleges and universities, tribal colleges, Hispanic-serving institutions, and their histories"
  neighbors: "generations policy ledger, for access landmarks"
 }
 ^["acquisition"]{
  missing: "first and second language acquisition and bilingual education research"
  neighbors: ~"../language-and-mind/linguistics/phonetics-and-phonology.spw#linguistics_phonology"
 }
}
