# Affinity Atlas
#
# Six plates that set an older form beside a current one, in the manner of the Mnemosyne panels, each naming the shared gesture and the place where the resemblance breaks.

#>panel_affinity_atlas
#:layer #!creative
#:domain #!panel
#:form #!comparison
#:level #!advanced
#:review #!adversarial_checked
#:valence #!boon

^"emit"{
 ~#title: "Affinity Atlas"
 ~#claim: "Old and new forms of keeping and sharing text, sound, and gifts repeat a few gestures, and each plate shows where the resemblance breaks, which teaches as much as the match."
 ~#proof: "Each side of a plate cites its own history; the shared gesture is marked interpretive and every plate names where it breaks."
 ~#door: "Read one plate left, right, then the break, and only then the affinity line."
 ~#audience: "readers who like comparing eras, and streamers, podcasters, and archivists looking for precedent"
 continuity: "Affinity Atlas | where the resemblance breaks"
 cold_open: "Old forms and new ones repeat a few gestures, and each plate shows where the resemblance breaks."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{
   event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #partial
   note: "forward ref to a planned trail another package had not written yet"
  }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "Thanksgiving dates and home cylinder timing corrected"
  }
  ^["r5"]{
   event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #partial
   note: "only the forward ref to the planned scroll-to-stream trail remains"
  }
  ^["r6"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "harvest recap see-link moved from the Samhain row to the US Thanksgiving calendar anchor"
  }
  ^["r7"]{
   event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #partial
   note: "only the forward ref to the planned scroll-to-stream trail remains"
  }
 }
 rule: "each side of a plate is a sourced fact; the affinity is an authored reading and stays interpretive"
}

^["edges"]{
 needs: [ ~"../record/information/reference-works-lineage.spw#information_science_reference_lineage" ]
 see: [ ~"../record/information/archive-patterns-matrix.spw#information_science_patterns_warburg" ]
}

^["concepts"]{
 primary: [ #affinity_plate, #cadence ]
 transfers: [ #provenance, #renvoi ]
 tensions: [ #false_analogy ]
}

^["plate_form"]{
 axes: .{ rows: "era", columns: "form of keeping or sharing" }
 parts: "left, right, affinity, breaks"
 origin: "Warburg pinned images from distant eras to panels to show recurring gestures"
 source: ~"../registries/sources/provenance-and-reference.spw#src_prov_gombrich_1970"
}

^["plates"]{
 #>panel_affinity_scroll_feed
 ^["scroll_and_feed"]{
  eras: .{ left: #ancient, right: #contemporary }
  ^["left"]{
   #:claim #!settled
   statement: "A Greek or Latin book roll was read by unrolling it column by column; Roberts and Skeat trace how the codex displaced it in the early centuries CE."
   source: ~"../registries/sources/provenance-and-reference.spw#src_prov_roberts_skeat_1983"
  }
  ^["right"]{
   #:claim #!settled
   statement: "Infinite scrolling loads more items as a reader nears the bottom, so a feed has no last page; one early record is a 2006 patent application."
   source: ~"../registries/sources/provenance-and-reference.spw#src_prov_wiki_infinite_scroll"
  }
  ^["affinity"]{
   #:claim #!interpretive
   statement: "Both present text as one continuous strip read forward, where finding an earlier passage means winding back rather than turning to a numbered page."
  }
  breaks: "a roll had a last column and the same text for every reader, while a feed never ends and is reordered for each reader"
 }
 #>panel_affinity_scriptorium_moderation
 ^["scriptorium_and_moderation"]{
  eras: .{ left: #medieval, right: #current }
  ^["left"]{
   #:claim #!settled
   statement: "In a medieval scriptorium a scribe copied from an exemplar, and a corrector compared the copy with it and marked errors."
   source: ~"../registries/sources/provenance-and-reference.spw#src_prov_clemens_graham_2007"
  }
  ^["right"]{
   #:claim #!settled
   statement: "Twitch moderators remove messages and ban users during a stream, and their actions and example shape what other viewers post next."
   sources: [ ~"../registries/sources/creators-and-platforms.spw#src_creator_seering_2017", ~"../registries/sources/creators-and-platforms.spw#src_creator_taylor_2018" ]
  }
  ^["affinity"]{
   #:claim #!interpretive
   statement: "A small trusted team stands between a stream of text and its readers and decides what passes."
  }
  breaks: "a corrector checked a copy against a fixed exemplar after it was written, while a moderator judges live speech by strangers with no exemplar at all"
 }
 #>panel_affinity_leishu_cache
 ^["leishu_and_cache"]{
  eras: .{ left: #medieval, right: #contemporary }
  ^["left"]{
   #:claim #!settled
   statement: "Leishu compilers excerpted earlier writings under fixed categories so officials and scholars could consult them without reading every source whole."
   sources: [ ~"../registries/sources/provenance-and-reference.spw#src_prov_wilkinson_2012", ~"../registries/sources/provenance-and-reference.spw#src_prov_tsai_2001" ]
  }
  ^["right"]{
   #:claim #!settled
   statement: "A processor cache keeps copies of recently used data near the processor and evicts entries under a replacement policy when it fills."
   source: ~"../registries/sources/provenance-and-reference.spw#src_prov_hennessy_patterson_2017"
  }
  ^["affinity"]{
   #:claim #!interpretive
   statement: "Both keep a nearby copy of what is needed often, so a reader or a processor rarely walks back to the full store."
  }
  breaks: "compilers chose and arranged excerpts by judgment and kept them, while a cache keeps by recent use and discards without telling anyone"
  ~#(this is why the cut contract says the cut is not a cache)
 }
 #>panel_affinity_patron_gift
 ^["patron_and_live_gift"]{
  eras: .{ left: #early_modern, right: #current }
  ^["left"]{
   #:claim #!settled
   statement: "Cosimo de Medici paid for churches, buildings, and art in fifteenth-century Florence, and Kent reads that patronage as building his honor and civic standing."
   source: ~"../registries/sources/provenance-and-reference.spw#src_prov_kent_2000"
  }
  ^["theory"]{
   #:claim #!settled
   statement: "Mauss argued that a gift carries obligations to give, to receive, and to give back."
   source: ~"../registries/sources/provenance-and-reference.spw#src_prov_mauss_1925"
  }
  ^["right"]{
   #:claim #!settled
   statement: "On TikTok LIVE, viewers buy Coins and send Gifts, and hosts accrue Diamonds at a conversion rate the platform sets."
   source: ~"../registries/sources/creators-and-platforms.spw#src_creator_tiktok_virtual_items"
   see: ~"../society/platforms/monetization-receipt.spw#live_platforms_monetization_chain"
  }
  ^["affinity"]{
   #:claim #!interpretive
   statement: "Public giving to a maker buys standing in a crowd and leaves both sides feeling an obligation."
  }
  breaks: "a patron was one known person in a lasting relation, while a live gift passes through a platform that sets the rate and takes a share before the host sees it"
 }
 #>panel_affinity_cylinder_podcast
 ^["cylinder_and_podcast"]{
  eras: .{ left: #industrial, right: #contemporary }
  ^["left"]{
   #:claim #!settled
   statement: "Edison's 1877 phonograph embossed sound on tinfoil; wax cylinders appeared in the late 1880s, and by the later 1890s prerecorded cylinders and home phonographs let recorded voices be bought and replayed at home."
   sources: [ ~"../registries/sources/provenance-and-reference.spw#src_prov_gitelman_1999", ~"../registries/sources/record-and-carriers.spw#src_media_millard_2005", ~"../registries/sources/provenance-and-reference.spw#src_prov_wiki_phonograph_cylinder" ]
   early_use: "the first wax-cylinder machines went mainly to office dictation and coin-slot parlors"
   see: ~"../record/carriers/sound/phonograph-shellac-and-vinyl.spw#media_carriers_wax_cylinder"
  }
  ^["right"]{
   #:claim #!settled
   statement: "Hammersley floated the word podcasting in a February 2004 Guardian article, and podcast episodes reach listeners as media files announced in feeds."
   sources: [ ~"../registries/sources/provenance-and-reference.spw#src_prov_hammersley_2004", ~"../registries/sources/provenance-and-reference.spw#src_prov_rss_2003" ]
  }
  ^["affinity"]{
   #:claim #!interpretive
   statement: "Both let a voice be heard at the time the listener chooses instead of the time it was spoken."
  }
  breaks: "a cylinder was a physical copy that wore with each play and had to be shipped, while a feed delivers fresh copies at no cost per listener and can be withdrawn"
 }
 #>panel_affinity_harvest_recap
 ^["harvest_and_recap"]{
  eras: .{ left: #modern, right: #current }
  ^["left"]{
   #:claim #!settled
   statement: "US Thanksgiving, a federal holiday since an 1870 act, has fallen by law on the fourth Thursday of November since 1942, under a resolution signed in December 1941."
   sources: [ ~"../registries/sources/provenance-and-reference.spw#src_prov_wiki_federal_holidays", ~"../registries/sources/provenance-and-reference.spw#src_prov_nara_thanksgiving" ]
   see: ~"../season/calendar-2026q4.spw#season_cal_thanksgiving_us"
  }
  ^["right"]{
   #:claim #!settled
   statement: "Spotify has sent each user a personal summary of their year of listening in late November or December every year since 2016."
   source: ~"../registries/sources/provenance-and-reference.spw#src_prov_wiki_spotify_wrapped"
  }
  ^["affinity"]{
   #:claim #!interpretive
   statement: "A yearly reckoning turns a season of work or attention into a story people tell each other at the same time."
  }
  breaks: "a harvest counts what a community grew and shares it, while a recap counts what one person consumed as measured by a platform that also markets with the result"
 }
}

^["reading_rule"]{
 order: << "left" ; "right" ; "breaks" ; "affinity" >>
 why: "reading the break before the affinity keeps a plate from turning into a claim that the two things are the same"
 trail: ~"../trails/scroll-to-stream.spw#trail_scroll_to_stream"
}

^["try"]{
 #>panel_affinity_try_plate
 ^["make_a_plate"]{
  materials: [ "two printed images or objects from different centuries", "a sheet of dark paper", "pins or tape", "a pencil" ]
  steps: << "pin the older thing on the left and the newer on the right" ; "write one sourced fact under each" ; "write where the resemblance breaks" ; "only then write the gesture they share" >>
  time: .{ n: 30, unit: "minutes" }
  safety: "no hazard worth naming; handle old prints by the edges"
  shows: ~"./affinity-atlas.spw#panel_affinity_leishu_cache"
 }
}

#>panel_affinity_gift_q
?["Does a gift sent in public bind giver and maker more than a private payment of the same size?"]{
 #:depth #!social ~#lens(market flow)
 #:claim #!speculative
 ~#hypothesis: "A gift seen by the crowd should make the giver more likely to return and the host more likely to name them, compared with a private payment."
 !probe{ "compare return visits of viewers whose first gift was shown on screen with viewers who subscribed privately, using only counts a host can see" =id[p_prov_affinity_public_gift] =kind[census] }
 ~"./affinity-atlas.spw#panel_affinity_patron_gift" ~#neighbor(nearest)
 breaks: "Mauss described gift economies without money or platforms, so the obligation he named may not survive a fee and an exchange rate"
}

#>panel_affinity_recap_q
?["Would a recap built from a community's shared year feel more like a harvest than a personal one?"]{
 #:depth #!experiential ~#lens(production cadence)
 #:claim #!speculative
 ~#hypothesis: "A recap of what a group made together should prompt more retelling between members than a recap of what each one consumed."
 !probe{ "give one study group a shared year-end summary and another individual summaries, then count how often members bring them up a week later" =id[p_prov_affinity_shared_recap] =kind[field] }
 ~"./affinity-atlas.spw#panel_affinity_harvest_recap" ~#neighbor(nearest)
 breaks: "a harvest feeds people, while a recap only describes them, so the obligation a shared meal creates may not appear"
}
