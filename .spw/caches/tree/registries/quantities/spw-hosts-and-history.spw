# Quantities: Spw Hosts and History
#
# Counted cells for the editor hosts and the workbench history surfaces. Each cell was recounted from the repository at a named commit or from a named document.

#>q_hosts_registry
#:layer #!reference
#:domain #!registry
#:form #!registry
#:level #!mixed
#:review #!adversarial_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r5"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r6"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r7"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r8"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r9"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
   note: "cells recounted by the checker matched their at strings; the gate warns that the file passes 300 lines"
  }
  ^["r10"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 method_note: "counts come from the cited file or git log at 1aa1dc23, the tip of main on 2026-10-02; the cut cells count the tree of 651b535b, the commit that shelved waves 1 through 3"
 recount: "the cut cells held snapshots of 2026-10-02 (268 files; care 135, 390, 115, 277, 219) and of 02:45 on 2026-10-03 (383; 154, 635, 219, 430, 285); 651b535b supersedes both under the same handles, and a recount when the resumed wave 3 closes should supersede it"
 corrections: #[
  "native_lsp_rename_min_ide read 2026.1 as a verify cell; the JetBrains table marks rename 2026.1.1, reread on 2026-10-03, so the cell is settled at that value",
  "sigil_dot_count read 173; a recount under its own rule gives 174, corrected in place as a miscount",
  "rewrite_stamped_commit_count and first_commit_date described a published rewrite and a single root; both at strings now name the docs import, and the handles keep their names"
 ]
}

^["families"]{
 ^["shared"]{ operator: "%", plane: world, scope: corpus, scheme: tol, form: scalar }
 ^["lookup"]{ algorithm: world.registry_lookup }
 ^["vscode"]{ id: hosts_vscode, identifier: hosts.vscode }
 ^["lsp"]{ id: hosts_lsp, identifier: hosts.lsp }
 ^["jb"]{ id: hosts_jb, identifier: hosts.jb }
 ^["palette"]{ id: hosts_palette, identifier: hosts.palette }
 ^["cli"]{ id: hosts_cli, identifier: hosts.cli }
 ^["history"]{ id: hosts_history, identifier: hosts.history }
 ^["plans"]{ id: hosts_plans, identifier: hosts.plans }
 ^["cut"]{ id: hosts_cut, identifier: hosts.cut }
}

^["keys"]{
 vscode: #[ command_count, setting_count, color_id_count, registered_only_command_count, custom_methods_called, decoration_refresh_ms, probe_ttl_ms ]
 lsp: #[ provider_capability_count, custom_method_count, token_type_count, token_modifier_count ]
 jb: #[ since_build, build_host_version, semantic_tokens_min_ide, native_lsp_rename_min_ide, action_count, live_template_count, java_toolchain ]
 palette: #[ bone_light_contrast, potential_light_contrast, wcag_aa_text_ratio, distinct_dark_hex_count ]
 cli: #[ canonical_command_count, compat_route_count, command_group_count, package_commit_count ]
 history: #[ commit_count, episode_commit_count, rewrite_stamped_commit_count, first_commit_date, sigil_amp_count, sigil_dot_count, commits_2026_01, commits_2026_02, commits_2026_03, commits_2026_04, commits_2026_07, commits_2026_08, commits_2026_09, vscode_commit_count, intellij_commit_count, neovim_commit_count, extension_commit_count ]
 plans: #[ card_count, archived_count, plan_map_coverage, lane_execution_count, lane_projection_count, lane_curriculum_count, curriculum_css_step_count, curriculum_svg_step_count, curriculum_logic_step_count ]
 cut: #[ census_file_count, care_glance_count, care_skim_count, care_read_count, care_audit_count, care_adversarial_count, fact_checked_file_count ]
}

#>q_hosts_vscode
^"vscode"{
 %hosts.vscode.command_count{
  value: 22, unit: "commands", abs: 0
  at: "contributes.commands, extensions/vscode-spw/package.json:61-149", src: ~"../sources/spw-hosts-and-history.spw#src_hosts_vscode_manifest", status: #settled
 }
