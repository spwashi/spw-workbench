  status: #settled
 }
}

#>q_formal_transforms
^"transforms"{
 %formal.transforms.nyquist_rate_factor{
  value: 2
  unit: "times bandwidth"
  at: "uniform sampling recovers a signal bandlimited below B hertz when the sample rate exceeds 2B"
  abs: 0
  src: ~"../sources/formal.spw#src_formal_shannon_1949"
  status: #settled
 }
 %formal.transforms.gibbs_overshoot_fraction{
  value: 0.0895
  unit: "fraction of the jump"
  at: "limiting overshoot of Fourier partial sums at a jump discontinuity, beside each side of the jump"
  abs: 0.0001
  src: ~"../sources/formal.spw#src_formal_oppenheim_willsky_1997"
  status: #settled
 }
}

