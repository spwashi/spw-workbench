# Quantities: Formal
#
# World metric cells for mathematics and computing. A handle names one cell; surfaces read it instead of restating the number.

#>q_formal_registry
#:layer #!reference
#:domain #!registry
#:form #!registry
#:level #!mixed
#:review #!adversarial_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[ "binary64 epsilon, normal quantiles, birthday probability, and log2 of 10 recomputed with Python 3 on 2026-10-01", "Hilbert matrix condition number recomputed on 2026-10-01 from the exact rational inverse and power iteration", "Ecma-262 edition list, Maglev post, ABET criteria, and GAO Patriot summary read on 2026-10-01", "fact-check pass 2026-10-02 recomputed the epsilon, Hilbert, normal, birthday, and Gibbs cells and reframed the Byzantine replica cell for partial synchrony", "fact-check pass 2026-10-03 recomputed the normal, birthday, log2, Gibbs, epsilon, and Hilbert cells, and moved the ABET cell to the 2026-2027 criteria read that day" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #corrected }
  ^["r5"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #corrected }
 }
 status_legend: "settled cells were checked against the linked source or recomputed on the access date; dated cells carry as_of"
}

^["families"]{
 ^["fp"]{
  id: formal_fp, operator: "%", identifier: formal.fp
  keys: #[ binary64_precision_bits, binary64_epsilon, binary32_precision_bits ]
  plane: world, scope: corpus, scheme: tol, algorithm: world.registry_lookup, form: scalar
 }
 ^["numerics"]{
  id: formal_numerics, operator: "%", identifier: formal.numerics
  keys: #[ hilbert10_cond2, bisection_steps_per_digit, newton_order, rk4_order, patriot_clock_error_s_100h ]
  plane: world, scope: corpus, scheme: tol, algorithm: world.registry_lookup, form: scalar
 }
 ^["stats"]{
  id: formal_stats, operator: "%", identifier: formal.stats
  keys: #[ normal_two_sided_95_z, normal_within_1sd, normal_within_2sd, birthday_23_shared, berkeley_1973_men_admit, berkeley_1973_women_admit ]
  plane: world, scope: corpus, scheme: tol, algorithm: world.registry_lookup, form: scalar
 }
 ^["transforms"]{
  id: formal_transforms, operator: "%", identifier: formal.transforms
  keys: #[ nyquist_rate_factor, gibbs_overshoot_fraction ]
  plane: world, scope: corpus, scheme: tol, algorithm: world.registry_lookup, form: scalar
 }
 ^["structures"]{
  id: formal_structures, operator: "%", identifier: formal.structures
  keys: #[ a5_order, sphere_euler_characteristic ]
  plane: world, scope: corpus, scheme: tol, algorithm: world.registry_lookup, form: scalar
 }
 ^["consensus"]{
  id: formal_consensus, operator: "%", identifier: formal.consensus
  keys: #[ crash_replicas_f1, bft_replicas_f1 ]
  plane: world, scope: corpus, scheme: tol, algorithm: world.registry_lookup, form: scalar
 }
 ^["memory"]{
  id: formal_memory, operator: "%", identifier: formal.memory
  keys: #[ cache_line_bytes, page_bytes, va_bits_4level, va_bits_5level ]
  plane: world, scope: corpus, scheme: tol, algorithm: world.registry_lookup, form: scalar
 }
 ^["dated"]{
  id: formal_dated, operator: "%", identifier: formal.dated
  keys: #[ ecma262_edition_2026, maglev_chrome_major, abet_math_science_credits ]
  plane: world, scope: corpus, scheme: tol, algorithm: world.registry_lookup, form: scalar
 }
}

#>q_formal_fp
^"fp"{
 %formal.fp.binary64_precision_bits{
  value: 53
  unit: "bit"
  at: "IEEE 754 binary64 significand precision, 52 stored bits plus the implicit leading bit"
  abs: 0
  src: ~"../sources/formal.spw#src_formal_ieee754_2019"
  status: #settled
 }
 %formal.fp.binary64_epsilon{
  value: 0.0000000000000002220446
  unit: "1"
  at: "machine epsilon of binary64, the gap from 1 to the next double, 2 to the minus 52"
  rel: 0.0000001
  src: ~"../sources/formal.spw#src_formal_higham_2002"
  status: #settled
 }
 %formal.fp.binary32_precision_bits{
  value: 24
  unit: "bit"
  at: "IEEE 754 binary32 significand precision, 23 stored bits plus the implicit leading bit"
  abs: 0
  src: ~"../sources/formal.spw#src_formal_ieee754_2019"
  status: #settled
 }
}

#>q_formal_numerics
^"numerics"{
 %formal.numerics.hilbert10_cond2{
  value: 16026000000000
  unit: "1"
  at: "2-norm condition number of the 10 by 10 Hilbert matrix, recomputed 2026-10-01 from its exact inverse"
  rel: 0.001
  src: ~"../sources/formal.spw#src_formal_higham_2002"
  status: #settled
 }
 %formal.numerics.bisection_steps_per_digit{
  value: 3.3219
  unit: "iteration per decimal digit"
  at: "bisection halves the bracket each step, so one decimal digit costs log2 of 10 steps"
  abs: 0.0001
  src: ~"../sources/formal.spw#src_formal_higham_2002"
  status: #settled
 }
 %formal.numerics.newton_order{
  value: 2
  unit: "order"
  at: "local convergence order of Newton iteration near a simple root of a twice-differentiable function"
  abs: 0
  src: ~"../sources/formal.spw#src_formal_nocedal_wright_2006"
  status: #settled
 }
 %formal.numerics.rk4_order{
  value: 4
  unit: "order"
  at: "global error order of the classical four-stage Runge-Kutta method on smooth problems"
  abs: 0
  src: ~"../sources/formal.spw#src_formal_hairer_1993"
  status: #settled
 }
 %formal.numerics.patriot_clock_error_s_100h{
  value: 0.34
  unit: "s"
  at: "Patriot battery clock error after about 100 hours of continuous operation, Dhahran, 25 February 1991"
  abs: 0.01
  src: ~"../sources/formal.spw#src_formal_gao_1992"
  status: #settled
 }
}

#>q_formal_stats
^"stats"{
