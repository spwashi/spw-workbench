  value: 60
  unit: "element"
  at: "order of the alternating group on five letters, the smallest nonabelian simple group"
  abs: 0
  src: ~"../sources/formal.spw#src_formal_dummit_foote_2004"
  status: #settled
 }
 %formal.structures.sphere_euler_characteristic{
  value: 2
  unit: "1"
  at: "Euler characteristic of the 2-sphere, so its total Gaussian curvature is 4 pi"
  abs: 0
  src: ~"../sources/formal.spw#src_formal_lee_2018"
  status: #settled
 }
}

#>q_formal_consensus
^"consensus"{
 %formal.consensus.crash_replicas_f1{
  value: 3
  unit: "replica"
  at: "majority quorums tolerating f crash faults need 2f+1 replicas; here f is 1"
  abs: 0
  src: ~"../sources/formal.spw#src_formal_lynch_1996"
  status: #settled
 }
 %formal.consensus.bft_replicas_f1{
  value: 4
  unit: "replica"
  at: "Byzantine agreement needs at least 3f+1 replicas with oral messages in synchronous systems, and with or without signatures under partial synchrony absent trusted components (Dwork, Lynch, Stockmeyer 1988); PBFT uses exactly that; here f is 1"
  abs: 0
  src: ~"../sources/formal.spw#src_formal_lsp_1982"
  status: #settled
 }
}

