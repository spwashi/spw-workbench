#>q_creator_live
^"live"{
 %creator.live.host_min_age_years{
  value: 18, unit: "years"
  at: "minimum age to host TikTok LIVE from 2022-11-23, as a TikTok newsroom post of 2022-10-18 announced; region qualifiers apply"
  region: "varies", as_of: "2026-10-02"
  src: ~"../sources/creators-and-platforms.spw#src_creator_tiktok_live_2022"
  access: "the newsroom post and TikTok help pages could not be read on 2026-10-02; verify until a current help page is read"
  prior: %[creator.live.host_min_age_prior_years]
  status: #verify
 }
 %creator.live.host_min_age_prior_years{
  value: 16, unit: "years"
  at: "minimum age to host TikTok LIVE before 2022-11-23; the encyclopedia entry read on 2026-10-02 still gives over 16"
  region: "varies", as_of: "2022-11-22"
  src: ~"../sources/creators-and-platforms.spw#src_creator_wiki_tiktok"
  status: #superseded
 }
