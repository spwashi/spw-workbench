# Quantities: Creators and Platforms
#
# Dated cells for publishing terms, live-platform gates and gifts, and public case figures. A cell with status verify is a question, not a fact.

#>registry_qty_creators_and_platforms
#:layer #!reference
#:domain #!registry
#:form #!registry
#:level #!practitioner
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 status_legend: "settled cells were read from the linked source on the access date; verify cells hold a reported value or unset and must be checked before use; superseded cells keep an old value for history"
 corrections: #[
  "TikTok payout: the raw halved coins into diamonds and took a second 50 percent share at cashout; the policy names both conversions and publishes neither rate, so both halvings are unverified, not refuted",
  "fact check 2026-10-02: the earlier note that one platform share applies once is withdrawn; the policy describes two platform-set conversions",
  "no fiat value is attached to any gift; the raw gave the Lion as both 450 and 500 USD",
  "the 121,000 Twitch Plays Pokemon peak is simultaneous participation, not concurrent viewers; peak_viewers is superseded by peak_participants",
  "the host age cell no longer cites the encyclopedia for 18; that entry still says over 16 and is kept as the counter",
  "fact check 2026-10-02: over 16 is the superseded pre-2022-11-23 host age, not a live counter; it moves to its own superseded cell beside the verify cell for 18",
  "fact check 2026-10-02: the Twitch price cell now separates the 2014-08-25 announcement from the 2014-09-25 close",
  "the KENP note and the Kickstarter cells now cite the pages actually re-read on 2026-10-02"
 ]
}

^["family"]{
 id: creator
 operator: "%"
 identifier: creator
 plane: world
 scope: corpus
 keys: #[ kdp, ku, kickstarter, nanowrimo, live, tpp, twitch ]
 scheme: dated
 algorithm: world.registry_lookup
 form: scalar
}

#>q_creator_kdp
^"kdp"{
