# Quantities: Spw Doors and Perspectives
#
# Keyboard cells for the marks the fragment doors teach: how many modifier keys each mark needs on the Windows US layout and on the Windows UK layout of an ISO board.

#>q_doors_registry
#:layer #!reference
#:domain #!registry
#:form #!registry
#:level #!mixed
#:review #!adversarial_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 namespace: "doors: handles %doors.*, sources src_doors_*, probes p_doors_*"
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
  }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r8"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
  }
  ^["r9"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 why: "the critic of the spw plan found the ANSI keyboard directive served only by hedged notes; these cells give each door mark a sourced shift state on two layouts"
 scope: "Windows layouts only; Apple and ChromeOS layouts place some marks differently and are not covered here"
 grid: "key positions in at strings use the ISO/IEC 9995-1 row and column names, such as E03 for the 3 key and C12 for the key beside Enter on an ISO board"
 grid_source: ~"../sources/spw-doors-perspectives.spw#src_doors_iso_9995_1"
 status_legend: "settled cells were read from the layout tables named in src; a verify cell would hold a reported value not yet checked"
}

^["families"]{
 ^["shared"]{ operator: "%", plane: world, scope: corpus, scheme: tol, form: scalar }
 ^["lookup"]{ algorithm: world.registry_lookup }
 ^["key"]{ id: doors_key, identifier: doors.key }
}

^["keys"]{
 key: #[ hash_us_mods, hash_uk_mods, tilde_us_mods, tilde_uk_mods, equals_us_mods, equals_uk_mods, percent_us_mods, percent_uk_mods, at_us_mods, at_uk_mods, colon_us_mods, colon_uk_mods, caret_us_mods, caret_uk_mods, langle_us_mods, langle_uk_mods, question_us_mods, question_uk_mods, dquote_us_mods, dquote_uk_mods ]
 unit: "modifier keys held while the base key is pressed: 0 for an unshifted key, 1 for Shift"
}

#>q_doors_key
^"key"{
 #>q_doors_key_hash
 ^["hash"]{
  %doors.key.hash_us_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows US, KLID 00000409: Shift with the 3 key, E03", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_us", status: #settled
  }
  %doors.key.hash_uk_mods{
   value: 0, unit: "modifier keys", abs: 0
   at: "Windows UK, KLID 00000809: its own key beside Enter on an ISO board, C12", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_uk", status: #settled
  }
 }
 #>q_doors_key_tilde
 ^["tilde"]{
  %doors.key.tilde_us_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows US: Shift with the backquote key left of 1, E00", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_us", status: #settled
  }
  %doors.key.tilde_uk_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows UK: Shift with the hash key beside Enter, C12", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_uk", status: #settled
  }
 }
 #>q_doors_key_equals
 ^["equals"]{
  %doors.key.equals_us_mods{
   value: 0, unit: "modifier keys", abs: 0
   at: "Windows US: the equals key, E12", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_us", status: #settled
  }
  %doors.key.equals_uk_mods{
   value: 0, unit: "modifier keys", abs: 0
   at: "Windows UK: the equals key, E12", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_uk", status: #settled
  }
 }
 #>q_doors_key_percent
 ^["percent"]{
  %doors.key.percent_us_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows US: Shift with the 5 key, E05", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_us", status: #settled
  }
  %doors.key.percent_uk_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows UK: Shift with the 5 key, E05", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_uk", status: #settled
  }
 }
 #>q_doors_key_at
 ^["at"]{
  %doors.key.at_us_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows US: Shift with the 2 key, E02", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_us", status: #settled
  }
  %doors.key.at_uk_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows UK: Shift with the apostrophe key, C11", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_uk", status: #settled
  }
 }
 #>q_doors_key_colon
 ^["colon"]{
  %doors.key.colon_us_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows US: Shift with the semicolon key, C10", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_us", status: #settled
  }
  %doors.key.colon_uk_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows UK: Shift with the semicolon key, C10", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_uk", status: #settled
  }
 }
 #>q_doors_key_caret
 ^["caret"]{
  %doors.key.caret_us_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows US: Shift with the 6 key, E06", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_us", status: #settled
  }
  %doors.key.caret_uk_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows UK: Shift with the 6 key, E06", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_uk", status: #settled
  }
 }
 #>q_doors_key_langle
 ^["langle"]{
  %doors.key.langle_us_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows US: Shift with the comma key, B08", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_us", status: #settled
  }
  %doors.key.langle_uk_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows UK: Shift with the comma key, B08", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_uk", status: #settled
  }
 }
 #>q_doors_key_question
 ^["question"]{
  %doors.key.question_us_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows US: Shift with the slash key, B10", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_us", status: #settled
  }
  %doors.key.question_uk_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows UK: Shift with the slash key, B10", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_uk", status: #settled
  }
 }
 #>q_doors_key_dquote
 ^["dquote"]{
  %doors.key.dquote_us_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows US: Shift with the apostrophe key, C11", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_us", status: #settled
  }
  %doors.key.dquote_uk_mods{
   value: 1, unit: "modifier keys", abs: 0
   at: "Windows UK: Shift with the 2 key, E02", src: ~"../sources/spw-doors-perspectives.spw#src_doors_kbd_uk", status: #settled
  }
 }
}
