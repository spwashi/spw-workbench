  abs: 0
  bound: #upper
  src: ~"../sources/life-and-mind.spw#src_life_malek_1999"
  status: #settled
 }
}

#>q_life_mind
^"mind"{
 %life.psychophysics.stevens_brightness_exponent{
  value: 0.33
  unit: "1"
  at: "magnitude estimation of brightness, 5 degree target in the dark"
  abs: 0.01
  src: ~"../sources/life-and-mind.spw#src_life_stevens_1961"
  status: #verify
 }
 %life.psychophysics.stevens_length_exponent{
  value: 1.0
  unit: "1"
  at: "magnitude estimation of the length of a projected line"
  abs: 0.05
  src: ~"../sources/life-and-mind.spw#src_life_stevens_1961"
  status: #verify
 }
 %life.psychophysics.stevens_shock_exponent{
  value: 3.5
  unit: "1"
  at: "magnitude estimation of electric current through the fingers"
  abs: 0.1
  src: ~"../sources/life-and-mind.spw#src_life_stevens_1961"
  status: #verify
 }
 %life.memory.miller_span_chunks{
  value: 7
  unit: "items, plus or minus 2"
  at: "immediate memory span as Miller summarized it"
  abs: 2
  src: ~"../sources/life-and-mind.spw#src_life_miller_1956"
  status: #superseded
 }
 %life.memory.cowan_capacity_chunks{
  value: 4
  unit: "chunks"
  at: "focus-of-attention capacity in adults when rehearsal and chunking are controlled; Cowan gives about 3 to 5"
  abs: 1
  src: ~"../sources/life-and-mind.spw#src_life_cowan_2001"
  status: #settled
 }
 %life.memory.own_name_notice_pct{
  value: 33
  unit: "percent of listeners"
  at: "listeners who report hearing their own name in an unattended channel while shadowing, as Moray 1959 and Wood and Cowan 1995 found and the abstract restates"
  abs: 2
  src: ~"../sources/life-and-mind.spw#src_life_conway_2001"
  status: #settled
 }
 %life.decision.tk1992_lambda{
  value: 2.25
  unit: "ratio of loss to gain weight"
  at: "median loss-aversion coefficient fitted in cumulative prospect theory"
  abs: 0.01
  src: ~"../sources/life-and-mind.spw#src_life_tversky_kahneman_1992"
  status: #settled
 }
 %life.decision.meta_lambda_mean{
  value: 1.955
  unit: "ratio of loss to gain weight"
  at: "mean of 607 estimates from 150 articles, 1992 to 2017, with a 95 percent interval of 1.820 to 2.102"
  abs: 0.15
  src: ~"../sources/life-and-mind.spw#src_life_brown_2024"
  status: #settled
 }
}

#>q_life_replication
^"replication"{
 %life.replication.osc_original_sig_pct{
  value: 97
  unit: "percent of 100 original studies"
