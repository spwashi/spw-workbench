# Sources: Spw Branch
#
# Bibliography anchors for the reflexive spw class: repository code and canon pinned to a commit, the owner note, the study reports, and the research works the reading surfaces cite.

#>src_spw_registry
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!mixed
#:review #!adversarial_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "repository rows re-read at commit 1aa1dc23 on 2026-10-02; locators give the file, and claims quote the path:line they use",
  "Crossref records matched on 2026-10-02 for Brysbaert 2019 and Kennedy 2010; the rest come from the writer and the study reports",
  "Crossref records matched on 2026-10-03 for Alter 2007 and Meyer 2015, and the Meyer abstract read from PubMed record 25844628",
  "the fact check of 2026-10-03 found every research row a real work and confirmed the repository and canon locators it sampled"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r8"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r9"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the tokens study gave v0.1 Spw.x as index only; v0.1 itself is split, index in CHANGELOG.md:25 and linkage in dialects/PHASES.md:176",
  "the render study placed the canon hold role at flow-protocol-sigils.spw:38; at 1aa1dc23 it sits at :40",
  "the study reports labeled cut rules and the owner note as canon; rows here keep three labels: a-canon, a-cut, and owner hold",
  "Kennedy units-of-measure chapter is dated 2010 in LNCS 6299, from the 2009 Central European Functional Programming School",
  "the CLI, LSP, and history rows now name 651b535b too, since c79a096a changed how census and graph resolve links and 6690d686 taught the LSP to index lens readings",
  "the disfluency counter cited Diemand-Yauman 2011, a study of retention in learning; the reasoning claim Meyer failed to replicate is Alter, Oppenheimer, Epley, and Eyre 2007, now its own row",
  "the scorecard locator covered only lines 6-39; the tree-wide handle and lens counts sit at lines 154-155",
  "the keyboard row named one French AZERTY layout; the Microsoft page lists the legacy 0000040C beside the AFNOR standard 0001040C",
  "the NVDA row named a user guide version that was never checked; the row now names only the symbol file read"
 ]
 added: "the 2026-10-03 entries for the canonical seed modules, the dialect registry, the Microsoft layout pages, and the NVDA symbol file were read at their locators on that date"
 groups: #[ repository, canon, owner, studies, research ]
}

