# Sources: Trails
#
# Bibliography anchors for the trails apparatus. Trail claims link here; each entry names a work a reader can find by title, author, year, and venue, or a repository file by its path.

#>registry_src_trails
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!mixed
#:review #!adversarial_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "journal entries with a doi were matched against Crossref records on 2026-10-03",
  "book entries come from the writer; the 2026-10-03 fact check confirmed each by title, author, year, and publisher",
  "repository entries were read at their locators on 2026-10-03 on main after 651b535b"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the COPE retraction guidance appeared in several journals in 2009 and 2010; this entry names the Maturitas printing that Crossref returned",
  "Mayr wrote both a 1970 MIT Press book and a 1970 Scientific American article titled The Origins of Feedback Control; claims here cite the article",
  "fact-check 2026-10-03: the first-contact pause cited a retrieval study for spacing; Cepeda and colleagues 2006, matched against Crossref on 2026-10-03, now carries spacing",
  "fact-check 2026-10-03: the Strathern entry gains the DOI Crossref returns for it"
 ]
 groups: #[ repository, trail_form, attention, control_and_information, reading_numbers, method ]
}

^["repository"]{
 #>src_trail_cut_contract
 ^["cut_contract"]{ title: "Cut contract 2026-09-30: graph, arcs, voice, and ethics frames", authors: "spw-workbench", year: 2026, locator: ".spw/caches/2026-09-30/contract.spw", kind: #repository }
