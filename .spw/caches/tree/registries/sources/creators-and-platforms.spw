# Sources: Creators and Platforms
#
# Bibliography anchors for authorship, broadcast, streaming, and live platforms. Claims link here; each entry names a work or page a reader can find.

#>registry_src_creators_and_platforms
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!practitioner
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r5"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r6"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 fact_check: "a later pass on 2026-10-02 re-read the KDP list price page, the IAB version table, the EPUB 3.3 status line, and the Musical.ly, Periscope, TikTok, and Twitch Plays Pokemon entries"
 adversarial_check: "the r5 pass re-read the Virtual Items Policy, the KDP royalty and ranking pages, the IDPF EPUB 3.0 page, and the TikTok, Twitch, Musical.ly, VidCon, Will Wight, LitRPG, and BookTok entries; the TikTok 2022 newsroom post could not be read"
 tiers: "primary pages and works first; encyclopedia entries are marked kind encyclopedia and carry an accessed date"
 accessed_note: "web pages were read on 2026-10-01; every platform page and encyclopedia entry was read again on 2026-10-02 except the FTC pages and entries carrying verify; help pages change without notice"
 doi_note: "the DOIs for Seering 2017, Titze 2003, Hockx 2015, and Bonner 2007 resolved to their publishers on 2026-10-02"
 unverified: "an entry carrying verify could not be fetched for this cut; no claim leans on it alone except the 2022-11-23 host age change in the moderation ledger, which carries an access caveat and keeps its cell verify"
}

