  publisher: "Government of India", year: 1897, kind: #statute
  note: "defines the financial year as the year commencing on 1 April"
 }
 #>src_season_au_aia_1901
 ^["au_aia_1901"]{
  title: "Acts Interpretation Act 1901 (Cth), section 2B"
  publisher: "Parliament of Australia", year: 1901, kind: #statute
  note: "defines the financial year as a period of 12 months beginning on 1 July"
 }
 #>src_season_nz_matariki_2022
