  publisher: "Parliament of Canada", year: 1985, kind: #statute
  note: "defines the federal fiscal year as 1 April to 31 March"
 }
 #>src_season_uk_calendar_act_1750
 ^["uk_calendar_act_1750"]{
  title: "Calendar (New Style) Act 1750 (24 Geo. II c. 23)"
  publisher: "Parliament of Great Britain", year: 1751, kind: #statute
  note: "moved Britain and its colonies to the Gregorian calendar, dropping eleven days in September 1752 and starting the legal year on 1 January"
 }
 #>src_season_japan_public_finance_1947
 ^["japan_public_finance_1947"]{
  title: "Public Finance Act (Act No. 34 of 1947), Article 11"
  publisher: "Government of Japan", year: 1947, kind: #statute
  note: "the state fiscal year begins 1 April and ends 31 March"
 }
 #>src_season_india_gca_1897
