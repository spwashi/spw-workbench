^["statutes"]{
 #>src_season_usc31_1102
 ^["usc31_1102"]{
  title: "United States Code, Title 31, Section 1102: Fiscal year"
  locator: "31 U.S.C. 1102", publisher: "Office of the Law Revision Counsel, US House of Representatives", year: 1982, kind: #statute
  note: "states that the Treasury fiscal year runs 1 October to 30 September"
 }
 #>src_season_cbica_1974
 ^["cbica_1974"]{
  title: "Congressional Budget and Impoundment Control Act of 1974"
  locator: "Pub. L. 93-344, 88 Stat. 297", year: 1974, kind: #statute
  note: "moved the federal fiscal year start to 1 October, with a transition quarter from 1 July to 30 September 1976"
 }
 #>src_season_usc5_6103
 ^["usc5_6103"]{
  title: "United States Code, Title 5, Section 6103: Holidays"
  locator: "5 U.S.C. 6103(a)", publisher: "Office of the Law Revision Counsel, US House of Representatives", year: 1966, kind: #statute
  note: "lists Thanksgiving Day as the fourth Thursday in November"
 }
 #>src_season_usc2_7
 ^["usc2_7"]{
  title: "United States Code, Title 2, Section 7: Time of election"
  locator: "2 U.S.C. 7", year: 1872, kind: #statute
  note: "sets federal elections on the Tuesday next after the first Monday in November of even years"
 }
 #>src_season_usc15_260a
 ^["usc15_260a"]{
  title: "United States Code, Title 15, Section 260a: Advancement of time or changeover dates"
  locator: "15 U.S.C. 260a, as amended by the Energy Policy Act of 2005, Pub. L. 109-58, sec. 110", year: 2005, kind: #statute
  note: "daylight saving time from the second Sunday of March to the first Sunday of November, effective 2007"
 }
 #>src_season_eu_2000_84
 ^["eu_2000_84"]{
  title: "Directive 2000/84/EC of the European Parliament and of the Council on summer-time arrangements"
  locator: "Official Journal of the European Communities L 31, 2 February 2001", year: 2001, kind: #statute
  note: "summer time ends at 01:00 UTC on the last Sunday in October"
 }
 #>src_season_usc17_copyright
 ^["usc17_copyright"]{
  title: "United States Code, Title 17: Copyright, Sections 104A, 304, 305 and 1401"
  locator: "17 U.S.C. 104A, 304(a)-(b), 305, 1401", publisher: "US Copyright Office", year: 2018, kind: #statute
  note: "95-year term for works published 1923 to 1963 with notice and a timely renewal, and for works published 1964 to 1977 with notice, renewal being automatic"
  note_terms: "terms run to 31 December of the final year; foreign works restored under section 104A keep the term they would have had; pre-1972 sound recordings published 1923 to 1946 are protected for 100 years"
 }
 #>src_season_renewal_act_1992
 ^["renewal_act_1992"]{
  title: "Copyright Renewal Act of 1992 (Copyright Amendments Act of 1992, Title I)"
  locator: "Pub. L. 102-307, title I, sec. 102(a), 106 Stat. 264", year: 1992, kind: #statute
  note: "made the renewal term automatic for copyrights secured from 1 January 1964 to 31 December 1977"
 }
 #>src_season_ctea_1998
 ^["ctea_1998"]{ title: "Sonny Bono Copyright Term Extension Act", locator: "Pub. L. 105-298, 112 Stat. 2827", year: 1998, kind: #statute }
 #>src_season_mma_2018
 ^["mma_2018"]{
  title: "Orrin G. Hatch-Bob Goodlatte Music Modernization Act, Title II: Classics Protection and Access Act"
  locator: "Pub. L. 115-264, 132 Stat. 3676, codified at 17 U.S.C. 1401", year: 2018, kind: #statute
  note: "Title II absorbed the stand-alone CLASSICS Act bill, H.R. 3301 and S. 2393; the enacted short title is the Classics Protection and Access Act"
 }
 #>src_season_uk_ita_2007
 ^["uk_ita_2007"]{
  title: "Income Tax Act 2007 (c. 3), section 4"
  publisher: "UK Parliament", year: 2007, kind: #statute
  note: "defines the income tax year as beginning on 6 April"
 }
 #>src_season_uk_interpretation_1978
 ^["uk_interpretation_1978"]{
  title: "Interpretation Act 1978 (c. 30), Schedule 1"
  publisher: "UK Parliament", year: 1978, kind: #statute
  note: "defines the financial year for central finance as the twelve months ending with 31 March"
 }
 #>src_season_ca_faa
