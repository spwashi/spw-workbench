# Sources: Materials and Engineering
#
# Bibliography anchors for the materials and engineering branches. Claims link here; each entry names a work a reader can find by title, author, year, and venue.

#>src_mateng_registry
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!mixed
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "claude-opus-5.5", care: #read, outcome: #raw }
  ^["r2"]{ event: #fact_checked, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #partial }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 checked: "most journal entries were matched against Crossref metadata and most book editions against Open Library on 2026-10-01; the rest come from the writer and keep the registry at spot_checked"
 fact_check: "on 2026-10-02 a fact-checker matched about 170 entries against bibliographic records and found one error, the CRC editor; the 97th edition of 2016 was edited by William M. Haynes, and Rumble edits from the 98th"
 added: "the 2026-10-02 additions were matched against Crossref, the NBER record, Open Library, or the Handbook of Mineralogy entry before entry"
 economics: "Goetzmann 2004, Sigler 2002, Wellington 1887, Grant 1930, and Weingartner 1963 were added for the engineering economics leaf after matching NBER and Open Library records on 2026-10-02; the 2026-10-03 fact-check compared them with known bibliographic records, not live fetches, and found no errors"
 second_fact_check: "on 2026-10-03 a second fact-check found a withdrawn standard edition and two missing companion papers; the additions below were matched against Crossref, OpenAlex, the EVS catalog, or the IAPWS release scan that day; the Oktaviana abstract was read from OpenAlex"
 corrections: #[
  "the CRC Handbook 97th edition of 2016 names William M. Haynes as editor, not John R. Rumble",
  "EN 10088-1:2014 was withdrawn when EN 10088-1:2023 was published; the entry now names the current edition and says which edition the definition was read in",
  "the current-source companion to Johnson 2003, Proceedings of the IEEE 91(5):817-821, is added beside the voltage-source paper",
  "the correlated-insulator companion to Cao 2018, Nature 556:80-84, is added beside the superconductivity paper",
  "Oktaviana and coworkers 2026 is added; its Muna hand stencil, at least 67.8 thousand years old, is far older than the 2014 Maros stencil",
  "the Anderson, Charles, and Rees entry now records that the published abstract finds filtration tied to lower infant mortality, unlike the 2018 working paper",
  "IAPWS R2-83(1992) is added for the uncertainty of the water critical point"
 ]
 groups: #[ matter_and_structure, material_histories, engineering ]
}

