# Language and Mind Glossary
#
# The Micropaedia for cognition and linguistics: seven terms, how they nest, and which leaves put each one to work.

#>language_and_mind_glossary
#:layer #!reference
#:domain #!language_and_mind
#:form #!glossary
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Language and Mind Glossary"
 ~#claim: "Seven terms carry most work in this class: representation, heuristic, phoneme, morpheme, implicature, variable, and register."
 ~#proof: "Glosses follow Marr, Tversky and Kahneman, Ladefoged and Johnson, Haspelmath and Sims, Grice, Labov, and Biber and Conrad."
 ~#door: "Start with representation, then follow phoneme and morpheme into the linguistics leaves."
 ~#audience: "readers entering cognition or linguistics from any direction"
 continuity: "Language and Mind Glossary | seven terms"
 cold_open: "Seven terms carry this class, from a representation in the mind to the register a speaker picks for the room."
}

