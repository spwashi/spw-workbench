^["edges"]{
 see: [ ~"./linguistics/phonetics-and-phonology.spw#linguistics_phonology", ~"./linguistics/sociolinguistics-and-documentation.spw#linguistics_sociolinguistics" ]
}

^["concepts"]{
 primary: [ #representation, #morpheme, #implicature ]
 transfers: [ #variation, #distinctive_feature ]
 tensions: [ #default_inference ]
}

^["lattice"]{
 #>language_and_mind_term_representation
 ^["representation"]{
  gloss: "a state of a mind or machine that stands for something and is used in processing it, such as an edge map in vision or a phoneme in speech"
  levels: << "computational: what is computed and why" ; "algorithmic: which representation and procedure" ; "implementational: how a brain or device realizes it" >>
  narrower: [ ~"./language-and-mind-glossary.spw#language_and_mind_term_phoneme", ~"./language-and-mind-glossary.spw#language_and_mind_term_morpheme" ]
  source: ~"../registries/sources/language-and-communities.spw#src_lang_marr_1982"
 }
 #>language_and_mind_term_heuristic
 ^["heuristic"]{
  gloss: "a fast rule of thumb for judgment under uncertainty, such as judging frequency by how easily cases come to mind"
  example: "availability, representativeness, and anchoring, each useful and each producing predictable biases"
  see: [ ~"./language-and-mind-glossary.spw#language_and_mind_term_implicature" ]
  used_in: [ ~"./cognition/reasoning-and-decision.spw#cognition_reasoning" ]
  source: ~"../registries/sources/language-and-communities.spw#src_lang_tversky_kahneman_1974"
 }
 #>language_and_mind_term_phoneme
 ^["phoneme"]{
  gloss: "a contrastive sound category of one language, found by minimal pairs; its variants by context are allophones"
  example: "pin and bin differ in one phoneme; the aspirated p of pin and the plain p of spin are allophones of one phoneme"
  broader: [ ~"./language-and-mind-glossary.spw#language_and_mind_term_representation" ]
  used_in: [ ~"./linguistics/phonetics-and-phonology.spw#linguistics_phonology_phoneme" ]
  source: ~"../registries/sources/language-and-communities.spw#src_lang_ladefoged_johnson_2015"
 }
 #>language_and_mind_term_morpheme
 ^["morpheme"]{
  gloss: "the smallest unit pairing form with meaning or grammatical function, free like cat or bound like the plural s"
  example: "unhappiness has three morphemes: un, happy, and ness"
  broader: [ ~"./language-and-mind-glossary.spw#language_and_mind_term_representation" ]
  used_in: [ ~"./linguistics/morphology-and-syntax.spw#linguistics_syntax_morpheme_types" ]
  source: ~"../registries/sources/language-and-communities.spw#src_lang_haspelmath_sims_2010"
 }
 #>language_and_mind_term_implicature
 ^["implicature"]{
  gloss: "what a speaker conveys beyond what the words entail, inferred by assuming the speaker is cooperative, and cancellable"
  example: "some of the students passed usually conveys that not all did"
  see: [ ~"./language-and-mind-glossary.spw#language_and_mind_term_heuristic" ]
  used_in: [ ~"./linguistics/semantics-and-pragmatics.spw#linguistics_semantics_implicature" ]
  source: ~"../registries/sources/language-and-communities.spw#src_lang_grice_1975"
 }
 #>language_and_mind_term_variable
 ^["variable"]{
  gloss: "in sociolinguistics, a set of alternative ways of saying the same thing whose rates shift with speaker, group, and setting"
  example: "pronouncing or dropping r after a vowel in New York City English"
  distinct_from: "a variable in mathematics or code names a value; a sociolinguistic variable names a choice among variants"
  see: [ ~"./language-and-mind-glossary.spw#language_and_mind_term_register" ]
  relation_note: "variables shift across registers, and a register is marked by co-occurring variants; neither term is narrower than the other"
  used_in: [ ~"./linguistics/sociolinguistics-and-documentation.spw#linguistics_sociolinguistics_variable" ]
  source: ~"../registries/sources/language-and-communities.spw#src_lang_labov_1966"
 }
 #>language_and_mind_term_register
 ^["register"]{
  gloss: "a variety defined by its situation of use, such as a lecture, a text message, or a sports commentary, rather than by who is speaking"
  distinct_from: "a dialect varies with the speaker group; a register varies with the situation, and one speaker commands many"
  see: [ ~"./language-and-mind-glossary.spw#language_and_mind_term_variable" ]
  source: ~"../registries/sources/language-and-communities.spw#src_lang_biber_conrad_2009"
 }
}

#>language_and_mind_glossary_shortcut_q
?["Is a judgment heuristic the same kind of shortcut as a conversational implicature?"]{
 #:depth #!computational ~#lens(information flow)
 #:claim #!speculative
 ~#hypothesis: "Both trade exactness for speed by leaning on expectations about the world or the speaker, so both fail most where those expectations are violated."
 breaks: "a heuristic is graded against probability norms for one judge; an implicature is graded against cooperative norms shared by two people"
 !probe{ "pair five heuristic studies with five implicature studies and list what counts as an error in each" =id[p_lang_glossary_shortcuts] =kind[lit] }
 ~"./language-and-mind-glossary.spw#language_and_mind_term_heuristic" ~#neighbor(nearest)
}
