# Cognitive Development
#
# A timeline from Piaget and Vygotsky to core knowledge and false-belief research, then a ledger of what holds: shared trajectories, timing that varies by task and culture, and abilities that peak at different ages.

#>cognition_development
#:layer #!reference
#:domain #!cognition
#:form #!timeline
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bonk
#:era #!modern

^"emit"{
 ~#title: "Cognitive Development"
 ~#claim: "Children's thinking changes along trajectories shared across cultures, but timing shifts with task, language, and community, and adult abilities peak at different ages."
 ~#proof: "Piaget, Vygotsky, and Wood, Bruner, and Ross on construction and scaffolding; Wimmer and Perner and the meta-analyses of Wellman and Liu on false belief; Watts on the marshmallow test; Hartshorne and Germine on peaks."
 ~#door: "Climb the timeline first, then read the ledger, especially the false-belief entries."
 ~#audience: "students, teachers, and parents reading as observers, not assessors"
 continuity: "Cognitive Development | timing shifts"
 cold_open: "Children everywhere come to understand false beliefs, but the timing shifts with the task, the language, and the community."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/cognitive-psychology/cognitive-development-and-language.spw" ]
 evidence: #[ "Europe PMC abstracts read 2026-10-02 for Wellman 2001, Liu 2008, Onishi and Baillargeon 2005, Kulke 2018, Watts 2018, Mischel 1989, Hartshorne and Germine 2015, and Spelke and Kinzler 2007" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03",
   agent: "claude-opus-5.5 fact-checker", care: #adversarial, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the raw wonder said children pass false-belief tasks at almost exactly 48 months across cultures; timing varies by task, country, and community, and the claim is recorded as refuted (raw line 39)",
  "the raw shift between 3.5 and 4.5 years is replaced by the meta-analytic picture of a shared trajectory with varying timing (raw line 28)",
  "scaffolding is credited to Wood, Bruner, and Ross in 1976, not to Bruner alone (raw line 21)",
  "the marshmallow test is no longer taught as a stable predictor; the 2018 replication is cited (raw line 29)",
  "the raw said fluid intelligence peaks in the early twenties; different abilities peak at different ages (raw line 32)",
  "the raw rTPJ maturation hypothesis stated a biological cause as fact; it is dropped, and the wonder below asks about experience instead (raw line 41)",
  "2026-10-03 fact-check: the infant entry linked Kulke 2018 as a counter as if it retested Onishi and Baillargeon; it tested anticipatory looking, not violation of expectation, and the entry now says so"
 ]
}

