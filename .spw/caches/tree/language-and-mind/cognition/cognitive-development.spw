}

^["scope"]{
 #>cognition_development_guard
 ^["guard"]{
  #:valence #!honk
  warning: "ages here are population tendencies from studies, never a standard to judge a particular child; children vary widely, and concerns about a child belong with a qualified professional"
 }
 not_advice: "educational reference under the living class rule; nothing here is a developmental assessment or parenting advice"
}

^["timeline"]{
 #>cognition_development_piaget
 ^["piaget"]{
  #:claim #!settled
  statement: "Piaget described children building schemes, assimilating experience to them and accommodating them when experience does not fit, through sensorimotor, preoperational, concrete, and formal stages."
  source: ~"../../registries/sources/life-and-mind.spw#src_life_piaget_1952"
  era: 1936
 }
 #>cognition_development_vygotsky
 ^["vygotsky"]{
  #:claim #!settled
  statement: "Vygotsky argued that higher thinking first happens between people and is then internalized, and defined the zone of proximal development as the gap between what a child does alone and with guidance."
  source: ~"../../registries/sources/learning-and-generations.spw#src_learn_vygotsky_1978"
  era: 1934
 }
 #>cognition_development_scaffolding
 ^["scaffolding"]{
  #:claim #!settled
  statement: "Wood, Bruner, and Ross named scaffolding: a tutor takes over the parts of a task a child cannot yet manage and hands them back as competence grows."
  source: ~"../../registries/sources/learning-and-generations.spw#src_learn_wood_1976"
  era: 1976
 }
 #>cognition_development_false_belief
 ^["unexpected_transfer"]{
  #:claim #!settled
  statement: "Wimmer and Perner asked children where a boy would look for chocolate moved while he was away; younger preschoolers mostly named the new place, and older children increasingly named where he left it."
  source: ~"../../registries/sources/life-and-mind.spw#src_life_wimmer_perner_1983"
  era: 1983
 }
 #>cognition_development_sally_anne
 ^["sally_anne"]{
  #:claim #!settled
  statement: "Baron-Cohen, Leslie, and Frith introduced the doll version known as the Sally-Anne task."
  source: ~"../../registries/sources/life-and-mind.spw#src_life_baron_cohen_1985"
  era: 1985
 }
 #>cognition_development_meta
 ^["shared_trajectory"]{
  #:claim #!settled
  statement: "A meta-analysis of 178 studies found preschoolers moving from below-chance to above-chance false-belief answers in every country sampled, with country and task features shifting when."
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_wellman_2001"
  era: 2001
 }
 #>cognition_development_infant
 ^["infant_looking"]{
  #:claim #!contested
  statement: "Onishi and Baillargeon reported that fifteen-month-olds looked longer when an actor searched where her belief should not lead her; implicit measures are contested: a preregistered replication of four anticipatory-looking tasks, a different paradigm, largely failed."
  source: ~"../../registries/sources/life-and-mind.spw#src_life_onishi_baillargeon_2005"
  counter: ~"../../registries/sources/life-and-mind.spw#src_life_kulke_2018"
  counter_scope: "Kulke and colleagues tested anticipatory-looking tasks, not the violation-of-expectation looking-time paradigm Onishi and Baillargeon used, so this counter bears on implicit measures as a class and does not test this result directly"
  era: 2005
 }
 #>cognition_development_china
 ^["timing_by_community"]{
  #:claim #!settled
  statement: "Comparing more than three thousand Chinese children with North American samples, a meta-analysis found parallel trajectories, but timing that differed across locales by two years or more."
  source: ~"../../registries/sources/life-and-mind.spw#src_life_liu_2008"
  era: 2008
 }
 #>cognition_development_core
 ^["core_knowledge"]{
  #:claim #!contested
  statement: "Spelke and Kinzler propose that infants start with core systems for objects, actions, number, and space, and perhaps social partners, a nativist alternative to Piaget's construction from action."
  source: ~"../../registries/sources/life-and-mind.spw#src_life_spelke_kinzler_2007"
  counter: ~"../../registries/sources/life-and-mind.spw#src_life_piaget_1952"
  era: 2007
 }
 #>cognition_development_peaks
 ^["asynchronous_peaks"]{
  #:claim #!settled
  statement: "Abilities peak at different ages: some around the end of high school, some plateau in early adulthood and decline from the thirties, and others, including vocabulary, not until the forties or later."
  source: ~"../../registries/sources/life-and-mind.spw#src_life_hartshorne_germine_2015"
  era: 2015
 }
 order: << "Vygotsky" ; "Piaget" ; "scaffolding" ; "unexpected transfer" ; "Sally-Anne" ; "shared trajectory" ; "infant looking" ; "timing by community" ; "core knowledge" ; "asynchronous peaks" >>
}

^["ledger"]{
 #>cognition_development_stage_ages
 ^["stage_ages"]{
  #:claim #!contested
  statement: "Piaget's stage ages are now read as typical rather than fixed; studies of infants and of children elsewhere find some abilities earlier or later than his tasks implied."
  sources: [ ~"../../registries/sources/life-and-mind.spw#src_life_spelke_kinzler_2007", ~"../../registries/sources/life-and-mind.spw#src_life_liu_2008" ]
  counter: ~"../../registries/sources/life-and-mind.spw#src_life_piaget_1952"
 }
 #>cognition_development_raw_48
 ^["raw_forty_eight_months"]{
  #:claim #!refuted
  statement: "The raw claim that children pass false-belief tasks at almost exactly four years across cultures is wrong: the trajectory is shared, but timing varies by task, country, and community."
  sources: [ ~"../../registries/sources/provenance-and-reference.spw#src_prov_wellman_2001", ~"../../registries/sources/life-and-mind.spw#src_life_liu_2008" ]
 }
 #>cognition_development_marshmallow
 ^["delay_of_gratification"]{
  #:claim #!contested
  statement: "Mischel reported that preschoolers who waited longer became more competent adolescents; a larger, more diverse replication found the link half as strong and cut by two thirds after background controls."
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_watts_2018"
  counter: ~"../../registries/sources/life-and-mind.spw#src_life_mischel_1989"
 }
 #>cognition_development_reading
 ^["learning_to_read"]{
  #:claim #!settled
  statement: "In an alphabetic writing system such as English, early reading depends on learning how letters map to sounds, so phonics instruction is central, while skilled reading also needs vocabulary and comprehension."
  source: ~"../../registries/sources/learning-and-generations.spw#src_learn_castles_2018"
 }
 =~"./cognitive-development.spw#cognition_development_china"[extends]{ ~"./cognitive-development.spw#cognition_development_meta" }
 =~"./cognitive-development.spw#cognition_development_raw_48"[contrasts]{ ~"./cognitive-development.spw#cognition_development_china" }
}

#>cognition_development_talk_q
?["Why would the same understanding arrive at different ages in different places?"]{
 #:depth #!social ~#lens(social fabric)
 #:claim #!speculative
 ~#hypothesis: "Talk about thoughts, wants, and beliefs in a child's home and language may speed the shift, so communities with more everyday mental-state talk should show earlier false-belief success."
 !probe{ "list cross-cultural false-belief studies that also measured family talk about minds and compare timing with talk frequency" =id[p_life_cog_mind_talk] =kind[lit] }
 ~"./cognitive-development.spw#cognition_development_china" ~#neighbor(nearest)
}

#>cognition_development_succession_q
?["Is a developmental stage like a successional stage in a forest?"]{
 #:depth #!educational ~#lens(living system)
 #:claim #!speculative
 ~#hypothesis: "Both describe ordered change in which each phase prepares conditions for the next, so both should show a typical sequence with timing set by local conditions."
 breaks: "a burned forest can restart its sequence and take a different path, while a child does not return to an earlier stage, and a child is not a community of competing species"
 !probe{ "set the false-belief meta-analyses beside a succession chronosequence and list what each calls a stage, a trigger, and a delay" =id[p_life_cog_stage_succession] =kind[thought] }
 ~"../../living/development-and-ecology/development-as-succession.spw#development_ecology_parallels" ~#neighbor(nearest)
}
