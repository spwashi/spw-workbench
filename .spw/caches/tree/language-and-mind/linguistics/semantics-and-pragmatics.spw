# Semantics and Pragmatics
#
# A lattice of terms for how sentence meaning is composed from typed parts and how speakers mean more than they say.

#>linguistics_semantics
#:layer #!reference
#:domain #!linguistics
#:form #!glossary
#:level #!advanced
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Semantics and Pragmatics"
 ~#claim: "Typed composition explains what sentences say, and implicature and presupposition explain what speakers convey beyond it."
 ~#proof: "Types from Montague and Heim and Kratzer; implicature from Grice and Horn; presupposition from Karttunen, Stalnaker, and Lewis."
 ~#door: "Start at composition, follow the lattice down to the determiner type, then cross to implicature."
 ~#audience: "readers comfortable with sets, functions, and introductory syntax"
 continuity: "Semantics and Pragmatics | typed composition"
 cold_open: "Typed composition tells you what a sentence says, and pragmatics tells you what the speaker meant by saying it."
}

