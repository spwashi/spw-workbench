# Moving-Image Carriers
#
# Carriers for moving pictures and the photochemistry that writes on them: film gauges and bases, emulsions, processing, and videotape.

#>media_carriers_moving_image_index
#:layer #!reference
#:domain #!media_carriers
#:form #!index
#:level #!intro
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Moving-Image Carriers"
 ~#claim: "Moving pictures were stored on two kinds of carrier before files: a chemical image in silver and dye on film, and a magnetic signal on videotape."
 ~#proof: "Four leaves cite gauge histories, the photographic-process literature, Kodak process manuals, and television histories through the registry."
 ~#door: "Start with film stock and bases, then choose emulsion and processing or jump to videotape."
 ~#audience: "readers new to film and video history, students, and anyone holding old reels or tapes"
 continuity: "Moving-Image Carriers | silver and dye"
 cold_open: "Before files, moving pictures lived as silver and dye on film or as a magnetic signal on tape."
}

