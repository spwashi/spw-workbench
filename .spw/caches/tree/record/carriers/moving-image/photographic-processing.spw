^["edges"]{
 needs: [ ~"./emulsion-chemistry.spw#media_carriers_emulsion" ]
 grounds: [ ~"../../../registries/quantities/physical-sciences-and-image.spw#q_phys_process" ]
 see: [ ~"../../../physical/chemistry/chemistry-core.spw#chemistry_core_general" ]
}

^["concepts"]{
 primary: [ #state_machine, #sensitometry, #silver_halide ]
 transfers: [ #standards, #feedback ]
 tensions: [ #fidelity ]
}

^["development"]{
 #>media_carriers_processing_redox
 ^["selective_reduction"]{
  #:claim #!settled
  statement: "A developer reduces silver halide to metallic silver far faster in grains that carry a latent image, so exposure decides which grains turn black."
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_james_1977"
 }
 #>media_carriers_processing_superadditive
 ^["superadditivity"]{
  #:claim #!settled
  statement: "Pairs such as metol or phenidone with hydroquinone develop faster together than the sum of each alone; sulfite protects the developer, alkali activates it, and bromide restrains fog."
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_james_1977"
 }
 #>media_carriers_processing_temperature
 ^["temperature_control"]{
  #:claim #!settled
  statement: "Color processes hold developer temperature to a tight tolerance because the three dye layers respond differently to drift, shifting color balance as well as density."
  sources: [ ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_kodak_h2407", ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_kodak_z131" ]
 }
}

^["processes"]{
 #>media_carriers_processing_bw
 ^["bw_negative"]{
  path: << "develop" ; "stop" ; "fix" ; "wash" ; "dry" >>
  on_fix: ?match[clearing]{
   "film clear" => ![wash],
   "milky" => ![fix_longer],
   _ => ![check_fixer]
  }
  note: "fixer dissolves the undeveloped halide; washing removes fixer that would later stain"
 }
 #>media_carriers_processing_c41
 ^["c41"]{
  #:claim #!settled
  statement: "C-41 color negative processing runs developer, bleach, wash, fixer, wash, and stabilizer, with the developer at 37.8 C for 3 minutes 15 seconds."
  reads: %[phys.process.c41_dev_c, phys.process.c41_dev_min]
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_kodak_z131"
  path: << "developer" ; "bleach" ; "wash" ; "fixer" ; "wash" ; "stabilizer" >>
 }
 #>media_carriers_processing_ecn2
 ^["ecn2"]{
  #:claim #!settled
  statement: "ECN-2 motion-picture negative processing starts with a prebath and remjet removal, then develops at 41.1 C for 3 minutes before stop, bleach, fix, and final rinse."
  reads: %[phys.process.ecn2_dev_c, phys.process.ecn2_dev_min]
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_kodak_h2407"
  path: << "prebath" ; "remjet removal and rinse" ; "developer" ; "stop" ; "wash" ; "bleach" ; "wash" ; "fixer" ; "wash" ; "final rinse" >>
  ~#say(strip the black backing first, then develop warm)
 }
 #>media_carriers_processing_e6
 ^["e6"]{
  #:claim #!settled
  statement: "E-6 reversal starts with a black-and-white first developer near 38 C for 6 minutes, then a reversal bath and color developer form positive dyes before bleach and fix."
  reads: %[phys.process.e6_fd_c, phys.process.e6_fd_min]
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_kodak_z119"
  path: << "first developer" ; "wash" ; "reversal bath" ; "color developer" ; "pre-bleach" ; "bleach" ; "fixer" ; "wash" ; "final rinse" >>
  as_of: "first-developer tolerance is a verify cell; it differs by processor type"
 }
 #>media_carriers_processing_bw_reversal
 ^["bw_reversal"]{
  #:claim #!settled
  statement: "Black-and-white reversal develops a negative, bleaches that silver away, fogs the remaining halide by light or chemistry, and develops it into a positive."
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_james_1977"
  path: << "first developer" ; "bleach" ; "clear" ; "re-expose" ; "second developer" ; "wash" >>
 }
}

^["control"]{
 #>media_carriers_processing_density
 ^["optical_density"]{
  #:claim #!settled
  statement: "Optical density is the base-ten logarithm of incident over transmitted light, so densities of stacked layers add; Hurter and Driffield plotted density against log exposure in 1890."
  sources: [ ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_hurter_driffield_1890", ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_james_1977" ]
 }
 #>media_carriers_processing_iso52
 ^["iso_5_2"]{
  #:claim #!settled
  statement: "Transmittance density depends on how light is collected, so ISO 5-2 fixes the geometric conditions for diffuse transmission density; ISO 5-4 covers reflection."
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_iso_5_2"
  as_of: "2009 edition; later revisions to verify"
 }
 #>media_carriers_processing_curve
 ^["characteristic_curve"]{
  #:claim #!settled
  statement: "The characteristic curve rises from base plus fog through a toe, a straight portion whose slope is gamma, and a shoulder where highlights compress."
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_james_1977"
 }
 #>media_carriers_processing_control_strip
 ^["control_strips"]{
  #:claim #!interpretive
  statement: "A lab reads pre-exposed control strips each shift and acts on the drift it sees, so the process is a feedback loop around a chemical machine."
  on_strip: ?match[control_strip]{
   "in tolerance" => ![run],
   "density high" => ![check_temperature_and_time],
   "density low" => ![check_replenishment],
   "color shifted" => ![check_developer_balance],
   _ => ![hold_production]
  }
 }
 #>media_carriers_processing_push
 ^["push_and_pull"]{
  #:claim #!settled
  statement: "Pushing extends development to raise midtone density and contrast for underexposed film, with more grain and little gain in deep shadows; pulling does the reverse."
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_james_1977"
 }
}

^["try"]{
 #>media_carriers_processing_try_density
 ^["tracing_paper_wedge"]{
  materials: [ "a pad of tracing paper", "a phone flashlight", "a second phone or camera with a light meter app" ]
  steps: << "stack zero to eight sheets in a staircase" ; "shine the flashlight through each step" ; "read the light behind each step" ; "plot the log of the readings against sheet count" ; "check that each sheet subtracts about the same log amount" >>
  time: .{ n: 30, unit: "minutes" }
  safety: "do not stare into the flashlight; no other hazard worth naming"
  shows: ~"./photographic-processing.spw#media_carriers_processing_density"
 }
}

#>media_carriers_processing_drift_q
?["Why do color processes run at fixed warm temperatures, each its own?"]{
 #:depth #!physical ~#lens(molecular binding)
 #:claim #!speculative
 ~#hypothesis: "If each layer's development has its own activation energy, a small temperature error should tilt color balance, and the warmer processes should trade tighter tolerance for shorter times."
 !probe{ "fit Arrhenius rates to published time and temperature tables for each process and compare layer by layer" =id[p_phys_processing_drift] =kind[calc] }
 $%[phys.process.ecn2_dev_c, phys.process.c41_dev_c, phys.process.e6_fd_c]
 ~"./photographic-processing.spw#media_carriers_processing_temperature" ~#neighbor(nearest)
}
