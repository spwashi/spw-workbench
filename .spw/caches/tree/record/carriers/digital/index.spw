^"emit"{
 ~#title: "Digital Carriers"
 ~#claim: "Digital carriers store numbers instead of analog shapes, so an exact copy is possible, but reading it needs more machines, standards, and permissions."
 ~#proof: "Three leaves on optical discs, streaming, and reading devices, each linking dated standards and sources."
 ~#door: "Start with optical discs, then follow the stream, then the reading devices."
 ~#audience: "readers who own discs, stream daily, or read on screens"
 continuity: "Digital Carriers | exact copy"
 cold_open: "A digital carrier can make an exact copy, but reading that copy needs a longer chain of machines."
}

