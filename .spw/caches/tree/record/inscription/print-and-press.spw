# Print and Press
#
# From Tang woodblocks and Korean metal type to Gutenberg, the steam cylinder, the Linotype, offset lithography, and print on demand.

#>inscription_print
#:layer #!reference
#:domain #!inscription
#:form #!timeline
#:level #!intro
#:review #!adversarial_checked
#:valence #!bonk
#:era #!early_modern

^"emit"{
 ~#title: "Print and Press"
 ~#claim: "Printing began with East Asian woodblocks and metal type; Gutenberg combined a type mould, an alloy, oil ink, and a press into a European system around 1455."
 ~#proof: "Tsien on Chinese printing; UNESCO on Jikji; Kapr and Gaskell on Gutenberg; Moran and Kahan on the industrial press."
 ~#door: "Read the paper matrix next, then the carrier ladder."
 ~#audience: "readers curious how books came to be copied by machine"
 continuity: "Print and Press | East Asian woodblocks"
 cold_open: "Print began with East Asian woodblocks and metal type, then Mainz turned type, ink, and press into one machine."
}

