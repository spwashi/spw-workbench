# Record
#
# How people fix, copy, carry, and find what they know: inscription on surfaces, carriers that need machines, and the organization of information, with the missing kinds of record named as gaps.

#>record_index
#:layer #!reference
#:domain #!record
#:form #!index
#:level #!intro
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Record"
 ~#claim: "A record is a mark on a carrier that someone can find again; this class follows marks, carriers, and the orders that make them findable."
 ~#proof: "Branch leaves link sourced timelines for surfaces, print, paper, sound, film, discs, and streams, and protocols for classification and archives."
 ~#door: "Start with the glossary, then choose inscription, carriers, or information."
 ~#audience: "readers new to book history, media history, and library science"
 continuity: "Record | find again"
 cold_open: "A record is a mark on something durable that someone else can find again, long after you made it."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker", care: #skim, outcome: #pass }
 }
}

^["tree"]{
 glossary: ~"./record-glossary.spw"
 inscription: ~"./inscription/index.spw"
 carriers: ~"./carriers/index.spw"
 information: ~"./information/index.spw"
}

^["bundle"]{
 ={
  ~"./record-glossary.spw#record_glossary"
  ~"./inscription/index.spw#inscription_index"
  ~"./carriers/index.spw#media_carriers_index"
  ~"./information/index.spw#information_science_index"
 }
}

^["order"]{
 pmest: "personality by branch: inscription, carriers, information; matter in each leaf concepts frame; energy by form; time by era rungs"
 reading: << "glossary" ; "inscription" ; "carriers" ; "information" >>
 era_alignment: "inscription and carrier ladders share era rungs, so a reader can line up the codex, the press, and the disc"
}

^["ladder"]{
 ^["intro"]{
  rung: "surfaces, timelines, and keys you can use at home"
  stops: [ ~"./record-glossary.spw#record_glossary", ~"./inscription/surfaces-tablet-scroll-codex.spw#inscription_surfaces", ~"./carriers/form-factor-ladder.spw#media_carriers_ladder", ~"./carriers/media-object-dating.spw#media_carriers_object_dating" ]
 }
 ^["foundation"]{
  rung: "the chemistry and manufacture behind ink, paper, discs, and tape"
  stops: [ ~"./inscription/inks-and-inscription.spw#inscription_inks", ~"./inscription/paper-and-pulp-manufacture.spw#inscription_paper", ~"./carriers/carrier-manufacturing.spw#media_carriers_manufacturing", ~"./carriers/carrier-decay-and-fixity.spw#media_carriers_decay" ]
  needs: "school chemistry"
 }
 ^["advanced"]{
  rung: "dependencies, standards, and the orders that make records findable"
  stops: [ ~"./carriers/playback-dependency-dag.spw#media_carriers_playback_dag", ~"./carriers/digital/streaming-and-files.spw#media_carriers_streaming", ~"./information/knowledge-organization.spw#information_science_knowledge_org" ]
 }
}

^["gaps"]{
 #>record_gap_kinds
 ^["kinds_of_record"]{
  missing: [
   "music notation, from neumes to engraved scores",
   "cartography and the map as a record",
   "still photography from the daguerreotype to the image sensor",
   "broadcast radio and television, which transmit without a carrier",
   "microforms and storage media such as punched cards, floppy disks, hard drives, and flash",
   "Braille and other tactile writing"
  ]
  neighbors: "the carriers index names the storage gaps; the moving-image branch is the nearest home for photography"
 }
 #>record_gap_writing
 ^["writing_systems"]{
  missing: [
   "the scripts themselves, from cuneiform and Chinese characters to alphabets",
   "calligraphy as a craft across Arabic, East Asian, and Latin traditions"
  ]
  neighbors: "linguistics for scripts and the visual branch for calligraphy"
 }
}
