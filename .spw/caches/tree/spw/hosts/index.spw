# Editor Hosts
#
# What the VS Code, JetBrains, and Neovim plugins and the shared language server do today, read from their source at one commit and kept as residue under language scrutiny.

#>editor_hosts_index
#:layer #!reference
#:domain #!editor_hosts
#:form #!index
#:level #!practitioner
#:review #!sourced
#:valence #!bone
#:era #!current

^"emit"{
 ~#title: "Editor Hosts"
 ~#claim: "Each editor plugin renders Spw while the server knows its meaning, and every row here is read from source at one commit."
 ~#proof: "Rows cite file and line in the VS Code, IntelliJ, and Neovim extensions and in spw-lsp at commit 1aa1dc23."
 ~#door: "Start with the language server surface, then the parity matrix, then the defect ledger."
 ~#audience: "plugin maintainers and language designers checking what an editor really does"
 continuity: "Editor Hosts | the server knows"
 cold_open: "The editor paints the page while the server knows the language, and every row here comes from the code itself."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/vscode/taste.spw" ]
 method: #corrected
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "the canon line is advice, not a ban; the editor-truth trail was planned and not yet written when checked"
  }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: [
  "the raw taste said its principles are enforced in code reviews and test assertions; no test in the extensions asserts them, so the line is dropped",
  "the raw taste promised that decorations slower than 16 ms per frame are off by default; no such budget exists in the extension, so the line is dropped",
  "the raw wonders measured invented metrics such as a guidance score and a dismissal rate; they are replaced by one wonder whose handles resolve",
  "the doctrine claim said the VS Code canon forbids a second semantics stack; the canon line says contributions should not fork one",
  "the doors claim named the editor-truth trail as a door to this index; it was planned for wave 4 and absent when checked, and once written it stops at the host leaves, not here"
 ]
 kept: "the anti-echo idea from the raw taste file survives as a proposal for the host canon, credited to that file"
}

^["edges"]{
 grounds: [ ~"../../registries/quantities/spw-hosts-and-history.spw#q_hosts_lsp" ]
 see: [ ~".spw/tooling/vscode-spw.spw#spw_tooling_vscode", ~".spw/tooling/intellij-plugin.spw#spw_tooling_intellij" ]
}

^["concepts"]{
 primary: [ #thin_client, #cache_plane, #code_verified ]
 transfers: [ #parity_of_questions ]
 tensions: [ #editor_chrome ]
}

^["tree"]{
 lsp: ~"./lsp-surface.spw"
 vscode_commands: ~"./vscode-commands-and-views.spw"
 vscode_rendering: ~"./vscode-rendering.spw"
 vscode_lsp_cache: ~"./vscode-lsp-and-cache.spw"
 jetbrains_platform: ~"./jetbrains-platform.spw"
 jetbrains_native: ~"./jetbrains-native-features.spw"
 jetbrains_instruments: ~"./jetbrains-instruments.spw"
 parity: ~"./host-parity-matrix.spw"
 defects: ~"./known-defects.spw"
 radar: ~"./feature-radar.spw"
}

^["bundle"]{
 ={ ~"./lsp-surface.spw#editor_hosts_lsp" }
 ={ ~"./host-parity-matrix.spw#editor_hosts_parity" }
 ={ ~"./known-defects.spw#editor_hosts_defects" }
}

^["leaves"]{
 lsp: .{ concept: #thin_client, form: #registry }
 vscode_commands: .{ concept: #command_surface, form: #registry }
 vscode_rendering: .{ concept: #color_layer, form: #comparison }
 vscode_lsp_cache: .{ concept: #cache_plane, form: #state_machine }
 jetbrains_platform: .{ concept: #build_range, form: #registry }
 jetbrains_native: .{ concept: #line_regex, form: #registry }
 jetbrains_instruments: .{ concept: #saved_file_truth, form: #state_machine }
 parity: .{ concept: #parity_of_questions, form: #comparison }
 defects: .{ concept: #code_verified, form: #ledger }
 radar: .{ concept: #capability_gap, form: #registry }
}

^["standing"]{
 #>editor_hosts_index_residue
 ^["residue"]{
  #:claim #!settled
  statement: "The shelf index files the vscode and jetbrains caches under residue, and the owner's resume note asks readers to treat host-feature caches as residue."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_caches_index"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_resume_note" ]
  cites: [ ".spw/caches/index.spw:93-97", ".spw/caches/index.spw:135", ".spw/caches/resume/2026-09-30-direction.spw:69" ]
  provenance_label: "a-canon for the shelf index; owner hold for the resume note"
  ^["limits"]{
   holds: "for deciding what leads: language, mathematics, physics, linguistics, and attention lead; hosts follow"
   fails: "as a verdict on plugin quality; residue means the catalog follows the language, and the code rows below are still exact"
  }
 }
 #>editor_hosts_index_doors
 ^["doors"]{
  #:claim #!interpretive
  statement: "No door in the cut root opens on a host surface; a reader arrives from the spw class index or the plugin theory surface; the editor-truth trail walks the host leaves, not this index."
  trail_status: "plan v3 placed trails/editor-truth.spw in wave 4; it was absent when the fact check ran and was written later on 2026-10-03, with stops at the host leaves, not this index"
  root_status: "the cut root index is root apparatus for a later wave and did not exist when this page was revised"
  provenance_label: "a-cut rule from the final plan"
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_plan"
 }
}

^["doctrine"]{
 #>editor_hosts_index_server_knows
 ^["host_renders_server_knows"]{
  #:claim #!settled
  statement: "The VS Code canon says contributions should not fork semantic meaning into a second editor-only semantics stack; parsing, indexing, and diagnostics belong to spw-lsp."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_tooling_vscode"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_vscode_readme" ]
  cites: [ ".spw/tooling/vscode-spw.spw:108", "extensions/vscode-spw/README.md:43" ]
  ^["limits"]{
   holds: "for meaning: anchors, references, diagnostics, and rename"
   fails: "for color: four painting layers run their own regexes, as the rendering matrix shows"
  }
 }
 #>editor_hosts_index_anti_echo
 ^["anti_echo"]{
  #:claim #!interpretive
  statement: "A host earns screen space by showing what the page does not already show: a resolved target, a status, a count from elsewhere."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_review_scorecard"
  credit: "the anti-echo doctrine in the raw file .spw/caches/vscode/taste.spw, promoted by the review scorecard as a proposal for the host canon"
  status_binding: #proposed
 }
 #>editor_hosts_index_code_verified
 ^["code_verified"]{
  #:claim #!interpretive
  statement: "Every row in this branch cites a file and line in the extensions or spw-lsp at commit 1aa1dc23; rows from the six dropped host caches are never carried."
  provenance_label: "a-cut rule"
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_plan"
 }
 #>editor_hosts_index_parity_questions
 ^["parity_of_questions"]{
  #:claim #!settled
  statement: "The seed's cache-layer IR says parity is of four named cache questions, not of editor chrome; a host that cannot fill a plane names it and says why."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_seed_cache_layer"
  cites: "packages/spw-seed/src/ir/cache-layer.ts:1-6"
 }
}

^["gaps"]{
 obsidian: "the obsidian-spw plan is dormant and extensions/obsidian-spw does not exist at 1aa1dc23, so no Obsidian column is filled"
 neovim_rendering: "Neovim rows cover instruments and launch; its vim syntax and tree-sitter queries are not yet read into this branch"
 promote: "corrections to .spw/tooling canon are recorded here and queued for the plugin theory surface; this branch never edits canon"
}

#>editor_hosts_index_q
?["Would one shared role stream make the four painting layers agree?"]{
 #:depth #!computational ~#lens(signal path)
 #:claim #!speculative
 ~#hypothesis: "If every layer painted from the server's parse, disagreements between layers on the same construct should fall toward zero."
 !probe{ "count constructs where TextMate, semantic tokens, and decorations disagree on a fixture corpus, before and after a parse-derived legend" =id[p_hosts_index_role_stream] =kind[census] }
 $%[hosts.lsp.token_type_count, hosts.vscode.color_id_count]
 ~"./index.spw#editor_hosts_index_server_knows" ~#neighbor(nearest)
}
