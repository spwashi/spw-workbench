# Door: Percent
#
# One mark, legible alone: the percent sign is the canon measure on a zero-to-one scale, registry cells hold world quantities, and a typed 50% splits in two.

#>spw_door_percent
#:layer #!pragmatics
#:domain #!spw
#:form #!field_guide
#:level #!intro
#:review #!adversarial_checked
#:valence #!honk

^"emit"{
 ~#title: "Door: Percent"
 ~#claim: "A typed 50% splits into the number 50 and a loose percent mark; write 0.5 or a string, and keep quantities in cells."
 ~#proof: "The number matcher stops at the percent sign, and the runtime clamps a measured register to the unit interval; this cut keeps unit-bearing numbers in cells."
 ~#door: "Guess what a rubric score typed with a percent sign becomes, then check it with spw inspect source."
 ~#audience: "engineers and educators who write shares, scores, and tolerances"
 continuity: "Door: Percent | keep quantities in cells"
 cold_open: "A typed percent splits from its number, so write a decimal or a string and keep quantities in cells."
}

