 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "persona study familiarity_matrix row for the percent sign and false_friends_top rank 2",
  "number probes run by the writer at commit 1aa1dc23 on 2026-10-02"
 ]
 ^["receipts"]{
