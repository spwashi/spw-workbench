^["edges"]{
 feeds: [ ~"../glossary/terms.spw#spw_gloss_terms" ]
}

^["mark"]{
 #>spw_door_percent_split
 ^["typed_percent"]{
  #:claim #!settled
  statement: "Only integers and decimals with a point are numbers, so 50% parses as the number 50 followed by a separate bare percent operation, while 0.5 stays one number."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_seed_lexer"
  cites: [ "packages/spw-seed/src/lexer/matchers/literals.ts:95-120" ]
  probe_run: "share: 50% gives the binding share: 50 and a loose percent operation, with no error and no warning"
  ~#spoken(percent)
  ^["limits"]{
   holds: "a percent sign typed after a number in value position"
   fails: "inside a string the percent sign is text; a percent before a bracketed list or a dotted handle is a reading of registry cells"
  }
 }
 #>spw_door_percent_measure
 ^["unit_interval"]{
  #:claim #!settled
  statement: "Canon reads the percent sign as a measure on a zero-to-one scale, and the runtime divides a register value by its scale and clamps the result into that interval."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_runtime"
  cites: [ "docs/theory/spw/operator-atlas.spw:37", "packages/spw-runtime/src/interpreter/interpreter.ts:247-254", "packages/spw-runtime/src/state/register-bank.ts:596-604" ]
  canon: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_canon_atlas"
 }
 #>spw_door_percent_cells
 ^["world_cells"]{
  #:claim #!settled
  statement: "This cut also writes registry cells with the percent sign, and those hold unbounded world quantities with units, such as the specific heat of water."
  reads: %[mateng.water.cp_j_per_g_k]
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_cut_contract"
  label: "a-cut rule, not repository canon"
  ^["limits"]{
   holds: "cells under registries/quantities in this cut"
   fails: "the runtime measure and the registry cell share a sigil and nothing else; one is clamped, the other carries a unit"
  }
 }
}

^["habits"]{
 keep: "a share between zero and one, written as a decimal with a leading zero"
 quote: [
  "percentages as people say them, such as 40 percent written in a string",
  "tolerances with a plus-minus sign",
  "negative, scientific, and comma-decimal numbers"
 ]
 unlearn: "a percent sign after a number is a separate mark here, and the number before it loses its meaning as a share"
}

^["keyboard"]{
 #>spw_door_percent_keys
 ^["shift_five"]{
  #:claim #!settled
  statement: "The percent sign needs Shift with the 5 key on both the Windows US and the Windows UK layouts."
  reads: %[doors.key.percent_us_mods, doors.key.percent_uk_mods]
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_kbd_us"
 }
}

#>spw_door_percent_q
?["What does a rubric score typed as 75% become, and what would 0.75 claim?"]{
 #:depth #!educational ~#lens(scale and dimension)
 #:claim #!speculative
 ~#hypothesis: "A gradebook habit predicts one score; the split surprises it, and the decimal fix quietly asserts equal spacing between rubric levels that may be only ordered."
 !probe{ "guess first, then run spw inspect source --text on score: 75% and on score: 0.75 with --through structure" =id[p_doors_percent_score] =kind[thought] }
 breaks: "rubric levels are ordinal, while a decimal on a zero-to-one scale reads as an interval measure"
 ~"./percent.spw#spw_door_percent_split" ~#neighbor(nearest)
}
