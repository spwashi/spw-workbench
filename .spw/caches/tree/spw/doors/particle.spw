# Door: Particle
#
# One mark family, legible alone: hash-greater, hash-colon, and hash-bang mark deixis, case, and mood, and each binds forward to the next node.

#>spw_door_particle
#:layer #!pragmatics
#:domain #!spw
#:form #!field_guide
#:level #!intro
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Door: Particle"
 ~#claim: "A particle binds forward to the next node: the particle is the word you write, and the anchor is the bookmark it leaves on that node."
 ~#proof: "The seed lexer reads three aims after a hash, and the canonical reader binds each particle run to the first content node after it."
 ~#door: "Guess which node a case particle on the first line of a frame labels, then check it with spw inspect source."
 ~#audience: "linguists and catalogers who already read small marks as grammar"
 continuity: "Door: Particle | binds forward"
 cold_open: "A particle binds forward to the next node; the particle is the word, the anchor is the bookmark."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
