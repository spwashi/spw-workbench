# Spw
#
# The reflexive class: Spw read as material, from the glyphs and the habits readers bring to them, through reading surfaces and inspection, to the design studies, hosts, and history beneath.

#>spw_class_index
#:layer #!semantics
#:domain #!spw
#:form #!index
#:level #!intro
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Spw"
 ~#claim: "In this class Spw is read as material: what its glyphs mean to readers with other notations, how its tools disclose and hide, and what is still open."
 ~#proof: "The reading surfaces cite code or canon at 1aa1dc23 or 651b535b as quoted path and line, and the corpus and editor counts their claims use read registry cells."
 ~#door: "Readers with a notation habit start at the familiarity matrix; tool authors start at inspection and IR."
 ~#audience: "readers learning Spw, and authors of its tools and plugins"
 continuity: "Spw | read as material"
 cold_open: "Here Spw is read as material: its glyphs, the habits readers bring, and what its tools show and hide."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[ "the spw-branch package of the cut plan, its critic, and the claim anchors the sibling packages published" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the plan once filed the CLI readings under editor hosts; they live in inspection and IR and in rendering and the CLI",
  "no tour starts here: the persona seven-step door paths were not written, and each cluster keeps one fragment door",
  "the proof said every number in every child reads a registry cell; several printed counts had no cell, so the counts became cells and the proof names the reading surfaces only",
  "the ladder listed practitioner before graduate; the vocabulary order is intro, foundation, advanced, graduate, practitioner"
 ]
}

^["edges"]{
 grounds: [ ~"../contract.spw#cut_contract" ]
 see: [ ~"../vocabulary.spw#cut_vocabulary", ~"../registries/probes.spw#registry_probes" ]
}

^["tree"]{
 familiarity: ~"./familiarity-matrix.spw"
 glossary: ~"./glossary/index.spw"
 doors: ~"./doors/index.spw"
 specimens: ~"./specimens/index.spw"
 perspectives: ~"./perspectives/index.spw"
 voice: ~"./voice.spw"
 tokens: ~"./tokens-and-roles.spw"
 practice: ~"./practice-modes.spw"
 transforms: ~"./transforms.spw"
 recipes: ~"./recipes.spw"
 arcs: ~"./arcs-and-readings.spw"
 rendering: ~"./rendering-and-cli.spw"
 inspection: ~"./inspection-and-ir.spw"
 empathy: ~"./machine-empathy.spw"
 dialects: ~"./dialects-and-play.spw"
 lineage: ~"./lineage.spw"
 contraptions: ~"./contraptions/index.spw"
 plugin_theory: ~"./plugin-theory.spw"
 graph_idioms: ~"./graph-idioms.spw"
 questions: ~"./open-questions.spw"
 theory: ~"./theory/index.spw"
 design_research: ~"./design-research/index.spw"
 hosts: ~"./hosts/index.spw"
 history: ~"./history/index.spw"
}

^["bundle"]{
 ={ ~"./familiarity-matrix.spw#spw_familiarity_matrix" }
 ={ ~"./voice.spw#spw_voice" }
 ={ ~"./lineage.spw#spw_lineage" }
 ={ ~"./tokens-and-roles.spw#spw_tokens_and_roles" }
 ={ ~"./inspection-and-ir.spw#spw_inspection_and_ir" }
 ={ ~"./graph-idioms.spw#spw_graph_idioms" }
 ={ ~"./open-questions.spw#spw_open_questions" }
}

^["ladder"]{
 rungs: << "intro" ; "foundation" ; "advanced" ; "graduate" ; "practitioner" >>
 intro: [ ~"./familiarity-matrix.spw#spw_familiarity_matrix", ~"./perspectives/index.spw#spw_perspectives_index", ~"./history/index.spw#workbench_history_index" ]
 foundation: [
  ~"./glossary/index.spw#spw_glossary",
  ~"./specimens/index.spw#spw_specimens",
  ~"./voice.spw#spw_voice",
  ~"./lineage.spw#spw_lineage"
 ]
 advanced: [
  ~"./tokens-and-roles.spw#spw_tokens_and_roles",
  ~"./transforms.spw#spw_transforms",
  ~"./arcs-and-readings.spw#spw_arcs_readings",
  ~"./dialects-and-play.spw#spw_dialects_and_play",
  ~"./inspection-and-ir.spw#spw_inspection_and_ir",
  ~"./machine-empathy.spw#spw_machine_empathy",
  ~"./contraptions/index.spw#spw_contraptions",
  ~"./theory/index.spw#spw_theory_index",
  ~"./design-research/index.spw#lang_design_index"
 ]
 graduate: [ ~"./open-questions.spw#spw_open_questions" ]
 practitioner: [
  ~"./practice-modes.spw#spw_practice_modes",
  ~"./recipes.spw#spw_recipes",
  ~"./rendering-and-cli.spw#spw_rendering_and_cli",
  ~"./plugin-theory.spw#spw_plugin_theory",
  ~"./graph-idioms.spw#spw_graph_idioms",
  ~"./hosts/index.spw#editor_hosts_index"
 ]
 standing: "a rung names who a surface is written for; it never ranks a reader, and any reader may read any rung"
}

^["arrival"]{
 #>spw_class_arrival
 ^["one_fragment"]{
  #:claim #!interpretive
  statement: "A newcomer lands on one fragment door from the cut root, never on this index, and a practiced circuit through these surfaces is earned by attention."
  source: ~"../registries/sources/spw-branch.spw#src_spw_owner_resume"
  label: "owner hold for this revision, not site doctrine"
  cites: [ ".spw/caches/resume/2026-09-30-direction.spw:30", ".spw/caches/resume/2026-09-30-direction.spw:73-74" ]
 }
 finding: "this index is for finding; the meaning of the class lives in the typed edges between its surfaces"
}

^["facets"]{
 domains: "spw for the reading surfaces; spw_theory, lang_design, editor_hosts, and workbench_history for the studies, hosts, and history"
 labels: "a-canon marks repository canon, a-cut marks a rule of this dated cut, and owner hold marks the resume note"
 status: "every tool, mode, verb, and pack carries implemented, proposed, or scratch; implemented only where code exists at a quoted line"
}

^["gaps"]{
 perspectives: "musicians and sound designers, lawyers and policy drafters, game designers, and accessibility readers who use screen readers or plain language have no perspective yet"
 hosts: "Neovim and Obsidian columns in the host parity matrix stay empty until each is read from its own source"
 theory: "no formal semantics for the operators or for the case and mood pair product"
 reviews: "the perspective surfaces describe fields the writers do not belong to and stay unreviewed until a member reads them"
}

#>spw_class_door_q
?["Which first surface brings a reader back for a second one?"]{
 #:depth #!educational ~#lens(applied attention)
 #:claim #!speculative
 ~#hypothesis: "Readers who arrive through a fragment door matched to their notation return for a second surface more often than readers who arrive at this index."
 !probe{ "two consenting groups of newcomers start at a matched door or at this index, and each reports by hand whether they opened a second surface" =id[p_spw_class_return] =kind[field] }
 ~"./index.spw#spw_class_arrival" ~#neighbor(nearest)
}
