 }
}

^["lanes"]{
 notation: #[ false_friend_lab, kerning, opcode_map, operator_authority, igt_aligner ]
 tables: #[ grid_gap_finder, band_coverage, rubric_lens, closure_atlas ]
 graphs: #[ state_walker, sign_walker, dag_walker, coupling_map, fixity_walker ]
 order_and_law: #[ order_counter, law_lab, dimension_bench, automaton_loom ]
 numbers_and_time: #[ number_garden, derivation_checker, field_beat ]
 ~#(lanes are for finding; meaning lives in each surface edges)
}

#>spw_contraptions_status
^["tool_status"]{
 #:claim #!settled
 statement: "Kerning is the only contraption whose instrument runs wholly on existing commands; the other twenty bind a proposed verb beside the pieces of code that exist today."
 source: ~"../../registries/sources/spw-contraptions.spw#src_contrap_code_cli"
 implemented: #[ kerning ]
 proposed: #[ false_friend_lab, opcode_map, operator_authority, igt_aligner, grid_gap_finder, band_coverage, rubric_lens, state_walker, sign_walker, dag_walker, coupling_map, fixity_walker, order_counter, law_lab, closure_atlas, dimension_bench, derivation_checker, field_beat, number_garden, automaton_loom ]
 standing: "a-cut: the status binding is this cut rule from the spw branch critic"
}

^["shape"]{
 frames: << tool ; parameters ; world ; battery ; mirror ; limits ; try ; wonder >>
 mirror: "every contraption ends its battery by turning the instrument on Spw canon, code, or this cut, and labels what it reads as a-canon, a-cut, or owner hold"
 people: "no contraption scores, ranks, or logs a reader; probes that involve people tally guesses by group, never by person"
}

^["gaps"]{
 commands: "twenty contraptions wait on a verb; the most reused missing pieces are an exact rational null space, elementary cycle enumeration, and a hole selector"
 probability: "no contraption yet samples or simulates chance, so sampling frames and confidence have no bench here"
 sound: "no contraption works with rhythm, pitch, or audio, though cadence and beat appear in the field model"
 spoken: "every authority record leaves its spoken name as a hole, and no reader root has filled one yet"
 clinical: "clinical examples were removed on purpose; a clinical bench would need its own scope frame and guideline body before it could be written"
}
