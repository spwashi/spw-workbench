# Contraptions
#
# Twenty-one runnable instruments for mathematical exploration; each names its tool or says it is proposed, states what it can and cannot show, and turns the same instrument on Spw in a language mirror.

#>spw_contraptions
#:layer #!pragmatics
#:domain #!spw
#:form #!index
#:level #!advanced
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Contraptions"
 ~#claim: "Twenty-one small instruments each run one mathematical idea on a field example and then on Spw itself, and each says whether its tool exists, what it shows, and where it stops."
 ~#proof: "Every contraption binds a tool status and quotes repository code as path and line pinned to commit 1aa1dc23, while observations are dated and some ran at 651b535b or f22c12bb, where the code they ran is unchanged; only kerning runs wholly on commands that exist today."
 ~#door: "Bring a notation habit to the false-friend lab, or start computing by hand in the number garden."
 ~#audience: "readers who learn by building, teachers, and Spw maintainers"
 continuity: "Contraptions | small instrument"
 cold_open: "Each contraption is a small instrument that turns one idea on a field you know, then turns the same idea on Spw itself."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new", "persona study contraption_catalog, references/studies/persona-synthesis.json", "final-plan-v2 tree, contraptions kit reconciled" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
 }
 corrections: #[
  "the persona catalog listed a clinical bundle audit, a pharmacokinetic loading dose, and a clinical score table; all three are removed and re-exampled, since this cut gives no clinical instruction",
  "the catalog called every instrument a tool; each now binds implemented, proposed, or scratch, and implemented only where code exists at a quoted line",
  "the proof said every contraption quotes code at 1aa1dc23 as path and line while the number garden, grid gap finder, and order counter named parser behaviour without a line; those three now quote the grammar lines, and observations pinned to 651b535b or f22c12bb say so"
 ]
}

^["edges"]{
 extends: [ ~"../../panels/llull-wheel.spw#panel_llull_wheel" ]
 grounds: [ ~"../../registries/quantities/spw-contraptions.spw#registry_qty_spw_contraptions" ]
 see: [ ~"../graph-idioms.spw#spw_graph_idioms", ~"../../registries/symmetries.spw#registry_symmetries" ]
}

^["tree"]{
 false_friend_lab: ~"./false-friend-lab.spw"
 kerning: ~"./kerning.spw"
 opcode_map: ~"./opcode-map.spw"
 operator_authority: ~"./operator-authority.spw"
 igt_aligner: ~"./igt-aligner.spw"
 grid_gap_finder: ~"./grid-gap-finder.spw"
 band_coverage: ~"./band-coverage.spw"
 rubric_lens: ~"./rubric-lens.spw"
 state_walker: ~"./state-walker.spw"
 sign_walker: ~"./sign-walker.spw"
 dag_walker: ~"./dag-walker.spw"
 coupling_map: ~"./coupling-map.spw"
 fixity_walker: ~"./fixity-walker.spw"
 order_counter: ~"./order-counter.spw"
 law_lab: ~"./law-lab.spw"
 closure_atlas: ~"./closure-atlas.spw"
 dimension_bench: ~"./dimension-bench.spw"
 derivation_checker: ~"./derivation-checker.spw"
 field_beat: ~"./field-beat.spw"
 number_garden: ~"./number-garden.spw"
 automaton_loom: ~"./automaton-loom.spw"
}

^["bundle"]{
 ={
  ~"./false-friend-lab.spw#spw_lab_false_friend"
  ~"./kerning.spw#spw_lab_kerning"
  ~"./opcode-map.spw#spw_lab_opcode_map"
  ~"./operator-authority.spw#spw_lab_operator_authority"
  ~"./igt-aligner.spw#spw_lab_igt_aligner"
  ~"./grid-gap-finder.spw#spw_lab_grid_gap"
  ~"./band-coverage.spw#spw_lab_band_coverage"
  ~"./rubric-lens.spw#spw_lab_rubric_lens"
  ~"./state-walker.spw#spw_lab_state_walker"
  ~"./sign-walker.spw#spw_lab_sign_walker"
  ~"./dag-walker.spw#spw_lab_dag_walker"
  ~"./coupling-map.spw#spw_lab_coupling_map"
  ~"./fixity-walker.spw#spw_lab_fixity_walker"
  ~"./order-counter.spw#spw_lab_order_counter"
  ~"./law-lab.spw#spw_lab_law_lab"
  ~"./closure-atlas.spw#spw_lab_closure_atlas"
  ~"./dimension-bench.spw#spw_lab_dimension_bench"
  ~"./derivation-checker.spw#spw_lab_derivation_checker"
  ~"./field-beat.spw#spw_lab_field_beat"
  ~"./number-garden.spw#spw_lab_number_garden"
