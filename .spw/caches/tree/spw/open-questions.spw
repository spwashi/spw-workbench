# Open Questions
#
# The theory questions this cut raised about Spw itself, grouped and ranked, each with the probe that would settle it and the readers or studies that asked; and a queue of design amendments for the owner.

#>spw_open_questions
#:layer #!semantics
#:domain #!spw
#:form #!probe_battery
#:level #!graduate
#:review #!adversarial_checked
#:valence #!honk

^"emit"{
 ~#title: "Open Questions"
 ~#claim: "The questions most fields raise about Spw are about silent failure: what parses quietly into something else, and which tool says so."
 ~#proof: "Each question names its probe and who raised it; the top ranks are raised by six or more of the twelve fields in the persona study."
 ~#door: "Read the first ranked question, then run its probe on one surface you know."
 ~#audience: "the language owner and anyone proposing a change to Spw"
 continuity: "Open Questions | silent failure"
 cold_open: "Most questions here ask about silent failure: what Spw parses quietly into something else, and which tool says so."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  ".agents/plans/caches-cut-2026-09-30/references/spw-branch/spw-plan.json theory_questions, sixty-three questions in thirteen groups",
  "tokens-synthesis section 7, render-synthesis section 7, and the promote rows of the spw-branch package notes"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "questions already developed in a theory, glossary, or contraption surface are linked there instead of restated, so each has one home",
  "the spaced bias question is narrowed: at 1aa1dc23 a spaced form with the anchor first yields an edge, and only the canon form with the anchor after the frame yields none",
  "nothing here edits canon or a wave 1 or 2 file; promote rows are proposals for the owner",
  "the lens question asked why the LSP indexed no apposition; 6690d686 indexes lens readings for hover, inlay, and symbols, so it now asks about references, rename, and highlight",
  "the collapse law lives at docs/library/spw/wonder-calculus.spw, not under docs/theory",
  "the review honesty row was retargeted after a rerun on 2026-10-03 cleared the two files it first named",
  "the prediction-home question listed an educator among those who raised it; the plan credits the render study alone"
 ]
}

^["edges"]{
 needs: [ ~"./familiarity-matrix.spw#spw_familiarity_matrix", ~"./inspection-and-ir.spw#spw_inspection_and_ir" ]
 see: [ ~"./theory/index.spw#spw_theory_index", ~"./glossary/terms.spw#spw_gloss_terms" ]
}

^["concepts"]{
 primary: [ #silent_failure, #promote_queue ]
 transfers: [ #habit ], tensions: [ #canon_drift ]
}

^["ranking"]{
 rule: "ranked by how many fields raise a question and whether its probe can run with tools that exist today"
 top: << ~"./open-questions.spw#spw_oq_soft_errors_q" ; ~"./open-questions.spw#spw_oq_local_failure_q" ; ~"./open-questions.spw#spw_oq_habit_profiles_q" ; ~"./open-questions.spw#spw_oq_lens_visible_q" ; ~"./open-questions.spw#spw_oq_measure_profiles_q" >>
 raisers: "field names come from the persona study; study names refer to the tokens and render reports"
}

^["syntax"]{
 #>spw_oq_soft_errors_q
 ?["Should one same-line law govern capsules, empty bindings, inline hash prose, caret labels, and valence capture, and should lexer errors fail success?"]{
  #:depth #!computational ~#lens(formal structure)
  !probe{ "flip success on lexer errors in a branch and count how many cut and wip files change from pass to fail" =id[p_spw_oq_soft_errors] =kind[build] }
  ~"./tokens-and-roles.spw#spw_tokens_same_line" ~#neighbor(nearest)
  raised_by: #[ c_family, physics, design, eng_chem, crew, creator, tokens_study ]
 }
 #>spw_oq_local_failure_q
 ?["Should one stray angle bracket or comparison degrade the whole surface, or fail on its own line with a diagnostic?"]{
  #:depth #!computational ~#lens(formal structure)
  !probe{ "insert one comparison into ten cut surfaces and record how many lines each tool still reads" =id[p_spw_oq_local_failure] =kind[build] }
  ~"./familiarity-matrix.spw#spw_fam_arrow" ~#neighbor(nearest)
  raised_by: #[ c_family, design, eng_chem, social, educator, creator, physics, clinical ]
 }
 #>spw_oq_habit_profiles_q
 ?["Should Spw ship named prior-notation profiles that warn on familiar but wrong readings without changing the parse?"]{
  #:depth #!educational ~#lens(applied attention)
  !probe{ "draft one warning per false-friend row for two fields and ask members which warnings they would keep" =id[p_spw_oq_habit_profiles] =kind[interview] }
  ~"./familiarity-matrix.spw#spw_fam_counts" ~#neighbor(nearest)
  raised_by: #[ c_family, physics, design, social, library, creator, educator, math ]
 }
 also: [
  "is the tight versus spaced contrast meant to change the parse, as it does for bias and aspect keys, or only reading confidence",
  "should identifiers accept Unicode letters after NFC normalization, and should curly quotes and guillemets be named errors",
  "is the hyphen in identifiers worth the collisions with arrows, varlists, and bullets",
  "should a hash and a space keep dropping the rest of a line mid-line, with canon restating the rule",
  "should indent become a declared contract key, and how do readers whose tree is the meaning keep it when facets become the browse path",
  "should chat lines with a handle be a sanctioned form, or should people get a construct apart from the at sign"
 ]
 see: [ ~"./familiarity-matrix.spw#spw_familiarity_matrix", ~"./tokens-and-roles.spw#spw_tokens_same_line_law" ]
}

^["lens_and_readings"]{
 #>spw_oq_lens_visible_q
 ?["Now that the LSP indexes lens readings for hover, inlay, and symbols, should references, rename, and highlight read them from the parse rather than by regex?"]{
  #:depth #!computational ~#lens(information flow)
  !probe{ "count lens appositions in the cut and the ones any editor search or view can find" =id[p_spw_oq_lens_visible] =kind[census] }
  ~"./hosts/known-defects.spw#editor_hosts_defects_lens_index" ~#neighbor(nearest)
  last_run: ~"../registries/probes.spw#registry_probe_spw_oq_lens_visible"
  raised_by: #[ c_family, physics, design, clinical, library, creator, crew, linguist, educator, social ]
 }
 home: [ ~"./hosts/known-defects.spw#editor_hosts_defects_lens_index", ~"./voice.spw#spw_voice" ]
 also: [
  "which new lenses earn a place by recurrence, and should picture readings get a named apposition",
  "do appositions compose, is one with no host valid, and should named appositions count as volatile aspect",
  "should gloss return as a reading apart from apposition; the gloss reading in this cut stays provisional until this is settled",
  "which channel carries readings, hash marginalia or countable appositions, and should tools allow apostrophes in apposition bodies",
  "is a say line a reading or a derived product, may computed say lines be written back, and is the reading set closed per cut"
 ]
}

^["measures"]{
 #>spw_oq_measure_profiles_q
 ?["Is percent one operator with several profiles, a unit-interval measure, an unbounded registry quantity, and a count family, or does Spw need a quantity noun?"]{
  #:depth #!mathematical ~#lens(scale and dimension)
  !probe{ "classify every percent cell and frame in canon and this cut by range and unit, and count each profile" =id[p_spw_oq_measure_profiles] =kind[census] }
  ~"./familiarity-matrix.spw#spw_fam_percent" ~#neighbor(nearest)
  raised_by: #[ physics, eng_chem, social, creator, design, clinical, library, math, linguist ]
 }
 #>spw_oq_signed_literals_q
 ?["Will the lexer accept signed, scientific, uncertain, or unit-bearing literals, and a time literal that is not read as a Binding?"]{
  #:depth #!computational ~#lens(scale and dimension)
  !probe{ "parse a fixture of signed, exponent, plus-minus, and clock literals and record each error and split" =id[p_spw_oq_signed_literals] =kind[build] }
  ~"./familiarity-matrix.spw#spw_fam_observables" ~#neighbor(nearest)
  raised_by: #[ c_family, physics, eng_chem, clinical, design, social, math, crew ]
 }
 home: [ ~"./theory/measures-and-handles.spw#spw_theory_measures_dimension_q", ~"./theory/epistemic-status.spw#spw_theory_status_strength_q" ]
 also: [ "where do ordinal scores live: an ordinal measure family or match bands" ]
}

^["operators"]{
 #>spw_oq_compounds_q
 ?["Should the lexer own a closed list of compounds, so that dollar-percent, a doubled hash, and the arrows read one way and parse the same way?"]{
  #:depth #!computational ~#lens(formal structure)
  !probe{ "list every two-glyph run in canon and this cut and mark which parse as one token" =id[p_spw_oq_compounds] =kind[census] }
  ~"./tokens-and-roles.spw#spw_tokens_div_connectors" ~#neighbor(nearest)
  raised_by: #[ c_family, library, eng_chem, clinical, tokens_study ]
 }
 #>spw_oq_coupling_q
 ?["Should infix a <> b become coupling, and may coupling be n-ary?"]{
  #:depth #!mathematical ~#lens(symmetry and invariance)
  !probe{ "run the coupling operator on quoted, bare, and nested operands and record which keys couple" =id[p_spw_oq_coupling] =kind[calc] }
  ~"./familiarity-matrix.spw#spw_fam_couple" ~#neighbor(nearest)
  raised_by: #[ physics, clinical, social, creator, math, design, linguist, educator ]
 }
 home: [ ~"./glossary/operators.spw#spw_gloss_op_naming", ~"./contraptions/law-lab.spw#spw_lab_law_lab", ~"./dialects-and-play.spw#spw_play_reservation" ]
 also: [
  "is the operator by bound table meant to be total, or are its empty cells intended gaps",
  "does the prefix-transitive and postfix-reflexive law bind the parser, given postfix forms parse as siblings",
  "should Spw ever assert equality or isomorphism, or is pairing without identity a stance",
  "are the set, facet, and observer frame constructors ready to promote, and is a set unordered and unique by law",
  "should highlighting show canon reach for brackets and parentheses, and do the two arrow connectors carry their sigil role",
  "should wonder, tilde, percent, and bang take a path subject the way caret does"
 ]
}

^["linking"]{
 #>spw_oq_bias_types_q
 ?["Should bias axes used as relation types get a declared set the gate checks, so spw mutate with --bias never reads them as rewrite patches?"]{
  #:depth #!computational ~#lens(information flow)
  !probe{ "list every bias axis in canon and this cut and mark which ones mutate would apply as a patch" =id[p_spw_oq_bias_types] =kind[census] }
  ~"./familiarity-matrix.spw#spw_fam_bias" ~#neighbor(nearest)
  raised_by: #[ social, library, eng_chem, linguist, clinical, physics, creator ]
 }
 #>spw_oq_spaced_bias_q
 ?["Should readBias learn the canon bias form with the anchor after the frame, or should canon move to the anchor-first form?"]{
  #:depth #!computational ~#lens(formal structure)
  !probe{ "rewrite the canon bias examples anchor-first in a scratch copy and count edges before and after" =id[p_spw_oq_spaced_bias] =kind[build] }
  ~"./familiarity-matrix.spw#spw_fam_bias" ~#neighbor(nearest)
  raised_by: #[ design, eng_chem, linguist, c_family ]
 }
 home: [ ~"./theory/address-and-linking.spw#spw_theory_address_identity_q", ~"./theory/address-and-linking.spw#spw_theory_address_agree_q" ]
 also: [
  "should citation typing such as supports and disputes be edges or source and counter bindings, and can a claim cite a claim",
  "should emit continuity be anchored rather than phrases matched anywhere in the packet"
 ]
}

^["particles_and_valence"]{
 #>spw_oq_evidentiality_q
 ?["Is evidentiality a new particle aim or a closed value set under mood, and how does it relate to claim status?"]{
  #:depth #!social ~#lens(semiotic charge)
  !probe{ "lower ten child questions with evidential moods and ask two linguists whether each mark reads as source or as stance" =id[p_spw_oq_evidentiality] =kind[interview] }
  ~"./dialects-and-play.spw#spw_play_kin" ~#neighbor(nearest)
  raised_by: #[ linguist, educator, tokens_study ]
 }
 home: [ ~"./theory/particle-lattice.spw#spw_theory_particle_container_q", ~"./theory/valence-and-charge.spw#spw_theory_valence_palette_q" ]
 also: [
  "reconcile three readings of the pentad: charge-neutral material, edge direction, and hazard in code",
  "should valence words be usable as binding keys, and should the word valence face chemists and clinicians who already own it",
  "may valence ever mark progress on an arc or a practice ladder, given the owner hold that keeps charge off the visit arc"
 ]
}

^["practice_and_care"]{
 #>spw_oq_prediction_home_q
 ?["Where does a prediction live: a question body with a prediction capsule, a next capsule on the question, or a measure in the flow schedule?"]{
  #:depth #!educational ~#lens(applied attention)
  !probe{ "write one arc three ways and ask which form readers fill in before they check" =id[p_spw_oq_prediction_home] =kind[field] }
  ~"./arcs-and-readings.spw#spw_arcs_schedule" ~#neighbor(nearest)
  raised_by: #[ render_study ]
 }
 home: [ ~"./inspection-and-ir.spw#spw_ir_honesty_q", ~"./machine-empathy.spw#spw_empathy_declare_q", ~"./arcs-and-readings.spw#spw_arcs_reentry_q" ]
 also: [
  "is care only a property of a past inspection, or also a declared request the tools honor",
  "should a reader-owned calibration ledger exist at all, kept by hand and never by a tool",
  "which retention plane do overlays live on, and do corpus walks skip reader roots",
  "should the reading axis choose the default reducer and practice mode, and is grain the sanctioned complexity dial"
 ]
}

^["dialects_and_talk"]{
 #>spw_oq_dialect_axes_q
 ?["Should a dialect again be a set of optional axes, as in the v0.1 phases, and should dialects be named as words with letters as aliases?"]{
  #:depth #!historical ~#lens(historical layer)
  !probe{ "map each of the eight dialect ids onto the v0.1 phases and mark which flags each phase would absorb" =id[p_spw_oq_dialect_axes] =kind[thought] }
  ~"./lineage.spw#spw_lineage_v01" ~#neighbor(nearest)
  raised_by: #[ tokens_study ]
 }
 #>spw_oq_pronounce_q
 ?["How is spw pronounced, and which single word owns cut, expand, hub, lens, surface, measure, read, and skim?"]{
  #:depth #!social ~#lens(social fabric)
  !probe{ "ask ten readers to say the name and define three homonyms, then compare answers, never the readers" =id[p_spw_oq_pronounce] =kind[interview] }
  ~"./rendering-and-cli.spw#spw_rcli_alias_leak" ~#neighbor(nearest)
  raised_by: #[ render_study ]
 }
 home: [ ~"./lineage.spw#spw_lineage_letters", ~"./rendering-and-cli.spw#spw_rcli_vocabulary" ]
}

^["promote"]{
 rule: "each row names a source anchor, a target, and evidence; the owner decides, and nothing here edits the target"

 #>spw_oq_promote_state
 ^["phase_walk"]{
  source_anchor: ~"./contraptions/state-walker.spw#spw_lab_state_walker"
  target: "a new water-phases surface beside physical/materials/water.spw, and that surface edges"
  evidence: "the walker finds three forward edges; passes critical, not boils, reaches supercritical; only ice Ih is modeled"
 }
 #>spw_oq_promote_fixity
 ^["fixity"]{
  source_anchor: ~"./contraptions/fixity-walker.spw#spw_lab_fixity_walker"
  target: ~"../provenance/manifest.spw"
  evidence: "a staged water surface drifted between two recorded digests; add digest fields and a fixity-check event"
 }
 #>spw_oq_promote_dimensions
 ^["dimension_links"]{
  source_anchor: ~"./contraptions/dimension-bench.spw#spw_lab_dimension_bench"
  target: "every wave 1 and 2 quantities registry"
  evidence: "each quantity cell gains a dimension link so a homogeneity check can run"
 }
 #>spw_oq_promote_review
 ^["review_honesty"]{
  source_anchor: ~"./inspection-and-ir.spw#spw_ir_honesty_q"
  target: "contract.spw and vocabulary.spw at the cut root"
  evidence: "a scratch rerun on 2026-10-03 finds only these two short of their review value, since neither has a receipts frame; the guideline ledger and review scorecard flagged on 2026-10-02 now pass"
  run: ~"../registries/probes.spw#registry_probe_spw_ir_honesty"
 }
 #>spw_oq_promote_hash_prose
 ^["hash_prose"]{
  source_anchor: ~"./glossary/false-friends.spw#spw_false_friends"
  target: ~"docs/theory/spw/apposition.spw#spw_apposition"
  evidence: "the lexer drops a hash and a space mid-line, and the cut apostrophe rule is stricter than the lexer"
  cites: [ "packages/spw-seed/src/lexer/matchers/comments.ts:50-58", "docs/theory/spw/apposition.spw:83-84" ]
 }
 #>spw_oq_promote_kerning
 ^["spaced_bias"]{
  source_anchor: ~"./contraptions/kerning.spw#spw_lab_kerning"
  target: ~"docs/theory/spw/flow-protocol-sigils.spw"
  evidence: "the canon bias example at line 66 yields no edge; the anchor-first spaced form yields one"
 }
 #>spw_oq_promote_law
 ^["collapse_law"]{
  source_anchor: ~"./contraptions/law-lab.spw#spw_lab_law_lab"
  target: "docs/library/spw/wonder-calculus.spw:29-31"
  evidence: "collapse after defer returns a deferred wrapper, so the stated law fails on value, writes, and trace"
 }
 #>spw_oq_promote_homonyms
 ^["homonyms"]{
  source_anchor: ~"./rendering-and-cli.spw#spw_rendering_and_cli"
  target: ~".spw/conventions/cli.spw#spw_cli_conventions"
  evidence: "add a homonyms frame that gives cut, expand, hub, lens, readings, skim, and read one owner each"
 }
 #>spw_oq_promote_care
 ^["care_ladder"]{
  source_anchor: ~"./inspection-and-ir.spw#spw_ir_care_mapping"
  target: ~".spw/conventions/cli.spw#spw_cli_conventions"
  evidence: "the care ladder is cut vocabulary today; it must land in CLI canon before any care flag reaches seed, CLI, or LSP"
 }
}
