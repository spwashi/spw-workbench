# Transforms
#
# Five typed verbs over Spw surfaces, their carriers, eight laws with honest status, the notation that parses today, the range-notation hazard, and the comprehension budget, mapped onto the commands that exist.

#>spw_transforms
#:layer #!semantics
#:domain #!spw
#:form #!catalog
#:level #!advanced
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Transforms"
 ~#claim: "Expansion, comprehension, reduction, transformation, and projection are distinct verbs, and each must say what it keeps, what it drops, and where its bytes came from."
 ~#proof: "The seed finds sites with spans intact, while spw expand splices text by line and records provenance as a comment, so each verb is graded by its loss."
 ~#door: "Start with reduction: run the brief card on one surface and list what it dropped."
 ~#audience: "tool authors and careful readers of the spw verbs"
 continuity: "Transforms | keeps"
 cold_open: "Every transform keeps something and drops something; name both before you trust the result."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  ".agents/plans/caches-cut-2026-09-30/references/studies/tokens-synthesis.md section 3",
  "packages/spw-cli/src/expand.ts and canon onf.spw and range-transform.spw re-read at 1aa1dc23"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
  }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "carriers, comprehend, reduce, and project are proposals with status proposed; canonical/projection.ts and comprehend.ts do not exist at 1aa1dc23",
  "law L2 was verified on a scratch prototype only, so it reads emerging, not settled"
 ]
}

^["edges"]{
 extends: [ ~"docs/theory/spw/onf.spw", ~"docs/theory/spw/range-transform.spw#range_transform" ]
 feeds: [ ~"./recipes.spw#spw_recipes", ~"./inspection-and-ir.spw#spw_inspection_and_ir" ]
}

^["concepts"]{
 primary: [ #transform_verb, #omission ]
 transfers: [ #volvelle ]
 tensions: [ #round_trip ]
}

^["finding"]{
 #>spw_transforms_find_not_produce
 ^["finds_not_produces"]{
  #:claim #!settled
  statement: "The seed finds sites with spans intact but has no printer from AST or ONF back to Spw, and canon marks the round trip proposed."
  source: ~"../registries/sources/spw-branch.spw#src_spw_canon_onf"
  cites: [ "docs/theory/spw/onf.spw:90", "docs/theory/spw/onf.spw:98" ]
 }
}

^["verbs"]{
 #>spw_transforms_expansion
 ^["expansion"]{
  #:claim #!settled
  statement: "spw expand finds bundle sites through the parse, then splices each target into the host text by line, records provenance as a comment, and copies links without rebasing them."
  source: ~"../registries/sources/spw-branch.spw#src_spw_cli_commands"
  cites: [ "packages/spw-cli/src/expand.ts:56-66", "packages/spw-cli/src/expand.ts:79", "packages/spw-cli/src/expand.ts:88-96" ]
  command: "spw expand", status: #implemented
  loses: "the transcluded anchor line, because the slice starts at the bound node"
 }
 #>spw_transforms_comprehension
 ^["comprehension"]{
  #:claim #!speculative
  statement: "A comprehension would enumerate the views a comprehend-axis bias edge generates, one per tuple of its ranked targets, and every view must parse."
  status: #proposed
  today: "spw select and spw query filter; nothing generates"
  source: ~"../registries/sources/spw-branch.spw#src_spw_study_tokens"
  ^["budget"]{
   #:claim #!settled
   statement: "Hundreds of wonder anchors outside the caches make unbounded combination explode, so comprehension needs a budget and sampling."
   reads: %[spw.corpus.wonder_anchors]
   source: ~"../registries/sources/spw-branch.spw#src_spw_study_tokens"
   lineage: "Llull built rotating paper wheels that combine terms by rotation; the volvelle is the older form of this verb"
   see: [ ~"../registries/sources/spw-branch.spw#src_spw_bonner_2007" ]
  }
 }
 #>spw_transforms_reduction
 ^["reduction"]{
  #:claim #!settled
  statement: "The brief emit host keeps title, audience, claim, proof, and door, and drops claim status, provenance, as_of, and limits."
  source: ~"../registries/sources/spw-branch.spw#src_spw_cli_emit"
  reads: %[spw.cli.emit_hosts]
  command: "spw emit pack --host brief", status: #implemented
  cites: [ "packages/spw-cli/src/emit/types.ts:21-31" ]
  say_reduction: "a say line computed from a claim is proposed; an authored say reading must come back unchanged"
 }
 #>spw_transforms_transformation
 ^["transformation"]{
  #:claim #!settled
  statement: "spw pulse plans an effect and writes only with explicit authority, spw mutate applies a plan, and spw refactor renames an anchor particle without its path refs."
  source: ~"../registries/sources/spw-branch.spw#src_spw_cli_commands"
  cites: [ "packages/spw-cli/src/commands.ts:406-418", "packages/spw-seed/src/canonical/semantic-edit.ts:280-298" ]
  status: #implemented
 }
 #>spw_transforms_projection
 ^["projection"]{
  #:claim #!speculative
  statement: "A projection would be a view under overlays, grain, and a reading profile that never writes, with every byte mapped to a source segment or marked generated."
  status: #proposed
  carrier: "Projection holds text, segments, and receipts; its tree is the parse of its text"
  source: ~"../registries/sources/spw-branch.spw#src_spw_study_tokens"
 }
 comparison: "spw delta, spw cycle, and spw atlas compare revisions; they report labels and counts, not status changes"
}

^["laws"]{
 #>spw_transforms_law_l1
 ^["l1_views_never_write"]{ #:claim #!interpretive ~#say(the source is the fold) }
 #>spw_transforms_law_l2
 ^["l2_every_byte_has_a_segment"]{
  #:claim #!emerging
  statement: "On a scratch prototype a projected byte mapped back to its source byte and the projection parsed with no errors."
  source: ~"../registries/sources/spw-branch.spw#src_spw_study_tokens"
  status: #scratch
 }
 #>spw_transforms_law_l3
 ^["l3_provenance_in_tree"]{
  #:claim #!speculative
  statement: "Each transcluded block would open with a stream naming its source and a transcluded reading, so provenance lives in the tree rather than in a comment."
 }
 #>spw_transforms_law_l4
 ^["l4_say_is_stable"]{ #:claim #!interpretive ~#say(an authored say line comes back unchanged) }
 #>spw_transforms_law_l5
 ^["l5_views_parse"]{ #:claim #!speculative ~#say(every generated view parses) }
 #>spw_transforms_law_l6
 ^["l6_plans_not_trees"]{ #:claim #!interpretive ~#say(a transform returns a plan) }
 #>spw_transforms_law_l7
 ^["l7_overlays_by_anchor"]{
  #:claim #!speculative
  statement: "Overlays merge by anchor without touching canon; the prototype compared a file with a copy of itself, so it could not fail."
 }
 #>spw_transforms_law_l8
 ^["l8_refuse_without_spans"]{ #:claim #!interpretive ~#say(no spans, no transform) }
}

^["notation"]{
 note: "samples parsed with no errors in the tokens study; they are quoted here so they bind nothing"
 expand: `={ ~"./child.spw#child_anchor" }`
 comprehend: `=~"./wheel.spw#wonder_tpl"[comprehend]{ ~"./wheel.spw#lens_disc" ; ~"./wheel.spw#era_disc" }`
 reduce: `!reduce[say]{ ~"./tide.spw#wonder_tide_1" }`
 project: `=~"./tide.spw#wonder_tide_1"[reading]{ ~"./reader.spw#reading_tide_1" }`
 hole: "a dollar-prefixed name is a hole in code; inside strings and appositions it is only text"
}

^["range_hazard"]{
 #>spw_transforms_range
 ^["detached_range"]{
  #:claim #!settled
  statement: "A line range written after the closing quote of a path is a separate case particle that binds the next item, and canon labels the range forms proposed and illustrative."
  source: ~"../registries/sources/spw-branch.spw#src_spw_canon_onf"
  cites: [ "docs/theory/spw/range-transform.spw:79", "docs/theory/spw/range-transform.spw:109-110" ]
  rule: "keep a line-range fragment inside the path quotes"
 }
}

^["try"]{
 #>spw_transforms_try_loss
 ^["list_the_loss"]{
  materials: [ "a terminal in the workbench", "the water exemplar surface" ]
  steps: << "write the five fields you expect the brief card to keep" ; "run spw emit pack on water.spw with --host brief" ; "list what the card dropped" ; "find each dropped item in the surface by eye" >>
  time: .{ n: 15, unit: "minutes" }
  safety: "none worth naming; emit pack writes to the terminal only"
  shows: ~"./transforms.spw#spw_transforms_reduction"
 }
}

#>spw_transforms_collision_q
?["When a say reduction follows a comprehension, which generator axes vanish from the spoken views?"]{
 #:depth #!computational ~#lens(formal structure)
 #:claim #!speculative
 ~#hypothesis: "Any axis the say template never names collapses its tuples onto one spoken line, so a lint could flag the invisible axis."
 !probe{ "enumerate a three-axis wheel, reduce each view to a say line, count distinct lines per axis" =id[p_spw_transforms_collision] =kind[build] }
 $%[spw.corpus.wonder_anchors]
 ~"./transforms.spw#spw_transforms_comprehension" ~#neighbor(nearest)
}
