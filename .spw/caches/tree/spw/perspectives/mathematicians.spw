 }
 corrections: #[
  "the study said all ten LaTeX special characters are Spw syntax; the backslash is a lexer error rather than syntax, and an underscore inside a name is part of the name",
  "the lemma wonder said needs edges form a partial order while acyclic; a partial order is reflexive, so the hypothesis now names the reachability order an acyclic edge set induces",
  "the history row said mathematical signs were introduced by named authors at datable moments; Cajori also documents signs such as plus and minus that emerged gradually, so the row now says many, not all"
 ]
}

^["edges"]{
 feeds: [ ~"../doors/tilde.spw#spw_door_tilde", ~"../specimens/math-physics-notation.spw#spw_spec_math_physics", ~"../contraptions/law-lab.spw#spw_lab_law_lab" ]
 see: [ ~"../theory/epistemic-status.spw#spw_theory_status_states", ~"../contraptions/closure-atlas.spw#spw_lab_closure_atlas" ]
}

^["standing"]{
 #>spw_perspectives_mathematicians_standing
 ^["hypothesis"]{
  #:claim #!interpretive
  statement: "This ledger was written by an agent outside the cluster; it stays a hypothesis until a working mathematician checks each row against how the field reads its own notation."
  member_probe: "a mathematician marks each row as holds, holds with a stated condition, or fails, and names the condition the row forgot"
 }
}

^["ledger"]{
 #>spw_perspectives_mathematicians_labels
 ^["labels_and_references"]{
  #:claim #!interpretive
  notation: "a label on a lemma and a reference to it elsewhere, as LaTeX writes with label and ref"
  spw: "an anchor binds the next node, and a path ref with that name after the hash reaches it from any file"
  probe_run: "a lemma frame anchored as lemma_two and cited by a fragment path ref parsed with no error at 1aa1dc23"
  holds: "the label names one node, the reference names the label, and the cut gate fails a reference whose label is missing"
  fails: "nothing numbers lemmas, and anchors must be unique across the whole cut rather than per document"
  example: ~"../doors/particle.spw#spw_door_particle_forward"
  cites: [ "scripts/analyzers/spw-cut-gate.ts:337-346" ]
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_cut_gate"
 }
 #>spw_perspectives_mathematicians_sets
 ^["sets"]{
  #:claim #!interpretive
  notation: "a set written by listing its members in braces"
  spw: "a hash before square brackets lists items in order and keeps every one, including repeats"
  probe_run: "S: #[ a, b, a ] gives one set operation with three parameters, the second a still present"
  holds: "membership as a written list"
  fails: "no extensionality, since order and duplicates survive, and no comprehension or set-builder form"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_seed_grammar"
 }
 #>spw_perspectives_mathematicians_arrows
 ^["arrows"]{
  #:claim #!interpretive
  notation: "an arrow for a function, a morphism, or an implication"
  spw: "an arrow between two terms is a connector inside one expression"
  probe_run: "f: A -> B binds f to one expression holding A and B joined by an arrow connector"
  holds: "order: the term before the arrow and the term after it stay distinct"
  fails: "no domain, codomain, identity, or composition, so no category is formed"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_seed_grammar"
 }
 #>spw_perspectives_mathematicians_equality
 ^["equality"]{
  #:claim #!interpretive
  notation: "an equals sign for two things that are the same"
  spw: "the equals sign configures a register or opens a bias edge, and binding is the colon"
  holds: "nothing of equality; the reflexive, symmetric, and transitive laws have no observable"
  example: ~"../doors/equals.spw#spw_door_equals_flat"
  origin: "Robert Recorde introduced the sign in 1557 for two things that are equal"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_recorde_1557"
 }
 #>spw_perspectives_mathematicians_quantifiers
 ^["quantifiers"]{
  #:claim #!interpretive
  notation: "for-all and there-exists signs, U+2200 and U+2203"
  spw: "a non-ASCII quantifier is a lexer error that drops the sign and keeps the variable"
  probe_run: "q: with the for-all sign before x reported one lexer error and bound q to x; success stayed true"
  holds: "nothing; quantifiers need words or a backtick phrase"
  fails: "the bound variable survives alone, which reads as a claim about x rather than about every x"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_seed_lexer"
 }
 #>spw_perspectives_mathematicians_fractions
 ^["fractions"]{
  #:claim #!interpretive
  notation: "a fraction written with a slash, such as three quarters"
  spw: "a slash is a connector, so 3/4 is an expression of two literals, not one number"
  probe_run: "n: 3/4 binds n to the literals 3 and 4 joined by a slash connector"
  holds: "the numerator and denominator stay in order"
  fails: "no tool divides them; write 0.75 or keep the fraction in a string"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_seed_grammar"
 }
 #>spw_perspectives_mathematicians_proofs
 ^["proofs_and_status"]{
  #:claim #!interpretive
  notation: "a theorem, its proof, and the lemmas it depends on"
  spw: "a claim carries one of seven status moods, and a needs edge names a dependency between anchors"
  holds: "dependency direction: a needs edge from a theorem to a lemma reads like the order of a proof"
  fails: "settled rates agreement among sources, not derivation, and the gate checks edge relation names but not acyclicity"
  cites: [ "scripts/analyzers/spw-cut-gate.ts:297-301" ]
  example: ~"../doors/claim.spw#spw_door_claim_statuses"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_cut_gate"
 }
}

^["latex_ten"]{
 #>spw_perspectives_mathematicians_latex
 ^["special_characters"]{
  #:claim #!settled
  statement: "LaTeX reserves ten special characters: hash, dollar, percent, ampersand, tilde, underscore, caret, backslash, and the two braces."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_lamport_1994"
 }
 hash: .{ tex: "macro parameter", spw: "tag, set, or comment to line end", see: ~"../doors/hash.spw#spw_door_hash_drop" }
 dollar: .{ tex: "math mode", spw: "substrate operation; inline math splits", see: ~"../specimens/math-physics-notation.spw#spw_spec_math_physics_inline_math" }
 percent: .{ tex: "comment to line end", spw: "measure, and a typed percent splits", see: ~"../doors/percent.spw#spw_door_percent_split" }
 ampersand: .{ tex: "alignment tab", spw: "confluence; x: a & b binds a and leaves b on an ampersand sibling" }
 tilde: .{ tex: "non-breaking space", spw: "potential and the path-ref prefix", see: ~"../doors/tilde.spw#spw_door_tilde_split" }
 underscore: .{ tex: "subscript", spw: "part of a name such as a_1; alone, a wildcard node" }
 caret: .{ tex: "superscript", spw: "names frames; an exponent splits", see: ~"../doors/caret.spw#spw_door_caret_exponent" }
 backslash: .{ tex: "control sequence", spw: "a lexer error; the macro name survives", see: ~"../specimens/math-physics-notation.spw#spw_spec_math_physics_backslash_macro" }
 braces: .{ tex: "grouping", spw: "a body that groups an expression sequence" }
 probe_run: "x: a & b, w: _, a: a_1, and s: { x | x } parsed at 1aa1dc23 with no error and no warning"
 bridge: "braces and the underscore inside names are the two habits that carry over; the other eight need quotes or a backtick phrase"
}

^["notation_history"]{
 #>spw_perspectives_mathematicians_history
 ^["notation_drifts"]{
  #:claim #!settled
  statement: "Many mathematical signs can be traced to named authors at datable moments, others emerged gradually, and signs spread unevenly, so a sign can mean different things in neighbouring traditions."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_cajori_1928"
 }
 reading: "Spw sigils are a newer tradition of the same kind, with one owner who can still rename them"
}

^["tools"]{
 resolve: .{ command: "spw resolve", checks: "where each path ref lands", status: #implemented, cites: "packages/spw-cli/src/commands.ts:323-328" }
 law_lab: .{ contraption: "law-lab", checks: "whether an operator law holds on value, writes, and trace", status: #proposed }
 closure_atlas: .{ contraption: "closure-atlas", checks: "closure under a declared convention", status: #proposed }
}

^["try"]{
 #>spw_perspectives_mathematicians_try
 ^["label_and_cite"]{
  materials: [ "a text editor", "the spw CLI in this repository", "two scratch files outside the cut" ]
  steps: << "write a lemma frame with an anchor in the first file" ; "cite it from the second file with a fragment path ref" ; "run spw resolve on the second file" ; "rename the anchor and run spw resolve again" ; "note which tool told you the citation broke" >>
  time: .{ n: 20, unit: "minutes" }
  safety: "no hazard worth naming; keep scratch files outside the cut"
  shows: ~"./mathematicians.spw#spw_perspectives_mathematicians_labels"
 }
}

#>spw_perspectives_mathematicians_q
?["Do needs edges between lemmas form a partial order?"]{
 #:depth #!mathematical ~#lens(formal structure)
 #:claim #!speculative
 ~#hypothesis: "Reachability along needs edges orders lemmas partially only while authors avoid cycles, and nothing checks acyclicity, so the order is a promise rather than a property."
 !probe{ "draw needs edges among five lemmas you know, then search the drawing for a cycle by hand" =id[p_doors_math_lemma_order] =kind[thought] }
 breaks: "a proof dependency is checked by a referee or a proof assistant, while a needs edge is checked by nobody"
 ~"./mathematicians.spw#spw_perspectives_mathematicians_proofs" ~#neighbor(nearest)
}
