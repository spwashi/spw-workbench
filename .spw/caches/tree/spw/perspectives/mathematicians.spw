 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "persona study doors entry mathematicians and metaphor_limits for mathematics",
  "notation probes run by the writer at commit 1aa1dc23 on 2026-10-03"
 ]
 ^["receipts"]{
