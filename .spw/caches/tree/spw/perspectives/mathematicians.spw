# Perspective: Mathematicians
#
# Sets, relations, quantifiers, and proofs set against Spw sets, edges, and claim status, with the ten LaTeX special characters read as Spw marks and each correspondence marked where it holds and where it fails.

#>spw_perspectives_mathematicians
#:layer #!pragmatics
#:domain #!spw_perspectives
#:form #!ledger
#:level #!intro
#:review #!adversarial_checked
#:valence #!bonk

^"emit"{
 ~#title: "Perspective: Mathematicians"
 ~#claim: "Each correspondence between mathematical notation and Spw holds as shape only: a set keeps duplicates, an arrow orders without composing, and a settled claim is agreement, not proof."
 ~#proof: "Each ledger row pairs a notation with a parse run at commit 1aa1dc23 and names the property that fails to carry over."
 ~#door: "Read the labels row first, the one correspondence that holds almost whole, then the sets row."
 ~#audience: "mathematicians and students who write LaTeX and read notation as a promise of structure"
 continuity: "Perspective: Mathematicians | holds as shape"
 cold_open: "A Spw set keeps duplicates and an arrow proves nothing, so each correspondence holds as shape only."
}

