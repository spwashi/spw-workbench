# Perspective: Production Crews
#
# Call sheets, run sheets, breakdowns, and continuity logs read as schedules and states, entered role first: each crew role starts from the paper it already keeps, never from a sigil.

#>spw_perspectives_crews
#:layer #!pragmatics
#:domain #!spw_perspectives
#:form #!calendar
#:level #!intro
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Perspective: Production Crews"
 ~#claim: "A crew member enters through the paper their role already keeps: the call sheet becomes a calendar frame, the cue stack a schedule, and every time or timecode a quoted string."
 ~#proof: "Probes at commit 1aa1dc23 nest a bare timecode into four bindings and turn a forced Fountain transition into prose; a schedule of quoted steps parses as one ordered stream."
 ~#door: "Find your role in the roles frame and open only the artifact it names."
 ~#audience: "stage managers, assistant directors, script supervisors, editors, and camera and lighting crews"
 continuity: "Perspective: Production Crews | the paper their role already keeps"
 cold_open: "Start from the paper their role already keeps, and quote every time before it becomes structure."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "persona study doors entry production_crews and metaphor_limits for film, theatre, and production",
  "schedule, timecode, and Fountain probes run by the writer at commit 1aa1dc23 on 2026-10-03",
  "the Fountain syntax page read on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 study agents", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
  }
  ^["r7"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r8"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
