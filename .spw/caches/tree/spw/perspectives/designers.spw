# Perspective: Designers
#
# Design systems, tokens, and visual hierarchy read against Spw: highlighting as a projection of the parse, valence as material rather than merit, and the page itself as the reading surface.

#>spw_perspectives_designers
#:layer #!pragmatics
#:domain #!spw_perspectives
#:form #!protocol
#:level #!intro
#:review #!adversarial_checked
#:valence #!boon

^"emit"{
 ~#title: "Perspective: Designers"
 ~#claim: "In this cut the page carries the hierarchy and color only projects it: status and valence read from glyphs and position, so a monochrome print keeps every meaning."
 ~#proof: "The cut contract bars meaning that depends on color, the editor layers color from their own readings of the text, and canon names the valences material, not merit."
 ~#door: "Do the squint test on one printed surface, then read the highlighting row."
 ~#audience: "graphic, interaction, and type designers, illustrators, and design-system maintainers"
 continuity: "Perspective: Designers | color only projects it"
 cold_open: "The page carries the hierarchy and color only projects it, so a grey print keeps every meaning."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "persona study doors entry designers and metaphor_limits for design",
  "render synthesis section 5.3 on editor rules",
  "spacing and outline commands read by the writer at commit 1aa1dc23 on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 study agents", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{
   event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #partial
   note: "forward refs to planned files of other packages that were not yet written: concepts/plates"
  }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r6"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r7"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r8"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r9"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the study said a tight bias edge exists and the spaced form yields none; the edge door found that spacing is not the cause, so this file attributes spacing effects only to positions a probe confirmed",
  "a see edge and a plates link inside the settled clusters frame pointed at the plates panel, a wave 4 file not yet written, and failed the cut gate; both were withdrawn on 2026-10-03",
  "the spacing row gave a tilde before a quote as a spacing-sensitive position; the path ref grammar skips whitespace after the tilde, so the example now is a letter right after a particle aim, and the tilde case sits in the limits as a counterexample"
 ]
 links_pending: "the plates panel is planned for wave 4 as link-only frames that pin anchors from several classes, so it can link this protocol once it exists"
 pending_targets: #[ "concepts/plates.spw#concepts_plates" ]
}

^["edges"]{
 feeds: [ ~"../doors/equals.spw#spw_door_equals", ~"../specimens/design-tokens.spw#spw_spec_design" ]
 see: [ ~"../hosts/vscode-rendering.spw#editor_hosts_vscode_rendering_layers", ~"../theory/valence-and-charge.spw#spw_theory_valence_palette_problem", ~"../contraptions/kerning.spw#spw_lab_kerning" ]
}

^["standing"]{
 #>spw_perspectives_designers_standing
 ^["hypothesis"]{
  #:claim #!interpretive
  statement: "This protocol was written by an agent outside the cluster; it stays a hypothesis until a working designer runs the squint test and the token rows and says which held."
  member_probe: "a designer prints two surfaces, marks the hierarchy they see before reading any word, and compares it with the outline the tool reports"
 }
}

^["page"]{
 #>spw_perspectives_designers_page
 ^["page_hierarchy"]{
  #:claim #!settled
  statement: "Each surface in this cut builds its hierarchy from position: a title comment, an anchor, an axis stack, then frames indented one space per level, so the left edge reads as an outline."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_cut_contract"
  label: "a-cut rule from the contract shape and legibility frames"
  tradition: "a typographer will recognize hierarchy carried by position, spacing, and a few consistent contrasts"
  tradition_source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_bringhurst_2012"
  ^["limits"]{
   holds: "surfaces that pass the cut gate"
   fails: "the gate warns on width and anchor placement but does not measure visual rhythm, so two passing surfaces can still read unevenly"
  }
 }
 #>spw_perspectives_designers_projection
 ^["highlighting_as_projection"]{
  #:claim #!settled
  statement: "Editor color is a projection: the VS Code layers each color Spw from their own reading of the text, and the cut bars any meaning that depends on color alone."
  example: ~"../hosts/vscode-rendering.spw#editor_hosts_vscode_rendering_layers"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_cut_contract"
  breaks: "a design system treats color as a token with intent, while here a hue may only repeat what a glyph already says"
 }
}

^["material"]{
 #>spw_perspectives_designers_valence
 ^["valence_as_material"]{
  #:claim #!settled
  statement: "Canon calls the five valences charge-neutral material quality and says no valence is inherently good or bad."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_canon_valence"
  cites: [ "docs/theory/spw/valence-architecture.spw:38", "docs/theory/spw/valence-architecture.spw:115" ]
  reading: "a swatch book of materials, such as structure, opening, constraint, transition, and warning, rather than a good-to-bad ramp"
  breaks: "hue is continuous and cyclic, while the five valences are categories whose order, if any, is unsettled; a red-to-green palette would smuggle merit back in"
 }
 #>spw_perspectives_designers_tokens
 ^["tokens_and_cells"]{
  #:claim #!interpretive
  statement: "A design token and a registry cell both keep one named value in one place, but a token aliases other tokens and carries intent, while a cell holds a measurement and its source."
  example: ~"../doors/cell.spw#spw_door_cell_shape"
  see: ~"../specimens/design-tokens.spw#spw_spec_design_pixels"
 }
}

^["proximity"]{
 #>spw_perspectives_designers_gestalt
 ^["grouping_by_proximity"]{
  #:claim #!settled
  statement: "Wertheimer described grouping by proximity: elements placed closer together tend to be seen as belonging together."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_wertheimer_1923"
 }
 #>spw_perspectives_designers_spacing
 ^["spacing_positions"]{
  #:claim #!settled
  statement: "Spacing changes the parse only at exact positions, such as a hash before a word or a letter right after a particle's aim mark, and nowhere grades meaning by distance."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_seed_lexer"
  cites: [ "packages/spw-seed/src/lexer/matchers/comments.ts:52-96", "packages/spw-seed/src/lexer/matchers/particles.ts:20-33" ]
  probe_run: "at HEAD 651b535b on 2026-10-03, a: #b gave a tag while a: # b dropped the rest of the line, and #:claim gave one particle while #: claim gave a binding keyed by a bare hash operation"
  examples: [ ~"../doors/hash.spw#spw_door_hash_drop", ~"../doors/particle.spw#spw_door_particle_aims" ]
  ^["limits"]{
   holds: "the hash and particle positions above, each confirmed by a probe"
   fails: "a tilde path ref skips a space before its quoted path, so a spaced and a tight link parse to the same tree even though spw inspect spacing labels the two gaps differently"
  }
  breaks: "proximity is graded in perception, while a Spw gap is either significant at one position or not significant at all"
 }
}

^["protocol"]{
 #>spw_perspectives_designers_clusters
 ^["visual_affinity"]{
  #:claim #!settled
  statement: "In this cut a computed cluster is a prompt to compare, never a claim, so a plate that groups surfaces by visual affinity asks a question rather than answering one."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_cut_contract"
 }
 steps: << "print one surface in grey" ; "squint until the words vanish and mark the shapes that remain" ; "read the claim moods and valence words without color" ; "map each token you would reach for to a cell or a quoted string" ; "only then open the editor theme" >>
}

^["tools"]{
 outline: .{ command: "spw outline", use: "frame landmarks without the prose", status: #implemented, cites: "packages/spw-cli/src/commands.ts:338-343" }
 spacing: .{ command: "spw inspect spacing", use: "classify each significant gap", status: #implemented, cites: "packages/spw-cli/src/commands.ts:277-282" }
 atlas: .{ command: "spw atlas --html", use: "a visual map of a workspace before reading files", status: #implemented, cites: "packages/spw-cli/src/commands.ts:186-191" }
 status_glyphs: .{ mode: "claim status shown as glyph inlays beside the mood word", status: #proposed }
 kerning: .{ contraption: "kerning", use: "where a space changes the parse tree", status: #proposed }
}

^["try"]{
 #>spw_perspectives_designers_try
 ^["squint_test"]{
  materials: [ "a grey printout of one surface in this cut", "a pencil", "the spw CLI in this repository" ]
  steps: << "hold the page at arm length and squint until words blur" ; "mark the blocks, indents, and gaps that still show" ; "run spw outline on the same file" ; "compare your marks with the landmarks it prints" >>
  time: .{ n: 15, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"./designers.spw#spw_perspectives_designers_page"
 }
}

#>spw_perspectives_designers_q
?["Would margin glyphs for claim status speed a scan without changing what a careful reader finds?"]{
 #:depth #!stylistic ~#lens(applied attention)
 #:claim #!speculative
 ~#hypothesis: "Margin glyphs beside the mood word would speed a scan for contested claims, while a careful reader finds the same claims, since the word still carries the meaning."
 !probe{ "mark contested claims on two printed copies, one with hand-drawn margin glyphs, and note which copy you finished first and what each missed" =id[p_doors_designers_margin_glyphs] =kind[field] }
 breaks: "a glyph inlay is proposed for the editor and exists nowhere yet, so the probe tests a sketch, not a feature"
 ~"./designers.spw#spw_perspectives_designers_projection" ~#neighbor(nearest)
}
