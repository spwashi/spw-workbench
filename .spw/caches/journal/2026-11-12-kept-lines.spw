# Kept lines — 2026-11-12
#
# The owner asked for one pass over three trees: a story consumer's lane game (characters, tropes, teasing, beats, spells, sound and set, a readable story, powers that are seasonal and leave a residue, spells that are shared), and for this repo to consider braces with labels, a close that mirrors its open, a reader that scans braces forward and backward, _ beside #, operator labels as a mark and a name, modes that turn readers on and off, and a more useful example of a .spw tree. A second message asked for direction in the site consumer's caches.
# One thing ran through all of it: a line of Spw somebody keeps. Nothing here is decided; the readings are trial cards.

#>journal_2026_11_12_kept_lines
#:cache #!observation
#:layer #!pragmatics

^["entry"]{
 date: "2026-11-12"
 kind: #observation
 base: "this repo at c14d5b6d with pair-label-reading uncommitted; the story consumer and the site consumer read and written in place, in their own working trees, uncommitted"
 method: "four read-only surveys of the story consumer's game, each claim used here reread at its line; an opt-in pass over seed's tokens with laws over generated text and two mutants; a token census of three corpora with a scratch script, each surface lexed under the prose profile; one text under two parser builds; the consumer's own checks and its browser smoke test"
 limits: "the census reads .spw files only, so a consumer's selection spans, which live in its page scripts, were not counted; worktrees and archives were left out; nobody has listened to any sound or played the game by hand; every word written for the consumer's readers is a candidate for its maker"
 corrects: "this session's own first draft, which named the pass brace labels and read a crossing as damage: the form was already here as pair labels, and a consumer's plans already recorded the owner's reading that labeled braces may overlap"
}

^["found_first"]{
 # What existed before the question was asked again, and where.
 desugar: "normalize.ts writes A{} as {_A }_A and a sigil, an underscore and a name as sigil(name), by patterns over the whole text"
 fields: "Frame, Body and Scope nodes reserve openLabel and closeLabel; no grammar rule sets them; parse columns and nest-path read them when set"
 geometry: "form geometry moves a label on and off a pair (egress.pair_labels, pair_label_publish)"
 plan: ~"../../../.agents/plans/operational-topography/wip.spw"
 skill: "the operator-lattice skill: treat _ as the intrinsic operator carrier, favor labeled brace symmetry when block identity must survive projection"
 consumer: "a mounted consumer's plans: labeled braces permit overlapping, non-nesting scopes, load-bearing for selection spans, described nowhere durable; _ as label and escape with an intrinsic-operator history"
 lesson: "a search for the word label found none of this; a count of the literal form over the corpora found all of it"
}

^["pass"]{
 # scanPairLabels, experimental, spw.pair-labels/1. The parser is untouched.
 reads: "a label on an open, _name against the brace; a close that repeats it after the brace, or mirrors it before the brace"
 class: "a label makes a class: a brace pairs only with a brace of its kind carrying the same label, bare with bare"
 overlap: "classes do not see each other, so labeled pairs may cross; each crossing is listed, and tree says whether the pairs still nest"
 direction: "forward an open accumulates and a close releases, backward the reverse; both return the same pairs on any text, garbled text included"
 cut: "a text cut at any gap leaves the same classes waiting at its head as at its tail, so a window says which labeled blocks it sits in"
 damage: "a missing labeled close loses its own pair and no other; a missing bare close shifts every pair outward"
 mirror: "a mirrored close, read leftward from its brace, spells what the open spells rightward; a label ending in a digit or a hyphen has none the lexer keeps whole"
 one_end: "a label on one end finds no partner; loose says what the leftovers would pair as by kind alone, advisory, since there a bare close can stand in for a missing labeled one"
 not_read: "angle capsules, streams and n-ranges; a key, a binding's value, a word with its own brace and a brace's whole content are left as words"
 tested: "22 tests; two mutants fail 8 and 2 of them; seed 1,116 pass, CLI 419, runtime 137; tsc clean; LSP 404 of 405, the one failure (form-context label mobility) present on the committed tree without this work"
}

^["census"]{
 # .spw surfaces, worktrees and archives left out, each lexed under the prose profile.
 here: .{ surfaces: 1368, braces: 148819, labeled_pairs: 12, repeated: 12, mirrored: 0, crossing: 0, open_only: 10 }
 story_consumer: .{ surfaces: 164, braces: 15002, labeled_pairs: 0, open_only: 5 }
 site_consumer: .{ surfaces: 2254, braces: 151088, labeled_pairs: 0, open_only: 5, unpaired: 1 }
 here_reads: "the twelve wrap whole theory and probe surfaces, {_topography … }_topography; the ten label the open and close bare"
 story_reads: "the five are (_in \"boon.land\") and (_from \"bane.land\"): a leading word for a relation, not a name for the pair"
 site_reads: "its five are a reference copy of the story consumer's file; the one is a macro-like word"
 two_builds: "the committed seed and this tree read 1,368, 164 and 2,254 surfaces alike: 141,040, 14,300 and 202,977 lines with a reading, none drifted"
}

^["underscore"]{
 # By token, strings not counted.
 here: .{ holes: 410, words: 152015, inside: 30372, leading: 75, against_a_sigil: 7, trailing: 12 }
 story_consumer: .{ holes: 0, words: 28355, inside: 3327, leading: 6, against_a_sigil: 0, trailing: 0 }
 site_consumer: .{ holes: 28, words: 232246, inside: 56915, leading: 82, against_a_sigil: 19, trailing: 5 }
 reading: "the joiner inside a word is about a fifth of all words and has to be left alone; the leading mark is written a few dozen times a corpus, in four uses: a pair label, a relation word, a sigil's label, and a private-looking id"
}

^["host"]{
 # What the story consumer's game does with a kept line, built in its tree the same day behind a switch that starts off.
 season: "for four days a place is set by the road, the cloth, cup and plate its book sets early; its spell uses only words the game already bounds; the days are an event entry, and a check holds the two equal"
 line: "the first meeting writes one line into the reader's browser: ^kept[thursday]{_thursday .day[…] .chapter[…] .carrier[…] *kept_place{ ~warm[4] } yadsruht_}"
 seal: "the line opens with its season as a label and ends with the label mirrored; cut anywhere, it does not close and is refused"
 two_halves: "after the days the place stays set only where a day written by play and a sealed line are both held; a pasted line is shown to anyone else and never kept; a line carried in an address is shown and writes nothing; what plays afterward is the season's own residue, the line being the key and not the spell"
 walked: "its browser smoke test walks before, during, after with both and after with the line alone, a cut paste, and a line carried in an address; 19 of 19 at the end of the day, and its own check passes at 23 steps"
 beside_it: "two more trials in the same tree, both off: the people of the lanes answer a knock, a power taken and a power run out with a face and a narrated deed (41 moments, 64 rows), and each of its six places keeps its own light, room and quiet bed, with a door moving the ear; the sound was proved unchanged when off on a recording mock, and nobody has listened to it"
 readers: "the seal is read by this repo's pass (the line is a fixture in its tests), by a small reader in the game, and by a highlighter that draws the mirror as a reflection"
 parser: "the consumer's pinned parser reads the line whole, with the label and its mirror as two words in the body"
}

^["found_on_the_way"]{
 # In the consumer, seen while building; each is in its own tree, not here.
 captions: "its captions split a sentence at any full stop, so a name with a stop in it was said in two lines; 16 of 488 paragraphs. Shaped to 84 characters with every word kept: 577 lines over that became 3, and 186 given less time than their words need became none. Measured in a browser afterward: a carry passes a chapter in about 54 seconds and shows 11 to 20 of some 200 lines, so the captions are a skim, and they now pick up where a passage opens"
 record: "four fields a carry writes were never read back, so a trope's stage and the sheet's bests began over each visit"
 crossings: "a trope was crossed only by carrying its thing past untouched; doing what the trope is about did not count, and five tropes named kinds that are never things"
 calendar: "its book puts its feast at the turn of the year, so a season in late November is a Thursday that is kept, not the feast"
}

^["offers"]{
 # None decided. Each sits on a trial card or in a plan stream.
 fields_where_it_nests: "a grammar rule could set openLabel and closeLabel on a pair that nests and leave an overlap to a list beside the tree (operational-topography)"
 seal_upstream: "a host that seals a line wants the seal read by the reader that reads the line; the pass is that reader once a consumer pins it"
 census_first: "before a mark gets a meaning, count where it is written in every tree that mounts this one; the pass and its census are two functions and a walk"
 region_readers: "a reader chosen per region has to be found before lexing; a mirrored close is findable by its text (wonder_trial_reader_modes)"
 example_tree: "a small tree worth copying holds one of each: a surface a program reads with its check, one a person keeps true, a dated entry never edited, a wonder with a guess before its probe, and the form of a line a visitor may keep; the quest preset has the wonder and the shelves and none of the rest"
}

^["cards"]{
 pair_label: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_pair_label"
 underscore: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_underscore"
 operator_label: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_operator_label"
 reader_modes: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_reader_modes"
 plan: ~"../../../.agents/plans/pair-label-reading/wip.spw"
}
