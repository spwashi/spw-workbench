# Season 2026 Q4
#
# One run of the recurring season kept in the tree: the dated calendar from 1 October 2026 to 4 January 2027, and the trail that walks it.

#>journal_2026_10_01_season_2026_q4
#:layer #!pragmatics

^["entry"]{
 date: "2026-10-01"
 kind: #instance
 of: ~"../../tree/season/index.spw#season_index"
 runs_to: "2027-01-04"
}

^["files"]{
 calendar: ~"./calendar.spw#season_calendar_2026q4"
 trail: ~"./trail.spw#trail_season_2026_q4"
}

^["moves"]{
 calendar: "moved on 2026-10-13 from tree/season/calendar-2026q4.spw; its anchors are unchanged"
 trail: "moved on 2026-10-13 from tree/trails/season-2026-q4.spw; its anchors are unchanged"
 why: "the arc, protocol, festivals, fiscal years, and the weekly page recur each year and stay in the tree; this calendar and trail belong to one season"
}
