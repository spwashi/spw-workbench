# Said and sounded — 2026-11-13
#
# The owner asked to consider Spw serialized into forms that can be described to a blind person, to evaluate grounding topography through plates, to consider a canvas host as a site for a higher order field model of cognitive flow, and the inside and outside of concepts as overlapping or interleaved dimensions; then to commit, and to make targeted improvements for browsers ahead of a release on the 13th. While the work ran they added: a click on an open and a close brace whose timbre changes with the label, permeability as a design dimension, a story consumer's sound library, game state a board summarizer could recognize, and a start and stop phrase a listener learns.
# Two readers were built and two losses fixed. The five considerations are trial cards. Nothing here was heard by anyone.

#>journal_2026_11_13_said_and_sounded
#:cache #!observation
#:layer #!pragmatics

^["entry"]{
 date: "2026-11-13"
 kind: #observation
 base: "this repo at ba75100c with spoken-form uncommitted; two consumers read in place and not written"
 method: "a count of prior words before naming, in this repo and in a site consumer's caches; two opt-in readers in seed's experimental folder with laws over fixtures and generated text and five mutants; spectra measured on rendered samples; a census of three corpora with a scratch script; the release contract test, which builds the browser bundles and imports them"
 limits: "no screen reader was run and no sound was played to anyone, so every claim is about text and samples; the census reads .spw files only and says each surface a line at a time; the sound's numbers are a first guess; a consumer's sound library was read from its manifest, and its samples were not opened"
}

^["found_first"]{
 # What existed before the question, and where.
 spoken_twin: "a site consumer's caches ask that every Spw run a reader may hear carry a spoken twin made only of operator and slot names, and record that its creator ruled out connective words; a later cache of seven wonders found its canvas names a node by the raw line and that nobody had written down how a dot is said"
 names: "learn/readers.ts holds the operator names and line/names.ts the slot names in two columns, a reader's and a consumer's; a comment there already names four joins: a sequence, a list, a movement, a tight body"
 sound_card: "a trial card already asks whether a sound, a force or a material given to a mark is a reading or a decoration (wonder_trial_modality)"
 field_theory: "em-fixity-association reads an open as an accumulate port and a close as a release port, and says of itself: an interpretive profile, not Maxwell; field-dynamics defines flux as permeability times gradient and a membrane as a boundary law; coupling-constructors lists permeability as a view field until a dialect implements it"
 plates: "three things already carry the word or its neighbours: stencil.ts (form with the content cut out), findRhymes (a shape with holes), and six plates in the cache tree (pins, one reading, a required breaks line); the owner declined plate as a noun for the parse tree on 2026-11-11"
}

^["said"]{
 # spokenLine, experimental, spw.spoken/1.
 form: "~garden[care]{seed, water} is said: potential garden, mode care, definition, list of 2: seed, water"
 joins: "a comma, a semicolon, a tight dot and a movement are said list, sequence, tight and movement, so lines that differ only in their join are said differently"
 ends: "a body that held another pair says where it ends, by its word or its label: end kept place, end thursday; a flat body does not"
 labels: "a pair label is said once at the open (labeled thursday) and once at the close, the same for a repeated and a mirrored close"
 beside: "parts set beside each other are said one after another, so a state line such as ^board{ @hold[upright] *lanes[3] ~pace[calm] } is said whole"
 tables: "every word comes from a table a host may replace: marks, slots in two columns, joins, bonds, and the words end, labeled, key and unread; a join may be silenced"
 laws: "over 40 fixtures, 18 samples and 1,500 generated lines: no written character goes unsaid, none is said twice, and the written text of the clauses reads back to the source without its gaps; what the slot reader left unread is said as written and counted"
 not_decided: "an underscore inside a word is said as a gap by default; whether that is right is on the card, and a host can keep the written word"
}

^["sounded"]{
 # pairSound, experimental, spw.pair-sound/1.
 kind: "{ } [ ] and ( ) sit on three notes of one chord"
 depth: "a pair inside another sounds two semitones lower, to a floor of six"
 label: "a label picks the strength of five overtones, in quarters, from its letters; a bare pair is one pure tone; 3,124 timbres are possible, so two labels may share one"
 edge: "an open is struck and dies away; a close is the same samples backward"
 damage: "an edge with no partner carries a second tone at the square root of two above its pitch"
 bounds: "a stretch starts with three rising notes and stops with the same three falling"
 measured: "on rendered samples: a close is its open backward sample for sample; each overtone comes out within 0.08 of what the label asks; a bare pair holds under 0.05 of any overtone; the rough tone is over four times stronger on an edge with no partner than the spread of a paired one"
 hear_it: "npm run sound:pairs -- --line '<spw>' --out clicks.wav writes a file to listen to, and prints how the line is said"
}

^["census"]{
 # .spw surfaces, worktrees and archives left out.
 said_here: .{ surfaces: 1370, lines: 163611, nothing_unread: "59.0%", characters_unread: "1.0%", unsaid: 0, threw: 0 }
 said_story_consumer: .{ surfaces: 169, lines: 16274, nothing_unread: "67.1%", characters_unread: "0.6%", unsaid: 0, threw: 0 }
 said_site_consumer: .{ surfaces: 2255, lines: 217485, nothing_unread: "63.2%", characters_unread: "0.7%", unsaid: 0, threw: 0 }
 unread_reads: "most of what is unread is a brace that opens on one line and closes on another; a reader that takes a line at a time cannot pair it"
 closes_here: .{ pairs: 74524, on_one_line: "66.6%", ten_lines_or_more: "7.9%", forty_lines_or_more: 613, of_those_labeled: 12, farthest: 423 }
 closes_story_consumer: .{ pairs: 7535, on_one_line: "69.9%", ten_lines_or_more: "9.6%", forty_lines_or_more: 71, of_those_labeled: 0, farthest: 574 }
 closes_site_consumer: .{ pairs: 75579, on_one_line: "61.5%", ten_lines_or_more: "8.9%", forty_lines_or_more: 641, of_those_labeled: 0, farthest: 1349 }
 closes_reads: "a sighted reader finds those closes by indentation; a listener meets a close brace with nothing to say what it closes, and a label on the close, said or sounded, is the only thing in the text that would"
 shapes: "reading top-down, of subtrees of six or more nodes, 17.7% here, 20.5% and 26.3% in the consumers have a shape already met earlier in the same surface"
}

^["fixed_on_the_way"]{
 caret: "a caret inside @(topic) found the expression and stopped: the lookup walks a fixed list of child properties and never gained scope or capsule when same-line postfix containers landed, so the editor's form context had no label there and one LSP test had been red; a law now walks every key of the tree"
 dots: "the slot reader split ^kept[thursday]{ .day[x] .chapter[y] } at its dots as a tight body and dropped the ground mark from each part; a tight dot now needs a word on both sides"
 dots_moved: "the slot reader before and after, over every line of the three corpora: 4 of 172,022 lines read differently here, 198 of 17,267 in a story consumer and 13 of 225,487 in the site consumer, each a body where a dot led a word after a gap, such as *wonders{ @torch_ants .press_stones $drying_line }"
 host_effect: "both ship in the browser reader bundle: a page that lays out a state line now gets its parts with their marks, and an editor's hover inside a scope written against an operator answers again"
}

^["sound_sources"]{
 # A story consumer's sound library, read from its manifest.
 sources: "two, both CC0-1.0: Kenney's audio packs (eight packs, two skipped) and the Versilian Community Sample Library at a pinned commit (39 folders)"
 kept_how: "raw sources are fetched into a folder its repository ignores, and a sound reaches its game only as a trimmed take with a sidecar; each pack's page must state its license before anything is fetched"
 fit: "CC0 material may ship beside this repo's MIT license; its interface packs (clicks, toggles) and its claves are the nearest to a brace click"
 not_done: "no sample was copied here: the clicks are synthesized, so a test can hold them to numbers, and whether a sampled click is wanted is the owner's"
}

^["offers"]{
 # None decided. Each sits on a trial card or in the plan.
 said: "how a line is said: names, marks, a sentence, or sound beside plain words (wonder_trial_said)"
 plate: "stencil, template, plate and ground-and-edge share one form, something held already and a stated place where it stops holding; a spoken form could say a shape once (wonder_trial_plate)"
 permeability: "what a container lets through, said by its kind, a label, a mark or only a view; the first measurable version is the references and ties that cross it (wonder_trial_permeability)"
 inside: "inside as a place in a tree, a set of spans, a coordinate, or a reach; < > is the pair this repo calls a concept and the one pair the scan does not read (wonder_trial_inside)"
 field_order: "what would make the field reading higher order, with its breaks line: nothing here is conserved, valences have no sign that cancels, readings do not add, and no attention has been measured (wonder_trial_field_order)"
 summarizer: "a board summarizer is a table from a recognized line to a sentence: the spoken form says a state line whole today, and the pattern matcher in query/ is where recognizing one would start"
 rows: "a whole surface said as rows with a level and a position, for a tree widget, is the parse columns read once more"
}

^["cards"]{
 said: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_said"
 plate: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_plate"
 permeability: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_permeability"
 inside: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_inside"
 field_order: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_field_order"
 modality: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_modality"
 plan: ~"../../../.agents/plans/spoken-form/wip.spw"
}
