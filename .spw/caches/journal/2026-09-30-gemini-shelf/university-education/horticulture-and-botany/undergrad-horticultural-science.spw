# Undergraduate Horticultural Science Curricular Architecture
#
# Bachelor of Science (B.S.) in Horticulture: soil fertility, asexual propagation, pomology, greenhouse CEA, and IPM.

#>spw_cache_univ_undergrad_horticulture
#:cache #!horticulture
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the four-year undergraduate curriculum for a Bachelor of Science in Horticultural Science, articulating soil chemistry, asexual plant propagation, controlled environment agriculture (CEA), and sustainable crop management."
  ~#accreditation: "American Society for Horticultural Science (ASHS) Collegiate Curriculum Standards"
}

^["soil_science_and_plant_mineral_nutrition"]{
  sophomore_gateway: "Soil Science and Plant Fertility Laboratory."
  pedological_foundations: #[
    "Soil Physical Properties: Soil textural triangle, bulk density, pore size distribution, field capacity, and permanent wilting point (-15 bar)",
    "Soil Chemistry & Ion Dynamics: Cation Exchange Capacity (CEC), base saturation percentage, and soil pH modulation of nutrient availability",
    "Macronutrient Assimilation: Nitrate (NO3-) vs Ammonium (NH4+) uptake kinetics; phosphorus soil fixation and mycorrhizal solubilization; potassium stomatal gating",
    "Secondary & Micronutrients: Calcium pectate middle lamella cell wall integrity (blossom end rot prevention); magnesium chlorophyll core; iron chelation (Fe-EDDHA)",
    "Composting & Organic Soil Health: Carbon-to-nitrogen (C:N) ratio optimization (30:1), thermophilic windrow curing, and soil microbial biomass"
  ]
}

^["plant_propagation_and_aseptic_micropropagation"]{
  junior_core: "Plant Propagation and Tissue Culture Laboratory."
  propagation_disciplines: .{
    vegetative_propagation: #[
      "Stem and Leaf Cuttings: Adventitious root primordia induction using synthetic auxins (Indole-3-butyric acid IBA, 1-Naphthaleneacetic acid NAA)",
      "Layering & Division: Air layering of woody ornamentals, stool layering, and crown division of herbaceous perennials"
    ]
    grafting_and_budding_craft: #[
      "Scion-Rootstock Compatibility: Whip-and-tongue, cleft grafting, and T-budding; exact vascular cambial ring alignment and parenchymal callus bridge formation",
      "Rootstock Physiology: Dwarfing mechanisms, woolly apple aphid resistance, and precocious flower induction in commercial orchards"
    ]
    in_vitro_micropropagation: #[
      "Murashige and Skoog (MS) Basal Medium: Agar gelling, sucrose carbon source, vitamins, and autoclaving sterilization protocols",
      "Organogenesis Hormone Ratios: High cytokinin-to-auxin ratio driving axillary shoot multiplication; high auxin-to-cytokinin ratio inducing root formation"
    ]
  }[reg=facet]
}

^["pomology_and_commercial_olericulture"]{
  junior_core: "Fruit and Vegetable Production Science."
  production_systems: #[
    "Tree Fruit Physiology: Chilling hour accumulation models (Utah and Dynamic models), vegetative-reproductive balance, and chemical fruitlet thinning",
    "Training & Pruning Architectures: Tall spindle, central leader, and multi-leader trellis systems optimizing photosynthetic light interception",
    "Harvest Maturity Indices: Refractometric soluble solids (Brix), starch-iodine index patterns, penetrometer flesh firmness, and titratable acidity",
    "Vegetable Crop Plasticulture: Polyethylene raised-bed mulching, sub-surface drip irrigation fertigation, and high-tunnel season extension"
  ]
}

^["controlled_environment_agriculture_cea"]{
  senior_core: "Commercial Greenhouse Engineering and Hydroponic Systems."
  greenhouse_engineering: .{
    climate_control_automation: #[
      "Vapor Pressure Deficit (VPD): Maintaining 0.8 to 1.2 kPa leaf-to-air VPD to drive continuous calcium transpiration without water stress",
      "Heating & Cooling: Hot-water radiant floor heating, motorized ridge vents, and evaporative wet-pad and exhaust fan systems",
      "Carbon Dioxide Enrichment: Elevated atmospheric CO2 dosing (800-1200 ppm) during daytime photosynthetic hours"
    ]
    hydroponic_systems: #[
      "Recirculating Systems: Nutrient Film Technique (NFT) troughs, Deep Water Culture (DWC) rafts, and Dutch bucket rockwool/coir drip fertigation",
      "Fertigation Dosing: Automated electrical conductivity (EC) control and acid injection maintaining root-zone pH between 5.5 and 6.2",
      "Horticultural Lighting: Daily Light Integral (DLI) calculation, supplemental LED spectrum tuning (red/blue and far-red phytochrome end-of-day pulse)"
    ]
  }[reg=facet]
}

^["integrated_pest_management_ipm"]{
  senior_core: "Applied Plant Pathology, Entomology, and Weed Science."
  management_protocols: #[
    "Economic Thresholds: Scouting populations to establish Economic Injury Levels (EIL) before authorizing chemical spray interventions",
    "Biological Controls: Mass release of predatory mites (Phytoseiulus persimilis), parasitoid wasps (Encarsia formosa), and beneficial nematodes (Steinernema)",
    "Resistance Management: Systematic rotation of pesticide modes of action adhering to IRAC (insecticide) and FRAC (fungicide) classification codes"
  ]
}

^["taste"]{
  ~#taste: "Horticulture is the ancient marriage of science and craft: partnering with the earth to feed, heal, and delight the human senses."
  ~#wonder: "Why does grafting a delicate heirloom apple twig onto a rugged wild rootstock result in a single unified living tree that bears the sweet fruit of the scion?"

  principles: #[
    "Root health governs the canopy: What happens unseen below the soil line dictates every leaf and fruit above it.",
    "Prevention over remediation: An optimized greenhouse environment with balanced VPD and clean tools prevents disease better than any chemical fungicide.",
    "Living soil is irreplaceable: Sterile hydroponics is efficient for greens, but the complex flavor of heirloom produce requires living microbial soil ecology."
  ]
}

^"invariants"{
  "Hydroponic fertigation solutions must be formulated to maintain root-zone electrical conductivity and pH within crop-specific physiological thresholds.",
  "Grafting operations must achieve physical alignment between the vascular cambia of the scion and rootstock.",
  "Greenhouse pesticide applications must strictly enforce worker re-entry intervals (REI) and certified personal protective equipment."
}

#>wonder_undergrad_horticulture_1
?["How does narrow-band dynamic far-red LED pulsing at dusk accelerate flowering in short-day greenhouse crops?"]{
  #:depth #!biological ~#lens(photomorphogenic_control)
  ~#hypothesis: "A 15-minute end-of-day far-red (730 nm) photon pulse converts active phytochrome Pfr rapidly to inactive Pr, simulating sunset and accelerating flower bud initiation by 10 days in indeterminate floral crops without stretching stem internodes."
  !probe{ "Measure flowering date, node count to first flower, and internode elongation in greenhouse crops grown under standard LED vs end-of-day far-red pulses." }
  $%[phenology.days_to_anthesis_reduction, morphology.internode_stem_length_mm]
}
