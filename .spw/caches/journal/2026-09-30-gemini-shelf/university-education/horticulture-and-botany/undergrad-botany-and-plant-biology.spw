# Undergraduate Botany & Plant Biology Curricular Architecture
#
# Bachelor of Science (B.S.) in Botany: plant anatomy, photosynthetic biophysics, phytohormone signaling, and systematic phylogenetics.

#>spw_cache_univ_undergrad_botany
#:cache #!botany
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the four-year undergraduate curriculum for a Bachelor of Science in Botany and Plant Biology, articulating cellular histology, photosynthetic bioenergetics, water transport mechanics, and systematic evolutionary phylogenetics."
  ~#accreditation: "Botanical Society of America (BSA) Core Botanical Curriculum Guidelines"
}

^["plant_anatomy_histology_and_development"]{
  sophomore_gateway: "Plant Anatomy and Microtechnique Laboratory."
  anatomical_foundations: #[
    "Meristematic Architecture: Shoot Apical Meristem (SAM) tunica-corpus organization, Root Apical Meristem (RAM), and lateral vascular/cork cambia",
    "Vascular Tissue Specialization: Xylem tracheids and vessel elements with bordered pits; phloem sieve tube members and companion cells with callose sieve plates",
    "Stomatal Mechanics: Guard cell osmotic turgor pressure driven by blue-light-activated H+-ATPase, potassium (K+) influx, and chloride/malate counter-ions",
    "Root Histology: Endodermis suberin Casparian strip enforcing symplastic water filtering; pericycle origin of lateral root branching",
    "Microtechnique Craft: Rotary microtome paraffin sectioning, double staining (safranin and fast green), and polarized light microscopy of cellulose wall microfibrils"
  ]
}

^["plant_physiology_and_photosynthetic_biochemistry"]{
  junior_core: "Plant Physiology and Biochemical Energetics."
  physiological_branches: .{
    photosynthetic_carbon_assimilation: #[
      "Light Reactions: Photosystems II and I Z-scheme electron transport, water photolysis oxygen-evolving complex, and trans-thylakoid proton gradient ATP synthesis",
      "Calvin-Benson Cycle & Photorespiration: Rubisco carboxylase efficiency, RuBP regeneration, and the costly glycolate salvage pathway",
      "C4 and CAM Adaptations: C4 Kranz anatomy with PEP carboxylase spatial separation (maize, sugarcane); Crassulacean Acid Metabolism temporal nocturnally open stomata"
    ]
    water_and_solute_transport: #[
      "Water Potential (Psi_w = Psi_s + Psi_p + Psi_g): Cohesion-tension theory of transpirational pull, xylem sap negative pressures, and acoustic cavitation/embolism repair",
      "Phloem Translocation: Munch pressure-flow hypothesis, apoplastic vs symplastic companion cell loading, and sink tissue unloading"
    ]
    phytohormonal_regulation: #[
      "Auxin (IAA): Polar auxin transport mediated by PIN efflux carrier proteins, apical dominance, and phototropic bending",
      "Cytokinins & Gibberellins: Shoot initiation, cell division, seed germination, and internode stem elongation",
      "Abscisic Acid (ABA) & Ethylene: Drought stress stomatal closure via calcium signaling; fruit ripening and leaf abscission"
    ]
  }[reg=facet]
}

^["systematic_botany_taxonomy_and_phylogenetics"]{
  junior_senior_core: "Systematics of Vascular Plants."
  phylogenetic_methods: #[
    "Angiosperm Phylogeny Group (APG IV): Monophyletic clade classification replacing artificial Linnaean systems with molecular chloroplast DNA (rbcL, matK) trees",
    "Alternation of Generations: Heterosporous life cycles, gametophyte reduction from bryophytes to gymnosperm pollen/ovules and angiosperm double fertilization",
    "Floral Morphology & Taxonomy: Floral diagrams, ovary position (epigynous vs hypogynous), and diagnostic characteristics of major families (Asteraceae, Fabaceae, Poaceae, Orchidaceae, Solanaceae)",
    "Herbarium Science: Field voucher collection, archival mounting on 100% rag paper, geographical georeferencing, and dichotomous taxonomic key identification"
  ]
}

^["plant_ecology_and_symbiotic_interactions"]{
  senior_core: "Plant Ecology and Field Botany."
  ecological_domains: #[
    "Mycorrhizal Symbioses: Arbuscular Mycorrhizal Fungi (AMF) penetrating root cells and ectomycorrhizal Hartig nets trading soil phosphorus for host carbon",
    "Biological Nitrogen Fixation: Rhizobium-legume root nodule signaling (flavonoids, Nod factors), bacteroid differentiation, and leghemoglobin oxygen buffering",
    "Pollination Syndromes & Seed Dispersal: Co-evolution with insect, avian, and mammalian vectors; anemophilous wind pollination mechanics",
    "Secondary Plant Defense Chemistry: Terpenoids, phenolics (lignin, tannins), alkaloids (nicotine, caffeine), and glucosinolates repelling herbivores"
  ]
}

^["taste"]{
  ~#taste: "Botany is the reverent study of the green skin of our world: recognizing that every breath of oxygen in our lungs was exhaled by a plant."
  ~#wonder: "Why does a seedling germinating in pitch darkness use gravitropic starch statoliths in its root cap to know with certainty which way is down?"

  principles: #[
    "Structure reflects climate: Leaf thickness, stomatal density, and venation architectures are physical recordings of atmospheric moisture and sunlight.",
    "Symbiosis over competition: A forest is not a war of isolated trees, but a cooperative subterranean fungal super-organism exchanging carbon and warning signals.",
    "Taxonomic precision: Knowing the exact botanical binomial name of a plant connects you to hundreds of years of curated human observation."
  ]
}

^"invariants"{
  "Herbarium specimens must include verified field collection metadata (GPS coordinates, habitat description, date, collector accession number).",
  "Plant physiological models must account for water potential gradients from soil to roots, xylem, leaves, and atmosphere.",
  "Taxonomic reclassifications must be supported by published monophyletic molecular phylogenies."
}

#>wonder_undergrad_botany_1
?["How does the epigenetic memory of maternal drought stress alter stomatal sensitivity in second-generation Arabidopsis progeny?"]{
  #:depth #!biological ~#lens(transgenerational_botany)
  ~#hypothesis: "Progeny of drought-stressed parent plants inherit altered DNA methylation patterns at ABA-responsive promoter loci, closing stomata 25% faster under acute vapor pressure deficits than progeny of well-watered lineages."
  !probe{ "Track transgenerational bisulfite sequencing and stomatal conductance dynamics across three generations of water-stressed Arabidopsis thaliana." }
  $%[epigenetics.methylation_differential_percent, stomata.transpiration_shutdown_seconds]
}
