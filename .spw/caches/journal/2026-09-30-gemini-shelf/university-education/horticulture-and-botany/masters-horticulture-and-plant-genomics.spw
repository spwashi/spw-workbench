# Graduate Master's Horticulture & Plant Genomics Architecture
#
# Master of Science (M.S.) in Plant Science: molecular breeding, CRISPR crop editing, NLR immune signaling, and postharvest biochemistry.

#>spw_cache_univ_masters_hort_botany
#:cache #!horticulture_and_botany
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the graduate Master of Science (M.S.) curriculum in advanced plant genetics, molecular breeding, plant pathology, and postharvest physiological biochemistry."
  ~#degree_milestones: "Graduate Core Coursework, Field Breeding Practicum, Laboratory Research Defense, and Master's Thesis"
}

^["quantitative_genetics_and_genomic_crop_breeding"]{
  graduate_depth: "Statistical genomics and marker-assisted selection for complex polygenic agronomic traits."
  breeding_methodologies: #[
    "Quantitative Trait Loci (QTL) Mapping: High-density SNP linkage maps, composite interval mapping, and genome-wide association studies (GWAS)",
    "Genomic Selection (GS): Ridge-Regression Best Linear Unbiased Prediction (RR-BLUP) and machine learning models predicting breeding values from genome-wide markers",
    "Breeding Schemes: Recurrent phenotypic selection, doubled haploid (DH) technology via microspore culture for immediate homozygosity, and pedigree selection",
    "Heterosis & Male Sterility: Cytoplasmic Male Sterility (CMS) and nuclear restorer (Rf) gene systems for scalable F1 hybrid vegetable and grain seed production"
  ]
}

^["crispr_cas_genome_editing_and_transformation"]{
  biotechnology_frontiers: "Precision molecular modification of crop genomes without foreign DNA integration."
  transformation_suite: .{
    transformation_vectors: #[
      "Agrobacterium tumefaciens: Binary Ti plasmid vectors, vir gene induction by acetosyringone, and T-DNA nuclear integration into plant chromosomes",
      "Biolistic Particle Bombardment: Gold microprojectile gene gun delivery into recalcitrant monocot meristems and embryogenic calli"
    ]
    precision_editing_technologies: #[
      "CRISPR-Cas9 & Cas12a Ribonucleoproteins: Pre-assembled RNP biolistic delivery generating transgene-free non-GMO regulatory classified edits",
      "Base Editing & Prime Editing: Cytidine/adenine deaminases and reverse transcriptase fusion proteins installing targeted single-nucleotide transversions",
      "Regulatory Architecture Tuning: Promoter and cis-regulatory element mutagenesis tuning fruit size (e.g. CLAVATA3-WUSCHEL locule number pathways)"
    ]
  }[reg=facet]
}

^["molecular_plant_pathology_and_immune_signaling"]{
  host_pathogen_coevolution: "Molecular mechanisms of plant defense and pathogen virulence."
  immune_architecture: #[
    "Pattern-Triggered Immunity (PTI): Surface receptor-like kinases (e.g. FLS2, EFR) recognizing Pathogen-Associated Molecular Patterns (PAMPs like flagellin and EF-Tu)",
    "Effector-Triggered Immunity (ETI): Intracellular Nucleotide-binding Leucine-rich Repeat (NLR) resistosomes recognizing pathogen effector virulence proteins",
    "Hypersensitive Response (HR): Localized programmed cell death and oxidative burst (NADPH oxidase generated superoxide) arresting pathogen spread",
    "Systemic Acquired Resistance (SAR): Long-distance vascular signaling mediated by salicylic acid, pipecolic acid, and PR-1 pathogenesis-related protein accumulation",
    "Viral Defense: Post-transcriptional gene silencing via Dicer-like (DCL) endonucleases, RNA-induced silencing complexes (RISC), and viral suppressors of silencing"
  ]
}

^["postharvest_physiology_and_senescence_biochemistry"]{
  shelf_life_science: "Biochemical management of living horticultural produce post-detachment."
  postharvest_mechanics: .{
    ethylene_signaling_cascade: "Methionine -> S-adenosylmethionine (SAM) -> 1-aminocyclopropane-1-carboxylic acid (ACC) via ACC synthase -> ethylene via ACC oxidase"
    ethylene_inhibition: "Gaseous 1-Methylcyclopropene (1-MCP) irreversibly binding ETR1 copper-containing membrane receptors, arresting climacteric ripening"
    controlled_atmosphere_storage: "Ultra-Low Oxygen (ULO) regimes (1.0% O2, 1.0% CO2 at 0.5C) suppressing cellular respiration and delaying chlorophyll breakdown for 12 months"
    chilling_injury_mitigation: "Pre-storage conditioning and intermittent warming preventing membrane phase transitions from liquid-crystalline to rigid gel states"
  }[reg=facet]
}

^["abiotic_stress_genomics_and_climate_resilience"]{
  climate_adaptation: #[
    "Salt Overly Sensitive (SOS) Pathway: SOS3 calcium sensor activating SOS2 kinase, phosphorylating SOS1 plasma membrane Na+/H+ antiporters to extrude toxic sodium",
    "Osmoprotectant Biosynthesis: Metabolic accumulation of proline, glycine betaine, and trehalose preserving cell turgor and macromolecular hydration",
    "ROS Scavenging Networks: Enzymatic superoxide dismutase (SOD), ascorbate peroxidase (APX), and the glutathione-ascorbate redox recycling loop"
  ]
}

^["taste"]{
  ~#taste: "Master's-level plant genetics is the stewardship of humanity's caloric and aesthetic future: engineering resilience into crops facing an unpredictable, warming biosphere."
  ~#wonder: "Why does the plant immune system utilize intracellular NLR immune receptors that share structural homology with human NOD-like receptors from a common ancestor one billion years ago?"

  principles: #[
    "Genome editing is not a magic wand: A single gene edit can improve disease resistance, but climate resilience requires complex multi-genic developmental coordination.",
    "Biodiversity is the ultimate seed bank: Conserving wild crop relatives in Vavilov centers of diversity holds the resistance genes we will need fifty years from now.",
    "Respect the living tissue: A harvested apple in cold storage is still breathing, metabolizing, and responding to its environment; treat it as a living organism."
  ]
}

^"invariants"{
  "Genomic selection prediction models must be validated through cross-validation across distinct breeding generations and multi-environment trials (MET).",
  "CRISPR-edited plant lines must be sequenced at predicted off-target loci using high-throughput sequencing before field trials.",
  "Controlled atmosphere cold storage protocols must maintain oxygen concentrations above the anaerobic fermentation threshold (avoiding ethanol accumulation).",
}

#>wonder_masters_hort_botany_1
?["How does CRISPR multiplex promoter editing of the SWEET sucrose transporter family confer broad-spectrum bacterial blight resistance in rice?"]{
  #:depth #!biological ~#lens(transcription_activator_resistance)
  ~#hypothesis: "Mutating the effector-binding elements (EBEs) in the promoters of OsSWEET11, OsSWEET13, and OsSWEET14 prevents Xanthomonas transcription-activator-like (TAL) effectors from inducing sucrose leakage into the apoplast, conferring complete non-host resistance without yield penalty."
  !probe{ "Inoculate multiplex promoter-edited rice cultivars with diverse geographical strains of Xanthomonas oryzae and quantify lesion length and grain yield." }
  $%[pathology.bacterial_blight_lesion_length_cm, agronomy.grain_yield_per_hectare_kg]
}
