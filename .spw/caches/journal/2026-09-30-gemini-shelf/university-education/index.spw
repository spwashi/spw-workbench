# University Educational Architecture Cache Index
#
# Root cache index for higher education institutional models, curricular topologies, and governance systems.

#>spw_cache_university_index
#:cache #!university
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the institutional structures, academic governance, research economies, and pedagogical scaffolds of the modern research university."
  ~#domain: "Higher education architecture, academic epistemologies, tenure, curriculum design"
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @governance: ~"./governance-and-tenure.spw"
  @curriculum: ~"./curricular-architecture.spw"
  @research: ~"./research-and-funding.spw"
  @pedagogy: ~"./pedagogical-scaffolding.spw"
  @infrastructure: ~"./institutional-infrastructure.spw"
  @taste: ~"./taste.spw"
  @chemistry_cheme: ~"./chemistry-and-chemical-engineering/index.spw"
  @physics_meche: ~"./physics-and-mechanical-engineering/index.spw"
  @materials_science: ~"./materials-science/index.spw"
  @thermodynamics: ~"./thermodynamics/index.spw"
  @ece: ~"./electrical-and-computer-engineering/index.spw"
  @horticulture_botany: ~"./horticulture-and-botany/index.spw"
  @illustration_animation: ~"./illustration-and-animation/index.spw"
  @design_ie: ~"./design-and-industrial-engineering/index.spw"
  @film_theatre: ~"./film-and-theatre/index.spw"
  @linguistics: ~"./linguistics/index.spw"
  @economics: ~"./economics/index.spw"
  @mathematics: ~"./mathematics/index.spw"
  @cognitive_psychology: ~"./cognitive-psychology/index.spw"
  @neuroscience: ~"./neuroscience/index.spw"
  @molecular_cellular_biology: ~"./molecular-and-cellular-biology/index.spw"
  @bioengineering: ~"./bioengineering/index.spw"
  @nursing: ~"./nursing/index.spw"
  @hospitality_management: ~"./hospitality-and-management/index.spw"
  @library_information_sciences: ~"./library-and-information-sciences/index.spw"
}

^"dispatch"{
  governance_and_tenure: @governance
  curricular_architecture: @curriculum
  research_and_funding: @research
  pedagogical_scaffolding: @pedagogy
  institutional_infrastructure: @infrastructure
  taste_considerations: @taste
  chemistry_and_chemical_engineering: @chemistry_cheme
  physics_and_mechanical_engineering: @physics_meche
  materials_science: @materials_science
  thermodynamics: @thermodynamics
  electrical_and_computer_engineering: @ece
  horticulture_and_botany: @horticulture_botany
  illustration_and_animation: @illustration_animation
  design_and_industrial_engineering: @design_ie
  film_and_theatre: @film_theatre
  linguistics: @linguistics
  economics: @economics
  mathematics: @mathematics
  cognitive_psychology: @cognitive_psychology
  neuroscience: @neuroscience
  molecular_and_cellular_biology: @molecular_cellular_biology
  bioengineering: @bioengineering
  nursing: @nursing
  hospitality_and_management: @hospitality_management
  library_and_information_sciences: @library_information_sciences
}

^"taste"{
  ~#taste: "The university is an enduring republic of letters where long-range inquiry is sheltered from transient market panic."
  ~#wonder: "Can an institution born in medieval monastic guild halls survive the digital disintegration of knowledge without losing its soul?"
}

^"invariants"{
  "Academic governance models maintain a checks-and-balances tension between faculty senates and executive administrations.",
  "Curricular degree pathways enforce prerequisite DAG constraints to ensure cumulative epistemological scaffolding.",
  "Research funding mechanics disclose indirect cost recovery and laboratory sustainability requirements.",
}

#>wonder_university_index_1
?["What is the defining organizational paradox of the modern research university?"]{
  #:depth #!philosophical ~#lens(institutional_schizophrenia)
  ~#hypothesis: "The university is simultaneously an open sanctuary for disinterested truth-seeking and a multi-billion dollar corporate engine competing for grants, patents, and endowment capital."
  !probe{ "Trace the budget allocation of an R1 university: compare spending on tenure-track undergraduate humanities seminars vs STEM lab capital infrastructure." }
  $%[budget.humanities_ratio, lab.capital_expenditure_usd]
}
