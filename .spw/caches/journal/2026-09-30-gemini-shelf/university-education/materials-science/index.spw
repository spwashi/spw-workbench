# Materials Science & Engineering Curricular Hub
#
# Root cache index for undergraduate and master's degree programs in materials science, characterization, and computation.

#>spw_cache_univ_mse_index
#:cache #!materials_science
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the full pedagogical and physical spectrum of Materials Science and Engineering (MSE), centered on the fundamental Structure-Processing-Property-Performance tetrahedron."
  ~#accreditation: "ABET Engineering Accreditation Commission Criteria for Materials and Metallurgical Engineering"
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @undergrad_mse: ~"./undergrad-materials-science.spw"
  @masters_mse: ~"./masters-materials-science.spw"
  @characterization_computation: ~"./characterization-and-computation.spw"
  @taste: ~"./taste.spw"
}

^"dispatch"{
  undergrad_materials_science: @undergrad_mse
  masters_materials_science: @masters_mse
  characterization_and_computation: @characterization_computation
  taste_considerations: @taste
}

^"taste"{
  ~#taste: "Materials science is the alchemy that makes all other engineering possible: without the material, every design is merely a ghost on a screen."
  ~#wonder: "Why does adding a mere 0.2 percent carbon to pure iron increase its tensile yield strength by more than five hundred percent?"
}

^"invariants"{
  "The Structure-Processing-Property-Performance tetrahedron governs all MSE curricular milestones and research methodologies.",
  "Crystallographic symmetry, defect thermodynamics, and phase transformation kinetics form the non-negotiable core across all materials classes (metals, ceramics, polymers, composites, semiconductors).",
  "Experimental characterization (electron microscopy, X-ray diffraction, spectroscopy) and computational modeling (DFT, MD, phase-field) must validate each other.",
}

#>wonder_mse_index_1
?["How does the early pedagogical integration of 3D virtual reality crystallography affect spatial understanding of reciprocal lattice Ewald spheres?"]{
  #:depth #!pedagogical ~#lens(reciprocal_space_visualization)
  ~#hypothesis: "Students who manipulate 3D reciprocal lattice vectors and Brillouin zones in immersive virtual reality achieve 55% higher scores on electron diffraction pattern indexing exams compared to students learning from 2D textbook projections."
  !probe{ "Conduct randomized assessment across junior crystallography cohorts comparing zone axis and Kikuchi line indexing accuracy with vs without VR reciprocal space modeling." }
  $%[pedagogy.reciprocal_lattice_mastery_index, crystallography.diffraction_indexing_accuracy]
}
