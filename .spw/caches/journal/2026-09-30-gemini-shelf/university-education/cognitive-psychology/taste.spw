# Cognitive Psychology Taste & Wonder Cache
#
# Reverse-engineering subjective mind, ecological rationality, and ethical choice architecture.

#>spw_cache_univ_cog_psych_taste
#:cache #!cognitive_psychology_taste
#:layer #!pragmatics

^"intent"{
  ~#goal: "Articulate the aesthetic wonder, intellectual humility, and ethical responsibilities inherent in modeling human cognition, heuristics, and subjective mental models."
  ~#protocol: "cache.layer/1"
}

^"taste_principles"{
  "heuristics_as_ecological_intelligence": .{
    beyond_the_deficit_fallacy: "Heuristics are not pathetic defects or irrational glitches; as Gerd Gigerenzer demonstrated, 'fast and frugal' heuristics are brilliantly evolved adaptive tools optimized for real-world uncertainty where calculating exact probabilities is computationally impossible",
    bounded_rationality_nobility: "Herbert Simon's insight: human decision-makers satisfice rather than optimize because reality is vast, computation is metabolically expensive, and survival demands decisive action under partial information",
  }[reg=facet],
  "ethical_stewardship_of_choice_architecture": .{
    the_dark_pattern_temptation: "Understanding cognitive vulnerabilities (anchoring, default bias, hyperbolic discounting, loss aversion) creates immense asymmetric power; weaponizing heuristics to trap consumers in subscription traps or gambling addiction is an ethical violation",
    humane_nudging: "Applying choice architecture (Thaler & Sunstein) transparently to support human flourishing, retirement security, organ donation, and cognitive well-being without covert coercion",
  }[reg=facet],
  "the_fragile_miracle_of_the_internal_theater": .{
    the_constructed_reality: "Everything we see, hear, remember, and desire is a sensory-motor simulation synthesized by the brain; to study cognitive psychology is to awaken from naive realism into profound awe at the mental cinema of consciousness",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_univ_cog_psych_taste_1
  ?["Why does the human mind experience subjective time as accelerating dramatically as we age from childhood to late adulthood?"]{
    #:depth #!phenomenological ~#lens(perceptual_novelty_and_memory_chunking)
    ~#hypothesis: "Subjective retrospective duration is calculated not by physical seconds, but by the density of new semantic and episodic memories laid down in neural circuits. For an 8-year-old, a summer is filled with first-time schema accommodations (high perceptual informational entropy); for an adult in repetitive routine, experiences are subsumed into existing scripts without novel encoding, collapsing perceived duration."
    !probe{ "Measure autobiographical memory encoding density and subjective duration ratings across routine-dominant vs high-novelty adult cohorts." }
    $%[cognition.novelty_memory_density_per_month, time.subjective_duration_dilation_factor]
  }

  #>wonder_univ_cog_psych_taste_2
  ?["How does the experience of 'Aha!' insight in problem-solving suddenly deliver an instantaneous solution without any conscious awareness of the intermediate calculation steps?"]{
    #:depth #!neurological ~#lens(subconscious_remote_associative_convergence)
    ~#hypothesis: "Insight occurs when unconscious parallel processing in the right anterior superior temporal gyrus spreads activation across distant semantic nodes beneath the threshold of conscious working memory. When activation suddenly crosses the threshold of coherence, an abrupt gamma-band burst binds the solution and floods the conscious prefrontal cortex with subjective certainty and dopamine."
    !probe{ "Record high-density EEG and fMRI immediately preceding (300ms before) self-reported insight vs analytical step-by-step problem completion." }
    $%[eeg.insight_prestimulus_gamma_burst, neuroimaging.anterior_stg_activation_volume]
  }
}
