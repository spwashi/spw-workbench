# University Cognitive Psychology Curriculum Cache Index
#
# Root cache index for psychophysics, working memory architectures, heuristic decision theory, and developmental cognition.

#>spw_cache_univ_cog_psych_index
#:cache #!cognitive_psychology
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model undergraduate and graduate university cognitive psychology: psychophysics and signal detection, multi-store memory systems, dual-process decision heuristics, and developmental cognitive architectures."
  ~#domains: "Cognitive science, psychophysics, working memory, decision heuristics, and cognitive development"
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @perception_attention: ~"./perception-attention-and-psychophysics.spw"
  @memory_systems: ~"./memory-systems-and-knowledge-representation.spw"
  @reasoning_heuristics: ~"./reasoning-decision-making-and-heuristics.spw"
  @cognitive_development: ~"./cognitive-development-and-language.spw"
  @taste: ~"./taste.spw"
}

^"dispatch"{
  perception_attention_and_psychophysics: @perception_attention
  memory_systems_and_knowledge_representation: @memory_systems
  reasoning_decision_making_and_heuristics: @reasoning_heuristics
  cognitive_development_and_language: @cognitive_development
  taste_considerations: @taste
}

^"taste"{
  ~#taste: "Cognitive psychology is the reverse engineering of the soul: charting the mental algorithms through which sensory chaos becomes conscious reality."
  ~#wonder: "Why is the human mind simultaneously capable of proving Gödel's theorems and falling prey to trivial framing illusions in a supermarket aisle?"
}

^"invariants"{
  "Psychophysical models must distinguish between sensory sensitivity (d-prime) and cognitive response bias (criterion c).",
  "Memory models must respect dual-store dissociations (declarative vs procedural) and working memory bottleneck bandwidths.",
  "Decision-making analyses must clearly separate descriptive behavioral heuristics from normative expected utility axioms.",
}

^"wonder_probes"{
  #>wonder_univ_cog_psych_index_1
  ?["How does the brain construct a coherent, seamless 3D illusion of visual reality despite receiving two upside-down, blind-spot-interrupted, saccadic retinal signals?"]{
    #:depth #!perceptual ~#lens(predictive_perceptual_synthesis)
    ~#hypothesis: "Visual perception is not passive photographic registration; it is an active top-down generative hallucination constrained by sparse bottom-up sensory prediction errors (Helmholtz unconscious inference / predictive processing)."
    !probe{ "Measure visual change-blindness latency and pupil dilation during micro-saccadic scene alterations synchronized to eye movement." }
    $%[vision.saccadic_suppression_duration_ms, cognition.change_blindness_detection_rate]
  }
}
