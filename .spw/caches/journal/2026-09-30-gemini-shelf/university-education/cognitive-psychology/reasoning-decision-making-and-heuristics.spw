# Reasoning, Decision-Making & Heuristics Curriculum Cache
#
# Dual-process theory, Wason conditional logic, Prospect Theory, loss aversion, and cognitive heuristics.

#>spw_cache_univ_cog_psych_reasoning
#:cache #!reasoning_decision_making_and_heuristics
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model formal deductive and inductive reasoning, dual-process cognition, Kahneman & Tversky heuristics, and Prospect Theory behavioral decision making."
  ~#protocol: "cache.layer/1"
}

^"formal_reasoning_and_conditional_logic"{
  "deductive_logic_and_the_wason_selection_task": .{
    conditional_syllogisms: "Modus Ponens (P -> Q; P; therefore Q) vs Modus Tollens (P -> Q; not Q; therefore not P); frequent fallacies: Affirming the Consequent and Denying the Antecedent",
    wason_selection_card_paradigm: "Testing rule 'If card has vowel on one side, it has even number on other'; human failure to turn over 'odd number' card demonstrating confirmation bias",
    social_contract_facilitation: "Cosmides & Tooby evolutionary psychology: when abstract Wason task is framed as social contract cheating detection (e.g., drinking alcohol under 21), success rates soar from <10% to >75%",
  }[reg=facet],
  "dual_process_cognitive_architecture": .{
    system_1_vs_system_2: "System 1: fast, automatic, unconscious, associative, computationally cheap, heuristic-driven; System 2: slow, deliberative, conscious, rule-governed, resource-limited, susceptible to cognitive fatigue",
    cognitive_reflection_test_crt: "Frederick CRT measuring propensity to override automatic System 1 heuristic intuitions with deliberate System 2 analytic computation (e.g., the bat-and-ball problem)",
  }[reg=facet],
}

^"heuristics_biases_and_prospect_theory"{
  "judgmental_heuristics_and_biases": .{
    availability_heuristic: "Assessing event frequency based on the ease and emotional vividness with which instances come to mind (e.g., overestimating plane crashes vs vehicular collisions)",
    representativeness_and_conjunction_fallacy: "Judging probability by similarity to an idealized prototype; Linda problem demonstrating conjunction fallacy where subjects judge P(feminist & bank teller) > P(bank teller); base-rate neglect",
    anchoring_and_adjustment: "Initial arbitrary numerical values anchor quantitative judgments, with insufficient cognitive adjustment away from the anchor even when explicitly told it is random",
  }[reg=facet],
  "kahneman_tversky_prospect_theory": .{
    reference_dependent_value_function: "Utility defined over gains and losses relative to a neutral reference point: concave for gains (risk aversion), convex for losses (risk seeking), and distinctly steeper for losses (loss aversion coefficient lambda ~ 2.0 to 2.5)",
    non_linear_probability_weighting: "Weighting function w(p) systematically overweights low-probability lottery and catastrophe outcomes while underweighting moderate and high-probability events",
    framing_effects_and_loss_aversion: "Asian Disease Problem: identical outcomes framed as lives saved trigger risk aversion, whereas framed as lives lost trigger desperate risk-seeking bets",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_univ_cog_psych_reasoning_1
  ?["Why does human cognition violate the fundamental probability axiom P(A and B) <= P(A) in the Linda conjunction fallacy?"]{
    #:depth #!epistemological ~#lens(coherence_over_extensional_probability)
    ~#hypothesis: "Human narrative intelligence prioritizes causal coherence and typological representativeness over mathematical extensional probability. Adding 'and is active in the feminist movement' paints a vivid, causally harmonious personality archetype that satisfies System 1 semantic pattern recognition, overriding dry set-theoretic logic."
    !probe{ "Measure anterior cingulate cortex (ACC) conflict-monitoring activation during classic Linda conjunction prompts vs logically transparent frequency-format prompts." }
    $%[neuroimaging.acc_conflict_signal_intensity, decision.conjunction_fallacy_violation_rate]
  }
}
