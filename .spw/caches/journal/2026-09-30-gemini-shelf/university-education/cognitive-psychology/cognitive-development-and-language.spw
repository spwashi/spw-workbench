# Cognitive Development & Conceptual Maturation Curriculum Cache
#
# Piagetian operational stages, Vygotskian scaffolding, Theory of Mind, and fluid vs crystallized aging dynamics.

#>spw_cache_univ_cog_psych_development
#:cache #!cognitive_development_and_language
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model developmental cognitive architectures, Piagetian stage transitions, Vygotskian sociocultural scaffolding, Theory of Mind ontogeny, and cognitive aging trajectories."
  ~#protocol: "cache.layer/1"
}

^"developmental_stages_and_mechanisms"{
  "piagetian_stage_architecture": .{
    assimilation_and_accommodation: "Assimilation (fitting new sensory information into existing mental schemas) and Accommodation (restructuring schemas when disconfirmed by experience) driving Equilibration",
    sensorimotor_and_preoperational: "Sensorimotor (0-2 yr): object permanence development and A-not-B perseveration error; Preoperational (2-7 yr): symbolic play, egocentrism (Three Mountain task), centration, and conservation failure",
    operational_stages: "Concrete Operational (7-11 yr): conservation of volume/mass, reversibility, and transitive inference; Formal Operational (11+ yr): abstract propositional logic and hypothetical-deductive hypothesis testing",
  }[reg=facet],
  "vygotskian_sociocultural_cognition": .{
    zone_of_proximal_development_zpd: "The developmental space between what a child can achieve independently and what can be achieved with collaborative adult or peer scaffolding (Bruner)",
    internalization_of_inner_speech: "Social communicative speech transformed through egocentric externalized monologue into silent internalized private thought—the master tool of metacognitive self-regulation",
  }[reg=facet],
}

^"social_cognition_executive_function_and_aging"{
  "theory_of_mind_and_inhibitory_control": .{
    false_belief_and_mentalizing: "Sally-Anne false-belief paradigm: children reliably shift from attributing reality to attributing subjective mental states between ages 3.5 and 4.5",
    executive_function_maturation: "Protracted prefrontal cortex myelination governing working memory, cognitive flexibility (Dimensional Change Card Sort DCCS), and delay of gratification (Mischel marshmallow test)",
  }[reg=facet],
  "cognitive_trajectories_across_the_lifespan": .{
    fluid_vs_crystallized_intelligence_cattell: "Fluid intelligence (G_f: processing speed, working memory capacity, novel abstract problem solving) peaks in early twenties and gradually declines; Crystallized intelligence (G_c: semantic vocabulary, accumulated factual knowledge, cultural wisdom) remains robust or expands through late adulthood",
    scaffolding_theory_of_aging_and_cognition_stac: "Aging brains maintain high cognitive performance through bilateral compensatory prefrontal neural recruitment and adaptive cognitive scaffolding",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_univ_cog_psych_development_1
  ?["Why do human children pass the Sally-Anne false-belief task at almost exactly 48 months of age across radically diverse cultures and languages?"]{
    #:depth #!developmental ~#lens(maturational_epistemic_decoupling)
    ~#hypothesis: "Passing false-belief tasks requires a biologically hardwired neurodevelopmental event: the maturation of the right temporoparietal junction (rTPJ) and its white-matter tracts to the medial prefrontal cortex. This circuitry allows the brain to hold two conflicting representations of reality simultaneously: the world as it actually is, and the world as represented inside another person's false belief."
    !probe{ "Map diffusion tensor imaging (DTI) arcuate fasciculus connectivity and rTPJ fMRI activation in 3-year-olds failing vs 4-year-olds passing false-belief tasks." }
    $%[development.rtpj_structural_connectivity_fraction, cognition.false_belief_pass_probability]
  }
}
