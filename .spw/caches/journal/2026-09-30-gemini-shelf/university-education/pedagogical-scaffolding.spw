# University Pedagogical Scaffolding & Instructional Modes
#
# Analysis of lecture halls, recitation sections, research seminars, and grading systems.

#>spw_cache_univ_pedagogy
#:cache #!university
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the operational pedagogy of university instruction across diverse class sizes and learning modalities."
  ~#focus: "Lectures, discussion sections, laboratory benches, seminars, and evaluation frameworks"
}

^["instructional_modalities"]{
  large_lecture: .{
    scale: "150 to 500+ students in sloped amphitheater lecture halls"
    pedagogy: "Broad conceptual exposition, rhetorical framing, demonstrations, guest keynote lectures"
    interaction: "Limited direct dialogue; supplemented by electronic polling or live audience response systems"
  }[reg=facet]

  recitation_discussion: .{
    scale: "18 to 28 students meeting weekly with a Graduate Teaching Assistant (TA)"
    pedagogy: "Active problem set solving, text analysis, clarifying confusing lecture proofs, review sessions"
    role: "The humanizing connective tissue of large university foundation courses"
  }[reg=facet]

  laboratory_and_studio: .{
    scale: "12 to 24 students at physical workbenches, microscopes, or art easels"
    pedagogy: "Direct empirical manipulation, instrument calibration, tactile error debugging, safety protocols"
  }[reg=facet]

  undergraduate_seminar: .{
    scale: "10 to 16 students around a single wooden conference table"
    pedagogy: "Socratic cross-examination of primary texts, student presentation of working papers, oral critique"
    role: "The pinnacle of liberal arts intellectual intimacy"
  }[reg=facet]
}

^["assessment_and_grading_curves"]{
  norm_referenced_curve: .{
    model: "Forced distribution (e.g. 15% As, 35% Bs, 35% Cs, 15% Ds/Fs)"
    context: "Historic STEM gateway courses; induces competitive zero-sum peer dynamics"
  }[reg=facet]

  criterion_referenced_mastery: .{
    model: "Grades awarded based on objective mastery rubrics regardless of peer distribution"
    context: "Upper-division seminars, project courses; encourages collaborative peer study groups"
  }[reg=facet]

  grade_inflation_trend: "Decades-long upward drift of average undergraduate GPAs (national average shifted from 2.5 in 1960 to 3.2+ today)."
}

^["the_teaching_assistant_apprenticeship"]{
  dual_identity: "Graduate TAs are simultaneously developing scholars and front-line classroom teachers."
  responsibilities: #[
    "Conducting weekly 50-minute recitation or lab sections",
    "Holding scheduled drop-in office hours for individualized tutoring",
    "Grading hundreds of problem sets, lab reports, and essay drafts",
    "Providing compassionate pastoral support to overwhelmed first-year students"
  ]
}

^["taste"]{
  ~#taste: "Teaching is not pouring liquid into an empty vessel; it is lighting a spark in dry kindling."
  ~#wonder: "Why does a 12-person seminar leave a lifelong imprint while a 400-person lecture fades from memory in a week?"

  principles: #[
    "Active over passive: A student who speaks aloud in class internalizes a concept 5x faster than one who only takes notes.",
    "The office hour sanctuary: The one-on-one conversation across a professor's book-lined desk is where life callings are forged.",
    "Compassionate rigor: Demanding excellence while offering unyielding scaffolding and support."
  ]
}

^["invariants"]{
  "Every credit-bearing course publishes a comprehensive syllabus detailing grading criteria on day one.",
  "Disability accommodations (extended exam time, distraction-free rooms) are legally binding.",
  "Instructional evaluations are collected anonymously to protect students from grading retaliation.",
}

#>wonder_univ_pedagogy_1
?["How does the physical architecture of a lecture hall dictate pedagogical passivity?"]{
  #:depth #!philosophical ~#lens(spatial_pedagogy)
  ~#hypothesis: "Tiered seating facing a solitary podium enforces an authoritarian broadcasting dynamic; a circular seminar table forces democratic peer engagement."
  !probe{ "Track student speaking time and voluntary question frequency in an amphitheater vs a flat circular room of the same cohort." }
  $%[student.active_speaking_seconds, instructor.broadcast_ratio]
}
