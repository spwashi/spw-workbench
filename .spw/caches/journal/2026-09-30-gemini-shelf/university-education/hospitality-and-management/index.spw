# University Hospitality & Management Curriculum Cache Index
#
# Root cache index for service blueprinting, revenue management algorithms, F&B menu engineering, and servant leadership.

#>spw_cache_univ_hosp_mgmt_index
#:cache #!hospitality_and_management
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model university hospitality administration and management: service experience blueprinting, RevPAR dynamic pricing algorithms, food and beverage menu engineering, and ethical organizational culture."
  ~#domains: "Hospitality administration, service operations, revenue management, culinary systems, and organizational leadership"
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @service_operations: ~"./service-operations-and-experience-design.spw"
  @revenue_management: ~"./revenue-management-and-dynamic-pricing.spw"
  @food_and_beverage: ~"./food-and-beverage-systems-and-procurement.spw"
  @organizational_leadership: ~"./organizational-leadership-and-hospitality-ethics.spw"
  @taste: ~"./taste.spw"
}

^"dispatch"{
  service_operations_and_experience_design: @service_operations
  revenue_management_and_dynamic_pricing: @revenue_management
  food_and_beverage_systems_and_procurement: @food_and_beverage
  organizational_leadership_and_hospitality_ethics: @organizational_leadership
  taste_considerations: @taste
}

^"taste"{
  ~#taste: "Hospitality is the ancient, sacred art of welcoming the stranger: transforming commercial transactions into sanctuary, communion, and grace."
  ~#wonder: "How does a world-class luxury hotel choreograph thousands of invisible backstage logistical operations so that a guest experiences only effortless, magical serenity?"
}

^"invariants"{
  "Service operations models must map explicit lines of visibility separating on-stage customer touchpoints from backstage support processes.",
  "Revenue management algorithms must account for perishable inventory constraints, unconstrained demand forecasting, and rate parity contracts.",
  "Food and beverage financial equations must enforce standard food cost percentages, par levels, and HACCP critical control limits.",
}

^"wonder_probes"{
  #>wonder_univ_hosp_mgmt_index_1
  ?["Why does a guest who experiences a service failure that is flawlessly recovered report higher long-term brand loyalty than a guest who experienced zero defects (the Service Recovery Paradox)?"]{
    #:depth #!psychological ~#lens(the_service_recovery_paradox)
    ~#hypothesis: "Flawless service is taken for granted as an expected baseline. A service failure followed by immediate, empathetic, empowered recovery provides the brand a high-stakes emotional stage to demonstrate genuine care and human vulnerability, transforming a routine commercial transaction into a memorable emotional bond."
    !probe{ "Track Net Promoter Scores (NPS) and 5-year repeat booking revenues across hotel guests with zero service issues vs guests experiencing documented service recovery resolutions." }
    $%[hospitality.service_recovery_loyalty_lift, business.customer_lifetime_value_retention]
  }
}
