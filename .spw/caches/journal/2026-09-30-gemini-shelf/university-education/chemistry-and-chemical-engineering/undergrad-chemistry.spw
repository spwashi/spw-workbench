# Undergraduate Chemistry Curricular Architecture
#
# ACS-certified Bachelor of Science (B.S.) in Chemistry: foundational disciplines, synthetic bench craft, and instrumental analysis.

#>spw_cache_univ_undergrad_chemistry
#:cache #!chemistry
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the four-year undergraduate curriculum for an ACS-certified Bachelor of Science in Chemistry, articulating foundational subdisciplines, laboratory bench mastery, and spectroscopic elucidation."
  ~#certification: "American Chemical Society (ACS) Guidelines for Bachelor's Degree Programs"
}

^["foundational_and_quantitative_chemistry"]{
  freshman_sequence: "General Chemistry I & II with Quantitative Analysis Lab."
  core_topics: #[
    "Stoichiometric Principles: Limiting reagents, theoretical yield, empirical formulae, and gas phase behavior",
    "Aqueous Chemical Equilibria: Polyprotic acid-base buffers, Henderson-Hasselbalch relations, common-ion effects, and solubility product constants (Ksp)",
    "Thermodynamic Potentials: Enthalpy of reaction, Hess's law, standard entropies, and Gibbs free energy criteria for spontaneity",
    "Electrochemistry: Galvanic and electrolytic cells, standard reduction potentials, Nernst equation, and cyclic voltammetry basics",
    "Quantitative Gravimetric & Volumetric Analysis: Analytical balance metrology, primary standards, redox titrations, and propagation of experimental uncertainty"
  ]
}

^["organic_chemistry_and_mechanistic_synthesis"]{
  sophomore_core: "Organic Chemistry I & II with Advanced Synthesis Laboratory."
  mechanistic_pillars: .{
    reaction_mechanisms: "Curved-arrow electron displacement formalism mapping electrophile-nucleophile interactions"
    aliphatic_pathways: "Bimolecular and unimolecular nucleophilic substitutions (SN1, SN2) and beta-eliminations (E1, E2) governed by sterics and solvent polarities"
    aromatic_systems: "Electrophilic and nucleophilic aromatic substitutions, Huckel 4n+2 pi-electron rule, directing effects, and diazonium salt chemistry"
    carbonyl_transformations: "Nucleophilic acyl substitutions, Aldol, Claisen, and Michael additions, enolate alkylations, and Wittig olefination"
    synthetic_bench_craft: #[
      "Multi-step organic synthesis (3-5 transformations) with microscale and macroscale glassware",
      "Purification techniques: fractional vacuum distillation, flash column chromatography, and recrystallization",
      "Reaction monitoring via thin-layer chromatography (TLC) under ultraviolet visualization"
    ]
  }[reg=facet]
}

^["physical_chemistry_and_quantum_foundations"]{
  junior_core: "Physical Chemistry I (Thermodynamics & Kinetics) and II (Quantum Chemistry & Spectroscopy)."
  subdisciplines: #[
    "Macroscopic & Statistical Thermodynamics: Real gas equations of state (van der Waals), Maxwell relations, chemical potential, phase diagrams, and colligative properties",
    "Chemical Reaction Kinetics: Rate laws, differential rate equations, temperature dependence (Arrhenius and Eyring formulations), enzyme kinetics, and collision theory",
    "Quantum Postulates: Wavefunctions, Hermitian operators, eigenvalue equations, and probability density interpretations",
    "Exact Quantum Models: Particle-in-a-box, quantum harmonic oscillator (Hermite polynomials), rigid rotor (spherical harmonics), and the Hydrogen atom radial wavefunctions",
    "Molecular Orbital Theory: Linear Combination of Atomic Orbitals (LCAO-MO), Huckel pi-electron approximations, and correlation diagrams"
  ]
}

^["inorganic_and_coordination_chemistry"]{
  junior_senior_sequence: "Inorganic Chemistry with Inorganic Synthesis Lab."
  theoretical_frameworks: #[
    "Symmetry & Group Theory: Point group classification, character tables, irreducible representations, and symmetry-adapted linear combinations (SALCs)",
    "Ligand Field Theory: Octahedral, tetrahedral, and square planar crystal field splitting (Delta_o, Delta_t), high-spin vs low-spin configurations, and spectrochemical series",
    "Electronic Spectroscopy & Magnetism: Tanabe-Sugano diagrams, Laporte and spin selection rules, Jahn-Teller structural distortions, and Gouy balance magnetic susceptibility",
    "Organometallic Fundamentals: The 18-electron rule, oxidative addition, reductive elimination, migratory insertion, and olefin metathesis"
  ]
}

^["instrumental_analysis_and_structural_elucidation"]{
  senior_capstone_lab: "Instrumental Analysis and Spectroscopy Lab."
  instrumentation_suite: .{
    nuclear_magnetic_resonance: "1D 1H and 13C NMR: chemical shift referencing (TMS), spin-spin coupling constants (J-coupling), integration, and relaxation times (T1, T2)"
    infrared_spectroscopy: "Fourier Transform Infrared (FT-IR): characteristic functional group vibrational stretching and bending modes, ATR sample handling"
    mass_spectrometry: "Gas Chromatography-Mass Spectrometry (GC-MS) and LC-MS: electron ionization (EI) vs electrospray (ESI), mass-to-charge (m/z) fragmentation patterns"
    optical_spectroscopy: "UV-Visible Spectrophotometry (Beer-Lambert law, charge-transfer transitions) and Atomic Absorption Spectroscopy (flame AAS trace metal detection)"
  }[reg=facet]
}

^["laboratory_safety_and_professional_culture"]{
  bench_invariants: #[
    "Chemical Hygiene Plans: Safety Data Sheet (SDS) literacy, secondary containment, and solvent compatibility matrices",
    "Inert Atmosphere Operations: Air-free Schlenk lines, dual manifold vacuum-nitrogen manipulation, and pyrophoric reagent handling (tert-butyllithium)",
    "Hazardous Waste Stewardship: Segregation of halogenated vs non-halogenated organic solvents, heavy metal sequestration, and acid/base neutralization"
  ]
}

^["taste"]{
  ~#taste: "Undergraduate chemistry is the transformation of abstract symbols on a page into the tactile, olfactory, and visual reality of matter."
  ~#wonder: "Why does the subtle geometry of a single asymmetric carbon atom determine whether a molecule is a life-saving medication or a lethal poison?"

  principles: #[
    "Mechanism over memorization: Understanding electron density and orbital overlap renders thousands of seemingly disparate reactions predictable.",
    "Bench humility: The yield in your round-bottom flask does not care about your theoretical elegance; purity must be earned at the rotary evaporator.",
    "Spectroscopic integrity: Never claim a structure until NMR, IR, and mass spectra unanimously confirm the molecular connectivity."
  ]
}

^"invariants"{
  "All student synthetic claims must be confirmed by spectroscopic evidence (NMR, IR, or MS) before credit is granted.",
  "Laboratory courses must mandate appropriate PPE (splash goggles, lab coat, nitrile/neoprene gloves) and fume hood velocity verification.",
  "Undergraduate research experiences require compliance with institutional chemical safety and hazardous waste disposal regulations.",
}

#>wonder_undergrad_chemistry_1
?["How does early undergraduate training in air-free Schlenk line synthesis affect upper-division independent research productivity?"]{
  #:depth #!pedagogical ~#lens(experimental_dexterity)
  ~#hypothesis: "Sophomores who master inert-gas dual-manifold manipulation and syringe transfers produce 3x more publishable organometallic yield during summer research than peers introduced to air-free technique only in senior year."
  !probe{ "Track undergraduate co-authorship rates and bench error incident counts across cohorts completing sophomore vs senior advanced synthesis labs." }
  $%[pedagogy.schlenk_dexterity_score, research.undergrad_publication_rate]
}
