# Formal Semantics, Pragmatics & Discourse Cache
#
# Typed compositional semantics, lambda calculus, Gricean implicature, presupposition, and speech acts.

#>spw_cache_univ_ling_semantics
#:cache #!semantics_pragmatics_and_discourse
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model truth-conditional compositionality, typed lambda calculus, possible-worlds intensionality, Gricean pragmatics, and speech act theory."
  ~#protocol: "cache.layer/1"
}

^"formal_compositional_semantics"{
  "truth_conditional_foundations_and_types": .{
    fregean_compositionality: "The semantic denotation of a complex expression is a mathematical function of the denotations of its immediate constituents and their syntactic mode of combination",
    semantic_type_system: "Atomic types: e (entities in domain D_e) and t (truth values {0, 1} in D_t); complex functional types <sigma, tau> mapping denotations of type sigma to type tau",
    lambda_abstraction_and_application: "Lambda expressions denoting functions (e.g., lambda x [x is mortal]); beta-reduction combining function with argument via Functional Application",
    predicates_and_quantifiers: "Intransitive verbs denoted as <e, t> characteristic functions of sets; Generalized Quantifiers ('every', 'some', 'most') typed as <<e, t>, t> relations over sets",
  }[reg=facet],
  "scope_ambiguities_and_intensional_logic": .{
    quantifier_raising_qr: "Syntactic displacement at Logical Form (LF) resolving scope ambiguity in sentences like 'Every student read a book' (surface scope: forall > exists; inverse scope: exists > forall)",
    possible_worlds_semantics: "Kripkean intensional semantics where propositions denote functions from possible worlds W to truth values <s, t>; propositions true in all accessible worlds are necessary",
    modality_and_accessibility: "Epistemic modality (what is known given evidence) vs Deontic modality (what is permitted/obligated given moral/legal rules); modal bases and ordering sources (Kratzer framework)",
  }[reg=facet],
}

^"pragmatics_and_discourse_dynamics"{
  "gricean_pragmatics_and_implicature": .{
    cooperative_principle: "Make your conversational contribution such as is required, at the stage at which it occurs, by the accepted purpose or direction of the talk exchange",
    conversational_maxims: "Quantity (informative as required), Quality (truthful with evidence), Relation (be relevant), and Manner (perspicuous, unambiguous, brief, orderly)",
    conversational_implicature: "Meaning inferred beyond literal truth-conditions when speakers exploit or flout maxims; marked by cancellability, reinforceability, and calculability",
    scalar_implicatures: "Use of a weaker term on a lexical scale (<some, many, all>) implicates the negation of the stronger term ('I ate some cookies' implicates 'not all cookies')",
  }[reg=facet],
  "presuppositions_and_speech_acts": .{
    presupposition_triggers_and_projection: "Propositions taken for granted as common ground (triggered by factives 'know', aspectuals 'stop', clefts); survive negation and questioning",
    accommodation_mechanisms: "When a speaker introduces a novel presupposition, listeners smoothly adjust their conversational common ground if uncontroversial (Lewis accommodation)",
    speech_act_taxonomy_austin_searle: "Locutionary act (phonetic articulation), Illocutionary force (assertion, question, promise, declaration, directive), Perlocutionary effect (consequential psychological impact on listener)",
    performative_utterances: "Utterances that execute the very act they name ('I hereby declare this session adjourned') governed by felicity conditions rather than truth values",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_univ_ling_semantics_1
  ?["How do human interlocutors decode nuanced conversational implicatures and sarcastic ironies in milliseconds when literal semantics contradicts the intended meaning?"]{
    #:depth #!pragmatic ~#lens(theory_of_mind_bayesian_pragmatics)
    ~#hypothesis: "Human communication relies on recursive Theory of Mind modeled via Rational Speech Act (RSA) Bayesian inference: listeners compute what a cooperative speaker would have said given the speaker's epistemic goals, instantly inverting literal semantic probability to recover unspoken communicative intent."
    !probe{ "Measure N400 and P600 ERP neurophysiological brainwave spikes during processing of scalar implicature cancellations vs semantic anomalies." }
    $%[neurolinguistics.n400_implicature_peak_delay, pragmatics.rsa_bayesian_recovery_accuracy]
  }
}
