# Sociolinguistics & Language Documentation Cache
#
# Labovian variation, AAVE systematicity, comparative method sound laws, and endangered language documentation.

#>spw_cache_univ_ling_socio_field
#:cache #!sociolinguistics_and_language_documentation
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model quantitative sociolinguistic variation, dialect grammar systematicity, historical comparative reconstruction, and endangered language documentation field ethics."
  ~#protocol: "cache.layer/1"
}

^"quantitative_sociolinguistics_and_dialect_grammars"{
  "labovian_variation_and_prestige": .{
    quantitative_sociolinguistics: "William Labov's pioneering methodology: correlating structured linguistic variation (e.g., post-vocalic /r/ in NYC department stores) with social class, age, gender, and speech style",
    overt_vs_covert_prestige: "Overt prestige attaches to standard institutional varieties enforcing social mobility; Covert prestige attaches to non-standard vernaculars indexing local identity, solidarity, and working-class authenticity",
    linguistic_profiling_and_discrimination: "Auditory dialect discrimination in housing, employment, and courtroom testimony (demonstrated by John Baugh); debunking racist 'deficit' myths with descriptive linguistic science",
  }[reg=facet],
  "african_american_english_grammatical_rigor": .{
    systematic_rule_governed_grammar: "African American Language (AAL / AAVE) possesses complex syntactic and aspectual rules absent in Standard American English",
    habitual_be_aspect: "Invariant 'be' marking habitual or recurring aspect ('She be singing' denotes habitual action; 'She singing' denotes present continuous action)",
    copula_absence_regularity: "Zero copula ('He tall') occurs under the exact syntactic conditions where Standard English permits contraction ('He's tall'), governed by rigorous phonological constraints",
    remote_past_bin: "Stressed BIN indicating an action completed long ago or a state continuing indefinitely ('He BIN married')",
  }[reg=facet],
}

^"historical_reconstruction_and_field_documentation"{
  "the_comparative_method_and_sound_laws": .{
    neogrammarian_sound_change_hypothesis: "Regular sound change operates blindly without exception (Ausnahmslosigkeit der Lautgesetze); conditioned phonological sound laws explain seeming irregularities (e.g., Verner's Law qualifying Grimm's Law)",
    proto_language_reconstruction: "Reconstructing ancestral phonemic inventories and morphological paradigms (Proto-Indo-European, Proto-Austronesian) through systematic cognate comparison",
    greenbergian_typological_universals: "Cross-linguistic implicational universals: correlations between basic word order (SOV vs SVO) and adposition type (postpositions vs prepositions) and relative clause positioning",
  }[reg=facet],
  "endangered_language_documentation_and_revitalization": .{
    the_biodiversity_of_the_mind: "Documenting endangered indigenous languages facing extinction due to colonial assimilation; preserving unique cognitive taxonomies and botanical knowledge",
    open_access_ethical_archives: "Curating audio, video, and annotated time-aligned corpora (ELAN, FLEx) in digital preservation repositories (ELAR, PARADISEC) with strict community access protocols",
    community_sovereignty_and_immersion: "Indigenous linguistic self-determination: Hawaiian Punana Leo and Maori Kohanga Reo language nest immersion models reviving intergenerational mother-tongue transmission",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_univ_ling_socio_field_1
  ?["How does an endangered language's unique grammatical encoding of evidentiality or spatial geometry reveal cognitive categories invisible to speakers of Standard English?"]{
    #:depth #!anthropological ~#lens(linguistic_relativity_and_epistemic_marking)
    ~#hypothesis: "Languages with obligate evidential marking (such as Tuyuca or Matses, which require verbs to encode whether information was directly seen, heard, inferred from evidence, or reported) compel speakers to permanently maintain high-precision cognitive tracking of epistemic source data, shaping how reality is recalled and evaluated."
    !probe{ "Conduct eye-tracking and witness recall accuracy experiments comparing speakers of obligate evidential languages with speakers of languages lacking grammatical evidentials." }
    $%[cognition.epistemic_source_accuracy, anthropology.grammatical_evidential_density]
  }
}
