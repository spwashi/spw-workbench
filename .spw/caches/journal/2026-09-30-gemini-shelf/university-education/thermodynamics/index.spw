# Thermodynamics Curricular Hub
#
# Root cache index for undergraduate and graduate thermodynamics across classical, statistical, non-equilibrium, and information domains.

#>spw_cache_univ_thermo_index
#:cache #!thermodynamics
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the complete pedagogical and theoretical continuum of thermodynamics: from macroscopic power cycles and exergy balances to statistical ensembles, non-equilibrium dissipative structures, and Landauer computational limits."
  ~#cross_cutting: "Physics, Mechanical Engineering, Chemical Engineering, Materials Science, Biophysics, and Information Theory"
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @classical: ~"./classical-and-engineering-thermodynamics.spw"
  @statistical: ~"./statistical-and-molecular-thermodynamics.spw"
  @nonequilibrium: ~"./non-equilibrium-and-information-thermodynamics.spw"
  @taste: ~"./taste.spw"
}

^"dispatch"{
  classical_and_engineering: @classical
  statistical_and_molecular: @statistical
  nonequilibrium_and_information: @nonequilibrium
  taste_considerations: @taste
}

^"taste"{
  ~#taste: "Thermodynamics is the supreme arbiter of physical possibility: empires and atoms alike must balance their books with entropy."
  ~#wonder: "Why does the Second Law of Thermodynamics create an irreversible arrow of time in a macroscopic universe whose microscopic quantum and gravitational laws are entirely time-reversible?"
}

^"invariants"{
  "All thermodynamic formulations strictly enforce the First Law (energy conservation) and Second Law (non-negative universe entropy generation).",
  "Equilibrium states must correspond to extremized thermodynamic potentials under specified boundary constraints.",
  "Calculations of available work (exergy) must declare the dead-state reference temperature, pressure, and chemical composition.",
}

#>wonder_thermo_index_1
?["How does the early pedagogical introduction of exergy analysis reshape student intuition regarding thermal waste?"]{
  #:depth #!pedagogical ~#lens(exergy_intuition)
  ~#hypothesis: "Engineering students who analyze power plants using Second-Law exergy destruction rather than First-Law energy efficiency alone identify 50% more actionable waste-heat recovery opportunities by recognizing temperature degradation."
  !probe{ "Compare cycle optimization designs between student cohorts trained in First-Law enthalpy balance vs Second-Law exergy destruction." }
  $%[pedagogy.exergy_comprehension_score, engineering.heat_recovery_optimization_rate]
}
