# Molecular & Cellular Biology Taste & Wonder Cache
#
# Brownian nanotechnology, the unbroken 4-billion-year ribosomal thread, and cellular reverence.

#>spw_cache_univ_mcb_taste
#:cache #!molecular_and_cellular_biology_taste
#:layer #!pragmatics

^"intent"{
  ~#goal: "Articulate the aesthetic awe, molecular reverence, and philosophical wonder demanded by the nanoscale machinery of the living cell."
  ~#protocol: "cache.layer/1"
}

^"taste_principles"{
  "the_masterpiece_of_brownian_nanotechnology": .{
    order_from_thermal_storm: "A cell is not a clockwork machine of rigid gears; it is an aqueous whirlwind where proteins collide billions of times per second in violent thermal Brownian agitation, harnessing chaotic kinetic energy through molecular shape complementarity into self-assembling order",
    the_miracle_of_the_kinesin_step: "Watching a single kinesin motor protein take eight-nanometer mechanical steps along a microtubule track, burning one ATP molecule per stride to haul a secretory vesicle a thousand times its own mass",
  }[reg=facet],
  "the_unbroken_four_billion_year_thread": .{
    the_sacred_ribosomal_peptidyl_transferase: "At the catalytic heart of the 50S large ribosomal subunit sits no protein, but an RNA ribozyme whose tertiary fold is identical across every living bacterium, redwood tree, and human poet—an unbroken physical molecular chain connecting our lungs to the primordial soup",
    the_thirty_seven_trillion_cell_republic: "Every human body is a cooperative civilization of 37 trillion individual cells, each executing automated apoptosis when damaged for the preservation of the greater whole",
  }[reg=facet],
  "epistemic_humility_at_the_nanoscale": .{
    the_limits_of_cartesian_diagrams: "Flat textbook pathway arrows deceive us into imagining static linear circuits; in truth, cellular biology is a dynamic sea of liquid-liquid phase-separated membraneless condensates and transient quantum electronic rearrangements",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_univ_mcb_taste_1
  ?["Why is the catalytic peptidyl transferase center of the ribosome made entirely of RNA rather than catalytic protein amino acids?"]{
    #:depth #!evolutionary ~#lens(rna_world_living_fossil)
    ~#hypothesis: "The ribosome is a living molecular fossil from the primordial 'RNA World' that preceded protein enzymes and DNA. Proteins evolved later as structural scaffolding around the ancestral catalytic ribozyme core, which was already so chemically perfected that natural selection could never replace it without catastrophically halting all protein synthesis on Earth."
    !probe{ "Analyze high-resolution 1.5-angstrom cryo-EM electron density maps of the bacterial vs eukaryotic peptidyl transferase center to confirm total absence of amino acid side chains within 18 angstroms of the catalytic site." }
    $%[structural_biology.catalytic_site_protein_free_radius_angstroms, evolution.ribosomal_rna_sequence_conservation]
  }

  #>wonder_univ_mcb_taste_2
  ?["How do membraneless organelles (such as nucleoli and P-granules) maintain sharp biochemical boundaries inside the cytoplasm without a lipid bilayer?"]{
    #:depth #!biophysical ~#lens(liquid_liquid_phase_separation)
    ~#hypothesis: "Membraneless organelles condense via liquid-liquid phase separation (LLPS) driven by multivalent weak interactions between intrinsically disordered protein regions (IDRs) and RNA molecules. Above a critical saturation concentration, these macromolecules spontaneously demix like oil droplets in water, concentrating specific biochemical reaction cascades while excluding surrounding cytoplasmic enzymes."
    !probe{ "Measure optical FRAP fluorescence recovery rates and droplet fusion surface tension in purified FUS and TDP-43 protein condensates in vitro." }
    $%[biophysics.condensate_surface_tension_n_m, phase_separation.frap_diffusion_coefficient]
  }
}
