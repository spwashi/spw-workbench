# Information Policy, Intellectual Freedom & Literacy Cache
#
# ALA Library Bill of Rights, digital license erosion, Fair Use, Open Access (Plan S), and ACRL threshold concepts.

#>spw_cache_univ_lis_policy
#:cache #!information_policy_intellectual_freedom_and_literacy
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model library information policy, ALA intellectual freedom defenses, patron privacy ethics, copyright Fair Use and digital licensing erosion, and ACRL information literacy frameworks."
  ~#protocol: "cache.layer/1"
}

^"intellectual_freedom_privacy_and_censorship_defenses"{
  "ala_library_bill_of_rights_and_patron_confidentiality": .{
    ala_first_amendment_tenets: "Books and library resources should be provided for the interest and enlightenment of all people; libraries must challenge censorship in the fulfillment of their responsibility to provide information and enlightenment",
    patron_circulation_privacy: "Strict confidentiality of patron borrowing records, search logs, and reading histories; refusing warrantless state surveillance inquiries (e.g., resisting USA PATRIOT Act national security letters without judicial warrant)",
    materials_reconsideration_and_book_bans: "Rigorous collection development policies requiring formal reconsideration committee reviews to protect LGBTQ+ and racial minority literature against politically coordinated censorship challenges",
  }[reg=facet],
  "the_digital_divide_and_civic_infrastructure": .{
    universal_access_mission: "Bridging structural socio-economic digital divides by providing free public computer terminals, broadband internet access, digital literacy coaching, and community civic shelter",
  }[reg=facet],
}

^"copyright_open_access_and_information_literacy"{
  "copyright_fair_use_and_ebook_licensing_crises": .{
    four_factor_fair_use_analysis: "17 U.S.C. 107: 1) Purpose and character of use (transformative vs commercial), 2) Nature of copyrighted work, 3) Amount and substantiality of portion taken, 4) Effect of use on market value",
    erosion_of_the_first_sale_doctrine: "Section 109 First Sale permitting lending of physical books does not legally apply to digital downloads; libraries forced into extractive publisher licensing contracts (e.g., 24-month expirations, 26-checkout caps, 4x retail price markups)",
    open_access_and_plan_s: "Battling commercial publisher subscription paywalls (Elsevier, Springer Nature); Gold OA (author-paid APCs), Green OA (institutional repository self-archiving), and Diamond OA (community-funded scholar-led publishing)",
  }[reg=facet],
  "acrl_information_literacy_framework": .{
    six_core_threshold_concepts: "1) Authority Is Constructed and Contextual, 2) Information Creation as a Process, 3) Information Has Value, 4) Research as Inquiry, 5) Scholarship as Conversation, 6) Searching as Strategic Exploration",
    algorithmic_misinformation_and_lateral_reading: "Wineburg lateral reading heuristic: leaving the source page immediately to evaluate credibility across independent tabs rather than trusting internal visual polished markers",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_univ_lis_policy_1
  ?["Why do public libraries remain the only remaining secular, non-commercial indoor public spaces in modern cities where a citizen can exist for hours without spending money?"]{
    #:depth #!sociological ~#lens(the_erasure_of_the_civic_commons)
    ~#hypothesis: "Modern urban neoliberal architecture has privatized and commodified almost all third places (malls, cafes, plazas). The public library survives as an intentional, democratic sanctuary of unmonetized civic commons—a radical space where human presence is validated by citizenship and curiosity alone, rather than consumer solvency."
    !probe{ "Map municipal third-place accessibility and patron demographic diversity across public library branches vs commercial urban commercial zones." }
    $%[sociology.unmonetized_civic_space_ratio, urbanism.library_social_safety_net_utilization]
  }
}
