# University Institutional Infrastructure & Operational Backbone
#
# Systems analysis of the registrar, bursar, financial aid, residential colleges, and research libraries.

#>spw_cache_univ_infrastructure
#:cache #!university
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the operational administrative infrastructure that enables a university to function as a self-contained civic ecosystem."
  ~#legal_standards: "FERPA (Family Educational Rights and Privacy Act), Title IV Higher Education Act, Clery Act"
}

^["the_registrar_and_academic_records"]{
  mandate: "Official guardian of academic integrity, course catalogs, permanent student transcripts, and degree certification."
  functions: #[
    "Course scheduling & classroom space optimization algorithms",
    "Enrollment caps, waitlists, and prerequisite enforcement engines",
    "FERPA privacy firewalls governing disclosure of educational records",
    "Degree progress audits verifying major and general education completion"
  ]
}

^["bursar_and_financial_aid"]{
  title_iv_aid: "Pell Grants, Direct Subsidized/Unsubsidized Loans, Federal Work-Study (FWS)"
  institutional_aid: "Need-blind admissions with need-based endowment grants vs merit-based recruitment discounts"
  tuition_mechanics: "Tuition billing, student health insurance fees, housing charges, payment plan amortization"
}

^["student_affairs_and_residential_life"]{
  residential_colleges: .{
    model: "Oxford/Cambridge collegiate model adapted in U.S. (Harvard, Yale, Princeton, Rice)"
    structure: "Students live, dine, and socialize in cohesive residential houses led by faculty heads and resident deans"
    benefit: "Fosters interdisciplinary cross-pollination and social belonging within a massive university"
  }[reg=facet]

  campus_services: #[
    "Student Health & Psychological Services (counseling, psychiatric care, crisis response)",
    "Career Services & Alumni Mentorship Networks",
    "Office of Student Conduct & Conflict Resolution (honor codes, academic integrity hearings)"
  ]
}

^["libraries_and_scholarly_archives"]{
  role: "The physical and digital intellectual repository of human knowledge."
  holdings: "Millions of physical volumes, rare manuscripts, special collections, digital database subscriptions"
  interlibrary_loan: "Global ILL lending networks ensuring any scholar can access any text on Earth within days"
}

^["taste"]{
  ~#taste: "Infrastructure is silent when it functions flawlessly; it provides the quiet ground upon which genius can walk."
  ~#wonder: "Why does walking into a university library reading room immediately induce a reverent, contemplative hush?"

  principles: #[
    "Student dignity in financial aid: Applying for need-based support should never feel humiliating or punitive.",
    "Data stewardship: Student transcripts are sacred historical records that must endure across centuries.",
    "Physical place matters: The beauty of stone courtyards, ancient trees, and wood-paneled libraries elevates the human spirit."
  ]
}

^["invariants"]{
  "Student educational records are shielded under federal FERPA privacy regulations.",
  "Financial aid packaging adheres to federal EFC / SAI methodology formulas.",
  "Degree conferral requires unencumbered clearance from registrar, bursar, and academic departments.",
}

#>wonder_univ_infrastructure_1
?["How does the residential college model buffer students against modern isolation?"]{
  #:depth #!philosophical ~#lens(communal_architecture)
  ~#hypothesis: "Living and dining with the same multi-class, multi-major cohort for four years creates dense social fabric that withstands academic burnout."
  !probe{ "Compare longitudinal loneliness scores and graduation rates of students in residential colleges vs scattered commuter apartments." }
  $%[retention.graduation_rate_delta, student.social_connectedness_score]
}
