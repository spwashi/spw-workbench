# Undergraduate Industrial Design Curricular Architecture
#
# Bachelor of Science (B.S.) / Bachelor of Industrial Design (B.I.D.): user research, physical form-giving, Class-A NURBS CAD, and ergonomics.

#>spw_cache_univ_undergrad_id
#:cache #!industrial_design
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the four-year undergraduate curriculum for a Bachelor of Industrial Design, articulating ethnographic user discovery, tactile foam prototyping, Class-A surface modeling, anthropometrics, and CMF manufacturing."
  ~#accreditation: "NASAD and Industrial Designers Society of America (IDSA) Academic Standards"
}

^["design_thinking_and_ethnographic_discovery"]{
  freshman_sophomore_gateway: "Design Methods and User Empathy Studio."
  research_methodologies: #[
    "Contextual Inquiry: Shadowing users in natural domestic and industrial environments, documenting unstated workarounds and micro-frustrations",
    "User Journey Mapping: Identifying emotional highs, friction troughs, and inflection points across product lifecycle touchpoints",
    "Problem Reframing: Moving from client feature mandates to root human needs using generative 'How Might We' design prompts",
    "Participatory Co-Design: Facilitating co-creation workshops with extreme users (elderly, disabled, domain experts) to uncover hidden constraints"
  ]
}

^["rapid_ideation_sketching_and_tactile_prototyping"]{
  sophomore_core: "Visual Ideation and Shop Craft Studio."
  tactile_disciplines: .{
    sketching_for_ideation: #[
      "Perspective Line Craft: Dynamic 3-point perspective lay-ins, ellipse accuracy on tilted planes, and communicative line weight hierarchy",
      "Marker & Digital Rendering: Alcohol marker value gradations, soft core shadows, white pastel highlights, and explosive isometric callouts"
    ]
    physical_foam_and_clay_shop: #[
      "High-Density Urethane Foam: Rapid rough-cut band sawing, rasp shaping, and fine sanding validating volumetric mass in the physical hand",
      "Automotive Styling Clay: Heated clay lay-on, steel scraper surfacing, and highlight tape sweeps defining flowing aerodynamic character lines",
      "Functional Proof-of-Concept Rigs: Cardboard, acrylic laser cutting, and modular aluminum extrusion mockups validating mechanical kinematics"
    ]
  }[reg=facet]
}

^["digital_cad_surfacing_and_visualization"]{
  junior_core: "Advanced Computer-Aided Industrial Design (CAID)."
  digital_craft: .{
    nurbs_surface_geometry: #[
      "Class-A Surface Continuity: G0 (positional touch), G1 (tangency), G2 (curvature continuity), and G3 (torsion rate continuity) across blends",
      "Surface Quality Diagnostics: Zebra stripe reflection mapping, Gaussian curvature analysis, and draft angle verification for tooling",
      "Solid Feature Integration: SolidWorks/PTC Creo parametric boss design, rib reinforcement, snap fits, and uniform wall thickness shelling"
    ]
    photorealistic_rendering: "KeyShot/Blender physically based rendering (PBR), measured material BRDFs, anisotropic brushed metals, and exploded CMF product animations"
  }[reg=facet]
}

^["human_factors_anthropometrics_and_ergonomics"]{
  junior_senior_core: "Ergonomics and Usability Engineering."
  ergonomic_principles: #[
    "Anthropometric Percentiles: Designing for the 5th percentile female through 95th percentile male body dimensions, reach envelopes, and clearance",
    "Biomechanics of Grasp: Power grip vs precision pinch load distributions; minimizing carpal tunnel pressure and ulnar deviation in manual hand tools",
    "Cognitive Ergonomics & Affordances: Don Norman principles (natural mapping, signifiers, physical constraints, and instant tactile feedback)",
    "Universal & Inclusive Design: ADA compliance, one-handed operation capability, high-contrast visual cues, and tactile braille/groove navigation"
  ]
}

^["materials_manufacturing_and_cmf_specification"]{
  senior_core: "Design for Manufacturing (DFM) and Product Commercialization."
  manufacturing_suite: #[
    "Polymer Tooling: Injection molding parting line placement, core and cavity tooling, side actions, lifters, and gate/ejector pin mark concealment",
    "Metal Forming: Sheet metal stamping, progressive dies, aluminum extrusion profiles, and high-pressure die casting",
    "Color, Material, Finish (CMF): Specifying Pantone matching, mold surface texturing (Mold-Tech/VDI EDM), anodizing, PVD coatings, and soft-touch paints",
    "Circular Design: Design for Disassembly (DFD), snap-together modularity avoiding glues, and post-consumer recycled (PCR) resin selection"
  ]
}

^["taste"]{
  ~#taste: "Industrial design is the physical embrace of human life: an everyday object should feel like an extension of your own hand and bring quiet joy to the eye."
  ~#wonder: "Why does running your fingers over a G2 curvature continuous fillet feel sensual and calm, while a G1 tangent fillet feels abrupt and mechanical?"

  principles: #[
    "Simplicity is hard work: Removing a part while preserving its function requires far more design genius than adding three extra features.",
    "Form follows empathy: An object must never be sculpted solely to look striking in a studio photograph; it must serve the living human who holds it.",
    "Honesty of materials: Let wood feel warm and fibrous, let aluminum feel cool and precise, and never disguise cheap plastic as marble."
  ]
}

^"invariants"{
  "All injection-molded part designs must incorporate minimum draft angles (1-2 degrees per side) and uniform wall thickness to prevent sink marks.",
  "Physical ergonomic handles must be evaluated through blind user testing with both small and large hand anthropometric demographics.",
  "CMF callout documentation must declare exact color standards (Pantone/RAL), surface texture codes, and material flammability ratings (UL 94).",
}

#>wonder_undergrad_id_1
?["How does the subtle introduction of asymmetrical finger indexing grooves on surgical handles affect laparoscopic surgeon hand fatigue?"]{
  #:depth #!ergonomic ~#lens(surgical_haptics)
  ~#hypothesis: "Sculpting asymmetrical index-finger resting facets tailored to hand pronation angles reduces surgeon thenar muscle fatigue by 28% and improves tip placement precision during 4-hour simulated operations compared to standard symmetrical cylindrical handles."
  !probe{ "Track surgeon electromyography fatigue slopes and tremor amplitude during prolonged suturing tasks using symmetrical vs organically contoured ergonomic handles." }
  $%[ergonomics.thenar_muscle_fatigue_index, precision.tip_tremor_micrometers]
}
