# Undergraduate Physics Curricular Architecture
#
# Standard four-year Bachelor of Science (B.S.) in Physics: analytical mechanics, electrodynamics, quantum mechanics, and statistical physics.

#>spw_cache_univ_undergrad_physics
#:cache #!physics
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the four-year undergraduate curriculum for a Bachelor of Science in Physics, articulating theoretical mechanics, Maxwellian field theory, Hilbert space quantum mechanics, and statistical ensembles."
  ~#foundations: "AIP Curricular Framework and Core Theoretical Physics Canon"
}

^["classical_mechanics_and_analytical_dynamics"]{
  sophomore_junior_core: "Intermediate and Advanced Classical Mechanics."
  theoretical_foundations: #[
    "Variational Principles: Principle of least action (Hamilton's principle), Euler-Lagrange equations of motion, and generalized coordinates",
    "Symmetries & Invariants: Noether's theorem relating spatial translation to linear momentum, rotational invariance to angular momentum, and time translation to energy",
    "Central Force Dynamics: Two-body problem reduction, effective potential, Keplerian orbital mechanics, and Rutherford scattering cross-sections",
    "Oscillations & Normal Modes: Coupled harmonic oscillators, secular determinants, eigenvalue analysis, and driven damped resonance",
    "Rigid Body Mechanics: Inertia tensor, principal axes of inertia, Euler's equations of motion, and torque-free precession"
  ]
}

^["electricity_and_magnetism_field_theory"]{
  junior_core: "Electrodynamics sequence (Griffiths level)."
  field_formalisms: .{
    electrostatics_and_magnetostatics: #[
      "Coulomb and Gauss laws, electric scalar potential, and Poisson/Laplace boundary value problems",
      "Method of images, separation of variables in spherical coordinates, and Legendre multipole expansions",
      "Dielectrics: Bound charges, polarization vector P, electric displacement field D, and linear dielectrics",
      "Lorentz force law, Biot-Savart law, Ampere's circuital law, and magnetic vector potential A",
      "Magnetic materials: Bound currents, magnetization M, magnetic field H, diamagnetism, and ferromagnetism"
    ]
    electrodynamics_and_waves: #[
      "Faraday's law of induction, Maxwell's displacement current, and complete Maxwell's equations in vacuum and matter",
      "Poynting's theorem, electromagnetic energy density, and radiation pressure",
      "Electromagnetic wave propagation in vacuum, linear dielectrics, and conductors; skin depth and Brewster's angle",
      "Gauge invariance: Coulomb gauge vs Lorenz gauge, scalar and vector potentials, and retarded potentials"
    ]
  }[reg=facet]
}

^["quantum_mechanics_and_atomic_physics"]{
  junior_senior_core: "Quantum Mechanics I & II."
  quantum_formalisms: #[
    "Postulates & State Space: Wavefunctions, Dirac bra-ket notation, Hermitian observable operators, and Copenhagen measurement collapse",
    "Operator Algebra: Commutation relations, generalized uncertainty principle, and time-evolution unitary operator",
    "Exact One-Dimensional Solutions: Infinite and finite square wells, delta-function potentials, and quantum tunneling through barriers",
    "Quantum Harmonic Oscillator: Operator ladder method (creation and annihilation operators a, a-dagger) and Hermite polynomial eigenfunctions",
    "Central Potentials & Hydrogen Atom: Separation of variables, orbital angular momentum algebra (L^2, Lz), spherical harmonics, and Coulomb radial wavefunctions",
    "Spin & Addition of Angular Momenta: Pauli spin matrices, electron spin-1/2, Clebsch-Gordan coefficients, and singlet/triplet states",
    "Approximation Methods: Non-degenerate and degenerate time-independent perturbation theory (Stark effect, relativistic fine structure), and variational principle"
  ]
}

^["thermal_and_statistical_physics"]{
  junior_senior_core: "Thermodynamics and Statistical Mechanics."
  ensemble_paradigms: .{
    macroscopic_thermodynamics: "First, Second, and Third Laws, thermodynamic potentials (Internal energy U, Enthalpy H, Helmholtz F, Gibbs G), and Maxwell relations"
    microcanonical_ensemble: "Isolated systems, microstates, density of states, and Boltzmann's entropy definition (S = k_B * ln Omega)"
    canonical_ensemble: "Thermal reservoirs, Boltzmann factor, canonical partition function Z, free energy, and internal energy fluctuations"
    grand_canonical_ensemble: "Open systems, chemical potential mu, absolute activity, and grand canonical partition function"
    quantum_statistics: #[
      "Maxwell-Boltzmann classical limit and the Gibbs paradox resolution",
      "Fermi-Dirac statistics: Pauli exclusion, Fermi energy, degenerate electron gas, and white dwarf stability limits",
      "Bose-Einstein statistics: Photons (Planck blackbody distribution), phonons (Debye heat capacity model), and Bose-Einstein condensation"
    ]
  }[reg=facet]
}

^["advanced_experimental_physics_laboratory"]{
  senior_capstone_lab: "Advanced Laboratory and Experimental Instrumentation."
  experiments: #[
    "Optical Metrology: Michelson and Fabry-Perot interferometers measuring laser wavelengths and gas refractive indices",
    "Fundamental Constants: Photoelectric effect determination of Planck's constant (h) and Millikan oil-drop charge quantization (e)",
    "Quantum & Nuclear Phenomena: Franck-Hertz atomic excitation, Compton scattering, and muon lifetime measurement with plastic scintillators",
    "Precision Electronics: Lock-in amplifiers for phase-sensitive weak signal detection, Johnson-Nyquist noise measurement, and digital signal processing"
  ]
}

^["taste"]{
  ~#taste: "Undergraduate physics is the supreme training in intellectual fearlessness: stripping away descriptive clutter until the fundamental differential law reveals itself."
  ~#wonder: "Why does the mathematical structure of complex vector spaces (Hilbert space) invented by mathematicians for abstract geometry perfectly predict the spectral lines of the stars?"

  principles: #[
    "Asymptotic limits: Always test a theoretical result at zero, infinity, and classical limits (h-bar -> 0, c -> infinity).",
    "Dimensional analysis: If the physical dimensions on both sides of an equal sign do not match, the physics is false regardless of effort.",
    "Physical intuition: A calculation is only half-done until you can explain the physical mechanism qualitatively without writing an equation."
  ]
}

^"invariants"{
  "Physics problem formulations must declare reference frames, coordinate systems, and boundary conditions explicitly.",
  "Experimental measurements must report confidence intervals, systematic uncertainties, and random error distributions.",
  "Quantum state evolutions must maintain probability normalization across all unitary transformations.",
}

#>wonder_undergrad_physics_1
?["How does the early pedagogical introduction of Python numerical phase-space visualization affect student comprehension of nonlinear orbital resonances?"]{
  #:depth #!pedagogical ~#lens(computational_phase_space)
  ~#hypothesis: "Undergraduates who numerically simulate Poincaré surface-of-section plots alongside analytical perturbation theory develop a 45% deeper grasp of chaotic transitions than students solving textbook integrable central-force orbits alone."
  !probe{ "Assess student identification of KAM stability islands and chaotic seas across computational vs purely analytical mechanics classes." }
  $%[pedagogy.phase_space_mastery_index, mechanics.chaos_threshold_accuracy]
}
