# Physics & Mechanical Engineering Curricular Hub
#
# Root cache index for undergraduate and master's degree programs in fundamental physics and mechanical engineering.

#>spw_cache_univ_physics_meche_index
#:cache #!physics_and_mechanical_engineering
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the full pedagogical and physical continuum from fundamental quantum fields, Lagrangian mechanics, and statistical physics to fluid machinery, continuum mechanics, and dynamic robotic control."
  ~#accreditation: "AIP (American Institute of Physics) Curricular Guidelines, ABET Engineering Accreditation Commission"
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @undergrad_physics: ~"./undergrad-physics.spw"
  @masters_physics: ~"./masters-physics.spw"
  @undergrad_meche: ~"./undergrad-mechanical-engineering.spw"
  @masters_meche: ~"./masters-mechanical-engineering.spw"
  @taste: ~"./taste.spw"
}

^"dispatch"{
  undergrad_physics: @undergrad_physics
  masters_physics: @masters_physics
  undergrad_mechanical_engineering: @undergrad_meche
  masters_mechanical_engineering: @masters_meche
  taste_considerations: @taste
}

^"taste"{
  ~#taste: "Physics discovers the immutable symmetries of the cosmos; mechanical engineering gives those symmetries physical bodies to move the world."
  ~#wonder: "How does the principle of least action (delta S = 0) simultaneously dictate the path of a photon bending around a black hole and the optimal trajectory of a robotic manipulator?"
}

^"invariants"{
  "Physics curricula strictly maintain the mathematical progression from vector calculus through differential geometry and Hilbert space operator algebra.",
  "Mechanical engineering balances analytical mechanics with numerical simulation (FEA, CFD) and physical prototype manufacturing.",
  "Experimental and design courses require rigorous treatment of measurement uncertainty, propagation of error, and engineering safety margins.",
}

#>wonder_physics_meche_index_1
?["How does the unified teaching of Lagrangian mechanics across sophomore physics and mechanical engineering affect cross-disciplinary problem solving?"]{
  #:depth #!pedagogical ~#lens(cross_disciplinary_transfer)
  ~#hypothesis: "Students who learn analytical mechanics through generalized coordinates and Euler-Lagrange equations rather than purely Newtonian vector force balancing solve complex multi-body coupled vibration problems with 60% fewer algebraic errors."
  !probe{ "Administer identical coupled double-pendulum and non-inertial frame exams to sophomore cohorts trained in Lagrangian vs Newtonian methods." }
  $%[pedagogy.lagrangian_formulation_accuracy, problem_solving.conceptual_transfer_score]
}
