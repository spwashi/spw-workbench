# Illustration & Animation Curricular Hub
#
# Root cache index for undergraduate (B.F.A.) and master's (M.F.A.) programs in narrative illustration, visual development, and 2D/3D animation.

#>spw_cache_univ_illus_anim_index
#:cache #!illustration_and_animation
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the full creative and technical continuum from foundational figure drawing, pictorial composition, and concept art to the twelve principles of animation, 3D character rigging, and auteur cinematic direction."
  ~#accreditation: "National Association of Schools of Art and Design (NASAD) Standards for BFA and MFA in Animation and Illustration"
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @undergrad_illustration: ~"./undergrad-illustration-and-visual-storytelling.spw"
  @undergrad_animation: ~"./undergrad-animation-principles-and-craft.spw"
  @masters_visual_direction: ~"./masters-animation-and-visual-direction.spw"
  @taste: ~"./taste.spw"
}

^"dispatch"{
  undergrad_illustration: @undergrad_illustration
  undergrad_animation: @undergrad_animation
  masters_visual_direction: @masters_visual_direction
  taste_considerations: @taste
}

^"taste"{
  ~#taste: "To animate is to breathe a living soul (anima) into lines of graphite or polygons of light."
  ~#wonder: "Why does an audience weep when a circle of digital pixels representing an animated wooden puppet sheds a tear?"
}

^"invariants"{
  "All student illustration and animation work must be rooted in rigorous observational anatomy and dynamic gestural drawing.",
  "Animation timing and spacing must respect weight, mass, and the physical laws of inertia even when exaggerated for comedic effect.",
  "Master's thesis productions require complete creative authorship from concept and storyboard to final composite and sound design.",
}

#>wonder_illus_anim_index_1
?["How does the early mastery of traditional 2D hand-drawn animation principles alter a 3D animator's curve editing in the graph editor?"]{
  #:depth #!pedagogical ~#lens(haptic_timing_transfer)
  ~#hypothesis: "Animators who animate on physical paper with pegs and lightboxes internalize spacing arcs and anticipation so deeply that they craft believable 3D character performances in Maya in 40% fewer graph editor spline keyframe passes."
  !probe{ "Compare keyframe density, curve cleanup iterations, and blind industry jury performance ratings of 3D dialogue scenes across animators with vs without 2D paper foundations." }
  $%[pedagogy.character_believability_rating, animation.graph_editor_keyframe_efficiency]
}
