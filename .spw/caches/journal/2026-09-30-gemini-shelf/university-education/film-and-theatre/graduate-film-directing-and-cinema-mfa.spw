# Graduate Master's Film Directing (M.F.A.) Curricular Architecture
#
# Terminal Master of Fine Arts (M.F.A.) in Film Directing: auteur visual strategy, professional actor collaboration, Dolby Atmos sound architecture, and thesis film.

#>spw_cache_univ_grad_film_mfa
#:cache #!film_studies
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the terminal Master of Fine Arts (M.F.A.) curriculum in Film Directing, articulating auteur visual strategies, professional casting, advanced cinematic grammar, and festival thesis short film production."
  ~#degree_culmination: "Narrative Short Film (15-25 minutes), 4K DCI DCP Master, and Public Festival Screening"
}

^["auteur_visual_strategy_and_cinematic_voice"]{
  graduate_depth: "Developing comprehensive, unmistakable visual design philosophies for narrative cinema."
  visual_architectures: #[
    "The Director's Lookbook: Formulating visual rules (color palettes, aspect ratios, lighting textures, and lens choices) reflecting character trauma and transformation",
    "Lens Philosophy: Choosing between vintage anamorphic glass (character distortion, horizontal flares) vs modern telecentric large-format primes to anchor narrative mood",
    "Motivated Camera Motility: Designing complex long-take 'oners' and Steadicam blocking that choreograph actors and cameras through multi-room spatial environments"
  ]
}

^["advanced_collaboration_with_professional_actors"]{
  directing_mastery: "Navigating the sacred psychological space of on-camera performance."
  actor_collaboration: .{
    casting_and_callbacks: "Casting as 80% of directing: audition chemistry reads, assessing coachability, and discovering unexpected authentic character truth"
    rehearsal_and_set_etiquette: #[
      "Rehearsing subtext and character history without locking in mechanical line inflections before the camera rolls",
      "Maintaining emotional safety and focus in the high-pressure environment of working film sets",
      "Collaborating seamlessly with intimacy coordinators and stunt coordinators to protect actor physical and emotional boundaries"
    ]
  }[reg=facet]
}

^["collaborative_cinematography_and_spatial_lighting"]{
  director_dp_dynamic: "Partnering with the Director of Photography to sculpt narrative mood."
  visual_mechanics: #[
    "Blocking the Scene for the Cut: Composing three-dimensional blocking where actors move through distinct pools of light and shadow, motivating camera pans and coverage",
    "Managing Depth of Field: Using razor-thin depth-of-field on Large Format sensors to isolate character isolation, and deep-focus staging to reveal environmental traps"
  ]
}

^["sound_design_as_narrative_architecture"]{
  auditory_cinema: "Sound as the direct path to the subconscious mind of the audience."
  sound_craft: .{
    subjective_sonic_pov: "Shifting the entire sound mix from objective reality to subjective internal acoustics (tinnitus, heartbeat, muffled underwater audio) reflecting character distress",
    spatial_surround_mastering: "Dolby Atmos bed and object-based spatial mixing positioning environmental room tones and off-screen sound threats dynamically"
  }[reg=facet]
}

^["mfa_thesis_film_production_and_festival_strategy"]{
  terminal_milestone: "Producing and launching a career-defining festival narrative short film."
  thesis_milestones: #[
    "Production Leadership: Managing SAG-AFTRA Short Project Agreements, location permits, production insurance, and professional department heads",
    "Post-Production Finishing: Supervising picture editorial, orchestral scoring, Foley recording, color grading in ACES, and mastering to 4K DCI compliant DCP packages",
    "Festival Distribution: Submitting to tier-one global festivals (Sundance, Cannes, Venice, Telluride, TIFF, Clermont-Ferrand) to secure literary and talent agency representation"
  ]
}

^["taste"]{
  ~#taste: "Master's-level film directing is the courage of omission: knowing that what you choose to leave off-screen in the shadows is far more terrifying and beautiful than what you illuminate."
  ~#wonder: "Why does lingering on an actor's face for four extra seconds after they stop speaking reveal the deepest truth of who they really are?"

  principles: #[
    "Camera movement is an ethical choice: A camera push-in is not a decorative trick; it is an intimate violation of personal space that must be earned by story emotion.",
    "Rhythm is musical: A great film scene has tempo, syncopation, and sudden acoustic rests just like a piece of classical chamber music.",
    "Authenticity over perfection: A technically flawed take where an actor experiences a real moment of human heartbreak will always beat a technically perfect dead take."
  ]
}

^"invariants"{
  "M.F.A. thesis films must operate under verified SAG-AFTRA union agreements and comprehensive general liability insurance.",
  "Production sets must enforce mandatory 12-hour turnaround times for all cast and crew members.",
  "Directorial lookbooks must provide clear visual rationale for chosen aspect ratios, focal lengths, and color palettes."
}

#>wonder_grad_film_mfa_1
?["How does the choice of aspect ratio (1.33:1 Academy vs 2.39:1 Anamorphic) impact viewer empathy in tight claustrophobic character dramas?"]{
  #:depth #!aesthetic ~#lens(aspect_ratio_spatial_psychology)
  ~#hypothesis: "The vertical 1.33:1 Academy ratio traps the human face within a portrait frame, increasing viewer eye-fixation duration on micro-expressions by 30% compared to widescreen 2.39:1 formats where peripheral negative space disperses viewer attention."
  !probe{ "Conduct eye-tracking gaze fixation mapping and emotional recall tests on audiences watching identical close-up dramatic monologues framed in 1.33:1 vs 2.39:1." }
  $%[cinematography.facial_gaze_fixation_duration_seconds, psychology.viewer_empathy_score]
}
