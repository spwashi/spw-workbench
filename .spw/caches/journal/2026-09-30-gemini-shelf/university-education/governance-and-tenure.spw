# University Governance, Tenure & Faculty Autonomy
#
# Structural analysis of shared governance, the tenure promotion ladder, and institutional authority.

#>spw_cache_univ_governance
#:cache #!university
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the delicate constitutional balance of shared governance, faculty autonomy, and academic freedom."
  ~#focus: "Faculty senates, tenure evaluation committees, provost hierarchies, and adjunct labor dynamics"
}

^["shared_governance_model"]{
  board_of_trustees: .{
    role: "Fiduciary oversight, presidential appointment, endowment stewardship, legal sovereignty"
    membership: "Alumni, civic leaders, corporate executives, donors (often lacking academic background)"
  }[reg=facet]

  executive_administration: .{
    president_chancellor: "External ambassador, capital campaign fundraiser, executive spokesperson"
    provost_vpaa: "Chief academic officer, dean coordinator, budget allocator, promotion gatekeeper"
    college_deans: "Translators between central administrative targets and departmental faculties"
  }[reg=facet]

  faculty_senate: .{
    role: "Legislative body representing voting faculty on curricular policy, degree requirements, and academic freedom"
    authority: "Primary jurisdiction over courses, degree conferrals, and tenure bylaws"
  }[reg=facet]

  departmental_chairs: .{
    role: "First-among-equals peer leaders managing course scheduling, teaching loads, and local budget allocation"
  }[reg=facet]
}

^["the_tenure_ladder"]{
  stages: #[
    .{ rank: "Assistant Professor", timeline: "Years 1 to 6 (The Tenure Clock)", mandate: "Establish independent research agenda, secure external grants, publish in top-tier journals" },
    .{ rank: "Associate Professor (Tenured)", timeline: "Year 7+", mandate: "Permanent appointment; protected academic freedom; university service; doctoral advising" },
    .{ rank: "Full Professor", timeline: "Post-tenure promotion", mandate: "International field leadership, major program stewardship, endowed chair eligibility" }
  ]
  dossier_components: #[
    "External Evaluation Letters: Blind external assessments from 6-10 eminent scholars in the candidate's exact subfield",
    "Research Portfolio: Monograph books, peer-reviewed journal articles, citation indices, and external grant capture",
    "Teaching Evaluations: Student feedback metrics, peer observation reports, syllabi design, pedagogical awards",
    "Service Record: Committee labor, conference organizing, journal peer reviewing, public scholarship"
  ]
}

^["adjunctification_tensions"]{
  tenure_line_erosion: "Shift from 75% tenure-line faculty in 1970 to over 70% non-tenure-track contingent/adjunct instructors today."
  two_tier_system: "Contingent faculty teach heavy course loads on semester-by-semester contracts with low pay and no research support."
  consequence: "Weakens institutional memory, shared governance quorum, and long-term academic freedom."
}

^["taste"]{
  ~#taste: "Tenure is not a lifetime employment sinecure; it is an intellectual fortress designed to protect dangerous truths."
  ~#wonder: "Can real academic freedom exist in an institution where 70% of the teaching staff can be dismissed without cause at semester's end?"

  principles: #[
    "Faculty sovereignty over curriculum: No bureaucrat or donor should ever dictate what a professor teaches in their lecture hall.",
    "Peer review rigor: Scholars must be evaluated by those who understand the technical nuance of their discipline.",
    "Dignity of labor: High-quality teaching cannot be built on precarious, underpaid adjunct labor."
  ]
}

^["invariants"]{
  "Tenure recommendations pass through departmental vote, college committee review, provost approval, and board confirmation.",
  "Faculty senate resolutions on academic matters carry binding institutional authority unless formally vetoed by trustees.",
  "Denial of tenure in year 6 triggers a mandatory terminal year contract before departure.",
}

#>wonder_univ_governance_1
?["How does the elimination of tenure alter the time horizon of intellectual research?"]{
  #:depth #!philosophical ~#lens(temporal_horizons)
  ~#hypothesis: "Without tenure, researchers abandon high-risk, decades-long fundamental questions in favor of rapid, safe, low-impact papers to guarantee contract renewal."
  !probe{ "Compare citation longevity and breakthrough rate of papers produced by tenure-track faculty vs annual contract researchers." }
  $%[paper.citation_half_life_years, breakthrough.paradigm_shift_score]
}
