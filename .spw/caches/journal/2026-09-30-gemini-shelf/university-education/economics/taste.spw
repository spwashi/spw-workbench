# Economics Taste & Wonder Cache
#
# Moral philosophy in calculus, bounded rationality, distributional ethics, and causal humility.

#>spw_cache_univ_econ_taste
#:cache #!economics_taste
#:layer #!pragmatics

^"intent"{
  ~#goal: "Articulate the ethical stakes, epistemological limits, and philosophical wonder of economic modeling and empirical social science."
  ~#protocol: "cache.layer/1"
}

^"taste_principles"{
  "moral_philosophy_beneath_the_calculus": .{
    equations_govern_human_lives: "Every objective function, budget constraint, and policy multiplier ultimately decides whether real human beings eat, receive chemotherapy, or sleep under bridges; economists must never hide moral cowardice behind mathematical formalism",
    efficiency_is_not_justice: "A market allocation can be mathematically Pareto-efficient while leaving children malnourished; economists must interrogate the normative distribution of initial property endowments rather than treating status-quo inequality as natural law",
  }[reg=facet],
  "the_dismantling_of_homo_economicus": .{
    behavioral_realism: "Human beings are not hyper-rational calculating automata maximizing expected utility across infinite horizons; we are boundedly rational, emotion-driven, loss-averse social creatures yearning for fairness, dignity, and belonging",
    humility_before_institutions: "Formal market clearing is secondary to the unwritten legal, historical, and racial power dynamics that structure property rights, labor unions, and political access",
  }[reg=facet],
  "causal_epistemological_rigor": .{
    the_scandal_of_spurious_correlation: "Rejecting ideological storytelling that confuses correlation with causation; demanding transparent quasi-experimental identification, pre-registered analysis, and open-data replication",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_univ_econ_taste_1
  ?["Why do decentralized price signals coordinate the production of an ordinary pencil across dozens of countries without a central planner, yet fail to price the survival of the biosphere?"]{
    #:depth #!philosophical ~#lens(the_miracle_and_blindness_of_price_signals)
    ~#hypothesis: "Hayek's price mechanism functions as a distributed computational network aggregating localized tacit knowledge with astonishing efficiency, but it computes solely over rival private property rights. Common-pool atmospheric and oceanic resources lack enforceable property boundaries, rendering their destruction invisible to market pricing as an unpriced global negative externality."
    !probe{ "Simulate global carbon pricing equilibrium models with endogenous tipping points and social cost of carbon discount rates (Nordhaus vs Stern)." }
    $%[climate.social_cost_of_carbon_discount, economics.hayekian_price_computation_blindness]
  }

  #>wonder_univ_econ_taste_2
  ?["How does the introduction of a modest financial incentive occasionally reduce, rather than increase, pro-social altruistic behavior (such as blood donation or volunteering)?"]{
    #:depth #!behavioral ~#lens(intrinsic_motivation_crowding_out)
    ~#hypothesis: "Small monetary compensation converts a moral social exchange (governed by identity, civic duty, and social signaling) into a market exchange. Once the transaction is monetized, the intrinsic emotional warm-glow and social praise of altruism are destroyed, crowding out pro-social motivation."
    !probe{ "Conduct field experiments measuring blood donation rates under zero compensation, modest cash vouchers ($10), and high civic recognition awards." }
    $%[behavioral.altruism_crowding_out_rate, psychology.warm_glow_valuation_metric]
  }
}
