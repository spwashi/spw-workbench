# Nursing Taste & Wonder Cache
#
# Bedside presence, the moral courage of patient advocacy, and humanizing technological medicine.

#>spw_cache_univ_nursing_taste
#:cache #!nursing_taste
#:layer #!pragmatics

^"intent"{
  ~#goal: "Articulate the aesthetic nobility, moral courage, and compassionate vigilance that define the professional practice of nursing."
  ~#protocol: "cache.layer/1"
}

^"taste_principles"{
  "the_sanctuary_of_the_bedside": .{
    the_primary_witness: "While physicians make intermittent rounds and technicians run machines, the professional nurse remains at the bedside through the long night—the constant, vigilant human presence witnessing the first breath of birth and the final sigh of death",
    dignity_in_the_physical: "Recognizing that bathing an incontinent patient, repositioning an aching limb, or smoothing tangled hair are not menial tasks, but sacred acts of bodily communion that restore fractured human dignity",
  }[reg=facet],
  "intellectual_rigor_married_to_radical_empathy": .{
    the_complete_clinician: "A great nurse unites razor-sharp pathophysiological knowledge, pharmacology, and hemodynamics with warm, perceptive emotional intelligence; knowing both the exact receptor pharmacology of norepinephrine and the exact comforting words to steady a terrified family",
  }[reg=facet],
  "moral_courage_and_patient_advocacy": .{
    the_shield_against_the_machine: "The nurse is the final line of defense against clinical error, medical arrogance, and dehumanizing institutional efficiency; having the moral fortitude to stop a procedure, question an order, or demand a physician return to the bedside when a patient is in danger",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_univ_nursing_taste_1
  ?["Why does the moral distress experienced by intensive care nurses during non-beneficial aggressive treatment predict professional burnout more strongly than physical workload or long shifts?"]{
    #:depth #!ethical ~#lens(betrayal_of_fiduciary_caring_vocation)
    ~#hypothesis: "Nursing is fundamentally structured around an internal moral covenant to alleviate human suffering. Being forced by institutional hierarchies to inflict physical pain (cracked ribs during futile CPR, arterial punctures, restraints) on dying patients with zero prognosis of recovery violates the core vocational identity of the nurse, producing deep existential moral injury that physical rest cannot heal."
    !probe{ "Survey moral injury index scores against turnover intention among critical care nurses during prolonged end-of-life conflict cases." }
    $%[burnout.moral_injury_scale_score, nursing.icu_turnover_intention_hazard_ratio]
  }

  #>wonder_univ_nursing_taste_2
  ?["How does the simple ritual of an unhurried, intentional nursing back rub reduce physiological anxiety and sleep disruption in postoperative surgical patients?"]{
    #:depth #!relational ~#lens(tactile_vagal_modulation)
    ~#hypothesis: "Rhythmic cutaneous pressure stimulates deep mechanoreceptors and spindle afferents, triggering central endorphin release and dampening hypothalamic-pituitary-adrenal (HPA) axis cortisol secretion. Beyond the physical soothing, it signals to the patient's hypervigilant nervous system that they are safe and protected in the care of a trusted human guardian."
    !probe{ "Measure salivary cortisol levels and continuous nocturnal polysomnography sleep architecture in postoperative patients receiving evening therapeutic back massage vs routine nursing care." }
    $%[endocrine.salivary_cortisol_reduction_percentage, sleep.slow_wave_sleep_stage_3_minutes]
  }
}
