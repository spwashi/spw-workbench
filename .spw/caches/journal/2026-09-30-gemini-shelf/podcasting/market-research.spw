# Podcasting Market Research & Industry Economics
#
# Comprehensive market analysis, audience economics, monetization tiers, and platform distribution dynamics.

#>spw_cache_podcast_market
#:cache #!podcasting
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the economic landscape, advertising mechanics, and distribution channels for professional high-density technical podcasting."
  ~#market_size: "Global podcasting industry projected to reach $30B+ USD with premium niche B2B tech commanding the highest CPMs"
}

^["industry_macro_landscape"]{
  total_addressable_audience: "Estimated 500M+ global weekly podcast listeners; software engineering niche represents ~15M high-intent professionals."
  listening_contexts: #[
    "Commuting (35% of total listening hours)",
    "Deep work & repetitive programming tasks (28%)",
    "Exercise & fitness (20%)",
    "Household & leisure (17%)"
  ]
  completion_rates: "Long-form (>90 min) technical audio achieves 75-85% average completion rates among professional developer cohorts."
}

^["monetization_models"]{
  cpm_advertising: .{
    model: "Cost Per Mille (cost per 1,000 downloads)"
    rates: #[
      .{ tier: "Broad entertainment", cpm_usd: "$18 - $25" },
      .{ tier: "General business/news", cpm_usd: "$30 - $45" },
      .{ tier: "Specialized software/cloud/security", cpm_usd: "$65 - $120" }
    ]
    formats: #[
      "Host-read baked-in sponsor endorsements (highest trust and retention)",
      "Dynamic ad insertion (DAI) targeting geo-location and listener history",
      "Quarterly title sponsorship packages with integrated developer tooling showcases"
    ]
  }[reg=facet]

  direct_listener_support: .{
    model: "Premium subscriber tiers (Patreon, Substack, Apple Podcasts Subscriptions)"
    pricing: "$10 - $25/month for ad-free feeds, full transcripts, raw code repositories, and weekly live Q&A office hours"
    conversion_benchmarks: "2% to 4% of dedicated active audience converts to paid recurring supporters"
  }[reg=facet]

  corporate_underwriting: .{
    model: "Enterprise developer tooling grants (cloud providers, database vendors, compiler toolchains)"
    structure: "Editorial independence firewall; underwriting credited as educational foundation grants"
  }[reg=facet]
}

^["distribution_platforms_and_standards"]{
  apple_podcasts: .{ share: "32%", role: "High-earning iOS demographic; strict editorial curation; directory backbone." }[reg=facet]
  spotify: .{ share: "34%", role: "Algorithmic discovery; integrated video podcast streaming; closed analytics garden." }[reg=facet]
  youtube_podcasts: .{ share: "22%", role: "Fastest-growing visual search engine; auto-chapters; global reach via recommendation feed." }[reg=facet]
  open_rss_ecosystem: .{ share: "12%", role: "Decentralized RSS 2.0 feeds via Overcast, Pocket Casts, Castro; immune to platform de-platforming." }[reg=facet]
}

^["listener_demographics_and_psychographics"]{
  demographics: #[
    "Experience: 45% Senior/Staff Engineers, 30% Mid-level, 15% Engineering Managers/CTOs, 10% Students/Self-taught",
    "Income: Average household income >$140k USD",
    "Tech stack distribution: 40% Full-stack/Web, 35% Backend/Distributed Systems, 25% Embedded/Systems/ML"
  ]
  psychographics: #[
    "High intellectual hunger: Disdain for shallow listicles; respect for first-principles derivations.",
    "Tool pragmatism: Strong skepticism toward marketing buzzwords; loyalty to battle-tested open-source primitives.",
    "Community identity: Pride in mastering complex, low-level computational mechanics."
  ]
}

^["taste"]{
  ~#taste: "Commercial sustainability must never compromise intellectual honesty."
  ~#wonder: "Why do developer audiences tolerate 4-minute host-read sponsor ads when they aggressively install browser ad-blockers?"

  principles: #[
    "Editorial firewall: No sponsor ever reviews episode topics, questions, or critical evaluations in advance.",
    "Personal vetting: Hosts only endorse developer tools, hardware, and services they personally use in their daily workflow.",
    "Respect for silence: When a sponsor spot ends, a clear audio cue separates paid message from technical inquiry."
  ]
}

^["invariants"]{
  "Podcast RSS feed maintains 100% compliance with open W3C and Podcast Index 2.0 namespace standards.",
  "Audio master files are normalized to -16 LUFS for stereo and -19 LUFS for mono distribution.",
  "Transcripts are published simultaneously with audio to ensure accessibility and SEO indexability.",
}

#>wonder_podcast_market_1
?["What is the economic durability of an evergreen technical audio archive?"]{
  #:depth #!philosophical ~#lens(evergreen_capital)
  ~#hypothesis: "News podcasts decay in value after 48 hours; a 3-hour deep dive on memory allocators or lambda calculus continues earning downloads and subscriptions 5 years later."
  !probe{ "Track download curves of conceptual foundational episodes vs trending framework release episodes over a 24-month horizon." }
  $%[episodes.long_tail_download_ratio, archive.revenue_decay_constant]
}
