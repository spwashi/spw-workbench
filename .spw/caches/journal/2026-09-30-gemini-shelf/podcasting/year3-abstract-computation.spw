# Year 3 Curriculum: Abstract Computation & Algorithmic Principles
#
# Complete 52-week daily curriculum exploring type systems, category theory, formal verification, and computational limits.

#>spw_cache_podcast_year3
#:cache #!podcasting
#:layer #!pragmatics

^"intent"{
  ~#goal: "Detail the 365 daily episodes of Year 3 ascending to pure abstract computation: lambda calculus, category theory, formal logic, consensus, and complexity theory."
  ~#timeline: "Episodes 731 - 1095 (Weeks 105 - 156)"
}

^["quarter_1_types_and_lambda"]{
  theme: "Lambda Calculus, Type Systems, and the Curry-Howard Bridge (Weeks 105 - 117 · Episodes 731 - 821)"
  weekly_modules: #[
    .{ week: "105-107", topic: "The Untyped Lambda Calculus: Terms, Beta-Reduction & Church Encodings", spec: "Alpha conversion; beta reduction; Church numerals; Church booleans; Y-combinator recursion" },
    .{ week: "108-110", topic: "The Simply Typed Lambda Calculus (STLC) & Soundness", spec: "Typing rules; progress and preservation theorems; strong normalization; termination guarantees" },
    .{ week: "111-113", topic: "The Curry-Howard Correspondence: Propositions as Types", spec: "Intuitionistic logic; proofs as programs; disjunction as sum types; conjunction as product types" },
    .{ week: "114-115", topic: "Type Inference: The Hindley-Milner Algorithm (Algorithm W)", spec: "Principal types; unconstrained type variables; Robinson unification algorithm; let-polymorphism" },
    .{ week: "116-117", topic: "Advanced Type Topologies: System F & Dependent Types", spec: "Universal quantification; existential types; dependent product types (Pi); dependent sums (Sigma)" }
  ]
}

^["quarter_2_category_theory_and_formal_methods"]{
  theme: "Category Theory, Algebraic Structures, and Formal Proof (Weeks 118 - 130 · Episodes 822 - 912)"
  weekly_modules: #[
    .{ week: "118-120", topic: "Category Theory Foundations: Objects, Morphisms & Composition", spec: "Categories; identity morphisms; associativity laws; dual categories; epimorphisms and monomorphisms" },
    .{ week: "121-123", topic: "Functors, Natural Transformations & Monads", spec: "Covariant and contravariant functors; naturality squares; monads as monoids in the category of endofunctors" },
    .{ week: "124-125", topic: "Adjunctions, Limits & Colimits", spec: "Universal properties; products and coproducts; pullbacks and pushouts; adjoint functor theorems" },
    .{ week: "126-128", topic: "Formal Specification in TLA+ & Model Checking", spec: "Temporal logic of actions; state transition machines; invariant checking; verifying distributed algorithms" },
    .{ week: "129-130", topic: "Interactive Theorem Proving with Coq and Lean", spec: "Calculus of Inductive Constructions; writing formal machine-checked proofs of software correctness" }
  ]
}

^["quarter_3_distributed_consensus_and_graph_flows"]{
  theme: "Consensus, Asynchronous Systems, and Graph Theory (Weeks 131 - 143 · Episodes 913 - 1003)"
  weekly_modules: #[
    .{ week: "131-133", topic: "The FLP Impossibility Theorem & Asynchronous Consensus", spec: "Fischer-Lynch-Paterson proof; partial synchrony; failure detectors (Chandra-Toueg)" },
    .{ week: "134-136", topic: "Paxos & Raft: Deconstructing Distributed Log Replication", spec: "Leader election; log matching property; view changes; joint consensus reconfiguration" },
    .{ week: "137-138", topic: "Byzantine Fault Tolerance (BFT) & Quorum Systems", spec: "PBFT; state machine replication with malicious actors; 3f+1 minimum node constraints" },
    .{ week: "139-141", topic: "Network Flows & Combinatorial Graph Algorithms", spec: "Ford-Fulkerson; Edmonds-Karp; Max-Flow Min-Cut theorem; bipartite matching" },
    .{ week: "142-143", topic: "Topological Sort, Strongly Connected Components & Graph Coloring", spec: "Tarjan's and Kosaraju's SCC algorithms; cycle detection; chordal graphs; compiler applications" }
  ]
}

^["quarter_4_complexity_cryptography_and_beyond"]{
  theme: "Computational Limits, Cryptography, and the Grand Unified Synthesis (Weeks 144 - 156 · Episodes 1004 - 1095)"
  weekly_modules: #[
    .{ week: "144-146", topic: "Computability Theory: Turing Machines & The Halting Problem", spec: "Universal Turing machines; undecidability; Rice's theorem; Kolmogorov complexity" },
    .{ week: "147-149", topic: "Computational Complexity: P, NP, PSPACE & The Cook-Levin Theorem", spec: "Deterministic vs nondeterministic polynomial time; 3-SAT reduction; NP-completeness; oracle machines" },
    .{ week: "150-152", topic: "Modern Zero-Knowledge Cryptography: zk-SNARKs & zk-STARKs", spec: "Interactive proof systems; arithmetic circuits; QAP (Quadratic Arithmetic Programs); polynomial commitments" },
    .{ week: "153-154", topic: "Quantum Computational Models: Qubits, Entanglement & Algorithms", spec: "Bloch sphere; unitary matrix operators; quantum superposition; Shor's and Grover's algorithms" },
    .{ week: "155-156", topic: "The Grand Synthesis: 3,285 Hours Across the Landscape of Computation", spec: "Tracing one computation simultaneously through category theory, type checking, assembly registers, and silicon gates" }
  ]
}

^["taste"]{
  ~#taste: "Mathematics is not an ornament of computer science; computer science is mathematics made executable."
  ~#wonder: "Why do programmers independently re-invent category theoretical structures centuries after mathematicians conceived them?"

  principles: #[
    "Proof over assertion: In abstract computing, a proposition is meaningless until its typing derivation or proof tree is complete.",
    "Aesthetic elegance: A system governed by a single general algebraic law outlives a hundred ad-hoc configuration flags.",
    "Boundaries of reason: Acknowledging what cannot be computed (Halting, Rice's Theorem) is the beginning of true wisdom."
  ]
}

^["invariants"]{
  "Every abstract mathematical concept is paired with an executable reference implementation in Haskell, OCaml, or Lean.",
  "Formal proofs verify progress and preservation theorems explicitly.",
  "The 3-year curriculum concludes with a unified case study connecting web, metal, and math.",
}

#>wonder_podcast_year3_1
?["Why is the Curry-Howard correspondence the most profound bridge in the history of intellectual thought?"]{
  #:depth #!philosophical ~#lens(isomorphic_truth)
  ~#hypothesis: "The realization that writing a computer program is identical to writing a mathematical proof unites engineering and formal logic into a single human endeavor."
  !probe{ "Derive Modus Ponens in logic; then write function application in lambda calculus; demonstrate to a student that they are the exact same geometric object." }
  $%[isomorphism.semantic_match_ratio, student.epiphany_latency_s]
}
