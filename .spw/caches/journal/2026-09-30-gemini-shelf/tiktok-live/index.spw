# TikTok LIVE Feature Cache Index
#
# Root cache index for TikTok LIVE features, streaming infrastructure, virtual economy, and interactive mechanics.

#>spw_cache_tiktok_live_index
#:cache #!tiktok_live
#:layer #!pragmatics

^"intent"{
  ~#goal: "Cache structural, interactive, economic, and infrastructure features of the TikTok LIVE platform."
  ~#domain: "Live streaming, real-time engagement, virtual gifting, algorithmic distribution"
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @features: ~"./features.spw"
  @pipeline: ~"./streaming-pipeline.spw"
  @economy: ~"./virtual-economy.spw"
  @interactive: ~"./interactive-mechanics.spw"
  @commerce: ~"./live-commerce.spw"
  @moderation: ~"./moderation-safety.spw"
  @analytics: ~"./analytics-metrics.spw"
  @taste: ~"./taste.spw"
}

^"dispatch"{
  overview: @features
  streaming_pipeline: @pipeline
  virtual_economy: @economy
  interactive_mechanics: @interactive
  live_commerce: @commerce
  moderation_safety: @moderation
  analytics_and_metrics: @analytics
  taste_considerations: @taste
}

^"taste"{
  ~#taste: "Real-time attention mechanics blend low-latency media delivery with synchronous gamified social contracts."
  ~#wonder: "How does sub-second video latency change the psychological contract between broadcaster and audience?"
}

^"invariants"{
  "All streaming features balance ultra-low latency with global scale edge distribution.",
  "Virtual economy transactions are atomic, audit-logged, and real-time synchronized across chat and overlays.",
  "Interactive mechanics (battles, multi-guest) dynamically negotiate media topologies between peer-to-peer and relayed CDN paths.",
}

#>wonder_tiktok_live_index_1
?["What is the fundamental architectural constraint of TikTok LIVE compared to VOD video?"]{
  #:depth #!philosophical ~#lens(temporal_immediacy)
  ~#hypothesis: "VOD optimizes for global CDN hit rates and pre-transcoded chunk delivery; LIVE optimizes for ingest-to-glass latency and real-time state synchronization."
  !probe{ "Trace the lifecycle of a single user gift: from touch gesture, through payment gateway, into distributed pub/sub, rendered in host WebGL canvas within 300ms." }
  $%[event.latency_ms, pubsub.fanout_nodes]
}
