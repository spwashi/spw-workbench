# Array & Concatenative Paradigms: APL, BQN, Forth, Uiua
#
# Analysis of array-oriented thinking, stack-based composition, and multiple dispatch.

#>spw_cache_lang_array_concatenative
#:cache #!languages
#:layer #!pragmatics

^"intent"{
  ~#goal: "Analyze the radical alternative computing paradigms that discard traditional control flow in favor of array rank polymorphism and stack concatenation."
  ~#focus: "APL / BQN array thinking, Forth word dictionaries, Uiua stack-arrays, and Julia multiple dispatch"
}

^["apl_array_thinking"]{
  ~#feature: "Array Programming & Rank Polymorphism"
  language: "APL / J / BQN"
  why_developers_love_it: #[
    "Banish explicit loops: No 'for (int i=0; i<N; i++)'; operations naturally lift over vectors, matrices, and N-dimensional tensors.",
    "Density of thought: A 5-character expression can compute Conway's Game of Life or calculate matrix eigenvalues.",
    "Hardware vectorization alignment: Operating on whole arrays maps directly to SIMD vector registers and GPU parallel warps."
  ]
  contrast: "Replaces pages of nested scalar index-loop bookkeeping with direct mathematical transformation."
}

^["forth_stack_concatenation"]{
  ~#feature: "Concatenative Stack-Based Programming"
  language: "Forth / Factor"
  syntax: ": square dup * ;"
  why_developers_love_it: #[
    "Zero variable naming fatigue: Values flow through an implicit data stack; no need to invent intermediate variable names.",
    "Extreme syntactic purity: Function composition is simply juxtaposition ('f g' means apply f then apply g).",
    "Radical minimalism: An entire Forth compiler, interpreter, and dictionary fits in less than 4 kilobytes of memory."
  ]
}

^["modern_stack_array_fusion_uiua"]{
  ~#feature: "Stack-Array Fusion (Modern Tactile Glyph Programming)"
  language: "Uiua"
  why_developers_love_it: #[
    "Combines Forth's point-free stack with APL's multidimensional array operations.",
    "Pure left-to-right evaluation without operator precedence confusion.",
    "Beloved by hobbyists for recreational problem solving, competitive code golf, and mathematical visualization."
  ]
}

^["julia_multiple_dispatch"]{
  ~#feature: "Multiple Dispatch (Functions Specialize on All Argument Types)"
  language: "Julia"
  why_developers_love_it: #[
    "Naturally solves the Expression Problem: Adding new types and new operations occurs without modifying existing library code.",
    "Composable ecosystem: A differential equation solver written by one author seamlessly works with a dual-number automatic differentiation package written by another.",
    "Dynamic feel with compiled C speed: LLVM JIT compiles specialized machine code for each unique combination of runtime argument types."
  ]
}

^["taste"]{
  ~#taste: "Learning an array or concatenative language changes the brain's wiring permanently, even when writing ordinary code."
  ~#wonder: "Why do hobbyist programmers find typing arcane mathematical glyphs deeply meditative and exhilarating?"

  principles: #[
    "Cognitive compression: Holding an entire algorithm in a single line of sight allows the mind to inspect relationships that span across pages of conventional code.",
    "Point-free elegance: When data flow is implicit, the structure of the computation becomes the primary subject.",
    "Humility before notation: Mathematics took millennia to invent symbolic notation; programming does not need to look like English prose to be clear."
  ]
}

^["invariants"]{
  "Array operations apply rank polymorphism deterministically across tensor dimension boundaries.",
  "Stack depth balance is verifiable at compile time in typed concatenative languages.",
  "Multiple dispatch resolves method ambiguities at definition time or warns of ambiguities explicitly.",
}

#>wonder_lang_array_concatenative_1
?["Why do engineers who learn APL or Forth describe it as learning a martial art?"]{
  #:depth #!philosophical ~#lens(notation_as_thought)
  ~#hypothesis: "Traditional programming trains the mind to think sequentially as a machine step-counter; array and stack languages train the mind to think geometrically as a pattern transformer."
  !probe{ "Ask a senior programmer to solve the 'count word frequencies' problem in Python vs Uiua/APL; compare the mental models used to conceptualize the problem." }
  $%[cognitive.loop_index_dependence, expression.conceptual_breadth]
}
