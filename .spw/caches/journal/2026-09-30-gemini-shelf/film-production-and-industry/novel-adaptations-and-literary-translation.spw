# Novel Adaptations & Literary Translation Cache
#
# IP rights acquisition, compression of prose, externalizing internal monologue, and structural transformation.

#>spw_cache_film_prod_novel_adaptations
#:cache #!novel_adaptations_and_literary_translation
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the legal, structural, and dramaturgical mechanisms of adapting novels and literary intellectual property into cinematic screenplays."
  ~#protocol: "cache.layer/1"
}

^"intellectual_property_and_rights_acquisition"{
  "rights_chain_and_option_mechanics": .{
    option_vs_purchase: "An option grants exclusive right to develop a literary property for a finite window (typically 12-18 months with renewal options) for 5-10% of total purchase price, preserving capital while packaging talent",
    shopping_agreements: "Zero-cost agreements granting a producer the temporary right to pitch an author's book to studios; author retains complete ownership and approval over eventual sale terms",
    chain_of_title_sanctity: "Meticulous legal paper trail verifying that the author holds clear, unencumbered copyright, free of reversion claims, co-author disputes, or legacy publisher encumbrances",
    public_domain_vs_underlying_rights: "Works published before 1929 exist in the public domain, allowing royalty-free adaptation; copyrighted works require underlying rights agreements encompassing theatrical, television, merchandising, and sequel rights",
  }[reg=facet],
}

^"literary_to_cinematic_dramaturgical_translation"{
  "externalizing_the_interior_mind": .{
    death_of_exposition: "Prose thrives on subjective interior monologue and philosophical narration; cinema demands behavioral externalization where thought is translated into physical action, subtextual glances, and environmental staging",
    visual_metaphor_and_objective_correlatives: "Transforming literary abstractions into tangible physical props, atmospheric weather, and recurring visual motifs that silently carry the protagonist's psychological trauma",
    voiceover_trap_avoidance: "Resisting the temptation to paste authorial prose into voiceover narration; voiceover is utilized effectively only when it contradicts or ironizes the on-screen visual reality",
  }[reg=facet],
  "structural_compression_and_character_mergers": .{
    the_compression_ratio: "A 400-page novel (120,000 words) must be ruthlessly compressed into a 110-page screenplay (approx 20,000 words); necessitates excising up to 80% of secondary storylines",
    character_consolidation: "Merging multiple minor novel characters into a single coherent composite character possessing distinct dramatic utility and strong dramatic stakes",
    restructuring_into_dramatic_sequences: "Translating sprawling, meandering literary chapters into an eight-sequence dramatic engine characterized by rising tension, midpoint crisis, and structural catharsis",
  }[reg=facet],
  "fidelity_vs_artistic_autonomy": .{
    the_fallacy_of_literal_illustration: "Reverent, scene-by-scene transcription of literature yields sluggish, lifeless cinema; true fidelity requires betraying the literal text to preserve its thematic essence",
    case_the_godfather: "Francis Ford Coppola and Mario Puzo ruthlessly pruned the pulpy subplots of the novel, distilling the core into an operatic tragedy of corporate succession and moral decay",
    case_no_country_for_old_men: "The Coen Brothers retained Cormac McCarthy's dialogue nearly verbatim, relying on vast negative space, absence of musical score, and visual geography to convey cosmic indifference",
    case_annihilation: "Alex Garland adapted the subjective dread and dreamlike atmosphere of Jeff VanderMeer's book from memory without re-reading it, prioritizing poetic cinematic impact over plot mechanics",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_film_prod_novel_adaptations_1
  ?["Why do the greatest film adaptations often require the screenwriter to fundamentally betray the plot mechanics of beloved literature in order to remain faithful to its emotional truth?"]{
    #:depth #!dramaturgical ~#lens(medium_specific_semiotics)
    ~#hypothesis: "Prose literature generates meaning through symbolic semantic decoding inside the reader's imagination, whereas cinema generates meaning through visceral, spatio-temporal audiovisual collision. A literal plot event that resonates on the printed page often collapses into melodramatic bathos when captured by a camera lens, requiring screenwriters to invent wholly new cinematic equivalents."
    !probe{ "Map structural plot divergence against critical audience emotional resonance across 50 landmark literary adaptations from 1950 to 2025." }
    $%[screenwriting.plot_divergence_index, audience.thematic_fidelity_perception]
  }
}
