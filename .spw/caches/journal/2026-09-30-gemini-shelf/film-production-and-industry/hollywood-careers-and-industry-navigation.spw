# Hollywood Careers & Industry Navigation Cache
#
# Representation ecosystem, guild labor agreements, pitch architecture, and contract negotiations.

#>spw_cache_film_prod_hollywood_careers
#:cache #!hollywood_careers_and_industry_navigation
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the professional ecosystem of Hollywood representation, guild labor protections, pitch mechanics, and intellectual property deal structures."
  ~#protocol: "cache.layer/1"
}

^"representation_triad_and_career_architecture"{
  "agents_managers_and_lawyers": .{
    talent_agents: "State-licensed under the California Talent Agencies Act; legally permitted to procure employment and negotiate contracts; strictly capped at 10% commission; major agencies include CAA, WME, UTA, Gersh, Verve",
    literary_and_talent_managers: "Career architects focusing on long-term brand, creative script development, and industry relationships; unbonded by employment procurement law; permitted to produce client projects; 10% to 15% commission",
    entertainment_lawyers: "Contract specialists negotiating deal points, chain-of-title cleanups, quote verifications, and backend profit definitions; typically retain 5% of client earnings or charge $600-$1,200/hr billable rates",
  }[reg=facet],
  "guild_protections_and_collective_bargaining": .{
    writers_guild_of_america_wga: "Minimum Basic Agreement (MBA) setting mandatory wage floors for script steps (first draft, revision, polish), guaranteed weekly room rates, streaming residual formulas, and strict guardrails against AI generative script replacement",
    directors_guild_of_america_dga: "Enforces director creative rights: guaranteed 10-week unhindered director's cut for features, sole authority to give acting notes on set, prep-time parity, and post-production creative oversight",
    screen_actors_guild_sag_aftra: "Protects performers via day-player scale rates, mandatory overtime/hazardous work pay, meal penalties, background performer quotas, and consent and compensation mandates for generative AI digital replicas",
    iatse_and_teamsters: "Protect craft and logistical labor: Local 600 (Cinematographers), Local 700 (Editors Guild), Local 800 (Art Directors), Local 728 (Electric), Local 80 (Grip), and Teamsters 399 (Casting, Drivers, Location Managers)",
  }[reg=facet],
}

^"industry_rituals_and_deal_structures"{
  "pitching_and_general_meetings": .{
    the_twenty_minute_pitch: "Classic executive pitch structure: 1) The Personal Connection / Why Me, 2) The World and Tone, 3) The Protagonist and Flaw, 4) Inciting Incident and Pilot/Act 1, 5) Series Engine / Franchise Viability, 6) The Climax",
    the_water_bottle_tour: "General meetings with creative executives to build rapport, share personal artistic tastes, and get onto open writing assignment (OWA) or open directing assignment (ODA) lists",
    lookbooks_and_sizzle_reels: "Visual dossiers curating typography, cinematography references, color palettes, and casting wishlists to communicate tone before financing is secured",
  }[reg=facet],
  "deal_points_and_profit_participation": .{
    option_and_purchase_agreements: "Producers secure an exclusive 12-to-18 month option window to develop a property for 5-10% of purchase price; full purchase price (typically 2-3% of production budget) triggers upon principal photography",
    net_points_vs_gross_participation: "'Net profit' points rarely pay due to studio overhead, distribution fees, and cross-collateralization ('Hollywood accounting'); elite talent negotiates Adjusted Gross Receipts (AGR) or First Dollar Gross (FDG)",
    step_deals_and_turnaround: "Writers contracted in distinct payable steps (treatment, draft 1, rewrite, polish) with studio reading periods; turnaround clauses allow writers to reclaim stalled projects after 12-24 months of dormancy",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_film_prod_hollywood_careers_1
  ?["Why do speculative screenplays with high 'concept voice' and non-linear structure succeed as calling cards but struggle to get financed without significant flattening in development?"]{
    #:depth #!sociological ~#lens(risk_aversion_vs_voice_signaling)
    ~#hypothesis: "Spec scripts act as dual-purpose economic instruments: they function as radical artistic calling cards that signal authorial brilliance to agents and managers, but once acquired by risk-averse studio financiers, corporate committee notes systematically sand away eccentricities to satisfy algorithmic four-quadrant audience appeal."
    !probe{ "Track textual divergence and sentiment drift between Black List winning spec drafts and their eventual theatrically released shooting scripts." }
    $%[industry.voice_flattening_coefficient, production.development_rewrite_rounds]
  }
}
