# Intimacy Coordination & Consent Protocols Cache
#
# Actor advocacy, choreography as stunt work, barrier mechanics, nudity riders, and closed-set hygiene.

#>spw_cache_film_prod_intimacy_coord
#:cache #!intimacy_coordination_and_consent
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the professional standards, physical barrier mechanics, legal riders, and choreographic protocols of intimacy coordination in film production."
  ~#protocol: "cache.layer/1"
}

^"advocacy_and_preproduction_framework"{
  "role_and_authority_of_intimacy_coordinators": .{
    sag_aftra_accreditation: "The Intimacy Coordinator (IC) acts as a specialized department head and actor advocate for simulated sex, nudity, and intense physical vulnerability, certified under SAG-AFTRA registry standards",
    creative_liaison: "Collaborates with the director to realize the dramatic vision while ensuring the physical and emotional safety of the performers through transparent, non-coercive communication",
    boundary_mapping_and_check_ins: "Conducts confidential one-on-one boundary check-ins with actors before rehearsals to establish definitive anatomical touch limits without director or producer presence",
  }[reg=facet],
  "nudity_riders_and_legal_safeguards": .{
    contractual_rider_specificity: "SAG-AFTRA riders explicitly detail exact anatomical areas permitted to be shown (e.g., bare back, partial side-breast), simulation actions permitted, and camera angles agreed upon",
    post_production_cgi_protections: "Strict contractual bans on using digital VFX or generative tools to alter nudity, composite faces onto body doubles, or extract unapproved frames",
    monitor_and_still_photo_embargo: "Complete prohibition of personal cell phones or unauthorized monitor photography; digital rushes containing nudity encrypted with watermarked biometric access controls",
  }[reg=facet],
}

^"choreography_and_set_execution"{
  "intimacy_as_choreographed_stunts": .{
    rejection_of_improvisation: "Simulated intimate scenes are never left to spontaneous actor improvisation; every physical contact point, hand grip, kiss duration, and pelvic angle is rigorously choreographed in advance",
    movement_scores_and_beat_counts: "Scenes are mapped to repeatable musical or rhythmic counts, allowing actors to inhabit emotional intensity without experiencing ambiguous physical boundary blurring",
    tap_out_safeguards: "Standardized physical and verbal safety cues (such as tapping an actor's shoulder or calling 'pause') allowing any performer to halt the take instantly if a boundary is breached",
  }[reg=facet],
  "modesty_garments_and_barrier_mechanics": .{
    barrier_cushions_and_pads: "Specially engineered foam and silicone barrier cushions positioned between performers' pelvises to ensure zero physical genital contact during simulated sexual motion",
    modesty_garments: "Skin-toned seamless thongs, silicone nipple covers, strapless adhesive garments, and tape barriers designed to stay secure under sweat and rapid physical movement",
  }[reg=facet],
  "closed_set_protocol_and_robe_discipline": .{
    closed_set_enforcement: "Soundstage cleared of all non-essential personnel; limited strictly to Director, DP, Boom Operator, 1st AD, and IC; all external video village monitors switched off or physically tented",
    robe_protocol: "Performers remain in robes until the immediate moments before 'action' is called; dedicated PAs or IC immediately cover performers with robes and blankets the instant 'cut' is called",
    continuous_consent_paradigm: "Consent is established as ongoing, conditional, and dynamic; agreement in rehearsal does not obligate an actor if discomfort or distress arises during production",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_film_prod_intimacy_coord_1
  ?["Why does treating intimate physical contact with the clinical rigor of a martial arts stunt sequence result in more authentic, electrically charged on-screen chemistry?"]{
    #:depth #!craft ~#lens(mechanical_safety_liberates_emotion)
    ~#hypothesis: "When the mechanical physical parameters of touch are unambiguously fixed, verified, and separated by physical barriers, the actor's nervous system is freed from defensive hyper-vigilance and boundary anxiety, unlocking genuine psychological vulnerability and visceral emotional presence."
    !probe{ "Conduct post-performance psychological debriefs and subjective authenticity ratings with actors performing intimate scenes under strict IC choreography vs unchoreographed improvisational direction." }
    $%[acting.psychological_safety_index, performance.scene_authenticity_rating]
  }
}
