# Film Production Taste & Ethics Cache
#
# Communal set alchemy, fiduciary care of actor vulnerability, and craft ethics.

#>spw_cache_film_prod_taste
#:cache #!film_production_taste
#:layer #!pragmatics

^"intent"{
  ~#goal: "Articulate the craft ethics, communal alchemy, and ethical stewardship required to lead high-stakes motion picture film sets."
  ~#protocol: "cache.layer/1"
}

^"taste_principles"{
  "the_set_as_sacred_commune": .{
    egalitarian_respect: "A film set collapses class pretension: the boom operator standing motionless for six minutes in physical pain and the key grip leveling track in the mud share equal artistic authorship with the director and movie star",
    the_miracle_of_synchronization: "When camera, focus puller, boom, lights, and actors move together in a continuous uninterrupted master shot, the result is not mere industrial coordination, but a breathless collective ritual of human harmony",
  }[reg=facet],
  "fiduciary_care_of_vulnerability": .{
    the_performer_as_open_nerve: "An actor on set strips away ordinary psychological armor to reveal terror, grief, or nakedness before a crew of strangers; leadership that abuses or mocks this vulnerability commits a profound moral failure",
    safety_as_prerequisite_to_art: "No shot, no visual spectacle, and no schedule acceleration is ever worth risking a single crew member's physical life or mental sanity; genuine cinematic brilliance is born from calm ethical discipline, not reckless chaos",
  }[reg=facet],
  "stewardship_of_literary_heritage": .{
    reverence_without_servility: "The adapter honors an author not by freezing their words in amber, but by treating their story as a living organism capable of being reborn in light and shadow",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_film_prod_taste_1
  ?["What allows a crew of 150 exhausted strangers working in freezing rain at 3:00 AM to suddenly achieve transcendent collective focus when the director whispers 'action'?"]{
    #:depth #!sociological ~#lens(liminal_collective_flow_states)
    ~#hypothesis: "Film production triggers an archaic evolutionary hunting-band consciousness: shared physical hardship, high stakes, explicit ritualized vocal signals ('rolling', 'speed', 'action'), and common focus on capturing an elusive moment collapse individual ego into an ecstatic collective flow state."
    !probe{ "Conduct galvanic skin response and EEG coherence measurements across diverse crew roles during active rolling takes vs waiting periods on high-stress night location shoots." }
    $%[psychology.crew_eeg_phase_locking, production.collective_flow_coherence]
  }

  #>wonder_film_prod_taste_2
  ?["How does the physical presence of an Intimacy Coordinator fundamentally alter the power dynamic between a veteran auteur director and a young vulnerable actor?"]{
    #:depth #!ethical ~#lens(structural_decentering_of_power)
    ~#hypothesis: "The presence of a dedicated, union-backed advocate introduces an institutional circuit breaker that neutralizes unspoken coercion, allowing the actor to negotiate their boundaries without the terrifying fear that saying 'no' will destroy their career."
    !probe{ "Survey casting directors and agency representatives regarding actor career trajectory before and after asserting strict IC boundaries on major studio productions." }
    $%[ethics.coercion_suppression_index, labor.actor_agency_longevity]
  }
}
