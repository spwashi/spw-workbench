# Genre Conventions & Cultural Trends Cache
#
# LitRPG, Progression Fantasy, Cozy Fantasy, Romantasy, Royal Road serial pipelines, and trope packaging.

#>spw_cache_indie_author_genres
#:cache #!genre_conventions_and_cultural_trends
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the emergent literary genres, serialization pipelines, trope-first reader expectations, and cover design aesthetics created within the indie author ecosystem."
  ~#protocol: "cache.layer/1"
}

^"emergent_indie_native_genres"{
  "litrpg_and_gamelit_mechanics": .{
    system_interfaces_and_stat_sheets: "Explicit integration of RPG game mechanics into fictional reality: numerical status screens, character levels, attribute allocations, skill notifications, and loot tables",
    subgenre_variants: "System Apocalypse (modern Earth suddenly subjected to game rules), Dungeon Core (protagonist reborn as a sentient subterranean dungeon), and VRMMO (virtual reality gaming worlds)",
    reader_contracts: "Unflinching commitment to rule consistency: readers audit math, skill progressions, and combat mechanics with the analytical rigor of competitive gamers",
  }[reg=facet],
  "progression_fantasy_and_cultivation": .{
    measurable_magical_advancement: "Focuses on characters systematically training, meditating, and comprehending cosmic principles to climb explicit stages of magical potency (e.g., Will Wight's 'Cradle' series)",
    wuxia_and_xianxia_synthesis: "Synthesizing Eastern Taoist cultivation traditions (Qi circulation, Dantian refining, tribulation lightning) with Western epic fantasy pacing and character arcs",
    hard_magic_empowerment: "Cathartic emotional resonance derived from earned personal mastery through sweat, discipline, and philosophical insight rather than unearned divine prophecy",
  }[reg=facet],
  "cozy_fantasy_and_domestic_solace": .{
    low_stakes_sanctuary: "Pioneered into mainstream prominence by Travis Baldree's 'Legends & Lattes': deliberate de-escalation of stakes, prioritizing warmth, small business building (bakeries, coffee shops, bookshops), and found family over apocalyptic warfare",
    sensory_domesticity: "Rich, tactile descriptions of brewing coffee, baking pastries, hearth fires, and restorative dialogue providing psychological refuge from modern burnout",
  }[reg=facet],
  "romantasy_and_dark_romance": .{
    fantasy_romance_fusion: "Melding expansive secondary-world high fantasy with emotionally intense, character-driven romance and high romantic spice ratings",
    iconic_trope_engines: "Enemies-to-lovers, 'who did this to you?', forced proximity, fated mates, and morally grey brooding antiheroes ('shadow daddies')",
  }[reg=facet],
}

^"serialization_pipelines_and_packaging_aesthetics"{
  "royal_road_to_amazon_serialization_pipeline": .{
    serialized_web_incubator: "Platforms like Royal Road and ScribbleHub serve as real-time testing grounds: authors publish daily 2,000-word chapters, monetize early access on Patreon, and leverage reader comments for rapid editing",
    stubbing_and_ku_migration: "Once a web serial reaches critical mass, the author 'stubs' early chapters (removing them from web platforms to comply with Amazon KDP Select exclusivity) and packages them into high-ranking Kindle Unlimited releases",
  }[reg=facet],
  "trope_first_packaging_and_cover_trends": .{
    explicit_trope_tagging: "Book descriptions and social media teasers prominently lead with explicit trope checklists ('Grumpy x Sunshine', 'Fake Dating', 'Found Family', 'Revenge Arc') fulfilling precise reader cravings",
    physical_art_renaissance: "High-contrast character illustration, illustrated floral discreet romance covers, gold-foil embossing, and stenciled digitally sprayed page edges establishing books as collector status symbols",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_indie_author_genres_1
  ?["Why did LitRPG and Progression Fantasy emerge almost exclusively from independent self-published web serials rather than traditional New York publishing houses?"]{
    #:depth #!sociological ~#lens(institutional_blindness_to_gaming_grammar)
    ~#hypothesis: "Legacy corporate publishing editors were culturally alienated from video game grammar and dismissed numerical stat boxes as 'unliterary'. Meanwhile, a generation that grew up on World of Warcraft, anime, and MMORPGs hungered for stories that honored their native psychological framing of progress, creating an immense underserved market that indie serial authors immediately colonized."
    !probe{ "Analyze demographic reading habits, gaming hours, and Amazon bestseller category rankings for LitRPG releases over the past decade." }
    $%[demographics.gamer_readership_overlap, market.progression_genre_growth_rate]
  }
}
