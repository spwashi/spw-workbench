# Advanced Curricular Frameworks: AP, IB & Dual Enrollment
#
# Comparative analysis of Advanced Placement, International Baccalaureate, and Dual Enrollment systems.

#>spw_cache_sec_advanced_curricula
#:cache #!secondary_ed
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the structure, assessment standards, and pedagogical philosophies of top advanced secondary academic frameworks in the United States."
  ~#accreditation: "College Board Advanced Placement (AP), International Baccalaureate (IB), State Dual Enrollment Articulation Agreements"
}

^["advanced_placement_ap_framework"]{
  overview: "College Board standardized curriculum offering 38+ university-level courses examined on a 1 to 5 scale."
  flagship_offerings: #[
    "AP Calculus BC (differential and integral calculus, series, Taylor polynomials)",
    "AP Physics C: Mechanics & Electricity/Magnetism (calculus-based physics)",
    "AP Computer Science A (Java-based data structures, algorithms, object-oriented design)",
    "AP Literature and Composition & AP United States History (document-based analytical writing)"
  ]
  ap_capstone_diploma: .{
    ap_seminar: "Year 1: Interdisciplinary inquiry, cross-curricular source evaluation, team multimedia presentations"
    ap_research: "Year 2: Year-long independent academic study culminating in a 5,000-word scholarly paper and defense"
  }[reg=facet]
}

^["international_baccalaureate_ib_diploma"]{
  philosophy: "Holistic, internationally minded education emphasizing critical thinking, global citizenship, and epistemological self-awareness."
  diploma_core: #[
    .{ component: "Theory of Knowledge (TOK)", focus: "Epistemological inquiry examining 'How do we know what we claim to know?' across disciplines" },
    .{ component: "Extended Essay (EE)", focus: "4,000-word independent research paper supervised by a faculty mentor" },
    .{ component: "Creativity, Activity, Service (CAS)", focus: "Experiential learning balancing artistic projects, athletic exertion, and community volunteering" }
  ]
  subject_groups: "6 subjects chosen across languages, individuals & societies, sciences, mathematics, and the arts (3 Higher Level HL + 3 Standard Level SL)."
}

^["dual_enrollment_and_early_college"]{
  mechanism: "High school students enroll concurrently in accredited community college or university courses."
  advantages: #[
    "Guaranteed credit transfer: Direct letter-grade college transcript transfer without relying on high-stakes single-day exams.",
    "Cost elimination: Provides low-income students with up to 2 full years of debt-free university credits before high school graduation.",
    "Authentic college socialization: Navigating university syllabus expectations, registrar systems, and adult classroom dynamics."
  ]
}

^["state_magnet_and_exam_schools"]{
  exemplars: "Thomas Jefferson High School for Science and Technology (TJHSST), Stuyvesant, Boston Latin, Illinois Math and Science Academy (IMSA)"
  curricular_elevation: "Post-AP coursework including Multivariable Calculus, Linear Algebra, Quantum Mechanics, Machine Learning, and dedicated research mentorship labs."
}

^["taste"]{
  ~#taste: "Advanced curriculum should ignite genuine passion for truth, not merely accumulate test-score badges."
  ~#wonder: "Why does the IB Theory of Knowledge course cultivate a deeper skepticism than taking six separate AP exams?"

  principles: #[
    "Depth over exam hacking: Teaching to the standardized test rubric sterilizes the intrinsic wonder of great literature and science.",
    "Equitable access: Rigorous advanced courses must be open to all curious minds, actively dismantling racial and socioeconomic tracking.",
    "Joy of inquiry: A high school research paper should feel like a thrilling voyage of discovery, not a mechanical chore."
  ]
}

^["invariants"]{
  "AP courses require annual College Board Course Audit syllabus approval.",
  "IB Diploma candidates complete all internal and external assessments across the 2-year diploma cycle.",
  "Dual enrollment credits meet regional accreditation standards (SACSCOC, NECHE, HLC) for collegiate transferability.",
}

#>wonder_sec_advanced_curricula_1
?["How does the AP exam's single-day high-stakes format compare to IB's cumulative portfolio assessment?"]{
  #:depth #!philosophical ~#lens(assessment_ecology)
  ~#hypothesis: "AP rewards rapid pattern recognition and test-taking composure; IB rewards sustained synthesis, revision, and reflective depth."
  !probe{ "Compare longitudinal college GPA performance of students entering with AP credits vs IB Diplomas across freshman year." }
  $%[freshman.retention_rate, student.deep_research_readiness]
}
