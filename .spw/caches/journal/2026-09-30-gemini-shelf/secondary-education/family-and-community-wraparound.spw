# Family & Community Wraparound Services in Secondary Education
#
# Holistic support architectures: McKinney-Vento liaisons, bilingual outreach, school-based health clinics, and restorative justice.

#>spw_cache_sec_family_wraparound
#:cache #!secondary_ed
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the holistic family engagement, basic needs support, and school-based health ecosystems that eliminate non-academic barriers to adolescent learning."
  ~#framework: "Whole School, Whole Community, Whole Child (WSCC) Model, McKinney-Vento Homeless Assistance Act"
}

^["family_engagement_and_outreach"]{
  bilingual_family_liaisons: "Dedicated staff fluent in primary community languages (Spanish, Arabic, Vietnamese, Mandarin) bridging home-school communication."
  family_empowerment_programming: #[
    "Bilingual College & FAFSA Nights: Evening sessions providing hands-on application and financial aid navigation with child care provided",
    "Mental Health & Adolescent Development Seminars: De-stigmatizing anxiety, depression, and digital wellness for immigrant and multi-generational households",
    "Parent Leadership Academies: Cultivating family advocacy in school site councils, budget oversight, and district advisory boards"
  ]
  accessible_communication_channels: #[
    "Multilingual SMS and app notifications (TalkingPoints, Remind) with automated two-way translation",
    "Flexible conference scheduling accommodating second-shift workers and non-traditional caregivers"
  ]
}

^["mckinney_vento_and_housing_stability"]{
  statutory_mandate: "McKinney-Vento Homeless Assistance Act (Title VII-B)"
  liaison_functions: .{
    role: "Dedicated District & School McKinney-Vento Homeless Liaison"
    immediate_enrollment: "Unconditional enrollment without requiring proof of residency, birth certificates, or immunization records at point of entry"
    transportation_guarantee: "Arranged busing or transit passes ensuring student remains in school of origin despite displacement"
    barrier_elimination: #[
      "Automatic waiver of all course fees, lab supplies, graduation caps/gowns, and testing fees",
      "Immediate certification for free meals under USDA federal programs"
    ]
  }[reg=facet]
  emergency_stability_resources: #[
    "On-campus hygiene closets stocked with clean clothes, toiletries, and laundry facilities",
    "Direct referral partnerships with rapid-rehousing shelters and local housing authorities"
  ]
}

^["school_based_health_and_wellness_centers"]{
  model: "Full-service School-Based Health Centers (SBHC) operated in partnership with local federally qualified health centers (FQHCs) or hospital networks."
  clinical_services: #[
    "Primary Care: Annual physicals, sports clearances, chronic condition management (asthma, diabetes, allergies)",
    "Adolescent Behavioral Health: Licensed clinical social workers (LCSW) providing on-site confidential psychotherapy",
    "Preventive Dental Clinics: Semi-annual cleanings, fluoride treatments, and dental sealants directly on school grounds",
    "Vision Screenings & Corrective Care: Mobile optometry vans providing free comprehensive exams and prescription eyeglasses"
  ]
}

^["food_security_and_material_stabilization"]{
  universal_meals: "Community Eligibility Provision (CEP) providing barrier-free, stigma-free breakfast and lunch to all enrolled students."
  community_pantries: "School-hosted dry food, fresh produce, and infant supply pantries open to families on weekends and holiday breaks."
  weekend_backpack_initiatives: "Discreet distribution of shelf-stable weekend meal kits to food-insecure households every Friday afternoon."
}

^["restorative_justice_and_crisis_deescalation"]{
  disciplinary_shift: "Transitioning from exclusionary discipline (suspensions, expulsions) to trauma-informed restorative justice circles."
  restorative_practices: #[
    "Restitution & Accountability Circles: Facilitated dialogues centering repair of harm between affected students, educators, and families",
    "Peace Rooms & Sensory De-escalation Zones: Supervised calming spaces equipped for nervous system regulation prior to classroom re-entry",
    "Multidisciplinary Behavioral Threat Assessment Teams: Early-warning support mapping rather than punitive or criminalized interventions"
  ]
}

^["taste"]{
  ~#taste: "A school cannot cultivate the mind of a student whose body is shivering with hunger or whose heart is paralyzed by domestic precarity."
  ~#wonder: "What happens when a high school ceases to be merely an instructional plant and becomes the emotional and physical anchor of an entire neighborhood?"

  principles: #[
    "Dignity first: Every material support (food, coats, hygiene) must be dispensed without shame, bureaucracy, or surveillance.",
    "Radical hospitality: Schools belong to the families whose children they serve; their doors must welcome parents as partners, not supplicants.",
    "Trauma-responsive discipline: Behind every disruptive behavior lies unmet distress; consequences must restore community rather than sever belonging."
  ]
}

^"invariants"{
  "McKinney-Vento provisions must be enacted immediately without delay for paperwork verification.",
  "Health center services strictly adhere to adolescent confidentiality laws and HIPAA/FERPA interoperability guidelines.",
  "Family outreach must be linguistically accessible in the home languages of all enrolled student populations.",
}

#>wonder_sec_family_wraparound_1
?["How does embedding comprehensive health clinics within high schools alter long-term chronic absenteeism and graduation rates?"]{
  #:depth #!sociological ~#lens(community_resilience)
  ~#hypothesis: "When students can access same-day medical, dental, and therapy visits without leaving school grounds, chronic absenteeism drops by over 30% among vulnerable demographics."
  !probe{ "Measure longitudinal attendance curves before and after SBHC installation in Title I urban and rural high schools." }
  $%[retention.attendance_delta, wellness.sbhc_access_index]
}
