# STEM & Humanities Acceleration Pathways
#
# Advanced academic sequences, lab practicums, Socratic discussion methods, and research competitions.

#>spw_cache_sec_pathways
#:cache #!secondary_ed
#:layer #!pragmatics

^"intent"{
  ~#goal: "Map the curricular pipelines enabling secondary students to reach collegiate and professional-level research mastery in STEM and the Humanities."
  ~#pedagogical_traditions: "Harkness table Socratic dialogue, university lab apprenticeships, mathematical proof acceleration"
}

^["stem_acceleration_tracks"]{
  mathematics_sequence: #[
    "Grade 8: Honors Algebra I (symbolic manipulation, quadratic functions)",
    "Grade 9: Honors Geometry & Proofs (Euclidean axiomatic deduction)",
    "Grade 10: Honors Algebra II & Trigonometry (polynomial, rational, and transcendental functions)",
    "Grade 11: AP Calculus BC (single-variable differential/integral calculus, infinite series)",
    "Grade 12: Multivariable Calculus, Linear Algebra, and Ordinary Differential Equations (ODEs)"
  ]

  sciences_and_engineering: #[
    "Laboratory Physics: Calculus-based mechanics, rotational dynamics, electromagnetism, wave optics",
    "Molecular Biology & Biochemistry: PCR gene amplification, gel electrophoresis, CRISPR Cas9 bacterial assays",
    "Computer Science & Robotics: Data structures, dynamic programming, FIRST Robotics Competition (FRC) real-time C++ control"
  ]
}

^["humanities_and_social_sciences_tracks"]{
  harkness_pedagogy: .{
    model: "Harkness Table (originating at Phillips Exeter Academy)"
    structure: "12 to 14 students seated at an oval wooden table; teacher acts as silent facilitator; students lead all text analysis."
    outcome: "Eliminates teacher-centric passive lecturing; forces every adolescent voice to articulate arguments with textual citations."
  }[reg=facet]

  humanities_sequences: #[
    "World Literature & Philosophy: Close reading of Homer, Dante, Shakespeare, Morrison, and Dostoevsky",
    "Constitutional Law & Civic Competitions: 'We the People: The Citizen and the Constitution' mock congressional hearings",
    "Policy Debate (Cross-Examination Debate Association): High-speed evidence research, affirmative plans, counterplans, and kritiks"
  ]
}

^["independent_scientific_and_humanistic_research"]{
  competitions: #[
    "Regeneron Science Talent Search (STS) & International Science and Engineering Fair (ISEF)",
    "National History Day (NHD): Year-long archival documentary, exhibit, or scholarly monograph based on primary historical sources",
    "Scholastic Art & Writing Awards: National portfolio adjudications"
  ]
  university_mentorship: "High schools partner with regional medical centers and engineering labs to provide biosafety hood access."
}

^["taste"]{
  ~#taste: "True acceleration is not moving through a textbook faster; it is dwelling more deeply in foundational mysteries."
  ~#wonder: "Why does sitting around an oval Harkness table make teenagers speak with the maturity of university fellows?"

  principles: #[
    "Proofs over recipes: In mathematics, deriving why the Pythagorean theorem holds is infinitely superior to plugging numbers into formulas.",
    "Textual reverence: In literature, arguing from exact sentences on the page cures ideological hand-waving.",
    "Humility in science: Running an experiment where the hypothesis is violently disproven teaches more than a hundred textbook demonstrations."
  ]
}

^["invariants"]{
  "Accelerated courses require mastery demonstrations, not mere chronological age gating.",
  "Laboratory safety protocols comply fully with OSHA and university-tier biosafety level (BSL-1/2) rules.",
  "Discussion seminars require equitable turn-taking without dominant voices silencing peers.",
}

#>wonder_sec_pathways_1
?["How does early mastery of mathematical proof alter an adolescent's capacity for civic reasoning?"]{
  #:depth #!philosophical ~#lens(deductive_formation)
  ~#hypothesis: "A student trained to demand rigorous proof for geometric assertions develops immunity against emotional sophistry and demagoguery in public debate."
  !probe{ "Track performance in critical policy debate and argumentative essay writing among students with formal proof training vs purely computational math training." }
  $%[argument.logical_fallacy_avoidance_score, student.dialectic_clarity]
}
