# Water: The Universal Matrix Cache
#
# Hydrogen bonding thermodynamics, density anomaly, hydraulic civilizations, steam revolution, and sanitation history.

#>spw_cache_mat_water
#:cache #!water_the_universal_matrix
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the anomalous physical chemistry of water, hydrogen-bonding networks, thermodynamic steam cycles, hydraulic civilizations, and the sanitation revolution."
  ~#protocol: "cache.layer/1"
}

^"molecular_physics_and_anomalous_thermodynamics"{
  "hydrogen_bonding_and_tetrahedral_geometry": .{
    molecular_geometry_and_dipole: "Bent C_2v molecular symmetry (sp3 hybridization); 104.5 degree bond angle compressed by two non-bonding lone pairs; permanent molecular dipole moment mu = 1.85 Debye",
    transient_hydrogen_bond_network: "Each water molecule acts as dual hydrogen bond donor and acceptor, forming fluctuating tetrahedral networks with picosecond bond lifetime (~1-2 ps); hydrogen bond enthalpy ~20 kJ/mol",
    high_specific_heat_and_latent_enthalpy: "Exceptional isobaric heat capacity C_p = 4.184 J/(g*K) acting as Earth's primary climatic heat buffer; standard enthalpy of vaporization Delta H_vap = 40.65 kJ/mol driving global meteorological convective hydrologic cycles",
  }[reg=facet],
  "density_anomaly_and_universal_solvation": .{
    density_inversion_at_four_degrees: "Maximum density occurs at 3.98 C; hexagonal ice (Ice I_h) forms an open, hollow cage-like crystalline lattice with lower density (0.917 g/cm^3) than liquid water (1.000 g/cm^3), ensuring ice floats to insulate benthic aquatic life",
    dielectric_screening_and_solvation: "Ultra-high static relative permittivity (dielectric constant epsilon_r ~ 80 at 20 C); Coulombic attraction between ions screened by factor of 80 (F = q_1*q_2 / (4*pi*epsilon_0*epsilon_r*r^2)), enabling spontaneous dissolution and hydration of ionic salts",
    the_hydrophobic_effect: "Non-polar solutes disrupt water's tetrahedral network, forcing water into entropic ice-like clathrate cages; spontaneous thermodynamic aggregation of non-polar molecules minimizes water order, driving lipid bilayer assembly and protein tertiary folding",
  }[reg=facet],
}

^"industrial_applications_and_power_cycles"{
  "steam_power_and_fluid_mechanics": .{
    rankine_thermodynamic_cycle: "High latent heat exploited in Rankine steam cycles powering nuclear, coal, and concentrated solar power plants; phase change from liquid to high-pressure superheated steam driving multi-stage turbines",
    hydroelectric_and_hydraulic_power: "Bernoulli energy equation and Navier-Stokes continuum dynamics in Pelton impulse, Francis reaction, and Kaplan axial-flow hydro-turbines; hydraulic presses leveraging Pascal's principle",
    membrane_desalination: "Thin-film composite polyamide reverse osmosis (RO) membranes operating at 60-80 bar hydraulic pressure to overcome seawater osmotic pressure (~27 bar), producing potable water globally",
  }[reg=facet],
}

^"world_history_and_civilizational_transformations"{
  "hydraulic_civilizations_and_maritime_empires": .{
    wittfogel_hydraulic_hypothesis: "Karl Wittfogel: early state centralization, bureaucratic administration, and despotic authority emerged directly from the logistical imperative to coordinate mass canal irrigation and flood defenses (Nile in Egypt, Tigris-Euphrates in Sumer, Indus Valley at Mohenjo-Daro, and China's Grand Canal)",
    monsoon_trade_and_the_age_of_sail: "Predictable seasonal reversal of Indian Ocean monsoon winds governing oceanic trade circuits between Arabia, India, and Southeast Asia; European caravel ocean navigation triggering the globalized colonial age",
  }[reg=facet],
  "the_steam_and_sanitation_revolutions": .{
    the_steam_engine_unshackling: "Thomas Newcomen (1712) pumping water from flooded coal mines; James Watt's separate condenser (1769) converting heat into continuous rotary mechanical power, freeing industrial manufacturing from riverbanks and birthing the Industrial Revolution",
    john_snow_and_the_great_stink: "John Snow's 1854 Broad Street cholera mapping establishing waterborne pathogen transmission over miasma theory; Joseph Bazalgette designing London's Victorian intercepting sewer network (1865); widespread municipal sand filtration and chlorine disinfection doubling human life expectancy in the 20th century",
    twenty_first_century_hydropolitics: "Geopolitical conflict over transboundary river systems (Nile Grand Ethiopian Renaissance Dam, Tigris-Euphrates damming, Indus Water Treaty) and catastrophic depletion of ancient fossil aquifers (Ogallala, North China Plain)",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_mat_water_1
  ?["Why would life on Earth be physically impossible if water's solid ice phase were denser than its liquid phase, like almost every other substance in the universe?"]{
    #:depth #!astronomy ~#lens(the_density_inversion_and_planetary_freezing)
    ~#hypothesis: "In almost all substances, molecules pack closer in the crystalline solid than in the liquid. If ice were denser than liquid water, surface ice formed during winter would sink to the ocean and lake bottoms, shielded from summer sunlight. Over millennia, the world's oceans would freeze solid from the bottom up, extinguishing marine ecosystems and plunging Earth into an irreversible runaway Snowball planet."
    !probe{ "Simulate planetary ocean thermal stratification and runaway glaciations under a hypothetical physics model where ice density exceeds liquid water by 5%." }
    $%[planetary.runaway_glaciation_years, ocean.benthic_ice_accumulation_rate_km3_yr]
  }
}
