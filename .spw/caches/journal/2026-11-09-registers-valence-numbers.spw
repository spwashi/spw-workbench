# Registers, valence and numbers — 2026-11-09
#
# Receipts for two changes the owner put first, and a table of how number and math forms read today.
# The owner asked to make better use of register stamps, to fix the valence concept, and to consider more complex number forms and dense mathematical syntax.

#>journal_2026_11_09_registers_valence_numbers
#:cache #!observation
#:layer #!syntax

^["entry"]{
 date: "2026-11-09"
 kind: #observation
 base: "main@4ec18f3a with the working tree of the same day; the site consumer and a second mounted consumer at their working trees"
 method: "parse over every tracked surface before and after the valence change, compared file by file; readRegisterStamps over every surface; lex and parse over 42 number and math forms"
 limits: "a prose fallback is counted per surface, not per line; the census reads stamps written [reg=name] against a bracket, and counts a stamp that follows anything else as detached"
}

^["valence"]{
 # What changed: a valence word before a colon is a key, and inside a hyphenated name it is part of the name. Everywhere a charge could stand, it still does.
 concept: "A valence word is a charge sign in two places: leading a noun (boon home[x]) and after an operator (*boon{…}). Anywhere else it is a word. The grammar already called the leading chain a charge sign; this makes the rest of it agree."
 before: .{ here: "9 of 1,083 surfaces fall back to prose", site_consumer: "13 of 630", second_consumer: "17 of 143" }
 after: .{ here: "8 of 1,083", site_consumer: "10 of 630", second_consumer: "9 of 143" }
 worse: "no surface in any corpus reads worse, and error counts are unchanged (264, 2 and 701)"
 healed_here: "one plan artifact whose tradeoffs frame keyed rows by valence word"
 healed_second: "eight surfaces: a chapter mirror, the precipitates ladder, the workspace and its story, and four other canon surfaces"
 touched: "valence keys: 12 lines here, 12 in the site consumer, 50 in the second; hyphenated valence names outside strings: 5 here"
 tests: "25 new cases beside the grammar; seed 1,013 tests, runtime 126 and CLI 400 pass; the language server suite keeps its one earlier failure"
 still_open: "a lone valence word as a whole value ([honk]) stays a charge with no noun, by design; whether the five words are grammar or a loaded vocabulary stays wonder_trial_valence_word"
}

^["registers"]{
 # What a stamp does today, and what the census found.
 today: "A source stamp is read by nothing. The parser reads [reg=facet] as two parameters, a word reg and a lean toward facet. The normal form keeps the stamp as an attachment beside a node whose own register it derives from the bracket. The runtime reads the derived register and never the stamp. One editor hover described every stamp as a flag for hooks that do not exist."
 here: .{ surfaces: 1336, stamped: 181, stamps: 825, restating: 797, informing: 28, characters_restating: 8627 }
 site_consumer: .{ surfaces: 886, stamped: 801, stamps: 12387, restating: 12151, informing: 236, characters_restating: 123947 }
 second_consumer: .{ surfaces: 136, stamps: 0 }
 informing_here: "pipeline 16, quality 3, stream 3, and six others once each"
 informing_site: "list 111, stream 63, set 56, facet 3, map 3: every one a shape word written against a different bracket"
 reading: "The register socket is empty. Across 13,212 stamps none names a voice, an authority, a phase or an audience; 98% repeat the bracket and the rest correct it. Whatever a register comes to mean, the stamp is free to carry it."
 built: "seed reads stamps (register.stamp/1): each against its bracket, restating or informing, with its span; a census script counts them; the hover now says which kind a stamp is; a function removes restating stamps and no other byte"
 not_done: "no stamp was removed anywhere, and no register was given a meaning"
}

^["numbers"]{
 # How forms lex and parse today. One token kind carries a number: digits with an optional decimal part.
 reads_whole: ["42", "0.13", "1/3 as two numbers and a connector", "0.04..0.4 as a range", "0.13 of 0.04..0.4", "48<hours>", "v[1 0 0] and v[1, 0, 0]", "m{ 1 0 0; 0 1 0; 0 0 1 }", "f(x)", "sum[i=1..n]{ x_i }", "f: A -> B", "a + b as one expression"]
 splits_silently: ["1e-3 into 1 and a name e-3", "6.02e23 into 6.02 and e23", "0xff into 0 and xff", "1_000_000 into 1 and _000_000", "7s, 16px and 220hz into a number and a name", "50% into 50 and the % mark", "16:9 and 17:22 into a number, a colon and a number", "0.3.0 into 0.3, a dot and 0"]
 errors: ["-4 loses its sign with one error", "2026-11-26 is three numbers and two errors", "0.13 ± 0.02 loses the sign with one error", "x ∈ S loses the symbol with one error"]
 falls_to_prose: ["+4", "a half-open interval [0, 1)", "a < b", "a <= b", "π", "∞"]
 math_as_marks: "a^2 is three expressions, a * b two, a ~ b two, and a^2 + b^2 = c^2 eight: the marks Spw uses for roles are the ones arithmetic uses for operations"
 reading: "Structure for mathematics is already here: a gap gives a vector, a semicolon a matrix, a range its bounds, a frame an index. What is missing is the number itself (a sign, an exponent, a unit, a date) and a place where ^ * ~ = < mean arithmetic."
}

^["follows"]{
 theory: ~"../../../docs/theory/spw/depiction-frames.spw"
 proposals: ~"../../../.agents/plans/syntax-hardware-alignment/syntax-hardware-alignment.spw"
 trials: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw"
}
