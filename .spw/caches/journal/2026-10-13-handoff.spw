# Handoff 2026-10-13
#
# Where the next agent picks up after the caches split into a living tree and a journal.

#>journal_2026_10_13_handoff
#:layer #!pragmatics

^["entry"]{
 date: "2026-10-13"
 kind: #handoff
 supersedes: ~"./2026-09-30-handoff.spw#spw_cache_resume_2026_09_30"
}

^["start_here"]{
 root: ~"../index.spw#caches_root"
 door: ~"../extend.spw#caches_extend"
}

^["state"]{
 tree: "437 surfaces at .spw/caches/tree; the cut gate passes with 0 failing and 19 size warnings"
 journal: "the gemini shelf of 2026-09-30, the 2026 Q4 season run, the snapshot of 2026-10-13, and two handoff notes"
 tag: "caches-cut/2026.09.30 holds the dated cut and the raw shelf as they stood before the split"
 review: "a fact_checked receipt records an adversarial agent check, not expert review; a surface without one is unreviewed"
 planned_panels: "concept-lattice, computed-kin, and facet-census are named as planned, not linked, until the apparatus writes them"
}

^["next"]{
 living_tree: "plan caches-living-tree: syntax samples p8 to p11 for the owner, then closed concepts, receipts to journal ledgers, a lean card, and @tree#anchor refs"
 cut: "plan caches-cut-2026-09-30: the weave, the apparatus panels, and the harm sweep, on the new paths"
}

^["still_holds"]{
 frames: "the direction, consumer_integration, and falsify frames of the 2026-09-30 note still hold"
 superseded: "its this_revision and not_in_this_revision frames describe the layout before the split; this entry replaces them"
}
