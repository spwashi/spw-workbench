# Play and reach — 2026-11-10
#
# What makes Spw pleasant to write in a story consumer, what theory two hosts can reach from a line, which assumptions the hosts rely on and no surface states, where the language feels like play, and which syntax a game would want.
# The owner asked for this reading alongside a pass to make the language more pleasant for a second mounted consumer.

#>journal_2026_11_10_play_and_reach
#:cache #!observation
#:layer #!pragmatics

^["entry"]{
 date: "2026-11-10"
 kind: #observation
 base: "main@be2df2ff with the day's parser changes in the working tree, since landed as 7b8e2250; the site consumer's working tree and a second mounted consumer's head of the same day, read only"
 method: "every surface parsed twice, by the parser at HEAD and the working tree, and compared file by file; forms read through the parser and readLine; host claims read in the host's code or plans and spot-checked at their lines"
 limits: "the canvas app clone is gitignored and had local changes, so its claims describe a working tree and not a deployment; a search that found no statement of an assumption is a limited search; nobody has played anything on this pass"
}

^["receipt"]{
 # Surfaces falling back to prose, before and after. Read differently counts surfaces whole on both sides whose trees differ.
 story_consumer: .{ surfaces: 85, prose_before: 11, prose_after: 0, errors_before: 0, errors_after: 0, worse: 0, read_differently: 0 }
 site_consumer: .{ surfaces: 483, prose_before: 18, prose_after: 18, errors_before: 0, errors_after: 0, worse: 0, read_differently: 0 }
 workbench: .{ surfaces: 1212, prose_before: 45, prose_after: 45, errors_before: 31, errors_after: 31, worse: 0, read_differently: 0 }
 caught_by_the_receipt: "the first version made a mid-line ?<a>[x] an operation on four site surfaces, where it had been a medial capsule; the named block now applies only where a line starts, and those four read as they did"
 caught_by_a_probe: "the first version let prose text stand in any body, which took the workbench from 45 to 36 and the site to 17, but ^x{ a: café } then read a as caf with a stray letter beside it; a fallback count called that healed; prose text now stands only in a capsule-led block, and those ten surfaces stop again, each with its place named"
 healed_checked: "every column-0 opener in the 11 healed surfaces starts a top-level expression"
 letters: "the plan named eight punctuation marks; non-ASCII letters are an extension made here, and without them the story consumer is 11 to 1, the last being an accented proper name in a rationale block"
 site_remainder: "10 of the site's 18 stop at a bare + in a value, now named by line and column; that is the next cause there, and it is not decided here"
 parse_cost: "unchanged on the story consumer's rules file, about 670 ms either way under load"
}

^["what_changed"]{
 stop: "a fallback now says where it stopped: the token nothing could take, its line and column, the form it fell back from, and at the end of a surface the bracket still owed; it is on the warning and on completeness.stop"
 named_block: "?\"name\"[ and #\"name\"{ read as a subject with a real frame or body, across lines or on one; at the start of a line so do ?<name>[ and #<name>{; a block that cannot read gives its name back to the line payload"
 prose_text: "inside a capsule-led block such as ~<rationale>{ }, under the prose profile, sentence punctuation and non-ASCII letters read as prose: the maker's, an em dash, a middle dot, an ellipsis, Poincaré"
 held_back: "any other body is a record and stays strict, so ^x{ a: café } and =tune{ =aim_step[0.13]’ } stop; a frame holds values only; a bare minus, a plus and an emoji stop; a name stays ASCII, so ^café{ stops"
}

^["theory_reach"]{
 # What each host can get to from a line today.
 quest: "the first steps are copied verbatim from docs/learn/quest.spw and held by a test; the operator words in guide.js are hand-written, were rewritten in f03d1b36, and answer.js and the canvas operators.ts still carry the older words; physics.js cites depiction-frames, and the rest of the theory notebooks have no route in"
 canvas: "a search of the app found no link to any theory surface; exits go to /build and the parser; its plan says ideally Spw navigates between its frames, with #> entering and . returning unbuilt"
 proposed: "^proposed_routes below is a first table from what a reader hands a host to where it could go; neither host reads it, and whether a link should arrive at a door, a notebook or an open question is for each host to try"
}

^["proposed_routes"]{
 # A proposal, kept here until a host tries it. Keys are the reader names seed gives; only targets opened on this pass are listed. If a host keeps it, its home is the doors index, reviewed like the doors.
 every_mark_and_pair: .{ theory: ~"../../../docs/theory/spw/operators.spw", says: "the reader names, the containers, and what the runtime does with each mark" }
 perspective: .{ door: ~"../tree/spw/doors/at.spw#spw_door_at", theory: ~"../../../docs/theory/spw/threshold-distance.spw", open: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_observer_postfix" }
 wonder: .{ theory: ~"../../../docs/theory/spw/wonder-field.spw" }
 potential: .{ open: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_prime_actualize" }
 action: .{ open: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_prime_actualize" }
 measure: .{ open: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_number_forms" }
 value: .{ open: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_typed_hole" }
 mode: .{ open: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_register" }
 line: .{ open: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_line_reach" }
 held: .{ theory: ~"../../../docs/theory/spw/threshold-distance.spw" }
 turn: .{ theory: ~"../../../docs/theory/spw/exhibit-floor.spw", open: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_turn" }
 stop: .{ open: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_quiet_fallback" }
}

^["assumptions"]{
 # Relied on by a host; no surface was found stating it. Each row is also on the trial card named.
 line: .{ quest: "a row between newlines", canvas: "a top-level statement, where a newline inside { } reads as a semicolon", card: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_line_reach" }
 which_side_looks: .{ left: "spw.quest: gardener @ garden is the garden as the gardener sees it", right: "the runtime table, and a second consumer's ~{warm_furrow}@boof", card: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_observer_postfix" }
 second_touch: .{ hosts: "a tap primes and a second writes", runtime: "!~x comes back still wrapped, so ! does not take what ~ holds", card: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_prime_actualize" }
 dot: .{ quest: "one name", canvas: "parts whose order is meaning", card: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_dot" }
 order: .{ quest: "a comma says nothing about order", canvas: "agrees, yet its ring starts at the first written", card: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_slot_order" }
 slots: .{ seed: "five", canvas: "adds charge and rest", quest_pivot: "adds charge and join", quest_build: "adds a mark", card: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_intermediate_forms" }
 held: .{ canvas: "the one line on the canvas", canvas_plans: "a stage between primed and actualized", quest: "the line under the caret", card: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_centre" }
}

^["fun"]{
 # Where authors say it is play, and what they are doing when they say so.
 a_toy_first: "a second consumer: a notation becomes a toy before it becomes a tool when every part of it answers a touch; a spell lights by role, plays as music, and its numbers turn like dials"
 played: "the canvas plans: factshift.center is where the language is played"
 by_hand: "the site's caches: authors write flat labels, and nesting happens in play; the hand learns by moving one body"
 stays_open: "the site's caches: generative play stays in ~ and ?"
 reading: "the fun clusters on four things: one change that answers at once, a mark felt as a body's law, nesting by hand, and a line that can be carried away; none of them needs a new mark"
}

^["gameplay_syntax"]{
 # Ordered by how little must be decided. Reads today means the parser takes it whole now.
 turn: .{ form: "~map[mode]{ care ~> rest }", state: "reads today, and readLine reads it as a word, a mode and two parts; the canvas still parses casts by regular expression, so what is missing is the kit and not syntax", card: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw#wonder_trial_turn" }
 dial: .{ form: "=dial[~]{ %range[0..3] }", state: "reads today, so ranges can move from script into canon by convention alone" }
 rule_line: .{ form: "^way{ !aside[7, 9] =apart[two_pies] }", state: "reads today in the parser; readLine leaves the second clause unread, which is the gap trial" }
 brief: .{ form: "^x{ a: _ }", state: "reads today; a hole a player or a model fills" }
 signed_number: .{ form: "%delay[-4]", state: "still stops, one owner decision away (wonder_trial_number_forms); the smallest change with the most direct use in a game" }
 observer: .{ form: "~{warm_furrow}@boof", state: "two expressions in the parser and one compound in readLine; which side looks has to be settled first (wonder_trial_observer_postfix)" }
 open_body: .{ form: "a body left open at a line end, on purpose", state: "a dropped brace now names its bracket, so a marked open body would no longer be the only way to learn one is open" }
}

^["next"]{
 # Each is one step, for whoever picks it up.
 owner: "decide %delay[-4], then which side of @ looks; the rest of this entry waits on nothing"
 host: "after a pin bump, the second consumer can lift its two authoring rules (never quote a ? or # name, no apostrophes in a prose body), since both forms read"
 kit: "line-kit slot_edits would let the canvas drop its cast regular expression and its _{body} wrapper"
}
