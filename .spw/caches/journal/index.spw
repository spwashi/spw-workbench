# Caches Journal
#
# Dated, append-only entries: what was seen or made on a day. The living tree beside it is kept true; nothing here is edited after its day.

#>caches_journal
#:layer #!pragmatics

^"intent"{
 ~#goal: "Give every dated record in the caches one home, so the tree can stay current and cite its history instead of carrying it."
 ~#taste: "append-only: a later entry corrects an earlier one, it never rewrites it"
}

^["contract"]{
 placement: "an entry records what was seen or made on a day; a surface someone should keep true belongs in the tree instead"
 naming: "YYYY-MM-DD-slug.spw for one file, YYYY-MM-DD-slug/ for an entry of several files; the date is the day the entry records"
 anchor: "the first code line of a new entry is #>journal_YYYY_MM_DD_slug; anchors are unique across the journal"
 entry: "an ^[entry] frame follows the axis lines with date, kind, and an optional supersedes edge to the entry it corrects"
 kinds: #[ generation, instance, observation, receipts, snapshot, resume, decision ]
 append_only: "an entry is not edited after its day, except to fix a path the journal itself moved"
 moved_in: "entries that arrived whole, such as the 2026-09-30 resume note and the gemini shelf, keep their original anchors and shape"
 growth: "flat until a year passes about a hundred entries, then one folder per year"
}

^["kinds"]{
 generation: "a body of generated material as it arrived"
 instance: "one dated run of a recurring form kept in the tree"
 observation: "what a source said when it was read, so a tree claim can cite the reading instead of restating its date"
 receipts: "inspection rows for one pass, grouped by event, date, agent, care, and outcome, with the files each row covers"
 snapshot: "a git tag over the caches, its commit, the counts, and the gate result"
 resume: "where to pick up after a mount or a session limit"
 decision: "an owner decision with its date, so plans and surfaces can cite it instead of restating it"
}

^["entries"]{
 resume_2026_09_30: ~"./2026-09-30-resume.spw"
 snapshot_2026_10_13: ~"./2026-10-13-cut-snapshot.spw"
}
