# Extension sockets — 2026-11-08
#
# Which language features give a plugin, library or framework a place to attach without rewriting the grammar,
# read beside four hosts' asks and the owner's public repositories. Each opportunity names its socket, its
# lineage, what must be decided first, and the friend test it should pass.

#>journal_2026_11_08_extension_sockets
#:cache #!observation
#:layer #!pragmatics

^["entry"]{
 date: "2026-11-08"
 kind: #observation
 base: "main@f8392a0a; the owner's public repositories read by description only on 2026-11-08; host asks as routed in ask-exchange the same day"
}

^["thread"]{
 # The one finding the ideas share.
 claim: "Spw's readers have been rewritten more often than extended: a college project that became a language (2017), a client (2020), an editor and a library for creating languages (2021), a grammar, parser and runtime for JavaScript (2024), a web parser (2025), and this workbench (2026). The four hosts still carry readers of their own: six in one story site, four copies of one codec, a canvas reader on a March workbench copy."
 owner_rewrites: "The owner, 2026-11-08: the time spent writing and rewriting a PHP framework from scratch before discovering GitHub."
 owner_hackathon: "The owner, 2026-11-08: the difficulty of making that framework suddenly learnable and navigable for a hackathon with a friend."
 owner_instrument: "The owner, 2026-11-08: the PHP framework was valuable because it traced the contours of what they anticipated fluency would need; it was a keyboard or synthesizer of fluency while the ideals of expression had not yet met the demands of business synchronicity."
 lesson: "The rewrites were an instrument, and Spw's rewrites read the same way: each one practised a fluency before anyone else needed it. What changes now is that others need to play the instrument, under deadline and in time with business. A socket lets the next player start where the last one stopped, and a socket that ships with its doorway and examples is learnable before a hackathon asks for it."
}

^["stance"]{
 # Magic, made inspectable.
 owner: "The owner, 2026-11-08: appreciated PHP's magic but wanted it more inspectable, so was cautious of Laravel, before coming to appreciate Symfony around 2017 to 2019."
 claim: "Spw's operators are magic of the same kind: one character carries a role. The sockets should be magic you can inspect, which is the shape Symfony took."
 components: "Symfony ships components usable alone, and other frameworks, Laravel among them, are built on them; the components outlived the frameworks that assembled them. The line kit and the codec are Spw's components, and a framework here is only an assembly of sockets."
 bundles: "a bundle declares what it registers; a Spw plugin declares what it selects and which reader reads each field it writes, and fails closed when either is missing"
 debug_verbs: "the container can be dumped and every route listed; each socket gets a verb that dumps what is wired (which vocabularies are loaded, which registers are stamped and who reads them, which plugins select what), toward cli-sense-reorientation ?[task_verbs]"
 profiler: "a profiler shows one request through every layer; host-receipts editor_diff and the stages card show one line through every reading"
 quiet_magic: "silent prose fallback is the magic to retire: wonder_trial_quiet_fallback's marked reading is the inspectable one"
}

^["sockets"]{
 # Places to attach without changing the grammar. Each has a contract, demand from a host, and what must be decided first.
 line: .{ contract: "line.*/1: read, query, edit, wrap and describe a line, each edit byte-preserving", demand: "spw.quest and factshift.center rebuild slot edits; one codec is written four times; a story site runs six readers", decide: "line-kit kit_laws and ?[query_match]" }
 vocabulary: .{ contract: "words given meaning after the parse and loaded by name, so the grammar knows only marks and containers", demand: "valence words degrade six story surfaces; families written as sigils on a map; three readings of the pentad", decide: "wonder_trial_valence_word" }
 register: .{ contract: "what a frame is for and how it is read, stamped only where the brackets cannot say it", demand: "6,719 of 6,890 site stamps restate shape, while defer, hole, proj, pipeline and hydrate say more", decide: "wonder_trial_register" }
 plugin: .{ contract: "a .spw plugin selects, emits, and fails closed when a selector matches nothing or a field it writes has no reader", demand: "the site's plugin asks, ranks 1 to 17; header lenses no tool reads", decide: "first-plugin ?[first_plugin]" }
}

^["opportunities"]{
 # kind, what it is, sockets, lineage in the owner's repositories, readiness, who outside the four hosts would use it.
 o1_line_library: .{ kind: #library, what: "seed's line kit as a package any app imports, so people type lines the app can read, query and edit", sockets: [#line], lineage: "a library for creating languages in TypeScript (2021), the web parser (2025)", readiness: "closest: the slot reader landed (3f53adf2) and parser-releases cuts browser builds", outside: "apps where people type tags, briefs or prompts" }
 o2_share_codec: .{ kind: #library, what: "#spw64= share links and slot hashes: a line carried byte for byte in an address, laid out and colored by its hash", sockets: [#line], lineage: "spw.quest and factshift.center", readiness: "four host copies of the codec; slotHash in seed with no written form", outside: "any interactive page that keeps its state in a URL" }
 o3_reading_extension: .{ kind: #plugin, what: "a browser extension: hold a phrase on any page, it becomes a line in a cauldron, and the line carries to a canvas", sockets: [#line, #register], lineage: "a Chrome extension for boon.land (2022)", readiness: "the site's cauldron and hold timing exist; needs the kit in a reader build", outside: "readers and students: the attention instrument outside the owner's sites" }
 o4_prose_bracework: .{ kind: #plugin, what: "a markdown and notes plugin that reads bracework in prose ({frost & hearth}) with glosses, as a story site does in its book", sockets: [#line, #vocabulary], lineage: "a NextJS blog (2021); obsidian-spw, dormant", readiness: "needs prose_typography and the vocabulary socket", outside: "docs sites, fiction, personal notes" }
 o5_record_library: .{ kind: #library, what: "records whose register says their voice and authority and whose schema is pinned, generating types and validation", sockets: [#register, #vocabulary], lineage: "a backend JS library for configuring business entity prototypes and a PHP framework with SQL generation (2018 to 2019)", readiness: "needs the register and clause_authority trials; generated types are a settled preference", outside: "configuration and content schemas" }
 o6_audit_spells: .{ kind: #framework, what: "state with provenance a reader can recompute and agree with: chosen, measured, derived, pinned and checked clauses", sockets: [#register, #line], lineage: "a story site's projection spell and planned folio value", readiness: "needs the comparison, observer_postfix and clause_authority trials", outside: "pricing, scoring and briefs a client can recompute" }
 o7_interaction_contracts: .{ kind: #framework, what: "components declare gesture contracts as lines (hold[prime]{cauldron}); the framework checks one answer per touch and shows primed and actualized states", sockets: [#line, #register], lineage: "React utility hooks and a React and D3 force-simulation boilerplate (2021)", readiness: "needs wonder_trial_prime_actualize; the site holds 545 contracts as free text", outside: "design systems" }
 o8_field_renderer: .{ kind: #library, what: "a line drawn as a field of pulls and pushes and edited byte for byte", sockets: [#line], lineage: "the React and D3 force-simulation boilerplate (2021), factshift.center", readiness: "factshift.center runs it on a March workbench copy", outside: "diagramming and teaching" }
 o9_contrast_curriculum: .{ kind: #framework, what: "lessons as lines that differ in one slot, wonders with probes, holes a learner fills, and emit packs that prompt the next line", sockets: [#line, #plugin], lineage: "the profile's bio (learning how to learn how to teach how to learn how to learn) and the 2017 Learning-from-Text origin", readiness: "/forms/, trial cards and emit holes exist", outside: "teachers and courses: the philosophical instrument" }
}

^["friend_test"]{
 # The hackathon lesson as an acceptance test: learnability is built in, not added under deadline.
 rule: "A socket is ready when a friend can build something with it in one afternoon from its doorway alone: one page, three examples that differ in one place, and a starter that fails loudly."
 doorway: "each socket's page answers what it is, the smallest working example, and where it fails, before any reference"
 examples: "the examples are the socket's own fixtures and specimens, so tests and teaching cannot drift apart"
 starter: "a starter plugin, vocabulary or record that runs, plus one that fails closed with its reason named"
 rubric: "self-determination as the check: can a friend act alone (autonomy), succeed (competence), and build it with someone else (relatedness)? docs/theory/spw/exhibit-floor.spw ^learners"
 receipt: "host-receipts docs_diff shows a doorway example whose reading changed, so a doorway never teaches a reading the parser stopped giving"
}

^["order"]{
 claim: "Build a socket before anything that plugs into it."
 first: "o1 and o2 ship from line-kit and parser-releases with no new grammar, and each passes the friend test before release"
 then: "o3 and o9 make the attention instrument, and they come most directly from the owner's own lineage"
 later: "o5, o6 and o7 each wait on two sockets and on the register, authority, comparison and prime_actualize trials"
}

^["held"]{
 # Not decided here.
 names: "package and product names"
 pricing: "whether any of these is sold, and how"
 choice: "which opportunity is built first is the owner's call; the order above is a dependency order, not a priority"
}
