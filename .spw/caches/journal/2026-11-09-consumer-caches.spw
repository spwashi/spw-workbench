# Consumer caches — 2026-11-09
#
# What two mounted consumers wrote down in November, read as ground for future exploration here:
# the claims worth keeping, which of their findings reproduce on this repo's main, and where each lead starts.
# The owner asked to integrate the other caches, mind theory, and expand wonder or ground exploration with caches.

#>journal_2026_11_09_consumer_caches
#:cache #!observation
#:layer #!pragmatics

^["entry"]{
 date: "2026-11-09"
 kind: #observation
 base: "main@4ec18f3a; the site consumer's working tree of the same day, including two caches not yet committed there; a second mounted consumer at its head of the same day, pinned to edbc5500"
 method: "each cache read for its stated claims, gates and wonders; findings that name seed re-run in a minimal form with parse and readLine; counts in this repo by script"
 limits: "the site's caches are its own and may change before they are committed; a minimal form is not the consumer's file, so a finding that does not reproduce here may still hold there"
}

^["thread"]{
 claim: "The consumers' November caches already hold a theory, and one of them says so: a session should pick one channel, carry its owner to one thing a friend could use, and refuse another survey. This entry is the map that lets the next session do that from here."
 direction: "Each lead below names where it came from, what was checked today, and the first probe. Nothing here is a plan until a probe says two places must change together."
}

^["channels"]{
 # The six channels the site's briefing names, with what its caches hold and where this repo meets each.
 wonder: .{ holds: "a wonder is one seat, one probe someone can run, and three outcomes; a question denotes the set of its resolutions, so $% is that set, ~#expect a guess over it, ~#answer a member, ~#retired a withdrawal", gate: "do not answer one in passing", here: ~"../../../docs/theory/spw/wonder-field.spw" }
 syntax: .{ holds: "a brace as written, a mark as its body's law, a line as a molecule; two particles compose when the line that writes both still reads", gate: "one canvas effect writes back as a line two readers accept", here: ~"../../../.agents/plans/syntax-hardware-alignment/wip.spw" }
 runtime: .{ holds: "the runtime is a small computer a learner can watch: a scheduler, a memory hierarchy, several clocks, an effect system; three hosts keep warmth on three timescales", gate: "name the machine part before adding a mnemonic", here: ~"../../../docs/theory/spw/threshold-distance.spw" }
 media: .{ holds: "digital and material meet when a line can be printed, worn or reset on a floor and still read; a mark picks a voice and a material", gate: "a mapping that cannot be written back as a line has left the language", here: ~"../../../docs/theory/spw/exhibit-floor.spw" }
 product: .{ holds: "a stage counts only when the next can read it again as Spw; a library with a doorway outranks a new mark; a socket before anything that plugs into it", gate: "one socket with a doorway, three examples and a starter that fails loudly, tried by a friend in an afternoon", here: ~"../../../.agents/plans/line-kit/wip.spw" }
 address: .{ holds: "the plugin surface a friend meets is the address, and an address has five seats: path, query, fragment, Accept, method", gate: "one host, one seat, one probe", here: ~"../../../.agents/plans/first-plugin/wip.spw" }
}

^["claims_kept"]{
 # Claims from the caches that this repo can test or build on. Each is the consumer's; the test is ours.
 rest_touch_keep: "an ephemeral design returns the floor to rest, answers a touch once where it is seen, and lets the visitor keep one line; the floor keeps no trace the visitor did not ask to keep"
 useful_change: "a notation is useful when one change answers once, answers the same way next time, and can be undone"
 next_reads_it: "a product precipitates in stages, and a stage counts only when the next one can read it again as Spw"
 pipes_keep_marks: "a pipe between plugins should carry Spw frames and project to another format only at the last step, since an intermediate format drops marks, brace kinds and source lines"
 legal_neighbors: "the full product of marks, containers, slots, clocks and materials is almost all uninhabited, and wonder lives in a few legal neighbors of a line that already reads"
 next_mark_visible: "a language is interesting to learn when the next legal mark is visible and the field answers in the same gesture; more glyphs delay the answer"
 shared_ground: "the least general form two lines both fit is the ground they share, and each hole it needs is a place they part"
 one_wonder_wide: "a plan is one wonder until a probe shows two hosts must change the same seat in one patch"
 spell_meaning_use: "a thing shows its spell always, its meaning once stood on, its use once a loop is walked"
 leaned_on: "a language earns trust by being leaned on: when a parser and a small reader agree and every rule survives a round trip, the grammar is carrying weight"
}

^["reproduced"]{
 # A second consumer's stress findings, each re-run on main in a minimal form. Its pin holds the same parser as main.
 quiet_prose_fallback: .{ holds: #yes, seen: "a dropped closing brace returns success true with complete false and a prose fallback, one warning" }
 valence_word_as_key: .{ holds: #yes, seen: ".{ boon: \"preloader\" } falls back to prose" }
 postfix_observer_detached: .{ holds: #yes, seen: "~{warm_furrow}@keeper is two expressions" }
 bias_anchor_after_frame: .{ holds: #yes, seen: "=meme[pov]@keeper{ pop } is two expressions with no warning" }
 silent_acceptance: .{ holds: #yes, seen: "a doubled mark (~~lit[7]) and a number with two points (1.0.5) read with no warning" }
 unclosed_string_cliff: .{ holds: #yes, seen: "9.6 KB of rules parse in 454 ms cold; with one unclosed string, 1,954 ms" }
 negative_frame_value: .{ holds: #in_part, seen: "%delay[-4] before a block gives one error and both blocks still read; no prose fallback in the minimal form" }
 apostrophe_in_capsule: .{ holds: #in_part, seen: "one error and no prose fallback in the minimal form" }
 probe_list_newline: .{ holds: #not_here, seen: "?name[ … ] and #name[ … ] over several lines read whole before a following block" }
 emoji_in_label: .{ holds: #not_here, seen: "a label with an emoji reads whole" }
 reading: "Six of ten hold as written. The others need the consumer's own file to reproduce, which is the case for carrying specimens per host (host-receipts host_specimens)."
}

^["codec"]{
 # The site's wonder about the share fragment, probed read-only. Not written back to its tree.
 asked: "do the hosts agree that the share fragment is base64url of UTF-8 text?"
 seen: "five implementations agree: the site's link kernel, the guide's build and walk scripts (the walk twice) and the canvas's reader all write or read base64url, without padding, of the text's UTF-8 bytes, behind one pattern; one cache calls the same fragment a serialized tree, and no code does"
 follows: "line-kit line_codec can state the codec in one sentence and replace five copies, where the plan counted four"
}

^["as_lines"]{
 # Forms the caches propose or imply, read today by both of seed's readers.
 request: "?guide/read[line]{garden}<text> reads whole in the line reader: the method as the mark, the path in the word, a query key as the mode, the carried line as the body, the representation as the concept"
 nested_request: "!guide/build[script]{garden[care]{seed, water}}<json> reads whole in the line reader and as two expressions in the parser"
 route: "a route written ?/host/#15/@keeper reads in the line reader as a join by @, and in the parser as one expression"
 expiry: "theme[sponsor]{honey}<until 2026-11-26> reads whole in the line reader as a concept; the parser reports two errors on the date"
 dial: "=dial[~]{ %range[0, 3] }, ~lit[7s] and =aim_step[0.13 of 0.04..0.4] all read today; a bare dial ~2 @8 is three expressions"
}

^["counts_here"]{
 wonders: "747 wonder anchors outside archives; 58 carry ~#expect; 22 have an answer written and 34 an answer left as a hole; 1 is retired"
 probes: "1,448 !probe blocks; 2 are marked ~#probe(run), so nearly every probe here is a prompt to think and not a command"
 plan_grain: "48 live plans hold 195 open questions and about 436 planned commits; 2 plans are one wonder wide; the median plan carries 7 planned commits"
}

^["second_consumer"]{
 # Its ten proposals and nine asks, by where each meets this repo. None is built there or here.
 addresses: .{ theirs: "one grammar for addresses, book routes, relative addresses, read a link before following it", here: "wonder_trial_address_line; line-kit; first-plugin familiarity_first" }
 dials: .{ theirs: "a mark followed directly by a number as sugar; dials declared in canon with a range; ranges and units on a number", here: "syntax-hardware-alignment p12; wonder-field wonder 4" }
 open_bodies: .{ theirs: "a body left open at the end of a line is legal and marked, and unclosed mid-line stays an error", here: "threshold-distance two_edges; line-kit owed closers; wonder_trial_quiet_fallback" }
 one_scheme: .{ theirs: "observer, channel, ground and body as one node, so a keeper after a room and an @ in an address read alike", here: "wonder_trial_observer_postfix; reproduced above" }
 materials: .{ theirs: "materials written as $ blocks with physics, read by letter blocks, lanes and a canvas alike", here: "wonder_trial_modality" }
 hooks: .{ theirs: "each verb a hook from a line and a context to a line and a receipt, every receipt written alike", here: "first-plugin plugin_hooks" }
 contact_sheet: .{ theirs: "six seeded variations side by side, each with its own address", here: "line-kit pivots; wonder-field neighbors" }
 honest_success: .{ theirs: "success false, or a flag, whenever a structured read falls back to prose", here: "plan-stream-parse-health; reproduced above" }
 runtime_reader: .{ theirs: "a small entry for reading at runtime; its bundle is 634 KB and a 5.6 KB rules file costs 300 to 430 ms cold", here: "parser-releases" }
 holes: .{ theirs: "a pattern variable as grammar, so what stories share can be written and read back", here: "syntax-hardware-alignment p17, hole_as_name" }
 sound_and_texture: .{ theirs: "a shared registry of mark voices and material textures", here: "wonder_trial_modality; audit-ui-data-models" }
}

^["leads"]{
 # Where to start, one probe each. Ordered by what the next depends on, not by importance.
 share_codec: .{ from: "the codec probe above", why: "five agreeing copies and one sentence make it the smallest socket with a doorway", first: "line-kit line_codec, failing first on a round trip of a line with marks and an emoji" }
 honest_read: .{ from: "reproduced: quiet_prose_fallback and valence_word_as_key", why: "a consumer checking success alone takes a broken rule set as read", first: "a fixture where a structured read that falls back says so in one field a consumer can test" }
 runnable_wonder: .{ from: "counts_here: 2 of 1,448 probes run", why: "a wonder closes on a receipt, and a prompt leaves none", first: "inquiry-loop probe_runner_l0 over the wonders in docs/theory/spw/wonder-field.spw, which are written to run" }
 address_as_line: .{ from: "as_lines: request and route", why: "three hosts and one consumer each parse addresses with a reader of their own", first: "the trial bench over wonder_trial_address_line" }
 neighbors: .{ from: "claims_kept: legal_neighbors and one_wonder_wide", why: "a wonder one edit from a line that reads is small enough to be a plan", first: "line-kit pivots over a trial card's forms" }
 dated_line: .{ from: "as_lines: expiry", why: "an ephemeral thing needs a line that says when it ends, and the parser cannot read a date", first: "wonder_trial_until, then p12's census with dates added" }
 plan_grain: .{ from: "counts_here: plan_grain", why: "2 of 48 live plans are one wonder wide, against a consumer rule that a plan is one wonder", first: "plan-tooling-design: list each plan's open questions that already carry a runnable probe" }
}

^["follows"]{
 theory: [~"../../../docs/theory/spw/wonder-field.spw", ~"../../../docs/theory/spw/threshold-distance.spw", ~"../../../docs/theory/spw/exhibit-floor.spw"]
 trials: ~"../../../.agents/plans/interpretation-trials/interpretation-trials.spw"
 held: "No reader, grammar or consumer file changed. The site's three address wonders keep their owner; only the codec probe was run, and its result is kept here."
}
