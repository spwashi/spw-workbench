# Marketing, Reader Communities & Indie Traditions Cache
#
# 20BooksTo50K philosophy, rapid release, reader magnets, ARC teams, BookTok, and paid acquisition.

#>spw_cache_indie_author_community
#:cache #!marketing_readers_and_community_traditions
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the community traditions, collaborative marketing strategies, rapid release mechanisms, and viral social discovery driving independent author success."
  ~#protocol: "cache.layer/1"
}

^"indie_traditions_and_release_velocity"{
  "the_twenty_books_to_fifty_k_ethos": .{
    foundational_philosophy: "Pioneered by Michael Anderle and Craig Martelle: building a sustainable full-time living not through lottery-ticket breakout hits, but through an accumulated backlist of 20+ well-crafted, disciplined genre novels",
    abundance_mindset_data_sharing: "A radical communal norm where indie authors openly publish comprehensive spreadsheets detailing exact ad spend, daily royalty earnings, keyword bidding strategies, and platform algorithm shifts",
    rapid_release_engine: "Publishing new series installments every 30 to 90 days to defeat Amazon's 30-day 'hot new release' algorithmic visibility cliff, compounding readership across sequential launches",
  }[reg=facet],
  "reader_magnets_and_collaborative_swaps": .{
    the_reader_magnet: "Offering a free, professionally edited prequel novella or bonus epilogue via BookFunnel in exchange for reader newsletter opt-ins, converting casual browsers into lifelong subscribers",
    newsletter_cross_promotion_swaps: "Peer authors in matching subgenres exchange promotional features in their subscriber newsletters, trading reader attention without paying ad platform tax",
  }[reg=facet],
}

^"social_discovery_and_audience_activation"{
  "arc_teams_and_launch_day_velocity": .{
    advance_reader_copy_teams: "Dedicated cohorts of 50 to 500 vetted superfans who receive watermarked pre-release manuscripts to post organic reviews within hours of official launch, signaling social proof to store algorithms",
    street_teams_and_beta_readers: "Engaged reader circles providing developmental beta feedback, voting on cover mockups, and reporting retail pricing anomalies or unauthorized piracy uploads",
  }[reg=facet],
  "booktok_and_visual_trope_virality": .{
    trope_first_video_hooks: "Short-form video hooks centering visceral emotional tropes ('He falls first and harder', 'Found family fighting an ancient god', 'Enemies-to-lovers with knives at throats') driving millions of impressions",
    the_aesthetic_object_subculture: "Celebrating books as physical lifestyle artifacts: unboxing limited sprayed edges, tabbed annotations with color-coded sticky flags, and ambient reading vlogs",
  }[reg=facet],
  "paid_advertising_and_deal_surges": .{
    amazon_and_meta_advertising: "Precision targeting of competitor author ASINs and genre keywords on Amazon Ads; Facebook/Meta ads utilizing high-contrast emotional quote graphics",
    bookbub_featured_deals: "The gold standard of promotional deal surges: curated newsletter blasts driving thousands of paid purchases within 48 hours to catapult backlist titles to the top of bestseller charts",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_indie_author_community_1
  ?["Why did the indie publishing community develop an 'abundance mindset' of transparent financial data sharing when traditional authors historically kept royalties and contracts secret?"]{
    #:depth #!sociological ~#lens(collaborative_commons_vs_zero_sum_gatekeeping)
    ~#hypothesis: "In traditional publishing, authors competed for scarce catalog slots and marketing budgets allocated by corporate editors, fostering zero-sum secrecy. In indie publishing, book consumption is infinite: an insatiable fantasy reader finishes a book in two days and immediately hungers for more. Authors realized recommending peers directly expands total market size and algorithmic cross-recommendations."
    !probe{ "Track cross-recommendation sales lift and shared newsletter swap conversion rates across collaborative indie author collectives vs isolated authors." }
    $%[publishing.collaborative_sales_lift_multiplier, community.data_sharing_network_density]
  }
}
