# Author Software & Production Tools Cache
#
# Drafting software, typesetting engines, automated ARC distribution, and reader CRM pipelines.

#>spw_cache_indie_author_tools
#:cache #!author_software_and_production_tools
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the software toolchain, typesetting systems, developmental editing pipelines, and direct reader fulfillment tools utilized by professional indie authors."
  ~#protocol: "cache.layer/1"
}

^"drafting_and_typesetting_technologies"{
  "manuscript_drafting_and_plotting_software": .{
    scrivener_workflow: "Literature & Latte's corkboard, binder file hierarchy, split-screen editor, custom metadata labeling (POV, timeline, draft status), and multi-format compile presets",
    plottr_structural_mapping: "Visual timeline and beat plotting tool providing native templates for 'Save the Cat', 'Romancing the Beat', Campbell's 'Hero's Journey', and Dan Harmon's 'Story Circle'",
    specialized_prose_editors: "Novlr, Dabble, and Ulysses providing distraction-free cloud synchronization, sprint word-count trackers, and mobile drafting affordances",
  }[reg=facet],
  "interior_typesetting_and_layout_engines": .{
    vellum_interior_design: "macOS-native formatting application that automated boutique book design: real-time device previews, automated ornamental scene breaks, drop caps, and instant dual-export to reflowable EPUB3 and print-ready PDF",
    atticus_formatting_suite: "Cross-platform cloud-based drafting and formatting suite designed by Kindlepreneur providing web/Windows parity with Vellum styling presets",
    indesign_bespoke_typography: "Adobe InDesign employed for intricate non-fiction, graphic novels, and complex Kickstarter collector editions requiring bespoke baseline grid alignment and custom typography",
  }[reg=facet],
}

^"quality_assurance_and_reader_delivery_stack"{
  "editorial_hierarchy_and_prose_diagnostics": .{
    developmental_editing: "Macro structural review analyzing plot arcs, pacing bottlenecks, character motivation, and genre trope compliance",
    line_and_copy_editing: "Line editors refine voice, cadence, and sentence rhythm; copy editors correct grammar, punctuation, continuity, and internal worldbuilding logic",
    stylistic_and_linting_software: "ProWritingAid and Grammarly checking for passive constructions, glued sentences, repeated dialogue tags, and pacing variance",
  }[reg=facet],
  "arc_distribution_and_newsletter_crm": .{
    bookfunnel_delivery_infrastructure: "The backbone of indie reader delivery: handles cross-platform sideloading (Kindle mobi/epub, Kobo, Apple Books), automated customer tech support, and watermarked ARC distribution stamping reader emails onto pages to prevent leak piracy",
    storyorigin_and_booksirens: "Platforms facilitating cross-promotional newsletter swaps, beta-reader tracking, and automated reviewer verification",
    email_service_providers_esp: "MailerLite, ConvertKit (Kit), and Flodesk managing reader lists; multi-step welcome funnels, reader tagging based on subgenre preference, and automated backlist re-engagement sequences",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_indie_author_tools_1
  ?["How did Vellum and BookFunnel eliminate the primary technical barriers that historically relegated self-published books to looking amateurish?"]{
    #:depth #!technical ~#lens(democratization_of_craft_standards)
    ~#hypothesis: "Before Vellum and BookFunnel, self-published ebooks suffered from distorted CSS styling, broken table of contents links, and insurmountable sideloading friction for non-technical readers. By encapsulating complex typography rules and automating multi-device file transfer, these two tools raised indie presentation to parity with Penguin Random House, shifting the battleground entirely to storytelling quality."
    !probe{ "Audit formatting defect error rates and reader support ticket volume across indie books produced with custom manual HTML/CSS vs automated Vellum exports." }
    $%[publishing.formatting_syntax_error_rate, software.customer_support_inquiry_ratio]
  }
}
