# Care & Health Stewards in Grassroots Communities
#
# Promotores de salud, full-spectrum doulas, death companions, mental health peers, and harm reduction advocates.

#>spw_cache_comm_care_health
#:cache #!community_roles
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the decentralized frontline health and care roles that protect vulnerable bodies, soothe psychiatric crises, and shepherd life transitions outside hospital walls."
  ~#foundations: "Community Health Worker (CHW) evidence base, Reproductive Justice framework, Harm Reduction principles, Peer Support models"
}

^["promotores_de_salud_and_community_health_workers"]{
  mandate: "Trusted cultural liaisons who translate complex medical regimens into culturally congruent, lived household realities."
  domains: #[
    "Chronic Disease Accompaniment: Navigating hypertension, type 2 diabetes, and renal disease with culturally familiar dietary substitutions",
    "Health Literacy & Insurance Navigation: Guiding families through Medicaid renewals, sliding-scale clinics, and prescription discount programs",
    "Vaccination & Preventive Screening Drives: Hosting pop-up wellness checkups at churches, flea markets, and neighborhood community centers",
    "Environmental Health Audits: Identifying lead paint risks, gas stove indoor pollution, and vermin hazards in older housing units"
  ]
}

^["community_doulas_and_perinatal_caregivers"]{
  critical_imperative: "Counteracting severe racial and socioeconomic disparities in maternal and infant morbidity through continuous relational care."
  service_spectrum: .{
    prenatal_advocacy: "Educating birthing people on patient rights, birth plans, and informed refusal during clinical hospital encounters"
    continuous_labor_support: "Hands-on somatic comfort, counter-pressure, breathwork, and emotional grounding through active labor"
    postpartum_recovery: "Home visits providing sitz bath herbs, nutritious broths, newborn soothing techniques, and postpartum depression screening"
    loss_and_bereavement_doulas: "Companionship through miscarriage, stillbirth, or infant medical complications with sacred tenderness"
  }[reg=facet]
}

^["end_of_life_companions_and_death_doulas"]{
  philosophy: "Reclaiming dying as a sacred human transition rather than a medical failure sanitized by sterile hospital equipment."
  practices: #[
    "Vigil Sitting: Ensuring that no human dies alone in hospice, shelter, or home, maintaining quiet presence and gentle touch",
    "Legacy Projects & Life Review: Assisting elders in recording audio memoirs, recipe books, and ethical wills for younger generations",
    "Home Funeral & Green Burial Advocacy: Supporting families in washing, dressing, and holding wake rituals in their own domestic spaces",
    "Grief Cafés: Monthly open community gatherings for sharing the heavy weight of bereavement without clinical psychologizing"
  ]
}

^["peer_mental_health_and_crisis_deescalators"]{
  operational_model: "Certified Peer Specialists (CPS) with direct lived experience of psychiatric hospitalization, trauma, or severe depression."
  crisis_alternatives: #[
    "Mobile Crisis Response Teams: Dispatching mental health peers instead of armed police to individuals experiencing acute emotional distress",
    "Hearing Voices Groups: Facilitating non-pathologizing peer spaces where voice-hearers explore meaning and coping strategies",
    "Warmline Responders: Operating confidential, non-emergency phone lines offering human connection to prevent escalation into acute crisis"
  ]
}

^["harm_reduction_stewards"]{
  motto: "Meeting people where they are, without judgment, to keep them alive and dignified."
  life_saving_interventions: #[
    "Naloxone (Narcan) Saturation: Training bartenders, transit workers, and neighbors to reverse opioid overdoses with nasal naloxone",
    "Drug Checking & Test Strips: Distributing fentanyl and xylazine test strips with clear spectroscopic testing instructions",
    "Sterile Syringe Access: Providing clean supplies, safe disposal boxes, and basic wound care to prevent endocarditis and abscesses",
    "Stigma-Free Radical Compassion: Affirming the inherent worth and beauty of active substance users within the neighborhood"
  ]
}

^["taste"]{
  ~#taste: "Care is the ultimate measure of civilization; when practiced by neighbors for neighbors, it repairs fractures that medicine cannot reach."
  ~#wonder: "Why does the physical presence of a trained doula cut emergency c-section rates by 50% more effectively than multimillion-dollar hospital telemetry monitors?"

  principles: #[
    "Lived authority: People who have survived an ordeal are uniquely equipped to hold hands with others walking the same fire.",
    "Non-carceral care: Healing must never be tied to surveillance, criminalization, or involuntary confinement.",
    "Bodily autonomy: Every human holds sovereign dominion over their own body, birth, medicine, and death."
  ]
}

^"invariants"{
  "Community health workers and doulas must prioritize the explicit wishes and autonomy of the client over institutional convenience.",
  "Harm reduction practices operate with zero requirement of mandatory abstinence as a condition for receiving sterile supplies.",
  "Peer mental health de-escalation must prioritize non-violent, trauma-informed physical safety for all participants.",
}

#>wonder_comm_care_health_1
?["How does embedding community doulas in high-morbidity zip codes affect NICU admission rates and preterm births?"]{
  #:depth #!sociological ~#lens(perinatal_justice)
  ~#hypothesis: "Continuous doula support across prenatal, birth, and 6-week postpartum periods reduces preterm births by 28% and NICU admissions by 35% among Medicaid-enrolled mothers."
  !probe{ "Analyze state Medicaid claims data comparing birth and neonatal outcomes between mothers receiving community doula services vs standard obstetric care alone." }
  $%[perinatal.preterm_birth_rate, neonatal.nicu_days_admitted]
}
