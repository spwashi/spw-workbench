# Civic Organizing & Grassroots Democracy Roles
#
# Block captains, mutual aid coordinators, participatory assembly facilitators, and tenant organizers.

#>spw_cache_comm_civic_organizing
#:cache #!community_roles
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the grassroots democratic and mutual aid roles that knit atomized individuals into organized, resilient neighborhood polities."
  ~#traditions: "Alinsky community organizing, Ella Baker decentralized leadership, participatory budgeting, mutual aid theory"
}

^["block_captains_and_street_liaisons"]{
  role_archetype: "The hyperlocal connector who knows every family, porch, elder, and pet on a single residential block."
  core_responsibilities: #[
    "Contact Trees & Phone Cascades: Maintaining up-to-date neighborhood phone/signal trees for emergencies and municipal alerts",
    "Elder Welfare Check-ins: Routine visits during heatwaves, winter freezes, and power outages to verify safety and food supply",
    "Hyperlocal Dispute Mediation: De-escalating neighbor-to-neighbor friction (noise, property boundaries, parking) before police involvement",
    "Welcoming Protocol: Personally greeting new tenants and homeowners with community orientation packets and local resources"
  ]
}

^["mutual_aid_coordinators"]{
  philosophy: "Solidarity, not charity: Meeting material human needs through horizontal peer-to-peer reciprocity without means-testing."
  operational_domains: .{
    freedge_and_pantry_networks: "Stocking, cleaning, and temperature-monitoring outdoor free refrigerators and pantry boxes"
    emergency_relief_funds: "Administering rapidly mobilized micro-grants for sudden eviction threats, utility shut-offs, and medical copays"
    disaster_rapid_response: "Setting up neighborhood field kitchens, generator hubs, and clean water points during municipal infrastructure failures"
    skillshares_and_tool_libraries: "Organizing recurring workshops on home weatherization, bike maintenance, sewing, and foraging"
  }[reg=facet]
}

^["participatory_assembly_facilitators"]{
  deliberative_craft: "Facilitators trained in consensus decision-making, Robert's Rules alternatives, and anti-oppressive assembly facilitation."
  contexts: #[
    "Participatory Budgeting Delegates: Guiding community assemblies to allocate municipal discretionary funds to local infrastructure",
    "Language Justice Interpreters: Providing simultaneous whispering/headset translation so non-English speakers actively debate policy",
    "Youth Civic Councils: Scaffolding teenagers to lead town hall questioning of city councilors, transit directors, and school superintendents"
  ]
}

^["tenant_and_housing_defense_organizers"]{
  mandate: "Protecting neighborhood residential stability against predatory slumlords, speculation, and retaliatory eviction."
  tactics_and_roles: #[
    "Tenant Union Stewards: Organizing whole-building tenant associations to demand code compliance, mold remediation, and heat restoration",
    "Eviction Court Observers: Providing emotional accompaniment and legal resource connection for families facing summary dispossess proceedings",
    "Right-to-Return Advocates: Ensuring long-time residents have first right of refusal on newly developed non-profit affordable housing units"
  ]
}

^["taste"]{
  ~#taste: "True organizing does not manufacture followers; it uncovers the latent leadership already slumbering inside quiet neighbors."
  ~#wonder: "Why is a block with an active potluck tradition exponentially more effective at preventing violent crime than a street blanketed by private surveillance cameras?"

  principles: #[
    "Relational depth over digital vanity: A face-to-face cup of coffee on a front porch outweighs a thousand signatures on an online petition.",
    "Decentralized power: Distributing responsibilities so that no single leader's departure collapses the community infrastructure.",
    "Joyful resistance: Sustaining serious political struggle through communal feasts, music, and shared laughter."
  ]
}

^"invariants"{
  "Mutual aid operations must remain unconditional and never impose moralizing means-tests on those requesting help.",
  "Community organizing leadership must be rooted in lived experience within the neighborhood being organized.",
  "Facilitators must maintain language justice as an essential prerequisite for equitable assembly participation.",
}

#>wonder_comm_civic_organizing_1
?["How does the presence of an active tenant union affect longitudinal health indicators in multi-family rental buildings?"]{
  #:depth #!sociological ~#lens(housing_health_nexus)
  ~#hypothesis: "Buildings with active tenant unions experience a 45% drop in pediatric emergency room visits for asthma due to forced landlord remediation of moisture and mold infestations."
  !probe{ "Cross-reference municipal code enforcement remediation records with pediatric emergency department respiratory admissions in organized vs unorganized buildings." }
  $%[health.pediatric_asthma_er_visits, housing.code_violation_cure_rate]
}
