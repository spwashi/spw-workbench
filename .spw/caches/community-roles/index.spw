# Community Roles & Relational Stewardship Cache Index
#
# Root cache index for grassroots civic organizing, community healthcare, cultural preservation, and ecological stewardship.

#>spw_cache_community_index
#:cache #!community_roles
#:layer #!pragmatics

^"intent"{
  ~#goal: "Map the decentralized, relational human roles that build social cohesion, intergenerational resilience, and communal flourishing."
  ~#focus: "Grassroots organizing, community health workers, oral cultural custodians, and urban ecological stewards"
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @civic_organizing: ~"./civic-and-organizing-roles.spw"
  @care_health: ~"./care-and-health-stewards.spw"
  @cultural_custodians: ~"./intergenerational-and-cultural-custodians.spw"
  @spatial_stewards: ~"./ecological-and-spatial-stewards.spw"
  @taste: ~"./taste.spw"
}

^"dispatch"{
  civic_and_organizing_roles: @civic_organizing
  care_and_health_stewards: @care_health
  intergenerational_and_cultural_custodians: @cultural_custodians
  ecological_and_spatial_stewards: @spatial_stewards
  taste_considerations: @taste
}

^"taste"{
  ~#taste: "A community is not defined by municipal boundary lines, but by the density of care and reciprocity among its stewards."
  ~#wonder: "Why do neighborhoods with robust informal steward networks survive economic and environmental crises far better than those reliant solely on top-down state agencies?"
}

^"invariants"{
  "Community roles derive their legitimacy from relational trust and local presence, not state appointment.",
  "Relational care and mutual aid operate outside extractive market logic, prioritizing human dignity over transactional efficiency.",
  "Intergenerational wisdom and spatial stewardship protect the continuity of place across demographic shifts.",
}

#>wonder_community_index_1
?["How do informal community steward networks generate social resilience during municipal infrastructure disruptions?"]{
  #:depth #!sociological ~#lens(relational_resilience)
  ~#hypothesis: "Neighborhoods with high densities of block captains, community gardeners, and promotores de salud mobilize emergency mutual aid 4x faster during extreme weather events than neighborhoods with identical median income lacking informal leadership."
  !probe{ "Map neighborhood recovery times and food/medical distribution speed post-disaster against community stewardship density scores." }
  $%[resilience.disaster_recovery_time_hours, community.relational_density_index]
}
