# Photochemical Emulsion Chemistry & Crystal Physics
#
# Silver halide lattice photochemistry, Gurney-Mott latent image theory, T-Grain technology, and vinegar syndrome degradation.

#>spw_cache_film_chem_emulsion
#:cache #!film_chemistry
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the physical chemistry of motion picture and still photographic film emulsions, articulating crystal lattice defects, latent image physics, chromogenic multi-layer dye synthesis, and base stability."
  ~#foundations: "Gurney-Mott Latent Image Theory, Kodak T-Grain Morphology, and Polymer Base Degradation Kinetics"
}

^["silver_halide_crystal_physics_and_latent_image"]{
  crystal_foundations: "The semiconductor physics of silver halide micro-crystals suspended in photographic gelatin."
  solid_state_photochemistry: #[
    "Lattice Architecture: Face-Centered Cubic (FCC) rocksalt lattice composed of silver cations (Ag+) and halide anions (Br- with 1-10% I-)",
    "Frenkel Defect Generation: High concentration of mobile interstitial silver ions (Ag_i+) and corresponding silver lattice vacancies",
    "Gurney-Mott Two-Stage Latent Image Theory: Photon absorption excites valence electrons into the conduction band; photoelectrons are trapped at sulfur/gold sensitivity specks",
    "Ionic Neutralization: Trapped negative charges attract mobile interstitial silver ions, depositing neutral silver atoms (Ag_i+ + e- -> Ag0)",
    "Critical Nucleus Stability: Accumulation of a cluster of 4 or more elemental silver atoms (Ag4) forms a stable, developable latent image speck"
  ]
}

^["tabular_t_grain_technology_vs_cubic_emulsions"]{
  crystal_morphology: "Engineering crystal aspect ratios to maximize light capture and sharpness."
  morphological_comparisons: .{
    traditional_polydisperse_cubes: "Three-dimensional pebble-like cubic/octahedral crystals with random orientation, high internal light scatter, and thick emulsion layers"
    tabular_t_grains: #[
      "Hexagonal/triangular flat platelet crystals grown via controlled twin-plane crystallization",
      "High Surface-Area-to-Volume Ratio: Maximizing sensitizing dye adsorption on broad top surfaces while maintaining ultra-thin profiles",
      "Reduced Light Scatter: Thin emulsion layers prevent internal lateral photon bouncing, dramatically increasing MTF sharpness and resolving power",
      "Superior Speed-to-Grain Ratio: Achieving high ISO sensitivity with significantly finer visual grain structure in shadow areas"
    ]
  }[reg=facet]
}

^["gelatin_binder_and_spectral_sensitization"]{
  macromolecular_matrix: "The unique biochemical properties of photographic gelatin."
  matrix_dynamics: #[
    "Colloidal Swelling Kinetics: Gelatin reversibly swells to four times its dry thickness in aqueous alkaline developer, admitting chemical ions while immobilizing silver grains",
    "Chemical Sensitization: Doping grain surfaces with trace sodium thiosulfate (sulfur) and potassium tetrachloroaurate (gold) to create deep electron traps",
    "Spectral Sensitizing Dyes: Unmodified silver halides absorb only UV and blue (< 450 nm); polymethine and cyanine dyes adsorb onto grain surfaces, transferring energy from green (orthochromatic) and red (panchromatic) photons into the conduction band"
  ]
}

^["chromogenic_multi_layer_color_architecture"]{
  color_negative_chemistry: "Subtractive color tri-pack layer engineering (Kodak Vision3 / Eastmancolor)."
  multilayer_stratigraphy: .{
    protective_overcoat: "Hardened gelatin layer with anti-abrasion additives and UV absorbers protecting underlying emulsions"
    blue_sensitive_layer: "Silver halide emulsion coupled with colorless yellow dye-forming couplers (acetoacetanilide derivatives)"
    yellow_filter_layer: "Colloidal Carey-Lea silver particles absorbing remaining blue light to protect underlying green/red emulsions; bleached away during processing"
    green_sensitive_layer: "Green-sensitized emulsion coupled with magenta dye-forming pyrazolone couplers"
    red_sensitive_layer: "Red-sensitized emulsion coupled with cyan dye-forming phenol/naphthol couplers"
    antihalation_undercoat: "Remjet carbon black backing or dyed gelatin absorbing back-reflections from the base, washed off during ECN-2 pre-bath"
  }[reg=facet]
}

^["film_base_polymers_and_archival_degradation"]{
  polymer_substrate_longevity: "Chemical stability of historical and modern motion picture film bases."
  base_chemistries: #[
    "Cellulose Nitrate (pre-1951): Auto-catalytic decomposition releasing toxic nitrogen dioxide; highly flammable with flash points below 40C; turns to shock-sensitive brown dust",
    "Cellulose Triacetate 'Safety Film' (1948-present): Susceptible to 'Vinegar Syndrome' via acid hydrolysis—acetate ester bonds split to produce volatile acetic acid, causing shrinkage, curling, brittleness, and crystalline plasticizer exudation",
    "Polyester / ESTAR (polyethylene terephthalate): Chemically inert, dimensionally stable, resistant to biological mold and hydrolysis; standard for modern archival intermediate stocks",
    "Cold Vault Preservation: Halting vinegar syndrome hydrolysis by maintaining sub-freezing conditions (-18C / 0F at 30-40% relative humidity)"
  ]
}

^["taste"]{
  ~#taste: "Photochemical film is physical memory: an authentic molecular impression made by real photons striking real earth metals in a sliver of time."
  ~#wonder: "Why does the random, organic distribution of silver halide crystals feel more alive and forgiving to the human eye than the rigid square grid of a CMOS sensor?"

  principles: #[
    "Grain is not digital noise: Photochemical grain has structural, organic spatial depth; it dances randomly across frames rather than buzzing as fixed pattern sensor noise.",
    "The permanence of physical media: A reel of polyester black-and-white film stored in a cool dry vault will remain projection-ready in five hundred years without requiring software updates.",
    "Highlight latitude: The chemical shoulder of film naturally compresses extreme overexposure into gentle pastel highlights where digital sensors violently clip."
  ]
}

^"invariants"{
  "Color negative film multi-layers must separate blue, green, and red records via wavelength-selective sensitizing dyes and colloidal silver yellow filter barriers.",
  "Cellulose triacetate film showing vinegar syndrome (acetic acid odor) must be quarantined immediately to prevent catalytic vapor damage to adjacent film cans.",
  "Motion picture negative stocks with remjet backing must undergo alkaline pre-bath wash before entering the developer bath to avoid developer contamination."
}

#>wonder_film_chem_emulsion_1
?["How does the inclusion of 2-phase iodide core-shell gradients inside silver bromoiodide tabular grains improve spectral sensitivity?"]{
  #:depth #!chemical ~#lens(bandgap_defect_engineering)
  ~#hypothesis: "Concentrating 8-12 mol% iodide in the interior core while maintaining a pure silver bromide outer shell creates an internal valence band offset that funnels photo-holes into the grain interior, reducing surface electron-hole recombination by 40% and doubling quantum efficiency."
  !probe{ "Measure microwave photoconductivity decay and photographic speed on core-shell AgBrI tabular grains with stepped vs homogeneous iodide profiles." }
  $%[solid_state.photoconductivity_lifetime_ns, photographic.speed_iso_delta]
}
