# Protein Structure & Enzymology Curriculum Cache
#
# Ramachandran dihedral landscapes, chaperonin folding cages, Michaelis-Menten kinetics, and catalytic triads.

#>spw_cache_univ_mcb_enzymology
#:cache #!protein_structure_and_enzymology
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model hierarchical protein folding thermodynamics, Ramachandran steric constraints, chaperone folding cages, Michaelis-Menten catalytic kinetics, and allosteric cooperativity."
  ~#protocol: "cache.layer/1"
}

^"hierarchical_protein_folding_and_chaperones"{
  "peptide_geometry_and_secondary_structure": .{
    peptide_bond_planarity: "Resonance between carbonyl oxygen and amide nitrogen imparting ~40% double-bond character; rigid planar trans configuration with zero rotation around C-N peptide bond",
    ramachandran_dihedral_angles: "Conformational freedom restricted to phi (N-C_alpha) and psi (C_alpha-C) torsional angles; allowed quadrants define right-handed alpha-helices, beta-pleated sheets, and left-handed collagen helices",
    alpha_helix_and_beta_sheet_h_bonding: "Alpha-helix: 3.6 residues per turn, 0.54nm pitch, backbone hydrogen bond between carbonyl C=O of residue i and amide N-H of residue i+4; Beta-sheets: parallel vs antiparallel arrangements stabilized by interstrand hydrogen bonds",
  }[reg=facet],
  "folding_funnels_and_chaperonin_cages": .{
    hydrophobic_collapse_and_anfinsen: "Entropic release of structured clathrate water shells around non-polar side chains driving rapid hydrophobic collapse; Anfinsen's dogma asserting primary sequence encodes lowest Gibbs free energy native state",
    levinthals_paradox_and_energy_landscapes: "Rugged folding funnel landscape guiding polypeptides down productive downhill kinetic pathways within milliseconds rather than sampling all 10^70 conformations randomly",
    groel_groes_chaperonin_nanocages: "Bacterial GroEL/GroES double-ring complex: ATP binding and GroES capping sequester misfolded hydrophobic intermediates inside an isolated hydrophilic cavity ('Anfinsen cage'), permitting unhindered folding cycles",
  }[reg=facet],
}

^"enzyme_catalysis_and_steady_state_kinetics"{
  "transition_state_theory_and_catalytic_triads": .{
    transition_state_stabilization: "Enzymes accelerate reaction rates by 10^6 to 10^17 fold by binding the high-energy transition state with vastly higher affinity than the ground-state substrate, lowering activation energy Delta G^double_dagger",
    serine_protease_catalytic_triad: "Chymotrypsin mechanism: Asp102 polarizes His57, which abstracts a proton from Ser195, generating a potent nucleophile that attacks peptide carbonyl; oxyanion hole stabilizing tetrahedral intermediate",
  }[reg=facet],
  "michaelis_menten_kinetics_and_inhibition": .{
    rate_equation_and_kinetic_parameters: "v_0 = (V_max * [S]) / (K_m + [S]); K_m = (k_-1 + k_2) / k_1 (substrate concentration at half-maximal velocity); Catalytic turnover k_cat = V_max / [E]_total; Catalytic perfection k_cat / K_m approaching diffusion limit 10^8 - 10^9 M^-1 s^-1",
    inhibition_mechanics: "Competitive: inhibitor competes for active site (increases apparent K_m, V_max unchanged); Uncompetitive: binds only to ES complex (decreases both K_m and V_max); Non-competitive: binds allosteric site (decreases V_max, K_m unchanged)",
    allosteric_cooperativity_mwc_knf: "Hill equation cooperativity (n_H > 1); Monod-Wyman-Changeux (MWC) concerted model (concerted T-to-R transition across all subunits) vs Koshland (KNF) sequential induced-fit model (e.g., hemoglobin oxygen binding)",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_univ_mcb_enzymology_1
  ?["How does triosephosphate isomerase (TIM) achieve 'catalytic perfection', where the enzymatic reaction rate is limited solely by how fast substrate molecules diffuse through water?"]{
    #:depth #!biochemical ~#lens(diffusion_controlled_catalytic_perfection)
    ~#hypothesis: "TIM operates with a catalytic efficiency k_cat / K_m of ~2 x 10^8 M^-1 s^-1, the physical diffusion ceiling of small molecules in aqueous solution. An active-site flexible loop (Loop 6) snaps shut over the substrate in microseconds, precisely positioning catalytic glutamate and histidine residues while protecting the unstable enediol phosphate intermediate from dephosphorylating into toxic methylglyoxal."
    !probe{ "Measure active-site Loop 6 open/closed kinetic transition rates using NMR relaxation dispersion during wild-type vs loop-mutant TIM turnover." }
    $%[enzymology.loop_closure_rate_constant_k_on, kinetics.diffusion_limited_bimolecular_ceiling]
  }
}
