# Undergraduate Mechanical Engineering Curricular Architecture
#
# ABET-accredited Bachelor of Science (B.S.) in Mechanical Engineering: solid mechanics, thermo-fluids, machine design, and system dynamics.

#>spw_cache_univ_undergrad_meche
#:cache #!mechanical_engineering
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the four-year undergraduate curriculum for an ABET-accredited Bachelor of Science in Mechanical Engineering, articulating structural mechanics, thermo-fluid systems, machine element design, and controls."
  ~#accreditation: "ABET Engineering Accreditation Commission (EAC) Criteria for Mechanical Engineering"
}

^["statics_and_solid_mechanics"]{
  sophomore_sequence: "Statics, Mechanics of Materials, and Materials Testing Laboratory."
  mechanics_foundations: #[
    "Equilibrium & Vector Statics: Free-body diagrams, particle and rigid body equilibrium, structural trusses (method of joints and sections), and friction clutches",
    "Internal Resultants & Stress Fields: Normal, shear, torsional, and bending stress distributions in beams; shear force and bending moment diagrams",
    "Beam Deflection Theory: Euler-Bernoulli beam theory, double integration method, superposition, and statically indeterminate beam analysis",
    "Multi-Axial Stress States: Plane stress transformations, principal stresses, Mohr's circle in 2D and 3D, and strain gauge rosette analysis",
    "Failure Criteria & Buckling: Ductile yield criteria (von Mises distortion energy, Tresca maximum shear stress), brittle fracture (Rankine), and Euler column buckling"
  ]
}

^["dynamics_and_mechanical_vibrations"]{
  sophomore_junior_core: "Dynamics and Vibration Analysis."
  kinematics_and_kinetics: .{
    rigid_body_dynamics: #[
      "Planar and spatial kinematics of particles and rigid bodies using rotating reference frames and Coriolis acceleration terms",
      "Work-energy and impulse-momentum principles applied to multi-body dynamic collision events",
      "Planar kinetics of rigid bodies: Equations of motion, mass moments of inertia, and instantaneous center of zero velocity"
    ]
    mechanical_vibrations: #[
      "Single-Degree-of-Freedom (1-DOF) Systems: Free, viscous-damped, and harmonic-forced response; logarithmic decrement and resonance magnification",
      "Vibration Isolation: Force transmissibility, base excitation, and vibration isolation mount design",
      "Multi-DOF Systems: Modal analysis, mass and stiffness matrices, natural frequencies, mode shapes, and tuned mass dampers"
    ]
  }[reg=facet]
}

^["thermo_fluids_and_energy_systems"]{
  junior_core: "Applied Thermodynamics, Fluid Mechanics, and Heat Transfer."
  thermal_fluid_sciences: #[
    "Thermodynamic Power Cycles: Vapor power (Rankine cycles with reheat and regeneration), gas turbine (Brayton cycles with intercooling), and internal combustion (Otto, Diesel)",
    "Fluid Dynamics: Control volume conservation laws (Reynolds Transport Theorem), differential Navier-Stokes equations, Moody friction chart, and pipe networks",
    "External Aerodynamics: Boundary layer growth (Blasius laminar vs turbulent), flow separation, pressure vs skin-friction drag, and airfoil lift generation",
    "Heat Transfer Modes: Steady/transient conduction (Fourier's law, lumped capacitance), convective correlations (Nusselt number), and radiation view factors",
    "Heat Exchanger Engineering: Log-Mean Temperature Difference (LMTD) and Effectiveness-NTU design for compact shell-and-tube and plate exchangers"
  ]
}

^["machine_element_design_and_manufacturing"]{
  junior_senior_core: "Design of Machine Elements and Computer-Aided Manufacturing."
  machine_design_suite: .{
    fatigue_and_failure: #[
      "High-cycle fatigue analysis: S-N curves, endurance limits, and fluctuating stress failure theories (Modified Goodman, Gerber, ASME Elliptic lines)",
      "Surface fatigue wear and contact stresses: Hertzian contact stress in rolling elements and gear teeth"
    ]
    component_engineering: #[
      "Shaft design: Combined bending and torsion, critical whirling speeds, keyways, and stress concentration mitigation",
      "Gears & Bearings: Spur, helical, and bevel gear kinematics (AGMA contact and bending stress ratings); rolling element bearing L10 dynamic life ratings",
      "Fasteners & Welds: Bolted joint preload, bolt stiffness, joint separation safety factors, and weld throat stress calculation"
    ]
    manufacturing_and_gdt: #[
      "Geometric Dimensioning and Tolerancing: ASME Y14.5 standards, datums, position, profile, runout, and maximum material condition (MMC)",
      "Processes: CNC 3-axis/5-axis milling, lathe turning, metal stamping, sheet metal bending, and polymer injection molding tooling"
    ]
  }[reg=facet]
}

^["system_dynamics_and_mechatronic_controls"]{
  senior_core: "System Dynamics, Control Systems, and Mechatronics Lab."
  control_disciplines: #[
    "Electromechanical Modeling: Differential equations governing coupled mechanical, electrical, and hydraulic dynamic systems",
    "Control Loop Design: Root locus, Bode plots, gain and phase margins, and operational amplifier signal conditioning",
    "Digital Control & Embedded Implementation: Microcontroller programming, Analog-to-Digital Conversion (ADC), Pulse-Width Modulation (PWM) motor drivers, and encoder feedback"
  ]
}

^["senior_capstone_design_prototyping"]{
  senior_culmination: "Two-semester Engineering Design Project."
  design_lifecycle: #[
    "Problem Scoping & Voice of Customer: Quality Function Deployment (QFD) House of Quality, engineering specification matrices, and functional decomposition",
    "Concept Generation & Selection: Morphological charts and Pugh decision matrix scoring against safety and cost constraints",
    "Analytical & Computational Validation: Complete 3D CAD parametric assemblies (SolidWorks/Creo) and Finite Element Analysis (FEA) structural verification",
    "Hardware Prototyping & Testing: Physical prototype fabrication, Design for Manufacturing and Assembly (DFM/DFA), and experimental performance testing"
  ]
}

^["taste"]{
  ~#taste: "Mechanical engineering is the poetry of physical constraint: balancing stress, heat, vibration, and cost to make metal and silicon dance."
  ~#wonder: "Why does a properly preloaded bolt withstand millions of severe fatigue cycles without ever coming loose, whereas an un-preloaded bolt snaps almost immediately?"

  principles: #[
    "Load paths must be visible: An experienced engineer looks at a mechanism and immediately traces where every pound of force flows into the ground.",
    "Tolerances cost money: Never specify a tenth-of-a-thousandth tolerance unless the kinematic functioning of the machine leaves no alternative.",
    "Hardware never lies: FEA simulations make colorful pictures; the physical test fixture proves whether the part actually survives."
  ]
}

^"invariants"{
  "All senior capstone designs must document stress safety factors and fatigue life calculations based on verified material properties.",
  "CAD assemblies must specify explicit GD&T tolerance callouts on critical functional interfaces.",
  "Physical prototyping must include emergency power cutoffs and mechanical shielding around high-speed rotating components.",
}

#>wonder_undergrad_meche_1
?["How does the early pedagogical integration of generative topology optimization into junior design courses affect student appreciation for organic load paths?"]{
  #:depth #!pedagogical ~#lens(computational_biomechanics)
  ~#hypothesis: "Students who use algorithmic topology optimization alongside traditional beam theory design 30% lighter structural brackets with reduced stress concentrations by naturally discovering bone-like structural load trusses."
  !probe{ "Compare weight-to-yield strength ratios and stress concentration factors in sophomore design brackets created via traditional CAD vs generative topology software." }
  $%[design.bracket_strength_to_weight_ratio, mechanics.peak_von_mises_stress_reduction]
}
