# Graduate Algebra & Algebraic Topology Curriculum Cache
#
# Module structure over PIDs, category theory, Yoneda lemma, singular homology, cup products, and Poincaré duality.

#>spw_cache_univ_grad_algebra_top
#:cache #!graduate_algebra_and_algebraic_topology
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model doctoral algebra (modules over PIDs, category theory, Yoneda lemma, homological Ext/Tor) and algebraic topology (fundamental groups, singular homology, cup product rings, Poincaré duality)."
  ~#protocol: "cache.layer/1"
}

^"advanced_algebra_and_category_theory"{
  "modules_over_pids_and_multilinear_algebra": .{
    structure_theorem_for_finitely_generated_modules: "For PID R: M ~= R^r (+) (direct_sum_i R / (d_i)) where d_1 | d_2 | ... | d_k are unique invariant factors; unifies Jordan canonical form and classification of finite abelian groups",
    tensor_products_and_universal_property: "M (x)_R N constructed via universal property linearizing bilinear maps; Tensor algebra T(V), Symmetric algebra S(V), and Exterior algebra Wedge(V)",
    projective_injective_and_flat_modules: "Projective modules (exact Hom(P, -)), Injective modules (exact Hom(-, I), Baer's criterion), and Flat modules (exact - (x)_R M)",
  }[reg=facet],
  "category_theory_and_homological_algebra": .{
    categories_functors_and_natural_transformations: "Category C (objects and morphisms); Functors F: C -> D; Natural transformations alpha: F => G; Adjoint functor pairs F -| G with Hom(Fa, b) ~= Hom(a, Gb)",
    the_yoneda_lemma: "Nat(Hom(A, -), F) ~= F(A); embeds any category C fully and faithfully into presheaf category Set^(C^op); objects are completely determined by their network of relationships with all other objects",
    chain_complexes_and_derived_functors: "Complexes ... -> C_n+1 -d-> C_n -d-> C_n-1 -> ... with d^2 = 0; Homology H_n = ker(d_n) / im(d_n+1); Snake Lemma yielding long exact sequence; Derived functors Ext^n_R(M, N) and Tor_n^R(M, N)",
  }[reg=facet],
}

^"algebraic_topology_and_cohomology_rings"{
  "fundamental_group_and_covering_spaces": .{
    homotopy_of_paths_and_pi_1: "Equivalence classes of loops based at x_0; Group operation via loop concatenation; pi_1(S^1) ~= Z; Van Kampen's Theorem computing pi_1 of union X_1 U X_2 as amalgamated free product",
    covering_spaces_and_galois_correspondence: "Covering projection p: E_tilde -> B with discrete fibers; Path lifting and homotopy lifting properties; Exact bijection between connected covering spaces and conjugacy classes of subgroups of pi_1(B)",
  }[reg=facet],
  "singular_homology_and_poincare_duality": .{
    singular_homology_and_axioms: "Singular simplices Delta^n -> X; Boundary operator partial_n satisfying partial^2 = 0; Homotopy invariance; Eilenberg-Steenrod axioms; Mayer-Vietoris exact sequence and Excision theorem",
    cohomology_and_cup_product_ring: "Cochains C^n(X; G) = Hom(C_n(X), G); Coboundary delta with delta^2 = 0; Universal Coefficient Theorem; Cup product smile: H^k(X; R) x H^l(X; R) -> H^(k+l)(X; R) turning cohomology into graded-commutative ring",
    poincare_duality_theorem: "For any closed, orientable topological n-manifold M: Cap product with fundamental class [M] in H_n(M) induces a canonical isomorphism H^k(M; Z) ~= H_(n-k)(M; Z); mirrors topology across middle dimension",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_univ_grad_algebra_top_1
  ?["Why does the Yoneda Lemma establish that an object in any mathematical universe is completely and faithfully known solely by how other objects map into it?"]{
    #:depth #!philosophical ~#lens(relational_ontology_of_mathematics)
    ~#hypothesis: "The Yoneda Lemma dismantles mathematical essentialism. It proves that an object has no intrinsic, isolated identity beyond the totality of its morphisms with the surrounding category. Identity is entirely relational: to know an object is to know its universal behavior in relationship to the whole."
    !probe{ "Formulate the Yoneda embedding of affine schemes in algebraic geometry to demonstrate the functor-of-points perspective." }
    $%[category.yoneda_faithfulness_metric, philosophy.relational_ontology_index]
  }
}
