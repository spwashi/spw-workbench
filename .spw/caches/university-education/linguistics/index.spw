# University Linguistics Curriculum Cache Index
#
# Root cache index for phonetics, phonology, morphology, generative syntax, formal semantics, sociolinguistics, and language documentation.

#>spw_cache_univ_ling_index
#:cache #!university_linguistics
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model university-level undergraduate and graduate linguistics: articulatory and acoustic phonetics, generative syntax, typed compositional semantics, Gricean pragmatics, sociolinguistics, and field documentation."
  ~#domains: "Theoretical linguistics, acoustic phonetics, generative grammar, formal logic, sociolinguistics, and historical typology"
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @phonetics_phonology: ~"./phonetics-and-phonology.spw"
  @morphology_syntax: ~"./morphology-and-syntax.spw"
  @semantics_pragmatics: ~"./semantics-pragmatics-and-discourse.spw"
  @sociolinguistics_field: ~"./sociolinguistics-and-language-documentation.spw"
  @taste: ~"./taste.spw"
}

^"dispatch"{
  phonetics_and_phonology: @phonetics_phonology
  morphology_and_syntax: @morphology_syntax
  semantics_pragmatics_and_discourse: @semantics_pragmatics
  sociolinguistics_and_language_documentation: @sociolinguistics_field
  taste_considerations: @taste
}

^"taste"{
  ~#taste: "Linguistics is the physics of human meaning: observing the recursive mathematical architectures through which breath becomes consciousness."
  ~#wonder: "How does an infant, equipped only with noisy acoustic fragments, master a recursive generative grammar of infinite expressive power within thirty-six months without formal instruction?"
}

^"invariants"{
  "All linguistic descriptions must strictly adhere to descriptive rather than prescriptive methodology.",
  "Phonetic descriptions must map precisely to International Phonetic Alphabet (IPA) standards and acoustic formant measurements.",
  "Syntactic formalisms must preserve hierarchical c-command relations, constituency proofs, and Merge operation constraints.",
}

^"wonder_probes"{
  #>wonder_univ_ling_index_1
  ?["Why do all human languages exhibit discrete infinity and hierarchical recursion, while no non-human animal communication system exhibits center-embedding or unbounded hierarchical Merge?"]{
    #:depth #!cognitive ~#lens(biolinguistic_computational_narrow_faculty)
    ~#hypothesis: "Human language evolved through an evolutionary cognitive rewiring (the Faculty of Language in the Narrow sense / FLN) that instantiated a single computational operator, Merge. Merge combines two syntactic objects into an unordered set, recursively generating infinite hierarchical structures that map to linear sensory-motor externalization channels."
    !probe{ "Compare neural activation in Broca's area (Brodmann areas 44/45) during parsing of hierarchical recursive center-embedded clauses vs linear artificial grammars." }
    $%[neurolinguistics.broca_activation_volume, cognition.hierarchical_merge_latency]
  }
}
