# Morphology & Generative Syntax Curriculum Cache
#
# Typological morphology, X-bar theory, Minimalist Program (Merge/Move/Agree), and Binding Theory.

#>spw_cache_univ_ling_syntax
#:cache #!morphology_and_syntax
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model word-formation morphology, cross-linguistic morphological typology, generative phrase structure, Minimalist syntax, and syntactic locality."
  ~#protocol: "cache.layer/1"
}

^"morphological_architecture_and_typology"{
  "morpheme_classification_and_word_formation": .{
    morpheme_taxonomy: "Free morphemes (lexical stems) vs bound morphemes (affixes: prefixes, suffixes, infixes, circumfixes); roots, stems, and bases",
    derivation_vs_inflection: "Derivational morphology alters lexical category or core semantic denotation (e.g., nation -> nationalize); Inflectional morphology encodes grammatical features (tense, aspect, number, gender, case) preserving category",
    morphological_processes: "Compounding (endocentric, exocentric/bahuvrihi), reduplication, ablaut/apophony (sing/sang/sung), and suppletion (go/went, good/better)",
  }[reg=facet],
  "cross_linguistic_morphological_typology": .{
    analytic_isolating_languages: "Low morpheme-per-word ratio; grammatical relations signaled via rigid word order and independent function words (e.g., Mandarin, Vietnamese)",
    synthetic_agglutinative_languages: "High morpheme-per-word ratio with transparent 1:1 boundaries between morphemes and grammatical features (e.g., Turkish, Finnish, Swahili, Japanese)",
    fusional_inflectional_languages: "Morpheme boundaries fused; single affixes cumulatively express multiple grammatical categories simultaneously (e.g., Latin, Russian, Spanish verb endings)",
    polysynthetic_languages: "Entire propositional clauses incorporated into single complex words with noun incorporation and multiple agreement heads (e.g., Inuktitut, Mohawk, Yupik)",
  }[reg=facet],
}

^"generative_syntax_and_minimalist_program"{
  "constituency_and_x_bar_schema": .{
    constituency_diagnostics: "Empirical structural tests: clefting ('It was [XP] that...'), topicalization/movement, pro-form substitution ('do so', pronouns), and stand-alone question response",
    x_bar_architecture: "Universal hierarchical template: XP -> Specifier X'; X' -> X' Adjunct; X' -> X0 Complement; applies uniformly across lexical (N, V, A, P) and functional (C, T, D, v) categories",
    c_command_formalism: "Node A c-commands Node B if and only if neither dominates the other, and the first branching node dominating A dominates B; foundational geometric relation for all syntactic dependency",
  }[reg=facet],
  "chomskyan_minimalist_engine": .{
    merge_operation: "External Merge: takes two syntactic objects alpha and beta and forms unordered set {alpha, beta}; Internal Merge (Move): merges an object already contained within the tree, producing displacement",
    agree_and_feature_valuation: "Probe with unvalued uninterpretable features searches its c-command domain for matching Goal with valued interpretable features, establishing agreement under structural locality",
    binding_theory_principles: "Principle A: An anaphor must be bound in its binding domain; Principle B: A pronoun must be free in its binding domain; Principle C: An R-expression must be free everywhere",
    locality_and_island_constraints: "Ross island domains (Complex NP, Wh-island, Adjunct island, Coordinate structure constraint) where syntactic extraction is strictly barred by Phase Impenetrability Condition (PIC)",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_univ_ling_syntax_1
  ?["Why do syntactic constraints (such as Binding Principle C and Wh-islands) operate strictly on hierarchical tree geometry (c-command) rather than linear word order?"]{
    #:depth #!cognitive ~#lens(structural_dependency_invariance)
    ~#hypothesis: "The human language faculty has no computational access to linear acoustic sequence during core syntactic computation. Linear word order is a peripheral artifact forced by the physical sensory-motor vocal tract (which cannot pronounce two sounds simultaneously), while the conceptual-intentional interface computes exclusively over hierarchical tree geometries."
    !probe{ "Evaluate artificial neural network syntactic generalization on auxiliary inversion questions testing hierarchical vs linear distance heuristics." }
    $%[syntax.hierarchical_inversion_accuracy, computational.linear_heuristic_error_rate]
  }
}
