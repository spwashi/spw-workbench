# Graduate Master's Chemistry Curricular Architecture
#
# Master of Science (M.S.) in Chemistry: advanced retrosynthesis, quantum chemical modeling, bioinorganic clusters, and 2D NMR.

#>spw_cache_univ_masters_chemistry
#:cache #!chemistry
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the graduate Master of Science (M.S.) curriculum in specialized chemistry, covering advanced retrosynthesis, computational quantum mechanics, multidimensional spectroscopy, and original thesis defense."
  ~#degree_milestones: "Graduate Core Coursework, Cumulative Exams, Literature Seminar, Original Research Proposal (ORP), and Master's Thesis Defense"
}

^["advanced_organic_synthesis_and_retrosynthesis"]{
  graduate_focus: "Total synthesis of complex natural products and asymmetric catalytic methodology."
  advanced_domains: #[
    "Corey Retrosynthetic Logic: Transform-based disconnections, strategic synthons, chiral pool reagents, and topological bond network analysis",
    "Stereoselective & Asymmetric Catalysis: Evans oxazolidinone chiral auxiliaries, Sharpless epoxidation/dihydroxylation, Noyori asymmetric hydrogenation, and chiral phosphoric acid organocatalysis",
    "Cross-Coupling & C-H Activation: Palladium and nickel catalyzed cross-couplings (Suzuki-Miyaura, Stille, Negishi, Buchwald-Hartwig) and directed C(sp3)-H functionalization",
    "Pericyclic & Photochemical Cascades: Woodward-Hoffmann orbital symmetry rules, electrocyclizations, sigmatropic rearrangements (Cope, Claisen), and visible-light photoredox catalysis"
  ]
}

^["computational_quantum_chemistry_and_molecular_modeling"]{
  theoretical_depth: "Ab initio electronic structure calculations and density functional modeling."
  methods_and_algorithms: .{
    electronic_structure_methods: #[
      "Hartree-Fock (HF) Self-Consistent Field theory and Slater determinants",
      "Moller-Plesset perturbation theory (MP2) treating electron correlation",
      "Coupled Cluster theory (CCSD and CCSD(T)) as gold standard for molecular energetics",
      "Density Functional Theory (DFT): Hohenberg-Kohn theorems, Kohn-Sham orbitals, and exchange-correlation functionals (B3LYP, PBE0, M06-2X)"
    ]
    basis_set_selection: "Pople split-valence (6-311+G(d,p)) vs Dunning correlation-consistent (cc-pVTZ) basis sets and effective core potentials (ECPs)"
    transition_state_locating: "Intrinsic Reaction Coordinate (IRC) calculations, saddle point optimization, and imaginary frequency vibrational analysis"
  }[reg=facet]
}

^["advanced_inorganic_and_bioinorganic_chemistry"]{
  advanced_coordination: "Molecular architectures of transition metals, lanthanides, and enzymatic metallo-centers."
  specializations: #[
    "Bioinorganic Active Sites: Nitrogenase FeMo-cofactor iron-sulfur clusters, Photosystem II Mn4CaO5 oxygen-evolving complex, and Cytochrome P450 iron-oxo intermediates",
    "Metal-Metal Multiple Bonds: Cotton quadruple bonds in dimolybdenum and dirhenium carboxylates, isolobal analogy, and Wade-Mingos cluster electron-counting rules",
    "Single-Crystal X-Ray Crystallography: Reciprocal lattice Ewald sphere construction, space group determination, direct methods/Patterson synthesis, and ShelX Rietveld refinement"
  ]
}

^["multidimensional_spectroscopy_and_metrology"]{
  advanced_characterization: "Structural elucidation of non-crystalline macromolecules and trace unknowns."
  techniques: .{
    twod_nmr_spectroscopy: #[
      "H-H COSY (Correlation Spectroscopy) and TOCSY (Total Correlation Spectroscopy) mapping scalar spin networks",
      "H-C HSQC (Heteronuclear Single Quantum Coherence) identifying direct one-bond carbon-proton connectivity",
      "H-C HMBC (Heteronuclear Multiple Bond Coherence) establishing long-range (2-3 bond) quaternary carbon linkages",
      "NOESY (Nuclear Overhauser Effect Spectroscopy) measuring through-space dipolar spatial proximity (< 5 Angstroms)"
    ]
    high_resolution_mass_spec: "Ultra-High Resolution Orbitrap and Quadrupole Time-of-Flight (Q-TOF) tandem MS/MS with sub-ppm mass accuracy"
    surface_spectroscopies: "X-ray Photoelectron Spectroscopy (XPS) and Auger Electron Spectroscopy probing surface oxidation states"
  }[reg=facet]
}

^["supramolecular_chemistry_and_macromolecular_architecture"]{
  materials_frontiers: #[
    "Non-Covalent Self-Assembly: Crown ethers, cryptands, calixarenes, catenanes, rotaxanes, and hydrogen-bonded molecular capsules",
    "Reticular Chemistry: Design of Metal-Organic Frameworks (MOFs) and Covalent Organic Frameworks (COFs) for gas storage and heterogeneous catalysis",
    "Controlled Polymerization Mechanics: Atom Transfer Radical Polymerization (ATRP) and Reversible Addition-Fragmentation Chain Transfer (RAFT)"
  ]
}

^["taste"]{
  ~#taste: "Master's-level chemistry is the moment where the chemist stops following recipes and begins composing entirely novel molecular scores."
  ~#wonder: "Why does the quantum exchange correlation functional—a mathematical term whose exact form remains unknown—accurately predict the stability of every drug molecule known to humanity?"

  principles: #[
    "Architectural elegance: A ten-step total synthesis that relies on catalytic cascades is an aesthetic triumph over a thirty-step brute force route.",
    "Rigorous computational skepticism: Never trust a DFT transition state unless it matches physical kinetic isotope effects and experimental activation barriers.",
    "Thesis integrity: A master's thesis represents independent authorial stewardship of original chemical knowledge."
  ]
}

^"invariants"{
  "All reported synthetic compounds in graduate theses must include HRMS parent ion validation and fully assigned 1D and 2D NMR spectra.",
  "Computational quantum calculations must document explicit functional, basis set, solvent continuum model, and dispersion corrections.",
  "Master's thesis defense requires public presentation followed by closed-door examination by a faculty committee of at least three members.",
}

#>wonder_masters_chemistry_1
?["How does the deployment of machine-learning-guided retrosynthetic engines alter graduate student thesis project velocity?"]{
  #:depth #!epistemic ~#lens(cheminformatics_velocity)
  ~#hypothesis: "Graduate students combining automated Monte Carlo tree search retrosynthesis (e.g., AiZynthFinder) with laboratory bench screening complete total natural product syntheses in 35% fewer synthetic attempts than traditional literature-only routes."
  !probe{ "Compare step counts, intermediate losses, and months-to-completion for complex target syntheses undertaken with vs without ML retrosynthesis tools." }
  $%[synthesis.total_step_count, timeline.months_to_target_completion]
}
