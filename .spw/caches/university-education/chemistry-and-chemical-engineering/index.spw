# Chemistry & Chemical Engineering Curricular Hub
#
# Root cache index for undergraduate and master's degree programs in pure/specialized chemistry and chemical engineering.

#>spw_cache_univ_chem_cheme_index
#:cache #!chemistry_and_chemical_engineering
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the full pedagogical and technical continuum from molecular electronic structure and synthetic chemistry to continuous transport phenomena and industrial chemical plant design."
  ~#accreditation: "ACS (American Chemical Society) Committee on Professional Training, ABET Engineering Accreditation Commission"
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @undergrad_chemistry: ~"./undergrad-chemistry.spw"
  @masters_chemistry: ~"./masters-chemistry.spw"
  @undergrad_cheme: ~"./undergrad-chemical-engineering.spw"
  @masters_cheme: ~"./masters-chemical-engineering.spw"
  @taste: ~"./taste.spw"
}

^"dispatch"{
  undergrad_chemistry: @undergrad_chemistry
  masters_chemistry: @masters_chemistry
  undergrad_chemical_engineering: @undergrad_cheme
  masters_chemical_engineering: @masters_cheme
  taste_considerations: @taste
}

^"taste"{
  ~#taste: "Chemistry imagines the bond; chemical engineering delivers the molecule to billions of human hands."
  ~#wonder: "How does the quantum mechanics of a single transition-metal d-orbital translate into a 50-meter catalytic distillation column running steadily for thirty years?"
}

^"invariants"{
  "Chemical curricula strictly balance theoretical reaction mechanisms with hands-on bench synthesis and instrumental characterization.",
  "Chemical engineering progression adheres to continuous conservation laws (mass, momentum, energy) across all phases and unit operations.",
  "Laboratory safety protocols (OSHA, HAZOP, chemical hygiene plans) operate as non-negotiable prerequisites to experimental execution.",
}

#>wonder_chem_cheme_index_1
?["How does the pedagogical integration of computational molecular dynamics into sophomore organic chemistry alter mechanistic intuition?"]{
  #:depth #!pedagogical ~#lens(epistemic_visualization)
  ~#hypothesis: "Students who manipulate interactive 3D electron-density isosurfaces and transition-state trajectories achieve 40% higher accuracy in predicting stereoselective additions than those taught solely via 2D Lewis dash-wedge diagrams."
  !probe{ "Conduct randomized assessment across multi-section organic chemistry cohorts comparing transition-state stereocenter predictions with vs without real-time orbital visualization." }
  $%[pedagogy.stereochemistry_accuracy_rate, cognitive.spatial_orbital_retention]
}
