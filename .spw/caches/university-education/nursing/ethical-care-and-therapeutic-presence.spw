# Ethical Care, Palliative Advocacy & Therapeutic Presence Cache
#
# Watson caring science, Benner novice-to-expert, moral distress, end-of-life advocacy, and cultural humility.

#>spw_cache_univ_nursing_ethics
#:cache #!ethical_care_and_therapeutic_presence
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the philosophical foundations of nursing caring science, patient advocacy against clinical hierarchy, end-of-life palliative ethics, and trauma-informed relational presence."
  ~#protocol: "cache.layer/1"
}

^"caring_science_and_experiential_know_how"{
  "watson_transpersonal_caring_and_benner": .{
    jean_watson_caritas_processes: "Caring is the moral ideal and ontological core of nursing, distinct from medical curing; transpersonal caring honoring mind-body-spirit wholeness through authentic presence",
    patricia_benner_from_novice_to_expert: "Skill acquisition stages: Novice, Advanced Beginner, Competent, Proficient, and Expert; progression from rule-governed textbook rigidity to intuitive perceptual grasp and clinical know-how rooted in rich paradigm cases",
  }[reg=facet],
  "therapeutic_communication_and_relational_presence": .{
    unhurried_relational_attunement: "Therapeutic listening, reflective validation, open-ended inquiry, and intentional silence; holding non-judgmental space for patients confronting catastrophic diagnosis or bereavement",
  }[reg=facet],
}

^"clinical_ethics_advocacy_and_moral_distress"{
  "patient_autonomy_and_end_of_life_advocacy": .{
    autonomous_decision_making: "Advocating for patient self-determination: advance directives, DNR/DNI orders, and POLST/MOLST execution; preventing non-beneficial aggressive interventions when palliative comfort is requested",
    principle_of_double_effect: "Administering high-dose intravenous opioids for intractable dyspnea and pain in terminal dying: ethically justified when primary intention is comfort, even if respiratory depression is an anticipated secondary consequence",
  }[reg=facet],
  "mitigating_moral_distress_and_trauma_informed_care": .{
    moral_distress_in_healthcare_hierarchies: "Andrew Jameton framework: moral distress arising when the nurse identifies the ethically sound course of action but is constrained by institutional policy, legal fear, or medical hierarchies; moral courage and institutional ethics committees",
    cultural_humility_and_trauma_informed_practice: "Rejecting checklist cultural stereotyping in favor of lifelong self-reflection; trauma-informed care: recognizing trauma histories, ensuring physical/psychological safety, and actively preventing re-traumatization during clinical procedures",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_univ_nursing_ethics_1
  ?["How does the physical, non-verbal presence of a nurse silently holding a dying patient's hand alter neurobiological markers of distress during active withdrawal of life support?"]{
    #:depth #!relational ~#lens(transpersonal_autonomic_co_regulation)
    ~#hypothesis: "Human beings possess an evolutionary social autonomic nervous system (Porges polyvagal theory). Unhurried, calm, compassionate physical human contact stimulates unmyelinated C-tactile afferent fibers, activating oxytocinergic pathways and dampening sympathetic catecholamine surges, reducing terminal respiratory agitation and inducing physiological peace without pharmacologic intervention."
    !probe{ "Measure heart-rate variability (RMSSD) and skin conductance levels in non-verbal comatose patients during peaceful palliative extubation with vs without continuous nursing hand contact." }
    $%[autonomic.hrv_parasympathetic_recovery_percentage, palliative.terminal_agitation_score]
  }
}
