# Undergraduate Animation Principles & Craft Curricular Architecture
#
# Bachelor of Fine Arts (B.F.A.) in Animation: the 12 principles of animation, 2D hand-drawn mechanics, 3D rigging, and storyboarding.

#>spw_cache_univ_undergrad_animation
#:cache #!animation
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the four-year undergraduate curriculum for a Bachelor of Fine Arts in Animation, articulating physical timing, spacing arcs, 2D/3D character performance, and cinematic animatic assembly."
  ~#accreditation: "NASAD Guidelines for Bachelor of Fine Arts in Animation"
}

^["the_twelve_principles_of_classical_animation"]{
  freshman_sophomore_gateway: "Principles of Character Animation Laboratory."
  canonical_principles: #[
    "Squash & Stretch: Preserving consistent three-dimensional volume while deforming mass to express organic elasticity and impact force",
    "Anticipation & Staging: Anatomic pre-action preparing the audience's eye; positioning characters for instantaneous silhouette clarity",
    "Timing & Spacing: Frame count governing physical mass (heavy bowling ball vs light rubber ball); spacing charts dictating acceleration",
    "Slow-In & Slow-Out: Spacing drawings closer together near key poses to simulate inertia deceleration and acceleration",
    "Arcs & Secondary Action: Ensuring natural limb trajectories follow curved geometric paths; adding hair and tail drag to amplify the main action",
    "Follow-Through & Overlapping Action: Terminating movement through staggered joint momentum dissipation rather than stopping all parts at once"
  ]
}

^["traditional_two_dimensional_hand_drawn_craft"]{
  sophomore_junior_core: "2D Character Animation and Walk Cycle Mechanics."
  traditional_disciplines: .{
    frame_rate_conventions: #[
      "Shooting on Ones (24 distinct drawings per second) for rapid chaotic motion; Shooting on Twos (12 drawings held for two frames) for dialogue and normal acting",
      "Exposure Sheets (X-Sheets): Mapping frame-by-frame dialogue phonemes, camera moves, and multiple drawing cel levels"
    ]
    locomotion_cycles: #[
      "Walk Cycle Anatomy: Contact pose, down (compression), passing position, and up (peak recoil) with accurate hip drop and arm counter-swing",
      "Run Cycles: Flight (airborne) phases, aggressive forward lean, and rapid foot impact deformation"
    ]
    facial_lip_sync: "Phonemic mouth shape breakdown (A/E open, O/U rounded, M/B/P closed, F/V lip-bite) synchronized two frames ahead of heard audio"
  }[reg=facet]
}

^["three_dimensional_computer_animation_and_rigging"]{
  junior_core: "3D Digital Character Animation and Kinematics."
  digital_pipeline: .{
    graph_editor_mastery: "Manipulating Bezier animation curve tangents, flat tangent overshoots, stepped blocking passes, and gimbal lock avoidance"
    rigging_and_kinematics: #[
      "Forward Kinematics (FK) for hierarchical rotational arcs; Inverse Kinematics (IK) for grounded foot/hand contact with pole vector targets",
      "Skinning & Weight Painting: Smooth binding and component editor vertex normalization across joint bending zones",
      "Facial Rigs: Blendshape target sculpting and corrective shape interpolation driven by face controllers"
    ]
  }[reg=facet]
}

^["storyboarding_cinematography_and_animatics"]{
  junior_senior_core: "Cinematic Storyboarding and Editorial Pacing."
  cinematic_frameworks: #[
    "Camera Language: Establishing shots, medium two-shots, Dutch angles, tracking dollies, and the inviolable 180-degree spatial line",
    "Beat Boards to Production Storyboards: Translating script emotion into clear visual beats with camera arrows and action directions",
    "Animatic Assembly: Cutting storyboard panels into time-accurate animatics with scratch dialogue, foley sound effects, and temp musical score"
  ]
}

^["lighting_rendering_and_compositing"]{
  senior_core: "Visual Aesthetics and Digital Output."
  rendering_pipeline: #[
    "Cinematic Lighting: Three-point lighting (key, fill, rim/backlight) and color temperature contrast establishing mood and depth",
    "Physically Based Shading: Subsurface scattering (SSS) for skin and wax, specular roughness, and Fresnel edge reflection",
    "Node-Based Compositing: Multi-pass beauty rendering (diffuse, specular, ambient occlusion, z-depth) composited and color-graded in Nuke or After Effects"
  ]
}

^["taste"]{
  ~#taste: "Animation is the illusion of life: the moment a drawn sketch appears to make a voluntary decision to move, a miracle has occurred."
  ~#wonder: "Why does adding a tiny two-frame delay between an eye dart and a head turn make a digital character look like it is genuinely thinking?"

  principles: #[
    "Acting is thinking: A character must not simply move through physical space; the audience must see the character make choices before moving.",
    "Weight reveals character: How an animated figure sits down in a chair tells you their age, social class, and emotional burden in two seconds.",
    "Restraint over hyper-activity: The most powerful moments in animation are often the quiet holds where a character simply breathes and absorbs a realization."
  ]
}

^"invariants"{
  "Animation timing must preserve consistent volume throughout squash and stretch decompressions.",
  "Scene cuts must preserve the 180-degree axis of action unless a clear camera move establishes new spatial orientation.",
  "Final rendered projects must maintain audio-video synchronization with zero dropped frames across target delivery frame rates."
}

#>wonder_undergrad_animation_1
?["How does the timing of an eye blink relative to a head turn alter audience perception of character sincerity?"]{
  #:depth #!psychological ~#lens(subconscious_acting_cues)
  ~#hypothesis: "Blinks that occur immediately before a head turn signal honest, reflective cognitive processing, whereas blinks occurring during mid-turn signal nervous deception or cognitive overload to human observers."
  !probe{ "Measure audience eye-tracking and character trustworthiness ratings on identical 3D dialogue scenes with variable blink micro-timings." }
  $%[psychology.character_trust_score, timing.blink_offset_frames]
}
