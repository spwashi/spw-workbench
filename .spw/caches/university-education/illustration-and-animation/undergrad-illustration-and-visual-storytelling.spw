# Undergraduate Illustration & Visual Storytelling Curricular Architecture
#
# Bachelor of Fine Arts (B.F.A.) in Illustration: observational drawing, anatomical structure, visual development, and editorial metaphor.

#>spw_cache_univ_undergrad_illustration
#:cache #!illustration
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the four-year undergraduate curriculum for a Bachelor of Fine Arts in Illustration, articulating anatomical figure drawing, pictorial composition, concept art, and sequential narrative craft."
  ~#accreditation: "NASAD Guidelines for Bachelor of Fine Arts in Illustration"
}

^["observational_drawing_and_anatomical_architecture"]{
  freshman_sophomore_core: "Structural Life Drawing and Spatial Perspective."
  draftsmanship_foundations: #[
    "Skeletal & Muscular Landmarking: Pelvic tilt, thoracic cage volume, acromion process, and major muscle origin/insertion mechanics",
    "Dynamic Gesture & Force Lines: Quick-pose 30-second gestural studies, contrapposto balance, and fluid lines of action expressing inner life",
    "Head & Facial Construction: Loomis and Reilly rhythm lines, plane breakdown of the face, and expressive oculofacial deformation",
    "Spatial Perspective Geometry: 1, 2, and 3-point linear perspective, vanishing points, measuring points, and 5-point curvilinear fish-eye grids"
  ]
}

^["visual_development_and_concept_art"]{
  sophomore_junior_core: "Character and Environment Design for Entertainment Media."
  concept_methodologies: .{
    shape_language_and_silhouettes: #[
      "Geometric Archetypes: Circles communicating warmth and innocence; squares projecting stability and stubbornness; triangles conveying speed or malice",
      "Silhouette Readability: Pure black silhouette test ensuring unmistakable pose, prop, and character identification at postage-stamp scale"
    ]
    color_and_lighting_scaffolding: #[
      "Notan Value Studies: Two-tone and three-tone graphic balance establishing clear hierarchy before color introduction",
      "Gamut Masking & Temperature: Warm key lights casting cool chromatic shadows; ambient bounce illumination and subsurface scattering",
      "Atmospheric Depth: Aerial perspective desaturation, value compression, and edge softness across foreground, midground, and background planes"
    ]
  }[reg=facet]
}

^["traditional_and_digital_medium_mastery"]{
  junior_core: "Materials, Pigments, and Digital Craft Laboratory."
  mediums_suite: #[
    "Traditional Wet Media: Transparent watercolor wet-on-wet glazing, opaque gouache matte layering, and archival cotton rag paper preparation",
    "Traditional Inking & Printmaking: Dip pen crowquill crosshatching, dry-brush brushwork, linocut relief, and copperplate etching",
    "Digital Painting & Raster Craft: Pressure-sensitive stylus curve calibration, custom brush texture synthesis, non-destructive layer masks, and CMYK color separations"
  ]
}

^["editorial_metaphor_and_sequential_narrative"]{
  junior_senior_core: "Narrative Illustration and Professional Studio Practice."
  narrative_craft: .{
    editorial_ideation: "Translating abstract economic or philosophical essays into biting, poetic single-image visual metaphors that enrich text rather than merely decorate it"
    children_book_architecture: #[
      "The Page Turn: Pacing visual revelations across 32-page standard book dummies; gutter margin avoidance and full-bleed compositional rhythms",
      "Text-Image Counterpoint: Allowing images to tell what the words omit, creating dramatic irony and humor"
    ]
    sequential_graphic_novels: "Panel transitions (action-to-action, aspect-to-aspect), tier pacing, dialogue balloon eye-tracking vectors, and cinematic wide-angle establishing panels"
  }[reg=facet]
}

^["professional_portfolio_and_studio_ethics"]{
  senior_culmination: "Senior Degree Portfolio Exhibition and Industry Review."
  professional_invariants: #[
    "Industry-Ready Body of Work: Curating 15-20 cohesive, stylistically mature portfolio pieces targeting specific editorial, publishing, or gaming markets",
    "Business of Art: Contract negotiation, copyright licensing vs work-for-hire rights, invoice tracking, and freelance self-employment accounting",
    "Creative Authorship Ethics: Respecting intellectual property, refusing generative image scraping theft, and maintaining personal creative voice"
  ]
}

^["taste"]{
  ~#taste: "Illustration is the visual voice of the human heart: a single drawing can pierce through cynicism where a thousand paragraphs fail."
  ~#wonder: "Why does a single hand-drawn line made with ink on paper convey the weight of sadness more instantly than a hyper-realistic photograph?"

  principles: #[
    "Concept over rendering: A beautifully rendered drawing of a boring idea is still boring; a rough thumbnail of a brilliant concept can change the world.",
    "Anatomy serves expression: Master human anatomy not to draw medical charts, but so you can distort and stretch the body without losing its organic truth.",
    "Eliminate visual noise: Every stroke that does not contribute to the narrative focus weakens the emotional power of the image."
  ]
}

^"invariants"{
  "Editorial concepts must provide original metaphorical interpretation rather than literal depiction of the headline text.",
  "Digital artwork intended for print publication must be formatted at 300+ DPI within standard print CMYK color profiles.",
  "Figure drawing portfolios must demonstrate observational anatomical mastery from live models before presenting stylized cartoons."
}

#>wonder_undergrad_illustration_1
?["How does the practice of limited 3-color palette painting constrain and elevate student compositional harmony?"]{
  #:depth #!aesthetic ~#lens(chromatic_discipline)
  ~#hypothesis: "Restricting students to the Zorn palette (Titanium White, Yellow Ochre, Cadmium Red, Ivory Black) forces 45% faster mastery of tonal value relationships and skin undertones than granting unrestricted access to 24-color palettes."
  !probe{ "Assess value hierarchy accuracy and blind faculty aesthetic rankings of student portraits executed with Zorn vs full spectrum palettes." }
  $%[pedagogy.value_control_accuracy_score, aesthetics.chromatic_cohesion_rating]
}
