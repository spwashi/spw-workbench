# Undergraduate Theatre & Dramatic Arts Curricular Architecture
#
# Bachelor of Fine Arts (B.F.A.) in Theatre: Stanislavskian acting, Meisner repetition, Viewpoints, scenography, and dramaturgy.

#>spw_cache_univ_undergrad_theatre
#:cache #!theatre
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the four-year undergraduate curriculum for a Bachelor of Fine Arts in Theatre and Dramatic Arts, articulating embodied acting training, script analysis, stagecraft scenography, and theatre history."
  ~#accreditation: "National Association of Schools of Theatre (NAST) Accreditation Standards"
}

^["acting_methodologies_and_vocal_instrumentation"]{
  freshman_sophomore_core: "Acting Foundations, Voice, and Movement Studios."
  acting_disciplines: #[
    "The Stanislavski System: Action analysis, given circumstances, the 'Magic If', objectives, obstacles, tactics, and active psychophysical actions",
    "Meisner Repetition Craft: Spontaneous observation, repetition exercises, emotional preparation, and living truthfully under imaginary circumstances",
    "Physical Movement & Viewpoints: Anne Bogart's Nine Viewpoints (spatial relationship, kinesthetic response, shape, gesture, architecture, tempo, duration, repetition, topography)",
    "Suzuki Actor Training: Lower body stomp discipline, pelvic center grounding, breath control, and sustaining intense physical stage presence",
    "Voice & Speech: Kristin Linklater vocal progression (freeing the natural voice), diaphragmatic breath support, and IPA phonetic dialect acquisition"
  ]
}

^["directing_script_analysis_and_blocking"]{
  junior_core: "Stage Directing and Textual Dramaturgy."
  directing_methods: .{
    textual_architecture: "David Ball's backwards-and-forwards structural script analysis: identifying triggering events, sequential heaps, and character objectives"
    spatial_blocking_and_composition: #[
      "Stage Geometries: Directing for proscenium arches, thrust stages, and black box arena configurations; sightline and acoustic optimization",
      "Picturization & Visual Dynamics: Stage planes (upstage/downstage), triangulation, body positions (full front, profile), and movement tempos"
    ]
    collaborative_leadership: "Facilitating productive rehearsal tables, establishing trust with actors, and collaborating with designers"
  }[reg=facet]
}

^["scenography_stagecraft_and_technical_production"]{
  sophomore_junior_core: "Scenic, Lighting, Sound, and Costume Design."
  technical_disciplines: #[
    "Scenic Design & Drafting: Architectural ground plans, section elevations, 1/4-inch scaled spatial white models, and scenic painting textures",
    "Stage Lighting Design: Photometric beam angles, instrument types (Fresnels, Ellipsoidal ERS, moving LED fixtures), DMX512 control, and cue writing",
    "Theatrical Sound Engineering: Live reinforcement acoustics, wireless lavalier placement, spatial audio zoning, and QLab cue programming",
    "Stage Management (SM): Creating the production prompt book ('The Bible'), calling cues (warn, stand by, go), rehearsal logs, and Actors' Equity rules"
  ]
}

^["theatre_history_dramaturgy_and_dramatic_literature"]{
  junior_senior_core: "Dramatic Canon, Classical Traditions, and Contemporary Horizons."
  historical_arcs: .{
    classical_to_modern: #[
      "Classical Antiquity: Greek tragic structure (Sophocles, Euripides), chorus function, Aristotle's Poetics (mimesis, hamartia, catharsis)",
      "Early Modern & Renaissance: Elizabethan verse speaking, iambic pentameter scansion, and Commedia dell'arte masked stock archetypes",
      "Realism & Naturalism: Ibsen, Strindberg, and Anton Chekhov's Moscow Art Theatre subtextual innovations"
    ]
    twentieth_century_revolutions: #[
      "Epic Theatre: Bertolt Brecht's Verfremdungseffekt (alienation effect), historicization, and political gestus",
      "Theatre of the Absurd: Samuel Beckett, Eugene Ionesco, and existential dramatic structures",
      "Contemporary American Canon: August Wilson's Century Cycle, Tony Kushner, Suzan-Lori Parks, and diverse documentary theatre"
    ]
  }[reg=facet]
}

^["taste"]{
  ~#taste: "Theatre is the sacred art of human presence: an unrepeatable covenant forged between living actors and breathing audiences in the dark."
  ~#wonder: "Why does speaking five-hundred-year-old iambic pentameter lines written by Shakespeare alter an actor's cardiac rhythm and respiratory rate?"

  principles: #[
    "Action over mood: An actor must never play a general emotion; an actor plays an urgent physical action directed at changing the other person.",
    "Listen before speaking: The scene happens in the listening; if you are not genuinely hearing your scene partner, you are merely reciting lines.",
    "Spatial truth: Every step an actor takes across the stage must be motivated by an internal dramatic necessity."
  ]
}

^"invariants"{
  "Stage combat and physical stunts must be choreographed by certified fight directors and rehearsed at half-speed before every performance.",
  "Stage lighting and rigging operations must comply with theatrical load-bearing weight limits and fall-protection safety protocols.",
  "Student acting assessments must evaluate partner responsiveness and objective pursuit rather than isolated emotional display."
}

#>wonder_undergrad_theatre_1
?["How does the daily practice of Suzuki foot-stomping exercises alter an actor's vocal resonance and diaphragmatic stability?"]{
  #:depth #!somatic ~#lens(psychophysical_grounding)
  ~#hypothesis: "Training in Suzuki lower-body stamping strengthens pelvic floor and transverse abdominis engagement, increasing vocal formant projection by 4 dB while lowering heart-rate variability spikes during high-stress tragic monologues."
  !probe{ "Measure acoustic decibel output, vocal tract resonance, and autonomic heart-rate variability in actors before and after a 12-week Suzuki movement intensive." }
  $%[voice.projection_decibels_db, physiology.stage_fright_hrv_delta]
}
