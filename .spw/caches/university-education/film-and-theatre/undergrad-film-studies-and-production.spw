# Undergraduate Film Studies & Production Curricular Architecture
#
# Bachelor of Fine Arts (B.F.A.) in Film: cinematic grammar, screenwriting structure, camera direction, cinematography, and editing.

#>spw_cache_univ_undergrad_film
#:cache #!film_studies
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the four-year undergraduate curriculum for a Bachelor of Fine Arts in Film Studies and Production, articulating film history, three-act screenwriting, camera blocking, cinematography, and post-production editing."
  ~#accreditation: "NASAD and University Film and Video Association (UFVA) Standards"
}

^["film_history_and_formal_cinematic_analysis"]{
  freshman_sophomore_gateway: "History of World Cinema and Film Grammar Analysis."
  historical_movements: #[
    "Soviet Montage Theory: The Kuleshov effect (juxtaposition generating new psychological meaning) and Eisenstein's collision montage",
    "German Expressionism: Chiaroscuro high-contrast lighting, psychological exteriorization, and fractured geometric architectural sets",
    "Classical Hollywood Continuity System: Spatial grammar (180-degree rule, 30-degree rule, match-on-action, eyeline matches, shot-reverse-shot)",
    "Italian Neorealism & French New Wave: On-location real-life shooting, non-professional casting, Godardian jump cuts, and Truffaut's auteur policy",
    "Global & Postcolonial Cinema: Latin American Third Cinema, Japanese Golden Age (Kurosawa, Ozu), and the Iranian New Wave"
  ]
}

^["screenwriting_fundamentals_and_story_architecture"]{
  sophomore_core: "Screenwriting I & II."
  scriptwriting_mechanics: .{
    narrative_structure: #[
      "Three-Act Paradigm: Inciting incident, plot points 1 and 2, midpoint reversal, all-hope-is-lost climax, and resolution",
      "Character Psychology: Internal psychological need vs external conscious want; active pursuit of objectives driving plot",
      "Scene Engineering: Entering scenes late and leaving early; micro-tension, power shifts, and subtextual dialogue economy"
    ]
    industry_formatting: "Standard Master Scene Format (Courier 12pt, sluglines EXT/INT, action description, parentheticals, and dialogue)"
  }[reg=facet]
}

^["directing_the_actor_and_visual_mise_en_scene"]{
  junior_core: "Directing for the Camera Studio."
  directorial_craft: #[
    "Directing Actors for the Lens: Translating broad theatrical energy into microscopic cinematic subtext suitable for tight 85mm close-ups",
    "Action-Verb Direction: Avoiding result-oriented notes ('be sadder') in favor of playable physical verbs ('guilt-trip her', 'seduce him')",
    "Visual Staging & Coverage: Designing master shots, over-the-shoulders, inserts, and motivated camera movement (dolly tracking, push-ins)"
  ]
}

^["cinematography_optics_and_lighting_craft"]{
  junior_core: "Cinematography and Lighting Laboratory."
  camera_and_lighting: .{
    exposure_mechanics: "Sensor ISO sensitivity, 180-degree shutter angle (motion blur standards), T-stops, and neutral density (ND) filtration"
    lighting_setups: #[
      "Three-Point Foundations: Key, fill, and hair/rim backlighting; lighting contrast ratios (key-to-fill ratios 2:1 vs 8:1 noir)",
      "Modern Soft-Source Craft: Book lighting, large diffusion frames (8x8 silk), bounce sources, and negative fill absorbing unwanted spill"
    ]
    optical_perspective: "Focal length character: 24mm wide-angle dynamic expansion vs 100mm telephoto spatial compression and shallow depth of field"
  }[reg=facet]
}

^["post_production_picture_and_sound_editing"]{
  senior_core: "Digital Editing, Sound Design, and Color Grading."
  post_production_suite: #[
    "Picture Editing: Assembly edit, rough cut, fine cut, and picture lock in NLE suites (Avid Media Composer / Premiere Pro / DaVinci Resolve)",
    "The Grammar of the Cut: Walter Murch's Rule of Six (emotion, story, rhythm, eye-trace, two-dimensional screen plane, three-dimensional space)",
    "Sound Design Architecture: Dialogue cleanup, automated dialogue replacement (ADR), Foley footsteps, atmospheric room tone, and spatial mix",
    "Color Grading: Primary color wheels (lift, gamma, gain), Rec.709 vs Log color spaces, ACES color management, and LUT application"
  ]
}

^["taste"]{
  ~#taste: "Cinema is the art of sculpting in time: organizing light, shadow, and human faces so that thirty seconds feel like an eternity."
  ~#wonder: "Why does cutting between an actor's neutral expression and a bowl of soup make the audience believe the actor is intensely hungry?"

  principles: #[
    "Show, never tell: If an emotion or plot point can be communicated through a look, a prop, or a shadow, strike the dialogue line.",
    "Sound is half the film: Poor picture quality is forgiven as stylistic choice; poor sound recording is immediately recognized as amateurish.",
    "Respect the cut: Every edit forces the viewer's brain to reconstruct spatial orientation; cut only when the emotion demands a shift in perspective."
  ]
}

^"invariants"{
  "Film sets must adhere to strict fire safety, electrical cable tie-down, and C-stand sandbagging procedures.",
  "Digital cinema camera sensor white balances must be calibrated using standard 18% gray cards before recording production takes.",
  "Student screenplays must present active protagonists with clear visual external goals and internal obstacles.",
}

#>wonder_undergrad_film_1
?["How does the choice between handheld camera movement vs a rigid mechanical dolly alter audience empathy during dramatic dialogue?"]{
  #:depth #!aesthetic ~#lens(camera_kinetics_empathy)
  ~#hypothesis: "Organic micro-movements of an experienced handheld camera operator mirror human subconscious respiratory rhythms, inducing 25% higher emotional immersion during intimate scenes than mathematically perfect linear dolly tracks."
  !probe{ "Conduct eye-tracking and galvanic skin conductance measurements on viewers watching identical dialogue scenes filmed with handheld vs dolly tracking." }
  $%[cinematography.viewer_immersion_index, physiology.emotional_galvanic_response]
}
