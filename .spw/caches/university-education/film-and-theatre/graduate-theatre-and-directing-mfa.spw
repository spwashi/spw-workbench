# Graduate Master's Theatre Directing (M.F.A.) Curricular Architecture
#
# Terminal Master of Fine Arts (M.F.A.) in Directing: auteur stage vision, Chekhov psychological gesture, new play development, and thesis production.

#>spw_cache_univ_grad_theatre_mfa
#:cache #!theatre
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the terminal Master of Fine Arts (M.F.A.) curriculum in Stage Directing, articulating auteur conceptual vision, advanced psychophysical actor training, new play dramaturgy, and fully realized mainstage production."
  ~#degree_culmination: "Fully Staged Mainstage Thesis Production, Comprehensive Written Director's Book, and Oral Faculty Defense"
}

^["auteur_stage_directing_and_conceptual_vision"]{
  graduate_depth: "Developing cohesive, radical conceptual visions for classical and contemporary dramatic texts."
  directorial_methodologies: #[
    "Classical Reinterpretation: Radically deconstructing classical Greek or Shakespearean texts to illuminate contemporary socio-political crises without destroying poetic meter",
    "Conceptual Metaphor into Spatial Design: Translating abstract themes into tactile physical environments in collaboration with scenic and lighting designers",
    "Table Work Rigor: Leading intensive textual interrogations with actors, analyzing word origins, subtextual power structures, and emotional beats"
  ]
}

^["advanced_psychophysical_actor_pedagogy"]{
  embodied_mastery: "Master-level physical and psychological acting methodologies."
  advanced_training: .{
    michael_chekhov_technique: "The Psychological Gesture: Synthesizing an entire character's subconscious longing into an archetypal physical movement that spontaneously awakens inner feeling"
    grotowski_poor_theatre: "The 'Via Negativa': Eradicating muscular blocks, psychic resistance, and vanity to achieve total transparency between the actor's soul and physical body"
    lecoq_physical_mask: "Neutral mask training cultivating physical economy; larval masks and commedia archetypes discovering organic comedic timing"
  }[reg=facet]
}

^["new_play_development_and_playwright_collaboration"]{
  dramaturgical_craft: #[
    "The Director-Playwright Partnership: Nurturing new scripts from initial table read through multiple staged workshop iterations while fiercely protecting the writer's authentic voice",
    "Dramaturgical Casebook Production: Assembling deep cultural, historical, and linguistic research dossiers to ground the cast in the world of the play",
    "Devised Theatre Creation: Generating original performance texts from scratch through ensemble improvisation, movement experiments, and documentary interview material"
  ]
}

^["immersive_site_specific_and_digital_scenography"]{
  contemporary_frontiers: #[
    "Environmental & Immersive Staging: Dissolving the proscenium arch, designing 360-degree participatory worlds, and orchestrating non-linear audience pathways",
    "Digital Scenography & Projection Mapping: Integrating real-time interactive media, infrared performer tracking, and dynamic virtual backdrops into physical stage environments"
  ]
}

^["mfa_thesis_production_and_professional_showcase"]{
  terminal_milestone: "Full mainstage production leadership."
  production_components: #[
    "Full-Scale Production: Directing a fully mounted public production with professional design budgets, Equity guest artists, and technical crews",
    "Comprehensive Director's Book: Documenting script annotations, rehearsal journals, blocking diagrams, dramaturgical essays, and critical production reviews",
    "Industry Showcase: Auditioning and presenting graduating directing and acting cohorts to artistic directors, casting agents, and theatre producers"
  ]
}

^["taste"]{
  ~#taste: "Master's-level directing is the art of invisible architecture: shaping every breath, shadow, and pause so that the production feels like an organic, spontaneous act of life."
  ~#wonder: "Why does stripping a stage down to bare wooden boards often generate far greater emotional terror and wonder than a multimillion-dollar revolving scenic set?"

  principles: #[
    "Trust the actor's intuition: A great director does not impose choreography like a drill sergeant; they create the conditions where the actor discovers the action.",
    "Serve the story, not your ego: The moment a director's clever concept obscures the human truth of the playwright's characters, the production has failed.",
    "Breathe with the room: A live theatre performance is an acoustic circuit; the director teaches the actors to listen to the silence of the audience."
  ]
}

^"invariants"{
  "M.F.A. directing candidates must lead complete production processes from initial design concepts through post-show evaluation.",
  "Rehearsal room environments must adhere to professional codes of conduct, intimacy boundaries, and respectful ensemble collaboration.",
  "Directorial concept statements must articulate historical relevance, aesthetic rationale, and spatial staging strategies."
}

#>wonder_grad_theatre_mfa_1
?["How does the deployment of Michael Chekhov's Psychological Gesture alter an actor's galvanic stress response during intense tragic breakdowns?"]{
  #:depth #!somatic ~#lens(psychophysical_transference)
  ~#hypothesis: "Grounding traumatic character breakdown in an abstract physical gesture (rather than triggering personal traumatic autobiographical memory) enables actors to produce authentic emotional catharsis while reducing post-performance cortisol recovery latency by 60%."
  !probe{ "Measure salivary cortisol levels and post-show emotional grounding scores in MFA actors utilizing Chekhov Psychological Gestures vs emotional memory techniques during King Lear or Medea performances." }
  $%[somatic.cortisol_recovery_minutes, performance.audience_emotional_impact_rating]
}
