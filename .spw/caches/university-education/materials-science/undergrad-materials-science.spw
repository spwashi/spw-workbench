# Undergraduate Materials Science Curricular Architecture
#
# ABET-accredited Bachelor of Science (B.S.) in Materials Science and Engineering: crystallography, thermodynamics, phase transformations, and mechanical behavior.

#>spw_cache_univ_undergrad_mse
#:cache #!materials_science
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the four-year undergraduate curriculum for an ABET-accredited Bachelor of Science in Materials Science and Engineering, articulating atomic lattices, phase transformations, dislocation mechanics, and functional materials."
  ~#accreditation: "ABET EAC Criteria for Materials, Metallurgical, and Ceramics Engineering"
}

^["crystallography_and_diffraction_fundamentals"]{
  sophomore_gateway: "Structure of Materials and X-Ray Diffraction Laboratory."
  crystallographic_core: #[
    "Lattice Geometry & Symmetry: 14 Bravais lattices, 7 crystal systems, point groups, space groups, and close-packed geometries (FCC, HCP, BCC)",
    "Miller Indices & Reciprocal Space: Direction indices [uvw], plane indices (hkl), zone axes, reciprocal lattice basis vectors, and interplanar d-spacings",
    "X-Ray Diffraction Physics: Bragg's law (lambda = 2*d*sin theta), atomic form factors, and crystallographic structure factor F_hkl extinction rules",
    "Diffraction Analysis: Powder XRD peak indexing, lattice parameter determination, Scherrer equation crystallite size estimation, and texture analysis"
  ]
}

^["thermodynamics_and_phase_equilibria_of_materials"]{
  sophomore_junior_core: "Thermodynamics of Materials and Phase Diagrams."
  thermodynamic_formalisms: .{
    solution_thermodynamics: "Gibbs free energy of mixing, regular solution models, interaction parameter Omega, enthalpy/entropy competition, and chemical potentials"
    phase_rule_and_diagrams: #[
      "Gibbs Phase Rule (F = C - P + 2) and Lever rule for phase fraction calculations",
      "Binary Phase Topologies: Isomorphous systems, eutectic reactions, peritectic reactions, and intermetallic compound formation",
      "Iron-Carbon System (Fe-Fe3C): Ferrite (alpha), austenite (gamma), cementite (Fe3C), pearlite eutectoid microstructure, and carbon solubility limits"
    ]
    spinodal_decomposition: "Free energy curvature (d2G/dx2 < 0), uphill diffusion, coherent vs incoherent spinodal boundaries, and modulated microstructures"
  }[reg=facet]
}

^["kinetics_and_phase_transformations_in_solids"]{
  junior_core: "Diffusion and Solid-State Phase Transformations."
  kinetic_mechanisms: #[
    "Solid-State Diffusion: Fick's first and second laws, vacancy vs interstitial diffusion mechanisms, temperature dependence (Arrhenius), and the Kirkendall effect",
    "Nucleation Thermodynamics: Homogeneous nucleation critical radius r* and barrier Delta-G*, heterogeneous nucleation on grain boundaries, and contact angles",
    "Transformation Kinetics: Johnson-Mehl-Avrami-Kolmogorov (JMAK) sigmoidal growth kinetics, Time-Temperature-Transformation (TTT) and CCT diagrams",
    "Diffusionless Transformations: Martensitic transformation in steels, athermal habit planes, Kurdjumov-Sachs orientation relationships, and shape-memory alloys"
  ]
}

^["mechanical_behavior_and_dislocation_theory"]{
  junior_core: "Mechanical Properties and Deformation Mechanics."
  deformation_physics: .{
    dislocation_mechanics: #[
      "Edge and screw dislocations, Burgers vector b, slip planes and slip systems, Schmid's law, and resolved shear stress",
      "Dislocation Line Energy & Peierls-Nabarro Stress: Lattice resistance to dislocation motion across FCC, BCC, and covalent lattices",
      "Dislocation interactions: Frank-Read dislocation multiplication sources, pileups, cross-slip, and forest dislocation intersections"
    ]
    strengthening_mechanisms: #[
      "Hall-Petch grain boundary strengthening (yield strength scaling with d^(-1/2))",
      "Solid solution strengthening (Cottrell atmospheres, elastic modulus/size mismatch)",
      "Precipitation hardening: Orowan dislocation looping vs particle shearing (Guinier-Preston zones, coherent precipitates in Al-Cu alloys)",
      "Work hardening: Taylor flow stress scaling with square root of dislocation density"
    ]
    fracture_and_high_temp: "Griffith crack criterion, plane strain fracture toughness K_IC, Ductile-to-Brittle Transition Temperature (DBTT), and power-law dislocation creep"
  }[reg=facet]
}

^["functional_electronic_optical_and_magnetic_materials"]{
  senior_core: "Physical Properties of Materials."
  functional_domains: #[
    "Band Theory: Free electron model, Kronig-Penney periodic potential, energy bandgaps, and effective mass m*",
    "Semiconductor Physics: Direct vs indirect bandgaps, intrinsic carrier concentrations, donor/acceptor shallow impurities, and p-n junction space-charge layers",
    "Dielectrics & Ferroelectrics: Electronic, ionic, and orientational polarization, Curie-Weiss law, and perovskite barium titanate (BaTiO3) domain switching",
    "Magnetic Materials: Ferromagnetism, Curie temperature, exchange coupling, magnetic anisotropy, domain wall dynamics, and soft vs hard magnetic materials"
  ]
}

^["polymers_ceramics_and_biomaterials"]{
  senior_core: "Non-Metallic and Soft Materials."
  materials_classes: #[
    "Polymers: Linear, branched, and network topologies; glass transition temperature (Tg), degree of crystallinity, spherulitic growth, and rubber elasticity",
    "Ceramics: Rock salt (NaCl), zinc blende (ZnS), fluorite (CaF2), and perovskite (CaTiO3) lattices; Schottky and Frenkel point defects; solid-state sintering",
    "Biomaterials: Biocompatibility, protein adsorption, titanium osseointegration, bio-resorbable polymers (PLA, PGA), and synthetic hydroxyapatite scaffolds"
  ]
}

^["taste"]{
  ~#taste: "Undergraduate materials science is the revelation that the physical world is not continuous matter, but a vast, orderly crystal palace governed by periodic symmetry and illuminated by defects."
  ~#wonder: "Why is a perfectly flawless crystal brittle and fragile, while a metal riddled with billions of dislocation defects is ductile, tough, and capable of forming the hull of a ship?"

  principles: #[
    "Defects dictate reality: Pure crystals are theoretical abstractions; every useful property in engineering (strength, electrical conductivity, optical emission) is governed by vacancies, dislocations, and dopants.",
    "Processing controls microstructure: Two pieces of steel with identical chemical composition can have radically different strengths based solely on how fast they were quenched from 900 degrees Celsius.",
    "Characterization is truth: You cannot control what you cannot image and measure at the nanoscale."
  ]
}

^"invariants"{
  "All reported crystal structures must specify space group symmetry, lattice parameters, and basis atom fractional coordinates.",
  "Calculations of phase equilibrium must confirm coexistence by equality of chemical potentials across all phases.",
  "Tensile and fracture test specimens must conform strictly to ASTM standard geometries and loading rates.",
}

#>wonder_undergrad_mse_1
?["How does the physical manipulation of ball-and-stick crystal models compare to digital CAD in teaching junior dislocation slip geometry?"]{
  #:depth #!pedagogical ~#lens(haptic_crystallography)
  ~#hypothesis: "Students who physically construct close-packed FCC/HCP hard-sphere models and manually propagate dislocation lines identify active slip planes with 35% higher accuracy than peers trained exclusively on desktop molecular rendering software."
  !probe{ "Benchmark student identification of Schmid factor slip planes under multi-axial stress states across physical-tactile vs screen-only crystallography cohorts." }
  $%[pedagogy.slip_system_accuracy_rate, haptics.spatial_slip_retention]
}
