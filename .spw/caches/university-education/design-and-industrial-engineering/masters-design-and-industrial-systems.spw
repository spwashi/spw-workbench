# Graduate Master's Design & Industrial Systems Architecture
#
# Master of Science (M.S.) in Industrial & Systems Engineering: stochastic supply networks, cognitive human factors, digital twins, and healthcare systems.

#>spw_cache_univ_masters_design_ie
#:cache #!design_and_industrial_engineering
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the graduate Master of Science (M.S.) curriculum in Design and Industrial Systems Engineering, articulating multi-echelon supply network optimization, cognitive neuroergonomics, discrete-event digital twins, and circular economy engineering."
  ~#degree_tracks: "M.S. Research Thesis Track and M.Eng. Advanced Operations Analytics Track"
}

^["supply_chain_engineering_and_logistics_optimization"]{
  graduate_depth: "Mathematical modeling of global multi-echelon production and freight logistics."
  supply_chain_mechanics: #[
    "Multi-Echelon Inventory Optimization: Clark-Scarf recursive decomposition, base-stock inventory policies, and risk pooling across regional distribution hubs",
    "Bullwhip Effect Mitigation: Quantitative control of order oscillation amplification through point-of-sale data integration and Vendor-Managed Inventory (VMI)",
    "Stochastic Vehicle Routing (VRPTW): Capacitated fleet routing with tight time windows; heuristic solving via Genetic Algorithms, Tabu Search, and Column Generation",
    "Two-Stage Stochastic Network Design: Facility location under uncertain future tariffs, fuel costs, and geopolitical supply disruptions using Sample Average Approximation (SAA)"
  ]
}

^["advanced_human_systems_integration_and_neuroergonomics"]{
  human_technology_teaming: "Designing high-consequence complex socio-technical systems (aviation, surgical, aerospace control)."
  cognitive_engineering: .{
    cognitive_workload_metrology: #[
      "NASA-Task Load Index (TLX) multi-dimensional subjective workload assessment",
      "Physiological Workload Sensing: Eye-tracking gaze fixations, pupil diameter dilation, heart rate variability (HRV), and functional Near-Infrared Spectroscopy (fNIRS)"
    ]
    situation_awareness_models: "Endsley's Three Levels: Perception of environmental cues, Comprehension of current status, and Projection of future states"
    human_ai_collaboration: "Levels of Automation (Sheridan-Verplank scale), automation complacency, out-of-the-loop unfamiliarity, and explainable algorithmic interfaces"
  }[reg=facet]
}

^["discrete_event_simulation_and_industrial_digital_twins"]{
  computational_operations: "High-fidelity virtual modeling of stochastic factory and logistical operations."
  simulation_suite: #[
    "Stochastic Input Modeling: Kolmogorov-Smirnov and Anderson-Darling goodness-of-fit tests, non-stationary Poisson arrival processes, and correlated multivariate distributions",
    "Simulation Execution Mechanics: Next-event time-advance algorithms, process-interaction world views, and pseudo-random number generator cycle verification",
    "Statistical Output Analysis: Welchs method for warm-up period determination, batch means method for steady-state variance reduction, and antithetic variates",
    "Industrial Digital Twins: Real-time IoT sensor telemetry streaming into live simulation models to execute automated predictive bottleneck avoidance"
  ]
}

^["healthcare_systems_engineering_and_patient_safety"]{
  clinical_systems_optimization: #[
    "Emergency Department Flow Modeling: Triage queue prioritization, boarding reduction, and dynamic nurse-to-patient staffing ratios",
    "Operating Room Scheduling: Two-bin stochastic surgical block scheduling balancing overtime costs against expensive room idle time",
    "High-Reliability Healthcare Organizations: Root cause analysis (RCA), failure modes and effects analysis (FMEA) in surgical suites, and barcoded medication verification"
  ]
}

^["circular_economy_and_lifecycle_sustainability"]{
  ecological_engineering: #[
    "Life Cycle Assessment (LCA): ISO 14040/14044 framework, ReCiPe midpoint and endpoint environmental impact categories, and cradle-to-cradle material accounting",
    "Closed-Loop Supply Chains: Reverse logistics network optimization, used product return quality grading, and remanufacturing yield scheduling",
    "Scope 1, 2, and 3 Carbon Auditing: Decarbonizing freight transport logistics and supplier emission tracking"
  ]
}

^["taste"]{
  ~#taste: "Master's-level industrial systems engineering is the noble orchestration of human labor, physical matter, and mathematical algorithms into sustainable harmony."
  ~#wonder: "Why does a hospital emergency department designed by industrial engineers with queueing theory save more lives per year than adding ten additional MRI machines?"

  principles: #[
    "Design for the human in the loop: A system that depends on an exhausted human operator never making a mistake is an architectural failure, not human error.",
    "Data without theory is noise: Feeding massive data lakes into machine learning without understanding queueing physics or supply chain dynamics yields fragile models.",
    "True efficiency respects the planet: A supply chain that maximizes quarterly profits by exhausting workers and polluting ecosystems is bankrupt engineering."
  ]
}

^"invariants"{
  "Discrete-event simulation models must document warm-up period truncation and verified statistical independence of output batch means.",
  "Stochastic supply chain optimization models must specify probability distribution bounds for uncertain parameters.",
  "Human-system interface designs for safety-critical environments must guarantee that vital alarm signals are distinguishable across sensory modalities (visual and acoustic).",
}

#>wonder_masters_design_ie_1
?["How does real-time eye-tracking pupilometry integrated into air traffic control displays prevent cognitive tunnel vision during emergency rerouting?"]{
  #:depth #!ergonomic ~#lens(neuroadaptive_interfaces)
  ~#hypothesis: "Air traffic control interfaces that dynamically detect cognitive overload through pupillometry (pupil diameter dilation > 15% baseline) and automatically de-clutter secondary flight telemetry reduce controller decision errors by 45% during sector weather crises."
  !probe{ "Measure controller loss-of-separation incident rates and decision latency during simulated radar emergency scenarios with vs without neuroadaptive display de-cluttering." }
  $%[safety.loss_of_separation_incidents, cognition.emergency_decision_latency_seconds]
}
