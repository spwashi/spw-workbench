# Memory Systems & Knowledge Representation Curriculum Cache
#
# Baddeley working memory, multi-store architecture, semantic networks, schema theory, and reconstructive recall.

#>spw_cache_univ_cog_psych_memory
#:cache #!memory_systems_and_knowledge_representation
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model structural memory architectures, Baddeley's multi-component working memory, declarative vs procedural memory systems, and reconstructive semantic knowledge representations."
  ~#protocol: "cache.layer/1"
}

^"working_memory_and_multi_store_architectures"{
  "atkinson_shiffrin_and_sensory_buffers": .{
    iconic_and_echoic_memory: "Sperling partial report paradigm establishing vast sensory iconic capacity (~250ms decay); echoic memory auditory persistence (~3-4 seconds)",
    short_term_capacity_and_chunking: "Miller's 7 +/- 2 chunks refined by Cowan's 4 +/- 1 item working memory focal focus; chunking compressing information via semantic schema association",
  }[reg=facet],
  "baddeley_multi_component_working_memory": .{
    phonological_loop: "Composed of passive phonological store and active articulatory rehearsal loop; exhibits phonological similarity effect, word length effect, and vulnerability to articulatory suppression",
    visuospatial_sketchpad: "Dedicated to visual appearance (visual cache) and spatial movement (inner scribe); demonstrated via Shepard and Metzler mental rotation paradigms (linear RT scaling with rotation angle)",
    central_executive_and_episodic_buffer: "Central executive coordinates attentional control, task switching, and proactive inhibition; Episodic buffer integrates multimodal representations into temporary coherent episodic scenes",
  }[reg=facet],
}

^"long_term_memory_taxonomy_and_semantic_organization"{
  "declarative_vs_non_declarative_dissociations": .{
    tulving_squire_taxonomy: "Explicit/Declarative memory: Episodic (autonoetic conscious reliving of autobiographical events) vs Semantic (noetic factual knowledge devoid of personal context); Implicit/Non-declarative: procedural motor skills, perceptual priming, and classical conditioning",
    neuropsychological_dissociations: "Patient H.M. bilateral medial temporal lobectomy: complete anterograde declarative amnesia with preserved procedural motor skill learning (mirror-tracing test)",
  }[reg=facet],
  "encoding_retrieval_and_forgetting_dynamics": .{
    levels_of_processing_and_encoding_specificity: "Craik & Lockhart: deep semantic elaboration produces vastly superior retention compared to shallow phonemic or orthographic processing; Tulving's Encoding Specificity Principle: memory retrieval succeeds when retrieval cues recreate the encoding context",
    spacing_and_testing_effects: "Ebbinghaus exponential forgetting curve; Spaced repetition vastly outperforming massed cramming; Roediger & Karpicke testing effect demonstrating that active retrieval produces deeper structural consolidation than passive re-reading",
  }[reg=facet],
  "semantic_networks_and_reconstructive_recall": .{
    spreading_activation_and_prototype_theory: "Collins & Loftus spreading activation model; Rosch prototype theory: basic-level categories ('chair') prioritized over superordinate ('furniture') or subordinate ('rocking chair')",
    bartlett_reconstructive_memory_and_schemas: "Bartlett 'War of the Ghosts': memory is not a video recording but an active reconstructive puzzle guided by cultural schemas (leveling, sharpening, assimilation); Loftus eyewitness misinformation effect demonstrating false memory implantation through post-event leading questions",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_univ_cog_psych_memory_1
  ?["Why is episodic memory systematically prone to reconstructive confabulation and false detail, rather than operating like a lossless digital recording?"]{
    #:depth #!evolutionary ~#lens(memory_as_future_simulation_engine)
    ~#hypothesis: "Episodic memory did not evolve to store an immutable archival ledger of the past; it evolved as a flexible generative simulation engine (the constructive episodic simulation hypothesis) designed to deconstruct past experiences and recombine them into novel counterfactual scenarios to predict future survival challenges."
    !probe{ "Compare fMRI default mode network activation during autobiographical past recall vs episodic future simulation in healthy adults." }
    $%[memory.dmn_overlap_percentage, cognition.future_simulation_vividness_score]
  }
}
