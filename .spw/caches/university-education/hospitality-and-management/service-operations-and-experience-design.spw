# Service Operations & Experience Design Curriculum Cache
#
# Service blueprinting, Bitner servicescapes, Hochschild emotional labor, and SERVQUAL gap models.

#>spw_cache_univ_hosp_operations
#:cache #!service_operations_and_experience_design
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model service blueprinting methodology, servicescape environmental psychology, frontline emotional labor dynamics, and SERVQUAL multidimensional quality metrics."
  ~#protocol: "cache.layer/1"
}

^"service_blueprinting_and_environmental_design"{
  "shostack_service_blueprint_architecture": .{
    structural_boundaries: "Line of Interaction (customer engaging front-of-house staff), Line of Visibility (separating on-stage theatrical performance from backstage operations), and Line of Internal Interaction (support process handoffs)",
    fail_points_and_wait_management: "Explicit identification of high-risk operational fail points (e.g., luggage delivery delay, room keys demagnetizing); establishing Poka-Yoke error-proofing mechanisms and psychological wait-time buffers (e.g., ambient mirrors at elevator banks)",
  }[reg=facet],
  "bitner_servicescape_environmental_psychology": .{
    ambient_conditions: "Lighting color temperature (warm 2700K in luxury dining vs bright daylight in breakfast cafes), acoustic soundscaping (BGM tempo modulating dining duration), and olfactory scent branding (signature ambient diffusion)",
    spatial_layout_and_symbolic_artifacts: "Guest flow ergonomics; orientation cues; spatial architectural prestige establishing subconscious social status and emotional tranquility",
  }[reg=facet],
}

^"emotional_labor_and_service_quality_analytics"{
  "hochschild_emotional_labor_and_experience_economy": .{
    surface_vs_deep_acting: "Surface acting (putting on a commercial smile without internal emotional shift, causing psychological burnout and cynicism) vs Deep acting (evoking genuine empathetic perspective-taking, fostering sustained vocational fulfillment)",
    pine_and_gilmore_experience_transformation: "Evolution from commodity extraction to staged theatrical experience; orchestrating sensory cues to deliver authentic, transformative guest memories",
  }[reg=facet],
  "servqual_gap_model_and_recovery_protocols": .{
    servqual_five_dimensions: "Reliability (dependable delivery), Assurance (staff competence and courtesy), Tangibles (physical cleanliness and design), Empathy (individualized care), Responsiveness (prompt willingness to assist)",
    gap_model_of_service_quality: "Analyzing discrepancies between customer expectations and actual service: Gap 1 (management perception), Gap 2 (service standards), Gap 3 (service delivery), Gap 4 (external communication), culminating in Gap 5 (expected vs perceived service)",
    frontline_recovery_empowerment: "Granting line-level employees autonomous financial authority to instantly resolve guest grievances without managerial approval",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_univ_hosp_operations_1
  ?["Why do luxury hotels find that signature olfactory scent branding in the lobby increases guest perception of room cleanliness and perceived value?"]{
    #:depth #!psychological ~#lens(limbic_olfactory_priming)
    ~#hypothesis: "The human olfactory bulb projects directly into the amygdala and hippocampus without passing through the cognitive thalamic filter. A distinct, elegant ambient scent immediately primes nostalgic emotional tranquility and subconscious feelings of luxury safety, creating a halo effect that systematically elevates subsequent cognitive ratings of physical cleanliness and perceived room quality."
    !probe{ "Measure guest post-stay satisfaction ratings and Willingness-To-Pay (WTP) metrics in identical hotel suites with vs without lobby olfactory brand diffusion." }
    $%[psychology.olfactory_halo_effect_wtp_percentage, guest.satisfaction_rating_delta]
  }
}
