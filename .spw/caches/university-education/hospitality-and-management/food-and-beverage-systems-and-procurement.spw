# Food & Beverage Systems & Procurement Curriculum Cache
#
# Kasavana-Smith menu engineering, food cost variance, FIFO inventory par levels, and HACCP safety.

#>spw_cache_univ_hosp_fb
#:cache #!food_and_beverage_systems_and_procurement
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model culinary operations management, Kasavana-Smith menu engineering matrices, food cost percentage equations, inventory par controls, and HACCP safety protocols."
  ~#protocol: "cache.layer/1"
}

^"menu_engineering_and_profitability_optimization"{
  "kasavana_smith_menu_matrix": .{
    classification_axes: "Plotting menu items across two variables: Popularity (Menu Mix percentage MM vs 70% hurdle rate) and Profitability (Contribution Margin CM = Menu Price - Direct Food Cost)",
    stars_and_plowhorses: "Stars (High MM, High CM): signature drivers, protect recipe consistency and prominent menu placement; Plowhorses (High MM, Low CM): high volume but low margin, modestly increase price or reduce expensive garnish portions",
    puzzles_and_dogs: "Puzzles (Low MM, High CM): high margin but low sales, reposition with menu eye-magnets or train service staff on suggestive selling; Dogs (Low MM, Low CM): candidates for menu elimination unless fulfilling critical dietary niches",
  }[reg=facet],
  "visual_menu_psychology": .{
    menu_eye_tracking_and_anchoring: "The 'Sweet Spot' (upper right quadrant of a bi-fold menu receiving initial eye gaze); boxing premium dishes; eliminating dollar signs ($) to reduce payment pain friction; decoys and decoy pricing",
  }[reg=facet],
}

^"cost_controls_inventory_and_haccp_safety"{
  "food_cost_accounting_and_par_stocks": .{
    cost_of_goods_sold_cogs: "Food Cost % = (Beginning Inventory + Purchases - Ending Inventory - Employee Meals - Transfers Out) / Total Food Sales * 100; benchmark targets maintained between 28% and 34%",
    inventory_management_fifo: "First-In, First-Out (FIFO) stock rotation preventing spoilage; setting dynamic Par levels (minimum operational stock + safety buffer based on delivery lead times); perpetual inventory audits via barcode scales",
  }[reg=facet],
  "haccp_food_safety_architecture": .{
    seven_haccp_principles: "1) Conduct hazard analysis, 2) Determine Critical Control Points (CCPs), 3) Establish critical limits, 4) Monitor CCPs, 5) Establish corrective actions, 6) Verify system procedures, 7) Maintain documentation",
    temperature_danger_zone_tdz: "Pathogen proliferation between 41 F and 135 F (5 C to 57 C); two-stage cooling mandates (135 F to 70 F within 2 hours; 70 F to 41 F within additional 4 hours); digital continuous temperature data-logging",
    banquet_event_orders_beo: "Master contractual document detailing timeline, room setup, menu specifications, dietary allergies, and guaranteed guest covers for mass catering operations",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_univ_hosp_fb_1
  ?["Why does removing the dollar sign ($) and listing prices in plain numerals (e.g., '28' instead of '$28.00') significantly increase average diner spending?"]{
    #:depth #!behavioral ~#lens(monetary_symbolism_and_pain_of_paying)
    ~#hypothesis: "The dollar sign functions as a potent symbolic cue that primes cognitive awareness of financial loss, activating the anterior insular cortex associated with physical pain. Removing the currency symbol decouples the sensory delight of the dish description from commercial pain-of-paying, encouraging diners to order higher-margin items."
    !probe{ "Conduct randomized A/B menu testing across high-volume restaurants measuring check averages and wine spend across symbol-bearing vs numeral-only menus." }
    $%[behavioral.average_check_increase_percentage, neuroeconomics.pain_of_paying_insulation_index]
  }
}
