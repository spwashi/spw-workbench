# University Curricular Architecture & Epistemological Scaffolding
#
# Curricular topologies, credit-hour mechanics, general education models, and prerequisite DAGs.

#>spw_cache_univ_curriculum
#:cache #!university
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the architecture of undergraduate and graduate degree requirements, intellectual scaffolding, and distribution philosophies."
  ~#standard: "Carnegie Unit credit-hour standard (1 credit = 1 hour direct instruction + 2 hours independent study per week across 15 weeks)"
}

^["undergraduate_degree_structure"]{
  total_credit_budget: "120 Semester Credit Hours (typical 4-year Bachelor of Arts / Bachelor of Science)"
  partition: #[
    .{ component: "General Education Core", credits: "30 - 45", role: "Epistemological breadth: humanities, natural sciences, quantitative reasoning, social sciences" },
    .{ component: "Major Field of Study", credits: "36 - 60", role: "Disciplinary depth: foundational survey, methods sequence, upper-division seminars, capstone" },
    .{ component: "Free Electives / Minor", credits: "15 - 30", role: "Student exploratory agency, interdisciplinary bridges, secondary concentrations" }
  ]
}

^["the_prerequisite_lattice"]{
  dag_structure: "Courses form a strict Directed Acyclic Graph (DAG) enforcing cumulative intellectual progression."
  course_numbering_tiers: #[
    .{ level: "100-level (Introductory)", role: "Foundational concepts, vocabulary acquisition, large lecture surveys" },
    .{ level: "200-level (Intermediate)", role: "Methodological tools, lab techniques, formal proof introductions" },
    .{ level: "300-level (Advanced)", role: "Primary literature reading, specialized subfields, critical debate" },
    .{ level: "400-level (Culminating)", role: "Original research, independent synthesis, senior theses, graduate-level prep" }
  ]
  gateway_filters: "High-attrition courses (e.g. Organic Chemistry, Real Analysis) that regulate entry into competitive majors."
}

^["general_education_philosophies"]{
  columbia_core: .{
    model: "Common Core Curriculum"
    mechanism: "All students read the exact same foundational texts (Plato to Modern Philosophy) in small mandatory seminars."
    virtue: "Builds a universal intellectual lingua franca across the entire student body regardless of major."
  }[reg=facet]

  distribution_requirements: .{
    model: "Menu-based Distribution"
    mechanism: "Students choose from lists of approved courses across categories (e.g. 2 Natural Sciences, 2 Humanities, 1 Quantitative)."
    virtue: "Flexible, departmental student recruiting, adaptable to diverse student preparation."
  }[reg=facet]

  open_curriculum: .{
    model: "Open Curriculum (Brown, Amherst)"
    mechanism: "Zero mandatory general education courses; students design their own intellectual trajectory with faculty advisors."
    virtue: "Maximizes intrinsic motivation and interdisciplinary synthesis."
  }[reg=facet]
}

^["specialized_disciplinary_implementations"]{
  stem_dual_paradigms: #[
    "Chemistry & Chemical Engineering: Spanning molecular synthesis to continuum transport and plant-scale unit operations (~./chemistry-and-chemical-engineering/index.spw)",
    "Physics & Mechanical Engineering: Bridging Lagrangian mechanics and field theory with structural dynamics and robotic control (~./physics-and-mechanical-engineering/index.spw)",
    "Materials Science & Engineering: Traversing the structure-processing-property-performance tetrahedron from quantum DFT to macro metallurgy (~./materials-science/index.spw)",
    "Thermodynamics: Unifying power cycles, statistical ensembles, non-equilibrium dissipative structures, and Landauer information limits (~./thermodynamics/index.spw)",
    "Electrical & Computer Engineering: Connecting semiconductor physics, circuits, and signals to pipelined microarchitectures and VLSI (~./electrical-and-computer-engineering/index.spw)",
    "Horticulture & Botany: Integrating cellular plant physiology and phylogenetics with controlled environment agriculture and CRISPR crop genomics (~./horticulture-and-botany/index.spw)",
    "Illustration & Animation: Bridging classical observational draftsmanship and visual metaphor with 2D/3D animation and auteur direction (~./illustration-and-animation/index.spw)",
    "Design & Industrial Engineering: Marrying human-centered industrial design and physical ergonomics with operations research and stochastic systems (~./design-and-industrial-engineering/index.spw)",
    "Film & Theatre: Bridging dramatic text analysis and Meisner/Stanislavski acting with cinema auteur directing and post-production (~./film-and-theatre/index.spw)",
    "Linguistics: Unifying acoustic spectrograms and generative syntax with typed compositional semantics and sociolinguistic documentation (~./linguistics/index.spw)",
    "Economics: Linking consumer optimization and causal econometrics to Arrow-Debreu general equilibrium and DSGE dynamic macroeconomics (~./economics/index.spw)",
    "Mathematics: Traversing linear algebra and Galois theory to Lebesgue integration, smooth manifolds, and algebraic topology (~./mathematics/index.spw)",
    "Cognitive Psychology: Modeling psychophysics, Baddeley working memory, heuristic decision biases, and developmental schema Piagetian transitions (~./cognitive-psychology/index.spw)",
    "Neuroscience: Unifying Hodgkin-Huxley cellular electrophysiology and cortical sensory hierarchies with computational attractor networks (~./neuroscience/index.spw)",
    "Molecular & Cellular Biology: Bridging DNA replisome mechanics and CRISPR editing with protein folding chaperones, endomembrane trafficking, and cell cycle checkpoints (~./molecular-and-cellular-biology/index.spw)",
    "Bioengineering: Synthesizing forward-engineered genetic circuits and metabolic FBA with tissue scaffolds, mechanotransduction, and microfluidics (~./bioengineering/index.spw)",
    "Nursing: Grounding clinical ADPIE assessment and critical care vasoactive titration in pharmacological pathophysiology and transpersonal caring presence (~./nursing/index.spw)",
    "Hospitality & Management: Orchestrating service blueprinting, RevPAR dynamic yield pricing, Kasavana-Smith menu engineering, and servant leadership culture (~./hospitality-and-management/index.spw)",
    "Library & Information Sciences: Preserving human memory through Ranganathan faceted metadata, Okapi BM25 probabilistic retrieval, OAIS archival vaults, and intellectual freedom defense (~./library-and-information-sciences/index.spw)"
  ]
}

^["capstone_and_thesis_summits"]{
  senior_thesis: "Year-long original research culminating in an archival document and oral defense before a faculty committee."
  practicum_studio: "Team-based engineering capstone building client-facing hardware, software, or civic interventions."
}

^["taste"]{
  ~#taste: "A degree is not a shopping cart of 40 random courses; it is a carefully orchestrated intellectual pilgrimage."
  ~#wonder: "Can an institution balance professional vocational preparation with the timeless cultivation of critical human wisdom?"

  principles: #[
    "Breadth protects against obsolescence: Specialized skills become outdated; the ability to read, analyze, and synthesize lasts a lifetime.",
    "Depth protects against charlatans: Mastering one discipline to its frontier teaches a student how difficult real knowledge is to achieve.",
    "Epistemological variety: An educated mind should understand how a physicist, a historian, and a poet arrive at truth."
  ]
}

^["invariants"]{
  "Degree requirements cannot form circular prerequisite dependencies.",
  "Major programs require at least 50% of coursework to be completed in upper-division (300+) courses.",
  "Credit hours accurately reflect student workload standards across lecture, laboratory, and studio formats.",
}

#>wonder_univ_curriculum_1
?["How does the choice between a Core Curriculum and an Open Curriculum shape the civic character of a campus?"]{
  #:depth #!philosophical ~#lens(epistemological_communion)
  ~#hypothesis: "A shared Core Curriculum creates a collective conversational salon in dining halls; an Open Curriculum cultivates radical individual autonomy."
  !probe{ "Measure frequency of spontaneous intellectual debates among students outside the classroom in Core vs Open campuses." }
  $%[campus.spontaneous_debate_frequency, student.intellectual_breadth_score]
}
