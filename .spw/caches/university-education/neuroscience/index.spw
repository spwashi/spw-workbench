# University Neuroscience Curriculum Cache Index
#
# Root cache index for cellular electrophysiology, systems circuit architecture, and computational neural dynamics.

#>spw_cache_univ_neuro_index
#:cache #!neuroscience
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model undergraduate and doctoral neuroscience: Hodgkin-Huxley action potential kinetics, synaptic plasticity, sensory cortical hierarchies, neural oscillations, and computational connectomics."
  ~#domains: "Cellular neurobiology, systems neuroscience, electrophysiology, computational neuroscience, and neuroimaging"
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @cellular_molecular: ~"./cellular-and-molecular-neurobiology.spw"
  @systems_circuits: ~"./systems-neuroscience-and-sensory-circuits.spw"
  @computational_cognitive: ~"./cognitive-and-computational-neuroscience.spw"
  @taste: ~"./taste.spw"
}

^"dispatch"{
  cellular_and_molecular_neurobiology: @cellular_molecular
  systems_neuroscience_and_sensory_circuits: @systems_circuits
  cognitive_and_computational_neuroscience: @computational_cognitive
  taste_considerations: @taste
}

^"taste"{
  ~#taste: "Neuroscience is the cosmos investigating its own organ of contemplation: eighty-six billion neurons weaving electrical lightning into awareness."
  ~#wonder: "How does the physical flow of microscopic potassium and sodium ions through lipid protein channels give rise to the raw subjective experience of grief, love, or the color cadmium red?"
}

^"invariants"{
  "Electrophysiological models must satisfy Nernst-Planck thermodynamics and Hodgkin-Huxley differential conductance equations.",
  "Circuit descriptions must map precise anatomical projections between cortical layers and subcortical nuclei.",
  "Plasticity mechanisms must explicitly account for NMDA receptor biophysics, calcium microdomains, and spike-timing dynamics.",
}

^"wonder_probes"{
  #>wonder_univ_neuro_index_1
  ?["How does the brain consume only 20 watts of metabolic energy while outperforming supercomputers consuming megawatts on perceptual pattern recognition?"]{
    #:depth #!computational ~#lens(sparse_spiking_and_analog_dendritic_computation)
    ~#hypothesis: "Biological neural networks compute via asynchronous, event-driven sparse spiking and non-linear analog dendritic integration. Over 99% of neurons remain silent at any given millisecond, transmitting information only when local predictions fail (event-driven sparse coding), minimizing thermodynamic dissipation."
    !probe{ "Calculate energy consumption per synaptic event in cortical pyramidal neurons vs floating point operations (FLOPs) in GPU transformer architectures." }
    $%[thermodynamics.synaptic_energy_joules_per_spike, computation.neuromorphic_efficiency_gain]
  }
}
