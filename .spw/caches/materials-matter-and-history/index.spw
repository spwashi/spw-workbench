# Materials, Matter & World History Cache Index
#
# Root cache index for the physical chemistry, chemical bonding, material applications, and civilizational history of ink, steel, acrylic, water, paint, and fibers/textiles.

#>spw_cache_mat_hist_index
#:cache #!materials_matter_and_history
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the physical states, chemical bonding regimes, technological applications, and transformative world-historical impact of six primary civilizational substances: water, steel, ink, paint, acrylic, and textiles."
  ~#domains: "Materials chemistry, condensed matter physics, metallurgy, polymer science, textile mechanics, and material world history"
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @phases_and_bonds: ~"./phases-of-matter-and-chemical-bonding.spw"
  @water: ~"./water-the-universal-matrix.spw"
  @steel: ~"./steel-and-ferrous-metallurgy.spw"
  @ink: ~"./ink-and-inscriptional-technologies.spw"
  @paint: ~"./paint-and-color-chemistry.spw"
  @acrylic: ~"./acrylic-and-synthetic-polymers.spw"
  @fibers_textiles: ~"./fibers-and-textile-technologies.spw"
  @taste: ~"./taste.spw"
}

^"dispatch"{
  phases_of_matter_and_chemical_bonding: @phases_and_bonds
  water_the_universal_matrix: @water
  steel_and_ferrous_metallurgy: @steel
  ink_and_inscriptional_technologies: @ink
  paint_and_color_chemistry: @paint
  acrylic_and_synthetic_polymers: @acrylic
  fibers_and_textile_technologies: @fibers_textiles
  taste_considerations: @taste
}

^"taste"{
  ~#taste: "Civilization is matter organized by thought: the shape of human history is etched in iron, woven in linen, dissolved in water, and written in ink."
  ~#wonder: "Why did the mastery of single chemical bonds—the hydrogen bond in cellulose, the interstitial carbon bond in martensite, or the covalent chain in synthetic polymers—repeatedly topple global empires and birth industrial revolutions?"
}

^"invariants"{
  "Every material description must explicitly articulate its characteristic chemical bonding regime and phase thermodynamic stability.",
  "Technological applications must link microscopic crystalline/molecular properties directly to macro-scale engineering function.",
  "Historical analyses must preserve the materialist dialectic between raw material extraction, trade networks, labor institutions, and cultural transformations.",
}

^"wonder_probes"{
  #>wonder_mat_hist_index_1
  ?["How did the chemical transition from fragile organic animal/vegetable materials to refractory steel and synthetic polymers fundamentally alter humanity's perception of temporal permanence?"]{
    #:depth #!philosophical ~#lens(material_permanence_and_civilizational_memory)
    ~#hypothesis: "Pre-industrial civilization was marked by cyclical organic decay: wood rots, textiles fray, and iron rusts, enforcing a cultural consciousness attuned to biological cycles. The advent of mass-produced structural steel and non-biodegradable synthetic polymers created an artificial illusion of geological immutability, detaching modern civilization from ecological feedback loops."
    !probe{ "Measure material durability half-lives against civilizational infrastructure replacement cycles from 3000 BCE to 2026 CE." }
    $%[materials.mean_infrastructure_lifespan_years, culture.ecological_feedback_latency_decades]
  }
}
