# Editor Truth
#
# A source-grounded trail through what each editor host does today, where it is wrong, what the generated caches got wrong about it, and which language questions those rows raise.

#>trail_editor_truth
#:layer #!pragmatics
#:domain #!trail
#:form #!trail
#:level #!intro
#:review #!spot_checked
#:valence #!bane
#:era #!current

^"emit"{
 ~#title: "Editor Truth"
 ~#claim: "Sixteen stops read the server, VS Code, and JetBrains from code, then the defects, the errata, and the spec lineage, and end at the language questions host rows raise."
 ~#proof: "Every host stop cites code by path and line; the spec lineage stop crosses into the formal class, and the owner note treats host-feature caches as residue and names language among the scrutiny shelf."
 ~#door: "Start at the server surface, and at each host stop write the language question the row raises."
 ~#audience: "plugin maintainers and readers who want to know what an editor really does with Spw"
 continuity: "Editor Truth | language question"
 cold_open: "Read what each editor really does with Spw, then ask the language question each host row raises."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "stops follow the editor-truth row of final-plan-v3 trails, with the spec lineage stop inserted to cross classes",
  "the planned cli-readings stop was folded into inspection-and-ir in plan v3, so that stop stands in its place",
  "every stop anchor was matched against the cut on disk on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "fact-check 2026-10-03: the residue reading quoted the owner note as naming language, mathematics, and attention; the note names language, mathematics, physics, linguistics, and attention, and speaks of host-feature caches",
  "fact-check 2026-10-03: provenance is an apparatus directory, not a subject class, so it is listed apart from the classes"
 ]
}

^["edges"]{
 feeds: [ ~"./spw-circuit.spw#trail_spw_circuit" ]
 see: [ ~"./paired-cases.spw#trail_paired_cases" ]
}

^["concepts"]{
 primary: [ #thin_client, #code_verified ]
 transfers: [ #supersession, #cache_plane ]
 tensions: [ #editor_chrome ]
}

#>trail_editor_stops
^["stops"]{
 classes: #[ spw, formal ]
 apparatus: #[ provenance ]
 walk: <<
  ~"../spw/hosts/lsp-surface.spw#editor_hosts_lsp" ;
  ~"../spw/hosts/vscode-commands-and-views.spw#editor_hosts_vscode_commands" ;
  ~"../spw/hosts/vscode-rendering.spw#editor_hosts_vscode_rendering" ;
  ?{ "can a color in the editor say something the parse does not" } ~<prediction> ;
  ~"../spw/hosts/vscode-lsp-and-cache.spw#editor_hosts_vscode_lsp_cache" ;
  ~"../spw/hosts/jetbrains-platform.spw#editor_hosts_jetbrains_platform" ;
  ~"../spw/hosts/jetbrains-native-features.spw#editor_hosts_jetbrains_native" ;
  ~"../spw/hosts/jetbrains-instruments.spw#editor_hosts_jetbrains_instruments" ;
  ~"../spw/hosts/host-parity-matrix.spw#editor_hosts_parity" ;
  ?{ "which host reads Spw without asking the server" } ~<prediction> ;
  ~"../spw/hosts/known-defects.spw#editor_hosts_defects" ;
  ~"../spw/hosts/feature-radar.spw#editor_hosts_radar" ;
  ~"../spw/inspection-and-ir.spw#spw_inspection_and_ir" ;
  ~"../spw/history/editor-extension-arcs.spw#workbench_history_extensions" ;
  ~"../provenance/errata-technical.spw#provenance_errata_technical" ;
  ?{ "how would you cite a host feature so the citation stays true next year" } ~<prediction> ;
  ~"../formal/computing/spec-lineage.spw#computing_spec_lineage" ;
  ~"../spw/theory/address-and-linking.spw#spw_theory_address" ;
  ~"../spw/plugin-theory.spw#spw_plugin_theory"
 >>
 ^["questions"]{
  editor_hosts_lsp: "what does the one server know that every host must ask for"
  editor_hosts_vscode_commands: "which commands read the live buffer and which read the saved file"
  editor_hosts_vscode_rendering: "four paint layers with their own regexes: which of them is the language"
  editor_hosts_vscode_lsp_cache: "what is lost when a cache card drops the server plane"
  editor_hosts_jetbrains_platform: "is a declared build range part of the language or of the host"
  editor_hosts_jetbrains_native: "line regexes for folds and outline: what grammar do they assume"
  editor_hosts_jetbrains_instruments: "is the saved file or the buffer the truth an instrument should read"
  editor_hosts_parity: "parity of questions, not of features: which plane does each host answer honestly"
  editor_hosts_defects: "each defect is a host reading Spw on its own; what should it have asked"
  editor_hosts_radar: "which unused protocol feature would remove a host-side reading"
  spw_inspection_and_ir: "which rung of the IR does each host show, and what does that rung hide"
  workbench_history_extensions: "the plugins thinned toward the server; what did each one stop deciding"
  provenance_errata_technical: "which host features did the generated caches invent"
  computing_spec_lineage: "specs evolve by numbered replacement; host rows should be cited by version the same way"
  spw_theory_address: "one anchored link, six readings: which reading should every host share"
  spw_plugin_theory: "a plugin paints what the server knows; where is that line today"
 }
}

#>trail_editor_legs
^["legs"]{
 server: #[ editor_hosts_lsp ]
 vscode: #[ editor_hosts_vscode_commands, editor_hosts_vscode_rendering, editor_hosts_vscode_lsp_cache ]
 jetbrains: #[ editor_hosts_jetbrains_platform, editor_hosts_jetbrains_native, editor_hosts_jetbrains_instruments ]
 across: #[ editor_hosts_parity, editor_hosts_defects, editor_hosts_radar, spw_inspection_and_ir ]
 record: #[ workbench_history_extensions, provenance_errata_technical, computing_spec_lineage ]
 language: #[ spw_theory_address, spw_plugin_theory ]
}

^["readings"]{
 #>trail_editor_residue
 ^["residue"]{
  #:claim #!interpretive
  statement: "The owner note treats host-feature caches as residue and names language, mathematics, physics, linguistics, and attention as the scrutiny shelf, so each host row on this walk is read for the language question it raises."
  source: ~"../registries/sources/trails.spw#src_trail_owner_resume"
  cites: [ ".spw/caches/resume/2026-09-30-direction.spw:69" ]
  label: "owner hold"
 }
 #>trail_editor_dated_stills
 ^["dated_stills"]{
  #:claim #!interpretive
  statement: "Every host fact on this walk is a dated still read at one commit, so it should be cited the way a spec is cited, by version, and expected to be replaced."
  see: [ ~"../formal/computing/spec-lineage.spw#computing_spec_supersedes_rule" ]
  ^["limits"]{
   holds: "commands, settings, colors, and build ranges, which move with releases"
   fails: "the language questions, which outlive any one host release"
  }
 }
}

^["try"]{
 #>trail_editor_try_ask
 ^["ask_the_parse"]{
  materials: [ "a .spw file open in your editor", "a pen and paper", "the spw command line" ]
  steps: <<
   "pick three colored tokens on one line" ;
   "write what you think the parser calls each one" ;
   "run spw select on the file and read the node for that line" ;
   "mark where color and parse agree and where they part"
  >>
  time: .{ n: 15, unit: "minutes" }
  safety: "no hazard worth naming"
  status: #implemented
  cites: [ "packages/spw-cli/src/commands.ts:330" ]
  shows: ~"./editor-truth.spw#trail_editor_residue"
 }
}

#>trail_editor_drift_q
?["Does a host that reads Spw with its own regexes drift from the parse faster?"]{
 #:depth #!computational ~#lens(signal path)
 #:claim #!speculative
 ~#hypothesis: "Hosts that color or fold Spw from their own line regexes should collect verified defects faster per release than hosts that only paint what the server sends."
 !probe{ "count verified defects per host by reader kind across the extension history" =id[p_trail_editor_reader_drift] =kind[census] }
 $%[hosts.vscode.color_id_count, hosts.lsp.custom_method_count]
 ~"./editor-truth.spw#trail_editor_dated_stills" ~#neighbor(nearest)
}
