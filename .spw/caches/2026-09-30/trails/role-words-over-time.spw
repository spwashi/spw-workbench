# Role Words Over Time
#
# A trail that follows role words such as steward, organizer, moderator, streamer, elder, and doula from sound change and social meaning to a lattice of roles, and ends at why computed clusters stay prompts.

#>trail_role_words
#:layer #!pragmatics
#:domain #!trail
#:form #!trail
#:level #!intro
#:review #!adversarial_checked
#:valence #!bonk

^"emit"{
 ~#title: "Role Words Over Time"
 ~#claim: "Nine stops follow how role words keep an old core while their social charge shifts, then compare roles on shared facets, and end at the cautions on any one taxonomy."
 ~#proof: "Every stop is an anchor in the language-and-mind, society, spw, or record class; the keyword method is credited to Raymond Williams, and the role facts stay at their stops."
 ~#door: "Pick one role word you use, and carry it through every stop."
 ~#audience: "organizers, linguists, and community workers who name roles for a living"
 continuity: "Role Words Over Time | old core"
 cold_open: "Carry one role word through the walk and watch it keep an old core while its charge shifts."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "stops follow the role-words-over-time row of final-plan-v3 trails",
  "every stop anchor was matched against the cut on disk on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "fact-check 2026-10-03: the historical note stated sound-change regularity without the lexical-diffusion caveat its stop carries, and called meaning-change patterns more than the tendencies the stop allows"
 ]
}

^["edges"]{
 feeds: [ ~"./particle-physics-revisit.spw#trail_particle_physics" ]
 see: [ ~"./shared-curricula-kit.spw#trail_shared_curricula" ]
}

^["concepts"]{
 primary: [ #role, #semiotic_charge ]
 transfers: [ #faceted_classification ]
 tensions: [ #ossified_taxonomy ]
}

#>trail_role_stops
^["stops"]{
 classes: #[ language_and_mind, society, spw, record ]
 walk: <<
  ~"../language-and-mind/linguistics/historical-linguistics.spw#linguistics_historical" ;
  ~"../language-and-mind/linguistics/sociolinguistics-and-documentation.spw#linguistics_sociolinguistics" ;
  ?{ "which part of your role word is oldest, the sound or the job" } ~<prediction> ;
  ~"../society/communities/semiotic-charge.spw#communities_semiotic_charge" ;
  ~"../society/communities/roles-lattice.spw#communities_roles_lattice" ;
  ~"../society/communities/crew-crosswalk.spw#communities_crew_crosswalk" ;
  ?{ "which function does your role serve on a film set" } ~<prediction> ;
  ~"../society/communities/care-roles.spw#communities_care_roles" ;
  ~"../society/communities/custodian-roles.spw#communities_custodian_roles" ;
  ~"../spw/theory/clustering-hybrid.spw#spw_theory_clustering" ;
  ?{ "would a computer group your role with the right neighbors" } ~<prediction> ;
  ~"../record/information/taxonomy-cautions.spw#information_science_cautions"
 >>
 ^["notes"]{
  linguistics_historical: "sound change is largely regular, though some changes spread word by word; meaning change has regular tendencies, such as subjectification"
  linguistics_sociolinguistics: "variation carries social meaning, and every variety is rule-governed"
  communities_semiotic_charge: "the ladder for steward, organizer, moderator, streamer, clipper, elder, and doula"
  communities_roles_lattice: "five closed facets compare a doula and a block captain without ranking either"
  communities_crew_crosswalk: "six crew functions recur on sets, podcasts, streams, and blocks under different names"
  communities_care_roles: "care roles carry health work home; this trail reads their names, never their practice"
  communities_custodian_roles: "elders, storytellers, and muralists keep a community memory and pass it on"
  spw_theory_clustering: "a computed cluster is a prompt to compare, never a claim that two roles are alike"
  information_science_cautions: "any single taxonomy hardens; facets and declared gaps keep it open to revision"
 }
}

^["readings"]{
 #>trail_role_keywords
 ^["keywords_method"]{
  #:claim #!settled
  statement: "Raymond Williams traced how words such as culture, class, and society changed meaning with the social history around them, in Keywords, published in 1976."
  source: ~"../registries/sources/trails.spw#src_trail_williams_1976"
  ^["limits"]{
   holds: "a method for reading charged words historically, in English"
   fails: "role words born on platforms, whose recent senses move faster than dictionaries record"
  }
 }
 #>trail_role_core_and_charge
 ^["core_and_charge"]{
  #:claim #!interpretive
  statement: "Read in this order, a role word shows its old core first, its social charge second, and its place among other roles last, so a cluster cannot hide where the word came from."
  see: [ ~"../society/communities/semiotic-charge.spw#communities_charge_ladder" ]
 }
 #>trail_role_clusters_prompts
 ^["clusters_stay_prompts"]{
  #:claim #!interpretive
  statement: "The walk ends at taxonomy cautions because a computed grouping of roles inherits the outlook of whoever chose its features, as Bowker and Star argue of classification generally."
  source: ~"../registries/sources/trails.spw#src_trail_bowker_star_1999"
  see: [ ~"../record/information/taxonomy-cautions.spw#information_science_cautions_bowker_star" ]
 }
}

^["try"]{
 #>trail_role_try_ladder
 ^["word_ladder"]{
  materials: [ "one role word you use at work or in your community", "a historical dictionary or etymology reference", "a card and a pen" ]
  steps: <<
   "write the word and the job it names for you today" ;
   "guess its oldest sense and write the guess down" ;
   "look up the oldest recorded sense and the date it appears" ;
   "write what stayed the same and what changed" ;
   "place the word on the five facets of the roles lattice"
  >>
  time: .{ n: 20, unit: "minutes" }
  safety: "describe the role, not a person who holds it"
  shows: ~"./role-words-over-time.spw#trail_role_core_and_charge"
 }
}

#>trail_role_platform_drift_q
?["Do platform role words shift faster than care role words?"]{
 #:depth #!social ~#lens(semiotic charge)
 #:claim #!speculative
 ~#hypothesis: "Words for platform roles such as moderator and streamer should gain new senses faster than words for care roles such as doula and elder, because platform rules change on dated cycles."
 !probe{ "count dated new senses for six role words in two historical dictionaries" =id[p_trail_role_sense_rate] =kind[lit] }
 $%[creator.live.gift_min_age_years, lang.labor_support.trials_count]
 breaks: "a platform rule changes a role by decree on one date, while a care role changes through practice and law across many places"
 ~"./role-words-over-time.spw#trail_role_core_and_charge" ~#neighbor(nearest)
}
