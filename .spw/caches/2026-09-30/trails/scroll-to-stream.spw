# Scroll to Stream
#
# A trail through the carriers of text, sound, and image in rough order of first arrival, grouped by medium, with manufacture and decay as counterpoint, ending at the classroom screen and the archive that keeps it.

#>trail_scroll_to_stream
#:layer #!pragmatics
#:domain #!trail
#:form #!trail
#:level #!intro
#:review #!spot_checked
#:valence #!bonk

^"emit"{
 ~#title: "Scroll to Stream"
 ~#claim: "Seventeen stops follow text, sound, and image from twisted fiber to a licensed stream, with manufacture and decay beside the carriers, and end where schools and archives meet them."
 ~#proof: "Every stop is an anchor in the physical, record, or learning class; carrier facts live at their stops, and this trail only orders them and asks before each one."
 ~#door: "Start at the fibers stop and write one prediction before each new carrier."
 ~#audience: "readers who want the history of media as one walk"
 continuity: "Scroll to Stream | carrier"
 cold_open: "Walk from twisted fiber to a licensed stream, one carrier at a time, and watch how each one fails."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "stops follow the scroll-to-stream row of final-plan-v3 trails",
  "every stop anchor was matched against the cut on disk on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "fact-check 2026-10-03: the walk put magnetic tape before film stock and called the order one of arrival; celluloid roll film (1889) came before coated tape (1928 patent, 1935 Magnetophon), so film now precedes tape, and the header and arrival reading now say the order is rough and grouped by medium; the plan row keeps the old order"
 ]
}

^["edges"]{
 grounds: [ ~"../contract.spw#cut_contract" ]
 feeds: [ ~"./matter-to-meaning.spw#trail_matter_to_meaning" ]
 see: [ ~"../panels/affinity-atlas.spw#panel_affinity_scroll_feed" ]
}

^["concepts"]{
 primary: [ #carrier, #supersession ]
 transfers: [ #fixity, #playback_dependency ]
 tensions: [ #license_not_object ]
}

#>trail_scroll_stops
^["stops"]{
 classes: #[ physical, record, learning ]
 walk: <<
  ~"../physical/materials/fibers-and-textiles.spw#materials_fibers" ;
  ~"../record/inscription/surfaces-tablet-scroll-codex.spw#inscription_surfaces" ;
  ?{ "which surface first let a reader jump straight to a passage" } ~<prediction> ;
  ~"../record/inscription/inks-and-inscription.spw#inscription_inks" ;
  ~"../record/inscription/paper-and-pulp-manufacture.spw#inscription_paper" ;
  ~"../record/inscription/print-and-press.spw#inscription_print" ;
  ~"../record/carriers/sound/phonograph-shellac-and-vinyl.spw#media_carriers_disc_sound" ;
  ?{ "what made a disc easier to copy than a cylinder" } ~<prediction> ;
  ~"../record/carriers/moving-image/film-stock-and-bases.spw#media_carriers_film_stock" ;
  ~"../record/carriers/sound/magnetic-tape-and-cassette.spw#media_carriers_tape" ;
  ~"../record/carriers/moving-image/videotape.spw#media_carriers_videotape" ;
  ~"../record/carriers/format-wars.spw#media_carriers_format_wars" ;
  ?{ "did the better picture win the cassette war" } ~<prediction> ;
  ~"../record/carriers/digital/optical-discs.spw#media_carriers_optical" ;
  ~"../record/carriers/digital/streaming-and-files.spw#media_carriers_streaming" ;
  ~"../record/carriers/digital/reading-devices.spw#media_carriers_reading" ;
  ~"../record/carriers/carrier-manufacturing.spw#media_carriers_manufacturing" ;
  ~"../record/carriers/carrier-decay-and-fixity.spw#media_carriers_decay" ;
  ?{ "which carrier on this walk will be unreadable first" } ~<prediction> ;
  ~"../learning/generations/continuities-matrix.spw#generations_continuities" ;
  ~"../record/information/archives-and-preservation.spw#information_science_archives"
 >>
 ^["notes"]{
  materials_fibers: "twist and weave come first, and the loom card is the first stored pattern on this walk"
  inscription_surfaces: "clay, roll, and codex each trade durability, portability, and cost differently"
  inscription_inks: "carbon sits on the page while iron-gall bites into it; keep that difference for the decay stop"
  inscription_paper: "machines and wood pulp made paper cheap after 1800, and acid sizing made much of it brittle"
  inscription_print: "print begins with East Asian woodblocks and metal type before the Mainz press"
  media_carriers_disc_sound: "a stamped disc turns one master into thousands of copies"
  media_carriers_film_stock: "the film base moves from one that burns to one that turns to vinegar to polyester"
  media_carriers_tape: "tape makes sound erasable and editable, and the cassette makes copying cheap"
  media_carriers_videotape: "helical scan shrinks a broadcast machine into a home cassette"
  media_carriers_format_wars: "alliances and complements settle most format wars, not picture quality"
  media_carriers_optical: "one disc diameter holds more as the laser shortens and the lens strengthens"
  media_carriers_streaming: "a stream is a file cut into pieces and unlocked by a license, not an object you hold"
  media_carriers_reading: "electronic paper imitates the page while the book becomes a license"
  media_carriers_manufacturing: "counterpoint: discs are pressed from stampers, while tape and film are coated webs"
  media_carriers_decay: "counterpoint: every carrier decays by its own chemistry, and a checksum guards the digital copy"
  generations_continuities: "landing: the classroom screen changed fastest while the grammar of schooling held"
  information_science_archives: "landing: an archive keeps any of these trustworthy by order, description, and scheduled checks"
 }
}

#>trail_scroll_legs
^["legs"]{
 hand: #[ materials_fibers, inscription_surfaces, inscription_inks, inscription_paper, inscription_print ]
 playback: #[ media_carriers_disc_sound, media_carriers_film_stock, media_carriers_tape, media_carriers_videotape, media_carriers_format_wars, media_carriers_optical, media_carriers_streaming, media_carriers_reading ]
 counterpoint: #[ media_carriers_manufacturing, media_carriers_decay ]
 landing: #[ generations_continuities, information_science_archives ]
}

^["readings"]{
 #>trail_scroll_arrival
 ^["arrival_order"]{
  #:claim #!interpretive
  statement: "Each carrier on this walk took the main use of an older one while the older one lingered, so carriers are placed roughly by first arrival and grouped by medium, never by disappearance."
  see: [ ~"../record/carriers/form-factor-ladder.spw#media_carriers_supersedes_rule" ]
  ^["limits"]{
   holds: "first arrivals in main use as the stops date them: the gramophone disc in 1887, celluloid roll film in 1889, coated tape in the 1930s, and videotape in 1956"
   fails: "niches where an older carrier stayed primary, such as vinyl for collectors or paper for legal records"
   outside_order: "the format-wars stop spans the 1948 record war to the 1970s cassette war, and the counterpoint and landing stops sit outside the arrival order"
  }
 }
 #>trail_scroll_reader_machine
 ^["reader_machine"]{
  #:claim #!interpretive
  statement: "The later the carrier on this walk, the more machine a reader needs, so keeping a record shifts from the object to the player, the format, and the license."
  see: [ ~"../record/carriers/playback-dependency-dag.spw#media_carriers_playback_dag" ]
  ^["limits"]{
   holds: "playback carriers from the disc onward"
   fails: "the codex and the printed page, which need only light and a literate reader"
  }
 }
}

^["try"]{
 #>trail_scroll_try_shelf
 ^["carrier_shelf"]{
  materials: [
   "three carriers from your home, such as a book, a disc, and a phone",
   "an index card for each",
   "a pen"
  ]
  steps: <<
   "write what each carrier needs before anyone can read it" ;
   "guess which one will be unreadable first and write the guess down" ;
   "walk the decay stop and check each card against its row" ;
   "mark each guess hit or miss and keep the cards"
  >>
  time: .{ n: 20, unit: "minutes" }
  safety: "do not open, heat, or scrape a disc, tape, or film; reading its label is enough"
  shows: ~"./scroll-to-stream.spw#trail_scroll_reader_machine"
 }
}

#>trail_scroll_survival_q
?["Does a carrier that needs more machine get copied sooner?"]{
 #:depth #!historical ~#lens(material grain)
 #:claim #!speculative
 ~#hypothesis: "Carriers that need a dedicated player should be migrated to new formats sooner than paper of the same age, because the player fails before the medium does."
 !probe{ "compare migration dates for acid paper, cassettes, and optical discs in one archive" =id[p_trail_scroll_migration] =kind[lit] }
 $%[media.paper.iso9706_ph_min, media.optical.cd_capacity_mib]
 breaks: "paper decays by chemistry while a disc fails with its drive, so the two clocks measure different losses"
 ~"./scroll-to-stream.spw#trail_scroll_reader_machine" ~#neighbor(nearest)
}
