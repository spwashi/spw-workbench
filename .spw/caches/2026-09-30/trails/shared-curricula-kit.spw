# Shared Curricula Kit
#
# Material and method for a site story about sharing curricula across generations: what each generation was taught, what the evidence says, how to ask, and how to keep the answers. A kit, not the story.

#>trail_shared_curricula
#:layer #!creative
#:domain #!trail
#:form #!trail
#:level #!intro
#:review #!spot_checked
#:valence #!boon
#:era #!modern

^"emit"{
 ~#title: "Shared Curricula Kit"
 ~#claim: "Thirteen stops gather what a story about sharing curricula with parents needs: the school each cohort met, the evidence behind the fights, how to ask, and how to keep the answers."
 ~#proof: "Every stop is an anchor in the learning, language-and-mind, society, or record class; this is a kit, not the story, so it names materials and methods and writes no family memories."
 ~#door: "Read the curricula ladder for each person you will talk with, then open the interview consent state."
 ~#audience: "a writer preparing a story about school across generations, and families who want to compare notes"
 continuity: "Shared Curricula Kit | not the story"
 cold_open: "This kit gathers the material and the method for a story about school across generations, but it is not the story."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "stops follow the shared-curricula-kit row of final-plan-v3 trails",
  "every stop anchor was matched against the cut on disk on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "fact-check 2026-10-03: the consent reading implied shared material survives withdrawal; the protocol deletes every copy and dates the deletion, and the reading now says so",
  "fact-check 2026-10-03: the reading-gap probe cited the 2020 to 2022 NAEP age-9 declines, which measure a pandemic drop and not a curriculum swing; it now cites the state reading-law count, a verify cell that tracks the reading row in law"
 ]
}

^["edges"]{
 feeds: [ ~"./role-words-over-time.spw#trail_role_words" ]
 see: [ ~"../learning/intergenerational-kit/interview-protocol.spw#generations_kit_interview_consent" ]
}

^["concepts"]{
 primary: [ #curriculum_memory, #consent ]
 transfers: [ #cohort, #fixity ]
 tensions: [ #overclaim ]
}

#>trail_curricula_not_story
^["not_the_story"]{
 home: "the site story belongs to the owner site in its own repository; this cut holds the kit it draws on"
 kit: "materials, methods, and keeping practice, each at a stop"
 refuses: "any family memory, any private individual, and any ranking of a person or a generation"
}

#>trail_curricula_stops
^["stops"]{
 classes: #[ learning, language_and_mind, society, record ]
 walk: <<
  ~"../learning/generations/us-curricula-by-generation.spw#generations_us_curricula" ;
  ~"../learning/generations/policy-landmarks-ledger.spw#generations_policy_ledger" ;
  ~"../learning/generations/continuities-matrix.spw#generations_continuities" ;
  ?{ "what will two generations in your family agree school was like" } ~<prediction> ;
  ~"../learning/generations/curriculum-wars-matrix.spw#generations_curriculum_wars" ;
  ~"../learning/generations/public-worry-hooks.spw#generations_worry_hooks" ;
  ~"../language-and-mind/cognition/cognitive-development.spw#cognition_development" ;
  ~"../language-and-mind/linguistics/phonetics-and-phonology.spw#linguistics_phonology" ;
  ~"../society/communities/custodian-roles.spw#communities_custodian_roles" ;
  ~"../learning/intergenerational-kit/interview-protocol.spw#generations_kit_interview" ;
  ~"../learning/intergenerational-kit/difference-probes.spw#generations_kit_probes" ;
  ?{ "which probe will surface the biggest difference" } ~<prediction> ;
  ~"../learning/intergenerational-kit/curriculum-memory-map.spw#generations_kit_memory_map" ;
  ~"../learning/intergenerational-kit/artifact-dossier-template.spw#generations_kit_artifact_template" ;
  ~"../record/information/archives-and-preservation.spw#information_science_archives"
 >>
 ^["notes"]{
  generations_us_curricula: "material: find the rung for each person you will talk with"
  generations_policy_ledger: "material: the reports, laws, and rulings behind each rung"
  generations_continuities: "material: what held steady, so the differences stand out"
  generations_curriculum_wars: "evidence: systematic phonics has support; the math and history fights are mostly about aims"
  generations_worry_hooks: "evidence: read a school poll with its sample and wording before quoting it"
  cognition_development: "evidence: children everywhere change along shared paths at different paces"
  linguistics_phonology: "evidence: the sound system behind phonics, for a reader who wants to know why decoding works"
  communities_custodian_roles: "method: credit the storytellers and community archives this practice comes from"
  generations_kit_interview: "method: consent first, prompts keyed to the narrator school years, withdrawal honored"
  generations_kit_probes: "method: ask two generations the same question and let the difference send you to the timeline"
  generations_kit_memory_map: "method: one row per person and one column per topic"
  generations_kit_artifact_template: "keeping: a report card becomes a source with custody, consent, a scan, and a checksum"
  information_science_archives: "keeping: original order, description, and scheduled fixity checks"
 }
}

#>trail_curricula_kit
^["kit"]{
 material: #[ generations_us_curricula, generations_policy_ledger, generations_continuities ]
 evidence: #[ generations_curriculum_wars, generations_worry_hooks, cognition_development, linguistics_phonology ]
 method: #[ communities_custodian_roles, generations_kit_interview, generations_kit_probes, generations_kit_memory_map ]
 keeping: #[ generations_kit_artifact_template, information_science_archives ]
}

^["readings"]{
 #>trail_curricula_difference
 ^["difference_as_prompt"]{
  #:claim #!interpretive
  statement: "The kit treats every difference between two people's memories of school as a prompt to look something up together, never as a verdict on either person or their school."
  see: [ ~"../learning/intergenerational-kit/difference-probes.spw#generations_kit_probes" ]
  ^["limits"]{
   holds: "families in the United States whose members attended school there"
   fails: "families schooled across countries, where the ladder and the ledger cover only one system"
  }
 }
 #>trail_curricula_consent_order
 ^["consent_before_material"]{
  #:claim #!interpretive
  statement: "Consent comes before any material is shown to a narrator, who may withdraw at any stop; then every copy of what they shared is deleted and the deletion dated in the family log."
  see: [ ~"../learning/intergenerational-kit/interview-protocol.spw#generations_kit_interview_withdraw" ]
 }
}

^["try"]{
 #>trail_curricula_try_pack
 ^["pack_the_kit"]{
  materials: [ "a folder", "printouts of the consent state and two difference probes", "one blank memory map grid", "one blank artifact dossier" ]
  steps: <<
   "find the curricula rung for each person you plan to talk with" ;
   "pick two probes that match those rungs" ;
   "write your guess of the biggest difference on the folder flap" ;
   "put the consent state first, then the probes, the grid, and the dossier" ;
   "date the folder and keep it with your recording plan"
  >>
  time: .{ n: 30, unit: "minutes" }
  safety: "ask before recording anyone, keep recordings off shared drives unless the narrator agrees, and leave out names of people who are not present"
  shows: ~"./shared-curricula-kit.spw#trail_curricula_consent_order"
 }
}

#>trail_curricula_reading_gap_q
?["Will two generations disagree most about how reading was taught?"]{
 #:depth #!social ~#lens(historical layer)
 #:claim #!speculative
 ~#hypothesis: "Family pairs should report bigger differences on how reading was taught than on how math was taught, because the reading row of the curriculum wars swung further."
 !probe{ "tally which probe topic each family pair marks as most different, with consent and without names" =id[p_trail_curricula_reading_gap] =kind[interview] }
 $%[learn.policy.states_reading_laws_count]
 ~"./shared-curricula-kit.spw#trail_curricula_difference" ~#neighbor(nearest)
}
