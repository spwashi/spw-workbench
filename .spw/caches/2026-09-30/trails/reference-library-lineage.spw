# Reference Library Lineage
#
# A trail from the leishu and Llull through renvois, facets, the memex, Mnemosyne, card indexes, Whole Earth, Foxfire, OAIS, and Wikidata to the caution of Borges, ending at this cut vocabulary and contract.

#>trail_reference_lineage
#:layer #!pragmatics
#:domain #!trail
#:form #!trail
#:level #!intro
#:review #!adversarial_checked
#:valence #!boon

^"emit"{
 ~#title: "Reference Library Lineage"
 ~#claim: "Eleven stops walk the reference habits this cut borrows, from compiled categories and combining wheels to facets, trails, fixity, and sourced statements, and end at its own vocabulary and contract."
 ~#proof: "The rungs are anchors in the record class, the panels and graph idioms show the habits at work, and the last two stops are the rules that apply them; the trail form itself is credited to Bush."
 ~#door: "Climb the rungs in the first stop, then find each borrowed habit again in the contract."
 ~#audience: "librarians, archivists, and anyone building a linked collection of notes"
 continuity: "Reference Library Lineage | borrowed habit"
 cold_open: "Every borrowed habit in this cut has an ancestor, from Chinese compilations to Wikidata, and this walk meets each one."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "stops follow the reference-library-lineage row of final-plan-v3 trails, with the graph idioms stop inserted as the plan asks",
  "every stop anchor was matched against the cut on disk on 2026-10-03"
 ]
 pending: "the plan also lists the concept lattice panel; it is not on disk yet, so it is left off the walk rather than linked unwritten"
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "fact-check 2026-10-03: panels and the cut root files are apparatus, not subject classes, so they are listed apart from the classes"
 ]
}

^["edges"]{
 grounds: [ ~"../contract.spw#cut_contract" ]
 feeds: [ ~"./role-words-over-time.spw#trail_role_words" ]
}

^["concepts"]{
 primary: [ #renvoi, #faceted_classification ]
 transfers: [ #visible_gap, #fixity ]
 tensions: [ #ossified_taxonomy ]
}

#>trail_reference_stops
^["stops"]{
 classes: #[ record, spw ]
 apparatus: #[ panels, cut_root ]
 walk: <<
  ~"../record/information/reference-works-lineage.spw#information_science_reference_lineage" ;
  ~"../record/information/knowledge-organization.spw#information_science_knowledge_org" ;
  ?{ "which scheme makes room for a subject nobody had named yet" } ~<prediction> ;
  ~"../record/information/archive-patterns-matrix.spw#information_science_patterns" ;
  ~"../record/information/archives-and-preservation.spw#information_science_archives" ;
  ~"../record/information/taxonomy-cautions.spw#information_science_cautions" ;
  ~"../panels/affinity-atlas.spw#panel_affinity_atlas" ;
  ~"../panels/gap-table.spw#panel_gap_table" ;
  ?{ "what does an empty cell tell you that a full one cannot" } ~<prediction> ;
  ~"../panels/llull-wheel.spw#panel_llull_wheel" ;
  ~"../spw/graph-idioms.spw#spw_graph_idioms" ;
  ~"../vocabulary.spw#cut_vocabulary" ;
  ~"../contract.spw#cut_contract"
 >>
 ^["notes"]{
  information_science_reference_lineage: "climb the rungs below before going on; each rung names one pattern"
  information_science_knowledge_org: "enumerative schemes list subjects in advance; faceted schemes build them from parts"
  information_science_patterns: "each pattern answers addressing, relation, facets, gaps, fixity, and access; read the borrow line"
  information_science_archives: "respect des fonds, original order, and scheduled fixity checks"
  information_science_cautions: "the caution: any single taxonomy encodes its makers and hardens, as Borges mocked"
  panel_affinity_atlas: "the Warburg habit at work: plates that set distant forms side by side, with a break line"
  panel_gap_table: "the Mendeleev habit at work: empty cells that name their neighbors"
  panel_llull_wheel: "the Llull habit at work: turning rings that generate question stems, never findings"
  spw_graph_idioms: "the habits restated as Spw idioms: one parent, typed edges, closed facets, registries"
  cut_vocabulary: "facets made closed sets, the Colon habit under a gate"
  cut_contract: "the rules that apply every borrowed habit, and the ethics that credit their origins"
 }
}

#>trail_reference_rungs
^["rungs"]{
 walk: <<
  ~"../record/information/reference-works-lineage.spw#information_science_lineage_leishu" ;
  ~"../record/information/reference-works-lineage.spw#information_science_lineage_llull" ;
  ~"../record/information/reference-works-lineage.spw#information_science_lineage_encyclopedie" ;
  ~"../record/information/reference-works-lineage.spw#information_science_lineage_ranganathan" ;
  ~"../record/information/reference-works-lineage.spw#information_science_lineage_bush" ;
  ~"../record/information/reference-works-lineage.spw#information_science_lineage_warburg" ;
  ~"../record/information/reference-works-lineage.spw#information_science_lineage_luhmann" ;
  ~"../record/information/reference-works-lineage.spw#information_science_lineage_whole_earth" ;
  ~"../record/information/reference-works-lineage.spw#information_science_lineage_foxfire" ;
  ~"../record/information/reference-works-lineage.spw#information_science_lineage_oais" ;
  ~"../record/information/reference-works-lineage.spw#information_science_lineage_wikidata" ;
  ~"../record/information/taxonomy-cautions.spw#information_science_cautions_borges"
 >>
 order: "the rungs follow the habit a reader meets, not strict date order; Warburg worked before Bush, and Foxfire began before the Whole Earth Catalog"
}

#>trail_reference_borrowed
^["borrowed_habits"]{
 compiled_categories: "leishu, kept as the class tree that only finds things"
 combining_wheels: "Llull, kept as the wonder wheel that only prompts"
 cross_references: "Encyclopedie renvois, kept as typed edges"
 facets: "Colon Classification, kept as closed vocabularies"
 trails: "the memex, kept as this folder"
 plates: "Mnemosyne, kept as the affinity atlas"
 linked_cards: "the Luhmann card index, kept as anchors and links"
 reader_reviews: "Whole Earth, kept as readings outside the cut"
 community_credit: "Foxfire, kept as the origins rule"
 fixity: "OAIS and LOCKSS, kept as the manifest and receipts"
 sourced_statements: "Wikidata, kept as the claim frame with source and status"
}

^["readings"]{
 #>trail_reference_memex
 ^["memex_trail"]{
  #:claim #!settled
  statement: "Bush imagined in 1945 a memex user who ties items into a named trail, recalls it later, and can pass a copy of the trail to a colleague."
  source: ~"../registries/sources/trails.spw#src_trail_bush_1945"
  reads: %[trail.memex.essay_year]
  ^["limits"]{
   holds: "the trail as Bush described it, a sequence a person builds by hand"
   fails: "computed paths and search results, which no person walked or chose"
  }
 }
 #>trail_reference_answers
 ^["one_question"]{
  #:claim #!interpretive
  statement: "Each rung answers how to find a thing again in a growing collection, and each answer returns at the end of this walk as a rule in the contract."
  see: [ ~"../record/information/archive-patterns-matrix.spw#information_science_patterns_declined" ]
 }
}

^["try"]{
 #>trail_reference_try_renvois
 ^["typed_renvois"]{
  materials: [ "ten index cards from your own notes", "a pen", "the relation set in the vocabulary" ]
  steps: <<
   "number the cards one to ten" ;
   "on each card write one renvoi to another card with a relation word such as needs, contrasts, or case_of" ;
   "guess which card will collect the most incoming renvois and write it down" ;
   "count incoming renvois per card and compare with the guess" ;
   "pick five cards and order them as a trail someone else could walk"
  >>
  time: .{ n: 30, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"./reference-library-lineage.spw#trail_reference_memex"
 }
}

#>trail_reference_strain_q
?["Where will this cut vocabulary strain first as it grows?"]{
 #:depth #!historical ~#lens(curated collection)
 #:claim #!speculative
 ~#hypothesis: "The closed sets should strain first in the domain axis, where new subjects arrive, before the form or level axes, as enumerative schemes strained at new subjects."
 !probe{ "count vocabulary values used by one file only, per axis, at each future cut" =id[p_trail_reference_strain] =kind[census] }
 $%[prov.encyclopedie.text_volume_count, prov.ddc.main_class_count]
 breaks: "the Encyclopedie grew by authors adding articles, while this cut grows by packages and a gate, so strain shows up as gate failures rather than volumes"
 ~"./reference-library-lineage.spw#trail_reference_answers" ~#neighbor(nearest)
}
