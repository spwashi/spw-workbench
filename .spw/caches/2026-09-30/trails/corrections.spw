# Corrections
#
# A scientific-integrity trail through how this cut corrected its generated source and keeps each correction in view: scorecard, errata, harm register, replication and guideline ledgers, and its own receipts.

#>trail_corrections
#:layer #!pragmatics
#:domain #!trail
#:form #!trail
#:level #!intro
#:review #!adversarial_checked
#:valence #!honk

^"emit"{
 ~#title: "Corrections"
 ~#claim: "Ten stops show how this cut scored its raw source, logged each error beside its fix, pointed at harmful lines without repeating them, and keeps replaced findings and rules in view."
 ~#proof: "Every stop is an anchor in the language-and-mind, living, making, or spw class or in the provenance apparatus; the visible-correction rule is the one COPE gives for retractions."
 ~#door: "Start at the scorecard, then follow one raw line from its errata row to the surface that fixed it."
 ~#audience: "readers deciding how far to trust this cut, and editors building their own correction trail"
 continuity: "Corrections | in view"
 cold_open: "Follow one error from the scorecard to its fix, and see how this cut keeps each correction in view."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "stops follow the corrections row of final-plan-v3 trails",
  "every stop anchor was matched against the cut on disk on 2026-10-03",
  "the COPE guidance was matched against Crossref on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "fact-check 2026-10-03: provenance is an apparatus directory, not a subject class, so it is listed apart from the classes"
 ]
}

^["edges"]{
 grounds: [ ~"../contract.spw#cut_contract" ]
 feeds: [ ~"./reference-library-lineage.spw#trail_reference_lineage" ]
}

^["concepts"]{
 primary: [ #correction, #provenance ]
 transfers: [ #replication, #guideline_drift ]
 tensions: [ #overclaim ]
}

^["scope"]{
 health: "this trail visits the harm register and the nursing guideline ledger only to see how corrections are kept; it gives no clinical guidance and repeats no harmful line"
 quarantine: "quarantined raw files are named only by the stops that point at them, never cited here"
}

#>trail_corrections_stops
^["stops"]{
 classes: #[ language_and_mind, living, making, spw ]
 apparatus: #[ provenance ]
 walk: <<
  ~"../provenance/review-scorecard.spw#provenance_scorecard" ;
  ?{ "where in the raw shelf did errors cluster, the core lists or the wonder" } ~<prediction> ;
  ~"../provenance/errata-technical.spw#provenance_errata_technical" ;
  ~"../provenance/errata-life-and-mind.spw#provenance_errata_life_mind" ;
  ~"../provenance/errata-culture-and-society.spw#provenance_errata_culture" ;
  ~"../provenance/harm-register.spw#provenance_harm_register" ;
  ~"../language-and-mind/cognition/replication-ledger.spw#cognition_replication_ledger" ;
  ~"../living/nursing/guideline-currency-ledger.spw#nursing_guideline_ledger" ;
  ~"../making/film/labor-agreements-ledger.spw#film_labor_ledger" ;
  ?{ "what should happen to a rule once a newer version replaces it" } ~<prediction> ;
  ~"../spw/theory/epistemic-status.spw#spw_theory_epistemic_status" ;
  ~"../spw/history/this-cut.spw#workbench_history_this_cut"
 >>
 ^["notes"]{
  provenance_scorecard: "two review rounds found core lists mostly right and errors concentrated in taste and wonder"
  provenance_errata_technical: "editor caches invented features; science files mixed up laws, names, and magnitudes"
  provenance_errata_life_mind: "dropped theorem conditions and contested findings stated as settled"
  provenance_errata_culture: "dated rules, inverted shares, and uncredited frameworks"
  provenance_harm_register: "pointers to harmful raw lines, each beside its correcting source, never the line itself"
  cognition_replication_ledger: "the same discipline in a field: findings that shrank or vanished stay in the ledger"
  nursing_guideline_ledger: "read for its form only: each replaced guideline stays beside the version in force"
  film_labor_ledger: "agreements replace one another on dates, and the ledger keeps both"
  spw_theory_epistemic_status: "a status moves only when evidence and a receipt move it"
  workbench_history_this_cut: "the cut counts its own receipts by care rung like any other record"
 }
}

^["readings"]{
 #>trail_corrections_cope
 ^["retractions_stay_visible"]{
  #:claim #!settled
  statement: "COPE guidance of 2009 says a retracted article should stay in the record, clearly marked as retracted, with a notice linked to it, rather than be removed."
  source: ~"../registries/sources/trails.spw#src_trail_wager_2009"
  ^["limits"]{
   holds: "journal articles under editors who follow COPE"
   fails: "preprints, websites, and generated text, which no editor retracts unless someone keeps a ledger"
  }
 }
 #>trail_corrections_same_rule
 ^["same_rule_here"]{
  #:claim #!interpretive
  statement: "Every stop on this walk applies the retraction rule to a different record: a known error, a replaced guideline, or a superseded agreement stays in view beside what replaced it."
  source: ~"../registries/sources/trails.spw#src_trail_cut_contract"
  see: [ ~"../provenance/errata-technical.spw#provenance_errata_technical" ]
 }
 #>trail_corrections_care_shown
 ^["care_shown"]{
  #:claim #!interpretive
  statement: "Receipts let the next reader see how much care a surface already got and start checking where that care ran out, instead of trusting or doubting the whole cut at once."
  see: [ ~"../spw/history/this-cut.spw#workbench_history_this_cut_care" ]
 }
}

^["try"]{
 #>trail_corrections_try_follow
 ^["follow_one_fix"]{
  materials: [ "the errata technical ledger", "a notebook" ]
  steps: <<
   "pick one errata row and copy its raw path and line" ;
   "write what you think the raw line got wrong before reading the row" ;
   "read the row and open the surface that carries the correction" ;
   "find that surface receipts and note the highest care they report" ;
   "write one sentence on whether the fix is visible to a reader who met the error elsewhere"
  >>
  time: .{ n: 25, unit: "minutes" }
  safety: "skip harm register rows if a health topic is personally hard; the trail works with any technical row"
  shows: ~"./corrections.spw#trail_corrections_same_rule"
 }
}

#>trail_corrections_trust_q
?["Does a visible errata ledger raise trust in corrected surfaces?"]{
 #:depth #!ethical ~#lens(curated collection)
 #:claim #!speculative
 ~#hypothesis: "Readers shown an errata row beside its fix should trust the corrected surface more, and surfaces without receipts less, than readers shown neither."
 !probe{ "find studies of reader trust after correction notices in journals and newsrooms" =id[p_trail_corrections_trust] =kind[lit] }
 $%[prov.review.r1_effect_line_recount, hosts.cut.fact_checked_file_count]
 ~"./corrections.spw#trail_corrections_cope" ~#neighbor(nearest)
}
