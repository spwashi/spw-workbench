# Clocks and Cadences
#
# A trail that reads rhythm as one shared form across organisms, schools, shows, and ledgers, and ends at living forms proposed as patterns for scripts.

#>trail_clocks_and_cadences
#:layer #!pragmatics
#:domain #!trail
#:form #!trail
#:level #!intro
#:review #!spot_checked
#:valence #!boon
#:season #!reflection

^"emit"{
 ~#title: "Clocks and Cadences"
 ~#claim: "Ten stops compare how cells, plants, schools, shows, and ledgers keep time, each with a period, a reset cue, and a window that matters most."
 ~#proof: "Every stop is an anchor in the living, learning, or making class or in the season apparatus; the trail asks the same three questions of each and leaves the answers at the stops."
 ~#door: "Start at the biological clocks stop and write each rhythm as period, reset cue, and window."
 ~#audience: "planners, teachers, and makers who keep several calendars at once"
 continuity: "Clocks and Cadences | reset cue"
 cold_open: "Every rhythm here has a period, a reset cue, and a window, from a bean leaf to a school term."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "stops follow the clocks-and-cadences row of final-plan-v3 trails",
  "every stop anchor was matched against the cut on disk on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "fact-check 2026-10-03: season is an apparatus directory, not a subject class, so it is listed apart from the classes"
 ]
}

^["edges"]{
 feeds: [ ~"./season-2026-q4.spw#trail_season_2026_q4" ]
 see: [ ~"./attention-arcs.spw#trail_attention_arcs" ]
}

^["concepts"]{
 primary: [ #oscillator, #season_cadence ]
 transfers: [ #sensitive_period, #new_year_reset ]
 tensions: [ #false_analogy ]
}

#>trail_clocks_stops
^["stops"]{
 classes: #[ living, learning, making ]
 apparatus: #[ season ]
 walk: <<
  ~"../living/development-and-ecology/biological-clocks.spw#development_ecology_clocks" ;
  ?{ "does a clock in a dark room keep exactly one day" } ~<prediction> ;
  ~"../living/plants/horticultural-science.spw#plant_science_horticulture" ;
  ~"../living/development-and-ecology/sensitive-periods.spw#development_ecology_sensitive_periods" ;
  ~"../living/development-and-ecology/succession-and-resilience.spw#development_ecology_resilience" ;
  ?{ "which reset is chosen and which is forced on a system" } ~<prediction> ;
  ~"../learning/institutions/academic-year-cadence.spw#institutions_academic_year" ;
  ~"../making/broadcast/episode-run-sheet.spw#broadcast_run_sheet" ;
  ~"../making/broadcast/broadcast-cadence.spw#broadcast_cadence" ;
  ~"../season/fiscal-and-academic-years.spw#season_fiscal_academic" ;
  ?{ "which of these rhythms would drift if nobody kept a calendar" } ~<prediction> ;
  ~"../living/development-and-ecology/forms-for-scripts.spw#development_ecology_script_forms" ;
  ~"../season/retrospective-protocol.spw#season_retrospective"
 >>
 ^["notes"]{
  development_ecology_clocks: "period near a day, a tide, or a year; light and food are the reset cues"
  plant_science_horticulture: "night length is the cue a poinsettia reads, so a streetlight can break its season"
  development_ecology_sensitive_periods: "a window when experience shapes development most; graded, sometimes reopened"
  development_ecology_resilience: "growth, lock-in, release, and reorganization; a reset can be a fire"
  institutions_academic_year: "midterms, registration, finals, and a new term; the calendar is the cue"
  broadcast_run_sheet: "inside one episode each hour has one job, a cadence at the scale of a show"
  broadcast_cadence: "a daily show must name who speaks on the rest days, or the host carries every one"
  season_fiscal_academic: "fiscal years turn on different dates, so October finds each ledger at a different phase"
  development_ecology_script_forms: "cycles, metamorphosis, and succession proposed as script patterns, each with a break line"
  season_retrospective: "the reset most crews can choose: look back, celebrate, choose, and close"
 }
}

#>trail_clocks_questions
^["three_questions"]{
 period: "how long until the rhythm repeats"
 cue: "what outside signal resets it, and who controls that signal"
 window: "when in the cycle an input matters most"
}

^["readings"]{
 #>trail_clocks_shared_form
 ^["shared_form"]{
  #:claim #!interpretive
  statement: "Cells, plants, schools, shows, and ledgers can each be read as a period, a reset cue, and a window, but only living clocks keep running without a calendar."
  see: [ ~"../living/development-and-ecology/biological-clocks.spw#development_ecology_clocks_human_tau" ]
  ^["limits"]{
   holds: "as a set of questions that compare rhythms"
   fails: "as a mechanism; an academic year has no oscillator inside it and stops when people stop keeping it"
  }
 }
 #>trail_clocks_chosen_reset
 ^["chosen_reset"]{
  #:claim #!interpretive
  statement: "Resets on this walk run from forced, such as light on a leaf or fire in a forest, to chosen, such as a retrospective; the later stops let a crew pick its cue."
  see: [ ~"../season/retrospective-protocol.spw#season_retro_reset" ]
 }
}

^["try"]{
 #>trail_clocks_try_rhythm_card
 ^["rhythm_card"]{
  materials: [ "three index cards", "a pen", "one week of your own calendar" ]
  steps: <<
   "pick three rhythms you keep, one bodily, one seasonal, and one institutional" ;
   "write the period, the reset cue, and the window for each" ;
   "guess which one would drift first without a calendar and write the guess down" ;
   "check the guess against the clocks stop and the academic year stop"
  >>
  time: .{ n: 15, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"./clocks-and-cadences.spw#trail_clocks_shared_form"
 }
}

#>trail_clocks_drift_q
?["Does a show cadence drift without a reset cue the way a free-running clock does?"]{
 #:depth #!social ~#lens(bodily rhythm)
 #:claim #!speculative
 ~#hypothesis: "A recurring show with no fixed weekly reset should slide its start times in one direction over a season, as a clock in constant dim light drifts from the day."
 !probe{ "log start times of one recurring stream for a season and fit a drift line" =id[p_trail_clocks_show_drift] =kind[field] }
 $%[eco.clock.human_tau_h, season.calendar.tropical_year_days]
 breaks: "a circadian clock drifts by its molecular period, while a show drifts by choices, travel, and contracts that can push either way"
 ~"./clocks-and-cadences.spw#trail_clocks_shared_form" ~#neighbor(nearest)
}
