# Intergenerational Kit
#
# A kit for comparing what different generations were taught: an interview protocol, paired difference probes, a family memory map, and an artifact dossier, all built around consent.

#>generations_kit_index
#:layer #!creative
#:domain #!generations
#:form #!index
#:level #!intro
#:review #!spot_checked
#:valence #!boon

^"emit"{
 ~#title: "Intergenerational Kit"
 ~#claim: "Four tools let a family compare schooling across generations with consent: interview, paired probes, a memory map, and artifact dossiers; the kit feeds a story and holds none."
 ~#proof: "The protocol follows Oral History Association principles and digital preservation practice; prompts link the generations ledger and matrices."
 ~#door: "Read the consent state first, then pick two difference probes and fill a two-row memory map."
 ~#audience: "families, teachers, and students who want to talk across generations about school"
 continuity: "Intergenerational Kit | with consent"
 cold_open: "Ask, listen, map the differences, and keep what you gather with consent, so the story stays yours to tell."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #woven, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #pass }
  ^["r2"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["tree"]{
 interview: ~"./interview-protocol.spw"
 probes: ~"./difference-probes.spw"
 map: ~"./curriculum-memory-map.spw"
 artifacts: ~"./artifact-dossier-template.spw"
}

^["bundle"]{
 ={ ~"./interview-protocol.spw#generations_kit_interview" }
 ={ ~"./difference-probes.spw#generations_kit_probes" }
 ={ ~"./curriculum-memory-map.spw#generations_kit_memory_map" }
 ={ ~"./artifact-dossier-template.spw#generations_kit_artifact_template" }
}

^["sequence"]{
 order: <<
  "interview protocol: consent and keeping" ;
  "difference probes: the same question to two generations" ;
  "curriculum memory map: rows, columns, and differences" ;
  "artifact dossier: objects as sources"
 >>
}

^["ethics"]{
 consent: "every narrator agrees before recording and may narrow or withdraw consent later"
 privacy: "names, recordings, transcripts, and filled maps stay with the family; the corpus holds only templates"
 difference: "a difference between generations is a reason to explore together, never a ranking of people or schools"
 boundary: "this kit feeds a story about shared curricula; it holds the method, and the story belongs to whoever tells it"
}
