# Policy Landmarks Ledger
#
# The US laws, court cases, and reports that changed what schools taught and whom they had to serve, from the Committee of Ten to the Every Student Succeeds Act, each cited to its primary source.

#>generations_policy_ledger
#:layer #!reference
#:domain #!generations
#:form #!ledger
#:level #!foundation
#:review #!sourced
#:valence #!bone
#:era #!modern

^"emit"{
 ~#title: "Policy Landmarks Ledger"
 ~#claim: "A few reports, statutes, and rulings from 1892 to 2015 shaped the school each generation met: what counted as core, who had a right to attend, and how schools were judged."
 ~#proof: "Each entry cites its primary source: the 1893 report, the statute by public law number, or the Supreme Court opinion."
 ~#door: "Read the ledger by era, then see each landmark land on a cohort in the curricula ladder."
 ~#audience: "readers comparing the schooling of parents, grandparents, and children"
 continuity: "Policy Landmarks Ledger | who had a right to attend"
 cold_open: "Reports, laws, and rulings decided what counted as core, who had a right to attend, and how schools were judged."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["edges"]{
 feeds: [ ~"./us-curricula-by-generation.spw#generations_us_curricula" ]
 see: [ ~"./curriculum-wars-matrix.spw#generations_curriculum_wars" ]
}

^["concepts"]{
 primary: [ #standards, #accountability ]
 transfers: [ #cohort ]
 tensions: [ #access ]
}

^["eras"]{
 ^["foundations"]{
  #>generations_policy_committee_ten
  ^["committee_of_ten"]{
   #:claim #!settled
   statement: "An NEA committee chaired by Charles W. Eliot, appointed in 1892, reported in 1893 that high school students should get the same academic preparation whether or not they went to college."
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_committee_of_ten"
   era: 1892..1893
  }
  #>generations_policy_cardinal
  ^["cardinal_principles"]{
   #:claim #!settled
   statement: "A 1918 NEA commission named seven aims for secondary school, among them health, citizenship, vocation, and worthy use of leisure, widening school beyond college preparation."
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_cardinal_1918"
   year: 1918
  }
 }
 ^["access"]{
  #>generations_policy_boarding_schools
  ^["boarding_schools"]{
   #:claim #!settled
   statement: "A 2022 Interior Department report identified 408 federal Indian boarding schools operating between 1819 and 1969, many of which suppressed Native languages and cultures."
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_interior_2022"
   era: 1819..1969
  }
  #>generations_policy_brown
  ^["brown"]{
   #:claim #!settled
   statement: "In 1954 the Supreme Court held that state-mandated racial segregation of public schools violates the Equal Protection Clause."
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_brown_1954"
   year: 1954
  }
  #>generations_policy_civil_rights
  ^["title_vi"]{
   #:claim #!settled
   statement: "Title VI of the Civil Rights Act of 1964 barred discrimination by race, color, or national origin in federally funded programs, schools included."
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_civil_rights_1964"
   year: 1964
  }
  #>generations_policy_title_ix
  ^["title_ix"]{
   #:claim #!settled
   statement: "Title IX of the Education Amendments of 1972 barred sex discrimination in federally funded education programs."
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_title_ix_1972"
   year: 1972
  }
  #>generations_policy_lau
  ^["lau"]{
   #:claim #!settled
   statement: "In Lau v. Nichols in 1974 the Supreme Court held that schools must take steps so students who do not speak English can take part in instruction."
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_lau_1974"
   year: 1974
  }
  #>generations_policy_eha
  ^["eha"]{
   #:claim #!settled
   statement: "The Education for All Handicapped Children Act of 1975 guaranteed children with disabilities a free appropriate public education; it was renamed IDEA in 1990."
   sources: [ ~"../../registries/sources/learning-and-generations.spw#src_learn_eha_1975", ~"../../registries/sources/learning-and-generations.spw#src_learn_idea_statute" ]
   era: 1975..1990
  }
 }
 ^["defense_and_poverty"]{
  #>generations_policy_ndea
  ^["ndea"]{
   #:claim #!settled
   statement: "After Sputnik launched in October 1957, Congress passed the National Defense Education Act of 1958, funding science, mathematics, and foreign language teaching and student loans."
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_ndea_1958"
   era: 1957..1958
  }
  #>generations_policy_esea
  ^["esea"]{
   #:claim #!settled
   statement: "The Elementary and Secondary Education Act of 1965 sent federal Title I money to districts serving children from low-income families."
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_esea_1965"
   year: 1965
  }
 }
 ^["excellence_and_accountability"]{
  #>generations_policy_nation_at_risk
  ^["nation_at_risk"]{
   #:claim #!settled
   statement: "A Nation at Risk in 1983 warned of a rising tide of mediocrity and urged more academic requirements, higher standards, and more time in school."
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_nation_at_risk"
   year: 1983
  }
  #>generations_policy_risk_diagnosis
  ^["risk_diagnosis"]{
   #:claim #!contested
   statement: "Sandia analysts argued that falling average scores mostly reflected more students taking tests, while most subgroups held steady or improved."
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_sandia_1993"
   counter: ~"../../registries/sources/learning-and-generations.spw#src_learn_nation_at_risk"
   disagreement: "an average can fall while every group rises when the mix of test takers changes"
  }
  #>generations_policy_nclb
  ^["nclb"]{
   #:claim #!settled
   statement: "No Child Left Behind, signed in January 2002, required yearly reading and math tests in grades 3 through 8 and once in high school, with targets for every student subgroup."
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_nclb_2002"
   era: 2002..2015
  }
  #>generations_policy_ccss
  ^["ccss"]{
   #:claim #!settled
   statement: "State governors and school chiefs released the Common Core State Standards for English and mathematics in 2010, for states to adopt voluntarily."
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_ccss_2010"
   later: "several states later revised, renamed, or replaced the standards; a count needs a dated tracker"
   year: 2010
  }
  #>generations_policy_essa
  ^["essa"]{
   #:claim #!settled
   statement: "The Every Student Succeeds Act of 2015 replaced No Child Left Behind, kept yearly testing, and returned the design of school accountability to the states."
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_essa_2015"
   year: 2015
  }
 }
}

^["try"]{
 #>generations_policy_try_primary
 ^["read_two_primary_sources"]{
  materials: [
   "the opening pages of A Nation at Risk",
   "the summary of the Sandia report",
   "a sheet with two columns"
  ]
  steps: <<
   "copy one sentence about test scores from each" ;
   "write what each counts and whom it counts" ;
   "decide whether both can be true at once" ;
   "note one question you would ask an elder who was in school in 1983"
  >>
  time: .{ n: 40, unit: "minutes" }
  safety: "none worth naming"
  shows: ~"./policy-landmarks-ledger.spw#generations_policy_risk_diagnosis"
 }
}

#>generations_policy_monday_q
?["Which landmark changed what teachers did on an ordinary Monday?"]{
 #:depth #!historical ~#lens(historical layer)
 #:claim #!speculative
 ~#hypothesis: "Laws that changed who sat in the room, such as Brown and the 1975 Act, changed daily practice more than reports that changed what the room was told to aim for."
 !probe{ "read classroom histories for each era and list practices that changed within five years of each landmark" =id[p_learn_policy_monday] =kind[lit] }
 literature: ~"../../registries/sources/learning-and-generations.spw#src_learn_tyack_cuban_1995"
 ~"./policy-landmarks-ledger.spw#generations_policy_eha" ~#neighbor(nearest)
}
