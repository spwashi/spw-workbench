# Learning Glossary
#
# Short definitions for the learning class, arranged as a lattice of broader, narrower, and related terms, each pointing to the leaf that explains it.

#>learning_glossary
#:layer #!reference
#:domain #!learning
#:form #!glossary
#:level #!intro
#:review #!sourced
#:valence #!bone

^"emit"{
 ~#title: "Learning Glossary"
 ~#claim: "Credit hour, prerequisite, IEP, Section 504, dual enrollment, standards, and scaffolding each name a structure, a right, or a method with a home leaf in this class."
 ~#proof: "Legal terms cite their statute or regulation; method terms cite the study that named them."
 ~#door: "Look up a term, follow its home link, then climb to a broader term."
 ~#audience: "anyone meeting school or university vocabulary for the first time"
 continuity: "Learning Glossary | home leaf"
 cold_open: "Every school word here has a short meaning, a broader term, and a home leaf that explains it."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["edges"]{
 grounds: [ ~"../registries/sources/learning-and-generations.spw#registry_src_learning_and_generations" ]
}

^["concepts"]{
 primary: [ #credit_hour, #prerequisite, #iep ]
 transfers: [ #scaffolding, #dual_enrollment ]
 tensions: [ #standards ]
 powers: [ #shared_governance, #tenure, #contingent_faculty, #indirect_costs ]
 supports: [ #section_504 ]
 methods: [ #retrieval_practice, #learning_styles, #general_education ]
}

^["lattice"]{
 relations: #[ broader, narrower, related, home ]

 ^["structures"]{
  #>learning_term_credit_hour
  ^["credit_hour"]{
   #:claim #!settled
   statement: "A credit hour is the federal unit of college work: one hour of instruction and two hours of outside work weekly across a semester, or equivalent."
   reads: %[learn.credit.semester_weeks, learn.credit.outside_hours_per_class_hour]
   source: ~"../registries/sources/learning-and-generations.spw#src_learn_credit_hour_cfr"
   related: [ ~"./learning-glossary.spw#learning_term_carnegie_unit" ]
   home: ~"./institutions/curricular-architecture.spw#institutions_curric_credit_hour"
  }
  #>learning_term_carnegie_unit
  ^["carnegie_unit"]{
   means: "a high school unit of about a year of instruction in one subject, the older sibling of the college credit hour"
   related: [ ~"./learning-glossary.spw#learning_term_credit_hour" ]
   home: ~"./institutions/curricular-architecture.spw#institutions_curric_carnegie"
  }
  #>learning_term_prerequisite
  ^["prerequisite"]{
   means: "a course that must be passed before another may be taken; prerequisites form a directed acyclic graph"
   narrower: [ "corequisite: a course taken in the same term" ]
   home: ~"./institutions/curricular-architecture.spw#institutions_curric_level_200"
  }
  #>learning_term_general_education
  ^["general_education"]{
   means: "the share of a degree meant for breadth across fields, built as a core, a distribution menu, or left open"
   broader: [ ~"./learning-glossary.spw#learning_term_credit_hour" ]
   home: ~"./institutions/curricular-architecture.spw#institutions_curric_core"
  }
  #>learning_term_standards
  ^["standards"]{
   means: "statements of what students should know and be able to do by grade; a curriculum is the sequence and materials that teach toward them"
   home: ~"./generations/policy-landmarks-ledger.spw#generations_policy_ccss"
  }
  #>learning_term_dual_enrollment
  ^["dual_enrollment"]{
   means: "college courses taken by high school students for a college transcript; the receiving college decides whether credit counts"
   related: [ ~"./learning-glossary.spw#learning_term_credit_hour" ]
   home: ~"./secondary/advanced-coursework.spw#secondary_schooling_dual"
  }
 }

 ^["powers"]{
  #>learning_term_shared_governance
  ^["shared_governance"]{
   means: "division of decisions among board, administration, and faculty, with faculty primary on curriculum and faculty status"
   home: ~"./institutions/governance-and-tenure.spw#institutions_governance_faculty_primary"
  }
  #>learning_term_tenure
  ^["tenure"]{
   means: "continuous appointment after a probationary period, ended only for cause or financial exigency under AAUP standards"
   broader: [ ~"./learning-glossary.spw#learning_term_shared_governance" ]
   home: ~"./institutions/governance-and-tenure.spw#institutions_governance_statement_1940"
  }
  #>learning_term_contingent
  ^["contingent_faculty"]{
   means: "faculty appointed off the tenure track, part-time or full-time, on fixed-term contracts"
   related: [ ~"./learning-glossary.spw#learning_term_tenure" ]
   home: ~"./institutions/governance-and-tenure.spw#institutions_governance_contingency"
  }
  #>learning_term_indirect_costs
  ^["indirect_costs"]{
   means: "facilities and administrative costs a grant pays at a negotiated rate on top of direct research costs"
   home: ~"./institutions/research-funding.spw#institutions_research_funding_fa"
  }
 }

 ^["supports"]{
  #>learning_term_fape
  ^["fape"]{
   #:claim #!settled
   statement: "A free appropriate public education is special education and related services at public expense, meeting state standards, under an IEP."
   source: ~"../registries/sources/learning-and-generations.spw#src_learn_idea_regs"
   narrower: [ ~"./learning-glossary.spw#learning_term_iep", ~"./learning-glossary.spw#learning_term_section_504" ]
  }
  #>learning_term_iep
  ^["iep"]{
   #:claim #!settled
   statement: "An IEP is the written program IDEA requires for each eligible child, stating present levels, measurable annual goals, and the services the school will provide."
   source: ~"../registries/sources/learning-and-generations.spw#src_learn_idea_regs"
   broader: [ ~"./learning-glossary.spw#learning_term_fape" ]
   home: ~"./secondary/student-support.spw#secondary_schooling_support_meeting"
  }
  #>learning_term_section_504
  ^["section_504"]{
   #:claim #!settled
   statement: "A 504 plan records the accommodations a school provides so a student with a disability has equal access under Section 504 of the Rehabilitation Act."
   source: ~"../registries/sources/learning-and-generations.spw#src_learn_section_504"
   broader: [ ~"./learning-glossary.spw#learning_term_fape" ]
   home: ~"./secondary/student-support.spw#secondary_schooling_support_504"
  }
  #>learning_term_lre
  ^["least_restrictive_environment"]{
   #:claim #!settled
   statement: "IDEA requires that children with disabilities learn alongside children without disabilities to the maximum extent appropriate."
   source: ~"../registries/sources/learning-and-generations.spw#src_learn_idea_regs"
   related: [ ~"./learning-glossary.spw#learning_term_iep" ]
  }
  #>learning_term_mtss
  ^["mtss"]{
   means: "multi-tiered systems of support: core instruction for all, targeted help for some, intensive help for a few"
   home: ~"./secondary/student-support.spw#secondary_schooling_support_rti"
  }
 }

 ^["methods"]{
  #>learning_term_scaffolding
  ^["scaffolding"]{
   means: "temporary support that lets a learner do what they could not yet do alone, withdrawn as skill grows"
   related: [ ~"./learning-glossary.spw#learning_term_zpd" ]
   home: ~"./institutions/pedagogical-scaffolding.spw#institutions_pedagogy_scaffolding"
  }
  #>learning_term_zpd
  ^["zone_of_proximal_development"]{
   means: "the span between what a learner does alone and what they do with guidance, after Vygotsky"
   home: ~"./institutions/pedagogical-scaffolding.spw#institutions_pedagogy_zpd"
  }
  #>learning_term_retrieval
  ^["retrieval_practice"]{
   means: "learning by pulling information out of memory, as in a practice test, rather than rereading it"
   home: ~"./institutions/pedagogical-scaffolding.spw#institutions_pedagogy_retrieval"
  }
  #>learning_term_learning_styles
  ^["learning_styles"]{
   means: "a claimed preference for visual, auditory, or other input; tailoring teaching to it lacks support"
   home: ~"./institutions/pedagogical-scaffolding.spw#institutions_pedagogy_learning_styles"
  }
  #>learning_term_phonics
  ^["phonics"]{
   means: "teaching the links between letters and the sounds they stand for, in a planned sequence when systematic"
   home: ~"./generations/curriculum-wars-matrix.spw#generations_wars_phonics"
  }
  #>learning_term_oral_history
  ^["oral_history"]{
   means: "recorded interviews about lived experience, gathered with consent and kept as sources"
   home: ~"./intergenerational-kit/interview-protocol.spw#generations_kit_oha"
  }
 }

 ^["time"]{
  #>learning_term_cohort
  ^["cohort"]{
   means: "people born in the same span; a cohort difference must be told apart from an age or period difference"
   home: ~"./generations/us-curricula-by-generation.spw#generations_curricula_caution"
  }
  #>learning_term_grammar
  ^["grammar_of_schooling"]{
   means: "the stable forms of school, such as graded classrooms and subjects by period, that reforms rarely change"
   home: ~"./generations/continuities-matrix.spw#generations_cont_grammar"
  }
 }
}

#>learning_glossary_credit_q
?["Is a credit hour a measure of learning or a currency of time?"]{
 #:depth #!educational ~#lens(market flow)
 #:claim #!speculative
 ~#hypothesis: "Credits behave more like a currency than a measure: they are earned by time, exchanged at transfer, and discounted by receiving colleges."
 breaks: "money keeps its value across stores, while each college sets its own exchange rate for credits"
 !probe{ "compare credit acceptance rules at five colleges for the same community college course" =id[p_learn_glossary_credit] =kind[lookup] }
 $%[learn.transfer.credit_loss_percent]
 ~"./learning-glossary.spw#learning_term_credit_hour" ~#neighbor(nearest)
}
