# Secondary Schooling
#
# US high school as courses, pathways, supports, and community ties, with the tension between acceleration and well-being kept open.

#>secondary_schooling_index
#:layer #!reference
#:domain #!secondary_schooling
#:form #!index
#:level #!intro
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Secondary Schooling"
 ~#claim: "High school runs on course sequences, outside standards that carry credit, legal supports for students with disabilities, and community supports, while the pace of acceleration stays contested."
 ~#proof: "Leaves cite IDEA regulations, McKinney-Vento, College Board and IB rules, and district studies; the acceleration tension cites Pope and Colangelo."
 ~#door: "Families start with advanced coursework and student support; teachers start with pathways."
 ~#audience: "students, families, teachers, and counselors"
 continuity: "Secondary Schooling | acceleration"
 cold_open: "High school is sequences, standards, supports, and community, with the pace of acceleration still argued in the open."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5"
 lineage: #[ ".spw/caches/secondary-education/taste.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "school corridors induce constant cortisol elevation: unsourced; removed",
  "biophilic redesign lowers adolescent cortisol by measurable margins: invented effect; removed",
  "mastery transcripts produce superior resilience and retention: invented outcome; recast as an open question",
  "the stance on rigor and well-being kept as one contested tension with sources on both sides"
 ]
}

^["tree"]{
 advanced: ~"./advanced-coursework.spw"
 pathways: ~"./secondary-pathways.spw"
 support: ~"./student-support.spw"
 wraparound: ~"./family-and-community-wraparound.spw"
}

^["bundle"]{
 ={ ~"./advanced-coursework.spw#secondary_schooling_advanced" }
 ={ ~"./secondary-pathways.spw#secondary_schooling_pathways" }
 ={ ~"./student-support.spw#secondary_schooling_support" }
 ={ ~"./family-and-community-wraparound.spw#secondary_schooling_wraparound" }
}

^["facets"]{
 order: "leaves by matter, then form"
 rows: #[
  .{ leaf: "advanced-coursework", matter: "dual enrollment, credit portability", form: "comparison" },
  .{ leaf: "secondary-pathways", matter: "prerequisite, acceleration", form: "curriculum" },
  .{ leaf: "student-support", matter: "IEP, Section 504", form: "protocol" },
  .{ leaf: "family-and-community-wraparound", matter: "wraparound, confidentiality", form: "protocol" }
 ]
}

^["tension"]{
 #>secondary_schooling_acceleration_tension
 ^["acceleration_and_wellbeing"]{
  #:claim #!contested
  statement: "Pope documents students in high-achieving schools working for grades at a cost to health and learning; Colangelo and colleagues argue acceleration serves ready students well."
  sources: [ ~"../../registries/sources/learning-and-generations.spw#src_learn_pope_2001", ~"../../registries/sources/learning-and-generations.spw#src_learn_colangelo_2004" ]
  disagreement: "the same policy can relieve a bored student and overload a stretched one, so the argument is about who decides and how"
 }
 stance: "rigor and well-being are both goods; this cut keeps the tension open instead of ruling for either side"
}
