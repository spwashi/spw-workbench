# Physical Glossary
#
# The short-entry tier for the physical class: state, phase transition, entropy, temperature, free energy, exergy, bond, stability margin, aberration, dispersion, gauge, and latent image, each with a home leaf.

#>physical_glossary
#:layer #!reference
#:domain #!physical
#:form #!glossary
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Physical Glossary"
 ~#claim: "Twelve terms carry most of the physical class; each has a sourced definition, a place among broader and narrower terms, and one home leaf where it does its work."
 ~#proof: "Definitions cite Callen, Schroeder, Kardar, Bejan, Pauling, Seborg, Smith, Hecht, Jackson and Okun, and James through the registry."
 ~#door: "Pick a word, read its line, and follow its home link when a leaf leans on it."
 ~#audience: "newcomers to physics, chemistry, optics, and engineering"
 continuity: "Physical Glossary | home leaf"
 cold_open: "Each word here gets one sourced line, a family of related words, and a home leaf where it does real work."
}

