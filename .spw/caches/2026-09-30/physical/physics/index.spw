# Physics
#
# The physics branch: a core sequence, canonical homes for classical thermodynamics, statistical mechanics, and electromagnetism, the nonequilibrium frontier, and graduate topics.

#>physics_index
#:layer #!reference
#:domain #!physics
#:form #!index
#:level #!foundation
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Physics"
 ~#claim: "Thermodynamics, statistical mechanics, and electromagnetism each have one canonical node here, and engineering, chemistry, materials, and ecology reach them by needs edges instead of restating them."
 ~#proof: "Each leaf links its keystone claims to the registry; cross-links from engineering, materials, and ecology point at these anchors."
 ~#door: "Start with the core sequence, then open whichever canonical node your own field leans on."
 ~#audience: "students and readers entering physics from any neighboring discipline"
 continuity: "Physics | one canonical node"
 cold_open: "Physics keeps one canonical node for heat, for counting states, and for fields, and every other branch borrows from them."
}

