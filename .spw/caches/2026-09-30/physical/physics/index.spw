^["stance"]{
 #>physics_stance_symmetry_mechanism
 ^["symmetry_and_mechanism"]{
  #:claim #!interpretive
  statement: "Physics looks for frictionless laws and their symmetries; engineering lives where friction, compliance, and fatigue decide what survives, and each needs the other's habits."
  ~#(the one stance kept from the raw physics and mechanical engineering taste file)
  context: ~"../../registries/sources/physical-sciences-and-image.spw#src_phys_bathias_1999"
  ~#(gigacycle tests find fatigue failures below the classic endurance limit)
 }
}

^["gaps"]{
 optics: "geometric optics lives in its own branch; physical optics, lasers, and photonics have no leaf yet"
 acoustics: "acoustics and loudness standards have no home; broadcast, streaming, and film school need one"
 astronomy: "astronomy and cosmology are missing, including the low-entropy past the thermodynamics wonder asks about"
 nuclear_and_particle: "nuclear and particle physics appear only as lab rungs and the QFT preparation row"
 fluids: "fluid mechanics lives under engineering transport; no physics-side continuum mechanics leaf exists"
}
