 needs: [ ~"./core-sequence.spw#physics_core", ~"./statistical-mechanics.spw#physics_statmech" ]
 extends: [ ~"./electromagnetism.spw#physics_em" ]
 grounds: [ ~"../../registries/quantities/physical-sciences-and-image.spw#q_phys_critical" ]
 see: [ ~"../physical-glossary.spw#physical_term_phase_transition" ]
}

