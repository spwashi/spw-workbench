# Graduate Physics Topics
#
# The graduate core from canonical mechanics to field-theory preparation, with critical phenomena and topological matter stated precisely enough to keep water and iron apart.

#>physics_graduate
#:layer #!reference
#:domain #!physics
#:form #!ledger
#:level #!graduate
#:review #!adversarial_checked
#:valence #!bone
#:era #!contemporary

^"emit"{
 ~#title: "Graduate Physics Topics"
 ~#claim: "Universality classes depend on dimension and order-parameter symmetry, so water's critical point and iron's Curie point fall in different classes."
 ~#proof: "Pelissetto and Vicari for critical exponents; TKNN, Haldane, and Kane and Mele for Chern and Z2 invariants; Goldstein, Jackson, and Sakurai for the core."
 ~#door: "Start with the universality claim, then read the Chern and Z2 pair before the quantum Hall rung."
 ~#audience: "first-year graduate students and advanced undergraduates preparing for qualifying exams"
 continuity: "Graduate Physics Topics | different classes"
 cold_open: "Boiling water and magnetizing iron both go critical, but they belong to different classes, and the symmetry of what orders tells you which."
}

