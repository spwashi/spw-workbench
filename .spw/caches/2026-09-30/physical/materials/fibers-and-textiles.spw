^["edges"]{
 needs: [ ~"./bonding-and-states-of-matter.spw#materials_bonding_hydrogen" ]
 feeds: [
  ~"../../record/inscription/paper-and-pulp-manufacture.spw#inscription_paper",
  ~"../../spw/design-research/feature-lineage.spw#lang_design_lineage"
 ]
 see: [ ~"./pigments-and-binders.spw#materials_pigments_mauve" ]
}

^["concepts"]{
 primary: [ #fiber, #cellulose, #punched_card ]
 transfers: [ #polymer, #hydrogen_bond ]
 tensions: [ #cotton_and_slavery ]
}

^["ladder"]{
 order: << "wild fiber" ; "domestication" ; "knotted records" ; "silk routes" ; "calico" ; "pattern cards" ; "mechanized spinning" ; "synthetics" >>
 ^["wild_fiber"]{
  #>materials_fibers_dzudzuana
  ^["dzudzuana_flax"]{
   #:era #!prehistory
   #:claim #!contested
   statement: "Kvavadze and coworkers reported dyed and twisted wild flax fibers about 30,000 years old from Dzudzuana Cave, Georgia; Bergfjord and coworkers argue the evidence cannot identify them as flax."
   reads: %[mateng.chron.dzudzuana_flax_ka]
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_kvavadze_2009"
   counter: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_bergfjord_2010"
   see: [ ~"../../registries/sources/materials-and-engineering.spw#src_mateng_kvavadze_2010" ]
  }
 }
 ^["domestication"]{
  #>materials_fibers_mehrgarh
  ^["mehrgarh_cotton"]{
   #:era #!ancient
   #:claim #!settled
   statement: "Mineralized cotton fibers preserved in a copper bead at Neolithic Mehrgarh, in present-day Pakistan, date to the sixth millennium BCE, the earliest known cotton."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_moulherat_2002"
  }
  #>materials_fibers_two_cottons
  ^["two_worlds"]{
   #:claim #!settled
   statement: "Cotton was domesticated separately in South Asia, Africa, and the Americas, so Andean and Mesoamerican weavers had their own cotton long before contact."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_riello_2013"
  }
  #>materials_fibers_sericulture
  ^["sericulture"]{
   #:claim #!settled
   statement: "Chinese sericulture reeled continuous filament from silkworm cocoons and developed reeling and twisting machines over millennia before silk making spread west."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_kuhn_1988"
  }
 }
 ^["knotted_records"]{
  #>materials_fibers_khipu
  ^["khipu"]{
   #:claim #!settled
   statement: "Inka khipu are cords of cotton or camelid fiber whose knots record numbers in a base-ten place system, as Locke showed in 1912."
   sources: [ ~"../../registries/sources/materials-and-engineering.spw#src_mateng_locke_1912", ~"../../registries/sources/materials-and-engineering.spw#src_mateng_locke_1923" ]
   ~#(the 1923 museum book gave the fuller account)
  }
  #>materials_fibers_khipu_signs
  ^["khipu_signs"]{
   #:claim #!contested
   statement: "Urton argues that khipu also encode non-numerical signs through fiber, spin, ply, and color choices; how far khipu recorded narrative remains debated."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_urton_2003"
  }
 }
 ^["silk_routes"]{
  #>materials_fibers_silk_smuggling
  ^["silkworm_eggs"]{
   #:claim #!settled
   statement: "Procopius records that monks brought silkworm eggs from Central Asia to the emperor Justinian around 552, starting Byzantine silk production."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_procopius_wars"
   ~#(a primary account; historians read its details with caution)
  }
 }
 ^["calico"]{
  #>materials_fibers_indian_calico
  ^["indian_cloth"]{
   #:era #!early_modern
   #:claim #!settled
   statement: "Before British mechanization, printed and painted Indian cottons led world textile trade; European makers learned dyeing and printing by imitating them."
   sources: [ ~"../../registries/sources/materials-and-engineering.spw#src_mateng_riello_2013", ~"../../registries/sources/materials-and-engineering.spw#src_mateng_parthasarathi_2011" ]
  }
 }
 ^["pattern_cards"]{
  #>materials_fibers_bouchon
  ^["bouchon_falcon"]{
   #:era #!early_modern
   #:claim #!settled
   statement: "Basile Bouchon in Lyon used a perforated paper band to select warp threads in 1725, and Jean-Baptiste Falcon replaced it with a chain of cards in 1728."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_essinger_2004"
  }
  #>materials_fibers_jacquard
  ^["jacquard"]{
   #:era #!industrial
   #:claim #!settled
   statement: "Joseph Marie Jacquard combined these card ideas with Vaucanson mechanism in a loom attachment from 1804 that let one weaver produce complex patterned silk."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_essinger_2004"
  }
  #>materials_fibers_lovelace
  ^["lovelace"]{
   #:claim #!settled
   statement: "Babbage planned punched cards to drive his Analytical Engine, and Lovelace wrote in 1843 that it weaves algebraical patterns just as the Jacquard loom weaves flowers and leaves."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_lovelace_1843"
  }
  #>materials_fibers_hollerith
  ^["hollerith"]{
   #:claim #!settled
   statement: "Herman Hollerith tabulated the 1890 United States census with punched cards read by electrical contacts; he said the idea came from conductors punching railway tickets."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_austrian_1982"
  }
 }
 ^["mechanized_spinning"]{
  #>materials_fibers_spinning_machines
  ^["spinning_machines"]{
   #:era #!industrial
   #:claim #!settled
   statement: "Hargreaves spinning jenny of the 1760s, Arkwright water frame patented in 1769, and Crompton mule of 1779 mechanized cotton spinning in Lancashire."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_allen_2009"
  }
  #>materials_fibers_why_britain
  ^["why_britain"]{
   #:claim #!contested
   statement: "Allen explains British mechanization by high wages and cheap coal; Parthasarathi argues that competition with Indian cotton cloth drove it."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_allen_2009"
   counter: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_parthasarathi_2011"
  }
  #>materials_fibers_cotton_gin
  ^["cotton_gin"]{
   #:claim #!settled
   statement: "After Eli Whitney gin of 1793 made short-staple cotton cheap to clean, enslaved labor on cotton plantations spread across the American South to feed British mills."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_beckert_2014"
  }
 }
 ^["synthetics"]{
  #>materials_fibers_nylon
  ^["nylon"]{
   #:era #!modern
   #:claim #!settled
   statement: "Wallace Carothers group at DuPont made nylon 6,6 from adipic acid and hexamethylenediamine in 1935; stockings reached stores in 1940 before the war took the fiber."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_hounshell_smith_1988"
  }
  #>materials_fibers_kevlar
  ^["aramid"]{
   #:claim #!settled
   statement: "Stephanie Kwolek found that rigid aromatic polyamides form liquid-crystal solutions that spin into very stiff fibers, patented in 1972 and sold as Kevlar."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_kwolek_1972"
  }
 }
}

^["fiber_matrix"]{
 #>materials_fibers_cellulose
 ^["cellulose"]{
  #:claim #!settled
  statement: "Cotton and flax are cellulose: long glucose chains packed into crystalline microfibrils by hydrogen bonds, and cotton is stronger wet than dry."
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_morton_hearle_2008"
 }
 #>materials_fibers_wool
 ^["wool"]{
  #:claim #!settled
  statement: "Wool is keratin crosslinked by disulfide bonds; overlapping surface scales make fibers slide more easily one way than the other, which drives felting."
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_morton_hearle_2008"
 }
 #>materials_fibers_silk
 ^["silk"]{
  #:claim #!settled
  statement: "Silk fibroin packs glycine-alanine repeats into stacked beta sheets, giving a fine, strong, lustrous continuous filament."
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_morton_hearle_2008"
 }
}

^["try"]{
 #>materials_fibers_try_wet_strength
 ^["wet_and_dry"]{
  materials: [ "plain cotton sewing thread", "a strip of printer paper", "a paper cup with a string handle", "coins", "a bowl of water" ]
  steps: << "hang the cup from a dry thread and add coins until it breaks" ; "repeat with a thread soaked for five minutes" ; "repeat with dry and wet paper strips" ; "compare which material gained and which lost strength when wet" >>
  time: .{ n: 30, unit: "minutes" }
  safety: "no hazard worth naming; keep falling coins off toes"
  shows: ~"./fibers-and-textiles.spw#materials_fibers_cellulose"
 }
}

#>materials_fibers_wet_paper_q
?["Why does wet cotton thread hold more while wet paper falls apart, when both are cellulose?"]{
 #:depth #!physical ~#lens(molecular binding)
 #:claim #!speculative
 ~#hypothesis: "Water loosens the amorphous zones of a long twisted cotton fiber so load spreads more evenly, while paper strength sits in short fiber-to-fiber hydrogen bonds that water breaks."
 !probe{ "measure dry and wet breaking load of single cotton fibers and paper strips across humidity" =id[p_mateng_fibers_wet_paper] =kind[build] }
 $%[file.frame_count]
 ~"./fibers-and-textiles.spw#materials_fibers_cellulose" ~#neighbor(nearest)
}

#>materials_fibers_card_program_q
?["Is a chain of Jacquard cards a program?"]{
 #:depth #!computational ~#lens(information flow)
 #:claim #!speculative
 ~#hypothesis: "A card chain is a stored sequence of instructions, so it is a program in the narrow sense; Babbage added the branching and memory that make a general one."
 breaks: "a loom card selects threads and cannot test a result or loop on a condition"
 !probe{ "rewrite one card chain as a list of instructions and mark which computing features it lacks" =id[p_mateng_fibers_card_program] =kind[thought] }
 $%[graph.out_degree]
 ~"./fibers-and-textiles.spw#materials_fibers_jacquard" ~#neighbor(nearest)
}
