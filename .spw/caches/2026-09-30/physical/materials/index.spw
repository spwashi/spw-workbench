# Materials
#
# The materials branch: a curriculum from bonds to graduate scaling laws, and four material histories that show who made each substance and how.

#>materials_index
#:layer #!reference
#:domain #!materials
#:form #!index
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Materials"
 ~#claim: "Properties come from structure and its defects, and the history of each material is also a history of who could make it."
 ~#proof: "Every leaf cites its sources; the defect stance rests on Brenner whiskers, Nassau on ruby, and Sze and Ng on doped silicon."
 ~#door: "Learners start at bonding; history readers start at fibers; builders start at the materials core."
 ~#audience: "students, makers, and historians choosing a way into materials"
 continuity: "Materials | defects"
 cold_open: "What a material does comes from its structure and its defects, and who could make it shaped history."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/materials-science/taste.spw" ]
 method: #revised
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r5"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker", care: #adversarial, outcome: #pass }
  ^["r6"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the taste file said Bravais lattices generate millions of minerals; mineralogists recognize several thousand species, and lattices do not generate them",
  "the taste file called pure silicon an insulator; it is an intrinsic semiconductor",
  "the taste file called dislocation-free whiskers brittle; they are strong, near the ideal estimate",
  "perfection is sterile is kept as an interpretive stance, not a fact",
  "the 15 percent steel and cement emissions figure was unsourced; the steel share now reads an IEA verify cell"
 ]
 gate_note: "r4 is the 2026-10-02 rerun after the apposition on the defect stance was shortened to clear a width warning"
}

^["edges"]{
 see: [ ~"../../provenance/errata-technical.spw#provenance_errata_technical" ]
}

^["tree"]{
 core: ~"./materials-core.spw"
 advanced: ~"./materials-advanced.spw"
 bonding: ~"./bonding-and-states-of-matter.spw"
 water: ~"./water.spw"
 steel: ~"./steel-and-iron.spw"
 pigments: ~"./pigments-and-binders.spw"
 fibers: ~"./fibers-and-textiles.spw"
}

^["bundle"]{
 ={ ~"./bonding-and-states-of-matter.spw#materials_bonding" }
 ={ ~"./materials-core.spw#materials_core" }
 ={ ~"./materials-advanced.spw#materials_advanced" }
 ={ ~"./water.spw#materials_water" }
 ={ ~"./steel-and-iron.spw#materials_steel" }
 ={ ~"./pigments-and-binders.spw#materials_pigments" }
 ={ ~"./fibers-and-textiles.spw#materials_fibers" }
}

^["ladder"]{
 rungs: << "intro" ; "foundation" ; "graduate" >>
 intro: [
  ~"./water.spw#materials_water",
  ~"./steel-and-iron.spw#materials_steel",
  ~"./pigments-and-binders.spw#materials_pigments",
  ~"./fibers-and-textiles.spw#materials_fibers"
 ]
 foundation: [ ~"./bonding-and-states-of-matter.spw#materials_bonding", ~"./materials-core.spw#materials_core" ]
 graduate: [ ~"./materials-advanced.spw#materials_advanced" ]
}

^["facets"]{
 domain: "materials throughout"
 forms: "curriculum for the prerequisite graph, glossary for bonds, comparison for the technique matrix, timeline for histories, field_guide for water"
 eras: "histories run from prehistory to current; curricula carry no era"
}

^["stance"]{
 #>materials_index_defect_stance
 ^["philosophy_of_defect"]{
  #:claim #!interpretive
  statement: "Useful properties live in departures from perfect order: dislocations let metals bend, dopants let silicon switch, and trace ions color gems."
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_hull_bacon_2011"
  ~#(the perfect crystal is the reference that makes each defect legible)
 }
 #>materials_index_ruby
 ^["ruby"]{
  #:claim #!settled
  statement: "Pure corundum is colorless; a little chromium replacing aluminum absorbs green and violet light, and the crystal glows red as ruby."
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_nassau_2001"
 }
 #>materials_index_silicon
 ^["silicon_semiconductor"]{
  #:claim #!settled
  statement: "Pure silicon is an intrinsic semiconductor, not an insulator; parts-per-million dopants set its carriers and make it a switch."
  reads: %[mateng.silicon.bandgap_ev]
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_sze_ng_2007"
  see: [ ~"./materials-core.spw#materials_core_silicon" ]
 }
 #>materials_index_mineral_count
 ^["mineral_count"]{
  #:claim #!settled
  statement: "The International Mineralogical Association recognizes several thousand mineral species, a number that grows each year as new species are approved."
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_ima_mineral_list"
  as_of: "2026-10-01 reading of the IMA list; check the live list for the current count"
 }
 #>materials_index_extraction
 ^["extraction_ethics"]{
  #:claim #!interpretive
  statement: "A material choice includes its mine, its energy, and its end of life; this branch keeps the emissions and labor history beside the property tables."
  see: [ ~"./steel-and-iron.spw#materials_steel_emissions", ~"./fibers-and-textiles.spw#materials_fibers_cotton_gin" ]
 }
}

^["gaps"]{
 ceramics: "ceramics, glass, and concrete histories have no leaf yet; expected neighbors are bonding and materials core"
 batteries: "electrochemical materials for batteries and electrolysis appear only in passing"
 wool_trade: "the medieval wool trade and its finance were in the raw history without sources and wait for a sourced leaf"
}

#>materials_index_self_heal_q
?["Could a structural alloy close its own fatigue cracks at room temperature?"]{
 #:depth #!physical ~#lens(material grain)
 #:claim #!speculative
 ~#hypothesis: "Crack flanks that touch under compressive loading might rebond if surfaces stay clean, so healing would favor vacuum or inert service over air."
 !probe{ "search for room-temperature crack-healing reports in metals and note the environment of each" =id[p_mateng_index_self_heal] =kind[lit] }
 $%[graph.out_degree]
 ~"./index.spw#materials_index_defect_stance" ~#neighbor(nearest)
}
