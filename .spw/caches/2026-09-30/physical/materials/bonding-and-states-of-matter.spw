# Bonding and States of Matter
#
# A glossary lattice of the bonds that hold matter together and the states and flows that bonding allows, from ionic salt to supercritical carbon dioxide.

#>materials_bonding
#:layer #!reference
#:domain #!materials
#:form #!glossary
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Bonding and States of Matter"
 ~#claim: "Five kinds of attraction, from ionic to dispersion, set whether matter is a salt, a metal, a glass, a liquid, or a colloid."
 ~#proof: "Bond definitions follow Pauling, Atkins, and the 2011 IUPAC hydrogen-bond definition; phase points come from the IAPWS and Span-Wagner equations of state."
 ~#door: "Read the bond terms, then the phase diagrams, then try the spoon test for paint and honey."
 ~#audience: "students and makers with high-school chemistry"
 continuity: "Bonding and States of Matter | phase diagram"
 cold_open: "How atoms hold hands decides what a substance is, and a phase diagram maps where it changes."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/materials-matter-and-history/phases-of-matter-and-chemical-bonding.spw" ]
 method: #revised
 ^["receipts"]{
