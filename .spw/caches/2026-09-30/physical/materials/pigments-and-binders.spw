# Pigments and Binders
#
# A timeline ladder of color from ochre to acrylic, with a matrix of how binders cure and why some pigments hide what lies beneath.

#>materials_pigments
#:layer #!reference
#:domain #!materials
#:form #!timeline
#:level #!intro
#:review #!adversarial_checked
#:valence #!boon

^"emit"{
 ~#title: "Pigments and Binders"
 ~#claim: "Paint is colored particles held in a binder, and every new binder or synthetic pigment changed where and how fast people could paint."
 ~#proof: "Dated sites from Henshilwood, Aubert, and Quiles; pigment chemistry from Berke, Plesters, and Kraft; binder chemistry from Mills and White and Keddie and Routh."
 ~#door: "Start with ochre at Blombos, then wet some chalk with oil to watch hiding power vanish."
 ~#audience: "painters, art students, and curious readers"
 continuity: "Pigments and Binders | colored particles"
 cold_open: "Paint is colored particles held in a binder, and each new binder changed where people could paint."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/materials-matter-and-history/paint-and-color-chemistry.spw", ".spw/caches/materials-matter-and-history/acrylic-and-synthetic-polymers.spw" ]
 method: #revised
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "Chauvet is dated in calibrated years before present, about 37 to 33.5 thousand; the raw wrote 36,000 BCE",
  "oil paint is touch-dry in days and cures over months to years; the raw taste file said minutes",
  "Liquitex came from Henry Levison of Permanent Pigments; Magna, from Bocour and Golden, was a solvent-borne acrylic resin paint, not an emulsion",
  "the Messerschmitt Bf 109 had a framed canopy; the claim that every major wartime aircraft carried a PMMA bubble is dropped",
  "latex paint dries to the touch quickly, but polymer interdiffusion continues long after; the 30-minute finished film is dropped",
  "Prussian blue is dated to about 1706 following Kraft; the raw gave 1704",
  "the Renoir tube quotation was unsourced and is paraphrased as an interpretive reading",
  "Egyptian blue, Han blue and purple, and Maya blue are added as non-European synthetic pigments",
  "the pentimento wonder said aged oil approaches the index of lead white; aged linseed oil rises only part way, so the hypothesis now adds transparent lead soaps, and it reads a lead white index instead of rutile"
 ]
}

^["edges"]{
 needs: [ ~"./bonding-and-states-of-matter.spw#materials_bonding_shear_thinning" ]
 grounds: [ ~"../../registries/quantities/materials-and-engineering.spw#q_mateng_pigment" ]
 feeds: [ ~"../../record/inscription/inks-and-inscription.spw#inscription_inks", ~"../../record/carriers/carrier-manufacturing.spw#media_carriers_manufacturing" ]
}

^["concepts"]{
 primary: [ #pigment, #binder, #refractive_index ]
 transfers: [ #polymer, #colloid ]
 tensions: [ #toxic_pigment ]
}

^["ladder"]{
 order: << "earth" ; "ancient synthetic" ; "mineral trade" ; "laboratory" ; "tube" ; "acrylic" >>
 ^["earth"]{
  #>materials_pigments_blombos
  ^["blombos"]{
   #:era #!prehistory
   #:claim #!settled
   statement: "About 100,000 years ago people at Blombos Cave, South Africa, ground ochre and mixed it with bone and charcoal in abalone shells, the oldest known paint kit."
   reads: %[mateng.chron.blombos_ochre_ka]
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_henshilwood_2011"
  }
  #>materials_pigments_sulawesi
  ^["sulawesi"]{
   #:claim #!settled
   statement: "A hand stencil in the Maros karsts of Sulawesi has a minimum uranium-series age of 39.9 thousand years, as old as the oldest European cave art."
   reads: %[mateng.chron.sulawesi_stencil_min_ka]
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_aubert_2014"
   as_of: "2014 report; later Sulawesi studies report older figurative art"
  }
  #>materials_pigments_chauvet
  ^["chauvet"]{
   #:claim #!settled
   statement: "The first human phase at Chauvet-Pont d Arc ran from about 37 to 33.5 thousand calibrated years before present, with charcoal and ochre on the walls."
   reads: %[mateng.chron.chauvet_early_start_ka, mateng.chron.chauvet_early_end_ka]
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_quiles_2016"
  }
 }
 ^["ancient_synthetic"]{
  #>materials_pigments_egyptian_blue
  ^["egyptian_blue"]{
   #:era #!ancient
   #:claim #!settled
   statement: "Egyptian blue, calcium copper silicate fired from sand, lime, copper, and flux in the third millennium BCE, is the oldest known synthetic pigment."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_berke_2007"
  }
  #>materials_pigments_han_maya
  ^["han_and_maya"]{
   #:claim #!settled
   statement: "Chinese artisans made the barium copper silicates Han blue and Han purple, and Mesoamerican painters bound indigo into palygorskite clay to make the durable Maya blue."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_berke_2007"
  }
 }
 ^["mineral_trade"]{
  #>materials_pigments_ultramarine
  ^["ultramarine"]{
   #:era #!medieval
   #:claim #!settled
   statement: "Natural ultramarine was extracted from lapis lazuli mined in Badakhshan; its blue comes from trisulfur radical anions held in the cages of the mineral lazurite."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_plesters_1993"
  }
  #>materials_pigments_toxic
  ^["toxic_classics"]{
   #:claim #!settled
   statement: "Several classic pigments are poisons: lead white is basic lead carbonate, vermilion is mercury sulfide, and orpiment is arsenic sulfide."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_mayer_1991"
  }
 }
 ^["laboratory"]{
  #>materials_pigments_prussian_blue
  ^["prussian_blue"]{
   #:era #!early_modern
   #:claim #!settled
   statement: "Prussian blue, an iron hexacyanoferrate, was made by chance in Berlin around 1706 by the color maker Diesbach and became the first modern synthetic pigment sold widely."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_kraft_2008"
  }
  #>materials_pigments_guimet
  ^["synthetic_ultramarine"]{
   #:era #!industrial
   #:claim #!settled
   statement: "In 1828 Jean-Baptiste Guimet in France, and Christian Gmelin in Germany, made synthetic ultramarine, cutting the price of a pigment once dearer than most others."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_plesters_1993"
  }
  #>materials_pigments_mauve
  ^["mauveine"]{
   #:claim #!settled
   statement: "William Henry Perkin made the dye mauveine from coal-tar aniline in 1856 and opened the synthetic dye industry."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_garfield_2000"
  }
 }
 ^["tube"]{
  #>materials_pigments_tube
  ^["collapsible_tube"]{
   #:claim #!settled
   statement: "The American painter John Goffe Rand patented a collapsible metal paint tube in 1841, replacing pig-bladder packets that leaked and dried."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_rand_1841"
  }
  #>materials_pigments_plein_air
  ^["plein_air"]{
   #:claim #!interpretive
   statement: "Callen reads ready-made tube colors and new synthetic pigments as part of what let Impressionist painters work outdoors in one session."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_callen_2000"
   ~#(the tube enabled outdoor work; it did not by itself cause Impressionism)
  }
 }
 ^["acrylic"]{
  #>materials_pigments_pmma
  ^["pmma"]{
   #:era #!modern
   #:claim #!settled
   statement: "PMMA is a clear amorphous plastic with a glass transition near 105 C and a refractive index near 1.49, which is why it replaced glass in canopies and lenses."
   reads: %[mateng.polymer.pmma_tg_c, mateng.polymer.pmma_n_d]
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_brandrup_1999"
  }
  #>materials_pigments_ridley
  ^["ridley_lens"]{
   #:claim #!settled
   statement: "Harold Ridley saw that Perspex splinters from aircraft canopies sat quietly in pilots eyes, and in 1949 implanted the first intraocular lens made of PMMA."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_apple_sims_1996"
  }
  #>materials_pigments_magna
  ^["magna"]{
   #:claim #!settled
   statement: "Magna, introduced by Leonard Bocour and Sam Golden in the late 1940s, was an acrylic resin dissolved in mineral spirits, a solvent-borne paint that mixed with turpentine."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_learner_2004"
  }
  #>materials_pigments_liquitex
  ^["liquitex"]{
   #:claim #!settled
   statement: "Henry Levison of Permanent Pigments in Cincinnati brought out Liquitex in the mid-1950s, among the first water-based acrylic emulsion paints made for artists."
   source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_crook_learner_2000"
  }
 }
}

^["binder_matrix"]{
 #>materials_pigments_drying_oil
 ^["drying_oil"]{
  #:claim #!settled
  statement: "Linseed oil does not dry by evaporation; oxygen attacks its unsaturated fatty acids and crosslinks them, so a film is touch-dry in days and keeps changing for years."
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_mills_white_1994"
 }
 #>materials_pigments_tempera_fresco
 ^["tempera_and_fresco"]{
  #:claim #!settled
  statement: "Egg tempera binds pigment in yolk that sets as water leaves; true fresco paints wet lime plaster, which takes up carbon dioxide and locks the pigment in calcium carbonate."
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_mayer_1991"
 }
 #>materials_pigments_latex
 ^["latex_film"]{
  #:claim #!settled
  statement: "A latex paint film forms in stages: water evaporates, polymer particles pack and deform, then chains diffuse across particle boundaries, a step that continues long after the surface feels dry."
  source: ~"../../registries/sources/materials-and-engineering.spw#src_mateng_keddie_routh_2010"
  ^["limits"]{
   holds: "above the minimum film-forming temperature of the latex"
   fails: "below it the particles stay separate and the film cracks or powders"
  }
 }
 #>materials_pigments_hiding
 ^["hiding_power"]{
  #:claim #!settled
  statement: "A white pigment hides by scattering, which grows with the index gap to its binder: rutile near 2.7 in oil near 1.48 hides strongly, while chalk in oil turns nearly clear."
  reads: %[mateng.pigment.n_rutile, mateng.pigment.n_linseed_oil]
  sources: [ ~"../../registries/sources/materials-and-engineering.spw#src_mateng_nassau_2001", ~"../../registries/sources/materials-and-engineering.spw#src_mateng_mayer_1991" ]
 }
}

^["try"]{
 #>materials_pigments_try_chalk_oil
 ^["chalk_in_oil"]{
  materials: [ "white chalk or a crushed antacid tablet", "dark paper", "cooking oil", "a dropper or spoon" ]
  steps: << "rub a patch of chalk onto the dark paper and see it white" ; "drip oil onto half of the patch" ; "watch the oiled half go gray and see-through" ; "say why the dry half still scatters light" >>
  time: .{ n: 10, unit: "minutes" }
  safety: "no hazard worth naming beyond oily paper; keep historical pigments such as lead white out of this test"
  shows: ~"./pigments-and-binders.spw#materials_pigments_hiding"
 }
 #>materials_pigments_try_tempera
 ^["egg_tempera"]{
  materials: [ "one egg yolk", "a teaspoon of water", "earth pigment, cocoa, or turmeric", "a brush", "heavy paper" ]
  steps: << "pierce the yolk sac and keep only the yolk" ; "mix a little yolk and water with the pigment" ; "paint thin strokes" ; "wait ten minutes and rub one stroke" ; "compare it with pigment mixed in water alone" >>
  time: .{ n: 30, unit: "minutes" }
  safety: "raw egg can carry salmonella, so wash hands and surfaces after; use food or earth colors only"
  shows: ~"./pigments-and-binders.spw#materials_pigments_tempera_fresco"
 }
}

#>materials_pigments_pentimento_q
?["Why do old oil paintings sometimes reveal the changes a painter covered up?"]{
 #:depth #!physical ~#lens(material grain)
 #:claim #!speculative
 ~#hypothesis: "Aging raises the oil index part way toward lead white and turns some lead white into transparent lead soaps; both cut scattering, so covered layers show through."
 !probe{ "compare reflectance of fresh and aged lead white and oil drawdowns over a black and white chart" =id[p_mateng_pigments_pentimento] =kind[lit] }
 $%[mateng.pigment.n_linseed_oil, mateng.pigment.n_hydrocerussite_omega]
 ~"./pigments-and-binders.spw#materials_pigments_hiding" ~#neighbor(nearest)
}

#>materials_pigments_lapis_route_q
?["Did the long road from Badakhshan shape what European painters chose to make blue?"]{
 #:depth #!historical ~#lens(market flow)
 #:claim #!speculative
 ~#hypothesis: "Because natural ultramarine was scarce and dear, patrons and painters reserved it for the most honored figures, and cheap synthetic ultramarine after 1828 loosened that rule."
 breaks: "price is one constraint among many; symbolism, guild rules, and the patron contract also chose the color"
 !probe{ "survey painting contracts that name ultramarine and compare with the figures that wear it" =id[p_mateng_pigments_lapis_route] =kind[lit] }
 $%[graph.in_degree]
 ~"./pigments-and-binders.spw#materials_pigments_ultramarine" ~#neighbor(nearest)
}
