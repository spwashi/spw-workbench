# Mechanical Core
#
# The undergraduate mechanical sequence as a prerequisite graph, from statics and solids through dynamics and vibration to power cycles, exergy, machine design, and a capstone.

#>engineering_mechanical
#:layer #!reference
#:domain #!engineering
#:form #!curriculum
#:level #!foundation
#:review #!sourced
#:valence #!bone

^"emit"{
 ~#title: "Mechanical Core"
 ~#claim: "Mechanical design follows every load path into the ground, keeps forcing away from resonance, and counts exergy, the work a system could still deliver, as a cost."
 ~#proof: "Shigley for failure, fatigue, and fasteners; Rao for vibration; Carnot, Gouy, and Bejan for cycles and exergy; Junker for loosening; ASME Y14.5 for tolerances."
 ~#door: "Start at statics, then twang a ruler off a table edge to hear a natural frequency move."
 ~#audience: "first- and second-year mechanical engineering students and makers who build machines"
 continuity: "Mechanical Core | load path"
 cold_open: "A mechanical engineer follows every load path into the ground and treats lost work as a cost, not a rounding error."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/physics-and-mechanical-engineering/undergrad-mechanical-engineering.spw", ".spw/caches/university-education/thermodynamics/classical-and-engineering-thermodynamics.spw" ]
 method: #revised
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the topology-optimization wonder claimed 30 percent lighter brackets without a source; the question survives without a magnitude",
  "thermo-fluids appeared in three raw files; this node keeps power cycles and exergy and points to the canonical thermodynamics and transport nodes",
  "the classical thermodynamics raw is split: laws and the state postulate go to the physics node, while cycles and exergy stay here",
  "the bolt wonder said an unpreloaded bolt snaps almost immediately; the mechanism is restated without a time",
