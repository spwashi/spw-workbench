# Control and Signals
#
# The canonical node for linear systems, sampling, feedback, PID, and state space, shared by electrical, mechanical, and chemical engineering, with a state machine for a working loop.

#>engineering_control_signals
#:layer #!reference
#:domain #!engineering
#:form #!protocol
#:level #!advanced
#:review #!adversarial_checked
#:valence #!honk

^"emit"{
 ~#title: "Control and Signals"
 ~#claim: "Feedback lets an imperfect machine track a goal, and stability margins are heuristics about how far the model can be wrong, not guarantees."
 ~#proof: "Black, Nyquist, and Bode built the frequency-domain theory; Minorsky and Ziegler and Nichols gave PID; Kalman gave state estimation; Astrom and Murray state the margins as robustness measures."
 ~#door: "Read the survey, follow the loop machine from manual to auto, then balance a broom."
 ~#audience: "engineering students who meet control in any department"
 continuity: "Control and Signals | heuristics"
 cold_open: "Feedback lets a sloppy machine hit its target, and its safety margins are heuristics, so read them as warnings."
}

