# Industrial and Systems Engineering
#
# Operations research, queueing, quality, lean production, supply chains, human factors, and simulation, laid out as a queueing matrix and a finite-buffer state machine.

#>engineering_ise
#:layer #!reference
#:domain #!engineering
#:form #!comparison
#:level #!advanced
#:review #!sourced
#:valence #!bone

^"emit"{
 ~#title: "Industrial and Systems Engineering"
 ~#claim: "Flow through a system is set by utilization and variability: queues explode as servers near full load, and variability, not effort, is what spare capacity must absorb."
 ~#proof: "Kendall, Little, Jackson, and Kingman give the queueing results; Hopp and Spearman turn them into factory physics; Shewhart, Ohno, and Lee and coworkers cover quality, lean, and the bullwhip."
 ~#door: "Read across the queueing matrix, then time a real counter line and check Little's law."
 ~#audience: "industrial engineering students, operations managers, and anyone who designs a line people wait in"
 continuity: "Industrial and Systems Engineering | variability"
 cold_open: "Queues explode as servers fill up, and variability, not effort, is what spare capacity is really for."
}

