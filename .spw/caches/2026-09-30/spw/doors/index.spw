# Fragment Doors
#
# A router for writers and tools, not an arrival page: each door is one mark or one region, legible alone, and each reader cluster is pointed at exactly one door.

#>spw_doors
#:layer #!pragmatics
#:domain #!spw
#:form #!index
#:level #!intro
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Fragment Doors"
 ~#claim: "A newcomer lands on one fragment door, one mark or one region legible alone; this index routes writers and tools to the thirteen doors."
 ~#proof: "The owner note asks for one fragment door and refuses a command tour and a gradient of every operator on arrival; each door holds one keystone with a source."
 ~#door: "Find your cluster in the habits frame and open only that door."
 ~#audience: "writers, reviewers, and tools that route readers into the spw class"
 continuity: "Fragment Doors | one fragment door"
 cold_open: "Each reader lands on one fragment door, one mark or one region, and the rest stays quiet."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "owner hold in .spw/caches/resume/2026-09-30-direction.spw lines 30, 66, 73, and 74",
  "contract.spw arcs frame, arrival rule",
  "persona study doors, reframed: the seven-step cluster paths and the first-hour path are tours and are not written"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 study agents", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the persona study proposed a seven-step path per cluster and a shared first hour; the owner refuses a command tour as onboarding, so each cluster gets exactly one fragment door and no schedule appears here"
 ]
}

^["standing"]{
 #>spw_doors_arrival
 ^["arrival"]{
  #:claim #!settled
  statement: "The owner note says a newcomer may land on one fragment, that a practiced circuit is earned by holding attention, and refuses a command tour and a live gradient of every operator on arrival."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_owner_resume"
  cites: [ ".spw/caches/resume/2026-09-30-direction.spw:30", ".spw/caches/resume/2026-09-30-direction.spw:66", ".spw/caches/resume/2026-09-30-direction.spw:73-74" ]
  label: "owner hold, not repository canon"
 }
 router: "no door links this index and no root door targets it; read as a whole it would be the gradient the owner refuses"
 order: "the tree lists marks first, then regions; the order is for finding, and no reading order is implied"
}

^["tree"]{
 hash: ~"./hash.spw"
 particle: ~"./particle.spw"
 equals: ~"./equals.spw"
 tilde: ~"./tilde.spw"
 percent: ~"./percent.spw"
 at: ~"./at.spw"
 colon: ~"./colon.spw"
 caret: ~"./caret.spw"
 angle: ~"./angle.spw"
 claim: ~"./claim.spw"
 cell: ~"./cell.spw"
 wonder: ~"./wonder.spw"
 edge: ~"./edge.spw"
}

^["habits"]{
 c_programmers: ~"./hash.spw#spw_door_hash"
 physics: ~"./caret.spw#spw_door_caret"
 designers: ~"./equals.spw#spw_door_equals"
 mathematicians: ~"./tilde.spw#spw_door_tilde"
 engineers_chemists: ~"./percent.spw#spw_door_percent"
 life_clinical: ~"./angle.spw#spw_door_angle"
 linguists: ~"./particle.spw#spw_door_particle"
 social_scientists: ~"./edge.spw#spw_door_edge"
 librarians: ~"./claim.spw#spw_door_claim"
 production_crews: ~"./colon.spw#spw_door_colon"
 creators: ~"./at.spw#spw_door_at"
 educators_community: ~"./wonder.spw#spw_door_wonder"
 rule: "each cluster maps to exactly one door, chosen by its top-ranked false friend or the concept it already trusts; the cell door is reached from the tree"
 basis: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_study_persona"
}

^["bundle"]{
 ={
  ~"./hash.spw#spw_door_hash"
