  ~"./at.spw#spw_door_at"
  ~"./colon.spw#spw_door_colon"
  ~"./caret.spw#spw_door_caret"
  ~"./angle.spw#spw_door_angle"
  ~"./claim.spw#spw_door_claim"
  ~"./cell.spw#spw_door_cell"
  ~"./wonder.spw#spw_door_wonder"
  ~"./edge.spw#spw_door_edge"
 }
