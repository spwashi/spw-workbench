^["edges"]{
 feeds: [ ~"../glossary/false-friends.spw#spw_false_friends" ]
}

^["mark"]{
 #>spw_door_at_reference
 ^["perspective"]{
  #:claim #!settled
  statement: "An at sign followed by a name parses as a reference node, and the runtime observes a value through an observer of that name; no message goes anywhere."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_seed_grammar"
  cites: [ "packages/spw-seed/src/grammar/references.ts:188-262", "packages/spw-runtime/src/interpreter/interpreter.ts:216-223", "docs/theory/spw/operators.spw:36" ]
  ~#spoken(at)
  ^["limits"]{
   holds: "an at sign touching a name, a dotted path, or a number"
   fails: "inside a string the at sign is text, which is where a role or an email-like string belongs"
  }
 }
 #>spw_door_at_chat
 ^["chat_line"]{
  #:claim #!settled
  statement: "A chat line written @viewer_a: is this live? becomes a binding keyed by a reference that keeps only the word is; this, live, and a bare question mark are left loose."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_seed_grammar"
  probe_run: "parsed at 1aa1dc23 with the synthetic handle viewer_a; level: lx @ 70 likewise gives a reference named 70"
 }
 #>spw_door_at_people
 ^["roles_not_names"]{
  #:claim #!settled
  statement: "This cut names public figures and published authors only and writes everyone else as a role inside a string, so a private handle never becomes a graph node."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_cut_contract"
  label: "a-cut rule from the contract ethics frame, not repository canon"
 }
}

^["habits"]{
 keep: "an at sign that marks whose view this is, as a perspective or a root"
 quote: [
  "everything a person typed, with synthetic handles such as viewer_a in place of real ones",
  "clock times and levels, such as a level written as 0.7 instead of at 70",
  "citation keys and email addresses"
 ]
 unlearn: "an at sign here mentions no one and pings no one; it adds a name to the tree"
}

^["keyboard"]{
 #>spw_door_at_keys
 ^["two_places"]{
  #:claim #!settled
  statement: "The at sign needs Shift on both Windows layouts: with the 2 key on the US layout and with the apostrophe key on the UK layout."
  reads: %[doors.key.at_us_mods, doors.key.at_uk_mods]
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_kbd_uk"
 }
}

#>spw_door_at_q
?["What does a chat line that opens with a handle become?"]{
 #:depth #!ethical ~#lens(social fabric)
 #:claim #!speculative
 ~#hypothesis: "A streaming habit predicts a message addressed to someone; the reveal that the handle became a graph node is what makes pseudonyms feel necessary."
 !probe{ "guess first, then run spw inspect source --text on a chat line with the synthetic handle viewer_a and --through structure" =id[p_doors_at_chat_line] =kind[thought] }
 breaks: "a platform mention notifies a person, while a Spw reference only names a node, which is why the privacy rule lives in the contract and not in the syntax"
 ~"./at.spw#spw_door_at_chat" ~#neighbor(nearest)
}
