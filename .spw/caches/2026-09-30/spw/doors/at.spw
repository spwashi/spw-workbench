# Door: At
#
# One mark, legible alone: the at sign names a perspective or a root, notifies no one, and puts a name into the graph, so people appear as roles inside strings.

#>spw_door_at
#:layer #!pragmatics
#:domain #!spw
#:form #!field_guide
#:level #!intro
#:review #!adversarial_checked
#:valence #!honk

^"emit"{
 ~#title: "Door: At"
 ~#claim: "An at sign names a perspective or a root and puts that name into the graph; write people as roles inside strings."
 ~#proof: "The grammar builds a reference node from an at sign and a name, and the runtime only observes a value through a named observer."
 ~#door: "Guess what a chat line that starts with a handle becomes, then check it with spw inspect source."
 ~#audience: "creators and educators who type an at sign to mention someone"
 continuity: "Door: At | roles inside strings"
 cold_open: "An at sign names a perspective and reaches no one, so write people as roles inside strings."
}

