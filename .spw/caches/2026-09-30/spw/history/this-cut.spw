# This Cut
#
# The 2026-09-30 generation, the review that scored it, the decisions that shaped this cut, and the cut counting its own inspection receipts by care rung.

#>workbench_history_this_cut
#:layer #!reference
#:domain #!workbench_history
#:form #!dossier
#:level #!intro
#:review #!sourced
#:valence #!bone
#:era #!current

^"emit"{
 ~#title: "This Cut"
 ~#claim: "This cut turned one day of generated text into sourced, addressable surfaces, and it counts its own receipts by care rung like any other record."
 ~#proof: "The raw manifest and review scorecard in provenance, the cut plan stream, the contract, and a grep census of receipts at the commit that shelved waves 1 through 3."
 ~#door: "Read the generation, then the decisions, then count the receipts yourself and compare."
 ~#audience: "newcomers to the cut and anyone deciding how far to trust a surface in it"
 continuity: "This Cut | its own receipts"
 cold_open: "This cut keeps its own receipts, so you can see how much care each page got before you trust it."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected
   note: "census recounted from the tree of 651b535b with git archive; wave rungs extended from the plan stream"
  }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
  }
  ^["r7"]{
   event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected
   note: "the contrasts edge now points at the published rewrite of 2026-03-26"
  }
  ^["r8"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r9"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "the review verdict was overstated against its sources; census and care counts confirmed at 651b535b"
  }
  ^["r10"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the census first counted a working tree at 02:45 on 2026-10-03 while writers were still saving; it now counts the committed tree of 651b535b, so anyone can repeat it",
  "the review claim said both rounds judged the taste and wonder layers mostly wrong; the sources say errors were concentrated there, which is not the same"
 ]
 reflexive: "the census below counts the receipts of every surface in the cut, this one included"
}

^["edges"]{
 needs: [ ~"../../provenance/manifest.spw#provenance_manifest" ]
 grounds: [ ~"../../registries/quantities/spw-hosts-and-history.spw#q_hosts_cut", ~"../../contract.spw#cut_contract" ]
 see: [ ~"../../provenance/review-scorecard.spw#provenance_scorecard", ~"../inspection-and-ir.spw#spw_inspection_and_ir", ~"../../provenance/harm-register.spw#provenance_harm_register" ]
 contrasts: [ ~"./episode-timeline.spw#workbench_history_episodes_published_rewrite" ]
}

^["concepts"]{
 primary: [ #dated_receipt, #fixity, #provenance ]
 transfers: [ #care_ladder ]
 tensions: [ #generative_ai ]
}

^["generation"]{
 #>workbench_history_this_cut_generated
 ^["one_generator"]{
  #:claim #!settled
  statement: "One generator, gemini-3.8-flash-high, wrote the raw shelf on 2026-09-30; the manifest pins its 208 paths by checksum at commit 229aedcf, and the shelf stays in place."
  reads: %[prov.raw.file_count, prov.raw.line_count]
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_contract"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_stream" ]
  home: ~"../../provenance/manifest.spw#provenance_manifest"
 }
 #>workbench_history_this_cut_quarantine
 ^["quarantine"]{
  #:claim #!settled
  statement: "Nine raw health and remediation files are quarantined: kept for provenance, never cited, with successors written from real sources."
  reads: %[prov.raw.quarantine_file_count]
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_caches_index"
  cites: ".spw/caches/index.spw:106-118"
  provenance_label: "a-canon"
 }
}

^["review"]{
 #>workbench_history_this_cut_review
 ^["two_rounds"]{
  #:claim #!settled
  statement: "Round one scored 152 raw files on five axes and found 11 that declared any source; both rounds found core lists mostly right, with errors concentrated in the taste and wonder layers."
  core_accuracy: "the shelf disclosure puts core lists at about 85 to 90 percent accurate; that range is the reviewers estimate, not a recount"
  reads: %[prov.review.r1_file_count, prov.review.r1_sourced_file_count]
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_review_scorecard"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_caches_index" ]
  cites: [ ".spw/caches/index.spw:102", ".agents/plans/caches-cut-2026-09-30/references/review/scorecard.md:67,193" ]
  home: ~"../../provenance/review-scorecard.spw#provenance_scorecard"
 }
 #>workbench_history_this_cut_invented
 ^["invented_numbers"]{
  #:claim #!settled
  statement: "The reviewers counted about 49 invented effect sizes styled as findings in round-one wonder hypotheses, which is why every hypothesis here states a direction, not a magnitude."
  reads: %[prov.review.r1_invented_effect_count]
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_review_scorecard"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_contract" ]
  ^["limits"]{
   holds: "as the reviewers own estimate"
   fails: "as a recount; the scorecard says about"
  }
 }
}

^["decisions"]{
 #>workbench_history_this_cut_compartment
 ^["dated_compartment"]{
  #:claim #!settled
  statement: "On 2026-09-30 the owner chose a dated compartment beside the raw shelf and asked for native links, bound metric handles, a visible lens, and deeper nesting."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_stream"
  cites: "plan stream entries of 2026-09-30 at 14:10 and 17:30"
  provenance_label: "owner decision recorded in the plan stream"
 }
 ^["rules"]{
  closed_sets: .{ rule: "every axis, relation, lens, and status comes from one vocabulary file", label: "a-cut" }
  registries: .{ rule: "quantities and sources live once in registries and are cited many times", label: "a-cut" }
  receipts: .{ rule: "each inspection leaves a receipt with event, care, and outcome", label: "a-cut" }
  permanence: .{ rule: "an anchor or handle is never renamed or reused once the cut opens", label: "a-cut" }
  gate: .{ rule: "a script fails a sourced surface whose claims lack sources, and any provenance without as_of", label: "a-cut" }
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_contract"
 }
 #>workbench_history_this_cut_plans
 ^["plan_revisions"]{
  #:claim #!settled
  statement: "The plan was revised twice in two days: version two on 2026-10-01 applied a critic pass, and version three on 2026-10-02 split the spw branch into six writer packages."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_stream"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_plan" ]
  cites: "plan stream entries of 2026-10-01 at 11:10 and 2026-10-02 at 18:45"
 }
}

^["waves"]{
 #>workbench_history_this_cut_opened
 ^["opened_2026_10_01"]{ at: "2026-10-01", event: "the cut opens from staging with its contract, vocabulary, water exemplar, and first registries", source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_stream" }
 #>workbench_history_this_cut_paused
 ^["paused_2026_10_01"]{ at: "2026-10-01", event: "usage limits pause the first two writer waves mid-run; resumed writers are told to complete files, not rewrite them", source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_stream" }
 #>workbench_history_this_cut_wave_one
 ^["wave_one_2026_10_02"]{ at: "2026-10-02", event: "wave one completes four packages and 82 files", source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_stream" }
 #>workbench_history_this_cut_wave_two
 ^["wave_two_2026_10_02"]{ at: "2026-10-02", event: "wave two lands nine packages and 195 files, and a harm sweep covers the whole cut", source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_stream" }
 #>workbench_history_this_cut_wave_three
 ^["wave_three_2026_10_02"]{ at: "2026-10-02", event: "wave three starts six spw packages under plan version three, this history among them", source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_stream" }
 #>workbench_history_this_cut_patches_land
 ^["patches_land_2026_10_03"]{ at: "2026-10-03", event: "the lens and corpus graph patches, hardened beside the cut plan, land on main as 6690d686 and c79a096a", source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_git_log_w3" }
 #>workbench_history_this_cut_shelved
 ^["shelved_2026_10_03"]{ at: "2026-10-03", event: "commit 651b535b shelves waves 1 through 3 with 394 surfaces, 262 of them fact-checked, and wave 4 not yet run", source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_resume_note_w3" }
 #>workbench_history_this_cut_limit
 ^["limit_2026_10_03"]{ at: "2026-10-03", event: "a weekly usage limit stops the wave 3 writers, and the same morning they resume to complete files on disk", source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_stream" }
 cites: ".agents/plans/caches-cut-2026-09-30/wip.spw:80-84"
}

^["corrections"]{
 #>workbench_history_this_cut_pathology
 ^["parse_pathology"]{
  #:claim #!refuted
  statement: "Two cut files were reported to take 45 to 60 minutes to parse because of a pathological input shape in the parser."
  correction: "the times matched two machine-sleep intervals that a wall-clock timer counted, and a snapshot of the slow file parsed in under a second"
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_stream"
  cites: "plan stream entries of 2026-10-02 at 19:42 and 2026-10-03 at 10:20"
  lesson: "time a parse with CPU time or a monotonic clock, and record wall time beside it"
 }
}

^["receipts_by_care"]{
 #>workbench_history_this_cut_care
 ^["census"]{
  #:claim #!settled
  statement: "At commit 651b535b the cut holds 394 surfaces whose receipts name care glance 154 times, skim 666, read 223, audit 447, and adversarial 287."
  reads: %[
   hosts.cut.census_file_count,
   hosts.cut.care_glance_count,
   hosts.cut.care_skim_count,
   hosts.cut.care_read_count,
   hosts.cut.care_audit_count,
   hosts.cut.care_adversarial_count
  ]
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_census"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_git_log_w3" ]
  method: "extract the cut with git archive at 651b535b, then count each care key followed by its rung across every .spw file"
  ladder: ~"../inspection-and-ir.spw#spw_inspection_and_ir"
  ^["limits"]{
   holds: "as a snapshot of attention the writers and gate recorded"
   fails: "as a measure of quality: a receipt records care claimed, and counted output never stands in for understanding"
  }
 }
 #>workbench_history_this_cut_shape
 ^["why_skim_leads"]{
  #:claim #!interpretive
  statement: "Skim leads because every gate run leaves a skim receipt, and glance stays low because only surfaces drawn from the raw shelf carry a generated receipt at glance."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_contract"
  provenance_label: "a-cut reading of the receipt convention"
 }
 #>workbench_history_this_cut_fact_checked
 ^["fact_checked_share"]{
  #:claim #!settled
  statement: "At the same commit 262 of the 394 surfaces carry a fact_checked receipt, and the resume note asks readers to treat the rest as unreviewed."
  reads: %[hosts.cut.fact_checked_file_count, hosts.cut.census_file_count]
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_cut_census"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_resume_note_w3" ]
  cites: ".spw/caches/resume/2026-09-30-direction.spw:58"
 }
 open_count: "wave 3 resumed after this commit, so a recount when it closes should supersede these cells, keeping their handles"
}

^["try"]{
 #>workbench_history_this_cut_try_receipts
 ^["recount_the_care"]{
  materials: [ "a checkout of the workbench", "a terminal" ]
  steps: << "open any surface in the cut and read its receipts frame" ; "name the highest care that reports a passing outcome" ; "compare it with the review axis in the header" ; "grep the cut for care lines at the adversarial rung and count them" ; "compare your count and date with the census cells" >>
  time: .{ n: 15, unit: "minutes" }
  safety: "none worth naming; reading and grep change nothing"
  shows: ~"./this-cut.spw#workbench_history_this_cut_care"
 }
}

#>workbench_history_this_cut_q
?["Do visible receipts change where the next reader spends care?"]{
 #:depth #!educational ~#lens(applied attention)
 #:claim #!speculative
 ~#hypothesis: "Reviewers shown a surface receipts should recheck frames an adversarial pass already covered less often, and spend more care on frames no receipt reached."
 !probe{ "ask consenting reviewers to mark which frames they recheck on two surfaces, one with its receipts shown and one with them hidden" =id[p_hosts_history_receipt_shift] =kind[interview] }
 $%[hosts.cut.care_adversarial_count, hosts.cut.care_glance_count]
 ~"./this-cut.spw#workbench_history_this_cut_care" ~#neighbor(nearest)
}
