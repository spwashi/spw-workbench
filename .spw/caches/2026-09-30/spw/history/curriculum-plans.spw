# Curriculum Plans
#
# Three learning ladders this repository wrote for itself, HTML and CSS, SVG, and logic with the terminal, read as authored curricula that no lab has tested yet.

#>workbench_history_curriculum_plans
#:layer #!reference
#:domain #!workbench_history
#:form #!dossier
#:level #!foundation
#:review #!adversarial_checked
#:valence #!boon
#:era #!current

^"emit"{
 ~#title: "Curriculum Plans"
 ~#claim: "Three curricula, for HTML and CSS, for SVG, and for logic with the terminal, were authored ahead as full ladders in February 2026, and none has scaffolded its first lab."
 ~#proof: "The three plan cards, their PLAN.md commit ladders, their SOURCE.txt import notes, and a directory check at commit 1aa1dc23."
 ~#door: "Read the ladder shape, try Lab 1.01 by hand, then compare with the weekly spec rows in the computing branch."
 ~#audience: "learners who want a web or terminal ladder and readers studying how a syllabus is planned"
 continuity: "Curriculum Plans | authored ahead"
 cold_open: "Three learning ladders were authored ahead of any lab, so for now the plan is the whole curriculum."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
   note: "planned step counts, expansion times, SOURCE.txt, card next steps, and the external curriculum sources confirmed"
  }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 web_checks: "the two HOPL papers were matched against Crossref, SVG 1.1, SVG 2, and ECMA-48 against their publisher pages, and the GQL date against its public record on 2026-10-03"
 corrections: #[
  "the credits said the ladders build on W3C SVG 1.1; the SVG plan names SVG 2, a Candidate Recommendation, and SVG 1.1 is the stable Recommendation this cut adds",
  "the credits presented ECMA-48 and the WHATWG Living Standard as the ladders own sources; the plans say ANSI escape codes and HTML5, and those two citations are this cut mapping",
  "the lab kit sent learners to the accessibility tree to find implied html, head, and body; those appear in the DOM tree of the Elements panel, and the accessibility tree stays the same"
 ]
}

^["edges"]{
 grounds: [ ~"../../registries/quantities/spw-hosts-and-history.spw#q_hosts_plans" ]
 analog: [ ~"../../formal/computing/web-and-browser-internals.spw#computing_web" ]
 contrasts: [ ~"../../making/broadcast/serial-2014-case.spw#broadcast_serial_case" ]
 see: [ ~"./plan-ecology.spw#workbench_history_plans", ~"../theory/valence-and-charge.spw#spw_theory_valence" ]
}

^["concepts"]{
 primary: [ #prerequisite, #plan_card, #lane_glyph ]
 transfers: [ #active_learning ]
 tensions: [ #status_drift ]
}

^["case"]{
 question: "What does a curriculum look like when it is written whole before its first lesson?"
 setting: "three dormant cards in the curriculum lane of .agents/plans, each with a PLAN.md ladder, a reference index or none, and an import note"

 #>workbench_history_curriculum_plans_ladders
 ^["three_ladders"]{
  #:claim #!settled
  statement: "Each plan runs five phases with one step per planned commit: fifty for HTML and CSS, fifty for SVG, and twenty-six for logic with the terminal."
  reads: %[
   hosts.plans.curriculum_css_step_count,
   hosts.plans.curriculum_svg_step_count,
   hosts.plans.curriculum_logic_step_count
  ]
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_plan_cards_curriculum"
  cites: [ ".agents/plans/curriculum-html-css-mastery/PLAN.md:16-140", ".agents/plans/curriculum-html-svg-mastery/PLAN.md:16-31", ".agents/plans/curriculum-logic-terminal-mastery/PLAN.md:16-31" ]
 }
 #>workbench_history_curriculum_plans_origin
 ^["origin"]{
  #:claim #!settled
  statement: "All three were drafted on 2026-02-20 and imported on 2026-02-26 from an earlier repository, and each keeps a SOURCE.txt naming the branch and commit it came from."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_plan_cards_curriculum"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_git_log" ]
  cites: [ ".agents/plans/curriculum-html-css-mastery/SOURCE.txt:1", "commit a69e6d5f on 2026-02-26" ]
 }
 #>workbench_history_curriculum_plans_growth
 ^["grew_on_day_one"]{
  #:claim #!settled
  statement: "On the morning they were drafted, the SVG ladder grew to fifty commits to match HTML and CSS, and the logic ladder doubled from a thirteen-step draft to twenty-six."
  reads: %[hosts.plans.curriculum_svg_step_count, hosts.plans.curriculum_logic_step_count]
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_plan_cards_curriculum"
  cites: [ ".agents/plans/curriculum-html-svg-mastery/wip.spw:81-83", ".agents/plans/curriculum-logic-terminal-mastery/wip.spw:60-62" ]
 }
 #>workbench_history_curriculum_plans_unscaffolded
 ^["none_scaffolded"]{
  #:claim #!settled
  statement: "At 1aa1dc23 no lab directory exists for any ladder, and each card names scaffolding its first lab as the next step after a reheat."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_plan_cards_curriculum"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_plan_index" ]
  cites: [ ".agents/plans/curriculum-html-css-mastery/wip.spw:14", ".agents/plans/curriculum-html-svg-mastery/wip.spw:14", ".agents/plans/curriculum-logic-terminal-mastery/wip.spw:14" ]
  evidence: "the labs, labs-svg, and spw-logic-terminal-lab directories named in the cards were absent on 2026-10-03"
 }
 #>workbench_history_curriculum_plans_lane
 ^["lane"]{
  #:claim #!settled
  statement: "The curriculum lane holds six cards: these three dormant ladders and three stranded audit cards for CSS tokens, data attributes, and UI data models."
  reads: %[hosts.plans.lane_curriculum_count]
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_plan_index"
  cites: ".agents/plans/index.spw:165-168,185-188"
 }
}

^["ladder_shape"]{
 #>workbench_history_curriculum_plans_pairing
 ^["standard_then_spw"]{
  #:claim #!settled
  statement: "Each HTML and CSS lab pairs a web standard with a Spw idea, such as the accessibility tree with Spw ontologies and :has() with introspection, then asks for a reflection and a reusable heuristic."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_plan_cards_curriculum"
  cites: [ ".agents/plans/curriculum-html-css-mastery/PLAN.md:13", ".agents/plans/curriculum-html-css-mastery/PLAN.md:18-41" ]
 }
 ^["phases"]{
  html_css: << "semantics and the accessibility tree" ; "layout topology" ; "CSS calculus and color" ; "selectors as queries" ; "scroll and view transitions" >>
  svg: << "coordinate systems" ; "path calculus" ; "filter primitives" ; "declarative animation" ; "foreignObject and HTML interop" >>
  logic_terminal: << "terminal and TTY mechanics" ; "logic programming in Prolog" ; "functional purity in Haskell" ; "graph queries in GQL" ; "a Spw CLI synthesis" >>
  cites: [ "curriculum-html-svg-mastery/PLAN.md:18-30", "curriculum-logic-terminal-mastery/PLAN.md:18-30" ]
 }
 #>workbench_history_curriculum_plans_valence_mood
 ^["valence_as_mood"]{
  #:claim #!interpretive
  statement: "The CSS calculus lab reads the valence pentad as moods a UI shifts through, while the valence canon and this cut read the pentad as material quality, not mood."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_plan_cards_curriculum"
  counter: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_valence_canon"
  cites: [ ".agents/plans/curriculum-html-css-mastery/PLAN.md:28-31", "docs/theory/spw/valence-architecture.spw:38-39" ]
  provenance_label: "a-cut reading; the plan text is a February draft"
 }
}

^["precedents"]{
 #>workbench_history_curriculum_plans_credits
 ^["named_origins"]{
  #:claim #!settled
  statement: "The ladders name public standards and languages: HTML5, SVG 2 with Filter Effects and SMIL, ANSI escape codes, Prolog, Haskell, and GQL; each row below credits a citable origin."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_plan_cards_curriculum"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_svg2_cr_2018", ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_iso_gql_2024" ]
  cites: [ ".agents/plans/curriculum-html-css-mastery/PLAN.md:19", ".agents/plans/curriculum-html-svg-mastery/PLAN.md:13,76", ".agents/plans/curriculum-logic-terminal-mastery/PLAN.md:5,13,19" ]
  cut_mapping: "this cut cites HTML5 as the WHATWG HTML Living Standard and ANSI escape codes as ECMA-48, fifth edition; the plans name neither document"
  graphql_note: "the logic plan goal line says GraphQL and Cypher, while its phase and scope name GQL and ISO property graphs; GraphQL is a separate query language, so the cut follows the phase"
  provenance_label: "plan text for the named items; a-cut mapping for the HTML and terminal citations"
 }
 ^["rows"]{
  prolog: .{ credit: "Alain Colmerauer and Philippe Roussel in Marseille, 1972, by their own account", source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_colmerauer_roussel_1996" }
  haskell: .{ credit: "an open committee from 1987, as told by Hudak, Hughes, Peyton Jones, and Wadler", source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_hudak_2007" }
  gql: .{ credit: "ISO/IEC 39075, published in April 2024", source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_iso_gql_2024" }
  svg: .{ credit: "W3C, SVG 2, a Candidate Recommendation of 4 October 2018, named by the plan", source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_svg2_cr_2018" }
  svg_stable: .{ credit: "W3C, SVG 1.1 Second Edition, the Recommendation of 16 August 2011, which this cut adds as the stable reference", source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_svg11_2011" }
  terminal: .{ credit: "Ecma International, ECMA-48 fifth edition of 1991, this cut mapping of the plan phrase ANSI escape codes", source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_ecma48_1991" }
  html: .{ credit: "the WHATWG HTML Living Standard, this cut mapping of the plan word HTML5", source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_whatwg_html" }
 }
}

^["lessons"]{
 #>workbench_history_curriculum_plans_syllabus
 ^["syllabus_before_lessons"]{
  #:claim #!interpretive
  statement: "A ladder written whole works as a syllabus: anyone can read and argue with it before a lab exists, but it cannot yet show which step a learner finds hard."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_plan_cards_curriculum"
  provenance_label: "a-cut reading"
 }
 pairing: "Serial released its first season one episode a week, so listeners waited between chapters; these ladders were authored ahead and wait for their first learner"
}

^["try"]{
 #>workbench_history_curriculum_plans_try_lab
 ^["lab_one_by_hand"]{
  materials: [ "a plain text editor", "a web browser with developer tools" ]
  steps: << "write a file holding html and body elements around one paragraph" ; "open it in the browser and inspect the DOM tree in the Elements panel of developer tools" ; "delete the html and body tags and reload" ; "compare the two DOM trees and name the elements the parser added back" ; "optionally open the accessibility tree and note that it is unchanged" ; "write one sentence on how a Spw frame differs from an implied element" >>
  time: .{ n: 20, unit: "minutes" }
  safety: "none worth naming; the file stays on your own machine"
  shows: ~"./curriculum-plans.spw#workbench_history_curriculum_plans_pairing"
 }
}

#>workbench_history_curriculum_plans_q
?["Will the first scaffolded lab reorder the ladder written before it?"]{
 #:depth #!educational ~#lens(craft practice)
 #:claim #!speculative
 ~#hypothesis: "Scaffolding the first three labs should move or merge some later steps, because a built lab exposes prerequisites that a planned list only guesses."
 breaks: "a broadcast season meets its audience every week, while these ladders have no learner yet; the analogy covers sequencing, not feedback"
 !probe{ "when Lab 1.01 is scaffolded, diff the commit ladder in PLAN.md before the first lab and after the third, and count moved or merged steps" =id[p_hosts_history_ladder_reorder] =kind[build] }
 $%[hosts.plans.curriculum_css_step_count, hosts.plans.lane_curriculum_count]
 ~"./curriculum-plans.spw#workbench_history_curriculum_plans_ladders" ~#neighbor(nearest)
}
