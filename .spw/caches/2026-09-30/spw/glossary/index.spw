# Spw Glossary
#
# A micropaedia for the Spw class: operators, particles, false friends, and borrowed terms, with a short entry for each word a newcomer meets first.

#>spw_glossary
#:layer #!semantics
#:domain #!spw
#:form #!index
#:level #!foundation
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Spw Glossary"
 ~#claim: "Four glossaries name every Spw mark, every particle aim, ten false friends from other fields, and twenty-five borrowed words, each with a source and a break line."
 ~#proof: "Every row in the four children cites canon or code at commit 1aa1dc23, and every false friend was probed through the parser."
 ~#door: "Start with false friends if you are pasting notes in, or with operators if you are reading Spw aloud."
 ~#audience: "newcomers and practitioners looking up a Spw word"
 continuity: "Spw Glossary | false friends"
 cold_open: "Look up any mark or word here, and start with the false friends if you paste notes in."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 anchor_note: "spw_glossary is the anchor the v2 plan gave a single glossary surface; root trails cite it, so it now names this router"
}

^["edges"]{
 see: [ ~"../specimens/index.spw#spw_specimens" ]
}

^["tree"]{
 operators: ~"./operators.spw"
 particles: ~"./particles.spw"
 false_friends: ~"./false-friends.spw"
 terms: ~"./terms.spw"
}

^["bundle"]{
 ={
  ~"./false-friends.spw#spw_false_friends"
  ~"./operators.spw#spw_gloss_operators"
  ~"./particles.spw#spw_gloss_particles"
  ~"./terms.spw#spw_gloss_terms"
 }
}

^["order"]{
 pasting: << "false friends" ; "operators" ; "particles" ; "terms" >>
 reading_aloud: << "operators" ; "particles" ; "terms" ; "false friends" >>
}

^["micropaedia"]{
 #>spw_glossary_particle
 ^["particle"]{
  gloss: "the mark as written: a hash, an aim, and a name"
  row: ~"./particles.spw#spw_gloss_particle_word_bookmark"
 }
 #>spw_glossary_anchor
 ^["anchor"]{
  gloss: "the bookmark a deixis particle leaves on the node after it"
  row: ~"./terms.spw#spw_term_anchor"
 }
 #>spw_glossary_aims
 ^["aims"]{
  gloss: "deixis, case, mood, aspect, and apposition, the five grammatical names canon gives the marks"
  row: ~"./particles.spw#spw_gloss_particle_aliases"
 }
 #>spw_glossary_frame
 ^["frame"]{
  gloss: "a caret before a bracketed name with a body: a named region"
  row: ~"./terms.spw#spw_term_frame"
 }
 #>spw_glossary_facet
 ^["facet"]{
  gloss: "a dot before a brace: a block of named bindings"
  row: ~"./operators.spw#spw_gloss_op_dot"
 }
 #>spw_glossary_set
 ^["set"]{
  gloss: "a hash before a square bracket: a closed list of values"
  row: ~"./operators.spw#spw_gloss_op_hash"
 }
 #>spw_glossary_bias_edge
 ^["bias_edge"]{
  gloss: "an equals sign with an axis and a body of ranked targets"
  row: ~"./terms.spw#spw_term_bias"
 }
 #>spw_glossary_register
 ^["register"]{
  gloss: "a runtime slot that operators read and write"
  row: ~"./terms.spw#spw_term_register"
 }
 #>spw_glossary_valence
 ^["valence"]{
  gloss: "five words for material quality: boon, bane, bone, bonk, and honk"
  row: ~"./terms.spw#spw_term_valence"
 }
}

^["gaps"]{
 formal_semantics: "no row gives formal semantics for an operator; the operator rows quote canon runtime behavior and stop there"
 spoken_names: "spoken names for marks live in the voice surface; rows here carry them as readings beside each mark"
}
