# Borrowed Terms
#
# Words Spw borrows from physics, mathematics, grammar, craft, and its own tools: each row gives the field senses, the Spw sense, and the place where the borrowing breaks.

#>spw_gloss_terms
#:layer #!semantics
#:domain #!spw
#:form #!glossary
#:level #!foundation
#:review #!sourced
#:valence #!bone

^"emit"{
 ~#title: "Borrowed Terms"
 ~#claim: "Spw borrows twenty-five words from other fields and from its own tools; each keeps a field sense, gains a Spw sense, and breaks somewhere a reader should know."
 ~#proof: "Field senses cite a textbook or standard of that field; Spw senses cite canon or code at commit 1aa1dc23; tool homonyms cite the command registry."
 ~#door: "Find a word your field already owns, read its break line, then read the four tool homonyms at the end."
 ~#audience: "readers who meet a familiar word in Spw and want to know what it means here"
 continuity: "Borrowed Terms | break line"
 cold_open: "Every word here has a home field and a Spw sense, and the break line says where they part."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  ".agents/plans/caches-cut-2026-09-30/references/studies/persona-synthesis.json tree_amendments and metaphor_limits",
  ".agents/plans/caches-cut-2026-09-30/references/studies/render-synthesis.md section 4.3, homonyms",
  "canon, CLI, emit, and readBias re-read and probed at commit 1aa1dc23 on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "a raw language-features cache of 2026-09-30 read valence as emotional charge and the equals sign as a constraint; canon reads valence as material quality and the equals sign as configuration and bias",
  "the persona study said the spaced bias form yields no edge; readBias reads = [depth]{ deep } and =[depth]{ deep } as the same edge",
  "the persona amendment listed fingerprint, action, integration, ground, scene, and production; the plan list of twenty-five governs, and operator names live in the operator glossary"
 ]
 home: "this file owns the homonyms; care rungs and receipts live in inspection and IR, and spoken names in voice"
}

^["edges"]{
 extends: [ ~"./particles.spw#spw_gloss_particles", ~"./operators.spw#spw_gloss_operators" ]
 see: [ ~"../inspection-and-ir.spw#spw_inspection_and_ir", ~"../theory/valence-and-charge.spw#spw_theory_valence" ]
}

^["matter_and_math"]{
 #>spw_term_valence
 ^["valence"]{
  #:claim #!settled
  statement: "Spw valence names material quality in five words, boon, bane, bone, bonk, and honk; canon calls them charge-neutral and names pass or fail readings a hygiene failure."
  senses: "chemistry: the combining capacity of an atom; linguistics: the number of arguments a verb takes; psychology: the pleasant or unpleasant tone of an affect"
  breaks: "no count, sign, or argument rides on a Spw valence, so bane is a useful constraint and never an error or an inhibition"
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_valence", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_iupac_gold_book", ~"../../registries/sources/language-and-communities.spw#src_lang_tesniere_1959", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_russell_1980" ]
  cites: [ "docs/theory/spw/valence-architecture.spw:38-39,115", "docs/theory/spw/dimensional-axes.spw:121" ]
 }
 #>spw_term_potential
 ^["potential"]{
  #:claim #!settled
  statement: "Potential is the canon reader name of the tilde, which the runtime turns into a deferred wrapper around its first argument."
  senses: "physics: a scalar field whose gradient gives a force"
  breaks: "no field, gradient, or force exists, and nothing sums amplitudes"
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators", ~"../../registries/sources/physical-sciences-and-image.spw#src_phys_griffiths_em_2017" ]
  cites: [ "docs/theory/spw/operators.spw:29,57" ]
 }
 #>spw_term_resonance
 ^["resonance"]{
  #:claim #!settled
  statement: "Code tables call the hash resonance while canon calls it vibration; the runtime resonates a register, and canon files the sigil metaphor as interpretive."
  senses: "physics: a driven oscillator answering most strongly near its natural frequency; chemistry: one molecule drawn as several bonding structures; sociology: a responsive relation to the world"
  breaks: "no frequency, damping, or amplitude exists in a Spw resonance"
  sources: [ ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_naming_tables", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_french_1971", ~"../../registries/sources/physical-sciences-and-image.spw#src_phys_pauling_1960", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_rosa_2019" ]
  cites: [ "packages/spw-runtime/src/state/type-affinities.ts:26", "docs/theory/spw/field-dynamics.spw:23" ]
 }
 #>spw_term_field
 ^["field"]{
  #:claim #!settled
  statement: "A Spw field is a scalar per site on a graph, advanced by beats of decay, diffuse, and inject; canon also names an operational field of clocks that never share names."
  senses: "physics: a quantity defined at every point of space; sociology: an arena of positions and struggles; records: one named slot, such as a MARC field"
  breaks: "sites hold unitless amplitude, and each beat is a discrete step with no units"
  sources: [ ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_canon_theory", ~"../../registries/sources/physical-sciences-and-image.spw#src_phys_griffiths_em_2017", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_bourdieu_1993", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_marc21_bib" ]
  cites: [ "docs/theory/spw/field-dynamics.spw:20-23,39", "docs/theory/spw/operational-field.spw:46-50" ]
 }
 #>spw_term_coupling
 ^["coupling"]{
  #:claim #!settled
  statement: "Canon reads the angle pair as coupling; the runtime makes a two-way register edge only when the first two operands are string keys."
  senses: "physics: a term linking two oscillators; software design: how much one module depends on another; bibliometrics: two papers citing a common reference"
  breaks: "a Spw coupling carries no strength or energy, and it is declared, where Kessler computed his couplings from shared references"
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_french_1971", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_stevens_myers_constantine_1974", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_kessler_1963" ]
  cites: [ "docs/theory/spw/operators.spw:41,59" ]
 }
 #>spw_term_lattice
 ^["lattice"]{
  #:claim #!settled
  statement: "Spw says lattice for the five particle aims and for operator tables, and neither has a meet, a join, or a partial order."
  senses: "order theory: a partially ordered set in which every pair has a meet and a join; solid state: a periodic array of points"
  breaks: "the particle lattice is a list of grammatical categories, and no tool orders or combines its members"
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_apposition", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_davey_priestley_2002", ~"../../registries/sources/physical-sciences-and-image.spw#src_phys_kittel_2005" ]
  cites: [ "docs/theory/spw/apposition.spw:33" ]
 }
 #>spw_term_measure
 ^["measure"]{
  #:claim #!settled
  statement: "The percent sign is measure: the runtime maps a register into zero to one, registry cells written with it hold unbounded quantities, and spw measure compares declared and observed mass."
  senses: "measure theory: a countably additive set function; measurement theory: scales from nominal to ratio"
  breaks: "nothing is countably additive, and a scalar in zero to one asserts an equal spacing that an ordinal rubric lacks"
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_cli_readers", ~"../../registries/sources/formal.spw#src_formal_folland_1999", ~"../../registries/sources/spw-design-studies.spw#src_lab_stevens_1946" ]
  cites: [ "docs/theory/spw/operators.spw:39,51", ".spw/registries/register-bank.spw:31", "packages/spw-cli/src/commands.ts:232-235" ]
 }
 #>spw_term_dimension
 ^["dimension"]{
  #:claim #!settled
  statement: "Canon defines an abstract axis as a named one-dimensional quantity with a domain, a unit or ratio, a subjective hook, and an operational binding, composed by named formulas."
  senses: "physics: the exponents of base quantities in a quantity; linear algebra: the size of a basis"
  breaks: "an axis is a named reading of a surface rather than a base quantity, so dimensional analysis and the Pi theorem say nothing about it"
  sources: [ ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_canon_theory", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_bridgman_1922" ]
  cites: [ "docs/theory/spw/dimensional-axes.spw:30" ]
 }
}

^["language"]{
 #>spw_term_register
 ^["register"]{
  #:claim #!settled
  statement: "A Spw register is a runtime slot that operators read and write, described in the register bank; canon keeps geometric words for registers as analogy until each meets a falsifier."
  senses: "linguistics: a variety of language fitted to a situation of use; computing: a small fast storage cell in a processor"
  breaks: "a Spw register has no situation of use and no fixed width"
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_register_bank", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_canon_theory", ~"../../registries/sources/language-and-communities.spw#src_lang_biber_conrad_2009", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_horowitz_hill_2015" ]
  cites: [ ".spw/registries/register-bank.spw:11-24", "docs/theory/spw/register-geometry.spw:26" ]
 }
 #>spw_term_case
 ^["case"]{
  #:claim #!settled
  statement: "The case particle classifies the role of the node it binds; the name comes from grammar, and the LSP calls the same aim lens."
  senses: "grammar: marking that shows the role of a noun; Fillmore: a deep role such as agent; programming: one arm of a switch"
  breaks: "no head governs a Spw case, and it chooses no branch"
  sources: [ ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_blake_2001", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_fillmore_1968", ~"../../registries/sources/spw-design-studies.spw#src_lab_kr_1988" ]
  glossary: ~"./particles.spw#spw_gloss_particle_case"
 }
 #>spw_term_mood
 ^["mood"]{
  #:claim #!settled
  statement: "The mood particle gives the value or force of what it binds, such as a settled claim or a semantics layer; the LSP calls the aim intent."
  senses: "grammar: the marking of a clause as statement, question, command, or wish"
  breaks: "Spw mood values mix epistemic status with kind and genre, and none describes a feeling"
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_palmer_2001"
  glossary: ~"./particles.spw#spw_gloss_particle_mood"
 }
 #>spw_term_aspect
 ^["aspect"]{
  #:claim #!settled
  statement: "Spw aspect is a tilde-hash datum, which the seed counts as volatility: deferred state whose content may expire."
  senses: "grammar: the internal time of an event, such as perfective or progressive"
  breaks: "nothing marks completion or duration; expiring content sits closer to a stage-level predicate"
  sources: [ ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_comrie_1976", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_carlson_1977" ]
  cites: [ "packages/spw-seed/src/canonical/particles.ts:107-117" ]
  glossary: ~"./particles.spw#spw_gloss_particle_aspect"
 }
 #>spw_term_apposition
 ^["apposition"]{
  #:claim #!settled
  statement: "A Spw apposition sets a reading beside its host in parens, anonymous for a one-off reading and named once the reading recurs."
  senses: "grammar: a noun phrase set beside another with the same referent"
  breaks: "most Spw readings are supplements with no shared referent, and no tool checks the host"
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_apposition", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_quirk_1985", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_huddleston_pullum_2002" ]
  cites: [ "docs/theory/spw/apposition.spw:21-34,92" ]
 }
 #>spw_term_anchor
 ^["anchor"]{
  #:claim #!settled
  statement: "A Spw anchor is the bookmark a deixis particle leaves on the next node, and a path ref naming the file and the anchor reaches that node."
  senses: "web: a fragment target inside a document; supplement grammar: the host a supplement relates to; judgment: a first number that pulls later estimates"
  breaks: "a Spw anchor marks a node rather than an offset, and its name is chosen by the author rather than fixed by syntax"
  sources: [ ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_seed_canonical", ~"../../registries/sources/spw-design-studies.spw#src_lab_rfc3986", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_huddleston_pullum_2002", ~"../../registries/sources/language-and-communities.spw#src_lang_tversky_kahneman_1974" ]
  glossary: ~"./particles.spw#spw_gloss_particle_word_bookmark"
 }
 #>spw_term_dialect
 ^["dialect"]{
  #:claim #!settled
  statement: "A Spw dialect is a lexing and role profile, such as block, line, or flow, chosen by a header marker or a path default, with exactly one active per file."
  senses: "linguistics: a regional or social variety of a language with its own vocabulary, grammar, and pronunciation"
  breaks: "a Spw dialect has no speakers and no continuum, and switching mid-file is forbidden"
  sources: [ ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_canon_theory", ~"../../registries/sources/spw-branch.spw#src_spw_seed_dialect", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_chambers_trudgill_1998" ]
  cites: [ ".spw/registries/dialect-spec.spw:13-21,31,35" ]
 }
}

^["craft"]{
 #>spw_term_frame
 ^["frame"]{
  #:claim #!settled
  statement: "A Spw frame is a caret before a bracketed name with a body, naming a region; a bracketed list right after a name also parses as a Frame node."
  senses: "artificial intelligence: a structure of slots with defaults; sociology: a scheme for what is going on; linguistics: the scene a word evokes; film: one image"
  breaks: "a Spw frame has no default slots, geometry, or duration; it names and nests, and typed edges carry meaning between frames"
  sources: [ ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_parser_probes", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_minsky_1974", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_goffman_1974", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_fillmore_1982" ]
  cites: [ "docs/theory/spw/operators.spw:37,56" ]
 }
 #>spw_term_beat
 ^["beat"]{
  #:claim #!settled
  statement: "spw beat advances runtime cadence without writing the source tree, and the canon field beat is a discrete clock of decay, diffuse, and inject."
  senses: "screenwriting: the smallest exchange of action and reaction in a scene"
  breaks: "a Spw beat carries no story and no meter; canon asks for beats shown without story nouns"
  sources: [ ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_cli_readers", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_canon_theory", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_mckee_1997" ]
  cites: [ "packages/spw-cli/src/commands.ts:420-422", "docs/theory/spw/field-dynamics.spw:39,53" ]
 }
 #>spw_term_stream
 ^["stream"]{
  #:claim #!settled
  statement: "A Spw stream is a schedule written between double angle brackets with semicolons; the parser keeps its order as a Stream node, and no clock runs it."
  senses: "computing: a sequence produced on demand, as with delayed lists; media: a live broadcast"
  breaks: "nothing is delayed, produced on demand, or broadcast; the schedule records order alone"
  sources: [ ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_parser_probes", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_abelson_sussman_1996" ]
 }
 #>spw_term_hold
 ^["hold"]{
  #:claim #!settled
  statement: "In emit, a hold measures whether a pack keeps its anchors, as continuity, style, subject, and genre holds, and canon multiplies hold factors into a Hold product."
  senses: "stage management: a call that stops the action at once, recorded by the persona study as a crew habit"
  breaks: "an emit hold stops nothing, so a crew call and the emit measure share only the word"
  sources: [ ~"../../registries/sources/spw-branch.spw#src_spw_cli_emit", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_canon_theory", ~"../../registries/sources/spw-branch.spw#src_spw_study_persona" ]
  cites: [ "packages/spw-cli/src/emit/codecs.ts:44-53", "packages/spw-cli/src/emit/axes.ts:360", "docs/theory/spw/math-modeling.spw:43" ]
 }
 #>spw_term_continuity
 ^["continuity"]{
  #:claim #!settled
  statement: "An emit card names continuity phrases after a bar; emit checks the pack text carries each anchor, and the cut gate checks the spoken cold open carries each phrase."
  senses: "film: matching details across takes so a cut reads as one action; mathematics: a function with no jumps"
  breaks: "Spw continuity is a phrase check on text, and it matches no props, eyelines, or limits"
  sources: [ ~"../../registries/sources/spw-branch.spw#src_spw_cli_emit", ~"../../registries/sources/spw-branch.spw#src_spw_cut_gate", ~"../../registries/sources/film-stage-visual.spw#src_film_murch_2001", ~"../../registries/sources/formal.spw#src_formal_rudin_1976" ]
  cites: [ "packages/spw-cli/src/emit/continuity.ts:90-136", "scripts/analyzers/spw-cut-voice.ts:68-71" ]
 }
 #>spw_term_bias
 ^["bias"]{
  #:claim #!settled
  statement: "A Spw bias edge is an equals operation with an axis and a body of ranked targets; readBias reports anchor, axis, targets, and sign, and reads spaced and tight forms alike."
  senses: "statistics: the gap between an estimator and the truth on average; psychology: a systematic tilt in judgment; electronics: the steady operating point of a device"
  breaks: "a bias edge has rank and sign, with no magnitude, standard error, or operating point"
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_bias_product", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_parser_probes", ~"../../registries/sources/formal.spw#src_formal_casella_berger_2002", ~"../../registries/sources/language-and-communities.spw#src_lang_tversky_kahneman_1974" ]
  cites: [ "packages/spw-seed/src/canonical/read-bias.ts:102-117", ".spw/registries/bias-product.spw:10,17,19" ]
 }
}

^["tool_homonyms"]{
 #>spw_term_lens
 ^["lens"]{
  #:claim #!settled
  statement: "Lens has four senses in this repository: the LSP name for the case aim, the lens reading in a wonder, the retired comment form the gate bans, and the lenses list emit reads."
  reads: %[gloss.terms.lens_senses_n]
  senses: "optics: a refracting element with a focal length"
  breaks: "no Spw lens focuses anything; the reading is a phrase from a closed vocabulary"
  since: "commit 6690d686 of 2026-10-03 lets the LSP index lens readings and show them on wonder hovers, preferring the reading, then a datum, then the comment form"
  sources: [ ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_lsp_display", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_diagnostics", ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_cli_readers", ~"../../registries/sources/physical-sciences-and-image.spw#src_phys_hecht_2017" ]
  cites: [ "packages/spw-lsp/src/handlers/display.ts:39", "scripts/analyzers/spw-cut-gate.ts:48", "packages/spw-cli/src/emit/extract.ts:26,68" ]
 }
 #>spw_term_cut
 ^["cut"]{
  #:claim #!settled
  statement: "Cut has three senses here: this dated reference cut, the pulse flag that cuts and banks a stencil, and delta, which compares two cuts."
  reads: %[gloss.terms.cut_senses_n]
  senses: "film: the join between two shots, or an edited version such as a locked cut"
  breaks: "a dated cut promises nothing to downstream departments, and a pulse stencil keeps form without content"
  sources: [ ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_cli_readers", ~"../../registries/sources/film-stage-visual.spw#src_film_murch_2001" ]
  cites: [ "packages/spw-cli/src/pulse.ts:295,562", "packages/spw-cli/src/commands.ts:225-227" ]
 }
 #>spw_term_skim
 ^["skim"]{
  #:claim #!settled
  statement: "Skim lives in three vocabularies: the CLI, where it aliases outline and names a flag on select and query; the care ladder, where it is the second rung; and everyday reading."
  breaks: "running spw skim earns no skim receipt by itself, since a receipt names the care a reader applied"
  sources: [ ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_cli_readers", ~"../../registries/sources/spw-design-studies.spw#src_lab_cut_vocabulary" ]
  cites: [ "packages/spw-cli/src/commands.ts:338-341", "packages/spw-cli/src/args.ts:121,272" ]
  care: ~"../inspection-and-ir.spw#spw_inspection_and_ir"
 }
 #>spw_term_read
 ^["read"]{
  #:claim #!settled
  statement: "Read lives in three vocabularies: the CLI, where it aliases outline; the care ladder, where it means following every claim; and readings, the appositions spw lattice counts."
  breaks: "spw read prints landmarks or a line window, and following every claim is work the command leaves to the reader"
  sources: [ ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_cli_readers", ~"../../registries/sources/spw-design-studies.spw#src_lab_cut_vocabulary" ]
  cites: [ "packages/spw-cli/src/commands.ts:217-220,338-341" ]
  care: ~"../inspection-and-ir.spw#spw_inspection_and_ir"
 }
}

^["try"]{
 #>spw_term_try
 ^["two_sided_cards"]{
  materials: [ "index cards", "a pen", "a partner" ]
  steps: << "pick three words your field owns" ; "write the field sense on one side and the Spw sense on the other" ; "read the break line aloud" ; "swap cards and guess where the other words break" >>
  time: .{ n: 15, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"./terms.spw#spw_term_valence"
 }
}

#>spw_term_mislead_q
?["Which borrowed word misleads readers from its home field most?"]{
 #:depth #!social ~#lens(semiotic charge)
 #:claim #!speculative
 ~#hypothesis: "Words that keep a field term but drop its observable, such as resonance and field, mislead their home readers more than tool homonyms such as skim mislead anyone."
 !probe{ "ask readers from three fields to define five terms before and after reading the break lines, and tally changed definitions per term, never per reader" =id[p_gloss_term_mislead] =kind[interview] }
 breaks: "a physicist meeting resonance brings a whole theory, while a tool homonym brings only a habit of use"
