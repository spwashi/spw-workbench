# Operator Glossary
#
# One frame per mark: the canon reader name, the other names the repository gives it, what the runtime does, a spoken name, a keyboard note, and field analogs that each name where they break.

#>spw_gloss_operators
#:layer #!semantics
#:domain #!spw
#:form #!glossary
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Operator Glossary"
 ~#claim: "Each Spw mark has one canon reader name, while five naming tables in the repository disagree on six of the thirteen marks."
 ~#proof: "Names are read from operators.spw and four code and registry tables at commit 1aa1dc23; runtime rows quote operators.spw:47-59."
 ~#door: "Find a mark you already type, say its spoken name, then read where your field analog breaks."
 ~#audience: "anyone learning to read Spw marks aloud and in code"
 continuity: "Operator Glossary | reader name"
 cold_open: "Every mark has a reader name you can say aloud, and each analog from your field shows where it breaks."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  ".agents/plans/caches-cut-2026-09-30/references/studies/persona-synthesis.json tree_amendments and metaphor_limits",
  "naming tables and runtime rows re-read at commit 1aa1dc23 on 2026-10-02"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #skim, outcome: #pass }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r8"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker", care: #adversarial, outcome: #pass }
  ^["r9"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the persona amendment taught # as resonance, & as confluence, and ^ as integration; canon names them vibration, subject, and ascension, so each row leads with the canon name and lists the rest as aliases",
  "the persona limits said the spaced bias form yields no edge; at 1aa1dc23 readBias reads = [depth]{ deep } and =[depth]{ deep } as the same edge",
  "a raw language-features cache read = as a constraint and skipped # and .; the rows cover all thirteen marks and read = as configuration and bias",
  "the question row cited geometry-inspect.ts:57 for the probe alias, which is the bang row; the probe alias sits at :58"
 ]
}

^["edges"]{
 grounds: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators" ]
 extends: [ ~"../voice.spw#spw_voice_spoken_names" ]
 contrasts: [ ~"../familiarity-matrix.spw#spw_familiarity_matrix" ]
}

#>spw_gloss_op_naming
^["naming"]{
 #:claim #!settled
 statement: "Across five naming tables, seven marks keep one name and six vary; # varies most, named resonance, vibration, and annotation."
 reads: %[gloss.naming.tables_n, gloss.naming.hash_label_bits]
 source: ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_naming_tables"
 cites: [ "docs/theory/spw/operators.spw:28-42", "packages/spw-runtime/src/state/type-affinities.ts:18-32", ".spw/registries/register-bank.spw:11-24", "packages/spw-seed/src/canonical/geometry-inspect.ts:55-68", "packages/spw-seed/src/canonical/form-ladders.ts:304-547" ]
 collision: "subject names & in operators.spw:35 and names . in type-affinities.ts:27 and register-bank.spw:21"
 status_discipline: "canon tags each behavior as token, onf, runtime, proposed, or interpretive at operators.spw:18-24"
}

^["keyboard_note"]{ basis: "interpretive", scope: "positions are for the US ANSI layout as printed on its keycaps; other layouts move marks behind AltGr, Option, or dead keys, so check the keyboard viewer of your system" }

^["marks"]{
 #>spw_gloss_op_tilde
 ^["tilde"]{
  #:claim #!settled
  statement: "Canon reads ~ as potential, and the runtime returns a deferred wrapper around its first argument; before a quoted path, ~ makes a path ref."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators"
  cites: [ "docs/theory/spw/operators.spw:29", "docs/theory/spw/operators.spw:57" ]
  names: "potential in every table; geometry-inspect.ts:59 adds path"
  keyboard: "Shift with the key left of 1" ~#spoken(tilde)
  ^["analogs"]{
   physics: .{ analog: "a potential field", observable: "a deferred wrapper", breaks: "no field, gradient, or force, and nothing sums amplitudes" }
   c: .{ analog: "a quoted include path", observable: "a path ref resolved against the citing file", breaks: "nothing is included; only spw expand inlines reflexive edges" }
  }
 }
 #>spw_gloss_op_hash
 ^["hash"]{
  #:claim #!settled
  statement: "Canon reads # as vibration and code tables call it resonance; the runtime resonates a register, #word is a tag, and # with a space starts a dropped note."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators"
  cites: [ "docs/theory/spw/operators.spw:30,47", "packages/spw-seed/src/lexer/matchers/comments.ts:58-68" ]
  names: "Resonance in three tables, annotation / resonance in geometry-inspect.ts:63; vibration, the canon name, is the outlier"
  reads: %[gloss.naming.hash_label_bits]
  keyboard: "Shift with 3; UK PC layouts give # its own key beside Enter" ~#spoken(hash)
  ^["analogs"]{
   design: .{ analog: "a CSS id or hex colour", observable: "a tag operation", breaks: "a tag is not unique, and the parser never sees a colour" }
   creators: .{ analog: "a hashtag", observable: "a tag operation", breaks: "no feed or search, and tags are case-sensitive identifiers" }
  }
 }
 #>spw_gloss_op_dot
 ^["dot"]{
  #:claim #!settled
  statement: "Canon reads . as ground; the runtime accesses a framed property path or returns the base value, and .{ } holds a facet of named bindings."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators"
  cites: [ "docs/theory/spw/operators.spw:31,53,120" ]
  names: "Ground in form-ladders.ts:427 and geometry-inspect.ts:64; Subject in type-affinities.ts:27 and register-bank.spw:21"
  reads: %[gloss.naming.dot_label_bits]
  keyboard: "the period key, unshifted" ~#spoken(dot)
  ^["analogs"]{
   design: .{ analog: "a CSS class rule", observable: "a labeled facet with a body", breaks: "no selection, cascade, or specificity" }
   library: .{ analog: "a Colon Classification facet", observable: "a property block", breaks: "Ranganathan drew a facet from one train of characteristics with a filing order; .{ } holds any bindings" }
  }
  credit: ~"../../registries/sources/spw-design-studies.spw#src_lab_ranganathan_1933"
 }
 #>spw_gloss_op_amp
 ^["amp"]{
  #:claim #!settled
  statement: "Canon names & subject while every code table calls it confluence; the runtime merges arguments through register confluence."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators"
  cites: [ "docs/theory/spw/operators.spw:35,49", "docs/theory/spw/operator-atlas.spw:41" ]
  names: "Confluence in four tables; subject, the canon name, is the outlier"
  reads: %[gloss.naming.amp_label_bits]
  keyboard: "Shift with 7" ~#spoken(and)
  ^["analogs"]{
   c: .{ analog: "logical and", observable: "two & operations, the second taking the next word as a modifier", breaks: "no boolean is computed" }
   chem_eng: .{ analog: "a mixing tee", observable: "confluence with provenance in the atlas", breaks: "physical mixing loses which stream each part came from" }
  }
 }
 #>spw_gloss_op_caret
 ^["caret"]{
  #:claim #!settled
  statement: "Canon reads ^ as ascension and code tables as integration; the runtime returns an integrated wrapper, and a caret before a bracketed name opens a named frame."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators"
  cites: [ "docs/theory/spw/operators.spw:37,56", "packages/spw-runtime/src/state/type-affinities.ts:20" ]
  names: "Integration in three tables, integrate / frame in geometry-inspect.ts:56; ascension, the canon name, is the outlier"
  reads: %[gloss.naming.caret_label_bits]
  keyboard: "Shift with 6; a dead key on many European layouts" ~#spoken(caret)
  ^["analogs"]{
   math: .{ analog: "an exponent", observable: "x^2 splits into x, a bare ^, and 2", breaks: "no arithmetic is done" }
   design: .{ analog: "a Figma frame or layer", observable: "nested named frames", breaks: "no geometry, constraints, or stacking order" }
  }
 }
 #>spw_gloss_op_dollar
 ^["dollar"]{
  #:claim #!settled
  statement: "Canon reads $ as substrate, and the runtime materializes register metadata, so $HOME names a substrate and reads no environment."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators"
  cites: [ "docs/theory/spw/operators.spw:38,52", "packages/spw-seed/src/canonical/geometry-inspect.ts:66" ]
  names: "Substrate in four tables; select / address in geometry-inspect.ts:66 is the outlier"
  reads: %[gloss.naming.dollar_label_bits]
  keyboard: "Shift with 4" ~#spoken(dollar)
  ^["analogs"]{
   c: .{ analog: "a shell variable", observable: "a $ operation named HOME", breaks: "no environment is read" }
   math: .{ analog: "TeX inline math", observable: "four scattered operations", breaks: "the formula never forms" }
  }
 }
 #>spw_gloss_op_equals
 ^["equals"]{
  #:claim #!settled
  statement: "Canon reads = as configuration; the runtime writes its first argument to a register, a bare k = v forms no binding, and = with a body is a bias edge."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_bias_product"
  cites: [ "docs/theory/spw/operators.spw:40,50", "packages/spw-seed/src/canonical/read-bias.ts:102-117" ]
  names: "Configuration in form-ladders.ts:527, config / bias in geometry-inspect.ts:61; Set in type-affinities.ts:24 and register-bank.spw:19"
  reads: %[gloss.naming.equals_label_bits]
  keyboard: "the key left of Backspace, unshifted" ~#spoken(equals)
  ^["analogs"]{
   c: .{ analog: "assignment", observable: "k = v leaves three flat siblings", breaks: "Spw binds with a colon" }
   society: .{ analog: "a regression coefficient", observable: "anchor, axis, ranked targets, and a sign", breaks: "no magnitude, standard error, or identification" }
   life: .{ analog: "a pathway arrow", observable: "a forward or inverse sign", breaks: "bane leans inverse, which is not inhibition" }
  }
 }
 #>spw_gloss_op_at
 ^["at"]{
  #:claim #!settled
  statement: "Canon reads @ as perspective; the runtime observes its first argument through a named observer, and @name parses as a reference that notifies no one."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators"
  cites: [ "docs/theory/spw/operators.spw:36,48" ]
  names: "perspective in every table; geometry-inspect.ts:62 adds root"
  keyboard: "Shift with 2; UK PC layouts move it to Shift with the quote key" ~#spoken(at)
  ^["analogs"]{
   creators: .{ analog: "a mention", observable: "a Reference node", breaks: "nobody is notified, and the handle enters the tree" }
   design: .{ analog: "a media query", observable: "a reference with a scope and a body", breaks: "no condition is evaluated" }
  }
 }
 #>spw_gloss_op_question
 ^["question"]{
  #:claim #!settled
  statement: "Canon reads ? as wonder; the runtime returns the second argument, or true, when the first is truthy, and a wonder block opens with ?[ ]."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators"
  cites: [ "docs/theory/spw/operators.spw:32,54" ]
  names: "wonder in every table; geometry-inspect.ts:58 adds probe"
  keyboard: "Shift with the slash key" ~#spoken(question)
  ^["analogs"]{
   stagecraft: .{ analog: "a standby call", observable: "a ? operation in order", breaks: "nothing waits for a reply" }
   society: .{ analog: "a survey item", observable: "a wonder block with a probe", breaks: "probes never run" }
  }
 }
 #>spw_gloss_op_bang
 ^["bang"]{
  #:claim #!settled
  statement: "Canon reads ! as action, and the runtime returns its first argument, so !done names an action and negates nothing."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators"
  cites: [ "docs/theory/spw/operators.spw:33,55" ]
  names: "action in every table; geometry-inspect.ts:57 adds inject"
  keyboard: "Shift with 1" ~#spoken(bang)
  ^["analogs"]{
   stagecraft: .{ analog: "a GO", observable: "the first argument returned", breaks: "nothing fires" }
   creators: .{ analog: "a chat command", observable: "an action operation", breaks: "nothing executes" }
  }
 }
 #>spw_gloss_op_star
 ^["star"]{
  #:claim #!settled
  statement: "Canon reads * as value, and the runtime writes and returns a collapsed first argument, with the same result on every run."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators"
  cites: [ "docs/theory/spw/operators.spw:34,58" ]
  names: "value in every table; geometry-inspect.ts:60 adds collapse"
  keyboard: "Shift with 8" ~#spoken(star)
  ^["analogs"]{
   physics: .{ analog: "wavefunction collapse", observable: "a write and a return", breaks: "no basis, probabilities, or Born rule" }
   language: .{ analog: "the ungrammatical star", observable: "a value operation with a modifier", breaks: "no judgment is recorded" }
  }
 }
 #>spw_gloss_op_percent
 ^["percent"]{
  #:claim #!settled
  statement: "Canon reads % as measure; the runtime measures a register into the range zero to one, while registry cells written with % hold unbounded world quantities."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators"
  cites: [ "docs/theory/spw/operators.spw:39,51", ".spw/registries/register-bank.spw:31" ]
  names: "measure in every table"
  keyboard: "Shift with 5" ~#spoken(percent)
  ^["analogs"]{
   math: .{ analog: "a measure", observable: "a scalar in zero to one", breaks: "no sigma-additivity, so it sits closer to a membership grade" }
   learning: .{ analog: "a rubric score", observable: "a scalar in zero to one", breaks: "rubric levels are ordinal, and a scalar asserts equal spacing" }
  }
  credit: ~"../../registries/sources/spw-design-studies.spw#src_lab_stevens_1946"
 }
 #>spw_gloss_op_couple
 ^["couple"]{
  #:claim #!settled
  statement: "Canon reads <> as coupling; the runtime makes a two-way register edge only when the first two operands are string keys, and returns all operands."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators"
  cites: [ "docs/theory/spw/operators.spw:41,59", "packages/spw-runtime/src/state/type-affinities.ts:31" ]
  names: "coupling in the three tables that list it; register-bank.spw and geometry-inspect.ts omit <>"
  keyboard: "Shift with comma, then Shift with period" ~#spoken(couple)
  ^["analogs"]{
   chem_eng: .{ analog: "an equilibrium double arrow", observable: "<=> degrades the surface", breaks: "an equilibrium holds between whole sides" }
   library: .{ analog: "bibliographic coupling", observable: "a declared two-way edge", breaks: "Kessler computed coupling from shared references; <> is declared" }
  }
  credit: ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_kessler_1963"
 }
 canon_status: #runtime, status_cite: "docs/theory/spw/operators.spw:47-59"
}

^["compounds"]{
 #>spw_gloss_op_dollar_percent
 ^["dollar_percent"]{
  #:claim #!settled
  statement: "$% followed by a bracketed list parses as two operations, a bare $ and a % with a frame, so it lives on wonder metric lines."
  source: ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_parser_probes"
  cites: [ "scripts/analyzers/spw-cut-gate.ts:51" ]
 }
 #>spw_gloss_op_hash_hash_deixis
 ^["hash_hash_deixis"]{
  #:claim #!settled
  statement: "##> with a name is no particle to the parser, which reads a # operation with a prose payload, while the LSP display matches it as an anchor."
  source: ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_parser_probes"
  cites: [ "packages/spw-seed/src/lexer/matchers/particles.ts:30-33", "packages/spw-lsp/src/handlers/display.ts:36,78-80" ]
 }
 #>spw_gloss_op_fat_arrow
 ^["fat_arrow"]{
  #:claim #!settled
  statement: "=> lexes as an arrow that separates steps; in k: v => w only v binds to k, and w stands as its own step."
  source: ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_parser_probes"
  cites: [ "packages/spw-seed/src/types/token.ts:44" ]
 }
}

^["try"]{
 #>spw_gloss_op_try
 ^["say_and_type"]{
  materials: [ "this glossary", "your own keyboard", "a partner or a voice recorder" ]
  steps: << "pick three marks" ; "say the spoken name, then the reader name" ; "type each mark and note the keys you pressed" ; "compare with the keyboard note" >>
  time: .{ n: 10, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"./operators.spw#spw_gloss_op_naming"
 }
}

#>spw_gloss_op_naming_q
?["Would the naming tables converge if each name had to carry an observable?"]{
 #:depth #!computational ~#lens(semiotic charge)
 #:claim #!speculative
 ~#hypothesis: "The marks whose names vary are those whose runtime behavior sits closest to a neighbor, so tying names to observables would shrink their spread first."
 !probe{ "pair each varying mark with its runtime row and its nearest neighbor by behavior, then recount label spread after renaming" =id[p_gloss_op_naming] =kind[census] }
 $%[gloss.naming.hash_label_bits, gloss.naming.dot_label_bits]
 ~"./operators.spw#spw_gloss_op_naming" ~#neighbor(nearest)
}
