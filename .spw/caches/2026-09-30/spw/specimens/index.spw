# Spw Specimens
#
# Hazard fixtures grouped by notation family: each row is a habit fed to the parser, the verdict it earned, and the glossary row it is evidence for.

#>spw_specimens
#:layer #!semantics
#:domain #!spw
#:form #!index
#:level #!foundation
#:review #!sourced
#:valence #!honk

^"emit"{
 ~#title: "Spw Specimens"
 ~#claim: "One hundred twenty field habits were fed to the parser one line at a time, and most of them changed shape with no tool reporting it."
 ~#proof: "Every row records its fingerprint signature, verdict, and loudness at commit 1aa1dc23, and all rows were replayed against the parser on 2026-10-03."
 ~#door: "Open the battery for your own field, then follow a row to the false friend it illustrates."
 ~#audience: "practitioners checking their own notation, and maintainers looking for regression fixtures"
 continuity: "Spw Specimens | changed shape"
 cold_open: "Most habits from other fields changed shape in the parser, and no tool said a word."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["edges"]{
 grounds: [ ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_parser_probes" ]
 feeds: [ ~"../glossary/false-friends.spw#spw_false_friends", ~"../contraptions/false-friend-lab.spw#spw_lab_false_friend" ]
}

^["tree"]{
 code: ~"./code-habits.spw"
 math_physics: ~"./math-physics-notation.spw"
 design: ~"./design-tokens.spw"
 lab_data: ~"./lab-and-data.spw"
 language_library: ~"./language-and-library.spw"
 media_classroom: ~"./media-and-classroom.spw"
}

^["bundle"]{
 ={
  ~"./code-habits.spw#spw_spec_code"
  ~"./math-physics-notation.spw#spw_spec_math_physics"
  ~"./design-tokens.spw#spw_spec_design"
  ~"./lab-and-data.spw#spw_spec_lab_data"
  ~"./language-and-library.spw#spw_spec_language_library"
  ~"./media-and-classroom.spw#spw_spec_media_classroom"
 }
}

^["census"]{
 #>spw_specimens_census
 ^["loudness_census"]{
  #:claim #!settled
  statement: "Across the six batteries, most rows pass every tool, fewer fail only the cut gate, and the fewest raise a parse warning that the validator prints."
  reads: %[
   gloss.spec.rows_n,
   gloss.spec.silent_n,
   gloss.spec.gate_n,
   gloss.spec.validator_n
  ]
  source: ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_parser_probes"
  ^["limits"]{
   holds: "one parse of one line, with any following line and a final newline, at commit 1aa1dc23"
   fails: "the count measures the parser, not how strongly a habit pulls on a reader, and a parser change makes it a historical reading"
  }
 }
}

^["verdicts"]{
 clean: "the habit parses into the shape a reader of that field expects"
 restructures: "a complete parse into a different tree, such as a ternary that becomes two bindings"
 splits: "a value breaks into siblings, such as 1e3 into 1 and e3"
 hidden_error: "a lexer error drops a character while the parse still succeeds"
 swallows: "a value takes the next line as part of itself"
 drops: "a hash and a space remove the rest of a line from the tree"
 degrades: "the structured parse stops and the whole surface turns to prose"
 loudness: ~"../glossary/false-friends.spw#spw_ff_loudness"
}

^["fixtures"]{
 status: #proposed
 runner: "no repository test replays these rows at 1aa1dc23; the writer replay script was scratch, and a regression suite is proposed for the false-friend lab"
 privacy: "rows use synthetic names and handles only; no row quotes a real person or account"
}
