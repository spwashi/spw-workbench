   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
   note: "toolchain, build range, verifier hosts, two-stage launcher, settings, and the JetBrains feature table confirmed"
  }
  ^["r10"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: [
  "the availability line said the LSP API ships in the commercial IntelliJ-based IDEs; JetBrains also lists unified PyCharm without a Pro subscription since 2025.1",
  "the first revision gave inlay hints and folding from 2025.2 and rename from 2026.1; the table marks 2025.2.2 and 2026.1.1",
  "the raw compatibility cache gave Gradle task paths under extensions:intellij-spw; the plugin is its own root project, so tasks are test, buildPlugin, and the verify tasks",
  "the raw lsp-client cache named settings customCommand, customWorkingDirectory, and autoStart; the state fields are enabled, command, and workDir",
  "the raw lsp-client cache put an environment variable and local source checkouts in the discovery ladder; the JetBrains launcher reads neither",
  "the raw lsp-client cache said the working directory defaults to the consumer root; with a mount the server runs from the mounted workbench"
 ]
 kept: "Java 21, Gradle 9.5, Kotlin 2.4.10, the platform Gradle plugin 2.18.1, and the 242 to 262 range were exact in the raw compatibility cache"
}

^["edges"]{
 grounds: [ ~"../../registries/quantities/spw-hosts-and-history.spw#q_hosts_jb" ]
