}

^["toolchain"]{
 #>editor_hosts_jetbrains_platform_toolchain
 ^["coordinates"]{
  #:claim #!settled
  statement: "The plugin builds with Java 21, the Kotlin JVM plugin 2.4.10, the IntelliJ Platform Gradle plugin 2.18.1, and the Gradle 9.5.0 wrapper, compiling against WebStorm 2024.2.1."
  reads: %[hosts.jb.java_toolchain, hosts.jb.build_host_version]
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_jb_build"
  cites: [ "extensions/intellij-spw/build.gradle.kts:3-7,12,26-35,38-46", "extensions/intellij-spw/gradle/wrapper/gradle-wrapper.properties:3", "extensions/intellij-spw/.java-version:1" ]
 }
 #>editor_hosts_jetbrains_platform_range
 ^["build_range"]{
  #:claim #!settled
  statement: "The plugin declares sinceBuild 242 and untilBuild 262 wildcard and is verified against WebStorm 2026.2.0.1 and 2026.2.1."
  reads: %[hosts.jb.since_build]
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_jb_build"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_jb_plugin_xml" ]
  cites: [ "extensions/intellij-spw/build.gradle.kts:13-14,52-55,58-63", "extensions/intellij-spw/src/main/resources/META-INF/plugin.xml:10-11" ]
 }
 ^["tasks"]{
  root: "extensions/intellij-spw/settings.gradle.kts names rootProject intellij-spw, so tasks have no parent path"
  test: "npm run test:intellij runs gradlew test; package.json:153"
  verify: "npm run verify:intellij runs test, buildPlugin, verifyPluginProjectConfiguration, verifyPluginStructure, verifyPlugin; package.json:154"
  build: "npm run build:intellij runs gradlew buildPlugin; package.json:155"
  status: #implemented
 }
 depends: #[ platform, textmate, lsp, spellchecker ]
 depends_cites: "plugin.xml:28-31"
}

^["discovery"]{
 #>editor_hosts_jetbrains_platform_two_stage
 ^["two_stage"]{
  #:claim #!settled
  statement: "Stage one picks a tool root: a configured workDir, else the project if its package.json has an lsp script, else a mounted .spw/_workbench with one, else the project."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_jb_launcher"
  cites: "extensions/intellij-spw/src/main/kotlin/com/spwashi/spw/SpwLspLauncher.kt:18-41"
 }
 #>editor_hosts_jetbrains_platform_stage_two
 ^["stage_two"]{
  #:claim #!settled
  statement: "Stage two launches a configured command if its executable exists; otherwise it requires a package.json, an lsp script, and npm on PATH, then runs npm run --silent lsp."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_jb_lsp_provider"
  cites: "extensions/intellij-spw/src/main/kotlin/com/spwashi/spw/SpwLspServerSupportProvider.kt:47-88"
  on_failure: ?match[startup_issue]{
   "no project root" => "warn once: open a project folder or set an absolute working directory",
   "missing workDir" => "warn once with the path",
   "no package.json" => "warn once naming the project or mounted workbench",
   "no lsp script" => "warn once with the default launcher contract",
   "no npm" => "warn once: Node.js with npm must be on PATH",
   "missing command" => "warn once with the executable name"
  }
  failure_cites: "SpwLspServerSupportProvider.kt:28-84,100-120"
 }
 #>editor_hosts_jetbrains_platform_workdir
 ^["workdir_is_tool_root"]{
  #:claim #!settled
  statement: "The resolved tool root is also the server process working directory, so with a mount the server runs inside .spw/_workbench while the consumer project keeps document identity."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_jb_lsp_provider"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_tooling_intellij", ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_lsp_server" ]
  cites: [ "SpwLspServerSupportProvider.kt:36,136-142", ".spw/tooling/intellij-plugin.spw:53", "packages/spw-lsp/src/stdio-server.ts:195-197" ]
 }
 #>editor_hosts_jetbrains_platform_settings
 ^["settings_state"]{
  #:claim #!settled
  statement: "The settings page Spw LSP under Tools stores three fields per project in the workspace file: enabled, command, and workDir."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_jb_settings"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_jb_plugin_xml" ]
  cites: [ "settings/SpwLspSettings.kt:10-20", "plugin.xml:43-47" ]
 }
 ^["abbreviation"]{ kotlin: "Kotlin paths are under extensions/intellij-spw/src/main/kotlin/com/spwashi/spw" }
}

^["native_lsp"]{
 #>editor_hosts_jetbrains_platform_token_floor
 ^["token_floor"]{
  #:claim #!settled
  statement: "The JetBrains native client paints semanticTokens/full from 2024.2.2, while the plugin admits every 2024.2 build, so the earliest admitted hosts get no server token colors."
  reads: %[hosts.jb.semantic_tokens_min_ide, hosts.jb.since_build]
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_jetbrains_lsp_docs"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_jb_build", ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_tokens_study" ]
  as_of: "JetBrains documentation read 2026-10-02"
 }
 #>editor_hosts_jetbrains_platform_no_customization
 ^["no_customization"]{
  #:claim #!settled
  statement: "The server descriptor overrides only isSupportedFile and createCommandLine; it sets no lspCustomization, so token colors follow the platform defaults."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_jb_lsp_provider"
  cites: "SpwLspServerSupportProvider.kt:128-143"
  verify: "how the platform maps the nine server token types to TextAttributesKeys has not been checked in a running IDE"
 }
 #>editor_hosts_jetbrains_platform_feature_table
 ^["feature_table"]{
  #:claim #!settled
  statement: "The JetBrains feature table lists document links from 2025.1, inlay hints and folding from 2025.2.2, code lens from 2026.1, and rename from 2026.1.1, so admitted builds differ in what the server can show."
  reads: %[hosts.jb.native_lsp_rename_min_ide]
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_jetbrains_lsp_docs"
  as_of: "JetBrains documentation read 2026-10-02 and reread 2026-10-03"
  verify: "whether Rename Spw Symbol works on builds 242 through 253 has not been run; the raw cache said rename was verified on 262 only"
 }
 availability: "JetBrains lists the LSP API in IntelliJ IDEA, WebStorm, PhpStorm, PyCharm, DataSpell, RubyMine, CLion, DataGrip, GoLand, Rider, and RustRover, and since 2025.1 in unified PyCharm without a Pro subscription"
 unavailable: "JetBrains says plugins using it are unavailable in IntelliJ IDEA open source builds and Android Studio; read 2026-10-03"
 availability_source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_jetbrains_lsp_docs"
}

#>editor_hosts_jetbrains_platform_q
?["Does a build range wider than the token floor leave some hosts without server colors?"]{
 #:depth #!computational ~#lens(signal path)
 #:claim #!speculative
 ~#hypothesis: "On WebStorm 2024.2.1 the plugin should start the server yet show TextMate colors only, while 2024.2.2 should add server tokens."
 !probe{ "run runIde on WebStorm 2024.2.1 and 2024.2.2 with the same project and compare token colors on one fixture" =id[p_hosts_jb_token_floor] =kind[build] }
 $%[hosts.jb.since_build, hosts.jb.semantic_tokens_min_ide]
 ~"./jetbrains-platform.spw#editor_hosts_jetbrains_platform_token_floor" ~#neighbor(nearest)
}
