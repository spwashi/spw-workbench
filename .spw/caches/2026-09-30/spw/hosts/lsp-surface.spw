# Language Server Surface
#
# Every capability and spw request method the shared language server answers, which host calls which, and what the server reads only once at initialize.

#>editor_hosts_lsp
#:layer #!reference
#:domain #!editor_hosts
#:form #!registry
#:level #!practitioner
#:review #!sourced
#:valence #!bone
#:era #!current

^"emit"{
 ~#title: "Language Server Surface"
 ~#claim: "One server, spw-lsp, advertises seventeen standard providers and answers twenty-three spw methods; VS Code calls fourteen, Neovim eight, JetBrains none."
 ~#proof: "Rows cite the dispatcher and handlers in packages/spw-lsp and the call sites in each extension at commit 1aa1dc23."
 ~#door: "Read the custom method rows, then follow a caller into the VS Code cache machine."
 ~#audience: "plugin maintainers wiring a new host to spw-lsp"
 continuity: "Language Server Surface | one server"
 cold_open: "One server answers every editor, and this page lists what it answers, who asks, and what it reads only once."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
