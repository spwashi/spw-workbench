  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #corrected
   note: "providers, methods, callers, legend, diagnostics gate, and lens commands reread at 1aa1dc23"
  }
 }
 recount: "capabilities, methods, and call sites recounted at commit 1aa1dc23 by reading the dispatcher and grepping each extension"
 corrections: [ "referenceGraph and corpus share one dispatcher case, so the method count now says eight answered directly, two sharing a case" ]
 refutes: "the raw syntax-highlighting cache said the server sends full and delta semantic tokens; it advertises full only, as the errata ledger records"
}

^["edges"]{
 grounds: [ ~"../../registries/quantities/spw-hosts-and-history.spw#q_hosts_lsp" ]
 feeds: [ ~"./vscode-lsp-and-cache.spw#editor_hosts_vscode_lsp_cache", ~"./host-parity-matrix.spw#editor_hosts_parity" ]
