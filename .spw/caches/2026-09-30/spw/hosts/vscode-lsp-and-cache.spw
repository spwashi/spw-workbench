^["client"]{
 #>editor_hosts_vscode_lsp_cache_bundled
 ^["bundled_only"]{
  #:claim #!settled
  statement: "The client reads one server path from the manifest, refuses any path that leaves the extension, and runs that bundled file over stdio as client spwLanguageServer."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_vscode_extension"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_vscode_readme", ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_vscode_manifest" ]
  cites: [ "extensions/vscode-spw/src/extension.ts:76-90", "extensions/vscode-spw/src/extension.ts:114-125", "extensions/vscode-spw/package.json:35-38", "extensions/vscode-spw/README.md:28" ]
 }
 ^["states"]{
  #>editor_hosts_vscode_lsp_cache_s_inactive
  ^["inactive"]{ enters: "VS Code start", exits: "an activation event: a spw file, the Concepts view, or the Workspace view", cites: "extensions/vscode-spw/package.json:27-31" }
  #>editor_hosts_vscode_lsp_cache_s_activating
  ^["activating"]{
   enters: "activate"
   work: "build the client, start it, then register views, decorations, and commands"
   on_manifest: ?match[server_path]{
    "a dot-slash path with no parent step" => "resolve it inside the extension and start over stdio",
    "anything else" => "throw, so activation fails with a message about the bundled path"
   }
   cites: "extensions/vscode-spw/src/extension.ts:23-60"
  }
  #>editor_hosts_vscode_lsp_cache_s_initializing
  ^["initializing"]{
   enters: "the initialize request"
   work: "find the consumer workspace root, read initializationOptions, build the index, answer capabilities, then scan the workspace in the background"
   exits: "running"
   cites: "packages/spw-lsp/src/stdio-server.ts:194-252"
  }
  #>editor_hosts_vscode_lsp_cache_s_running
  ^["running"]{
   enters: "the initialize result"
   work: "track open, change, save, and close; publish diagnostics after a debounce"
   on_setting_change: ?match[setting]{
    "spw.surface or spw.compute" => "decorations reread it on the next pass",
    "spw.cache.probeTtlMs" => "the probe cache is cleared and takes the new TTL",
    "spw.inlayHints or spw.diagnostics" => "the server keeps the old value; see the restart claim",
    "spw.trace.server" => "nothing reads it"
   }
   cites: [ "packages/spw-lsp/src/stdio-server.ts:172-179", "packages/spw-lsp/src/stdio-server.ts:418-475", "extensions/vscode-spw/src/surface-decorations.ts:463-465" ]
  }
  #>editor_hosts_vscode_lsp_cache_s_restarting
  ^["restarting"]{ enters: "Spw: Restart Language Server", work: "client.restart, which sends initialize again", exits: "initializing", cites: "extensions/vscode-spw/src/commands.ts:165-168" }
  #>editor_hosts_vscode_lsp_cache_s_stopped
  ^["stopped"]{ enters: "deactivate or window close", work: "client.stop", cites: "extensions/vscode-spw/src/extension.ts:62-66" }
 }
 #>editor_hosts_vscode_lsp_cache_restart_options
 ^["restart_reuses_options"]{
  #:claim #!emerging
  statement: "The client builds its initializationOptions once at activation as a plain object, so a restart sends the same inlay and diagnostic values and only a window reload sends new ones."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_vscode_extension"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_vscode_languageclient" ]
  cites: [ "extensions/vscode-spw/src/extension.ts:25,92-111", "vscode-languageserver-node client.ts, initializationOptions evaluated from stored client options" ]
  evidence: "read from the extension and library code on 2026-10-02; not yet run in an editor"
 }
 #>editor_hosts_vscode_lsp_cache_trace
 ^["inert_trace_setting"]{
  #:claim #!settled
  statement: "The language client reads its trace level from the setting named after its id, spwLanguageServer.trace.server, so the contributed spw.trace.server changes nothing."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_vscode_languageclient"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_vscode_extension", ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_vscode_manifest" ]
  cites: [ "extensions/vscode-spw/src/extension.ts:77", "extensions/vscode-spw/package.json:175-180" ]
 }
}

^["cache_planes"]{
 #>editor_hosts_vscode_lsp_cache_planes
 ^["four_planes"]{
  #:claim #!settled
  statement: "The seed names four cache planes, editor probe cache, LSP session reflection, runtime cache, and corpus memo, and a host that cannot fill one names it and says why."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_seed_cache_layer"
  cites: [ "packages/spw-seed/src/ir/cache-layer.ts:1-15", "packages/spw-seed/src/ir/cache-layer.ts:36-56" ]
 }
 #>editor_hosts_vscode_lsp_cache_probe_cache
 ^["editor_probe_cache"]{
  #:claim #!settled
  statement: "The VS Code probe cache serves Inspect Form only, keys on URI and document version, expires entries lazily on read, and has no size cap."
  reads: %[hosts.vscode.probe_ttl_ms]
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_vscode_probe_cache"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_vscode_instruments" ]
  cites: [ "extensions/vscode-spw/src/instruments/probe-cache.ts:9-18", "extensions/vscode-spw/src/instruments/probe-cache.ts:22,46-51", "extensions/vscode-spw/src/instruments/commands.ts:97-103" ]
  stats: #[ entries, ttlMs, hits, misses, expired, disabled, writes, clears ]
 }
 #>editor_hosts_vscode_lsp_cache_dropped_layers
 ^["dropped_layers"]{
  #:claim #!settled
  statement: "The server sends layers with the LSP plane present, but the VS Code client keeps five other fields only, so the card falls back to defaults marking that plane absent."
  source: ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_vscode_custom_requests"
  sources: [ ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_lsp_cache_reflection", ~"../../registries/sources/spw-hosts-and-history.spw#src_hosts_vscode_instruments" ]
  cites: [ "packages/spw-lsp/src/handlers/cache-reflection.ts:164-171", "extensions/vscode-spw/src/lsp/custom-requests.ts:377-387", "extensions/vscode-spw/src/instruments/commands.ts:33-44,165" ]
  peer: "Neovim renders the server layers as sent, extensions/neovim-spw/lua/spw/instruments.lua:116-122"
 }
 ^["card_rows"]{
  editor_probe_cache: .{ vscode_card: "present with snapshot stats when the cache exists", cites: "instruments/commands.ts:46-58" }
  lsp_session_reflection: .{ vscode_card: "absent, omission no LSP session in this process", cites: "instruments/commands.ts:41" }
  runtime_cache: .{ vscode_card: "absent, next spw inspect cache", cites: "instruments/commands.ts:42" }
  corpus_memo: .{ vscode_card: "absent, next spw census --json", cites: "instruments/commands.ts:43" }
 }
}

