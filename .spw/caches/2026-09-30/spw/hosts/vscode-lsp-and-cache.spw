#:era #!current

^"emit"{
 ~#title: "VS Code Server Lifecycle and Cache Planes"
 ~#claim: "VS Code starts only its bundled server over stdio, sends settings once at initialize, and its cache card drops the server's layers."
 ~#proof: "States and transitions cite extension.ts, commands.ts, custom-requests.ts, and the stdio server at commit 1aa1dc23."
 ~#door: "Walk the client states, then read why the cache card shows the server plane absent."
 ~#audience: "maintainers debugging VS Code startup, settings, or the cache card"
 continuity: "VS Code Server Lifecycle and Cache Planes | bundled server"
 cold_open: "VS Code starts one bundled server, tells it the settings once, and its cache card loses the server plane on the way."
}

