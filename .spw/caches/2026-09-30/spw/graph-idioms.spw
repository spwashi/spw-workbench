 ]
}

^["edges"]{
 needs: [ ~"../record/information/archive-patterns-matrix.spw#information_science_patterns" ]
 grounds: [ ~"../contract.spw#cut_contract" ]
 case_of: [ ~"../physical/materials/water.spw#materials_water" ]
 see: [ ~"./theory/address-and-linking.spw#spw_theory_address" ]
}

^["concepts"]{
 primary: [ #typed_edge, #one_parent ]
 transfers: [ #renvoi ], tensions: [ #facet_decay ]
}

^["ancestors"]{
 #>spw_idiom_ancestors
 ^["older_graphs"]{
  #:claim #!interpretive
  statement: "These idioms rework older practice: cross-references that tie an alphabetical work together, faceted classification, and slip boxes that link notes by number."
  see: [ ~"../record/information/archive-patterns-matrix.spw#information_science_patterns_renvoi", ~"../record/information/archive-patterns-matrix.spw#information_science_patterns_colon", ~"../record/information/archive-patterns-matrix.spw#information_science_patterns_luhmann" ]
 }
}

^["idioms"]{
 #>spw_idiom_one_parent
 ^["one_parent"]{
  do: "route each surface from exactly one index with a tree entry and no fragment"
  avoid: "linking from a child up to its own index or any ancestor index"
  why: "the tree is for finding; the gate fails any non-index link to an index whose directory prefixes the linking file"
  learned: ~"../contract.spw#cut_contract"
  cites: [ "scripts/analyzers/spw-cut-gate.ts:348-349" ]
 }
 #>spw_idiom_typed_edges
 ^["typed_edges"]{
  do: "put meaning in edges whose relation comes from the closed set: needs, feeds, grounds, extends, contrasts, analog, supersedes, case_of, see"
  avoid: "a page of untyped links that a reader must interpret"
  why: "an edge is a claim and should be defensible"
  learned: ~"../physical/materials/water.spw#materials_water"
 }
 #>spw_idiom_small_bundles
 ^["small_bundles"]{
  do: "bundle only the file anchors of the index's own children"
  avoid: "bundling deep keystones or files in other directories"
  why: "spw expand splices each target by line and copies its links without rebasing them"
  learned: ~"./transforms.spw#spw_transforms_expansion"
 }
 #>spw_idiom_closed_facets
 ^["closed_facets"]{
  #:claim #!settled
  statement: "At 229aedcf the raw shelf carried 231 distinct lens phrases in 232 uses, so its lens facet grouped almost nothing."
  reads: %[spw.corpus.raw_lens_distinct, spw.corpus.raw_lens_uses]
  source: ~"../registries/sources/spw-branch.spw#src_spw_raw_shelf"
  see: [ ~"../registries/sources/spw-branch.spw#src_spw_study_scorecard" ]
  earlier: "the review scorecard counted 165 distinct in 167 uses on a 152-file snapshot of the same shelf"
  do: "draw every axis, lens, relation, and status from the vocabulary, and add a value only when it recurs"
  learned: ~"../vocabulary.spw#cut_vocabulary"
 }
 #>spw_idiom_registries
 ^["registries_once"]{
  #:claim #!settled
  statement: "At 229aedcf the raw shelf carried 469 metric handles and used each exactly once, so no two surfaces could be compared through a shared number."
  reads: %[spw.corpus.raw_handles]
  source: ~"../registries/sources/spw-branch.spw#src_spw_raw_shelf"
  see: [ ~"../registries/sources/spw-branch.spw#src_spw_study_scorecard" ]
  earlier: "the review scorecard counted 337 handles, all unique, on the earlier snapshot"
  do: "write a number once as a registry cell and read it from every surface that needs it"
  learned: ~"../registries/quantities/materials-and-engineering.spw#q_mateng_water"
 }
 #>spw_idiom_two_conventions
 ^["two_registry_conventions"]{
  do: "address a quantity by its handle with reads and one anchor per family; address a work by a link to its own source anchor"
  avoid: "linking a quantity cell by path, or citing a source by a handle"
  why: "handles aggregate across files, while a source anchor is where a reader lands to find the work"
  learned: [ ~"../registries/quantities/materials-and-engineering.spw#q_mateng_water", ~"../registries/sources/materials-and-engineering.spw#src_mateng_crc_handbook" ]
 }
 #>spw_idiom_trails
 ^["trails"]{
  do: "order a trail with a stops frame and a schedule, and cross at least two classes"
  avoid: "a trail that tours one directory, or a command tour offered as onboarding"
  why: "the tree already serves one directory; a trail earns its place by crossing"
  learned: ~"./arcs-and-readings.spw#spw_arcs_schedule"
 }
 #>spw_idiom_clusters
 ^["clusters_as_prompts"]{
  do: "read a computed cluster as a prompt to compare two surfaces"
  avoid: "writing a cluster or a shared facet as a claim that two things are alike"
  learned: [ ~"./theory/clustering-hybrid.spw#spw_theory_clustering", ~"../panels/affinity-atlas.spw#panel_affinity_atlas" ]
 }
 #>spw_idiom_check_links
 ^["check_links"]{
  do: "check link health with spw resolve and the cut gate, which exist to check links"
  avoid: "reading link health from census or graph counts alone"
  why: "until c79a096a census counted anchored links as broken; the counts now agree, but a count is not a check"
  learned: ~"./inspection-and-ir.spw#spw_ir_trust_census"
 }
}

^["gate_traps"]{
 note: "each trap was hit while writing this cut; the rule in the contract hazards frame came after"

 #>spw_idiom_anchor_binds
 ^["anchor_binds"]{
  do: "put an anchor after a blank line or a brace and directly before the frame or binding it names"
  avoid: "an anchor inside a set or facet, or at the end of a frame"
  cites: [ "scripts/analyzers/spw-cut-gate.ts:202", "scripts/analyzers/spw-cut-gate.ts:209" ]
 }
 #>spw_idiom_same_line
 ^["same_line_tags"]{
  do: "separate same-line bindings with commas"
  avoid: "a tag value followed by another key on the same line, which nests that key inside the tag"
  cites: [ "scripts/analyzers/spw-cut-gate.ts:53" ]
 }
 #>spw_idiom_valence_keys
 ^["valence_keys"]{
  do: "use the five valence words only as header values or modifiers"
  avoid: "a valence word as a binding key, which degrades the whole surface to prose"
  learned: ~"./tokens-and-roles.spw#spw_tokens_div_valence"
 }
 #>spw_idiom_directories
 ^["directory_names"]{
  do: "give sibling directories names that are not string prefixes of each other"
  avoid: "directories named for a query dialect, whose path default can lex a whole surface as one comment"
  cites: [ "scripts/analyzers/spw-cut-gate.ts:348" ]
 }
 #>spw_idiom_fragments
 ^["fragment_quotes"]{
  do: "keep a line-range fragment inside the path quotes"
  avoid: "a range after the closing quote, which becomes a particle on the next node"
  learned: ~"./transforms.spw#spw_transforms_range"
 }
 #>spw_idiom_handles
 ^["metric_lines"]{
  do: "read cells with reads in a claim, and keep the dollar-percent form to wonder lines with at most three handles"
  avoid: "a dollar-percent value inside a binding, which leaves a bare dollar"
  cites: [ "scripts/analyzers/spw-cut-gate.ts:51", "scripts/analyzers/spw-cut-gate.ts:357" ]
 }
}

^["try"]{
 #>spw_idiom_try_trace
 ^["trace_water"]{
  materials: [ "the water exemplar surface", "a notebook you keep" ]
  steps: << "find the one index that routes to water" ; "list every typed edge and its relation" ; "list every registry handle it reads" ; "find one claim whose edge you would type differently" >>
  time: .{ n: 20, unit: "minutes" }
  safety: "none worth naming; you only read surfaces"
  shows: ~"./graph-idioms.spw#spw_idiom_typed_edges"
 }
}

#>spw_idiom_follow_q
?["When readers follow a cut by its typed edges, which relations do they take first?"]{
 #:depth #!social ~#lens(curated collection)
 #:claim #!speculative
 ~#hypothesis: "Readers take needs and see edges more often than contrasts or supersedes, so the most defended edges are read least."
 !probe{ "volunteers walk one hour from the water surface by edges only and note each relation they chose, kept on their own paper" =id[p_spw_idiom_follow] =kind[field] }
 ~"./graph-idioms.spw#spw_idiom_typed_edges" ~#neighbor(nearest)
}
