# Graph Idioms
#
# How to structure a Spw graph, learned while building this cut: one authored parent, typed edges as claims, small bundles, closed facets, registries cited many times, and the gate traps that taught each rule.

#>spw_graph_idioms
#:layer #!pragmatics
#:domain #!spw
#:form #!glossary
#:level #!practitioner
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Graph Idioms"
 ~#claim: "A Spw graph reads well when the tree only finds things, typed edges carry the meaning, and every number and source lives once in a registry."
 ~#proof: "Each idiom names the anchor or gate line where this cut learned it, from the water exemplar to the up-link check in the cut gate."
 ~#door: "Read the one-parent idiom, then open the water exemplar and find its parent, its edges, and its registry reads."
 ~#audience: "writers of Spw graphs, in this cut or in a reader root"
 continuity: "Graph Idioms | typed edges"
 cold_open: "Let the tree help you find things, let typed edges carry the meaning, and keep each number in one place."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "contract.spw graph, links, hazards, and quantities frames, and the gate traps in the cut plan risks",
  "scripts/analyzers/spw-cut-gate.ts re-read by the writer at 1aa1dc23 on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the idioms are a-cut practice learned in this build, not repository canon",
  "the link-check idiom said census counts anchored links as broken; that held until c79a096a, so the reason now names the commit",
