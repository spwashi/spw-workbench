# Perspective: Physicists
#
# Units, conservation, symmetry, and order-of-magnitude habits turned into probes, with each physics-sounding operator name checked against what the runtime observably does.

#>spw_perspectives_physics
#:layer #!pragmatics
#:domain #!spw_perspectives
#:form #!probe_battery
#:level #!intro
#:review #!unreviewed
#:valence #!bonk

^"emit"{
 ~#title: "Perspective: Physicists"
 ~#claim: "Test Spw the way you test a model: ask each operator name for its observable, check every quantity for a unit, and look for what the corpus conserves."
 ~#proof: "Every physics homonym in the operator table maps to a short runtime behavior at commit 1aa1dc23, and every registry cell carries a unit string and a source."
 ~#door: "Run the homonym probe on potential first, then try the estimate kit with one water cell."
 ~#audience: "physics students and physicists who sort ideas by invariant"
 continuity: "Perspective: Physicists | its observable"
 cold_open: "Ask each operator name for its observable, and keep only the names that answer."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "persona study doors entry physics and metaphor_limits for physics",
  "runtime dispatch read by the writer at commit 1aa1dc23 on 2026-10-02"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 study agents", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r5"]{
   event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #partial
   note: "forward refs to planned files of other packages that were not yet written: the concept hubs"
  }
 }
 corrections: #[
  "the plan asks this battery to link the concept hubs; see edges to their planned anchors were added on 2026-10-03"
 ]
 links_out: "the concept hubs on conservation, symmetry, and scaling are planned in the same wave; the see edges below name their planned anchors"
}

^["edges"]{
 feeds: [ ~"../doors/caret.spw#spw_door_caret", ~"../contraptions/dimension-bench.spw#spw_lab_dimension_bench", ~"../specimens/math-physics-notation.spw#spw_spec_math_physics" ]
 see: [ ~"../../concepts/conservation.spw#concepts_conservation", ~"../../concepts/symmetry.spw#concepts_symmetry", ~"../../concepts/scaling-and-dimension.spw#concepts_scaling_and_dimension" ]
}

^["standing"]{
 #>spw_perspectives_physics_standing
 ^["hypothesis"]{
  #:claim #!interpretive
  statement: "This battery was written by an agent outside the cluster; it stays unreviewed until a physics student or physicist runs each probe and says which ones match how the field checks a model."
  member_probe: "run the four habit probes on one surface you choose and mark which answer the way a units check or a symmetry argument would"
 }
}

^["battery"]{
 #>spw_perspectives_physics_units
 ^["units"]{
  #:claim #!interpretive
  habit: "a quantity without its unit is not yet a quantity"
  probe: "open any registry cell and find value, unit, conditions, tolerance, and source in its body"
  observable: "the water heat capacity cell carries the unit J/(g K) as a string beside its value"
  reads: %[mateng.water.cp_j_per_g_k]
  sources: [ ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_si_brochure_2019", ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_buckingham_1914" ]
  breaks: "units are strings to the parser, so nothing checks dimensional homogeneity yet; the dimension bench is a proposed contraption"
 }
 #>spw_perspectives_physics_conservation
 ^["conservation"]{
  #:claim #!interpretive
  habit: "find the conserved quantity before trusting a description"
  probe: "ask what the cut keeps fixed across edits"
  observable: "each handle names one cell across the whole cut and each anchor is unique, and the gate fails a second definition of either"
  cites: [ "scripts/analyzers/spw-cut-gate.ts:200-205", "scripts/analyzers/spw-cut-gate.ts:220-226" ]
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_cut_gate"
  breaks: "identity of a name is conserved by rule, not by any dynamics; nothing flows"
 }
 #>spw_perspectives_physics_symmetry
 ^["symmetry"]{
  #:claim #!interpretive
  habit: "a symmetry earns its name by the invariant it protects, as Noether showed for continuous symmetries of an action"
  probe: "for each symmetry word in canon, ask which observable stays unchanged and under which transformation"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_noether_1918"
  breaks: "most geometric words in canon are declared interpretive or exploratory and name no transformation group yet"
 }
 #>spw_perspectives_physics_magnitude
 ^["order_of_magnitude"]{
  #:claim #!interpretive
  habit: "estimate before you calculate, then compare"
  probe: "estimate a quantity from experience, then read the registry cell and compare the powers of ten"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_mahajan_2010"
  breaks: "a say line drops numbers by rule, so the estimate lives in the try kit and the number lives in the cell"
 }
}

^["homonyms"]{
 #>spw_perspectives_physics_homonyms
 ^["runtime_check"]{
  #:claim #!settled
  statement: "At runtime the tilde returns a deferred wrapper, the star writes and returns its first argument, the bang returns its first argument, and the caret returns an integrated wrapper."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_runtime"
  cites: [ "packages/spw-runtime/src/interpreter/interpreter.ts:285-308" ]
 }
 potential: .{ canon: "tilde as potential", observable: "a deferred wrapper", breaks: "no field, gradient, or force, and nothing sums amplitudes" }
 collapse: .{ canon: "star as value or collapse", observable: "writes and returns its first argument", breaks: "deterministic, with no basis and no probabilities" }
 action: .{ canon: "bang as action", observable: "returns its first argument", breaks: "no stationary action and no variation" }
 integration: .{ canon: "caret as ascension or integration", observable: "an integrated wrapper", breaks: "no summation and no measure" }
 resonance: .{ canon: "hash as vibration or resonance", observable: "reduces its arguments and writes a register", breaks: "no frequency and no damping" }
 coupling: .{ canon: "the angle pair as coupling", observable: "a two-way register edge only when the first two operands are string keys", breaks: "no coupling strength and no interaction energy" }
 measure: .{ canon: "percent as measure", observable: "a register value divided by a scale and clamped to the unit interval", breaks: "no additivity over sets, so closer to a grade than a measure" }
 cites: [ "docs/theory/spw/operators.spw:28-42", "docs/theory/spw/operators.spw:46-60" ]
}

^["notation"]{
 #>spw_perspectives_physics_ket
 ^["kets_and_carets"]{
  #:claim #!interpretive
  habit: "Dirac kets, superscripts, and hats are everyday notation"
  spw: "a ket typed bare turns the whole surface into prose, an exponent splits, and a line-end caret takes the next key"
  probe_run: "state: with a ket for psi degraded to prose at 1aa1dc23; area: x^2 split into three siblings"
  sources: [ ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_dirac_1939", ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_seed_grammar" ]
  example: ~"../doors/caret.spw#spw_door_caret_line_end"
 }
}

^["try"]{
 #>spw_perspectives_physics_try
 ^["estimate_then_read"]{
  materials: [ "paper and pencil", "the water cells in the materials and engineering registry" ]
  steps: << "estimate the energy to warm a mug of water by ten degrees, with no lookup" ; "write the estimate as a power of ten" ; "read the heat capacity cell and its unit" ; "multiply mass, cell value, and temperature change" ; "compare the two powers of ten and note which input you guessed worst" >>
  time: .{ n: 15, unit: "minutes" }
  safety: "no hazard worth naming; the kit is pencil and paper"
  shows: ~"./physicists.spw#spw_perspectives_physics_magnitude"
 }
}

#>spw_perspectives_physics_q
?["Which operator name would survive a units check?"]{
 #:depth #!physical ~#lens(scale and dimension)
 #:claim #!speculative
 ~#hypothesis: "Measure survives best, since its runtime output is a dimensionless ratio, while potential and action survive worst, since their runtime output has no quantity at all."
 !probe{ "for each homonym row, write the dimension its physics namesake carries and the dimension its runtime output carries" =id[p_doors_physics_units_check] =kind[thought] }
 $%[mateng.water.cp_j_per_g_k]
 breaks: "a units check needs quantities on both sides; most operators return wrappers, which carry no dimension to compare"
 ~"./physicists.spw#spw_perspectives_physics_homonyms" ~#neighbor(nearest)
}
