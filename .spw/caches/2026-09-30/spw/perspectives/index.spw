# Perspectives
#
# One perspective per practitioner cluster, each a hypothesis written from outside the cluster until a member of that cluster reviews it.

#>spw_perspectives_index
#:layer #!pragmatics
#:domain #!spw_perspectives
#:form #!index
#:level #!intro
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Perspectives"
 ~#claim: "Each practitioner cluster gets one perspective that reads Spw through the notation it already trusts, and each stays a hypothesis until a member reviews it."
 ~#proof: "Twelve perspectives route from this index; every one carries a standing frame that names the member probe that would review it."
 ~#door: "Pick the cluster whose notation you write every day and open only that perspective."
 ~#audience: "practitioners arriving from a field, and writers who route them"
 continuity: "Perspectives | until a member reviews it"
 cold_open: "Each perspective reads Spw through a notation you already trust, and stays a guess until a member reviews it."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "persona study doors and metaphor_limits, one entry per cluster",
  "cut plan gaps row for spw/perspectives"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 study agents", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
  }
  ^["r5"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r6"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the persona study gave each cluster a six- or seven-step path; each perspective here is one surface, and onboarding stays with the fragment doors",
  "the card proof said every perspective opens with its standing frame; each one carries a standing frame with a member probe, placed after its emit card, provenance, and edges frame, and in one file after a scope frame too",
  "the note above first said every cluster path had seven steps; four of the twelve, for mathematicians, linguists, social scientists, and creators, have six"
 ]
}

^["standing"]{
 #>spw_perspectives_index_hypotheses
 ^["hypotheses"]{
  #:claim #!interpretive
  statement: "Every perspective was written by an agent outside its cluster, so each one is a hypothesis about that cluster until a working member runs its member probe."
  member_review: "a review receipt from a cluster member, naming the rows that held and the rows that did not, is what would lift a perspective to expert reviewed"
  fact_check: "the adversarial fact-check of 2026-10-03 tested the facts, probes, and citations in each perspective, not whether a perspective fits how its cluster thinks"
 }
 no_scoring: "no perspective scores, ranks, or logs a reader; a member probe records what the rows got right, not what the member got right"
 one_home: "parse behaviour lives in the specimens and the doors; a perspective links those rows instead of restating them"
}

^["tree"]{
 c_family: ~"./c-family-programmers.spw"
 physicists: ~"./physicists.spw"
 mathematicians: ~"./mathematicians.spw"
 engineers_chemists: ~"./engineers-and-chemists.spw"
 life_clinical: ~"./life-and-clinical-scientists.spw"
 designers: ~"./designers.spw"
 linguists: ~"./linguists.spw"
 social_scientists: ~"./social-scientists.spw"
 librarians: ~"./librarians-and-archivists.spw"
 production_crews: ~"./production-crews.spw"
 creators: ~"./creators-and-streamers.spw"
 educators_community: ~"./educators-and-community.spw"
}

^["gaps"]{
 #>spw_perspectives_index_missing
 ^["missing_clusters"]{
  #:claim #!interpretive
  statement: "Four clusters have no perspective yet: musicians and sound designers, lawyers and policy drafters, game designers, and accessibility practitioners such as screen-reader and plain-language users."
  why_it_matters: "each of these clusters carries a notation of its own, such as chord symbols, section signs, state charts, or punctuation verbosity levels, that could meet Spw marks"
 }
 musicians: "chord symbols and figured bass use the hash, the caret, and the slash; no perspective has probed them"
 lawyers: "statutes cite with section signs and nested parentheses; no perspective has probed them"
 game_designers: "state charts and dialogue trees are close kin of match arms; no perspective has probed them"
 accessibility: "screen readers speak punctuation at configurable verbosity levels; the doors give each mark a spoken name, and no perspective has tested them with a screen-reader user"
}

^["bundle"]{
 ={
  ~"./c-family-programmers.spw#spw_perspectives_c_family"
  ~"./physicists.spw#spw_perspectives_physics"
  ~"./mathematicians.spw#spw_perspectives_mathematicians"
  ~"./engineers-and-chemists.spw#spw_perspectives_engineers"
  ~"./life-and-clinical-scientists.spw#spw_perspectives_life_clinical"
  ~"./designers.spw#spw_perspectives_designers"
  ~"./linguists.spw#spw_perspectives_linguists"
  ~"./social-scientists.spw#spw_perspectives_social"
  ~"./librarians-and-archivists.spw#spw_perspectives_librarians"
  ~"./production-crews.spw#spw_perspectives_crews"
  ~"./creators-and-streamers.spw#spw_perspectives_creators"
  ~"./educators-and-community.spw#spw_perspectives_educators"
 }
}
