^["edges"]{
 needs: [ ~"../../language-and-mind/linguistics/morphology-and-syntax.spw#linguistics_syntax" ]
 feeds: [ ~"../doors/particle.spw#spw_door_particle", ~"../specimens/language-and-library.spw#spw_spec_language_library" ]
 see: [ ~"../theory/particle-lattice.spw#spw_theory_particle_lattice", ~"../glossary/particles.spw#spw_gloss_particles" ]
}

^["standing"]{
 #>spw_perspectives_linguists_standing
 ^["hypothesis"]{
  #:claim #!interpretive
  statement: "These rows were written by an agent outside the cluster; they stay hypotheses until a working linguist checks each category against the literature it cites."
  member_probe: "a linguist marks each row as holds, holds for a named subtype, or fails, and names the closer term the row should have used"
 }
}

^["particles"]{
 #>spw_perspectives_linguists_deixis
 ^["deixis"]{
  #:claim #!interpretive
  category: "deixis, the anchoring of reference in the context of utterance, including discourse deixis to parts of the text itself"
  spw: "hash-greater binds the next node and leaves an anchor that a path ref reaches from any file"
  holds: "discourse deixis: the anchor points at a part of the text, as this chapter or the next point does"
  fails: "the referent never shifts with speaker, place, or time, so cited from elsewhere it works as a coindexed label"
  example: ~"../doors/particle.spw#spw_door_particle_forward"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_levinson_1983"
 }
 #>spw_perspectives_linguists_case
 ^["case"]{
  #:claim #!interpretive
  category: "case, the marking of a dependent noun for the relation it bears to its head"
  spw: "hash-colon names a role, such as claim, depth, or layer, for the node after it"
  holds: "a small mark classifies the role of the next item"
  fails: "no head governs the case and no agreement follows from it, so the label is a classifier rather than case"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_blake_2001"
 }
 #>spw_perspectives_linguists_mood
 ^["mood"]{
  #:claim #!interpretive
  category: "mood, the grammatical marking of a clause for its modality or illocutionary type"
  spw: "hash-bang gives the value of a case, such as settled, speculative, or intro"
  holds: "for claim statuses, which mark how the statement is held"
  fails: "the same aim carries values that are genres, levels, and lenses, so the slot is wider than mood"
  see: ~"../theory/epistemic-status.spw#spw_theory_status_modality"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_palmer_2001"
 }
 #>spw_perspectives_linguists_aspect
 ^["aspect"]{
  #:claim #!interpretive
  category: "aspect, the internal temporal constituency of a situation, such as perfective against imperfective"
  spw: "tilde-hash is the canon aim for aspect, and it still lexes on an older annotation path rather than as a particle token"
  holds: "nothing yet; no aspect value describes the inside of an event"
  fails: "the nearest observable is volatility, how soon content expires, which is closer to stage-level predication than to aspect"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_comrie_1976"
 }
 #>spw_perspectives_linguists_apposition
 ^["apposition"]{
  #:claim #!settled
  statement: "Canon chose the name apposition for its parenthesized readings and records gloss and aside as names it considered and rejected."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_canon_apposition"
  cites: [ "docs/theory/spw/apposition.spw:28-33", "docs/theory/spw/apposition.spw:50-53" ]
  label: "a-canon naming record"
  reading: "most readings are supplements beside a host rather than coreferential appositives, and nothing checks that a host exists"
 }
 #>spw_perspectives_linguists_valency
 ^["valency"]{
  #:claim #!interpretive
  category: "valency, the number and kind of arguments a verb takes, after Tesniere"
  spw: "valence names five material qualities of a surface and counts nothing"
  fails: "a linguist will read valence as valency, so the word needs its own gloss on first use"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_tesniere_1959"
 }
}

^["glossing"]{
 #>spw_perspectives_linguists_gloss
 ^["interlinear"]{
  #:claim #!settled
  statement: "A named gloss reading takes its body raw to the matching parenthesis, so morpheme boundaries, digits, and category labels survive inside it untouched."
  probe_run: "q: ~#gloss(1SG-see) gave one named gloss reading with body 1SG-see at 1aa1dc23"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_seed_lexer"
  convention: "the Leipzig rules separate morphemes with a hyphen, clitics with an equals sign, and fused categories with a period"
  convention_source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_leipzig_2015"
  outside_reading: [ ~"../specimens/language-and-library.spw#spw_spec_language_library_morpheme_boundary", ~"../specimens/language-and-library.spw#spw_spec_language_library_clitic_boundary" ]
 }
}

^["lineage"]{
 #>spw_perspectives_linguists_panini
 ^["indicatory_markers"]{
  #:claim #!settled
  statement: "The grammar of Sanskrit ascribed to Panini attaches unpronounced indicatory markers to roots and affixes to signal how rules apply, and names participant roles as karaka relations."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_cardona_1988"
  reading: "the oldest well-documented precedent for small marks that change how the next item is read, and for role labels that are not case endings"
  breaks: "an indicatory marker is part of a generative rule system, while a Spw particle labels a node and drives no derivation"
 }
}

^["varieties"]{
 #>spw_perspectives_linguists_naming
 ^["naming_as_data"]{
  #:claim #!interpretive
  statement: "The disagreement among the repository naming tables reads as variety data: several names for one mark, recorded with file and line like a dialect survey."
  example: ~"../glossary/operators.spw#spw_gloss_op_naming"
  breaks: "dialect variants spread through communities of speakers, while Spw variants come from one owner editing files over time"
 }
 #>spw_perspectives_linguists_layers
 ^["layer_names"]{
  #:claim #!settled
  statement: "The cut layer axis uses pragmatics for how-to and protocol surfaces and semantics for theory of the language, which are not the subfields those words name in linguistics."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_cut_vocabulary"
  label: "a-cut vocabulary gloss"
 }
}

^["tools"]{
 lattice: .{ command: "spw lattice", use: "count named and anonymous readings across a corpus", status: #implemented, cites: "packages/spw-cli/src/commands.ts:217-223" }
 igt_aligner: .{ contraption: "igt-aligner", use: "check that gloss words line up with source words", status: #proposed }
 operator_authority: .{ contraption: "operator-authority", use: "tabulate mark names by table", status: #proposed }
}

^["try"]{
 #>spw_perspectives_linguists_try
 ^["gloss_as_reading"]{
  materials: [ "one sentence from a published grammar, with its author and page", "a scratch file outside the cut", "the spw CLI in this repository" ]
  steps: << "write the source line as a quoted string" ; "write the morpheme gloss inside a named gloss reading" ; "write the free translation as a quoted string" ; "run spw lattice on the scratch file" ; "find your gloss among the named readings it counts" >>
  time: .{ n: 20, unit: "minutes" }
  safety: "use published examples with credit; for community languages use only examples the community has published or agreed to share"
  shows: ~"./linguists.spw#spw_perspectives_linguists_gloss"
 }
}

#>spw_perspectives_linguists_q
?["Would a dialect survey of Spw mark names find isoglosses or one editing history?"]{
 #:depth #!historical ~#lens(historical layer)
 #:claim #!speculative
 ~#hypothesis: "It would find one editing history, since each variant name traces to revisions by one owner rather than to separate groups of writers."
 !probe{ "date each variant name in the naming tables from the commit history and plot the variants by file and date" =id[p_doors_linguists_isoglosses] =kind[lookup] }
 breaks: "an isogloss marks the edge of a speech community, while a Spw variant marks a revision"
 ~"./linguists.spw#spw_perspectives_linguists_naming" ~#neighbor(nearest)
}
