# Perspective: Linguists
#
# Particles read as morphemes for deixis, case, mood, aspect, and apposition; operators read through syntax and pragmatics; and the drifting names of Spw marks read as variety data.

#>spw_perspectives_linguists
#:layer #!pragmatics
#:domain #!spw_perspectives
#:form #!glossary
#:level #!intro
#:review #!adversarial_checked
#:valence #!bonk

^"emit"{
 ~#title: "Perspective: Linguists"
 ~#claim: "Spw borrows the names of grammatical categories for its particles, and each borrowing holds for one property and fails for another: deixis binds, case has no head, and mood mixes status with genre."
 ~#proof: "Each row names the category source, the observable particle behavior at commit 1aa1dc23, and where the analogy stops."
 ~#door: "Read the deixis row, then write one interlinear gloss as a reading and count it with spw lattice."
 ~#audience: "linguists, language teachers, and documentary fieldworkers"
 continuity: "Perspective: Linguists | each borrowing holds"
 cold_open: "Spw names its particles after grammar, and each borrowing holds for one property and fails for another."
}

