# Perspective: Creators and Streamers
#
# Show notes, live capture, and chat lanes for authors, podcasters, and live streamers, with paste safety first and every person who appears written as a synthetic handle or a role.

#>spw_perspectives_creators
#:layer #!pragmatics
#:domain #!spw_perspectives
#:form #!protocol
#:level #!intro
#:review #!adversarial_checked
#:valence #!honk

^"emit"{
 ~#title: "Perspective: Creators and Streamers"
 ~#claim: "A creator mostly pastes: chat, captions, and Markdown notes; much of that fails without a word, so quote what a person typed and give every handle a synthetic name first."
 ~#proof: "Specimen probes at commit 1aa1dc23 drop a Markdown heading, turn a blockquote or a spoiler to prose, and make a bare handle into a graph node."
 ~#door: "Run the paste test with a synthetic chat transcript, then read the handles row."
 ~#audience: "authors, podcasters, video makers, and live streamers who keep show notes"
 continuity: "Perspective: Creators and Streamers | quote what a person typed"
 cold_open: "Quote what a person typed, and give every handle a synthetic name before it reaches the file."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "persona study doors entry creators and metaphor_limits for creators and media",
  "the streaming hypothesis in making/streaming/spw-for-streamers.spw, which links this file",
  "paste rows in the media and classroom specimens, read by the writer on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 study agents", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
  }
  ^["r5"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r6"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r7"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
  }
  ^["r8"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the study door treated platform coins and diamonds as metric units; platform currencies are set by policy, so they are left out here rather than carried without a dated source"
 ]
}

^["edges"]{
 needs: [ ~"../../making/streaming/spw-for-streamers.spw#streaming_spw_for_streamers" ]
 feeds: [ ~"../doors/at.spw#spw_door_at", ~"../doors/hash.spw#spw_door_hash" ]
 see: [ ~"../specimens/media-and-classroom.spw#spw_spec_media_classroom", ~"../../making/streaming/chat-torrent-pipeline.spw#streaming_chat_torrent" ]
}

^["standing"]{
 #>spw_perspectives_creators_standing
 ^["hypothesis"]{
  #:claim #!interpretive
  statement: "This protocol was written by an agent outside the cluster; it stays a hypothesis until a working creator keeps one show file through it and says what got in the way."
  member_probe: "a creator converts one episode of their own show notes, with every person replaced by a role or a synthetic handle, and marks each step as useful or not"
 }
}

^["paste_safety"]{
 #>spw_perspectives_creators_paste
 ^["silent_paste"]{
  #:claim #!settled
  statement: "Pasted Markdown and chat fail in two ways: a heading or a URL loses text with no warning, while a blockquote, a spoiler bar, or a smiley turns the whole surface to prose."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_seed_lexer"
  rows: [ ~"../specimens/media-and-classroom.spw#spw_spec_media_classroom_heading", ~"../specimens/media-and-classroom.spw#spw_spec_media_classroom_url" ]
  loud_rows: [ ~"../specimens/media-and-classroom.spw#spw_spec_media_classroom_blockquote", ~"../specimens/media-and-classroom.spw#spw_spec_media_classroom_spoiler" ]
  markdown: "CommonMark uses a hash and a space for a heading and a greater-than sign for a blockquote, the two marks that fail here"
  markdown_source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_commonmark_0312"
 }
 rule: "quote what a person typed: chat lines, captions, titles, and anything with an apostrophe, an emoji, or curly quotes"
 hashtags: .{ habit: "a hashtag", note: "a case-sensitive tag, so two spellings are two tags", see: ~"../specimens/media-and-classroom.spw#spw_spec_media_classroom_hashtag" }
 emoji: .{ habit: "an emoji value", note: "lexer errors that can empty a binding", see: ~"../specimens/media-and-classroom.spw#spw_spec_media_classroom_emoji" }
 typography: .{ habit: "curly quotes and dashes from a word processor", see: ~"../specimens/media-and-classroom.spw#spw_spec_media_classroom_curly_quotes" }
}

^["handles"]{
 #>spw_perspectives_creators_handles
 ^["names_become_nodes"]{
  #:claim #!settled
  statement: "A handle typed with an at sign becomes a reference node in the graph and notifies no one, so a real handle in a file would put that person into every tool that reads it."
  example: ~"../doors/at.spw#spw_door_at_chat"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_seed_grammar"
 }
 #>spw_perspectives_creators_pseudonyms
 ^["pseudonym_protocol"]{
  #:claim #!interpretive
  statement: "Pseudonymization is a protocol, not a dataset: replace each handle with a synthetic one before anything is written, keep no mapping in the file, and write hosts and guests as roles."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_cut_contract"
  steps: << "replace each handle with viewer_a, viewer_b, and so on" ; "drop any detail that could identify a viewer" ; "write the host and guests as roles" ; "keep no table that maps synthetic names back" >>
  limits: "a keyed hash still points at one person for anyone holding the key, so it is pseudonymous, not anonymous"
  see: ~"../../making/streaming/chat-torrent-pipeline.spw#streaming_chat_torrent_still_personal"
 }
}

^["protocol"]{
 #>spw_perspectives_creators_show_notes
 ^["show_notes"]{
  #:claim #!interpretive
  statement: "Show notes already have the shape of a surface: a title, segments as frames, recurring bits as anchored frames, links as quoted URLs, and timestamps as quoted strings."
  example: ~"../../making/streaming/spw-for-streamers.spw#streaming_spw_for_streamers_preshow"
  breaks: "a show has a clock and an audience, while the file has neither; it records the plan and what happened"
 }
 #>spw_perspectives_creators_live
 ^["live_capture"]{
  #:claim #!interpretive
  statement: "During a live show the host or a moderator appends topics, never people, to a few named lanes, and the full file stays the record after the show."
  example: ~"../../making/streaming/spw-for-streamers.spw#streaming_spw_for_streamers_board"
  breaks: "chat is not a sample of the audience, so lane counts describe who typed, not who watched"
 }
 #>spw_perspectives_creators_metrics
 ^["platform_metrics"]{
  #:claim #!interpretive
  statement: "Platform metrics are defined by platform policy and can change, so any metric that enters the cut needs a registry cell with as_of and the policy version it was read under."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_cut_contract"
  breaks: "a count of viewers or gifts has no physical dimension, so a unit string names a policy, not a quantity"
 }
 phases: << "outline the show" ; "quote and pseudonymize before pasting" ; "append topics to lanes live" ; "reduce the file to a brief card after" ; "keep the full file as the record" >>
}

^["first_users"]{
 #>spw_perspectives_creators_first_users
 ^["streamers_first"]{
  #:claim #!speculative
  statement: "Live streamers may be among the first everyday Spw users, since a show already has segments, recurring bits, and audience questions that frames can hold."
  home: ~"../../making/streaming/spw-for-streamers.spw#streaming_spw_for_streamers_first_users"
 }
 #>spw_perspectives_creators_session_log
 ^["what_a_log_would_test"]{
  #:claim #!interpretive
  statement: "A session log would test the hypothesis by recording which frames the host edited during the show and which bits later shows linked, and nothing about any viewer."
  status: #proposed
  records: "frame names, edit times, and links between show files"
  never: "viewer handles, message text, watch time, or any score of the host"
 }
}

^["tools"]{
 outline: .{ command: "spw outline", use: "frame landmarks of a show file", status: #implemented, cites: "packages/spw-cli/src/commands.ts:338-343" }
 emit: .{ command: "spw emit pack with the brief host", use: "a short card after the show", status: #implemented, cites: "packages/spw-cli/src/commands.ts:397-402" }
 session_log: .{ mode: "a log of frame edits during a show", status: #proposed }
 field_beat: .{ contraption: "field-beat", use: "decay and inject beats over a run sheet", status: #proposed }
}

^["try"]{
 #>spw_perspectives_creators_try
 ^["paste_test"]{
  materials: [ "a synthetic chat transcript you invent, with handles viewer_a to viewer_c", "a scratch file outside the cut", "the spw CLI in this repository" ]
  steps: << "paste the transcript bare" ; "predict which lines survive" ; "reveal them with spw inspect source" ; "quote each line and keep the synthetic handles inside the quotes" ; "reveal again and compare" >>
  time: .{ n: 15, unit: "minutes" }
  safety: "never paste real chat or real handles; a transcript of real viewers is personal data"
  shows: ~"./creators-and-streamers.spw#spw_perspectives_creators_paste"
 }
}

#>spw_perspectives_creators_q
?["Which paste failure does a creator meet first and notice last?"]{
 #:depth #!experiential ~#lens(information flow)
 #:claim #!speculative
 ~#hypothesis: "A dropped Markdown heading is met first and noticed last, because the file still parses, the editor still colors it, and nothing announces the missing text."
 !probe{ "paste one synthetic page of show notes, list what you think vanished, then check your list against the parse" =id[p_doors_creators_first_failure] =kind[thought] }
 breaks: "a chat client shows the message as sent, while the parser shows nothing about what it dropped"
 ~"./creators-and-streamers.spw#spw_perspectives_creators_paste" ~#neighbor(nearest)
}
