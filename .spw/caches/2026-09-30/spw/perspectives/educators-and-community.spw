# Perspective: Educators and Community
#
# Lesson sequences, rubrics, and community facilitation read as ladders and kits, with a spoken name for every mark and every person written as a role or a count, never a private name.

#>spw_perspectives_educators
#:layer #!pragmatics
#:domain #!spw_perspectives
#:form #!curriculum
#:level #!intro
#:review #!unreviewed
#:valence #!boon

^"emit"{
 ~#title: "Perspective: Educators and Community"
 ~#claim: "A teacher judges a notation by whether it can be read aloud, translated, and kept private; Spw gives every mark a spoken name, keeps rubric levels as words, and writes people as roles."
 ~#proof: "The voice surface pairs each mark with a spoken name, the percent door shows why a rubric score typed as a percent splits, and the contract bars private names."
 ~#door: "Read one door aloud with your class using its spoken names, then open the water lesson ladder."
 ~#audience: "teachers, librarians who teach, youth workers, and community organizers"
 continuity: "Perspective: Educators and Community | read aloud"
 cold_open: "A notation earns a classroom when it can be read aloud, so every mark here has a spoken name."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "persona study doors entry educators_community and metaphor_limits for education and community organizing",
  "the water exemplar try kit and wonder, read only"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 study agents", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the study proposed community minutes, volunteer, and story files of its own; this perspective keeps the facilitation rows as roles and counts and links the interview protocol for collection"
 ]
}

^["edges"]{
 needs: [ ~"../../learning/intergenerational-kit/interview-protocol.spw#generations_kit_interview" ]
 feeds: [ ~"../doors/wonder.spw#spw_door_wonder", ~"../doors/percent.spw#spw_door_percent" ]
 see: [ ~"../voice.spw#spw_voice_spoken_names", ~"../../physical/materials/water.spw#materials_water_try_density" ]
}

^["standing"]{
 #>spw_perspectives_educators_standing
 ^["hypothesis"]{
  #:claim #!interpretive
  statement: "This curriculum was written by an agent outside the cluster; it stays unreviewed until a working teacher or organizer runs one rung with a group and reports what the group could do."
  member_probe: "a teacher runs the read-aloud kit once and reports which marks the group could say and which it could not, never which people"
 }
 no_logging: "no rung, kit, or wonder here ranks, scores, or logs a learner; a tally counts marks or questions, never people"
}

^["spoken"]{
 #>spw_perspectives_educators_spoken
 ^["read_aloud"]{
  #:claim #!interpretive
  statement: "A surface a class can read aloud is one a class can share, so each mark needs a spoken name before it needs a definition."
  names_home: ~"../voice.spw#spw_voice_spoken_names"
  example: ~"../doors/hash.spw#spw_door_hash_drop"
  gap: "the spoken names are English words; a class reading in another language needs names of its own, and no surface offers them yet"
 }
}

^["ladder"]{
 #>spw_perspectives_educators_spiral
 ^["spiral"]{
  #:claim #!settled
  statement: "Bruner proposed that any subject can be taught in some intellectually honest form at any stage, and that a curriculum should return to its central ideas at rising depth."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_bruner_1960"
  breaks: "a needs edge between rungs is a claim about learners in general, not about any one learner"
 }
 ^["water_lesson"]{
  #>spw_perspectives_educators_rung_hands
  ^["rung_hands"]{ do: "run the layered glass kit", link: ~"../../physical/materials/water.spw#materials_water_try_density" }
  #>spw_perspectives_educators_rung_say
  ^["rung_say"]{ do: "say aloud what the glass showed, in one breath", needs: ~"./educators-and-community.spw#spw_perspectives_educators_rung_hands" }
  #>spw_perspectives_educators_rung_claim
  ^["rung_claim"]{ do: "read the density claim and name its status, source, and limits", link: ~"../../physical/materials/water.spw#materials_water_density_max" }
  #>spw_perspectives_educators_rung_wonder
  ^["rung_wonder"]{ do: "ask the sinking-ice question and name an instrument", link: ~"../../physical/materials/water.spw#materials_water_ice_sink_q" }
  order: << "hands" ; "say" ; "claim" ; "wonder" >>
  return: "a later lesson returns to density through a different material, so the spiral rises"
  ~#(a lesson ladder that uses the water exemplar, hands before claims)
 }
}

^["rubrics"]{
 #>spw_perspectives_educators_rubric
 ^["rubric_levels"]{
  #:claim #!settled
  statement: "Brookhart describes a rubric as a coherent set of criteria for student work with descriptions of performance at each level of quality."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_brookhart_2013"
 }
 #>spw_perspectives_educators_ordinal
 ^["levels_as_words"]{
  #:claim #!interpretive
  statement: "Rubric levels are ordered descriptions, so they belong in Spw as quoted level words under each criterion, not as percents or decimals that assert equal spacing."
  example: ~"../doors/percent.spw#spw_door_percent_q"
  see: ~"../theory/measures-and-handles.spw#spw_theory_measures_scale_types"
  shape: "criterion frames, each holding one quoted description per level"
 }
}

^["facilitation"]{
 #>spw_perspectives_educators_popular
 ^["popular_education"]{
  #:claim #!settled
  statement: "Horton and Freire describe popular education that begins from what participants already know and builds toward action they choose together."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_horton_freire_1990"
  see: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_freire_1970"
  origins: "Horton co-founded the Highlander Folk School in Tennessee, and Freire worked on adult literacy in northeast Brazil; both traditions start from community knowledge"
 }
 #>spw_perspectives_educators_roles
 ^["roles_and_counts"]{
  #:claim #!settled
  statement: "This cut names public figures and published authors only, so a meeting record written here keeps roles and vote counts and never a private name."
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_cut_contract"
  label: "a-cut rule from the contract ethics frame"
  shape: "a meeting frame with chair, note taker, and member roles, and motions with for, against, and abstain counts"
 }
 #>spw_perspectives_educators_collection
 ^["community_collection"]{
  #:claim #!interpretive
  statement: "Student collection of community knowledge, as in Foxfire, enters through the interview protocol, which puts consent first and keeps the teller in control of sharing."
  example: ~"../../learning/intergenerational-kit/interview-protocol.spw#generations_kit_origin_foxfire"
  source: ~"../../registries/sources/spw-doors-perspectives.spw#src_doors_wigginton_1972"
  breaks: "a shared word in two stories is not a shared meaning, and only the teller can say which"
 }
}

^["tools"]{
 outline: .{ command: "spw outline", use: "print frame landmarks as a lesson handout skeleton", status: #implemented, cites: "packages/spw-cli/src/commands.ts:338-343" }
 expand: .{ command: "spw expand", use: "print an index with its children digests as one packet", status: #implemented, cites: "packages/spw-cli/src/commands.ts:368-373" }
 rubric_lens: .{ contraption: "rubric-lens", use: "show how three aggregation rules rank the same profiles", status: #proposed }
 grid_gap_finder: .{ contraption: "grid-gap-finder", use: "find holes in a scope grid as invitations", status: #proposed }
}

^["try"]{
 #>spw_perspectives_educators_try
 ^["read_aloud_kit"]{
  materials: [ "one printed fragment door", "the spoken names from the voice surface", "a board or a sheet for a tally of marks" ]
  steps: << "hand out the door and the spoken names" ; "read it aloud together once" ; "tally each mark where the group hesitated" ; "agree a name for any mark that had none" ; "read it aloud again" >>
  time: .{ n: 20, unit: "minutes" }
  safety: "no recording and no names; the tally counts marks, never students"
  shows: ~"./educators-and-community.spw#spw_perspectives_educators_spoken"
 }
}

#>spw_perspectives_educators_q
?["Where does a class hesitate when it reads a surface aloud?"]{
 #:depth #!educational ~#lens(bodily rhythm)
 #:claim #!speculative
 ~#hypothesis: "A class hesitates most at marks made of two glyphs, such as the particles, and least at marks it already names, such as the colon and the question mark."
 !probe{ "read one door aloud with a group twice and tally hesitations by mark, never by person" =id[p_doors_educators_read_aloud] =kind[field] }
 breaks: "spoken mathematics carries conventions a class already shares, while these spoken names are new and owned by one project"
 ~"./educators-and-community.spw#spw_perspectives_educators_spoken" ~#neighbor(nearest)
}
