# Plugin Theory
#
# What an editor plugin is for, read from verified host rows: the server knows the language, the host paints it, and every defect, stale canon line, and next feature tests that split.

#>spw_plugin_theory
#:layer #!semantics
#:domain #!spw
#:form #!ledger
#:level #!practitioner
#:review #!spot_checked
#:valence #!bane

^"emit"{
 ~#title: "Plugin Theory"
 ~#claim: "A Spw plugin paints what the server knows and the page does not already show; each verified defect is a place where a plugin read Spw on its own."
 ~#proof: "Seven plugin defects in the hosts ledger sit in client code, and the VS Code canon forbids a second editor-only semantics stack."
 ~#door: "Open one defect row, then the canon line it breaks, and write what the plugin should have asked the server."
 ~#audience: "plugin authors and reviewers of the VS Code and JetBrains extensions"
 continuity: "Plugin Theory | the server knows"
 cold_open: "The server knows the language and the plugin paints it; every defect here is a plugin reading on its own."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "host claim anchors in spw/hosts at 1aa1dc23, written by the hosts package on 2026-10-02",
  "canon lines and extension manifests re-read by the writer on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the raw editor caches invented settings, URIs, and fallbacks; this ledger reads only host rows that cite code at a commit",
  "the anti-echo doctrine is credited to the raw VS Code taste file and stays a proposal until canon adopts it"
 ]
}

^["edges"]{
 needs: [ ~"./hosts/known-defects.spw#editor_hosts_defects" ]
 grounds: [ ~".spw/tooling/vscode-spw.spw#spw_tooling_vscode", ~".spw/tooling/intellij-plugin.spw#spw_tooling_intellij" ]
 see: [ ~"./hosts/index.spw#editor_hosts_index", ~"./tokens-and-roles.spw#spw_tokens_and_roles" ]
}

^["concepts"]{
 primary: [ #host_renders, #server_knows ]
 transfers: [ #anti_echo ], tensions: [ #editor_only_semantics ]
}

^["purpose"]{
 #>spw_plugin_split
 ^["host_renders_server_knows"]{
  #:claim #!settled
  statement: "The VS Code canon says contributions complement the server and must not fork semantic meaning into a second editor-only semantics stack."
  source: ~"../registries/sources/spw-branch.spw#src_spw_canon_tooling"
  cites: [ ".spw/tooling/vscode-spw.spw:108" ]
  label: "a-canon"
 }
 #>spw_plugin_markers
 ^["markers_navigate"]{
  #:claim #!settled
  statement: "The IntelliJ canon says a gutter marker is not navigation unless it exposes a working target action."
  source: ~"../registries/sources/spw-branch.spw#src_spw_canon_tooling"
  cites: [ ".spw/tooling/intellij-plugin.spw:50" ]
  label: "a-canon"
 }
 #>spw_plugin_anti_echo
 ^["anti_echo"]{
  #:claim #!interpretive
  statement: "A host earns screen space by showing what the page does not already show: a resolved target, a status, or a count from elsewhere."
  source: ~"../registries/sources/spw-branch.spw#src_spw_study_scorecard"
  row: ~"./hosts/index.spw#editor_hosts_index_anti_echo"
  status: #proposed
 }
}

^["inventory"]{
 note: "counts live in the host rows; this ledger reads what each says a plugin is for"

 #>spw_plugin_vscode_count
 ^["vscode_contributions"]{
  #:claim #!settled
  statement: "The VS Code extension contributes twenty-two commands, fourteen settings, and twenty-three color ids."
  reads: %[spw.editor.color_ids]
  source: ~"../registries/sources/spw-branch.spw#src_spw_vscode"
  probe_run: "count of contributes in extensions/vscode-spw/package.json at 1aa1dc23 on 2026-10-03"
  row: ~"./hosts/vscode-commands-and-views.spw#editor_hosts_vscode_command_count"
 }
 ^["rows"]{
  server_methods: ~"./hosts/lsp-surface.spw#editor_hosts_lsp_methods"
  jetbrains_actions: ~"./hosts/jetbrains-native-features.spw#editor_hosts_jetbrains_native_actions"
  parity: ~"./hosts/host-parity-matrix.spw#editor_hosts_parity"
  reading: "a host calls fewer server methods than the server answers, and JetBrains calls none of the custom ones"
 }
}

^["defects"]{
 #>spw_plugin_defects_client
 ^["all_client_side"]{
  #:claim #!interpretive
  statement: "All seven verified plugin defects sit in client glue or client regexes, so a plugin fails where it reads Spw or rebuilds a server answer on its own."
  source: ~"../registries/sources/spw-branch.spw#src_spw_study_scorecard"
  rows: ~"./hosts/known-defects.spw#editor_hosts_defects"
 }
 ^["ledger"]{
  d1: .{ row: ~"./hosts/known-defects.spw#editor_hosts_defects_d1", lesson: "never rebuild a server card in the client" }
  d2: .{ row: ~"./hosts/known-defects.spw#editor_hosts_defects_d2", lesson: "a setting must reach the server it names" }
  d3: .{ row: ~"./hosts/known-defects.spw#editor_hosts_defects_d3", lesson: "a fold builder that guesses comments diverges from the lexer" }
  d4: .{ row: ~"./hosts/known-defects.spw#editor_hosts_defects_d4", lesson: "one comment form across hosts" }
  d5: .{ row: ~"./hosts/known-defects.spw#editor_hosts_defects_d5", lesson: "prose in strings deserves a spellcheck" }
  d6: .{ row: ~"./hosts/known-defects.spw#editor_hosts_defects_d6", lesson: "a marker must navigate" }
  d7: .{ row: ~"./hosts/known-defects.spw#editor_hosts_defects_d7", lesson: "a receipt opens read-only" }
 }
 server_gaps: [
  ~"./hosts/known-defects.spw#editor_hosts_defects_anchor_line",
  ~"./hosts/known-defects.spw#editor_hosts_defects_lens_index"
 ]
}

^["stale_canon"]{
 #>spw_plugin_stale_startup
 ^["startup"]{
  #:claim #!settled
  statement: "VS Code canon says startup resolves the server from five places, while the extension README says it uses only its bundled server."
  source: ~"../registries/sources/spw-branch.spw#src_spw_canon_tooling"
  cites: [ ".spw/tooling/vscode-spw.spw:22", "extensions/vscode-spw/README.md:28" ]
  row: ~"./hosts/known-defects.spw#editor_hosts_defects_stale_startup"
 }
 #>spw_plugin_stale_atlas
 ^["atlas"]{
  #:claim #!settled
  statement: "VS Code canon lists projections among the workspace atlas sections, which the view does not build."
  source: ~"../registries/sources/spw-branch.spw#src_spw_canon_tooling"
  cites: [ ".spw/tooling/vscode-spw.spw:46" ]
  row: ~"./hosts/known-defects.spw#editor_hosts_defects_stale_atlas"
 }
}

^["next"]{
 note: "each feature names its plan card in the radar; this ledger orders them by what the split asks for first"
 order: << "publish lexer errors from the server" ; "one execute command so lenses act in every host" ; "settings that apply without a restart" ; "custom token types from a parse-derived role stream" >>
 rows: [
  ~"./hosts/lsp-surface.spw#editor_hosts_lsp_diagnostics_gate",
  ~"./hosts/feature-radar.spw#editor_hosts_radar_execute",
  ~"./hosts/feature-radar.spw#editor_hosts_radar_config",
  ~"./hosts/feature-radar.spw#editor_hosts_radar_custom_types"
 ]
 status: #proposed
 hold: ~"./hosts/feature-radar.spw#editor_hosts_radar_hold"
}

^["promote"]{
 rule: "a promote row names a source anchor, a target, and the evidence; the owner decides, and nothing here edits canon"

 #>spw_plugin_promote_instruments
 ^["instruments"]{
  source_anchor: ~"./hosts/jetbrains-instruments.spw#editor_hosts_jetbrains_instruments"
  target: ~".spw/tooling/intellij-plugin.spw#spw_tooling_intellij"
  evidence: "instruments refuse a dirty buffer, run the CLI on the saved file, and open a read-only file; discovery runs in two stages"
 }
 #>spw_plugin_promote_anti_echo
 ^["anti_echo"]{
  source_anchor: ~"./hosts/index.spw#editor_hosts_index_anti_echo"
  target: ~".spw/tooling/vscode-spw.spw#spw_tooling_vscode"
  evidence: "add the anti-echo doctrine, host renders and server knows, to the quality bar frame"
 }
 #>spw_plugin_promote_startup
 ^["startup"]{
  source_anchor: ~"./plugin-theory.spw#spw_plugin_stale_startup"
  target: ~".spw/tooling/vscode-spw.spw#spw_tooling_vscode"
  evidence: "replace the five-place startup line with the bundled-server rule the README states"
 }
}

^["try"]{
 #>spw_plugin_try_ask
 ^["ask_the_server"]{
  materials: [ "the known-defects host surface", "the lsp-surface host surface", "a notebook you keep" ]
  steps: << "pick one defect row" ; "find the server method or token that already holds the answer" ; "write the one call the plugin should make instead" ; "mark whether that method exists today" >>
  time: .{ n: 20, unit: "minutes" }
  safety: "none worth naming; you only read surfaces"
  shows: ~"./plugin-theory.spw#spw_plugin_defects_client"
 }
}

#>spw_plugin_echo_q
?["Would an instrument that prints its equivalent spw command teach readers the canonical names?"]{
 #:depth #!educational ~#lens(signal path)
 #:claim #!speculative
 ~#hypothesis: "Readers who see the equivalent command beside each instrument result name more commands by their canonical names a week later."
 !probe{ "two consenting groups use the instruments for a week, one with the command printed, then each lists the commands it remembers" =id[p_spw_plugin_echo] =kind[interview] }
 $%[spw.cli.commands]
 ~"./plugin-theory.spw#spw_plugin_anti_echo" ~#neighbor(nearest)
}
