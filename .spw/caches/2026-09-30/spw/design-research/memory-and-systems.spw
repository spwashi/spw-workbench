# Memory and Systems
#
# Who frees memory and when the rule is checked: Rust ownership, Zig allocators and comptime, defer in Zig and Go, C++ RAII, and arenas and regions.

#>lang_design_memory
#:layer #!reference
#:domain #!lang_design
#:form #!comparison
#:level #!advanced
#:review #!sourced
#:valence #!bone

^"emit"{
 ~#title: "Memory and Systems"
 ~#claim: "Systems languages differ in who decides when memory is freed: the owner in Rust, the scope in C++ and Zig defer, the arena in region schemes, and the caller in Zig."
 ~#proof: "Rows cite the Rust book, the Zig 0.14.0 reference and release notes, the Go specification, Stroustrup, Hanson, and Tofte and Talpin."
 ~#door: "Read the who-frees column, then the Zig allocator correction, then the retention question at the end."
 ~#audience: "language designers and Spw readers coming from systems programming"
 continuity: "Memory and Systems | who decides when memory is freed"
 cold_open: "Each systems language answers one question differently: who decides when memory is freed."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/language-features/systems-and-memory.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "Zig 0.14.0 renamed GeneralPurposeAllocator to DebugAllocator; the raw file used the old name",
  "the raw file said a Zig function without an allocator parameter is guaranteed not to allocate; that is a convention, and code can still reach a global allocator",
  "the raw invariant that explicit memory parameters guarantee zero heap allocation is refuted for the same reason",
  "claims of output equal to hand-tuned C and of stack traces preserved by error values had no source and are dropped"
 ]
}

