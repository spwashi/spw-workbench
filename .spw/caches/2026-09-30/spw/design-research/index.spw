^["order"]{
 reading: << "mark matrix" ; "pipelines and stacks" ; "macros" ; "types" ; "memory" ; "feature lineage" ; "script architectures" >>
}

^["rule"]{
 #>lang_design_index_raw_rule
 ^["raw_as_lineage"]{
  #:claim #!interpretive
  statement: "The raw language-feature caches appear here only as lineage strings; every corrected claim cites a language reference, a paper, or the repository at a pinned commit."
 }
 promote: "a design amendment for canon leaves through the open-questions promote queue, never by editing these files"
}

^["gaps"]{
 concurrency: "actor models and supervision trees from the raw generation are not carried; no surface here covers concurrency"
 pattern_matching: "multi-clause pattern matching is not compared yet"
}
