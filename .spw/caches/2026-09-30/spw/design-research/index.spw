}

^["bundle"]{
 ={
  ~"./spw-position-matrix.spw#lang_design_spw_position"
  ~"./pipelines-and-stacks.spw#lang_design_pipelines"
  ~"./macros-and-homoiconicity.spw#lang_design_macros"
