# Language Design Research
#
# Seven comparisons that set Spw beside other languages: macros, memory, types, pipelines, the mark matrix, the feature lineage, and the registry of script architectures this cut uses.

#>lang_design_index
#:layer #!reference
#:domain #!lang_design
#:form #!index
#:level #!advanced
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Language Design Research"
 ~#claim: "Seven comparisons read Spw against other languages, each correcting what the raw generation got wrong and citing the language reference that settles it."
 ~#proof: "Every row cites a named reference or paper, and Spw rows cite canon or the seed at commit 1aa1dc23."
 ~#door: "Start with the mark matrix, then the pipeline directions, then the lineage."
 ~#audience: "language designers and Spw readers who arrive knowing another language"
 continuity: "Language Design Research | read Spw against other languages"
 cold_open: "Seven comparisons read Spw against other languages and fix what the first generation got wrong."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
  }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["tree"]{
 marks: ~"./spw-position-matrix.spw"
 pipelines: ~"./pipelines-and-stacks.spw"
 macros: ~"./macros-and-homoiconicity.spw"
 memory: ~"./memory-and-systems.spw"
 types: ~"./type-systems.spw"
 lineage: ~"./feature-lineage.spw"
