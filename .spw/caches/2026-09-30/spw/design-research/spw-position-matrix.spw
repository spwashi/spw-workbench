# Spw Position Matrix
#
# Every Spw mark, including the hash and the dot, set against what the same mark means in C, the shell, Rust, Python, Lisp, and Markdown, with the canon reader name, the naming split, and the retired terms marked.

#>lang_design_spw_position
#:layer #!semantics
#:domain #!lang_design
#:form #!comparison
#:level #!advanced
#:review #!sourced
#:valence #!bonk

^"emit"{
 ~#title: "Spw Position Matrix"
 ~#claim: "Most Spw marks borrow a shape readers know from C, the shell, or Markdown while meaning something else, and canon names all thirteen, though code tables split six."
 ~#proof: "Family meanings cite K&R, POSIX, the Rust book, PEP 318, the HyperSpec, and CommonMark; Spw names cite operators.spw and four code and registry tables at 1aa1dc23."
 ~#door: "Find a mark you already type, read its family column, then follow its glossary link for the spoken name."
 ~#audience: "programmers and writers meeting Spw marks with habits from another language"
 continuity: "Spw Position Matrix | a shape readers know"
 cold_open: "Each Spw mark has a shape readers know from another language, and here is what it means instead."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/language-features/spw-resonance.spw" ]
 lineage_note: "the raw file is kept as drift evidence only; no claim here uses it as a source"
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the raw file listed ten operators and left out the hash, the dot, and the coupling mark; canon names thirteen",
  "the raw file called = a constraint; canon reads = as configuration, and = with a body as a neutral bias edge",
  "the raw file read valence as emotional and operational charge; canon calls the pentad charge-neutral material quality",
  "the raw file revived dual_read_cards; canon conventions retire dual-read as a public term",
  "the raw claims that files test their own invariants and record their own telemetry had no basis in code and are dropped"
 ]
}

^["edges"]{
 grounds: [ ~"docs/theory/spw/operators.spw" ]
 see: [
  ~"../glossary/operators.spw#spw_gloss_operators",
  ~"../theory/valence-and-charge.spw#spw_theory_valence",
  ~"./pipelines-and-stacks.spw#lang_design_pipelines"
 ]
}

^["concepts"]{
 primary: [ #false_friend, #reader_name ]
 transfers: [ #label_entropy ]
 tensions: [ #naming_split ]
}

^["matrix"]{
 ^["legend"]{
  columns: #[ mark, canon, families, spw, gloss ]
  split: "how many names the five naming tables give a mark, read in the six_split claim below"
  as_of: "canon and code at commit 1aa1dc23; family references read 2026-10-02 and 2026-10-03"
  ^["basis"]{
   c: ~"../../registries/sources/spw-design-studies.spw#src_lab_kr_1988"
   shell: ~"../../registries/sources/spw-design-studies.spw#src_lab_posix_2017"
   rust: ~"../../registries/sources/spw-design-studies.spw#src_lab_klabnik_nichols_2023"
   python: ~"../../registries/sources/spw-design-studies.spw#src_lab_pep318"
   lisp: ~"../../registries/sources/spw-design-studies.spw#src_lab_clhs_1996"
   markdown: ~"../../registries/sources/spw-design-studies.spw#src_lab_commonmark"
   regex: ~"../../registries/sources/spw-design-studies.spw#src_lab_posix_2017"
   web: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_ecma262_2020", ~"../../registries/sources/spw-design-studies.spw#src_lab_ts_3_7" ]
   chat: ~"../../registries/sources/spw-design-studies.spw#src_lab_study_persona"
   spw: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators"
  }
 }
 #>lang_design_spw_position_row_tilde
 ^["tilde"]{
  mark: "~"
  canon: "potential"
  families: .{ c: "bitwise complement", shell: "home directory, by tilde expansion" }
  spw: "a deferred wrapper; before a quoted path, a path ref"
  gloss: ~"../glossary/operators.spw#spw_gloss_op_tilde"
 }
 #>lang_design_spw_position_row_hash
 ^["hash"]{
  mark: "#"
  canon: "vibration, split three ways"
  families: .{ c: "preprocessor directive", shell: "comment", markdown: "heading", rust: "attribute" }
  spw: "a tag, a set opener, a particle prefix, and with a space a dropped note"
  gloss: ~"../glossary/operators.spw#spw_gloss_op_hash"
 }
 #>lang_design_spw_position_row_dot
 ^["dot"]{
  mark: "."
  canon: "ground, split two ways"
  families: .{ c: "member access", shell: "run a file in the current shell", web: "property access" }
  spw: "property path access, and .{ } opens a facet of bindings"
  gloss: ~"../glossary/operators.spw#spw_gloss_op_dot"
 }
 #>lang_design_spw_position_row_question
 ^["question"]{
  mark: "?"
  canon: "wonder"
  families: .{ c: "conditional operator", web: "optional chaining", rust: "error propagation" }
  spw: "a wonder block opener; at run time, the second argument when the first is truthy"
  gloss: ~"../glossary/operators.spw#spw_gloss_op_question"
 }
 #>lang_design_spw_position_row_bang
 ^["bang"]{
  mark: "!"
  canon: "action"
  families: .{ c: "logical negation", shell: "negate a pipeline status", rust: "macro call" }
  spw: "an action that returns its first argument; negates nothing"
  gloss: ~"../glossary/operators.spw#spw_gloss_op_bang"
 }
 #>lang_design_spw_position_row_star
 ^["star"]{
  mark: "*"
  canon: "value"
  families: .{ c: "multiply or dereference", shell: "match any string", markdown: "emphasis" }
  spw: "write and return a collapsed first argument"
  gloss: ~"../glossary/operators.spw#spw_gloss_op_star"
 }
 #>lang_design_spw_position_row_amp
 ^["amp"]{
  mark: "&"
  canon: "subject, split two ways"
  families: .{ c: "address-of or bitwise and", shell: "run in the background", rust: "borrow" }
  spw: "merge arguments through register confluence"
  gloss: ~"../glossary/operators.spw#spw_gloss_op_amp"
 }
 #>lang_design_spw_position_row_at
 ^["at"]{
  mark: "@"
  canon: "perspective"
  families: .{ python: "decorator", lisp: "splice inside a backquote, as ,@", chat: "a mention" }
  spw: "a root reference such as @root/x.spw, notifying no one"
  gloss: ~"../glossary/operators.spw#spw_gloss_op_at"
 }
 #>lang_design_spw_position_row_caret
 ^["caret"]{
  mark: "^"
  canon: "ascension, split two ways"
  families: .{ c: "bitwise exclusive or", regex: "start of a line" }
  spw: "an integrated wrapper; before a quoted name, a named frame"
  gloss: ~"../glossary/operators.spw#spw_gloss_op_caret"
 }
 #>lang_design_spw_position_row_dollar
 ^["dollar"]{
  mark: "$"
  canon: "substrate, split two ways"
  families: .{ shell: "parameter expansion", regex: "end of a line" }
  spw: "materialize register metadata; $HOME reads no environment"
  gloss: ~"../glossary/operators.spw#spw_gloss_op_dollar"
 }
 #>lang_design_spw_position_row_percent
 ^["percent"]{
  mark: "%"
  canon: "measure"
  families: .{ c: "remainder, and printf conversions", shell: "remove a suffix pattern" }
  spw: "a register measure; in this cut, registry cells for world quantities"
  gloss: ~"../glossary/operators.spw#spw_gloss_op_percent"
 }
 #>lang_design_spw_position_row_equals
 ^["equals"]{
  mark: "="
  canon: "configuration, split two ways"
  families: .{ c: "assignment", shell: "variable assignment" }
  spw: "write to a register; with a body, a neutral bias edge"
  gloss: ~"../glossary/operators.spw#spw_gloss_op_equals"
 }
 #>lang_design_spw_position_row_couple
 ^["couple"]{
  mark: "<>"
  canon: "coupling"
  families: .{ shell: "open a file for reading and writing" }
  spw: "a two-way register edge when the first two operands are string keys"
  gloss: ~"../glossary/operators.spw#spw_gloss_op_couple"
 }
}

^["claims"]{
 #>lang_design_spw_position_names
 ^["thirteen_names"]{
  #:claim #!settled
  statement: "Canon gives thirteen reader names, from potential for the tilde and vibration for the hash to ground for the dot and coupling for the paired angle mark."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators"
  cites: [ "docs/theory/spw/operators.spw:28-42" ]
  label: "a-canon"
 }
 #>lang_design_spw_position_split
 ^["six_split"]{
  #:claim #!settled
  statement: "Five naming tables disagree on six marks: the hash spreads across three names, the dot, equals, ampersand, caret, and dollar across two each, and seven marks keep one name."
  reads: %[
   gloss.naming.hash_label_bits,
   gloss.naming.dot_label_bits,
   gloss.naming.equals_label_bits,
   gloss.naming.amp_label_bits,
   gloss.naming.caret_label_bits,
   gloss.naming.dollar_label_bits
  ]
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_code_type_affinities", ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_register_bank", ~"../../registries/sources/spw-design-studies.spw#src_lab_code_geometry_inspect" ]
  cites: [ "docs/theory/spw/operators.spw:28-42", "packages/spw-seed/src/canonical/form-ladders.ts:304-547" ]
  see: [ ~"../glossary/operators.spw#spw_gloss_op_naming" ]
 }
 #>lang_design_spw_position_runtime
 ^["c_shapes_other_meanings"]{
  #:claim #!settled
  statement: "A C reader meets four familiar marks that do other work at run time: the bang returns its argument, the ampersand merges, the caret wraps, and the percent sign measures."
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators", ~"../../registries/sources/spw-design-studies.spw#src_lab_kr_1988" ]
  cites: [ "docs/theory/spw/operators.spw:47-59" ]
  ~#say(familiar shapes, other work)
 }
 #>lang_design_spw_position_bias
 ^["equals_as_bias"]{
  #:claim #!settled
  statement: "In canon, = with a body is a neutral directed edge whose consumers choose the verb: mount resolves it, mutate applies or reverts it, and expand projects it."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_bias_product"
  cites: [ ".spw/registries/bias-product.spw:10", ".spw/registries/bias-product.spw:30-34" ]
  label: "a-canon"
 }
 #>lang_design_spw_position_raw_list
 ^["raw_operator_list"]{
  #:claim #!refuted
  statement: "The raw generation listed ten operators, called = a constraint, and left out the hash, the dot, and the coupling mark."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_study_scorecard"
  counter: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operators"
 }
 #>lang_design_spw_position_valence
 ^["valence_as_material"]{
  #:claim #!settled
  statement: "Canon calls the five valences charge-neutral material quality; the valence ledger is the home of that reading and of the raw emotional-charge reading it refutes."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_valence"
  see: [ ~"../theory/valence-and-charge.spw#spw_theory_valence_raw_reading" ]
 }
}

^["retired"]{
 #>lang_design_spw_position_dual_read
 ^["dual_read"]{
  #:claim #!settled
  statement: "Canon conventions keep dual-read out of public copy as an ambition, not an output form; a Spw card is source-shaped and parses as Spw."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_cli"
  cites: [ ".spw/conventions/cli.spw:41", ".spw/conventions/cli.spw:130" ]
  standing: "retired in canon"
 }
 #>lang_design_spw_position_cut_bans
 ^["cut_bans"]{
  #:claim #!settled
  statement: "This cut bans dispatch tables, slash lens comments, tagged angle path forms, and a facet register tag after .{ }, though canon files still write that tag."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_code_cut_gate"
  cites: [ "scripts/analyzers/spw-cut-gate.ts:44-54", "docs/theory/spw/operators.spw:24" ]
  standing: "banned in this cut, not retired in canon"
  label: "a-cut"
 }
}

#>lang_design_spw_position_misread_q
?["Do readers misread first the marks their own language uses as operators?"]{
 #:depth #!educational ~#lens(semiotic charge)
 #:claim #!speculative
 ~#hypothesis: "C and shell readers will misread the bang, ampersand, and caret more often than Markdown writers, whose marks are punctuation rather than operators."
 !probe{ "ask C, shell, and Markdown writers to predict what five Spw lines do before any mark is explained, and tally misreadings per mark" =id[p_lab_position_family_misread] =kind[interview] }
 breaks: "label entropy counts names inside one repository; a reader brings a family meaning from outside it, so the two measures can disagree"
 $%[gloss.naming.amp_label_bits, gloss.naming.caret_label_bits]
 ~"./spw-position-matrix.spw#lang_design_spw_position_runtime" ~#neighbor(nearest)
}

#>lang_design_spw_position_revival_q
?["Do retired terms come back when a generator reads canon that still mentions them?"]{
 #:depth #!historical ~#lens(historical layer)
 #:claim #!speculative
 ~#hypothesis: "Terms that canon keeps as legacy notes, such as dual-read, reappear in generated text more often than terms canon has deleted outright."
 !probe{ "list terms canon marks legacy or retired, then count each on the raw shelf and in the canon files that still mention it" =id[p_lab_position_revival] =kind[census] }
 $%[graph.path_refs]
 ~"./spw-position-matrix.spw#lang_design_spw_position_dual_read" ~#neighbor(nearest)
}
