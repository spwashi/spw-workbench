# Feature Lineage
#
# Rungs of programmable pattern from a punched paper band on a Lyon loom to Lisp, APL, Forth, Unix pipes, ML, Elixir, and Uiua, each date tied to a named source.

#>lang_design_lineage
#:layer #!reference
#:domain #!lang_design
#:form #!timeline
#:level #!foundation
#:review #!sourced
#:valence #!bone

^"emit"{
 ~#title: "Feature Lineage"
 ~#claim: "The lineage of programmable pattern climbs from loom cards that select threads to languages whose notation is the pattern: Lisp lists, APL glyphs, Forth words, Unix pipes, ML types, and Uiua arrays."
 ~#proof: "Each rung names its date and links a history written by a participant or a historian: Essinger, McCarthy, Iverson, Rather and coauthors, McIlroy, Milner, Valim, and the Uiua repository."
 ~#door: "Climb the rungs in order, then punch a paper band and write the same pattern as a list."
 ~#audience: "newcomers to programming language history and Spw readers asking where its marks come from"
 continuity: "Feature Lineage | programmable pattern"
 cold_open: "From loom cards to Uiua, each rung of programmable pattern moves closer to a page that people can read."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "Lisp dates checked against the Stanford copy of McCarthy, History of Lisp, on 2026-10-03",
  "Forth dates checked against the FORTH, Inc. copy of the HOPL-II paper on 2026-10-03",
  "Uiua repository creation date read from the GitHub API on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["edges"]{
 grounds: [ ~"../../physical/materials/fibers-and-textiles.spw#materials_fibers_bouchon" ]
 see: [
  ~"./pipelines-and-stacks.spw#lang_design_pipelines",
  ~"./macros-and-homoiconicity.spw#lang_design_macros",
  ~"../history/episode-timeline.spw#workbench_history_episodes"
 ]
}

^["concepts"]{
 primary: [ #programmable_pattern, #notation ]
 transfers: [ #punched_card, #homoiconicity ]
 tensions: [ #first_claims ]
}

^["ladder"]{
 #>lang_design_lineage_loom
 ^["loom_band"]{
  #:era #!early_modern
  #:claim #!settled
  statement: "Basile Bouchon used a perforated paper band to select warp threads in 1725, and Falcon replaced it with a chain of cards in 1728, a pattern stored outside the weaver."
  year: 1725
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_essinger_2004"
  see: [ ~"../../physical/materials/fibers-and-textiles.spw#materials_fibers_jacquard" ]
  ~#(Jacquard joined these ideas in 1804; the textiles surface is the home of that rung)
 }
 #>lang_design_lineage_lisp
 ^["lisp"]{
  #:era #!modern
  #:claim #!settled
  statement: "McCarthy began implementing Lisp at the MIT Artificial Intelligence Project in the fall of 1958 and in 1960 published programs written as the same symbolic lists they process."
  year: 1958
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_mccarthy_1978", ~"../../registries/sources/spw-design-studies.spw#src_lab_mccarthy_1960" ]
  ~#say(programs became lists)
 }
 #>lang_design_lineage_apl
 ^["apl"]{
  #:era #!modern
  #:claim #!settled
  statement: "Kenneth Iverson published his array notation in A Programming Language in 1962, and in 1980 argued that notation is a tool of thought."
  year: 1962
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_iverson_1962", ~"../../registries/sources/spw-design-studies.spw#src_lab_iverson_1980" ]
 }
 #>lang_design_lineage_forth
 ^["forth"]{
  #:era #!modern
  #:claim #!settled
  statement: "Charles Moore wrote the first paper on Forth in 1970 and built the first complete stand-alone Forth in 1971 for an NRAO radio telescope at Kitt Peak."
  year: 1971
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_rather_1993"
 }
 #>lang_design_lineage_pipes
 ^["unix_pipes"]{
  #:era #!modern
  #:claim #!settled
  statement: "Douglas McIlroy pressed for coupling programs in series, and pipes entered Research Unix in 1973; the Third Edition manual documents them."
  year: 1973
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_mcilroy_1987", ~"../../registries/sources/spw-design-studies.spw#src_lab_unix_v3_1973" ]
  ~#say(programs joined end to end)
 }
 #>lang_design_lineage_ml
 ^["ml"]{
  #:era #!modern
  #:claim #!settled
  statement: "Milner and colleagues at Edinburgh built ML as the meta language of the LCF prover; his 1978 paper gave its polymorphic type inference and the 1979 book documents it."
  year: 1978
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_milner_1978", ~"../../registries/sources/spw-design-studies.spw#src_lab_gordon_milner_wadsworth_1979" ]
 }
 #>lang_design_lineage_elixir
 ^["elixir"]{
  #:era #!contemporary
  #:claim #!settled
  statement: "Jose Valim announced Elixir 1.0 on 18 September 2014, a language on the Erlang virtual machine whose pipe passes a value as the first argument."
  year: 2014
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_valim_2014", ~"../../registries/sources/spw-design-studies.spw#src_lab_elixir_kernel" ]
 }
 #>lang_design_lineage_uiua
 ^["uiua"]{
  #:era #!current
  #:claim #!settled
  statement: "The Uiua repository was created on 27 February 2023 for an array language whose functions execute right to left and whose expressions need no explicit grouping."
  year: 2023
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_uiua_repo", ~"../../registries/sources/spw-design-studies.spw#src_lab_uiua_design" ]
 }
 order: << "loom band" ; "Lisp" ; "APL" ; "Forth" ; "Unix pipes" ; "ML" ; "Elixir" ; "Uiua" >>
 rule: "a rung date links a named source; a date without one would be marked contested"
}

^["readings"]{
 #>lang_design_lineage_page_reading
 ^["toward_the_page"]{
  #:claim #!interpretive
  statement: "Read in order, the rungs move the pattern from a physical arrangement of holes toward text a person can read and edit, and Spw sits at the text end."
  limit: "a reading of the ladder; the rungs did not descend from one another, and Lisp owes nothing to the loom"
 }
 #>lang_design_lineage_not_a_tree
 ^["parallel_not_descent"]{
  #:claim #!interpretive
  statement: "The ladder is an order of dates, not a family tree; APL, Forth, and Unix pipes arose in parallel from different problems, and each rung credits its own makers."
 }
}

^["try"]{
 #>lang_design_lineage_try_band
 ^["paper_band"]{
  materials: [ "a strip of squared paper", "a hole punch or a pencil", "four lengths of yarn" ]
  steps: << "draw four columns, one per warp thread" ; "mark a hole where a thread should lift, row by row, for six rows" ; "lift the yarn by each row and see the pattern" ; "write the same six rows as a list of lists, as a Lisp program would hold them" >>
  time: .{ n: 20, unit: "minutes" }
  safety: "a hole punch can pinch fingers; no other hazard worth naming"
  shows: ~"./feature-lineage.spw#lang_design_lineage_loom"
 }
}

#>lang_design_lineage_page_q
?["Does each rung move more of the program onto the page?"]{
 #:depth #!historical ~#lens(historical layer)
 #:claim #!speculative
 ~#hypothesis: "Later rungs keep more of a program in written notation and less in hardware arrangement, so more people can read and change them without the machine at hand."
 !probe{ "for each rung, record where the pattern lives, who could edit it, and what they needed to do so, from a primary source" =id[p_lab_lineage_page] =kind[lit] }
 breaks: "a loom band selects threads and cannot test a result or repeat on a condition, so it is a stored sequence, not a program in the later sense"
 $%[file.frame_count]
 ~"./feature-lineage.spw#lang_design_lineage_page_reading" ~#neighbor(nearest)
}
