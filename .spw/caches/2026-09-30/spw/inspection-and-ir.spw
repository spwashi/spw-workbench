# Inspection and IR
#
# The intermediate representations as graded inspection surfaces: which care rung reads which IR, what each producer hides, how far each tool can be trusted, and the receipt as a ledger of what was not checked.

#>spw_inspection_and_ir
#:layer #!semantics
#:domain #!spw
#:form #!comparison
#:level #!advanced
#:review #!spot_checked
#:valence #!bane

^"emit"{
 ~#title: "Inspection and IR"
 ~#claim: "Care ascends while the IR descends: a glance reads the most derived card, and adversarial care returns to tokens and gaps, where the silent failures live."
 ~#proof: "At 1aa1dc23 lexer errors keep parse success true, ONF keeps spans only on postfix constructions, and the brief card drops claim status."
 ~#door: "Inspect the water surface at two rungs, a glance and a token view, and write down what the glance hid."
 ~#audience: "reviewers, tool authors, and readers who check before they trust"
 continuity: "Inspection and IR | care ascends"
 cold_open: "As care ascends, read less derived material, and write down what you did not check."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  ".agents/plans/caches-cut-2026-09-30/references/spw-branch/machine-empathy.md sections 2 and 3",
  "IR sources re-read at 1aa1dc23: ir/kinds.ts, ir/ref.ts, ir/lens.ts, ir/granularity.ts, ir/cache-layer.ts, ir/progressive.ts, canonical/index-config.ts",
  "tool runs on 2026-10-02: spw census on the registries, spw outline help, spw emit pack brief, parse of two lexer-error samples"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the study labeled the care ladder canon; it is a-cut vocabulary from vocabulary.spw, and no care ladder exists in .spw/conventions or docs/theory/spw",
  "ir/lens.ts and IrLensLevel were missing from the study; they are rows here, and care maps onto GranularityDepth, IrLensLevel, and IndexDepth as a mapping only",
  "spw cycle already produces before and after receipts; it is named before any new receipt field is proposed",
  "the dated CLI probes from the dropped hosts/cli-readings surface are folded into tool trust below"
 ]
}

^["edges"]{
 grounds: [ ~"docs/theory/spw/representational-disclosure.spw#representational_disclosure", ~"docs/theory/spw/cache-field.spw#cache_field" ]
 needs: [ ~"./tokens-and-roles.spw#spw_tokens_and_roles" ]
 feeds: [ ~"./machine-empathy.spw#spw_machine_empathy" ]
}

^["concepts"]{
 primary: [ #care_ladder, #receipt ]
 transfers: [ #omission ]
 tensions: [ #silent_failure ]
}

^["ladder"]{
 label: "the care ladder is a-cut vocabulary; producers and losses are code facts at 1aa1dc23"
 ^["glance"]{ sees: "the emit card", ir: "emit pack", producer: "spw emit pack --host brief", hides: "claim status, limits, provenance" }
 ^["skim"]{ sees: "frames and landmarks", ir: "line scan without a parse", producer: "spw outline", hides: "anchors, particles, wonders, cold_open" }
 ^["read"]{ sees: "every claim with bound particles, limits, and wonders", ir: "AST and particle bindings", producer: "LSP hover, spw select, spw expand", hides: "lexer errors while success stays true" }
 ^["audit"]{ sees: "sources, registry cells, links, numbers", ir: "AST, resolve graph, registry cells", producer: "the cut gate and spw resolve", hides: "facts outside the cited source" }
 ^["adversarial"]{ sees: "bytes, tokens, gaps, value projections, counter-sources", ir: "tokens, gaps, fingerprints, ONF value receipts", producer: "spw inspect source --through tokens, spw fingerprint", hides: "nothing by design; this rung lists losses" }
 #>spw_ir_care_descends
 ^["care_ascends_ir_descends"]{
  #:claim #!interpretive
  statement: "Care ascends while the IR descends, because the silent failures sit below the AST: lexer errors keep success true and ONF drops most spans."
  source: ~"../registries/sources/spw-branch.spw#src_spw_study_machine_empathy"
  reads: %[spw.corpus.onf_water_spanned]
 }
}

^["irs"]{
 #>spw_ir_tokens
 ^["tokens"]{
  #:claim #!settled
  statement: "The lexer has a closed set of token types and classifies every gap as tight, open, cadence, or episode; a lexer error is recorded while parse success stays true."
  source: ~"../registries/sources/spw-branch.spw#src_spw_seed_lexer"
  reads: %[spw.seed.token_types]
  cites: [ "packages/spw-seed/src/types/token.ts:39-71", "packages/spw-seed/src/lexer/gaps.ts:11-17" ]
 }
 #>spw_ir_ast
 ^["ast_and_particles"]{
  #:claim #!settled
  statement: "The AST has a closed set of node types; particle bindings are computed from it, and the cut gate reads anchors through the deixis table."
  source: ~"../registries/sources/spw-branch.spw#src_spw_seed_ast"
  reads: %[spw.seed.ast_node_types]
  cites: [ "packages/spw-seed/src/types/ast/index.ts:13-41", "scripts/analyzers/spw-cut-gate.ts:245" ]
 }
 #>spw_ir_onf
 ^["onf_and_value_receipt"]{
  #:claim #!settled
  statement: "ONF keeps source spans only in construction frames for postfix forms, and the interpreter attaches a value-projection receipt listing omissions when it drops postfix attachments."
  source: ~"../registries/sources/spw-branch.spw#src_spw_seed_onf"
  cites: [ "packages/spw-seed/src/types/ast/onf.ts:20-26", "packages/spw-seed/src/normalize-construction.ts:48-51", "packages/spw-runtime/src/interpreter/interpreter.ts:380-386" ]
 }
 #>spw_ir_kinds
 ^["kind_spine"]{
  #:claim #!settled
  statement: "The IR spine names a fixed list of IR kinds and of edge kinds between them, from preprocess and lex through corpus, plan, and charge."
  source: ~"../registries/sources/spw-branch.spw#src_spw_seed_ir"
  reads: %[spw.seed.ir_kinds, spw.seed.ir_edge_kinds]
  cites: [ "packages/spw-seed/src/ir/kinds.ts:9-56" ]
 }
 #>spw_ir_ref
 ^["ref_and_lens_level"]{
  #:claim #!settled
  statement: "An IrRef keys durable identity on kind, uri, content hash, dialect, channel, lens, schema, and producer, excluding retention stamps; its lens level runs from file to corpus."
  source: ~"../registries/sources/spw-branch.spw#src_spw_seed_ir"
  reads: %[spw.seed.ir_lens_levels]
  cites: [ "packages/spw-seed/src/ir/ref.ts:26", "packages/spw-seed/src/ir/ref.ts:61-71" ]
 }
 #>spw_ir_lens
 ^["traversal_lens"]{
  #:claim #!settled
  statement: "A traversal can carry effects, one of which is disclose, and opt channels carry a budget in beats, nodes, and milliseconds."
  source: ~"../registries/sources/spw-branch.spw#src_spw_seed_ir"
  cites: [ "packages/spw-seed/src/ir/lens.ts:9-19", "packages/spw-seed/src/ir/lens.ts:34-46" ]
 }
 #>spw_ir_granularity
 ^["granularity"]{
  #:claim #!settled
  statement: "Granularity depth runs skim, card, field, full, and a skim request without an explicit plane is forced to the bytecode plane."
  source: ~"../registries/sources/spw-branch.spw#src_spw_seed_ir"
  reads: %[spw.seed.granularity_depths]
  cites: [ "packages/spw-seed/src/ir/granularity.ts:14", "packages/spw-seed/src/ir/granularity.ts:198-201" ]
 }
 #>spw_ir_disclosure_shapes
 ^["omission_shapes"]{
  #:claim #!settled
  statement: "Three shipped shapes already state losses: a cache-layer card with omission and next, a progressive product with included, omitted, and deferred, and the ONF value receipt."
  source: ~"../registries/sources/spw-branch.spw#src_spw_seed_ir"
  cites: [ "packages/spw-seed/src/ir/cache-layer.ts:26-35", "packages/spw-seed/src/ir/progressive.ts:12-38" ]
  law: "a-canon: every bounded product states omitted rows, tokens, events, or fields"
  law_cites: [ ".spw/conventions/cli.spw:100" ]
 }
 #>spw_ir_index_depth
 ^["index_depth"]{
  #:claim #!settled
  statement: "Index depth is a third ladder, minimal, standard, full, used by the corpus index configuration."
  source: ~"../registries/sources/spw-branch.spw#src_spw_seed_ir"
  cites: [ "packages/spw-seed/src/canonical/index-config.ts:11" ]
 }
 #>spw_ir_emit
 ^["emit_pack"]{
  #:claim #!settled
  statement: "Emit pack projects a surface into one of several host packets; the brief host keeps five card fields."
  source: ~"../registries/sources/spw-branch.spw#src_spw_cli_emit"
  reads: %[spw.cli.emit_hosts]
  cites: [ "packages/spw-cli/src/emit/types.ts:21-31" ]
 }
}

^["mapping"]{
 #>spw_ir_care_mapping
 ^["care_to_code"]{
  #:claim #!speculative
  statement: "Care could map onto granularity depth, lens level, and index depth, a mapping only, so that no vocabulary is renamed into another."
  status: #proposed
  source: ~"../registries/sources/spw-branch.spw#src_spw_study_critic"
  precondition: "the care ladder must first land in .spw/conventions/cli.spw before any --care flag reaches seed, CLI, or LSP"
 }
 ^["glance"]{ depth: "skim", lens_level: "file", index_depth: "minimal" }
 ^["skim"]{ depth: "card", lens_level: "frame", index_depth: "minimal" }
 ^["read"]{ depth: "field", lens_level: "body", index_depth: "standard" }
 ^["audit"]{ depth: "full", lens_level: "graph", index_depth: "standard" }
 ^["adversarial"]{ depth: "full", lens_level: "body", index_depth: "full" }
 never_escalates: "a-canon defers weight-driven auto grain without explicit choice, so declared care never raises itself"
 never_escalates_cites: [ "docs/theory/spw/representational-disclosure.spw:296" ]
}

^["receipts"]{
 #>spw_ir_receipts_today
 ^["today"]{
  #:claim #!settled
  statement: "A cut receipt records event, at, agent, care, and outcome; the gate checks only that those values come from the vocabulary, not that review honestly summarizes them."
  source: ~"../registries/sources/spw-branch.spw#src_spw_cut_gate"
  cites: [ "scripts/analyzers/spw-cut-gate.ts:308-313" ]
  reads: %[spw.cut.receipts, spw.cut.receipts_adversarial, spw.cut.receipts_skim]
 }
 #>spw_ir_receipts_cycle
 ^["cycle"]{
  #:claim #!settled
  statement: "spw cycle already captures before and after receipts around one inspection, running prepare, parse, and inspect on one session."
  source: ~"../registries/sources/spw-branch.spw#src_spw_cli_commands"
  cites: [ "packages/spw-cli/src/commands.ts:270-276" ]
  status: #implemented
 }
 #>spw_ir_receipt_fields
 ^["loss_ledger"]{
  #:claim #!speculative
  statement: "A receipt could add ir, through, scope, omitted, digest, and next, borrowing omission and next from cache-layer cards, so each receipt becomes a ledger of what was not checked."
  status: #proposed
  source: ~"../registries/sources/spw-branch.spw#src_spw_study_machine_empathy"
 }
 standing: "a receipt is a loss ledger, not a grade; a reader who keeps one keeps it locally"
 standing_cites: [ ".spw/conventions/cli.spw:118-121" ]
}

#>spw_ir_tool_trust
^["tool_trust"]{
 #>spw_ir_trust_gate
 ^["gate_and_resolve"]{
  #:claim #!settled
  statement: "The cut gate fails on parse errors and warnings, prose fallback, capsule swallows, and refs whose file or anchor is missing, and spw resolve checks file and anchor too."
  source: ~"../registries/sources/spw-branch.spw#src_spw_cut_gate"
  trust: "trusted pair for link and parse health"
 }
 #>spw_ir_trust_validator
 ^["validator"]{
  #:claim #!settled
  statement: "The syntax validator fails a file only when success is false, so files with lexer errors pass."
  source: ~"../registries/sources/spw-branch.spw#src_spw_validator"
  cites: [ "scripts/analyzers/spw-syntax-validate.ts:209", "scripts/analyzers/spw-syntax-validate.ts:227" ]
  trust: "pass means the parse completed, not that every character lexed"
 }
 #>spw_ir_trust_census
 ^["census_and_graph"]{
  #:claim #!settled
  statement: "Run on the registries, spw census reported about half of its path links broken while the cut gate found none unresolved, because census counts anchored links as broken."
  source: ~"../registries/sources/spw-branch.spw#src_spw_cli_commands"
  reads: %[spw.cut.census_links_registries, spw.cut.census_broken_registries]
  trust: "use census for counts and roles, never for link health"
 }
 #>spw_ir_trust_outline
 ^["outline"]{
  #:claim #!settled
  statement: "spw outline skips every line that starts with a hash and takes depth from half the indent, and its help still prints the alias title Spw Skim."
  source: ~"../registries/sources/spw-branch.spw#src_spw_cli_commands"
  cites: [ "packages/spw-cli/src/view.ts:231", "packages/spw-cli/src/view.ts:234" ]
  probe_run: "spw outline --help on 2026-10-02 at 1aa1dc23"
  trust: "orientation only; read claims and wonders by eye"
 }
 #>spw_ir_trust_emit
 ^["emit_brief"]{
  #:claim #!settled
  statement: "The brief card keeps title, audience, claim, proof, and door, and drops the claim mood."
  source: ~"../registries/sources/spw-branch.spw#src_spw_cli_emit"
  trust: "a publishing gate, not a status report"
 }
 dollar_percent: "the dollar-percent metric line parses as two sibling operations; tools that read it as one unit are reading text, not the tree"
 at_name: "an at-name lexes as a reference, a root or alias, and never as the perspective operator"
}

^["homonyms"]{
 home: "skim, read, lens, level, and reading each carry several meanings; their rows live in the glossary terms surface"
 rule: "this surface uses skim and read only as care rungs, and names the outline command by its canonical name"
 see: [ ~"./glossary/terms.spw#spw_gloss_terms" ]
}

^["try"]{
 #>spw_ir_try_five_rungs
 ^["five_rungs"]{
  materials: [ "a terminal in the workbench", "the water exemplar surface", "a notebook you keep" ]
  steps: << "glance: spw emit pack with --host brief" ; "skim: spw outline" ; "read: spw select with --selector particles" ; "audit: spw resolve and the cut gate" ; "adversarial: spw inspect source with --through tokens" ; "write one receipt naming what each rung hid" >>
  time: .{ n: 40, unit: "minutes" }
  safety: "none worth naming; every command reads and prints, and the receipt stays in your notebook"
  shows: ~"./inspection-and-ir.spw#spw_ir_care_descends"
 }
}

#>spw_ir_honesty_q
?["How many sourced surfaces would fail if review had to match the best passing receipt care?"]{
 #:depth #!computational ~#lens(applied attention)
 #:claim #!speculative
 ~#hypothesis: "A handful of surfaces claim more review than any receipt shows, and they cluster where receipts were written before the gate checked care."
 !probe{ "map review to the highest passing care for every surface in the cut and list the mismatches" =id[p_spw_ir_honesty] =kind[census] }
 $%[spw.cut.receipts, spw.cut.files]
 ~"./inspection-and-ir.spw#spw_ir_receipts_today" ~#neighbor(nearest)
}
