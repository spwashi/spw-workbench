# Spw Theory Pressures
#
# Six pressure surfaces for the owner: particles, addresses, valence, measures, clustering, and claim status. Each one asks; none edits canon.

#>spw_theory_index
#:layer #!semantics
#:domain #!spw_theory
#:form #!index
#:level #!advanced
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Spw Theory Pressures"
 ~#claim: "Six pressure surfaces set what canon says against what the code does, and each ends in questions for the owner rather than edits."
 ~#proof: "Every factual line cites canon or code at commit 1aa1dc23; readings are marked interpretive and proposals speculative."
 ~#door: "Start with particles, where binding runs forward, then follow addresses and claim status."
 ~#audience: "the Spw owner and readers revisiting the language theory"
 continuity: "Spw Theory Pressures | questions for the owner"
 cold_open: "Six surfaces set canon against code and end in questions for the owner, never in edits."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["tree"]{
 particles: ~"./particle-lattice.spw"
 addresses: ~"./address-and-linking.spw"
 valence: ~"./valence-and-charge.spw"
 measures: ~"./measures-and-handles.spw"
 clustering: ~"./clustering-hybrid.spw"
 status: ~"./epistemic-status.spw"
}

^["bundle"]{
 ={
  ~"./particle-lattice.spw#spw_theory_particle_lattice"
  ~"./address-and-linking.spw#spw_theory_address"
  ~"./valence-and-charge.spw#spw_theory_valence"
  ~"./measures-and-handles.spw#spw_theory_measures"
  ~"./clustering-hybrid.spw#spw_theory_clustering"
  ~"./epistemic-status.spw#spw_theory_epistemic_status"
 }
}

^["order"]{
 reading: << "particle lattice" ; "address and linking" ; "epistemic status" ; "valence and charge" ; "measures and handles" ; "clustering hybrid" >>
}

^["rule"]{
 #>spw_theory_index_pressure_rule
 ^["pressure_not_canon"]{
  #:claim #!interpretive
  statement: "These surfaces record pressure on canon from code, tools, and readers; a design amendment leaves through the open-questions promote queue, never by editing a theory file."
 }
 labels: "a-canon marks repo canon, a-cut marks a rule of this cut, owner hold marks the resume note"
}

^["gaps"]{
 operator_semantics: "no surface here gives formal semantics for the operators; canon asks which equivalence its operator laws mean, and that cell stays empty"
 pair_product: "no surface defines #:k #!v as one pair node; the particle lattice asks the question and leaves the cell empty"
 dialects: "dialect pressure lives with the spw branch dialects surface, not here"
}
