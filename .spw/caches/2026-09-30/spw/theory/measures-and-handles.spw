# Measures and Handles
#
# The percent sign carries three profiles: a measure bounded to the unit interval in canon, an unbounded world quantity in this cut, and a count family in the measure registry. Handles and lenses drifted until nothing recurred.

#>spw_theory_measures
#:layer #!semantics
#:domain #!spw_theory
#:form #!ledger
#:level #!advanced
#:review #!adversarial_checked
#:valence #!bonk

^"emit"{
 ~#title: "Measures and Handles"
 ~#claim: "The percent sign is one operator with three profiles, and in the raw generation no metric handle recurred, so nothing could aggregate until closed sets made values recur."
 ~#proof: "Canon lines name the bounded measure and the count family, the contract names registry cells, and recounts at 1aa1dc23 show every raw handle used once."
 ~#door: "Read the three profiles first, then the drift counts, then why the cut closes its sets."
 ~#audience: "the Spw owner and writers who cite measures and handles"
 continuity: "Measures and Handles | nothing could aggregate"
 cold_open: "When every handle is used once, nothing could aggregate, so this cut closes its sets and reuses its cells."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  ".agents/plans/caches-cut-2026-09-30/references/studies/persona-synthesis.json theory_questions group measures and familiarity row for %",
  ".agents/plans/caches-cut-2026-09-30/references/review/scorecard.md tree-wide measurements",
  "recounts and parser probes by the writer at 1aa1dc23 on 2026-10-02"
 ]
 standing: "pressure surface for the owner; nothing here edits canon"
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the LSP wonder claim cited a source anchor missing from the registry; src_lab_code_lsp_wonder now exists with its locator at 6690d686",
  "the scale reading credited Stevens with a bounded proportion type and an absolute count; Stevens named four types, and the absolute scale is a later name, now sourced to Tal",
  "the lens recount called its six frequent values canon; they come from tracked .spw files across plans, biome, docs, and lib"
 ]
}

^["edges"]{
 grounds: [ ~"docs/library/spw/wonder-calculus.spw", ~".spw/registries/measure-context.spw" ]
 extends: [ ~"../../vocabulary.spw#cut_vocabulary" ]
 see: [ ~"./clustering-hybrid.spw#spw_theory_clustering" ]
}

^["concepts"]{
 primary: [ #measure, #registry_cell, #handle ]
 transfers: [ #scale_type ]
 tensions: [ #handle_drift ]
}

^["profiles"]{
 #>spw_theory_measures_unit_interval
 ^["unit_interval"]{
  #:claim #!settled
  statement: "Canon states that a measure returns a scalar in the unit interval, and the operator atlas notes the same bound for the percent transformer."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_wonder_calculus"
  see: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_operator_atlas" ]
  cites: [ "docs/library/spw/wonder-calculus.spw:47", "docs/theory/spw/operator-atlas.spw:37" ]
  label: "a-canon"
 }
 #>spw_theory_measures_world_cell
 ^["world_cell"]{
  #:claim #!settled
  statement: "This cut writes registry cells as percent-sign frames holding unbounded world quantities with units, such as a handle count in the billions."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_cut_contract"
  reads: %[lab.chat.half_collision_64bit_handles]
  label: "a-cut"
  ^["limits"]{
   holds: "registry cells read with reads and cited from wonders"
   fails: "the canon bound, which no world cell respects"
  }
 }
 #>spw_theory_measures_count_family
 ^["count_family"]{
  #:claim #!settled
  statement: "The measure registry declares mass as a count family, a percent frame holding raw line and byte counts, and canon lists surface family against register measure as an open question."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_measure_context"
  cites: [ ".spw/registries/measure-context.spw:3-4", ".spw/registries/measure-context.spw:47", "docs/theory/spw/measure-context-kernel.spw:137" ]
  label: "a-canon"
 }
 #>spw_theory_measures_scale_types
 ^["scale_types"]{
  #:claim #!interpretive
  statement: "All three profiles are ratio scales in the four-type scheme of Stevens; later theory names ratio scales with a natural unit, as for counts and probabilities, absolute, and one sigil hides that split."
  see: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_stevens_1946", ~"../../registries/sources/spw-design-studies.spw#src_lab_tal_2020" ]
 }
}

^["parse_facts"]{
 #>spw_theory_measures_fifty_percent
 ^["fifty_percent"]{
  #:claim #!settled
  statement: "Written as a value, 50% parses as a number followed by a separate loose percent operation, so the percent sign never attaches to the number."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_probe_parser"
  ~#say(write the fraction or a string)
 }
 #>spw_theory_measures_dollar_percent
 ^["dollar_percent"]{
  #:claim #!settled
  statement: "The wonder metric line $%[a.b] parses as two operations, a bare dollar sign and a percent frame, so no composite node carries the pair."
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_probe_parser", ~"../../registries/sources/spw-design-studies.spw#src_lab_cut_contract" ]
 }
 #>spw_theory_measures_reflexive
 ^["reflexive_handles"]{
  #:claim #!settled
  statement: "The cut gate accepts a short fixed list of reflexive handles such as file.lines and graph.in_degree, which name properties of the surface itself rather than the world."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_code_cut_gate"
  cites: [ "scripts/analyzers/spw-cut-gate.ts:36-41" ]
 }
}

^["drift"]{
 #>spw_theory_measures_handle_drift
 ^["handle_drift"]{
  #:claim #!settled
  statement: "In the round-one snapshot every one of 337 metric handles was used once; a recount of the larger raw shelf at 1aa1dc23 finds 469 uses and 469 distinct handles."
  reads: %[
   lab.drift.round1_handles_n,
   lab.drift.shelf_handles_n,
   lab.drift.shelf_handles_distinct_n
  ]
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_study_scorecard", ~"../../registries/sources/spw-design-studies.spw#src_lab_recount_shelf" ]
  ~#say(no handle ever came back)
 }
 #>spw_theory_measures_lens_drift
 ^["lens_drift"]{
  #:claim #!settled
  statement: "Round one held 165 lens values in 167 uses and the recount 231 in 232, while six lens values across tracked .spw files in plans, biome, and docs recur sixty times or more."
  reads: %[
   lab.drift.round1_lens_distinct_n,
   lab.drift.round1_lens_uses_n,
   lab.drift.shelf_lens_distinct_n,
   lab.drift.shelf_lens_uses_n
  ]
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_study_scorecard", ~"../../registries/sources/spw-design-studies.spw#src_lab_recount_shelf" ]
 }
 #>spw_theory_measures_lsp_blind
 ^["lsp_reads_old_form"]{
  #:claim #!superseded
  statement: "At commit 1aa1dc23 the LSP wonder hover read the lens only from a slash comment and the neighbor only from the angle form, so lens and neighbor appositions showed nothing."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_code_lsp_display"
  cites: [ "packages/spw-lsp/src/handlers/display.ts:304", "packages/spw-lsp/src/handlers/display.ts:308" ]
 }
 #>spw_theory_measures_lsp_lens
 ^["lsp_reads_apposition"]{
  #:claim #!settled
  statement: "From commit 6690d686 the wonder hover reads a lens apposition first, then a lens datum, then the legacy comment, and still finds a neighbor only in the angle form."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_code_lsp_wonder"
  cites: [ "packages/spw-lsp/src/handlers/wonder.ts:177-200", "packages/spw-lsp/src/handlers/wonder.ts:221" ]
  supersedes: [ ~"./measures-and-handles.spw#spw_theory_measures_lsp_blind" ]
  ^["limits"]{
   holds: "the wonder hover and inlay at 6690d686 and the 651b535b head"
   fails: "a later LSP change that reads the neighbor apposition; the neighbor half of this claim should be rechecked then"
  }
 }
}

^["closed_sets"]{
 #>spw_theory_measures_why_closed
 ^["why_closed"]{
  #:claim #!interpretive
  statement: "A facet value earns its place by recurring; closed sets for lens, depth, and relation make values recur, so a census can group surfaces where unique values could only list them."
  grounds: [ ~"../../vocabulary.spw#cut_vocabulary" ]
  ^["limits"]{
   holds: "facets meant for finding and comparing"
   fails: "a closed set ages; a new field arrives with a reading the set lacks, and the set must be amended on purpose"
  }
 }
 rule: "the gate rejects axis, lens, depth, claim, relation, and probe values outside vocabulary.spw"
 cost: "a writer with a new reading proposes it beside the set instead of minting it inline"
}

^["questions"]{
 quantity_noun: "Should the language keep one percent sign with profiles, or add a quantity noun for unit-bearing cells and leave percent for bounded measures?"
 ordinal: "Where should ordinal scores such as rubric levels live: an ordinal family, or ?match bands?"
 illustrative: "Should a teaching number that asserts nothing about the world carry its own claim status? That question lives in the epistemic status surface."
 composite: "Should the lexer own $% as one compound so wonder metrics become one node?"
}

#>spw_theory_measures_recurrence_q
?["Does a closed set make handles recur across this cut?"]{
 #:depth #!computational ~#lens(curated collection)
 #:claim #!speculative
 ~#hypothesis: "Registry cells in this cut are read from more than one place more often than raw handles ever were, because a writer must look a cell up before citing it."
 !probe{ "count reads and wonder metric sites per registry handle across the cut and compare with the raw shelf, where every handle appears once" =id[p_lab_measures_recurrence] =kind[census] }
 $%[lab.drift.shelf_handles_distinct_n, probe.metric_sites]
 ~"./measures-and-handles.spw#spw_theory_measures_handle_drift" ~#neighbor(nearest)
}

#>spw_theory_measures_dimension_q
?["Could a dimension check catch a wrong unit in a registry cell?"]{
 #:depth #!mathematical ~#lens(scale and dimension)
 #:claim #!speculative
 ~#hypothesis: "A dimension field on each cell, checked where cells are combined, would flag slips that string units let through, such as handles against handle uses."
 !probe{ "add a dimension field to the cells of one registry and run a homogeneity check over every statement that reads two cells" =id[p_lab_measures_dimension] =kind[build] }
 raised_by: #[ physics, engineers_chemists, c_programmers, mathematicians, creators ]
 $%[lab.chat.half_collision_64bit_handles, lab.drift.shelf_handles_n]
 ~"./measures-and-handles.spw#spw_theory_measures_world_cell" ~#neighbor(nearest)
}
