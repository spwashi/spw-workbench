# Particle Lattice Pressures
#
# Questions for the owner about the particle lattice: four aims against three lexed tokens, forward binding, container and file deixis, digit-led names, and one aim with three names.

#>spw_theory_particle_lattice
#:layer #!semantics
#:domain #!spw_theory
#:form #!probe_battery
#:level #!advanced
#:review #!sourced
#:valence #!bonk

^"emit"{
 ~#title: "Particle Lattice Pressures"
 ~#claim: "Canon names a lattice of particle aims, yet the lexer makes tokens of three, every run binds forward to the next node, and digit-led names vanish without a diagnostic."
 ~#proof: "Each pressure cites the seed at commit 1aa1dc23 and a parser probe the writer ran on 2026-10-02, and names the probe that would settle it."
 ~#door: "Start with forward binding, then container deixis; each question names the personas who raise it."
 ~#audience: "the Spw owner and readers revisiting the particle lattice"
 continuity: "Particle Lattice Pressures | binds forward"
 cold_open: "A particle run binds forward to whatever comes next, and most of these questions start there."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  ".agents/plans/caches-cut-2026-09-30/references/studies/persona-synthesis.json theory_questions, group particles",
  ".agents/plans/caches-cut-2026-09-30/references/studies/tokens-synthesis.md section 1",
  "parser probes run by the writer at 1aa1dc23 on 2026-10-02"
 ]
 standing: "pressure surface for the owner; nothing here edits canon, and design amendments go to the open-questions promote queue"
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["edges"]{
 grounds: [ ~"docs/theory/spw/apposition.spw#spw_apposition" ]
 feeds: [ ~"./epistemic-status.spw#spw_theory_epistemic_status" ]
 see: [ ~"./address-and-linking.spw#spw_theory_address" ]
}

^["concepts"]{
 primary: [ #particle, #forward_binding, #deixis ]
 transfers: [ #grammatical_category ]
 tensions: [ #container_deixis ]
}

^["terms"]{
 particle: "the mark itself, such as #>name, #:case, or #!mood"
 anchor: "the bookmark a deixis particle leaves on the node it binds"
 run: "consecutive particles that bind together to one node"
 label: "a-canon names the lattice; a-cut places #:claim inside the claim frame; neither is an owner hold"
}

^["observed"]{
 #>spw_theory_particle_three_lexed
 ^["three_lexed"]{
  #:claim #!settled
  statement: "Canon lists deixis, case, mood, aspect, and apposition as the lattice; the lexer makes PARTICLE tokens only for deixis, case, and mood, and aspect stays on the annotation path."
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_code_particle_lexer", ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_apposition" ]
  cites: [ "packages/spw-seed/src/lexer/matchers/particles.ts:9-12", "packages/spw-seed/src/lexer/matchers/particles.ts:20", "docs/theory/spw/apposition.spw:33" ]
 }
 #>spw_theory_particle_forward
 ^["forward_binding"]{
  #:claim #!settled
  statement: "particleBindings binds each particle run to the next content item in its sequence, skipping other marks; the binding is computed on demand and never stored on a node."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_code_particle_binding"
  cites: [ "packages/spw-seed/src/canonical/particles.ts:63-79", "packages/spw-seed/src/canonical/particles.ts:82" ]
  ~#say(a run binds to what follows)
 }
 #>spw_theory_particle_first_wins
 ^["first_wins"]{
  #:claim #!settled
  statement: "deixisTable keeps the first binding for each anchor name, so a second anchor with the same name in one file is silently ignored by fragment resolution."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_code_particle_binding"
  cites: [ "packages/spw-seed/src/canonical/particles.ts:148-156" ]
 }
 #>spw_theory_particle_digit_drop
 ^["digit_drop"]{
  #:claim #!settled
  statement: "A particle name must start with a letter or underscore; #!3 lexes as two operator marks and a number, #>12a leaves a prose payload, and parse reports no error."
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_code_particle_lexer", ~"../../registries/sources/spw-design-studies.spw#src_lab_probe_parser" ]
  cites: [ "packages/spw-seed/src/lexer/matchers/particles.ts:33" ]
 }
 #>spw_theory_particle_header_binds_card
 ^["header_binds_card"]{
  #:claim #!settled
  statement: "The header axis stack binds forward to the emit card, not to the file; the probe bound #>top, #:layer, and #!semantics to the frame that followed them."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_probe_parser"
 }
 #>spw_theory_particle_inside_frame
 ^["inside_frame"]{
  #:claim #!settled
  statement: "A #:claim #!settled run on the first line of a frame body binds to the statement binding after it, while the cut gate reads the enclosing frame as the claim."
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_probe_parser", ~"../../registries/sources/spw-design-studies.spw#src_lab_code_cut_gate" ]
  cites: [ "scripts/analyzers/spw-cut-gate.ts:315-321" ]
 }
 #>spw_theory_particle_three_names
 ^["three_names"]{
  #:claim #!settled
  statement: "One aim carries three names: the lexer and atlas call #: case, the LSP calls it lens, and the plan schema calls it kind; the LSP also names #> anchor and #! intent."
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_code_cli_atlas", ~"../../registries/sources/spw-design-studies.spw#src_lab_code_lsp_particle_names", ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_plan_schema" ]
  cites: [ "packages/spw-cli/src/atlas.ts:137-139", "packages/spw-lsp/src/server-index.ts:1046-1048", ".agents/plans/_schema/wip.spw:46" ]
 }
}

^["pressures"]{
 #>spw_theory_particle_aspect_q
 ?["Should aspect join the lexed particle family?"]{
  #:depth #!computational ~#lens(formal structure)
  #:claim #!speculative
  ~#hypothesis: "Lexing ~# as a fourth aim would let particle counts read aspect from the tree instead of the source text, while moving few existing parses."
  !probe{ "lex the repository with ~# as a fourth aim and diff selector counts and trees against 1aa1dc23" =id[p_lab_particle_aspect_lex] =kind[build] }
  raised_by: #[ linguists, physics, designers ]
  $%[particle.aspect, particle.case]
  ~"./particle-lattice.spw#spw_theory_particle_three_lexed" ~#neighbor(nearest)
 }
 #>spw_theory_particle_container_q
 ?["Should a run on the first line of a body bind to the enclosing frame?"]{
  #:depth #!computational ~#lens(formal structure)
  #:claim #!speculative
  ~#hypothesis: "Container binding for a first-line run would match how readers and the gate already read claim stacks, and would change few other bindings in the corpus."
  !probe{ "census every particle run on the first line of a body and record what it binds today and under container binding" =id[p_lab_particle_container_census] =kind[census] }
  raised_by: #[ c_programmers, designers, librarians, production_crews, linguists, educators_community ]
  $%[particle.case, particle.mood]
  ~"./particle-lattice.spw#spw_theory_particle_inside_frame" ~#neighbor(nearest)
 }
 #>spw_theory_particle_file_q
 ?["Is there, or should there be, a file-level deixis?"]{
  #:depth #!stylistic ~#lens(formal structure)
  #:claim #!speculative
  ~#hypothesis: "A declared file scope for the header stack would let tools read axes even when the emit card moves, and would make the header mean what readers think it means."
  !probe{ "move the emit card below another frame in copies of ten cut surfaces and check which tools still read the axes" =id[p_lab_particle_file_scope] =kind[build] }
  raised_by: #[ c_programmers, educators_community, creators, physics ]
  breaks: "a Rust inner attribute says which item it covers; a Spw header stack has only adjacency, so the analogy holds for intent and fails for scope"
  $%[particle.deixis]
  ~"./particle-lattice.spw#spw_theory_particle_header_binds_card" ~#neighbor(nearest)
 }
 #>spw_theory_particle_digit_q
 ?["Should case and mood names be allowed to start with a digit?"]{
  #:depth #!educational ~#lens(applied attention)
  #:claim #!speculative
  ~#hypothesis: "Writers from crews, clinics, and classrooms reach for codes like 12a or K-5 as moods, so a visible diagnostic would help them more than either rule chosen silently."
  !probe{ "grep the corpus and the persona specimens for #! or #> followed by a digit and record what each writer meant" =id[p_lab_particle_digit_census] =kind[census] }
  raised_by: #[ production_crews, life_clinical, social_scientists, creators, physics, educators_community, c_programmers ]
  $%[particle.mood]
  ~"./particle-lattice.spw#spw_theory_particle_digit_drop" ~#neighbor(nearest)
 }
 #>spw_theory_particle_names_q
 ?["Which name should each aim carry in docs and hovers?"]{
  #:depth #!educational ~#lens(semiotic charge)
  #:claim #!speculative
  ~#hypothesis: "Keeping the grammatical names and pairing each with one plain gloss should confuse fewer readers than renaming, since case already collides with switch-case."
  !probe{ "ask readers from three fields to predict what #:x does under each naming before any name is explained" =id[p_lab_particle_naming] =kind[interview] }
  raised_by: #[ linguists, mathematicians, c_programmers, engineers_chemists, educators_community, designers, creators ]
  $%[particle.case]
  ~"./particle-lattice.spw#spw_theory_particle_three_names" ~#neighbor(nearest)
 }
 #>spw_theory_particle_pair_q
 ?["Should a case and the mood after it form one pair node?"]{
  #:depth #!computational ~#lens(information flow)
  #:claim #!speculative
  ~#hypothesis: "A pair node would let facet queries read #:k #!v as one key and value, which atlas and census count apart today."
  !probe{ "write a selector that pairs adjacent case and mood particles and compare its counts with atlas buckets on this cut" =id[p_lab_particle_pair_selector] =kind[build] }
  raised_by: #[ librarians, social_scientists, designers ]
  $%[particle.case, particle.mood]
  ~"./particle-lattice.spw#spw_theory_particle_three_names" ~#neighbor(nearest)
 }
}

^["routing"]{
 mood_as_status: "whether #! should carry epistemic status lives in the epistemic status surface"
 anchors_as_addresses: "how anchors serve as link targets lives in the address surface"
}

#>spw_theory_particle_predict_q
?["Can a reader predict a binding before the tool shows it?"]{
 #:depth #!experiential ~#lens(applied attention)
 #:claim #!speculative
 ~#hypothesis: "Readers predict forward binding correctly in header stacks and miss it inside frame bodies, where container reading feels natural."
 !probe{ "show readers six short surfaces, ask what each particle run marks, then reveal the binding" =id[p_lab_particle_predict] =kind[field] }
 $%[particle.deixis, particle.case, particle.mood]
 ~"./particle-lattice.spw#spw_theory_particle_forward" ~#neighbor(nearest)
}
