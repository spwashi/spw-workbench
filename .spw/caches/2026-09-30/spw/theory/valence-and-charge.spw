# Valence and Charge
#
# The valence pentad read five ways: as charge-neutral material in canon, as hazard and error in code, as merit in the editor palette, as edge direction in bias, and as emotional charge in the raw generation.

#>spw_theory_valence
#:layer #!semantics
#:domain #!spw_theory
#:form #!ledger
#:level #!advanced
#:review #!adversarial_checked
#:valence #!bonk

^"emit"{
 ~#title: "Valence and Charge"
 ~#claim: "Canon calls the five valences charge-neutral material quality, while the code catalog, the editor palette, and bias edges read the same words as hazard, merit, or direction."
 ~#proof: "Each reading cites its canon or code line at commit 1aa1dc23 and names what a reader can observe and where the reading stops."
 ~#door: "Start with the canon reading, then the code catalog beside it; the owner hold closes the ledger."
 ~#audience: "the Spw owner, palette and plugin authors, and readers meeting the pentad"
 continuity: "Valence and Charge | material quality"
 cold_open: "Canon says the five valences name material quality, yet the code and the palette keep reading them as merit."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/language-features/spw-resonance.spw" ]
 lineage_note: "the raw file is kept as drift evidence only; no claim here uses it as a source"
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the raw generation read valence as emotional and operational charge with one word meaning danger; canon calls the pentad charge-neutral material quality, so that reading is recorded as refuted",
  "the raw generation wrote = as constraint; canon reads = with a body as a neutral bias edge, which this ledger uses for the direction reading",
  "the palette claim quoted the catalog phrase telemetry alert; the package.json descriptions say telemetry and high-priority signal, and the claim now follows them",
  "the false friend claim was marked settled and spoke of readers; it rests on one study of simulated personas, so it is now emerging, and the binding-key hazard is its own claim"
 ]
}

^["edges"]{
 grounds: [ ~"docs/theory/spw/valence-architecture.spw", ~".spw/registries/bias-product.spw#spw_bias_product" ]
 analog: [ ~"../../society/communities/semiotic-charge.spw#communities_semiotic_charge" ]
 see: [ ~"./epistemic-status.spw#spw_theory_epistemic_status" ]
}

^["concepts"]{
 primary: [ #valence_pentad, #material_quality ]
 transfers: [ #semiotic_charge ]
 tensions: [ #merit_reading ]
}

^["ledger"]{
 #>spw_theory_valence_canon
 ^["canon_material"]{
  #:claim #!settled
  statement: "Canon calls the five valences charge-neutral descriptions of material quality, not moral judgment, and holds that no valence is inherently good or bad."
  observable: "the pentad comment and the charge_neutrality principle in the valence architecture"
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_valence"
  cites: [ "docs/theory/spw/valence-architecture.spw:38-39", "docs/theory/spw/valence-architecture.spw:115" ]
  label: "a-canon"
  ^["limits"]{
   holds: "as a statement of intent for components and surfaces"
   fails: "the same file writes positive and negative charge fields and a glow effect, which invite the merit reading it rejects"
  }
 }
 #>spw_theory_valence_canon_wording
 ^["canon_own_wording"]{
  #:claim #!settled
  statement: "The canon entries give one valence a positive charge with a glow effect and another a negative charge, each with a not-merely clause, and compare the set to electron charge."
  observable: "the charge and effect fields in the pentad frame"
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_valence"
  cites: [ "docs/theory/spw/valence-architecture.spw:39", "docs/theory/spw/valence-architecture.spw:43-44", "docs/theory/spw/valence-architecture.spw:53" ]
  ^["limits"]{
   holds: "as metaphor beside an observable mapping"
   fails: "a reader who skips the not-merely clause keeps only the sign"
  }
 }
 #>spw_theory_valence_runtime
 ^["runtime_bridge"]{
  #:claim #!settled
  statement: "Canon splits a four-state runtime quality axis from the five-word pentad and keeps the fifth word as an overlay, with a falsifier if runtime types add it."
  observable: "the runtime_bridge frame with its falsify line"
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_valence", ~"../../registries/sources/spw-design-studies.spw#src_lab_code_runtime_valence" ]
  cites: [ "docs/theory/spw/valence-architecture.spw:30-35", "packages/spw-runtime/src/state/types.ts:41", "packages/spw-seed/src/types/token.ts:20" ]
  ^["limits"]{
   holds: "register geometry and runtime quality as canon describes them"
   fails: "RuntimeValence aliases ModifierKind, which has all five words, so the falsifier may have fired; whether that type is the base quality axis is for the owner"
  }
 }
 #>spw_theory_valence_catalog
 ^["code_catalog"]{
  #:claim #!settled
  statement: "The seed catalog gives each valence a status role: growth and implemented, hazard and error, scaffold and partial, conflict and interruption, signal and telemetry."
  observable: "VALENCE_PARTICLES role and description strings"
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_code_valence_catalog"
  cites: [ "packages/spw-seed/src/canonical/catalog.ts:44-49" ]
  label: "code at 1aa1dc23"
  ^["limits"]{
   holds: "any tool that reads roles from the catalog"
   fails: "canon prose, which rejects these merit and status roles"
  }
 }
 #>spw_theory_valence_palette
 ^["editor_palette"]{
  #:claim #!settled
  statement: "The VS Code extension contributes valence colors described as growth and implemented state, hazard and error state in red, scaffold and partial state, conflict, and telemetry signal."
  observable: "the five spw.valence color contributions"
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_code_vscode_palette", ~"../../registries/sources/spw-design-studies.spw#src_lab_study_render" ]
  cites: [ "extensions/vscode-spw/package.json:249-253" ]
  reads: %[lab.palette.bone_light_contrast_ratio, lab.palette.wcag_aa_text_min_ratio]
  ^["limits"]{
   holds: "editor decorations at the default theme colors"
   fails: "the cut contract lets no meaning depend on color, so in print the palette carries nothing"
  }
 }
 #>spw_theory_valence_direction
 ^["edge_direction"]{
  #:claim #!settled
  statement: "The bias product uses the pentad as the sign of a directed edge, one word leaning forward and another inverse, and spw mutate applies or reverts an anchored edge by that sign."
  observable: "the valence slot and the mutate verb in the bias product registry"
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_bias_product"
  cites: [ ".spw/registries/bias-product.spw:19", ".spw/registries/bias-product.spw:33" ]
  ^["limits"]{
   holds: "edges read by mount, mutate, and expand"
   fails: "a direction is not a quality, so one word now does two jobs"
  }
 }
 #>spw_theory_valence_false_friend
 ^["reader_misreading"]{
  #:claim #!emerging
  statement: "In the persona study, simulated readers from all twelve persona clusters read the five words as merit, status, sign, or alarm."
  observable: "false friend rank 8 in the persona study"
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_study_persona"
  ^["limits"]{
   holds: "simulated readers in one persona study"
   fails: "no live reader has been observed; the misreading rates are not measured"
  }
 }
 #>spw_theory_valence_key_hazard
 ^["valence_key_hazard"]{
  #:claim #!settled
  statement: "Written as binding keys, the five valence words degrade a whole surface to prose, so the cut contract lists them as a hazard."
  observable: "the valence_keys hazard in the contract"
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_cut_contract"
  label: "a-cut"
 }
 #>spw_theory_valence_raw_reading
 ^["raw_emotional_charge"]{
  #:claim #!refuted
  statement: "The raw generation described valence as emotional and operational charge, with one word meaning danger; canon rejects that reading, and the scorecard flagged it."
  observable: "the scorecard row for spw-resonance"
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_study_scorecard"
  counter: ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_valence"
 }
 #>spw_theory_valence_owner_hold
 ^["owner_hold"]{
  #:claim #!settled
  statement: "The owner keeps charge, what kind of difference, off the visit arc, how far along, and asks that valence never map onto spirit-cycle phases."
  observable: "the do list of the 2026-09-30 resume note"
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_owner_direction"
  cites: [ ".spw/caches/resume/2026-09-30-direction.spw:67" ]
  label: "owner hold"
  ~#say(charge stays off the visit arc)
 }
}

^["readings"]{
 #>spw_theory_valence_two_axes
 ^["two_axes"]{
  #:claim #!interpretive
  statement: "The ledger shows two axes sharing five words: a quality axis canon intends and a status-and-sign axis the code uses, so a separate sign vocabulary would free the pentad."
  limit: "an interpretation of the ledger above, not a canon decision"
 }
 #>spw_theory_valence_palette_problem
 ^["palette_merit_problem"]{
  #:claim #!interpretive
  statement: "While one valence is drawn in error red and the descriptions say hazard, a reader learns merit from the editor faster than material quality from canon."
  limit: "no reader study measures which lesson wins"
 }
}

^["questions"]{
 sign_words: "Should edge sign get its own words so the pentad names quality alone?"
 catalog: "Should the catalog roles be rewritten as material descriptions, or should canon accept status as a second reading?"
 keys: "Should a valence word followed by a colon read as a key, so bone and honk can name fields?"
 order: "Is the pentad ordered or categorical, and may a surface carry two valences?"
}

#>spw_theory_valence_palette_q
?["What palette shows material quality without implying merit?"]{
 #:depth #!stylistic ~#lens(semiotic charge)
 #:claim #!speculative
 ~#hypothesis: "Swatches chosen by texture or hue family without red and green read as material, so fewer readers pick one valence as the error."
 !probe{ "show readers five unlabeled swatches from each candidate palette and ask which one marks a mistake" =id[p_lab_valence_palette] =kind[interview] }
 $%[lab.palette.bone_light_contrast_ratio, lab.palette.wcag_aa_text_min_ratio]
 ~"./valence-and-charge.spw#spw_theory_valence_palette" ~#neighbor(nearest)
}

#>spw_theory_valence_drift_q
?["Do valence words drift toward merit the way role words gain charge?"]{
 #:depth #!social ~#lens(semiotic charge)
 #:claim #!speculative
 ~#hypothesis: "Each tool that maps a valence to a status pushes the word toward merit, as repeated use pushed some role words toward praise or blame."
 !probe{ "list every repository file that maps a valence word to a status or color, with its commit date, and order them in time" =id[p_lab_valence_drift] =kind[census] }
 breaks: "role words drift through many speakers; valence words are set by one owner who can rewrite canon and code in one commit"
 $%[op.distribution]
 ~"./valence-and-charge.spw#spw_theory_valence_catalog" ~#neighbor(nearest)
}
