# Clustering Hybrid
#
# The ocean biome names five different things at once. This surface sets each against a hybrid of authored tree, closed facets, typed edges, and computed clusters, and keeps the swap a set of questions.

#>spw_theory_clustering
#:layer #!semantics
#:domain #!spw_theory
#:form #!comparison
#:level #!advanced
#:review #!sourced
#:valence #!bonk

^"emit"{
 ~#title: "Clustering Hybrid"
 ~#claim: "Ocean is a module layout, a metaphor atlas, a runtime stability channel, a cache-tier contract, and an unbuilt cluster sketch, so a hybrid could replace only the atlas and the sketch."
 ~#proof: "Each ocean layer cites its canon file or code line at 1aa1dc23; the hybrid follows the cut contract and the plan index precedent."
 ~#door: "Read the ocean matrix, then the hybrid layers, then the two questions at the end."
 ~#audience: "the Spw owner and anyone organizing a large Spw corpus"
 continuity: "Clustering Hybrid | replace only the atlas"
 cold_open: "Ocean means five things at once, and a hybrid could replace only the atlas and the unbuilt cluster sketch."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  ".agents/plans/caches-cut-2026-09-30/references/understand/ocean_cluster.md at 229aedcf",
  "code and canon lines reread by the writer at 1aa1dc23 on 2026-10-02"
 ]
 standing: "pressure surface for the owner; the hybrid as a successor to ocean is a proposal, and nothing here edits canon"
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["edges"]{
 needs: [ ~"../../record/information/knowledge-organization.spw#information_science_knowledge_org" ]
 grounds: [ ~"docs/theory/spw/cache-field.spw#cache_field", ~".spw/biome/ocean/atlas.spw#spw_ocean_biome_atlas" ]
 see: [ ~"../../record/information/taxonomy-cautions.spw#information_science_cautions_facets", ~"./measures-and-handles.spw#spw_theory_measures_why_closed" ]
}

^["concepts"]{
 primary: [ #faceted_classification, #computed_cluster, #ocean_biome ]
 transfers: [ #plan_index ]
 tensions: [ #metaphor_overload ]
}

^["ocean_matrix"]{
 ^["legend"]{
  columns: #[ what, status, hybrid_layer, cost_to_retire ]
  as_of: "commit 1aa1dc23"
 }
 #>spw_theory_clustering_row_layout
 ^["module_layout"]{
  what: "a nursery layout of modules such as algos, expr, ops, query, style, and phase"
  status: "canon; consumer biomes mirror the shape"
  hybrid_layer: "tree, the one authored parent used for finding"
  cost_to_retire: "the LSP reads tiers from these directory names"
 }
 #>spw_theory_clustering_row_atlas
 ^["metaphor_atlas"]{
  what: "six sub-biomes such as reef and pelagic, each with a library physics"
  status: "doc only; no package or script reads the sub-biome names"
  hybrid_layer: "facets and lenses, closed values that recur"
  cost_to_retire: "low; nothing executes it"
 }
 #>spw_theory_clustering_row_channel
 ^["stability_channel"]{
  what: "ocean as a runtime stability channel with high volatility and a regional dialect tag"
  status: "code"
  hybrid_layer: "none; runtime law outside the reading hybrid"
  cost_to_retire: "a rename touches runtime sessions and seed granularity"
 }
 #>spw_theory_clustering_row_tiers
 ^["cache_tiers"]{
  what: "hot, warm, and cold retention tiers counted in beats, and LSP tiers chosen by path substrings"
  status: "code, with canon naming the planes"
  hybrid_layer: "none; retention is not classification"
  cost_to_retire: "cut paths must avoid the substrings the LSP matches"
 }
 #>spw_theory_clustering_row_root
 ^["hard_coded_root"]{
  what: "the @biome root resolves to .spw/biome/ocean in the LSP defaults"
  status: "code"
  hybrid_layer: "none"
  cost_to_retire: "every @biome link moves with a rename"
 }
 #>spw_theory_clustering_row_sketch
 ^["cluster_sketch"]{
  what: "cluster keys, a weighted-overlap distance, and cluster ids with a cohesion score"
  status: "aspirational; no implementation found"
  hybrid_layer: "computed clusters, held as prompts"
  cost_to_retire: "a generator must be built before anything is retired"
 }
}

^["ocean_facts"]{
 #>spw_theory_clustering_channel
 ^["runtime_channel"]{
  #:claim #!settled
  statement: "Ocean is a runtime stability channel with volatility 0.8, against 0.3 for an unknown channel, and Spw.o is its regional dialect tag."
  reads: %[lab.ocean.channel_volatility]
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_code_granularity", ~"../../registries/sources/spw-design-studies.spw#src_lab_code_channels" ]
  cites: [ "packages/spw-seed/src/ir/granularity.ts:160-168", "packages/spw-runtime/src/session/channels.ts:21", "packages/spw-runtime/src/session/channels.ts:51" ]
 }
 #>spw_theory_clustering_tiers
 ^["tier_contract"]{
  #:claim #!settled
  statement: "Canon names retention planes whose evaluate plane keeps hot, warm, and cold tiers of 8, 64, and 256 beats, while the LSP picks a tier from substrings such as query and algos in the path."
  reads: %[lab.ocean.hot_ttl_beats, lab.ocean.warm_ttl_beats, lab.ocean.cold_ttl_beats]
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_cache_field", ~"../../registries/sources/spw-design-studies.spw#src_lab_code_lsp_tiers" ]
  cites: [ "docs/theory/spw/cache-field.spw:3", "docs/theory/spw/cache-field.spw:37-83", "packages/spw-lsp/src/server-index.ts:913-921" ]
 }
 #>spw_theory_clustering_root
 ^["biome_root"]{
  #:claim #!settled
  statement: "The LSP default roots map @biome to the ocean directory under .spw/biome, so the name ocean is also an address."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_code_lsp_helpers"
  cites: [ "packages/spw-lsp/src/helpers.ts:123" ]
 }
 #>spw_theory_clustering_sketch_only
 ^["sketch_only"]{
  #:claim #!settled
  statement: "The ocean cluster algorithm lists keys, a distance, and a cohesion output, and a search of packages and scripts finds no code that computes them."
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_ocean", ~"../../registries/sources/spw-design-studies.spw#src_lab_study_ocean" ]
  cites: [ ".spw/biome/ocean/algos/cluster.spw:12-16" ]
 }
 #>spw_theory_clustering_scrutiny
 ^["raw_scrutiny"]{
  #:claim #!settled
  statement: "The raw caches index lists editor and platform catalogs as residue, leads with language, mathematics, physics, linguistics, and cognition, and grants retention to a cache that names its wire and cost."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_caches_index"
  cites: [ ".spw/caches/index.spw:92-96" ]
 }
}

^["hybrid"]{
 ^["layers"]{
  tree: "authored; one parent per surface; for finding, not meaning"
  facets: "authored; closed vocabularies that recur across the tree"
  edges: "authored; typed pointers that are claims and must be defensible"
  clusters: "computed; prompts to compare, never claims"
 }
 #>spw_theory_clustering_prompts
 ^["clusters_are_prompts"]{
  #:claim #!settled
  statement: "This cut treats computed clusters as prompts to compare and never as claims, and keeps meaning in typed edges between anchors."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_cut_contract"
  label: "a-cut"
 }
 #>spw_theory_clustering_plan_precedent
 ^["plan_index_precedent"]{
  #:claim #!settled
  statement: "The plan index already runs the hybrid: an authored lane glyph per card, a closed phase set, and computed kin written as a prompt, with guards that keep hub plans out of kinship."
  sources: [ ~"../../registries/sources/spw-design-studies.spw#src_lab_code_plan_index", ~"../../registries/sources/spw-design-studies.spw#src_lab_canon_plan_schema" ]
  cites: [ "scripts/plans/plan-index.ts:41-48", ".agents/plans/_schema/wip.spw:107-108" ]
 }
 #>spw_theory_clustering_facets
 ^["faceted_precedent"]{
  #:claim #!settled
  statement: "Ranganathan built Colon Classification from facets combined at classing time, an Indian library tradition that let new subjects be placed without a fixed enumerated slot."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_ranganathan_1933"
  see: [ ~"../../record/information/knowledge-organization.spw#information_science_ko_colon" ]
 }
 #>spw_theory_clustering_infrastructure
 ^["classification_consequences"]{
  #:claim #!settled
  statement: "Bowker and Star argue that classification systems become infrastructure whose choices make some work and people visible and others invisible."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_bowker_star_1999"
 }
 #>spw_theory_clustering_style_not_topic
 ^["style_not_topic"]{
  #:claim #!settled
  statement: "In the understand pass, graph strands scored a thermodynamics corpus near 0.97 sigil cosine against both live-streaming and economics corpora, so strands measured notation style, not topic."
  source: ~"../../registries/sources/spw-design-studies.spw#src_lab_study_ocean"
  as_of: "229aedcf"
 }
 #>spw_theory_clustering_proposal
 ^["successor_proposal"]{
  #:claim #!speculative
  statement: "A hybrid of authored tree, closed facets, typed edges, and computed clusters could replace the metaphor atlas and the cluster sketch, while channel, tiers, and the root stay where they are."
  test: "build a cluster prompt pass over this cut and ask whether its groups lead a reader to edges the authors missed"
 }
}

^["questions"]{
 rename: "Should the runtime channel and Spw.o keep the name ocean once the atlas retires, or take a name that says stability?"
 derived_marker: "How should a surface mark a computed frame as derived, now that only a comment says so?"
 set_or_confluence: "Is an authored grouping a #[ ] set and a computed cluster an & confluence, or does that overload two sigils?"
 tree_is_meaning: "How do readers whose tree is the meaning, such as syntax trees and finding aids, keep their structure in a cut where the tree is for finding?"
}

#>spw_theory_clustering_agree_q
?["Would computed clusters point at edges the authors missed?"]{
 #:depth #!computational ~#lens(curated collection)
 #:claim #!speculative
 ~#hypothesis: "Clusters from shared facets and co-cited sources would group some surfaces that share no authored edge, and a reader shown those pairs would add a few defensible edges."
 !probe{ "compute shared-facet and co-citation pairs over this cut, drop pairs already joined by an edge, and ask two readers which remaining pairs deserve one" =id[p_lab_clustering_missed_edges] =kind[build] }
 $%[graph.in_degree, graph.out_degree]
 ~"./clustering-hybrid.spw#spw_theory_clustering_prompts" ~#neighbor(nearest)
}

#>spw_theory_clustering_lens_q
?["Is ocean better read as a lens than as a structure?"]{
 #:depth #!stylistic ~#lens(ecological zone)
 #:claim #!speculative
 ~#hypothesis: "Keeping ocean as one recurring lens value and dropping it as a directory metaphor would cost readers little and free the name for its runtime meaning."
 !probe{ "list every reader-facing use of ocean in canon and sort each into lens, layout, channel, tier, or root" =id[p_lab_clustering_ocean_uses] =kind[census] }
 breaks: "an ecological zone is one place an organism lives; a surface lives in one directory and under many lenses at once"
 $%[lab.ocean.channel_volatility]
 ~"./clustering-hybrid.spw#spw_theory_clustering_row_atlas" ~#neighbor(nearest)
}
