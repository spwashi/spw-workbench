# False Friend Lab
#
# Field habits fed to the parser and ranked by how loudly they fail, from a clean bridge through silent restructuring to a surface that degrades, read from the specimen batteries.

#>spw_lab_false_friend
#:layer #!pragmatics
#:domain #!spw
#:form #!probe_battery
#:level #!foundation
#:review #!sourced
#:valence #!honk

^"emit"{
 ~#title: "False Friend Lab"
 ~#claim: "Ranked by how loudly they fail, most habits pasted into Spw go wrong in silence, and a parser fix helps when it moves a row toward a loud failure or a clean bridge."
 ~#proof: "The six specimen batteries were parsed at commit 1aa1dc23 and their tallies are glossary registry cells; Koessler and Derocquigny named the false friend in 1928."
 ~#door: "Pick a habit from your own field, predict its rung on the ladder, then open the specimen row that matches it."
 ~#audience: "people arriving with habits from code, mathematics, design, the lab, the library, or media"
 continuity: "False Friend Lab | how loudly"
 cold_open: "Every habit you bring is ranked by how loudly it fails, and the quiet failures are the ones to watch."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new", "persona study contraption_catalog[0], references/studies/persona-synthesis.json", "sketch references/spw-branch/seeds/contraptions/false-friend-lab.spw" ]
 method: #authored
 evidence: #[
  "verdicts in the six specimen batteries were tallied per battery on 2026-10-03",
  "the canon naming line and the canon spaced bias line were parsed and read with readBias at commit 1aa1dc23 on 2026-10-03"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 persona study", care: #skim, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the persona ladder ordered rungs by feel; here the order follows which tool reports a row: none, the cut gate, or the validator",
  "the sketch kept habits in single-quoted strings, which the cut bans; habits live once in the specimen rows and this lab links them",
  "the sketch omitted the drops rung that the specimens record; it sits with the silent rungs"
 ]
}

^["edges"]{
 grounds: [ ~"../specimens/code-habits.spw#spw_spec_code_observed" ]
 feeds: [ ~"./kerning.spw#spw_lab_kerning" ]
 see: [ ~"../glossary/false-friends.spw#spw_false_friends" ]
}

^["concepts"]{
 primary: [ #false_friend, #notation ]
 transfers: [ #reflexive_mirror ]
 tensions: [ #overclaim ]
}

^["tool"]{
 status: #proposed
 verb: "spw lab false-friends, which would replay every specimen row and fail when a signature or a rung changes; not yet a command"
 implemented: #[
  "packages/spw-cli/src/commands.ts:284 spw fingerprint, which counts node types for one surface or stdin",
  "scripts/analyzers/spw-cut-gate.ts:193-195 the cut gate, which fails on parse errors, warnings, and prose fallback"
 ]
 run_today: "pipe one habit line into npm run spw -- fingerprint --stdin --json and read errorCount and the signature"
 sources: [ ~"../../registries/sources/spw-contraptions.spw#src_contrap_code_cli", ~"../../registries/sources/spw-contraptions.spw#src_contrap_code_gate" ]
}

^["parameters"]{
 #>spw_lab_false_friend_ladder
 ^["ladder"]{
  rungs: << bridge ; restructures ; splits ; drops ; hidden_error ; swallows ; degrades >>
  ^["heard_by"]{
   nothing: #[ bridge ]
   no_tool: #[ restructures, splits, drops ]
   cut_gate: #[ hidden_error, swallows ]
   validator: #[ degrades ]
  }
  ~#(a rung names what the parser did; heard_by names which tool says so)
 }
 bridge: "a habit that parses into the tree its author meant, the specimen verdict clean"
 better: "a row improves when it moves toward a loud rung or onto the bridge; a quiet restructure is the worst place to stay"
}

^["world"]{
 #>spw_lab_false_friend_term
 ^["term"]{
  #:claim #!settled
  statement: "Koessler and Derocquigny named faux amis in 1928: words that look alike in two languages but differ in meaning, a known trap for translators."
  source: ~"../../registries/sources/spw-contraptions.spw#src_contrap_koessler_1928"
 }
 #>spw_lab_false_friend_tally
 ^["tally"]{
  #:claim #!settled
  statement: "Of the specimen rows, most draw no report from any tool, and the silent wrong trees outnumber every row the gate and the validator report together."
  reads: %[
   gloss.spec.rows_n,
   gloss.spec.silent_n,
   gloss.spec.gate_n,
   gloss.spec.validator_n
  ]
  source: ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_parser_probes"
  ~#(on 2026-10-03 the silent rows held nineteen clean bridges and sixty wrong trees)
 }
 #>spw_lab_false_friend_loudest
 ^["loudest_battery"]{
  #:claim #!settled
  statement: "Media and classroom habits form the loudest battery, and most of its gate-loud rows are typographic characters outside ASCII such as curly quotes, dashes, and currency signs."
  source: ~"../../registries/sources/spw-glossary-specimens.spw#src_gloss_parser_probes"
  see: [ ~"../specimens/media-and-classroom.spw#spw_spec_media_classroom_curly_quotes" ]
  observed: "on 2026-10-03, 13 of 22 media rows were loud, and six of its ten gate-loud rows were outside ASCII"
 }
}

#>spw_lab_false_friend_rows
^["rows"]{
 ^["bridge"]{
  rung: #bridge,
  specimen: ~"../specimens/math-physics-notation.spw#spw_spec_math_physics_backtick_phrase"
 }
 ^["restructures"]{
  rung: #restructures,
  specimen: ~"../specimens/code-habits.spw#spw_spec_code_ternary"
 }
 ^["splits"]{
  rung: #splits,
  specimen: ~"../specimens/code-habits.spw#spw_spec_code_hex"
 }
 ^["drops"]{
  rung: #drops,
  specimen: ~"../specimens/media-and-classroom.spw#spw_spec_media_classroom_heading"
 }
 ^["hidden_error"]{
  rung: #hidden_error,
  specimen: ~"../specimens/code-habits.spw#spw_spec_code_negative"
 }
 ^["swallows"]{
  rung: #swallows,
  specimen: ~"../specimens/code-habits.spw#spw_spec_code_generic"
 }
 ^["degrades"]{
  rung: #degrades,
  specimen: ~"../specimens/lab-and-data.spw#spw_spec_lab_data_p_threshold"
 }
 ~#(one specimen per rung; its battery keeps the detail)
}

^["battery"]{
 #>spw_lab_false_friend_rank
 ^["rank_a_battery"]{
  !probe{ "tally each specimen battery by rung and order the batteries by their share of loud rows" =id[p_contrap_false_friend_rank] =kind[census] }
  predict: ?{ "which battery is loudest, and why" } ~<guess>
  expect: "media and classroom first, because its typographic characters raise lexer errors; design tokens last, with most rows silent"
  shows: ~"./false-friend-lab.spw#spw_lab_false_friend_loudest"
 }
 #>spw_lab_false_friend_move
 ^["move_a_row"]{
  !probe{ "after any parser change, replay every row and list those whose rung changed, in which direction" =id[p_contrap_false_friend_move] =kind[calc] }
  expect: "a good change moves rows down the ladder toward degrades or up onto the bridge, and never from a loud rung into a silent one"
  shows: ~"./false-friend-lab.spw#spw_lab_false_friend_ladder"
 }
}

#>spw_lab_false_friend_mirror
^["language_mirror"]{
 question: "Which canon lines restructure silently in the parser that canon describes?"
 instrument: "feed canon example lines through the same ladder and record their rung"
 ^["canon_rows"]{
  #>spw_lab_false_friend_canon_names
  ^["naming_table"]{
   #:claim #!settled
   statement: "The canon name table writes a sigil, an equals sign, and a name; the parser reads a literal, then a separate equals operation carrying the name, so no sigil binds to its name."
   rung: #restructures,
   canon: "docs/theory/spw/operators.spw:28-42"
   source: ~"../../registries/sources/spw-contraptions.spw#src_contrap_parse_runs"
  }
  #>spw_lab_false_friend_canon_bias
  ^["spaced_bias"]{
   #:claim #!settled
   statement: "The spaced bias example in the flow protocol sigils parses without error, yet readBias returns no edge for it, so canon teaches a form the edge reader ignores."
   rung: #restructures,
   canon: "docs/theory/spw/flow-protocol-sigils.spw:37,66"
   sources: [ ~"../../registries/sources/spw-contraptions.spw#src_contrap_canon_flow_sigils", ~"../../registries/sources/spw-contraptions.spw#src_contrap_parse_runs" ]
   see: [ ~"./kerning.spw#spw_lab_kerning_open" ]
  }
 }
 standing: "a-canon: both lines are canon text; a-cut: the rung is this lab reading at one commit"
 !probe{ "run every example line in the canon theory files through the ladder and count rungs" =id[p_contrap_false_friend_canon] =kind[census] }
}

^["limits"]{
 holds: "the rung of one string, with the line that follows it, parsed at one commit"
 fails: "a row says nothing about how strongly a habit pulls a reader, how habits combine, or whether a reader would notice; tools here count rows and never readers"
}

^["try"]{
 #>spw_lab_false_friend_try
 ^["own_habit"]{
  materials: [ "a terminal at the repository root", "three notations you type every week" ]
  steps: << "write one line in each notation as a key and a value" ; "write down the rung you predict for each" ; "pipe each line into npm run spw -- fingerprint --stdin --json" ; "find the nearest specimen row and compare" >>
  time: .{ n: 20, unit: "minutes" }
  safety: "no hazard worth naming; keep scratch lines outside the cut"
  shows: ~"./false-friend-lab.spw#spw_lab_false_friend_ladder"
 }
}

#>spw_lab_false_friend_q
?["Which single parser rule would move the most silent rows to a loud rung?"]{
 #:depth #!computational ~#lens(formal structure)
 #:claim #!speculative
 ~#hypothesis: "A rule that flags an operator sigil right after a binding value on the same line should move more silent rows than any other single rule, since infix habits fill the restructures rung."
 !probe{ "prototype candidate rules on a copy of the parser and count specimen rows that change rung under each" =id[p_contrap_false_friend_q] =kind[sim] }
 $%[gloss.spec.silent_n, gloss.spec.rows_n]
 ~"./false-friend-lab.spw#spw_lab_false_friend_tally" ~#neighbor(nearest)
 breaks: "a louder rule can also break canon lines that rely on the same shape, so a count of moved rows is not yet a verdict"
}
