# Linguistics
#
# The linguistics branch: sounds, words and sentences, meaning and use, variation and documentation, and change over time.

#>linguistics_index
#:layer #!reference
#:domain #!linguistics
#:form #!index
#:level #!foundation
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Linguistics"
 ~#claim: "Linguistics studies language as a rule-governed system in minds and communities, from sound waves to sound change."
 ~#proof: "Five leaves, each with sourced keystone claims and a corrections list against the raw generation."
 ~#door: "Start with phonetics and phonology if you have a microphone, or with historical linguistics if you like a detective story."
 ~#audience: "curious readers and students starting a linguistics sequence"
 continuity: "Linguistics | rule-governed system"
 cold_open: "Linguistics treats every language as a rule-governed system, from the sound waves of speech to the slow drift of words."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/linguistics/taste.spw", ".spw/caches/university-education/linguistics/index.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: [
  "the raw taste file called large language models n-gram predictors; that claim is dropped as false of transformer models",
  "the raw taste file said every child induces grammar effortlessly from impoverished input; that is a contested position, kept below as a stance with its counter",
  "the raw taste file said signed and spoken languages share the exact same architecture; the Nicaraguan case in the sociolinguistics leaf states what is shared"
 ]
}

^["tree"]{
 phonology: ~"./phonetics-and-phonology.spw"
 syntax: ~"./morphology-and-syntax.spw"
 semantics: ~"./semantics-and-pragmatics.spw"
 sociolinguistics: ~"./sociolinguistics-and-documentation.spw"
 historical: ~"./historical-linguistics.spw"
}

^["bundle"]{
 ={
  ~"./phonetics-and-phonology.spw#linguistics_phonology"
  ~"./morphology-and-syntax.spw#linguistics_syntax"
  ~"./semantics-and-pragmatics.spw#linguistics_semantics"
  ~"./sociolinguistics-and-documentation.spw#linguistics_sociolinguistics"
  ~"./historical-linguistics.spw#linguistics_historical"
 }
}

^["order"]{
 facets: "leaves listed by domain, then matter, then form, then era, as in the class index"
 path: << "phonetics and phonology" ; "morphology and syntax" ; "semantics and pragmatics" ; "sociolinguistics and documentation" ; "historical linguistics" >>
}

^["stance"]{
 #>linguistics_index_descriptive
 ^["descriptive_humility"]{
  #:claim #!interpretive
  statement: "Linguists describe how people speak before anyone ranks it, so no variety is treated as broken or lazy speech."
 }
 #>linguistics_index_infinity
 ^["finite_means"]{
  #:claim #!interpretive
  statement: "A finite stock of sounds or signs and rules yields an unbounded set of new sentences, which is the puzzle syntax keeps returning to."
 }
 #>linguistics_index_acquisition
 ^["learning_from_input"]{
  #:claim #!contested
  statement: "Whether children need an innate grammar-specific bias to learn syntax from the input they hear remains a live dispute."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_crain_nakayama_1987"
  counter: ~"../../registries/sources/language-and-communities.spw#src_lang_pullum_scholz_2002"
 }
}

^["gaps"]{
 acquisition: "first- and second-language acquisition has no leaf yet; it would sit between cognitive development and phonetics"
 typology: "a typology leaf would hold Greenberg correlations now parked in historical linguistics"
 signed_languages: "signed-language phonology and grammar deserve their own leaf beyond one case"
}
