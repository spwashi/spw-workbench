# Morphology and Syntax
#
# How words are built from morphemes and sentences from constituents, compared across five grammar frameworks, with Ross islands as the shared test case.

#>linguistics_syntax
#:layer #!reference
#:domain #!linguistics
#:form #!comparison
#:level #!advanced
#:review #!sourced
#:valence #!bonk

^"emit"{
 ~#title: "Morphology and Syntax"
 ~#claim: "Sentences have hierarchical constituent structure, and five frameworks model it differently; island constraints are the test case they all must meet."
 ~#proof: "Islands from Ross 1967; frameworks from Chomsky, Pollard and Sag, Kaplan and Bresnan, Goldberg, and Tesniere."
 ~#door: "Compare how each framework handles a question word far from its verb, then read the island ledger."
 ~#audience: "readers who have taken an introductory linguistics course"
 continuity: "Morphology and Syntax | island constraints"
 cold_open: "Five grammar frameworks draw sentences differently, and island constraints are the shared test every one of them must pass."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/linguistics/morphology-and-syntax.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: [
  "the raw file credited island domains to Ross yet explained them by the Phase Impenetrability Condition; Ross named the islands in 1967, and phases are a Minimalist account from 2000",
  "the raw file presented only the Minimalist Program; HPSG, LFG, construction grammar, and dependency grammar are added as peers",
  "the raw hypothesis that syntax has no access to linear order is kept only as a contested position with a counter-account",
  "X-bar as a universal template for every category is restated as a hypothesis of one framework family"
 ]
}

^["edges"]{
 needs: [ ~"./phonetics-and-phonology.spw#linguistics_phonology_phoneme" ]
 feeds: [ ~"./semantics-and-pragmatics.spw#linguistics_semantics_composition" ]
}

^["concepts"]{
 primary: [ #constituency, #locality, #morpheme ]
 transfers: [ #dependency, #feature_structure ]
 tensions: [ #structure_dependence ]
}

^["morphology"]{
 #>linguistics_syntax_morpheme_types
 ^["morpheme_types"]{
  #:claim #!settled
  statement: "Morphemes are free or bound; bound affixes include prefixes, suffixes, infixes, and circumfixes, and processes include compounding, reduplication, ablaut, and suppletion."
  examples: [ "ablaut: sing, sang, sung", "suppletion: go, went", "reduplication in many Austronesian languages marks plurality or intensity" ]
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_haspelmath_sims_2010"
 }
 #>linguistics_syntax_derivation
 ^["derivation_and_inflection"]{
  #:claim #!settled
  statement: "Derivation forms new lexemes and may change category, as nation to national; inflection marks grammatical features such as tense, number, and case on one lexeme."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_haspelmath_sims_2010"
  ^["limits"]{
   holds: "as a prototype contrast"
   fails: "boundary cases such as participles and comparatives sit between the two"
  }
 }
 #>linguistics_syntax_typology
 ^["morphological_typology"]{
  #:claim #!settled
  statement: "Isolating, agglutinative, fusional, and polysynthetic name tendencies along scales, so one language often mixes types across its grammar."
  isolating: "few morphemes per word, as in Vietnamese"
  agglutinative: "many morphemes with one meaning each, as in Turkish or Swahili"
  fusional: "one affix carries several features at once, as in Latin verb endings"
  polysynthetic: "words with incorporated nouns and multiple agreement, as in Mohawk"
  sources: [ ~"../../registries/sources/language-and-communities.spw#src_lang_haspelmath_sims_2010", ~"../../registries/sources/language-and-communities.spw#src_lang_baker_1996" ]
 }
}

^["structure"]{
 #>linguistics_syntax_c_command
 ^["c_command"]{
  #:claim #!settled
  statement: "A node c-commands its sister and everything its sister contains; many dependencies, including binding, are stated over this hierarchical relation rather than over word order."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_reinhart_1976"
 }
 #>linguistics_syntax_binding
 ^["binding_principles"]{
  #:claim #!settled
  statement: "Principle A binds an anaphor in its local domain, Principle B keeps a pronoun free there, and Principle C keeps a name free everywhere."
  examples: [ "Kim praised herself", "Kim said Lee praised her", "she said Kim left, where she cannot be Kim" ]
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_chomsky_1981"
  ^["limits"]{
   holds: "English and many well-studied languages"
   fails: "long-distance reflexives in languages such as Icelandic and Mandarin need parameterized domains"
  }
 }
 #>linguistics_syntax_structure_dependence
 ^["structure_dependence"]{
  #:claim #!settled
  statement: "Children forming yes-no questions move the main-clause auxiliary, not the first auxiliary in the string, even for sentences they rarely hear."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_crain_nakayama_1987"
  ^["limits"]{
   holds: "the behavioral finding in English-speaking children"
   fails: "whether the bias is innate or learned from distributional input remains contested"
  }
 }
 #>linguistics_syntax_nets
 ^["hierarchical_bias_in_networks"]{
  #:claim #!emerging
  statement: "Sequence-to-sequence networks trained on question formation generalized hierarchically only when their architecture carried tree structure."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_mccoy_2020"
  ^["limits"]{
   holds: "the 2020 architectures and synthetic training sets"
   fails: "larger pretrained models were not tested and may behave differently"
  }
 }
}

^["islands"]{
 #>linguistics_syntax_islands_ross
 ^["ross_islands"]{
  #:claim #!settled
  statement: "Ross named island constraints in 1967, including the Complex NP Constraint and the Coordinate Structure Constraint, which block questioning out of certain domains."
  example: "what did you hear the rumor that Kim bought, judged unacceptable"
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_ross_1967"
 }
 #>linguistics_syntax_islands_accounts
 ^["grammatical_accounts"]{
  #:claim #!contested
  statement: "Grammatical accounts derive islands from locality: Subjacency in 1973, later phases with the Phase Impenetrability Condition in 2000."
  sources: [ ~"../../registries/sources/language-and-communities.spw#src_lang_chomsky_1973", ~"../../registries/sources/language-and-communities.spw#src_lang_chomsky_2000" ]
  counter: ~"../../registries/sources/language-and-communities.spw#src_lang_hofmeister_sag_2010"
  ~#counter(processing accounts trace some islands to memory load)
 }
 #>linguistics_syntax_islands_test
 ^["working_memory_test"]{
  #:claim #!contested
  statement: "A large acceptability study found island effects did not shrink with higher working-memory capacity, a result read as support for grammatical accounts."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_sprouse_2012"
  counter: ~"../../registries/sources/language-and-communities.spw#src_lang_hofmeister_sag_2010"
 }
}

^["frameworks"]{
 axes: #[ unit, structure, displacement, lexicon, origin ]

 #>linguistics_syntax_minimalism
 ^["minimalism"]{
  #:claim #!settled
  statement: "The Minimalist Program builds structure by Merge of two objects into a set and treats displacement as Merge of an object already inside the tree."
  unit: "syntactic object built by Merge"
  structure: "binary hierarchy derived step by step"
  displacement: "internal Merge leaves copies; Agree values features under c-command"
  lexicon: "features on lexical items drive the derivation"
  origin: "Noam Chomsky, 1995"
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_chomsky_1995"
 }
 #>linguistics_syntax_hpsg
 ^["hpsg"]{
  #:claim #!settled
  statement: "Head-Driven Phrase Structure Grammar states grammar as constraints on typed feature structures called signs, with no transformations."
  unit: "sign pairing phonology, syntax, and semantics in one feature structure"
  structure: "surface phrase structure licensed by constraints"
  displacement: "a gap feature passed up the tree links a filler to its gap"
  lexicon: "rich typed lexical entries carry most of the grammar"
  origin: "Carl Pollard and Ivan Sag, 1987 and 1994"
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_pollard_sag_1994"
 }
 #>linguistics_syntax_lfg
 ^["lfg"]{
  #:claim #!settled
  statement: "Lexical-Functional Grammar pairs a constituent structure with a functional structure of grammatical functions, related by annotations on phrase-structure rules."
  unit: "parallel c-structure and f-structure"
  structure: "word order and grouping in c-structure; subject and object as primitives in f-structure"
  displacement: "stated as a relation in f-structure, not as movement"
  lexicon: "lexical entries carry function-specifying equations"
  origin: "Ronald Kaplan and Joan Bresnan, 1982"
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_kaplan_bresnan_1982"
 }
 #>linguistics_syntax_cxg
 ^["construction_grammar"]{
  #:claim #!settled
  statement: "Construction grammar treats form-meaning pairings of every size, from words to argument-structure patterns, as the units of grammar."
  unit: "construction: a learned pairing of form and meaning"
  structure: "networks of constructions related by inheritance"
  displacement: "handled by constructions such as the question construction"
  lexicon: "no sharp line between lexicon and grammar"
  origin: "Fillmore, Kay, and O'Connor 1988; Goldberg 1995"
  example: "she sneezed the napkin off the table, where the caused-motion pattern adds the motion meaning"
  sources: [ ~"../../registries/sources/language-and-communities.spw#src_lang_fillmore_kay_oconnor_1988", ~"../../registries/sources/language-and-communities.spw#src_lang_goldberg_1995" ]
 }
 #>linguistics_syntax_dependency
 ^["dependency_grammar"]{
  #:claim #!settled
  statement: "Dependency grammar links words directly by head-dependent relations without phrasal nodes; Universal Dependencies applies one such scheme across many languages."
  unit: "word with one head"
  structure: "a tree of labeled dependency arcs"
  displacement: "non-projective arcs cross other arcs"
  lexicon: "valency of heads sets their dependents"
  origin: "Lucien Tesniere, 1959; Universal Dependencies consortium, 2021 overview"
  sources: [ ~"../../registries/sources/language-and-communities.spw#src_lang_tesniere_1959", ~"../../registries/sources/language-and-communities.spw#src_lang_de_marneffe_2021" ]
 }
}

#>linguistics_syntax_satiation_q
?["Do island violations sound better after you hear many of them?"]{
 #:depth #!experiential ~#lens(formal structure)
 #:claim #!speculative
 ~#hypothesis: "Repeated exposure raises ratings for some island types more than others, and the types that improve are the ones processing accounts predict."
 !probe{ "rate the same island sentences early and late in one session, by island type" =id[p_lang_syntax_satiation] =kind[field] }
 ~"./morphology-and-syntax.spw#linguistics_syntax_islands_accounts" ~#neighbor(nearest)
}

#>linguistics_syntax_braces_q
?["Does a reader of brace-first Spw parse nesting the way a listener parses constituents?"]{
 #:depth #!computational ~#lens(formal structure)
 #:claim #!speculative
 ~#hypothesis: "Readers recover deep brace nesting more slowly than shallow nesting, as listeners slow on center-embedded clauses."
 breaks: "Spw braces are explicit delimiters on a page; spoken constituency is inferred from prosody, agreement, and word order in real time"
 !probe{ "time readers locating the frame that holds a deep anchor at brace depths three and six" =id[p_lang_syntax_brace_depth] =kind[field] }
 $%[file.brace_depth_max]
 ~"./morphology-and-syntax.spw#linguistics_syntax_c_command" ~#neighbor(nearest)
}
