^["edges"]{
 needs: [ ~"./phonetics-and-phonology.spw#linguistics_phonology_phoneme" ]
 case_of: [ ~"../../panels/gap-table.spw#panel_gap_table" ]
}

^["concepts"]{
 primary: [ #sound_change, #comparative_method, #semantic_change ]
 transfers: [ #prediction, #reconstruction ]
 tensions: [ #exceptionless_change ]
}

^["ladder"]{
 #>linguistics_historical_jones
 ^["jones_1786"]{
  #:claim #!settled
  at: "1786"
  statement: "William Jones told the Asiatick Society in Calcutta that Sanskrit, Greek, and Latin share roots and forms too closely for chance, likely from a common source."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_jones_1786"
  ^["limits"]{
   holds: "as the widely quoted statement that launched comparative work"
   fails: "earlier observers had noted the resemblances, and Jones also grouped languages wrongly"
  }
 }
 #>linguistics_historical_sound_laws
 ^["comparative_method"]{
  #:claim #!settled
  at: "from the 1810s; made rigorous by the Neogrammarians in the 1870s"
  statement: "The comparative method reconstructs a proto-language by aligning cognates, finding regular correspondences, and positing the fewest changes that yield every daughter form."
  credit: "Bopp in 1816, Rask in 1818, and Grimm in 1822 set up correspondences; Schleicher reconstructed Proto-Indo-European forms in the 1860s; the Neogrammarians made sound laws exceptionless"
  sources: [ ~"../../registries/sources/language-and-communities.spw#src_lang_campbell_2013", ~"../../registries/sources/language-and-communities.spw#src_lang_fortson_2010" ]
 }
 #>linguistics_historical_grimm
 ^["rask_grimm_1818_1822"]{
  #:claim #!settled
  at: "1818 and 1822"
  statement: "Rask in 1818 and Grimm in 1822 set out regular stop correspondences between Germanic and its relatives, so Latin pater lines up with English father."
  shift: "voiceless stops became fricatives; voiced stops became voiceless; breathy voiced stops became plain voiced"
  sources: [ ~"../../registries/sources/language-and-communities.spw#src_lang_rask_1818", ~"../../registries/sources/language-and-communities.spw#src_lang_grimm_1822" ]
 }
 #>linguistics_historical_verner
 ^["verner_1877"]{
  #:claim #!settled
  at: "1877"
  statement: "Verner explained exceptions to Grimm Law by the place of the old accent: Gothic fadar has a voiced consonant where brothar keeps a voiceless one."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_verner_1877"
  ~#say(an exception became a law once the accent was found)
 }
 #>linguistics_historical_neogrammarians
 ^["neogrammarians_1878"]{
  #:claim #!settled
  at: "1878"
  statement: "Osthoff and Brugmann held that sound laws apply without exception in one dialect and period, leaving analogy and borrowing to explain the remainder."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_osthoff_brugmann_1878"
  ^["limits"]{
   holds: "as a working method that makes reconstruction testable"
   fails: "some changes spread word by word through the lexicon, as later studies of lexical diffusion showed"
  }
 }
 #>linguistics_historical_laryngeal_prediction
 ^["saussure_1879"]{
  #:claim #!settled
  at: "1879"
  statement: "Saussure posited lost sounds he called sonant coefficients to explain irregular vowel alternations in Indo-European roots, with no attested language showing them."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_saussure_1879"
 }
 #>linguistics_historical_hittite
 ^["hrozny_1915_1917"]{
  #:claim #!settled
  at: "1915 and 1917"
  statement: "Hrozny showed that the cuneiform language of the Hittite archives at Bogazkoy was Indo-European, the oldest well-attested branch."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_hrozny_1917"
 }
 #>linguistics_historical_laryngeal_confirmed
 ^["kurylowicz_1927"]{
  #:claim #!settled
  at: "1927"
  statement: "Kurylowicz showed that a Hittite consonant written h stands where Saussure had placed a lost sound, as in pahhur fire beside Greek pur."
  sources: [ ~"../../registries/sources/language-and-communities.spw#src_lang_kurylowicz_1927", ~"../../registries/sources/language-and-communities.spw#src_lang_fortson_2010" ]
  ^["limits"]{
   holds: "the existence of laryngeals and their reflex in Anatolian"
   fails: "how many laryngeals there were and how each sounded remain debated"
  }
 }
}

^["typology"]{
 #>linguistics_historical_greenberg
 ^["word_order_correlations"]{
  #:claim #!settled
  statement: "Greenberg found that verb-object languages tend to have prepositions and object-verb languages tend to have postpositions, as statistical tendencies across a sample."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_greenberg_1963"
 }
}

^["semantic_change"]{
 #>linguistics_historical_semantic_change
 ^["types"]{
  #:claim #!settled
  statement: "Word meanings narrow, broaden, worsen, improve, and shift by metaphor or metonymy; each type has well-documented English cases."
  narrowing: "deer once meant any animal; meat once meant any food"
  broadening: "bird once meant a young bird"
  pejoration: "silly once meant blessed or happy"
  amelioration: "nice comes from Latin nescius, ignorant, and passed through foolish and fussy"
  metaphor: "grasp an idea uses a hand word for understanding"
  metonymy: "the crown names the monarch by an object near the office"
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_campbell_2013"
 }
 #>linguistics_historical_subjectification
 ^["regular_tendencies"]{
  #:claim #!contested
  statement: "Traugott and Dasher argue that meaning change has regular directions, most often toward meanings grounded in the speaker's attitude or stance."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_traugott_dasher_2002"
  counter: ~"../../registries/sources/language-and-communities.spw#src_lang_campbell_2013"
  ~#counter(counterexamples make regularity a tendency at best)
 }
}

#>linguistics_historical_gap_q
?["Which reconstructed sounds are still waiting for their Hittite?"]{
 #:depth #!historical ~#lens(historical layer)
 #:claim #!speculative
 ~#hypothesis: "Reconstructions resting on internal irregularity alone, as the laryngeals once did, are the ones most likely to be confirmed or overturned by a newly read archive."
 !probe{ "list proto-language segments posited from internal evidence alone and check which gained direct attestation later" =id[p_lang_historical_waiting_sounds] =kind[lit] }
 ~"./historical-linguistics.spw#linguistics_historical_laryngeal_prediction" ~#neighbor(nearest)
}

#>linguistics_historical_role_words_q
?["Do words that name roles change meaning faster than words that name things?"]{
 #:depth #!historical ~#lens(semiotic charge)
 #:claim #!speculative
 ~#hypothesis: "Role nouns gain and lose evaluative charge faster than object nouns, because their meaning tracks how a community regards the people holding the role."
 !probe{ "count dated sense changes per century for matched role and object nouns in one etymological dictionary" =id[p_lang_historical_role_rate] =kind[census] }
 $%[graph.path_refs]
 ~"./historical-linguistics.spw#linguistics_historical_semantic_change" ~#neighbor(nearest)
}
