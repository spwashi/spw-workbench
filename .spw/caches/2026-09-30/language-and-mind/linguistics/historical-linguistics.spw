# Historical Linguistics
#
# A dated ladder from the first comparisons of Sanskrit and Greek to a predicted lost sound that turned up in Hittite, with the kinds of change words undergo.

#>linguistics_historical
#:layer #!reference
#:domain #!linguistics
#:form #!timeline
#:level #!advanced
#:review #!adversarial_checked
#:valence #!bonk

^"emit"{
 ~#title: "Historical Linguistics"
 ~#claim: "Regular sound correspondences let linguists reconstruct lost languages, and Saussure predicted lost sounds that Hittite later confirmed."
 ~#proof: "Rask, Grimm, Verner, and the Neogrammarians for regularity; Saussure 1879, Hrozny 1917, and Kurylowicz 1927 for the laryngeal case."
 ~#door: "Climb the ladder from Jones to Verner, then read the laryngeal prediction rung by rung."
 ~#audience: "readers who know what a phoneme is"
 continuity: "Historical Linguistics | lost sounds"
 cold_open: "Sound change is regular enough that a young Saussure predicted lost sounds, and decades later Hittite tablets showed them written down."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/linguistics/sociolinguistics-and-language-documentation.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #partial }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 gate_note: "r3 was first recorded as a pass while the planned panels gap-table was unwritten; that forward ref now resolves"
 corrections: [
  "split out of the raw sociolinguistics file, where comparative method and sound laws sat in one facet",
  "Grimm Law is credited to Rask 1818 as well as Grimm 1822",
  "Greenberg word-order correlations are stated as statistical tendencies, not laws",
  "fact check: the comparative method was dated from the 1870s; correspondences and reconstruction began in the 1810s, and the 1870s brought exceptionless laws"
 ]
