^["edges"]{
 needs: [ ~"./phonetics-and-phonology.spw#linguistics_phonology_vowel_formants" ]
 feeds: [ ~"./historical-linguistics.spw#linguistics_historical_neogrammarians", ~"../../record/information/archives-and-preservation.spw#information_science_archives" ]
}

^["concepts"]{
 primary: [ #variation, #prestige, #documentation ]
 transfers: [ #sound_change, #community_custody ]
 tensions: [ #observer_paradox ]
}

^["terms"]{
 #>linguistics_sociolinguistics_variable
 ^["sociolinguistic_variable"]{
  #:claim #!settled
  statement: "A sociolinguistic variable is a set of ways of saying the same thing, such as pronouncing or dropping r after a vowel, whose rates shift with speaker and setting."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_labov_1966"
 }
 #>linguistics_sociolinguistics_prestige
 ^["overt_and_covert_prestige"]{
  #:claim #!settled
  statement: "Overt prestige attaches to the standard in public; covert prestige attaches to local forms that signal solidarity, which some Norwich men over-reported using."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_trudgill_1972"
 }
 #>linguistics_sociolinguistics_waves
 ^["three_waves"]{
  #:claim #!interpretive
  statement: "Eckert reads variation study in three waves: correlations with broad categories, local categories found by ethnography, and variables as resources speakers use to style themselves."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_eckert_2012"
 }
}

^["cases"]{
 #>linguistics_sociolinguistics_vineyard
 ^["marthas_vineyard"]{
  #:claim #!settled
  statement: "On Martha's Vineyard, centralized diphthongs in words like right and house were strongest among islanders who identified with island life against summer visitors."
  when: "fieldwork published 1963"
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_labov_1963"
 }
 #>linguistics_sociolinguistics_department_stores
 ^["department_stores"]{
  #:claim #!settled
  statement: "Asking clerks for an item on the fourth floor, Labov found r after vowels most often in the highest-priced New York store and least in the lowest, and more on careful repetition."
  when: "fieldwork 1962, published 1966"
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_labov_1966"
  ^["limits"]{
   holds: "New York City English in the early 1960s"
   fails: "rates cannot be carried to other cities or decades without new fieldwork"
  }
 }
 #>linguistics_sociolinguistics_aae
 ^["african_american_english"]{
  #:claim #!settled
  statement: "African American English is rule-governed: habitual be marks recurring events, stressed BIN marks a state begun long ago, and the copula is absent where Standard English can contract it."
  examples: [ "she be working, meaning she works regularly", "she BIN married, meaning married for a long time", "he tall, where Standard English allows he is tall to contract to he's tall" ]
  sources: [ ~"../../registries/sources/language-and-communities.spw#src_lang_green_2002", ~"../../registries/sources/language-and-communities.spw#src_lang_labov_1969" ]
 }
 #>linguistics_sociolinguistics_profiling
 ^["dialect_profiling"]{
  #:claim #!settled
  statement: "In telephone experiments, listeners identified a caller's dialect from a single word, and housing inquiries in some dialects drew fewer appointments to see an apartment."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_purnell_1999"
  ^["limits"]{
   holds: "the San Francisco Bay Area housing calls and listener tests reported in 1999"
   fails: "the rate of such treatment elsewhere or now needs its own audit study"
  }
 }
 #>linguistics_sociolinguistics_courtroom
 ^["courtroom_hearing"]{
  #:claim #!settled
  statement: "In a 2013 Florida trial, a key witness speaking African American English was widely misheard and discounted; Rickford and King trace the errors to unfamiliar grammar and phonology."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_rickford_king_2016"
 }
 #>linguistics_sociolinguistics_nicaragua
 ^["nicaraguan_sign_language"]{
  #:claim #!settled
  statement: "Deaf children gathered in new Managua schools from the late 1970s created a sign language whose later cohorts broke motion into discrete, combinable units."
  credit: "the language was made by the Deaf children and signers of Nicaragua; researchers documented it"
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_senghas_2004"
  ^["limits"]{
   holds: "shared core properties such as discreteness and combination"
   fails: "signed languages also use space and simultaneity in ways spoken languages do not, so their grammars are not copies of spoken ones"
  }
 }
}

^["documentation"]{
 #>linguistics_sociolinguistics_documentary
 ^["documentary_linguistics"]{
  #:claim #!settled
  statement: "Documentary linguistics aims at a lasting, multipurpose record of a language in use, separate from the grammar and dictionary that describe it."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_himmelmann_1998"
 }
 #>linguistics_sociolinguistics_endangerment
 ^["endangerment"]{
  #:claim #!settled
  statement: "A 1992 collection in Language warned that a large share of the world's languages were no longer being learned by children and urged documentation and community support."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_hale_1992"
  ^["limits"]{
   holds: "the direction of the warning"
   fails: "counts of endangered languages change with each survey; read a dated catalog before quoting a number"
  }
 }
 #>linguistics_sociolinguistics_nests
 ^["language_nests"]{
  #:claim #!settled
  statement: "Te Kōhanga Reo, begun at the direction of Māori elders, or kaumātua, opened its first language nest in Wainuiomata in 1982, and Hawaiian educators adapted the model from 1983."
  hawaii: "the ʻAha Pūnana Leo, founded in 1983, opened the first Pūnana Leo preschool in Kekaha, Kauaʻi, in 1984, drawing on kōhanga reo and on Hawaiian-language schools of the nineteenth century"
  credit: "movements led by their communities; early Māori leaders include Jean Puketapu and Iritana Tāwhiwhirangi, and ʻAha Pūnana Leo founders include Larry Kimura, Kauanoe Kamanā, and William H. Wilson"
  sources: [
   ~"../../registries/sources/language-and-communities.spw#src_lang_hinton_hale_2001",
   ~"../../registries/sources/language-and-communities.spw#src_lang_wiki_kohanga_reo",
   ~"../../registries/sources/language-and-communities.spw#src_lang_wiki_aha_punana_leo"
  ]
 }
 #>linguistics_sociolinguistics_custody
 ^["community_custody"]{
  #:claim #!settled
  statement: "The CARE principles ask that data about Indigenous peoples serve collective benefit, authority to control, responsibility, and ethics, alongside FAIR technical principles."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_carroll_2020"
  practice: "time-aligned annotation tools such as ELAN and archives with community access protocols"
  cites: ~"../../registries/sources/language-and-communities.spw#src_lang_wittenburg_2006"
 }
 #>linguistics_sociolinguistics_descriptivism
 ^["descriptive_stance"]{
  #:claim #!interpretive
  statement: "This cut takes the descriptive stance: a variety is studied for its rules, and no dialect is treated as broken speech."
  ~#say(linguists describe how people talk before anyone ranks it)
 }
}

#>linguistics_sociolinguistics_evidential_q
?["Does a grammar that marks how you know something change what you remember?"]{
 #:depth #!social ~#lens(information flow)
 #:claim #!speculative
 ~#hypothesis: "Speakers of languages with obligatory evidentials attend more to their source of knowledge in speech, with little or no advantage in nonverbal source memory."
 !probe{ "compare source-memory tasks with and without speaking across evidential and non-evidential languages" =id[p_lang_socio_evidential_memory] =kind[lit] }
 sources: [
  ~"../../registries/sources/language-and-communities.spw#src_lang_aikhenvald_2004",
  ~"../../registries/sources/language-and-communities.spw#src_lang_fleck_2007",
  ~"../../registries/sources/language-and-communities.spw#src_lang_papafragou_2007"
 ]
 ~"./sociolinguistics-and-documentation.spw#linguistics_sociolinguistics_documentary" ~#neighbor(nearest)
}

#>linguistics_sociolinguistics_chat_q
?["Do live chat rooms grow their own variables, the way island speech did?"]{
 #:depth #!social ~#lens(social fabric)
 #:claim #!speculative
 ~#hypothesis: "Regulars in a long-running chat room use room-specific spellings and emotes at higher rates than newcomers, and the gap narrows as newcomers stay."
 breaks: "chat is typed and logged by a platform, so spelling stands in for pronunciation and the record is the platform, not the fieldworker"
 !probe{ "count room-specific tokens in public aggregate chat logs by account age bands, never by named user" =id[p_lang_socio_chat_variable] =kind[census] }
 ~"./sociolinguistics-and-documentation.spw#linguistics_sociolinguistics_vineyard" ~#neighbor(nearest)
}
