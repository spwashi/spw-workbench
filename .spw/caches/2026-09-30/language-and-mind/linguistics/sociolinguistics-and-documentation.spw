# Sociolinguistics and Language Documentation
#
# Case files on how speech varies with community and identity, how listeners judge speakers by dialect, and how communities and linguists keep languages alive.

#>linguistics_sociolinguistics
#:layer #!reference
#:domain #!linguistics
#:form #!dossier
#:level #!advanced
#:review #!adversarial_checked
#:valence #!honk

^"emit"{
 ~#title: "Sociolinguistics and Language Documentation"
 ~#claim: "Speech shows orderly variation that carries social meaning, every variety is rule-governed, and documentation works best when communities hold the keys."
 ~#proof: "Cases from Labov, Trudgill, Eckert, Green, Purnell, Idsardi and Baugh; documentation from Himmelmann, Hale and colleagues, and the CARE principles."
 ~#door: "Open the department store case, then the dialect profiling case, then the language nests."
 ~#audience: "readers who have taken an introductory linguistics course"
 continuity: "Sociolinguistics and Language Documentation | orderly variation"
 cold_open: "Speech shows orderly variation that signals who we are, and languages last longest when their communities steer the record."
}

