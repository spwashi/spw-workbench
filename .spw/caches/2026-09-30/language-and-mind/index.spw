# Language and Mind
#
# How minds perceive, remember, reason, and develop, and how languages are built, used, varied, and changed.

#>language_and_mind_index
#:layer #!reference
#:domain #!language_and_mind
#:form #!index
#:level #!intro
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Language and Mind"
 ~#claim: "Cognition and linguistics study the same speaker from two sides: the mind that perceives and reasons, and the language it learns and shares."
 ~#proof: "Two branches with sourced leaves, a replication ledger for cognition, and corrections lists against the raw generation."
 ~#door: "Start with the glossary, then pick cognition or linguistics; the acquisition gap below marks where they should meet."
 ~#audience: "curious readers and students entering psychology or linguistics"
 continuity: "Language and Mind | two sides"
 cold_open: "Cognition and linguistics look at one speaker from two sides, the mind that reasons and the language it shares."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["tree"]{
 glossary: ~"./language-and-mind-glossary.spw"
 cognition: ~"./cognition/index.spw"
 linguistics: ~"./linguistics/index.spw"
}

^["bundle"]{
 ={ ~"./language-and-mind-glossary.spw#language_and_mind_glossary" }
 ={ ~"./cognition/index.spw#cognition_index" }
 ={ ~"./linguistics/index.spw#linguistics_index" }
}

^["order"]{
 facets: "leaves are listed by domain, then matter, then form, then era: personality, matter, energy, space, time"
 space: "a declared gap: no region axis; region lives in qualifiers inside claims"
}

^["ladder"]{
 rungs: << "intro" ; "foundation" ; "advanced" ; "graduate" ; "practitioner" >>
 intro: "the glossary doubles as the intro rung until an intro leaf exists"
 foundation: [
  ~"./language-and-mind-glossary.spw#language_and_mind_glossary",
  ~"./cognition/perception-and-attention.spw#cognition_perception",
  ~"./cognition/memory-and-representation.spw#cognition_memory",
  ~"./cognition/cognitive-development.spw#cognition_development"
 ]
 advanced: [
  ~"./cognition/reasoning-and-decision.spw#cognition_reasoning",
  ~"./cognition/replication-ledger.spw#cognition_replication_ledger",
  ~"./linguistics/phonetics-and-phonology.spw#linguistics_phonology",
  ~"./linguistics/morphology-and-syntax.spw#linguistics_syntax",
  ~"./linguistics/semantics-and-pragmatics.spw#linguistics_semantics",
  ~"./linguistics/sociolinguistics-and-documentation.spw#linguistics_sociolinguistics",
  ~"./linguistics/historical-linguistics.spw#linguistics_historical"
 ]
 graduate: "a gap: research methods in psycholinguistics and field linguistics have no leaf yet"
 practitioner: "a gap: speech-language pathology, interpreting, and lexicography have no leaf yet"
 ^["prerequisites"]{
  phonology_before_history: "sound change is read through phonology, so phonetics and phonology comes before historical linguistics"
  syntax_before_semantics: "composition is stated over constituents, so morphology and syntax comes before semantics"
  perception_before_phonology: "categorical perception is a perception result before it is a phonology result"
 }
}

^["gaps"]{
 #>language_and_mind_gap_acquisition
 ^["acquisition"]{
  cell: "first- and second-language acquisition: no leaf yet"
  between: [ ~"./cognition/cognitive-development.spw#cognition_development", ~"./linguistics/phonetics-and-phonology.spw#linguistics_phonology" ]
  predicted_use: "it would ground the phonics and reading debates in the curriculum-wars matrix"
  feeds: ~"../learning/generations/curriculum-wars-matrix.spw#generations_curriculum_wars"
 }
 #>language_and_mind_gap_behavioral
 ^["behavioral_economics"]{
  cell: "behavioral economics has edges from reasoning and decision but no surface of its own"
  neighbors: [ ~"./cognition/reasoning-and-decision.spw#cognition_reasoning" ]
 }
 #>language_and_mind_gap_signed
 ^["signed_languages"]{
  cell: "signed-language linguistics appears only as one case in the sociolinguistics leaf"
  neighbors: [ ~"./linguistics/sociolinguistics-and-documentation.spw#linguistics_sociolinguistics_nicaragua" ]
 }
}
