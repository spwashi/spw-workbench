  ^["r4"]{ event: #fact_checked, at: "2026-10-03",
   agent: "claude-opus-5.5 fact-checker", care: #adversarial, outcome: #pass }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the drinking-age selection task is credited to Griggs and Cox in 1982, not to Cosmides and Tooby, and the raw success rates are dropped as unsourced (raw line 18)",
  "the raw said failing the selection task demonstrates confirmation bias; why people choose as they do is debated (raw line 17)",
  "dual-process theory is marked contested, with its critics cited (raw line 21)",
  "the raw loss-aversion range of 2.0 to 2.5 is replaced by the sourced 1992 fit and a 2024 meta-analytic mean, with a dissent (raw line 33)",
  "the taste file called heuristics brilliantly evolved tools; ecological rationality is kept as an interpretive reading, not a finding (taste line 16)",
  "the pain-of-paying tension is stated once here and linked from the hospitality surface that once recommended exploiting it"
 ]
}

^["edges"]{
 needs: [ ~"./memory-and-representation.spw#cognition_memory" ]
 contrasts: [ ~"../../society/economics/micro-and-macro-core.spw#economics_core", ~"../../society/management/food-and-beverage-systems.spw#management_fb_price_format" ]
 see: [ ~"./replication-ledger.spw#cognition_replication_ledger" ]
 grounds: [ ~"../../registries/quantities/life-and-mind.spw#q_life_mind" ]
}

^["concepts"]{
 primary: [ #heuristic, #loss_aversion, #selection_task ]
 transfers: [ #replication, #choice_architecture ]
 tensions: [ #dark_patterns ]
}

^["logic"]{
 valid: #[
  "modus ponens: if p then q; p; so q",
  "modus tollens: if p then q; not q; so not p"
 ]
 invalid: #[
  "affirming the consequent: if p then q; q; so p",
  "denying the antecedent: if p then q; not p; so not q"
 ]
 note: "these forms are definitions from logic, not findings; the claims below are about what people do with them"
}

^["ledger"]{
 ^["rule_testing"]{
  #>cognition_reasoning_wason
  ^["selection_task"]{
   #:claim #!settled
   statement: "Given four cards and a rule of the form if p then q, most people turn the p card, often the q card, and rarely the not-q card, which could falsify the rule."
   source: ~"../../registries/sources/life-and-mind.spw#src_life_wason_1968"
   credit: "Peter Wason introduced the selection task in the 1960s"
  }
  #>cognition_reasoning_drinking_age
  ^["drinking_age"]{
   #:claim #!settled
   statement: "Griggs and Cox found that a rule from everyday experience, if a person is drinking beer then the person must be over 19, was solved far more often than abstract versions."
   source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_griggs_cox_1982"
   ~#say(people find the rule breaker at the bar, not at the card table)
  }
  #>cognition_reasoning_content_accounts
  ^["content_accounts"]{
   #:claim #!contested
   statement: "Cosmides explains such content effects as an evolved skill for detecting cheaters on social contracts; Cheng and Holyoak explain them as learned schemas for permission and obligation."
   source: ~"../../registries/sources/life-and-mind.spw#src_life_cosmides_1989"
   counter: ~"../../registries/sources/life-and-mind.spw#src_life_cheng_holyoak_1985"
  }
  #>cognition_reasoning_raw_credit
  ^["raw_credit"]{
   #:claim #!refuted
   statement: "The raw note credited the drinking-age task to Cosmides and Tooby; Griggs and Cox published it in 1982, and Cosmides offered her account of such effects in 1989."
   sources: [ ~"../../registries/sources/provenance-and-reference.spw#src_prov_griggs_cox_1982", ~"../../registries/sources/life-and-mind.spw#src_life_cosmides_1989" ]
  }
 }
 ^["two_systems"]{
  #>cognition_reasoning_dual_process
  ^["dual_process"]{
   #:claim #!contested
   statement: "Dual-process accounts sort thinking into fast, intuitive processes and slow processes that need working memory; critics argue the features used to define the two types do not cluster."
   source: ~"../../registries/sources/life-and-mind.spw#src_life_evans_stanovich_2013"
   counter: ~"../../registries/sources/life-and-mind.spw#src_life_melnikoff_bargh_2018"
  }
  #>cognition_reasoning_crt
  ^["cognitive_reflection"]{
   #:claim #!settled
   statement: "Frederick's three-item Cognitive Reflection Test, which includes the bat-and-ball question, measures the tendency to check a first answer, and its scores predict time and risk preferences."
   source: ~"../../registries/sources/life-and-mind.spw#src_life_frederick_2005"
  }
 }
 ^["heuristics"]{
  #>cognition_reasoning_heuristics
  ^["three_heuristics"]{
   #:claim #!settled
   statement: "People judge likelihood by how easily examples come to mind, by resemblance to a type, and by adjusting from a starting number; the shortcuts often work and err in predictable directions."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_tversky_kahneman_1974"
  }
  #>cognition_reasoning_conjunction
  ^["conjunction_fallacy"]{
   #:claim #!settled
   statement: "Told about Linda, a former philosophy student concerned with social justice, most people judged her more likely a feminist bank teller than a bank teller, though a conjunction cannot be more probable."
   source: ~"../../registries/sources/life-and-mind.spw#src_life_tversky_kahneman_1983"
   ^["limits"]{
    holds: "single-case probability questions about a vivid description"
    fails: "asked how many of a hundred such women fit each description, far fewer people violate the rule"
   }
  }
  #>cognition_reasoning_anchoring
  ^["anchoring_replicated"]{
   #:claim #!settled
   statement: "Anchoring and gain-loss framing were among the classic effects that replicated across 36 samples in the first Many Labs project."
   source: ~"../../registries/sources/economy-and-markets.spw#src_econ_klein_2014"
  }
 }
 ^["prospect_theory"]{
  #>cognition_reasoning_prospect
  ^["value_function"]{
   #:claim #!settled
   statement: "Prospect theory values outcomes as gains and losses from a reference point, concave for gains, convex for losses, and steeper for losses, and overweights small probabilities."
   sources: [ ~"../../registries/sources/life-and-mind.spw#src_life_kahneman_tversky_1979", ~"../../registries/sources/life-and-mind.spw#src_life_tversky_kahneman_1992" ]
  }
  #>cognition_reasoning_framing
  ^["framing"]{
   #:claim #!settled
   statement: "Identical outcomes described as lives saved draw risk-averse choices and described as lives lost draw risk-seeking ones; this framing effect replicated in the Many Labs project."
   source: ~"../../registries/sources/economy-and-markets.spw#src_econ_klein_2014"
   credit: "Amos Tversky and Daniel Kahneman posed the disease problem in 1981"
  }
  #>cognition_reasoning_loss_aversion
  ^["loss_aversion"]{
   #:claim #!settled
   statement: "Across 607 estimates from 150 articles, the mean loss-aversion coefficient is near two, close to the median fitted when cumulative prospect theory was introduced."
   reads: %[life.decision.meta_lambda_mean, life.decision.tk1992_lambda]
   source: ~"../../registries/sources/life-and-mind.spw#src_life_brown_2024"
  }
  #>cognition_reasoning_loss_dissent
  ^["loss_aversion_dissent"]{
   #:claim #!contested
   statement: "Gal and Rucker argue that losses do not, on balance, loom larger than gains, and that observed asymmetries depend on stakes, status quo, and how the choice is measured."
   source: ~"../../registries/sources/life-and-mind.spw#src_life_gal_rucker_2018"
   counter: ~"../../registries/sources/life-and-mind.spw#src_life_brown_2024"
  }
 }
 ^["rationality"]{
  #>cognition_reasoning_bounded
  ^["bounded_rationality"]{
   #:claim #!interpretive
   statement: "Simon argued that people satisfice, choosing what is good enough, because search and calculation are costly; on this reading a heuristic is judged by how well it fits its environment."
   source: ~"../../registries/sources/economy-and-markets.spw#src_econ_simon_1955"
   credit: "Gerd Gigerenzer and colleagues developed the ecological-rationality reading of fast and frugal heuristics"
  }
 }
}

^["tensions"]{
 #>cognition_reasoning_pain_of_paying
 ^["pain_of_paying"]{
  #:claim #!emerging
  statement: "Prelec and Loewenstein proposed that paying carries a felt cost of its own, and that methods separating payment from use, such as credit, can dull it."
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_prelec_loewenstein_1998"
  see: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_knutson_2007" ]
 }
 #>cognition_reasoning_dark_patterns
 ^["dark_patterns"]{
  #:claim #!settled
  statement: "An automated crawl of thousands of shopping websites found dark patterns, interface designs that coerce, steer, or deceive users into choices they would not otherwise make, some supplied by third-party vendors."
  source: ~"../../registries/sources/life-and-mind.spw#src_life_mathur_2019"
 }
 #>cognition_reasoning_ethics
 ^["help_or_exploit"]{
  #:claim #!interpretive
  statement: "The same knowledge of defaults, loss aversion, and the pain of paying can help people choose what they want or trap them; this branch counts exploiting it against a person's interest as a harm."
  source: ~"../../registries/sources/life-and-mind.spw#src_life_mathur_2019"
  dissent: "the hospitality surface records menu tactics that hide prices; it now marks them contested and names this tension"
 }
}

#>cognition_reasoning_linda_q
?["Why does a richer description feel more probable?"]{
 #:depth #!computational ~#lens(information flow)
 #:claim #!speculative
 ~#hypothesis: "Each added detail can make a case seem more typical while its probability can only fall, so judgments should follow typicality unless the question asks for counts."
 !probe{ "ask two groups the Linda question, one as a probability and one as a count of a hundred women, and compare violation rates" =id[p_life_cog_linda_counts] =kind[field] }
 ~"./reasoning-and-decision.spw#cognition_reasoning_conjunction" ~#neighbor(nearest)
}

#>cognition_reasoning_stakes_q
?["Does loss aversion shrink when the stakes are small?"]{
 #:depth #!social ~#lens(market flow)
 #:claim #!speculative
 ~#hypothesis: "If loss aversion depends partly on stakes, the coefficient estimated from small everyday gambles should sit closer to one than estimates from larger ones."
 !probe{ "sort the meta-analytic estimates by stake size and compare their means" =id[p_life_cog_loss_stakes] =kind[lit] }
 $%[life.decision.tk1992_lambda, life.decision.meta_lambda_mean]
 ~"./reasoning-and-decision.spw#cognition_reasoning_loss_dissent" ~#neighbor(nearest)
}
