# Reasoning and Decision
#
# How people test rules, take shortcuts, and weigh gains against losses, with each famous effect given its source, its limits, and its replication record, and with the ethics of exploiting these tendencies kept in view.

#>cognition_reasoning
#:layer #!reference
#:domain #!cognition
#:form #!ledger
#:level #!advanced
#:review #!adversarial_checked
#:valence #!bonk

^"emit"{
 ~#title: "Reasoning and Decision"
 ~#claim: "People reason better about familiar rules than abstract ones, judge chance through shortcuts that err predictably, and weigh losses more than equal gains on average, though how much varies."
 ~#proof: "Wason and Griggs and Cox on rule testing, Tversky and Kahneman on heuristics and prospect theory, the Many Labs replications, a loss-aversion meta-analysis by Brown and colleagues, and Gal and Rucker's dissent."
 ~#door: "Read the rule-testing claims, then the heuristics, then prospect theory, then the tension between nudges and dark patterns."
 ~#audience: "advanced students in psychology, economics, or design"
 continuity: "Reasoning and Decision | shortcuts that err predictably"
 cold_open: "People decide with shortcuts that err predictably, and anyone who knows those shortcuts can help or exploit them."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/cognitive-psychology/reasoning-decision-making-and-heuristics.spw", ".spw/caches/university-education/cognitive-psychology/taste.spw" ]
 evidence: #[ "Crossref abstracts read 2026-10-02 for Griggs and Cox 1982, Klein 2014, Brown 2024, Gal and Rucker 2018, Frederick 2005, and Mathur 2019" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
