# Memory and Representation
#
# How long a glimpse lasts, how much a mind holds at once, how memory divides into systems, why forgetting is not a simple exponential, and why spacing and testing help, with memory as reconstruction.

#>cognition_memory
#:layer #!reference
#:domain #!cognition
#:form #!ledger
#:level #!foundation
#:review #!sourced
#:valence #!bone

^"emit"{
 ~#title: "Memory and Representation"
 ~#claim: "Memory holds a brief sensory trace, a few chunks in focus, and long-term systems that differ in kind; forgetting slows over time, spacing and testing help, and recall rebuilds rather than replays."
 ~#proof: "Sperling, Miller and Cowan, Baddeley and Hitch, Scoville and Milner, Wixted and Ebbesen, Cepeda and colleagues, Roediger and Karpicke, Bartlett, and Loftus and Palmer."
 ~#door: "Start with capacity, then the systems, then forgetting, spacing, and testing, and end with reconstruction."
 ~#audience: "first-year psychology students, teachers, and curious readers"
 continuity: "Memory and Representation | rebuilds rather than replays"
 cold_open: "Memory rebuilds rather than replays, which is why a well-timed test helps you keep what you learned."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/cognitive-psychology/memory-systems-and-knowledge-representation.spw" ]
 evidence: #[ "Crossref or Europe PMC abstracts read 2026-10-02 for Wixted and Ebbesen 1991, Murre and Dros 2015, Cepeda 2006, Roediger and Karpicke 2006, Wixted and Wells 2017, and Corkin 2002" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the raw Ebbinghaus exponential forgetting curve is refuted below: forgetting slows over time, and a power function fits it better than a single exponential (raw line 33)",
  "the raw iconic decay of about 250 ms and echoic persistence of three to four seconds had no source here; the iconic trace is described as fading within about a second (raw line 16)",
  "the raw called the amnesia of patient H.M. complete; it was dense for new facts and events, while motor skill learning was spared (raw line 29)",
  "the raw said deep processing gives vastly superior retention; the effect holds when the test matches the study, and limits are given (raw line 32)",
  "the raw constructive-simulation wonder stated an evolutionary purpose as fact; it is now a speculative question (raw line 45)"
 ]
}

^["edges"]{
 needs: [ ~"./perception-and-attention.spw#cognition_perception" ]
 feeds: [ ~"./reasoning-and-decision.spw#cognition_reasoning", ~"../../learning/institutions/pedagogical-scaffolding.spw#institutions_pedagogy_retrieval" ]
 contrasts: [ ~"../../living/neuroscience/cellular-neurobiology.spw#neuroscience_cellular_ltp" ]
 grounds: [ ~"../../registries/quantities/life-and-mind.spw#q_life_mind" ]
}

^["concepts"]{
 primary: [ #working_memory, #forgetting_curve, #reconstruction ]
 transfers: [ #representation, #replication ]
 tensions: [ #slots_or_resources ]
}

^["scope"]{
 what: "how memory works in general"
 not_advice: "educational reference under the living class rule; it is not a diagnosis of memory problems, and study findings describe group averages, not a prescription for any learner"
}

^["ledger"]{
 ^["short_term"]{
  #>cognition_memory_iconic
  ^["iconic_trace"]{
   #:claim #!settled
   statement: "Shown a brief grid of letters, people report only a few, yet can report most of any row cued just after it vanishes, so a rich visual trace fades within about a second."
   source: ~"../../registries/sources/life-and-mind.spw#src_life_sperling_1960"
  }
  #>cognition_memory_capacity
  ^["capacity"]{
   #:claim #!settled
   statement: "Miller's span of about seven measured rehearsed and chunked items; with rehearsal and chunking controlled, adults hold about three to five chunks in focus at once."
   reads: %[life.memory.miller_span_chunks, life.memory.cowan_capacity_chunks]
   sources: [ ~"../../registries/sources/life-and-mind.spw#src_life_miller_1956", ~"../../registries/sources/life-and-mind.spw#src_life_cowan_2001" ]
   ^["limits"]{
    holds: "simple items such as letters, digits, and colors"
    fails: "whether the limit is a fixed number of slots or a shared resource spread across items is still debated"
   }
  }
  #>cognition_memory_working
  ^["working_memory"]{
   #:claim #!settled
   statement: "Baddeley and Hitch divided short-term memory into a phonological loop, a visuospatial sketchpad, and a central executive that directs attention; an episodic buffer that binds them was added later."
   sources: [ ~"../../registries/sources/life-and-mind.spw#src_life_baddeley_hitch_1974", ~"../../registries/sources/life-and-mind.spw#src_life_baddeley_2020" ]
  }
  #>cognition_memory_loop
  ^["phonological_loop"]{
   #:claim #!settled
   statement: "Lists of similar-sounding words are harder to hold than dissimilar ones, and repeating an irrelevant word aloud, articulatory suppression, removes that effect for printed lists."
   source: ~"../../registries/sources/life-and-mind.spw#src_life_baddeley_2020"
  }
 }
 ^["long_term"]{
  #>cognition_memory_systems
  ^["memory_systems"]{
   #:claim #!settled
   statement: "Declarative memory for facts and events depends on the hippocampus and nearby structures, while skills, priming, and conditioning rely on other brain systems."
   source: ~"../../registries/sources/life-and-mind.spw#src_life_baddeley_2020"
   credit: "Endel Tulving separated episodic from semantic memory in 1972; Larry Squire and others mapped declarative and nondeclarative systems onto the brain"
  }
  #>cognition_memory_hm
  ^["patient_hm"]{
   #:claim #!settled
   statement: "After both medial temporal lobes were partly removed in 1953 to treat seizures, patient H.M. could not form new memories of facts and events, yet he learned new motor skills such as mirror drawing."
   sources: [ ~"../../registries/sources/life-and-mind.spw#src_life_scoville_milner_1957", ~"../../registries/sources/life-and-mind.spw#src_life_corkin_2002" ]
   ^["limits"]{
    holds: "the contrast between new declarative learning and new skill learning"
    fails: "his amnesia was dense, not total; decades of testing found some new knowledge did get through"
   }
  }
  #>cognition_memory_levels
  ^["levels_of_processing"]{
   #:claim #!settled
   statement: "Craik and Lockhart proposed that processing a word for its meaning leaves a more durable memory than processing its sound or look, and experiments that followed bore this out."
   source: ~"../../registries/sources/life-and-mind.spw#src_life_craik_lockhart_1972"
   ^["limits"]{
    holds: "ordinary recall and recognition tests"
    fails: "when the final test asks about rhyme, rhyme-based study can win, which transfer-appropriate processing explains"
    source: ~"../../registries/sources/life-and-mind.spw#src_life_baddeley_2020"
   }
  }
  #>cognition_memory_context
  ^["encoding_specificity"]{
   #:claim #!settled
   statement: "Recall improves when retrieval reinstates the study context; divers who learned words underwater recalled more underwater, and those who learned on land recalled more on land."
   source: ~"../../registries/sources/life-and-mind.spw#src_life_baddeley_2020"
   credit: "Endel Tulving and Donald Thomson named encoding specificity in 1973; Duncan Godden and Alan Baddeley ran the diver study in 1975"
  }
 }
 ^["forgetting"]{
  #>cognition_memory_forgetting_form
  ^["form_of_forgetting"]{
   #:claim #!settled
   statement: "Forgetting is steep at first and slows over time; across recall, recognition, and animal data a power function fit better than an exponential, including Ebbinghaus's own savings data."
   source: ~"../../registries/sources/life-and-mind.spw#src_life_wixted_ebbesen_1991"
   credit: "Hermann Ebbinghaus measured forgetting on himself with nonsense syllables"
   credit_source: ~"../../registries/sources/life-and-mind.spw#src_life_ebbinghaus_1885"
  }
  #>cognition_memory_ebbinghaus_replication
  ^["replication"]{
   #:claim #!settled
   statement: "A one-person replication of Ebbinghaus's savings method reproduced his forgetting curve, with an upward jump at the one-day point."
   source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_murre_dros_2015"
  }
  #>cognition_memory_raw_exponential
  ^["raw_exponential"]{
   #:claim #!refuted
   statement: "The raw description of an exponential forgetting curve is wrong in form: forgetting slows more than a single exponential allows."
   sources: [ ~"../../registries/sources/life-and-mind.spw#src_life_wixted_ebbesen_1991", ~"../../registries/sources/provenance-and-reference.spw#src_prov_murre_dros_2015" ]
  }
 }
 ^["learning"]{
  #>cognition_memory_spacing
  ^["spacing"]{
   #:claim #!settled
   statement: "Spreading study across sessions beats massing it for long-term retention, and the best gap between sessions grows with how long the material must be kept."
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_cepeda_2006"
  }
  #>cognition_memory_testing
  ^["testing_effect"]{
   #:claim #!settled
   statement: "Recalling material on practice tests, even without feedback, left more remembered days later than restudying it, though restudying won on a test five minutes later."
   sources: [ ~"../../registries/sources/learning-and-generations.spw#src_learn_roediger_karpicke_2006", ~"../../registries/sources/learning-and-generations.spw#src_learn_dunlosky_2013" ]
   ~#say(the test is part of the lesson)
  }
 }
 ^["knowledge"]{
  #>cognition_memory_networks
  ^["semantic_networks"]{
   #:claim #!settled
   statement: "People recognize a word faster just after a related one, which spreading-activation models explain as activation flowing along links between concepts."
   source: ~"../../registries/sources/life-and-mind.spw#src_life_baddeley_2020"
   credit: "Allan Collins and Elizabeth Loftus proposed the spreading-activation model in 1975; Eleanor Rosch and colleagues showed that a basic level such as chair is the one people name first"
  }
 }
 ^["reconstruction"]{
  #>cognition_memory_bartlett
  ^["schemas"]{
   #:claim #!settled
   statement: "When English readers retold an unfamiliar Native American story over time, their versions grew shorter and shifted toward their own conventions, which Bartlett read as recall rebuilt from schemas."
   source: ~"../../registries/sources/learning-and-generations.spw#src_learn_bartlett_1932"
   origin: "the story, The War of the Ghosts, is a Chinookan narrative from the lower Columbia River that Bartlett adapted from a translation by Franz Boas"
   ^["limits"]{
    holds: "as a demonstration that recall reconstructs"
    fails: "Bartlett's procedure was informal and his examples chosen, so the size of the distortion is not measured here"
   }
  }
  #>cognition_memory_misinformation
  ^["leading_questions"]{
   #:claim #!settled
   statement: "After a film of a car crash, people asked how fast the cars smashed gave higher speeds than people asked how fast they hit, and more later recalled broken glass never shown."
   source: ~"../../registries/sources/life-and-mind.spw#src_life_loftus_palmer_1974"
  }
  #>cognition_memory_confidence
  ^["first_confidence"]{
   #:claim #!settled
   statement: "Under pristine procedures, a fair lineup, no administrator influence, and an immediate confidence statement, a witness's initial high-confidence identification is usually accurate; later or contaminated confidence is not."
   source: ~"../../registries/sources/life-and-mind.spw#src_life_wixted_wells_2017"
  }
  =~"./memory-and-representation.spw#cognition_memory_confidence"[contrasts]{ ~"./memory-and-representation.spw#cognition_memory_misinformation" }
 }
}

#>cognition_memory_future_q
?["Is memory built to imagine the future as much as to keep the past?"]{
 #:depth #!computational ~#lens(information flow)
 #:claim #!speculative
 ~#hypothesis: "If one system both recalls past episodes and recombines them into imagined future ones, the recombining that makes planning flexible would also make recall prone to distortion."
 !probe{ "compare brain regions reported active when people recall past events and when they imagine future ones across published imaging studies" =id[p_life_cog_past_future] =kind[lit] }
 ~"./memory-and-representation.spw#cognition_memory_bartlett" ~#neighbor(nearest)
}

#>cognition_memory_four_q
?["Why would the focus of attention hold about four chunks?"]{
 #:depth #!computational ~#lens(information flow)
 #:claim #!speculative
 ~#hypothesis: "If items held together interfere more with each one added, capacity would settle where the cost of another item outweighs its use, and should shrink for items that resemble each other."
 !probe{ "simulate a store whose recall accuracy falls with pairwise similarity and find where added items stop helping" =id[p_life_cog_four_chunks] =kind[sim] }
 $%[life.memory.cowan_capacity_chunks, life.memory.miller_span_chunks]
 ~"./memory-and-representation.spw#cognition_memory_capacity" ~#neighbor(nearest)
}
