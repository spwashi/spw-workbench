# Cut Vocabulary 2026-09-30
#
# Closed vocabularies for every axis, relation, lens, and status this cut uses. The gate reads the single-line sets below; a value earns its place by recurring.

#>cut_vocabulary
#:layer #!reference
#:domain #!cut
#:form #!registry
#:level #!mixed
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Cut Vocabulary"
 ~#claim: "Every tag in this cut comes from a closed set declared here."
 ~#proof: "The cut gate rejects header axes, lenses, depths, claims, relations, and probe kinds outside these sets."
 ~#door: "Read the contract next for how each axis is written."
 ~#audience: "writers, reviewers, and tools reading the cut"
 continuity: "Cut Vocabulary | closed set"
 cold_open: "Every tag in this cut comes from a closed set you can read in one place."
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5"
 lineage: #[ "new" ]
 method: #authored
}

^["axes"]{
 layer: #[ reference, pragmatics, creative, semantics ]
 domain: #[ authorship, bioengineering, broadcast, cell_biology, chemistry, cognition, communities, computing, cut, development_ecology, economics, editor_hosts, engineering, film, formal, generations, information_science, inscription, institutions, lang_design, language_and_mind, learning, linguistics, live_platforms, living, making, management, markets, materials, mathematics, media_carriers, neuroscience, nursing, optics, panel, physical, physics, plant_science, provenance, record, registry, season, secondary_schooling, society, spw, spw_perspectives, spw_theory, streaming, theatre, trail, visual_arts, workbench_history ]
 form: #[ index, outline, curriculum, field_guide, glossary, timeline, case_study, comparison, protocol, catalog, ledger, registry, trail, calendar, dossier, probe_battery, story_kit, bibliography, contract ]
 level: #[ intro, foundation, advanced, graduate, practitioner, mixed ]
 review: #[ unreviewed, spot_checked, sourced, adversarial_checked, expert_reviewed ]
 valence: #[ boon, bane, bone, bonk, honk ]
 era: #[ deep_time, prehistory, ancient, classical, medieval, early_modern, industrial, modern, contemporary, current ]
 season: #[ reflection, crescendo, reset, off_season ]
}

^["statements"]{
 claim: #[ settled, contested, emerging, speculative, refuted, interpretive, superseded ]
 depth: #[ computational, educational, stylistic, experiential, mathematical, historical, physical, social, ethical ]
 probe_kind: #[ thought, lookup, calc, sim, census, lit, interview, field, build ]
 relation: #[ needs, feeds, grounds, extends, contrasts, analog, supersedes, case_of, see ]
 event: #[ generated, revised, corrected, gated, fact_checked, sourced, woven, expert_reviewed ]
 care: #[ glance, skim, read, audit, adversarial ]
 outcome: #[ raw, pass, fail, corrected, partial ]
 clock: #[ turn, minute, hour, day, week ]
 transform: #[ expansion, comprehension, reduction, transformation, comparison ]
}

^["lenses"]{
 reading: #[ lens, neighbor, say, confidence, counter ]
 lens: #[ "ecological zone", "molecular binding", "formal structure", "material grain", "curated collection", "living system", "signal path", "market flow", "social fabric", "historical layer", "bodily rhythm", "craft practice", "information flow", "energy budget", "semiotic charge", "production cadence" ]
}

^["glosses"]{
 layer: "reference holds settled lookup; pragmatics holds how-to and protocol; creative holds prompts and kits; semantics holds theory of the language itself"
 valence: "material quality, not merit: bone for structure and indexes, boon for generative openings, bane for limits and contraindications, bonk for transitions and paradigm shifts, honk for warnings and headline takeaways"
 review: "unreviewed means generated and not checked; spot_checked means sampled; sourced means keystone claims link a registry source; adversarial_checked means a skeptic pass tried to refute them"
 claim: "settled has consensus; contested has live disagreement; emerging has early evidence; speculative is a hypothesis; refuted is kept to mark a known error; interpretive is a reading, not a fact; superseded names an older consensus"
 depth: "the canon five (computational, educational, stylistic, experiential, mathematical) plus four declared extensions for this cut"
 lens: "the canon six plus ten declared extensions; a lens earns its place by recurring across files"
 care: "how much attention an inspection applied: glance reads the card, skim reads the frames, read follows every claim, audit checks sources and numbers, adversarial tries to refute"
}
