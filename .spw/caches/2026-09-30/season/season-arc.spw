# Season Arc
#
# Fourteen weekly rungs from post-September reflection through a November crescendo and December celebration to the reset on Monday 4 January 2027.

#>season_arc
#:layer #!pragmatics
#:domain #!season
#:form #!timeline
#:level #!intro
#:review #!sourced
#:valence #!boon
#:season #!reflection

^"emit"{
 ~#title: "Season Arc"
 ~#claim: "Fourteen weekly rungs carry the season from post-September reflection through a November crescendo and December celebration to the reset on 4 January."
 ~#proof: "Rung dates are Gregorian arithmetic from Thursday 1 October 2026; each rung links its dated calendar cells, one bench, and one study trail."
 ~#door: "Find this week's rung, open its bench calendar, then walk its trail."
 ~#audience: "makers and crews planning October to January"
 continuity: "Season Arc | weekly rungs"
 cold_open: "The season arc climbs in weekly rungs from reflection to reset, and each rung names one bench and one trail."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[ "weekday arithmetic checked against the Gregorian calendar for 2026-10-01 through 2027-01-04" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #partial }
 }
}

^["edges"]{
 grounds: [
  ~"../registries/quantities/season.spw#q_season_arc",
  ~"./calendar-2026q4.spw#season_calendar_2026q4"
 ]
 feeds: [
  ~"./production-cadence.spw#season_production_cadence",
  ~"./season-journal.spw#season_journal"
 ]
 see: [ ~"../trails/season-2026-q4.spw#trail_season_2026_q4" ]
}

^["concepts"]{
 primary: [ #production_season, #weekly_rung ]
 transfers: [ #phenology, #new_year_reset ]
 tensions: [ #southern_hemisphere, #lane_collision ]
}

^["arc"]{
 clock: #week
 archetype: "a season that opens in reflection, gathers, builds to a crescendo, celebrates, and resets"
 steps: << "reflection" ; "gathering" ; "crescendo" ; "celebration" ; "reset" >>
 predict: ?{ "which rung will carry the heaviest load for you" } ~<prediction>
 counts: "a tool can count rungs, dated cells, and journal pages; it cannot count whether the work was good"
 limit: "the arc schedules attention; it never ranks, scores, or logs a person"
 exit: ~"./production-cadence.spw#season_production_cadence"
}

^["frame"]{
 #>season_arc_span
 ^["span"]{
  #:claim #!settled
  statement: "The season runs 96 days in 14 rungs, from Thursday 1 October 2026 to Monday 4 January 2027 inclusive."
  reads: %[season.arc.length_days, season.arc.week_count]
  source: ~"../registries/sources/season.spw#src_season_reingold_dershowitz_2018"
 }
 #>season_arc_thursday_rungs
 ^["thursday_rungs"]{
  #:claim #!settled
  statement: "Because 1 October 2026 is a Thursday, rungs open on US Thanksgiving, Christmas Eve, and New Year's Eve, which are all Thursdays this year."
  sources: [
   ~"../registries/sources/season.spw#src_season_reingold_dershowitz_2018",
   ~"../registries/sources/season.spw#src_season_usc5_6103"
  ]
  ^["limits"]{
   holds: "the Gregorian calendar for 2026 to 2027"
   fails: "other years shift the weekdays; Canadian Thanksgiving falls on a Monday"
  }
 }
 #>season_arc_phases
 ^["phases"]{
  #:claim #!interpretive
  statement: "The five phase names are this cut's reading of a northern production year; other calendars and the southern hemisphere put the reset elsewhere."
 }
}

^["ladder"]{
 #>season_arc_reflection
 ^["reflection"]{
  span: "Thu 2026-10-01 to Wed 2026-10-21"
  mood: "post-September reflection: fiscal years turn and terms find their pace"
  ^["rungs"]{
   #>season_arc_w01
   ^["w01"]{
    dates: "Thu 2026-10-01 to Wed 2026-10-07"
    bench: ~"../making/broadcast/broadcast-cadence.spw#broadcast_cadence"
    emphasis: "open with a media look back: the compact disc and Serial anniversaries"
    dated: [
     ~"./calendar-2026q4.spw#season_cal_fy2027",
     ~"./calendar-2026q4.spw#season_cal_cd_1982",
     ~"./calendar-2026q4.spw#season_cal_serial_2014",
     ~"./calendar-2026q4.spw#season_cal_simchat_torah"
    ]
    trail: ~"../trails/scroll-to-stream.spw#trail_scroll_to_stream"
   }
   #>season_arc_w02
   ^["w02"]{
    dates: "Thu 2026-10-08 to Wed 2026-10-14"
    bench: ~"../learning/institutions/academic-year-cadence.spw#institutions_academic_year"
    emphasis: "compare where each fiscal and academic year stands in October"
    dated: [ ~"./calendar-2026q4.spw#season_cal_thanksgiving_ca" ]
    trail: ~"../trails/clocks-and-cadences.spw#trail_clocks_and_cadences"
   }
   #>season_arc_w03
   ^["w03"]{
    dates: "Thu 2026-10-15 to Wed 2026-10-21"
    bench: ~"./retrospective-protocol.spw#season_retrospective"
    emphasis: "first retrospective: close the summer and the third quarter"
    trail: ~"../trails/corrections.spw#trail_corrections"
   }
  }
 }
 #>season_arc_gathering
 ^["gathering"]{
  span: "Thu 2026-10-22 to Wed 2026-11-11"
  mood: "gather material, contacts, and rehearsal before the peak"
  ^["rungs"]{
   #>season_arc_w04
   ^["w04"]{
    dates: "Thu 2026-10-22 to Wed 2026-10-28"
    bench: ~"../making/film/film-season-calendar.spw#film_season_calendar"
    emphasis: "autumn festivals and awards campaigns; gather footage, notes, and contacts"
    dated: [ ~"./calendar-2026q4.spw#season_cal_eu_clocks" ]
    trail: ~"../trails/light-to-image.spw#trail_light_to_image"
   }
   #>season_arc_w05
   ^["w05"]{
    dates: "Thu 2026-10-29 to Wed 2026-11-04"
    bench: ~"../making/authorship/author-season-calendar.spw#authorship_season_calendar"
    emphasis: "gather research and outlines before a November drafting month"
    dated: [
     ~"./calendar-2026q4.spw#season_cal_halloween",
     ~"./calendar-2026q4.spw#season_cal_us_dst_end",
     ~"./calendar-2026q4.spw#season_cal_dia_muertos",
     ~"./calendar-2026q4.spw#season_cal_us_election"
    ]
    trail: ~"../trails/novel-to-screen.spw#trail_novel_to_screen"
   }
   #>season_arc_w06
   ^["w06"]{
    dates: "Thu 2026-11-05 to Wed 2026-11-11"
    bench: ~"../making/streaming/live-session-craft.spw#streaming_live_session"
    emphasis: "rehearse live formats and chat rules before holiday streams"
    dated: [ ~"./calendar-2026q4.spw#season_cal_diwali" ]
    trail: ~"../trails/streamer-first-contact.spw#trail_streamer_first_contact"
   }
  }
 }
 #>season_arc_crescendo
 ^["crescendo"]{
  span: "Thu 2026-11-12 to Wed 2026-12-16"
  mood: "peak output, with rest named in advance"
  ^["rungs"]{
   #>season_arc_w07
   ^["w07"]{
    dates: "Thu 2026-11-12 to Wed 2026-11-18"
    bench: ~"../making/authorship/author-season-calendar.spw#authorship_season_calendar"
    emphasis: "drafting at full volume; protect one daily writing hour"
    trail: ~"../trails/matter-to-meaning.spw#trail_matter_to_meaning"
   }
   #>season_arc_w08
   ^["w08"]{
    dates: "Thu 2026-11-19 to Wed 2026-11-25"
    bench: ~"../making/broadcast/episode-run-sheet.spw#broadcast_run_sheet"
    emphasis: "bank holiday episodes before the travel week"
    trail: ~"../trails/paired-cases.spw#trail_paired_cases"
   }
   #>season_arc_w09
   ^["w09"]{
    dates: "Thu 2026-11-26 to Wed 2026-12-02"
    bench: ~"../society/markets/market-probe-battery.spw#markets_probe_battery"
    emphasis: "Thanksgiving opens the retail holiday stretch; read market numbers with care"
    dated: [
     ~"./calendar-2026q4.spw#season_cal_thanksgiving_us",
     ~"./calendar-2026q4.spw#season_cal_retail_weekend"
    ]
    trail: ~"../trails/market-reading.spw#trail_market_reading"
   }
   #>season_arc_w10
   ^["w10"]{
    dates: "Thu 2026-12-03 to Wed 2026-12-09"
    bench: ~"../learning/institutions/academic-year-cadence.spw#institutions_academic_year"
    emphasis: "finals approach; review the term before the last week of classes"
    dated: [ ~"./calendar-2026q4.spw#season_cal_hanukkah" ]
    trail: ~"../trails/math-to-control.spw#trail_math_to_control"
   }
   #>season_arc_w11
   ^["w11"]{
    dates: "Thu 2026-12-10 to Wed 2026-12-16"
    bench: ~"../living/plants/horticultural-science.spw#plant_science_horticulture"
    emphasis: "forced holiday plants come into bloom; note how little day length now changes"
    trail: ~"../trails/entropy-across-scales.spw#trail_entropy"
   }
  }
 }
 #>season_arc_celebration
 ^["celebration"]{
  span: "Thu 2026-12-17 to Wed 2026-12-30"
  mood: "thanks, gatherings, and rest; output winds down"
  ^["rungs"]{
   #>season_arc_w12
   ^["w12"]{
    dates: "Thu 2026-12-17 to Wed 2026-12-23"
    bench: ~"./season-journal.spw#season_journal"
    emphasis: "solstice week: write the longest-night page; bring the shared curricula kit to family visits"
    dated: [
     ~"./calendar-2026q4.spw#season_cal_solstice",
     ~"./calendar-2026q4.spw#season_cal_dongzhi_yalda"
    ]
    trail: ~"../trails/shared-curricula-kit.spw#trail_shared_curricula"
   }
   #>season_arc_w13
   ^["w13"]{
    dates: "Thu 2026-12-24 to Wed 2026-12-30"
    bench: ~"../making/film/film-season-calendar.spw#film_season_calendar"
    emphasis: "holiday releases and family viewing; the crew stands down"
    dated: [
     ~"./calendar-2026q4.spw#season_cal_christmas",
     ~"./calendar-2026q4.spw#season_cal_kwanzaa"
    ]
    trail: ~"../trails/role-words-over-time.spw#trail_role_words"
   }
  }
 }
 #>season_arc_reset
 ^["reset"]{
  span: "Thu 2026-12-31 to Mon 2027-01-04"
  mood: "close the books, release old commitments, set the first rung of the new year"
  ^["rungs"]{
   #>season_arc_w14
   ^["w14"]{
    dates: "Thu 2026-12-31 to Mon 2027-01-04"
    bench: ~"../making/film/adaptation-and-rights.spw#film_adaptation"
    emphasis: "Public Domain Day adds 1931 works; run the year retrospective; set the first rung of 2027"
    dated: [
     ~"./calendar-2026q4.spw#season_cal_new_years_eve",
     ~"./calendar-2026q4.spw#season_cal_public_domain_2027",
     ~"./calendar-2026q4.spw#season_cal_reset_monday"
    ]
    trail: ~"../trails/reference-library-lineage.spw#trail_reference_lineage"
   }
  }
 }
}

^["try"]{
 #>season_arc_try_week_card
 ^["week_card"]{
  materials: [
   "one index card per rung",
   "a pen",
   "the season calendar"
  ]
  steps: <<
   "write the rung dates" ;
   "copy its dated cells" ;
   "name one bench and one trail stop" ;
   "pin the card where the crew can see it"
  >>
  time: .{ n: 10, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"./season-arc.spw#season_arc_thursday_rungs"
 }
}

#>season_arc_thursday_q
?["Do Thursday rungs soften holiday weeks?"]{
 #:depth #!experiential ~#lens(production cadence)
 #:claim #!speculative
 ~#hypothesis: "Rungs that open on holiday Thursdays should leave fewer split work weeks than Monday-start weeks, because each holiday starts a rung instead of cutting one."
 !probe{ "log 14 rungs and count split work weeks against a Monday-start plan" =id[p_season_arc_thursday_split] =kind[field] }
 $%[season.arc.week_count, season.arc.length_days]
 ~"./season-arc.spw#season_arc_thursday_rungs" ~#neighbor(nearest)
}

#>season_arc_phenology_q
?["Is a production season a kind of phenology?"]{
 #:depth #!social ~#lens(living system)
 #:claim #!speculative
 ~#hypothesis: "Crews may time their crescendo to outside cues the way plants time growth to day length, with contracts and audiences serving as the cue."
 !probe{ "compare phenology cue models with three branch calendars" =id[p_season_arc_phenology] =kind[lit] }
 $%[season.arc.length_days]
 breaks: "plants read day length through photoreceptors and cannot opt out; crews read calendars, contracts, and audiences and can choose to ignore them"
 ~"./season-arc.spw#season_arc_phases" ~#neighbor(nearest)
}
