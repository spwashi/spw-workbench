# Season Calendar 2026 Q4
#
# Dated cells from 1 October 2026 to 4 January 2027, each marked fixed, typical, or verify, with as_of and the authority that sets it.

#>season_calendar_2026q4
#:layer #!reference
#:domain #!season
#:form #!calendar
#:level #!practitioner
#:review #!spot_checked
#:valence #!honk
#:season #!crescendo

^"emit"{
 ~#title: "Season Calendar 2026 Q4"
 ~#claim: "Every dated cell from October 2026 to January 2027 is marked fixed, typical, or verify, with as_of and its authority."
 ~#proof: "US statutes, an EU directive, Hebcal, the US Naval Observatory, and the Duke public domain list ground the fixed cells."
 ~#door: "Trust the fixed cells, plan around the typical ones, and check each verify cell against its named authority."
 ~#audience: "planners, producers, and teachers"
 continuity: "Season Calendar | fixed, typical, or verify"
 cold_open: "Each date on the season calendar is marked fixed, typical, or verify, so you know what to trust and what to check."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[ "fetched 2026-10-01: Hebcal 5787 holiday list, USNO 2026 seasons table, Duke CSPD Public Domain Day 2026", "secondary checks 2026-10-01: Serial premiere date, CD launch date, Diwali 2026 date" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #partial }
 }
}

^["edges"]{
 grounds: [ ~"../registries/quantities/season.spw#q_season_copyright" ]
 see: [
  ~"../record/carriers/digital/optical-discs.spw#media_carriers_optical",
  ~"../making/broadcast/serial-2014-case.spw#broadcast_serial_case",
  ~"../making/film/adaptation-and-rights.spw#film_adaptation",
  ~"./festivals-and-resets.spw#season_resets"
 ]
}

^["concepts"]{
 primary: [ #calendar_cell, #production_season ]
 transfers: [ #public_domain, #fiscal_year, #solstice, #calendar_type ]
 tensions: [ #southern_hemisphere ]
}

^["legend"]{
 fixed: "set by statute, by calendar arithmetic, or by a past event; it moves only if the rule changes"
 typical: "the usual window; local practice or an annual proclamation decides the day"
 verify: "expected, but past this cut's verified knowledge or locally variable; check the named authority"
 as_of: "2026-10-01 unless a cell says otherwise"
}

^["october"]{
 #>season_cal_fy2027
 ^["fy2027"]{
  #:claim #!settled
  date: "Thu 2026-10-01"
  status: #fixed
  statement: "US federal fiscal year 2027 begins on 1 October 2026; the Treasury fiscal year runs from 1 October to 30 September."
  source: ~"../registries/sources/season.spw#src_season_usc31_1102"
  verify: "whether full-year appropriations or a continuing resolution were in force on 1 October 2026"
 }
 #>season_cal_cd_1982
 ^["cd_1982"]{
  #:claim #!settled
  date: "Fri 1982-10-01, anniversary"
  status: #fixed
  statement: "The compact disc reached retail in Japan on 1 October 1982, sold with the Sony CDP-101 player."
  source: ~"../registries/sources/season.spw#src_season_immink_1998"
  ~#(an anniversary cell: the 44th falls on the day the season opens)
 }
 #>season_cal_serial_2014
 ^["serial_2014"]{
  #:claim #!settled
  date: "Fri 2014-10-03, anniversary"
  status: #fixed
  statement: "Serial, hosted by Sarah Koenig and co-created with Julie Snyder at This American Life, released its first episode on 3 October 2014."
  source: ~"../registries/sources/season.spw#src_season_serial_2014"
 }
 #>season_cal_simchat_torah
 ^["simchat_torah"]{
  #:claim #!settled
  date: "Sat 2026-10-03 at sunset to Sun 2026-10-04 at nightfall, outside Israel"
  status: #fixed
  statement: "Simchat Torah begins at sunset on 3 October 2026 outside Israel, a day earlier in Israel; the yearly cycle of Torah readings ends and begins again."
  source: ~"../registries/sources/season.spw#src_season_hebcal_5787"
 }
 #>season_cal_thanksgiving_ca
 ^["thanksgiving_ca"]{
  date: "Mon 2026-10-12"
  status: #typical
  rule: "Canadian Thanksgiving is observed on the second Monday of October"
 }
 #>season_cal_eu_clocks
 ^["eu_clocks"]{
  #:claim #!settled
  date: "Sun 2026-10-25, 01:00 UTC"
  status: #fixed
  statement: "EU summer time ends at 01:00 UTC on the last Sunday of October, which is 25 October 2026."
  source: ~"../registries/sources/season.spw#src_season_eu_2000_84"
  verify: "a 2018 Commission proposal to end seasonal clock changes had not been adopted as of this cut; check before relying on later years"
 }
 #>season_cal_halloween
 ^["halloween"]{
  date: "Sat 2026-10-31"
  status: #fixed
  see: ~"./festivals-and-resets.spw#season_resets_samhain"
 }
}

^["november"]{
 #>season_cal_us_dst_end
 ^["us_dst_end"]{
  #:claim #!settled
  date: "Sun 2026-11-01, 02:00 local time"
  status: #fixed
  statement: "US daylight saving time ends on the first Sunday of November, which is 1 November 2026."
  source: ~"../registries/sources/season.spw#src_season_usc15_260a"
  ^["limits"]{
   holds: "states and territories that observe daylight saving time"
   fails: "Hawaii and most of Arizona stay on standard time all year"
  }
 }
 #>season_cal_dia_muertos
 ^["dia_muertos"]{
  date: "Sun 2026-11-01 to Mon 2026-11-02"
  status: #fixed
  see: ~"./festivals-and-resets.spw#season_resets_dia_muertos"
 }
 #>season_cal_us_election
 ^["us_election"]{
  #:claim #!settled
  date: "Tue 2026-11-03"
  status: #fixed
  statement: "US federal general elections fall on the Tuesday after the first Monday of November in even years, which is 3 November 2026."
  source: ~"../registries/sources/season.spw#src_season_usc2_7"
  ~#(a broadcast cell: election night shapes news and live schedules that week)
 }
 #>season_cal_diwali
 ^["diwali"]{
  date: "Sun 2026-11-08, expected"
  status: #verify
  check: "published Hindu calendars give 8 November for Lakshmi Puja; regional almanacs can differ by a day"
  see: ~"./festivals-and-resets.spw#season_resets_diwali"
 }
 #>season_cal_thanksgiving_us
 ^["thanksgiving_us"]{
  #:claim #!settled
  date: "Thu 2026-11-26"
  status: #fixed
  statement: "US Thanksgiving is a federal holiday on the fourth Thursday of November, which is 26 November 2026."
  source: ~"../registries/sources/season.spw#src_season_usc5_6103"
 }
 #>season_cal_retail_weekend
 ^["retail_weekend"]{
  date: "Fri 2026-11-27 to Mon 2026-11-30"
  status: #typical
  note: "the shopping weekend after US Thanksgiving opens the busiest weeks of the retail fourth quarter"
  see: ~"./fiscal-and-academic-years.spw#season_fiscal_retail"
 }
}

^["december"]{
 #>season_cal_hanukkah
 ^["hanukkah"]{
  #:claim #!settled
  date: "Fri 2026-12-04 at sunset, eight nights"
  status: #fixed
  statement: "Hanukkah begins with the first candle at sunset on 4 December 2026 and lasts eight nights."
  source: ~"../registries/sources/season.spw#src_season_hebcal_5787"
 }
 #>season_cal_solstice
 ^["solstice"]{
  #:claim #!settled
  date: "Mon 2026-12-21, 20:50 UTC"
  status: #fixed
  statement: "The December solstice falls at 20:50 UTC on 21 December 2026, which is already the morning of 22 December in China and Japan."
  source: ~"../registries/sources/season.spw#src_season_usno_seasons_2026"
 }
 #>season_cal_dongzhi_yalda
 ^["dongzhi_yalda"]{
  date: "Mon 2026-12-21 to Tue 2026-12-22"
  status: #verify
  check: "Dongzhi follows the solstice in China time, so 22 December; Yalda is the night before the first day of Dey in the Iranian calendar"
  see: ~"./festivals-and-resets.spw#season_resets_yalda"
 }
 #>season_cal_christmas
 ^["christmas"]{
  date: "Fri 2026-12-25"
  status: #fixed
  note: "churches keeping the Julian calendar celebrate on 7 January 2027 in the Gregorian count"
 }
 #>season_cal_kwanzaa
 ^["kwanzaa"]{
  date: "Sat 2026-12-26 to Fri 2027-01-01"
  status: #fixed
  see: ~"./festivals-and-resets.spw#season_resets_kwanzaa"
 }
 #>season_cal_new_years_eve
 ^["new_years_eve"]{
  date: "Thu 2026-12-31"
  status: #fixed
  note: "Hogmanay in Scotland and Omisoka in Japan close the Gregorian year"
 }
}

^["january"]{
 #>season_cal_public_domain_2027
 ^["public_domain_2027"]{
  #:claim #!settled
  date: "Fri 2027-01-01"
  status: #fixed
  statement: "On 1 January 2027, US works published in 1931 and sound recordings published in 1926 enter the public domain, because terms run to the end of the calendar year."
  reads: %[
   season.copyright.us_published_term_years,
   season.copyright.us_recording_term_years
  ]
  sources: [
   ~"../registries/sources/season.spw#src_season_usc17_copyright",
   ~"../registries/sources/season.spw#src_season_duke_pdd_2026"
  ]
  verify: "the 2027 headline titles; check the Duke list for 2027 before citing any one work"
  corrects: "the raw film-adaptation file said works before 1929; the line is 1931 as of 2026 and 1932 from 1 January 2027"
  ^["limits"]{
   holds: "works first published in the US in 1931 whose copyright was renewed"
   fails: "later versions, translations, trademarks, and unpublished works keep their own terms; other countries follow their own laws"
  }
 }
 #>season_cal_reset_monday
 ^["reset_monday"]{
  #:claim #!interpretive
  date: "Mon 2027-01-04"
  status: #fixed
  statement: "The season closes on the first Monday of 2027, when most offices and many schools resume."
 }
 #>season_cal_julian_christmas
 ^["julian_christmas"]{
  date: "Thu 2027-01-07"
  status: #fixed
  note: "Christmas for churches on the Julian calendar, three days after the season closes"
 }
}

^["horizon"]{
 #>season_cal_lunar_new_year_2027
 ^["lunar_new_year_2027"]{
  date: "Sat 2027-02-06, expected"
  status: #verify
  check: "published Chinese calendar tables give 6 February 2027, a month after the season closes"
  see: ~"./festivals-and-resets.spw#season_resets_lunar_new_year"
 }
}

#>season_cal_thanksgiving_q
?["How often does US Thanksgiving land on the 26th?"]{
 #:depth #!mathematical ~#lens(formal structure)
 #:claim #!speculative
 ~#hypothesis: "Across one 400-year Gregorian cycle the seven possible dates, 22 to 28 November, should occur almost but not exactly equally often."
 !probe{ "count fourth Thursdays of November over one Gregorian cycle" =id[p_season_cal_thanksgiving_cycle] =kind[calc] }
 $%[season.calendar.gregorian_cycle_years, season.calendar.gregorian_cycle_days]
 ~"./calendar-2026q4.spw#season_cal_thanksgiving_us" ~#neighbor(nearest)
}

#>season_cal_public_domain_q
?["Does Public Domain Day change what gets reprinted and adapted?"]{
 #:depth #!historical ~#lens(curated collection)
 #:claim #!speculative
 ~#hypothesis: "Works entering the public domain should gain new editions and adaptations in the following years faster than comparable works still under copyright."
 !probe{ "count new editions of 1931 titles listed for 2026, 2027, and 2028" =id[p_season_cal_pd_editions] =kind[census] }
 $%[season.copyright.us_published_term_years]
 ~"./calendar-2026q4.spw#season_cal_public_domain_2027" ~#neighbor(nearest)
}
