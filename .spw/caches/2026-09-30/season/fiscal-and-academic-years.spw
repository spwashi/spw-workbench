 primary: [ #fiscal_year, #academic_term ]
 transfers: [ #production_season, #grant_cycle ]
 tensions: [ #southern_hemisphere ]
}

^["columns"]{
 start: "first day of the year"
 on_october_first: "where the year stands when the season opens"
 status: "fixed by statute or survey; typical where practice varies"
}

^["fiscal"]{
 #>season_fiscal_us_federal
 ^["us_federal"]{
  #:claim #!settled
  start: "1 October"
  on_october_first: "the year restarts: quarter one of fiscal year 2027"
  statement: "The US federal fiscal year runs 1 October to 30 September; the 1974 Budget Act moved its start from 1 July, with a transition quarter in 1976."
  sources: [
   ~"../registries/sources/season.spw#src_season_usc31_1102",
   ~"../registries/sources/season.spw#src_season_cbica_1974"
  ]
 }
 #>season_fiscal_us_states
 ^["us_states"]{
  #:claim #!settled
  start: "1 July in most states"
  on_october_first: "quarter two begins for most states"
  statement: "Forty-six states begin their fiscal year on 1 July; New York begins on 1 April, Texas on 1 September, and Alabama and Michigan on 1 October."
  reads: %[season.fiscal.us_states_july_start_count]
  source: ~"../registries/sources/season.spw#src_season_ncsl_fy2026"
  as_of: "fiscal year 2026, checked 2026-10-01"
 }
 #>season_fiscal_uk
 ^["uk"]{
  #:claim #!settled
  start: "1 April for government accounts; 6 April for income tax"
  on_october_first: "the second half begins"
  statement: "UK central government counts its financial year to 31 March, while the personal income tax year runs from 6 April to 5 April."
  sources: [
   ~"../registries/sources/season.spw#src_season_uk_interpretation_1978",
   ~"../registries/sources/season.spw#src_season_uk_ita_2007"
  ]
 }
 #>season_fiscal_uk_tax_origin
 ^["uk_tax_origin"]{
  #:claim #!interpretive
  statement: "A widely repeated account traces 6 April to the old Lady Day year start of 25 March, moved by the eleven days dropped in 1752 and one more in 1800."
  source: ~"../registries/sources/season.spw#src_season_uk_calendar_act_1750"
  ~#(the 1752 change is statute; the step from it to 6 April is the repeated account)
 }
 #>season_fiscal_canada
 ^["canada"]{
  #:claim #!settled
  start: "1 April"
  on_october_first: "the second half begins"
  statement: "The Canadian federal fiscal year runs from 1 April to 31 March."
  source: ~"../registries/sources/season.spw#src_season_ca_faa"
 }
 #>season_fiscal_japan
 ^["japan"]{
  #:claim #!settled
  start: "1 April for both the state budget and the school year"
  on_october_first: "the second half begins; many universities open a second semester"
  statement: "Japan begins both its state fiscal year and its school year on 1 April."
  sources: [
   ~"../registries/sources/season.spw#src_season_japan_public_finance_1947",
   ~"../registries/sources/season.spw#src_season_japan_school_regs_1947"
  ]
 }
 #>season_fiscal_india
 ^["india"]{
  #:claim #!settled
  start: "1 April"
  on_october_first: "the second half begins"
  statement: "Indian law defines the financial year as the year beginning on 1 April."
  source: ~"../registries/sources/season.spw#src_season_india_gca_1897"
 }
 #>season_fiscal_australia
 ^["australia"]{
  #:claim #!settled
  start: "1 July"
  on_october_first: "quarter two begins"
  statement: "The Australian financial year runs from 1 July to 30 June."
  source: ~"../registries/sources/season.spw#src_season_au_aia_1901"
 }
 #>season_fiscal_retail
 ^["retail_454"]{
  #:claim #!settled
  start: "early February, after the Saturday nearest 31 January"
  on_october_first: "the third quarter is closing; the holiday quarter opens in November"
  statement: "Many US retailers keep a 4-5-4 calendar of 13-week quarters, ending the year near 31 January so the holiday season sits whole in one quarter."
  reads: %[season.fiscal.retail_quarter_weeks]
  source: ~"../registries/sources/season.spw#src_season_nrf_454"
 }
 #>season_fiscal_year_end_spending
 ^["year_end_spending"]{
  #:claim #!emerging
  statement: "Liebman and Mahoney found US federal procurement spending spikes in the last week of the fiscal year, and year-end IT projects drew lower quality ratings."
  source: ~"../registries/sources/season.spw#src_season_liebman_mahoney_2017"
  ^["limits"]{
   holds: "US federal procurement contracts in the period they studied"
   fails: "grants, other countries, and funds that carry over between years may behave differently"
  }
 }
}

^["academic"]{
 #>season_academic_systems
 ^["calendar_systems"]{
  #:claim #!settled
  statement: "US colleges report one academic calendar system to IPEDS: semester, quarter, trimester, four-one-four, or another pattern."
  source: ~"../registries/sources/season.spw#src_season_ipeds_glossary"
  as_of: "2026-10-01"
 }
 ^["rows"]{
  ^["semester"]{
   status: #typical
   october: "mid-term; the fall term runs from late August or early September to mid-December"
  }
  ^["quarter"]{
   status: #typical
   october: "the first half of a fall quarter that opened in late September"
  }
  ^["trimester"]{
   status: #typical
   october: "the first of three terms, closing before the winter break"
  }
  ^["four_one_four"]{
   status: #typical
   october: "the long fall term; a short January term follows and overlaps the reset week"
  }
  ^["japan"]{
   status: #typical
   october: "April entry; many universities start their second semester in late September or October"
  }
  ^["southern"]{
   status: #typical
   october: "Australian and New Zealand school years follow the calendar year, so October to January closes the year and opens the summer break"
  }
 }
}

^["grants"]{
 #>season_fiscal_continuing_resolution
 ^["continuing_resolution"]{
  #:claim #!settled
  statement: "When regular appropriations are not enacted by 1 October, a continuing resolution keeps agencies running, usually at a rate tied to the prior year."
  source: ~"../registries/sources/season.spw#src_season_gao_glossary_2005"
  verify: "the fiscal year 2027 appropriations status on 1 October 2026"
  see: ~"../learning/institutions/research-funding.spw#institutions_research_funding"
 }
}

^["try"]{
 #>season_fiscal_try_year_wheel
 ^["year_wheel"]{
  materials: [
   "a sheet of paper",
   "the fiscal year start of your employer, client, or school",
   "two colored pens"
  ]
  steps: <<
   "draw a circle for the calendar year with twelve month ticks" ;
   "mark where each of your fiscal and academic years starts" ;
   "shade how much of each year has passed by 1 October" ;
   "note which year restarts in October and which is half spent"
  >>
  time: .{ n: 20, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"./fiscal-and-academic-years.spw#season_fiscal_us_states"
 }
}

#>season_fiscal_buffer_q
?["Does a July start give states a buffer the federal year lacks?"]{
 #:depth #!social ~#lens(market flow)
 #:claim #!speculative
 ~#hypothesis: "States that start on 1 July should enter October with enacted budgets more often than the federal government, which starts on 1 October."
 !probe{ "compare NCSL budget status reports with federal continuing resolution history" =id[p_season_fiscal_state_buffer] =kind[lookup] }
 $%[season.fiscal.us_states_july_start_count]
 ~"./fiscal-and-academic-years.spw#season_fiscal_us_states" ~#neighbor(nearest)
}
