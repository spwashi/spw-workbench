# Fiscal and Academic Years
#
# Why October finds most fiscal years a quarter or half spent, the US federal year starting over, and northern academic terms at their working pace.

#>season_fiscal_academic
#:layer #!reference
#:domain #!season
#:form #!comparison
#:level #!foundation
#:review #!sourced
#:valence #!bone
#:era #!current
#:season #!reflection

^"emit"{
 ~#title: "Fiscal and Academic Years"
 ~#claim: "By October most fiscal years are a quarter or half spent, while the US federal year restarts and northern academic terms reach their working pace."
 ~#proof: "Statutes in the US, UK, Canada, Japan, India, and Australia, the NCSL state survey, the NRF retail calendar, and the IPEDS calendar systems."
 ~#door: "Place your own fiscal and academic year in the matrix, then open the research funding surface."
 ~#audience: "students, staff, freelancers, and grant writers"
 continuity: "Fiscal and Academic Years | a quarter or half spent"
 cold_open: "In October most fiscal years are a quarter or half spent, while the federal year starts over and school terms hit their stride."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[ "fetched 2026-10-01: NCSL FY 2026 State Budget Status for state fiscal year start dates" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["edges"]{
 grounds: [ ~"../learning/institutions/research-funding.spw#institutions_research_funding" ]
 needs: [ ~"../learning/institutions/academic-year-cadence.spw#institutions_academic_year" ]
