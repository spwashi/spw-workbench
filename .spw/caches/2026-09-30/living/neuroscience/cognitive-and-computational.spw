# Cognitive and Computational Neuroscience
#
# Population codes, spike-timing plasticity, attractor maps of space, replay, oscillations, and the tools that record them, with predictive processing held here once as a contested framework.

#>neuroscience_computational
#:layer #!reference
#:domain #!neuroscience
#:form #!ledger
#:level #!graduate
#:review #!sourced
#:valence #!bonk

^"emit"{
 ~#title: "Cognitive and Computational Neuroscience"
 ~#claim: "Brains represent direction, place, and value in the joint activity of many neurons, and attractor dynamics and replay let those codes persist and teach; predictive processing remains a contested frame."
 ~#proof: "Georgopoulos on population vectors, O'Keefe and the Mosers on place and grid cells, Gardner on the grid torus, Foster and Wilson on reverse replay, Schultz on dopamine, Walsh on the evidence for predictive processing."
 ~#door: "Read population codes first, then spatial attractors, then replay and reward, then the contested frame."
 ~#audience: "graduate students and modelers"
 continuity: "Cognitive and Computational Neuroscience | many neurons"
 cold_open: "A brain stores where you are and what you want in the joint activity of many neurons, not in any single cell."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
