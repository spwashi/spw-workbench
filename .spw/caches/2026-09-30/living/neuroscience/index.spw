# Neuroscience
#
# Ion channels, sensory circuits, and neural computation, with three popular overclaims about the brain moved to the errata and kept here only with their counter-sources.

#>neuroscience_index
#:layer #!reference
#:domain #!neuroscience
#:form #!index
#:level #!advanced
#:review #!sourced
#:valence #!bone

^"emit"{
 ~#title: "Neuroscience"
 ~#claim: "Neuroscience runs from ion channels to circuits to population codes, and its most quoted popular claims about energy, split brains, and new neurons are less settled than they sound."
 ~#proof: "Leaves cite Hodgkin and Huxley, Hubel and Wiesel, and the replay and grid-cell work; the stance cites Raichle, Pinto, Sorrells, and Boldrini."
 ~#door: "Start with cellular neurobiology, then systems and sensory circuits, then cognitive and computational neuroscience."
 ~#audience: "advanced students and readers who already know what a neuron is"
 continuity: "Neuroscience | less settled than they sound"
 cold_open: "Neuroscience runs from channels to circuits to codes, and its favorite popular claims are less settled than they sound."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/neuroscience/taste.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #fail }
  ^["r4"]{ event: #sourced, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 receipt_note: "r3 was first written as a pass while every source link pointed at a registry not yet written; r4 wrote and checked that registry, and r5 is the passing run after it"
 corrections: #[
  "split-brain surgery is no longer said to create two independent conscious streams; perception splits, and whether awareness does is contested (raw line 38)",
  "adult neurogenesis until the final breath is now a contest between 2018 and 2019 studies with opposite results (raw line 24)",
  "the raw claim that resting activity uses over 80 percent of brain energy had no source; the sourced share is the whole brain against the whole body, and intrinsic activity is described as the largest part (raw line 30)",
  "the raw claim that over 99 percent of neurons are silent each millisecond is replaced by Lennie's energy-budget estimate and its limits (raw index line 44)",
  "the 86 billion neuron count is kept and sourced to Azevedo and colleagues; the tenfold glia figure it is often quoted with is refuted by the same count",
  "2026-10-03: the facet row gives cellular neurobiology the state_machine form its leaf declares; the Pinto, Lennie, and Attwell and Laughlin abstracts were reread against the stance claims"
 ]
}

