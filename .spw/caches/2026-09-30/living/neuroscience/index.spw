}

^["ladder"]{
 rungs: << "advanced: cellular neurobiology" ; "advanced: systems and sensory circuits" ; "graduate: cognitive and computational neuroscience" >>
 ^["prerequisites"]{
  channel_before_circuit: "receptive fields are built from spikes and synapses, so cellular neurobiology comes first"
  circuit_before_code: "population codes and attractors read activity across mapped circuits, so systems come before computation"
  cells_before_neurons: "synaptic vesicle fusion is a cell biology mechanism with its single home in transport and signaling"
 }
}

^["facets"]{
 order: "leaves by matter, then form, then level"
 rows: #[
  .{ leaf: "cellular-neurobiology", matter: "channels, action potentials, synapses, LTP", form: "state_machine", level: "advanced" },
  .{ leaf: "systems-and-sensory-circuits", matter: "receptors, pathways, cortical maps", form: "comparison", level: "advanced" },
  .{ leaf: "cognitive-and-computational", matter: "population codes, attractors, replay", form: "ledger", level: "graduate" }
 ]
}

^["stance"]{
 #>neuroscience_index_neuron_doctrine
 ^["neuron_doctrine"]{
  #:claim #!settled
  statement: "Ramon y Cajal argued from Golgi-stained tissue that the nervous system is built of separate cells that contact one another, the neuron doctrine; Cajal and Golgi shared the 1906 Nobel Prize."
  source: ~"../../registries/sources/life-and-mind.spw#src_life_shepherd_1991"
  ~#(DeFelipe took a book title from the Cajal phrase butterflies of the soul)
  reading: ~"../../registries/sources/life-and-mind.spw#src_life_defelipe_2010"
 }
 #>neuroscience_index_count
 ^["neuron_count"]{
  #:claim #!settled
  statement: "An adult human brain holds about 86 billion neurons and a similar number of other cells, so the quoted tenfold excess of glia does not hold."
  reads: %[life.brain.neurons_e9, life.brain.nonneuronal_e9]
  source: ~"../../registries/sources/life-and-mind.spw#src_life_azevedo_2009"
 }
 #>neuroscience_index_energy
 ^["energy_budget"]{
  #:claim #!settled
  statement: "The adult brain is about 2 percent of body weight but uses about 20 percent of the body's oxygen and calories, and ongoing intrinsic activity likely takes more of it than task-evoked changes."
  reads: %[life.brain.mass_share_pct, life.brain.energy_share_pct]
  sources: [ ~"../../registries/sources/life-and-mind.spw#src_life_raichle_gusnard_2002", ~"../../registries/sources/life-and-mind.spw#src_life_raichle_mintun_2006" ]
 }
 #>neuroscience_index_sparse
 ^["sparse_activity"]{
  #:claim #!settled
  statement: "Energy budgets limit how many neurons can fire hard at once; Lennie estimated possibly fewer than 1 percent of human cortical neurons, and Attwell and Laughlin favored codes with at most 15 percent active."
  reads: %[life.brain.active_neurons_pct_max, life.brain.ap_energy_share_pct]
  sources: [ ~"../../registries/sources/life-and-mind.spw#src_life_lennie_2003", ~"../../registries/sources/life-and-mind.spw#src_life_attwell_laughlin_2001" ]
  ^["limits"]{
   holds: "as an upper bound derived from energy cost per spike"
   fails: "it is an estimate from a budget, not a count of silent neurons at any moment"
  }
 }
 #>neuroscience_index_split_brain
 ^["split_brain"]{
  #:claim #!contested
  statement: "Cutting the corpus callosum splits visual perception between hemispheres; whether it splits awareness into two agents is disputed, since two patients reported stimuli across the whole field."
  source: ~"../../registries/sources/life-and-mind.spw#src_life_gazzaniga_1962"
  counter: ~"../../registries/sources/life-and-mind.spw#src_life_pinto_2017"
 }
 #>neuroscience_index_neurogenesis
 ^["adult_neurogenesis"]{
  #:claim #!contested
  statement: "Whether new neurons keep forming in the adult human hippocampus is unresolved; postmortem studies with different tissue handling and markers reached opposite answers."
  sources: [ ~"../../registries/sources/life-and-mind.spw#src_life_boldrini_2018", ~"../../registries/sources/life-and-mind.spw#src_life_moreno_jimenez_2019" ]
  counter: ~"../../registries/sources/life-and-mind.spw#src_life_sorrells_2018"
 }
 #>neuroscience_index_hard_problem
 ^["hard_problem"]{
  #:claim #!interpretive
  statement: "Chalmers argued that explaining every function of the brain would still leave open why any of it is felt; this branch treats that as a live philosophical question, not a finding."
  source: ~"../../registries/sources/life-and-mind.spw#src_life_chalmers_1995"
 }
}

^["gaps"]{
 predicted: #[
  "glia as active partners, expected beside cellular neurobiology",
  "developmental neuroscience, expected beside the sensitive-periods leaf in development and ecology",
  "neurology and psychiatry as clinical fields, deliberately absent; this branch is not clinical reference"
 ]
}

^["doors"]{
 student: "cellular neurobiology, then systems and sensory circuits"
 modeler: "cognitive and computational, after the channel state machine"
 skeptic: "the stance frame above, then the errata surface"
}

#>neuroscience_index_watts_q
?["How many watts does a resting brain draw?"]{
 #:depth #!mathematical ~#lens(energy budget)
 #:claim #!speculative
 ~#hypothesis: "Multiplying the brain share by a resting whole-body metabolic rate gives a power near that of a dim light bulb, below the draw of hardware used for comparable perception tasks."
 !probe{ "take a sourced adult resting metabolic rate in watts, multiply by the brain share, and compare with a cited GPU power draw" =id[p_life_neuro_watts] =kind[calc] }
 $%[life.brain.energy_share_pct, life.brain.mass_share_pct]
 ~"./index.spw#neuroscience_index_energy" ~#neighbor(nearest)
}
