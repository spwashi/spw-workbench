 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/nursing/pathophysiology-and-pharmacology-in-nursing.spw" ]
 ^["receipts"]{
