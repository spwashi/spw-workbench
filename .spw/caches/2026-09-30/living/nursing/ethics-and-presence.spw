 revision_2026_10_03: "r6 redated the r4 fact-check to 2026-10-02, the day its sources were read; a singleton concept tag was swapped for a recurring one where the fit is real: polyvagal_theory became overclaim"
 corrections: #[
  "the raw wonder framed comfort at withdrawal of life support as peace without drugs; palliative consensus treats pain and breathlessness with titrated medicines as part of comfort care (raw line 39)",
  "polyvagal theory was presented as established; it is contested and its premises are disputed (raw line 39)",
  "the raw hand-holding wonder carried invented autonomic metrics and was dropped (raw line 41)",
  "the raw file is quarantined; this surface was written from the named consensus statements, books, and cases",
  "fact-check: Cruzan was said to recognize a right to refuse artificial nutrition; the Court inferred the liberty interest from precedent and only assumed, for the case, that it covers nutrition and hydration",
  "fact-check: Benner applied the 1980 Dreyfus report, not the 1986 book, which is now cited as the later statement",
  "fact-check: the fourth SAMHSA principle is collaboration and mutuality"
 ]
}

^["edges"]{
 needs: [ ~"./clinical-foundations.spw#nursing_foundations" ]
 see: [ ~"./critical-care.spw#nursing_critical_care", ~"./guideline-currency-ledger.spw#nursing_guideline_ledger" ]
}

^["concepts"]{
 primary: [ #comfort_care, #advocacy, #moral_distress ]
 transfers: [ #consent, #presence ]
 tensions: [ #overclaim ]
}

^["scope"]{
 #>nursing_ethics_guard
 ^["guard"]{
  #:valence #!honk
  warning: "end-of-life decisions belong to the patient, the surrogate, and the care team under local law; this dossier explains the vocabulary and the history, and decides nothing"
 }
 what: "ethics of nursing care, told through frameworks and public court cases"
 not_advice: "general information, not legal or medical advice"
 where_to_ask: "the care team, a palliative care service, a hospital ethics committee, or a lawyer for the law where you live"
}

^["cases"]{
 #>nursing_ethics_quinlan
 ^["quinlan"]{
  #>nursing_ethics_quinlan_holding
  ^["holding"]{
   #:claim #!settled
   statement: "In re Quinlan let a guardian father ask that his daughter's ventilator be withdrawn under her right of privacy, and pointed to hospital ethics committees."
   source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_quinlan_1976"
  }
  when: "1976"
  court: "Supreme Court of New Jersey"
  for_nursing: "families may speak for a patient who cannot, and ethics committees exist to help"
 }
 #>nursing_ethics_cruzan
 ^["cruzan"]{
  #>nursing_ethics_cruzan_holding
  ^["holding"]{
   #:claim #!settled
   statement: "Cruzan said a liberty interest in refusing unwanted treatment may be inferred from precedent, and let a state require clear and convincing evidence of an incapacitated patient's wishes."
   source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_cruzan_1990"
   assumed: "for purposes of the case only, the Court assumed a competent person could refuse lifesaving nutrition and hydration; it did not hold so"
  }
  when: "1990"
  court: "Supreme Court of the United States"
  for_nursing: "written wishes matter, because the evidence a state may demand can be strict"
 }
 #>nursing_ethics_psda
 ^["psda"]{
  #>nursing_ethics_psda_rule
  ^["rule"]{
   #:claim #!settled
   statement: "The Patient Self-Determination Act requires hospitals and other providers paid by Medicare and Medicaid to tell adult patients of their right to make advance directives."
   source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_psda_1990"
  }
  when: "enacted 1990"
  for_nursing: "nurses are often the ones who ask about advance directives at admission"
 }
}

^["end_of_life"]{
 #>nursing_ethics_comfort
 ^["comfort_care"]{
  #:claim #!settled
  statement: "During withdrawal of life support, consensus guidance treats relief of pain, breathlessness, and distress with opioids and sedatives, titrated to symptoms, as part of comfort care."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_truog_2008"
  body: "American College of Critical Care Medicine consensus statement, 2008"
  ~#say(comfort means treating the breathlessness, not watching it)
 }
 #>nursing_ethics_double_effect
 ^["double_effect"]{
  #:claim #!settled
  statement: "A review found no evidence that opioids and sedatives given in doses matched to symptoms shorten life at its end, which eases the double-effect worry."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_sykes_thorns_2003"
 }
}

^["frameworks"]{
 #>nursing_ethics_watson
 ^["caring_science"]{
  #:claim #!interpretive
  statement: "Jean Watson set caring, not curing, at the center of nursing, as carative factors attending to the whole person."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_watson_1979"
 }
 #>nursing_ethics_benner
 ^["novice_to_expert"]{
  #:claim #!settled
  statement: "Patricia Benner applied the 1980 Dreyfus skill model to nursing: novice, advanced beginner, competent, proficient, and expert, with experts acting from perceptual grasp of whole situations."
  sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_benner_1984", ~"../../registries/sources/plants-ecology-care.spw#src_eco_dreyfus_1980" ]
  later_statement: ~"../../registries/sources/plants-ecology-care.spw#src_eco_dreyfus_1986"
 }
 #>nursing_ethics_moral_distress
 ^["moral_distress"]{
  #:claim #!settled
  statement: "Andrew Jameton defined moral distress as knowing the right action while institutional constraints make it nearly impossible to take."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_jameton_1984"
 }
 #>nursing_ethics_humility
 ^["cultural_humility"]{
  #:claim #!settled
  statement: "Tervalon and Murray-Garcia proposed cultural humility, lifelong self-critique and attention to power imbalances, in place of a checklist idea of cultural competence."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_tervalon_1998"
 }
 #>nursing_ethics_trauma
 ^["trauma_informed"]{
  #:claim #!settled
  statement: "SAMHSA names six principles of trauma-informed care: safety; trustworthiness and transparency; peer support; collaboration and mutuality; empowerment, voice, and choice; and cultural, historical, and gender issues."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_samhsa_2014"
 }
 #>nursing_ethics_polyvagal
 ^["polyvagal"]{
  #:claim #!contested
  statement: "Porges's polyvagal theory ties social engagement to a branch of the vagus nerve; Grossman argues its five basic premises conflict with evidence from physiology and evolution."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_porges_2011"
  counter: ~"../../registries/sources/plants-ecology-care.spw#src_eco_grossman_2023"
 }
}

^["codes"]{
 #>nursing_ethics_codes
 ^["codes_of_ethics"]{
  #:claim #!settled
  statement: "The ANA Code of Ethics, revised in 2025, and the ICN Code, revised in 2021, set respect for persons and advocacy as duties of every nurse."
  sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_ana_2025", ~"../../registries/sources/plants-ecology-care.spw#src_eco_icn_2021" ]
  status: "current as of 2026-10-02"
 }
}

^["try"]{
 #>nursing_ethics_try_directive
 ^["read_a_blank_directive"]{
  materials: [ "a blank advance directive form published by your state or national health department" ]
  steps: << "list each decision the form asks about" ; "mark which words you would need explained" ; "note who the form lets you name as a surrogate" ; "write one question to bring to a clinician or family member" >>
  time: .{ n: 30, unit: "minutes" }
  safety: "reading a blank form commits you to nothing; talk with family and a clinician before completing one"
  shows: ~"./ethics-and-presence.spw#nursing_ethics_psda_rule"
 }
}

#>nursing_ethics_presence_q
?["What does a nurse's presence change for a family at a death?"]{
 #:depth #!ethical ~#lens(social fabric)
 #:claim #!speculative
 ~#hypothesis: "Families who report that a nurse explained each comfort measure as it was given will describe the death as more peaceful than families who saw the same care unexplained."
 !probe{ "ethics-approved interviews with bereaved families about explanation during comfort care" =id[p_eco_ethics_presence] =kind[interview] }
 ~"./ethics-and-presence.spw#nursing_ethics_comfort" ~#neighbor(nearest)
}
