# Cell Biology
#
# Molecular and cellular biology: proteins, nucleic acids, membranes and signals, and the cell cycle, with the four-billion-year thread kept as an interpretive note.

#>cell_biology_index
#:layer #!reference
#:domain #!cell_biology
#:form #!index
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Cell Biology"
 ~#claim: "A cell runs on folded proteins, copied and read nucleic acids, membranes that sort and signal, and a cycle that decides when to divide."
 ~#proof: "Each leaf links its claims to the life-and-mind sources registry; the stance cites the ribosome structure of Nissen and colleagues and the cell counts of Sender, Fuchs, and Milo."
 ~#door: "Start with proteins and enzymes, then nucleic acids, then transport and signaling, then the cell cycle."
 ~#audience: "students and curious readers with some chemistry"
 continuity: "Cell Biology | when to divide"
 cold_open: "A cell folds proteins, copies its genome, sorts and signals across membranes, and decides when to divide."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/molecular-and-cellular-biology/taste.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #fail }
  ^["r4"]{ event: #sourced, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r8"]{ event: #fact_checked, at: "2026-10-03",
   agent: "claude-opus-5.5 fact-checker", care: #adversarial, outcome: #corrected }
  ^["r9"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 receipt_note: "r3 was first written as a pass while every source link pointed at a registry not yet written; r4 wrote and checked that registry, and r5 is the passing run after it"
 corrections: #[
  "the raw count of 37 trillion human cells is Bianconi 2013; Sender, Fuchs, and Milo revised it to about 30 trillion in 2016 (raw line 21)",
  "the raw kinesin line said one motor hauls a vesicle a thousand times its own mass; that ratio had no source and was dropped (raw line 17)",
  "the raw line said the ribosomal catalytic fold is identical in every organism; the core is conserved, not identical (raw line 20)",
  "transient quantum electronic rearrangements as a general picture of cell biology had no source and was dropped (raw line 24)",
  "apoptosis is no longer described as cells sacrificing themselves for the whole, a purpose reading the evidence does not support (raw line 21)",
  "the raw ribosome wonder asserted that selection could never replace the RNA core; it is kept as a speculative question (raw line 32)",
  "the raw condensate wonder stated phase separation as the settled mechanism; it is now contested with its caveats (raw line 40)",
  "2026-10-03: the facet rows now give transport and the cell cycle the state_machine form their leaves declare",
  "2026-10-03: the RNA world claim named Woese and Fox as its counter, a paper that does not argue against it; Bernhardt 2012, a review of the objections, replaces it",
  "2026-10-03 fact-check: the thread said every living cell translates, which is false for single cells such as mature mammalian red blood cells, which lose their ribosomes; it now speaks of cellular organisms"
 ]
}

