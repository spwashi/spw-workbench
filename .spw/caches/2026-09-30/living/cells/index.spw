  .{ leaf: "protein-structure-and-enzymes", matter: "folding, catalysis, kinetics", form: "ledger", level: "advanced" },
  .{ leaf: "nucleic-acids-and-genomes", matter: "replication, chromatin, Cas9 search", form: "ledger", level: "advanced" },
  .{ leaf: "transport-and-signaling", matter: "vesicles, SNAREs, receptors, apoptosis", form: "state_machine", level: "advanced" },
  .{ leaf: "cell-cycle-and-stem-cells", matter: "cyclins, checkpoints, pluripotency", form: "state_machine", level: "advanced" }
 ]
}

^["stance"]{
 #>cell_biology_index_thread
 ^["four_billion_year_thread"]{
  #:claim #!interpretive
  statement: "Every cellular organism makes protein on a ribosome whose catalytic core is RNA, so the act of making protein links all cellular life to a shared ancestor."
  sources: [ ~"../../registries/sources/life-and-mind.spw#src_life_nissen_2000", ~"../../registries/sources/life-and-mind.spw#src_life_woese_fox_1977" ]
  ^["limits"]{
   holds: "as a reading of conserved ribosomal RNA and the RNA catalytic center"
   fails: "the dates and nature of the last universal common ancestor are debated, so the four-billion-year figure is a round reading, not a measurement"
  }
 }
 #>cell_biology_index_ribozyme
 ^["ribosome_is_a_ribozyme"]{
  #:claim #!settled
  statement: "The atomic structure of the large ribosomal subunit showed no protein side chain near the peptidyl transferase site, so RNA catalyzes peptide bond formation."
  source: ~"../../registries/sources/life-and-mind.spw#src_life_nissen_2000"
  credit: "Nissen, Hansen, Ban, Moore, and Steitz at Yale; RNA catalysis itself was found by Cech and by Altman in the early 1980s"
  credit_sources: [ ~"../../registries/sources/life-and-mind.spw#src_life_kruger_1982", ~"../../registries/sources/life-and-mind.spw#src_life_guerrier_takada_1983" ]
 }
 #>cell_biology_index_rna_world
 ^["rna_world"]{
  #:claim #!contested
  statement: "The RNA world hypothesis holds that RNA once served as both gene and catalyst before DNA and proteins; it remains a leading but unproven account, and critics point to RNA fragility and prebiotic complexity."
  source: ~"../../registries/sources/life-and-mind.spw#src_life_gilbert_1986"
  counter: ~"../../registries/sources/life-and-mind.spw#src_life_bernhardt_2012"
 }
 #>cell_biology_index_cell_count
 ^["cells_in_a_body"]{
  #:claim #!settled
  statement: "An adult human body holds about 30 trillion human cells, about nine in ten of them in the blood-forming lineage, and a similar number of bacteria; an earlier organ-by-organ estimate gave 37 trillion."
  reads: %[
   life.cells.human_count_e13_2016,
   life.cells.bacteria_count_e13_2016,
   life.cells.human_count_e13_2013
  ]
  sources: [ ~"../../registries/sources/life-and-mind.spw#src_life_sender_2016", ~"../../registries/sources/life-and-mind.spw#src_life_bianconi_2013" ]
 }
 #>cell_biology_index_kinesin
 ^["kinesin_steps"]{
  #:claim #!settled
  statement: "A single kinesin motor walks along a microtubule in 8 nm steps and spends one ATP per step at low load."
  reads: %[life.kinesin.step_nm, life.kinesin.atp_per_step]
  sources: [ ~"../../registries/sources/life-and-mind.spw#src_life_svoboda_1993", ~"../../registries/sources/life-and-mind.spw#src_life_schnitzer_block_1997" ]
 }
 #>cell_biology_index_condensates
 ^["condensates"]{
  #:claim #!contested
  statement: "P granules behave as liquid droplets that condense and dissolve; whether liquid-liquid phase separation explains most membraneless compartments in living cells is still debated."
  source: ~"../../registries/sources/life-and-mind.spw#src_life_brangwynne_2009"
  counter: ~"../../registries/sources/life-and-mind.spw#src_life_mcswiggen_2019"
 }
}

^["gaps"]{
