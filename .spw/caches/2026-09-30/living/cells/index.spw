^["ladder"]{
 rungs: << "advanced: proteins and enzymes" ; "advanced: nucleic acids and genomes" ; "advanced: transport and signaling" ; "advanced: cell cycle and stem cells" >>
 ^["prerequisites"]{
  fold_before_signal: "receptors, channels, and SNAREs are proteins whose states are folds, so proteins come before signaling"
  genome_before_cycle: "checkpoints guard replication, so nucleic acids come before the cell cycle"
  signal_before_fate: "growth factors and morphogens act through receptors, so signaling comes before stem cells"
 }
}

