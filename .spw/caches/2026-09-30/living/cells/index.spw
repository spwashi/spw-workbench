  "membranes, lipids, and bioenergetics as their own leaf, expected beside transport and signaling",
  "microbiology and immunology, expected beside the cell cycle",
  "evolution as a home for selection and common descent, expected above this branch"
 ]
}

^["doors"]{
 student: "proteins and enzymes, then nucleic acids and genomes"
 engineer: "transport and signaling, then the bioengineering branch"
 reader_of_the_thread: "the stance frame above, then the ribosome claim"
}

#>cell_biology_index_ribosome_q
?["Why has the core of protein synthesis stayed RNA for so long?"]{
 #:depth #!historical ~#lens(molecular binding)
 #:claim #!speculative
 ~#hypothesis: "Every protein in a cell is made by the ribosome, so any change to its catalytic center would disrupt all of them at once, which would keep the RNA core in place."
 !probe{ "compare conservation of peptidyl transferase nucleotides with conservation of ribosomal proteins across the three domains" =id[p_life_cells_ptc_conservation] =kind[lit] }
 $%[life.cells.human_count_e13_2016, life.cells.bacteria_count_e13_2016]
 ~"./index.spw#cell_biology_index_ribozyme" ~#neighbor(nearest)
}

#>cell_biology_index_kinesin_q
?["How much ATP does a vesicle spend to cross a long axon?"]{
 #:depth #!mathematical ~#lens(energy budget)
 #:claim #!speculative
 ~#hypothesis: "If one motor carries the cargo at one ATP per step, the cost grows in proportion to distance, so the longest axons pay the most per delivery."
 !probe{ "divide one metre by the step length to count ATP per motor per metre, then ask how many motors share a cargo" =id[p_life_cells_kinesin_cost] =kind[calc] }
 $%[life.kinesin.step_nm, life.kinesin.atp_per_step]
 ~"./index.spw#cell_biology_index_kinesin" ~#neighbor(nearest)
}
