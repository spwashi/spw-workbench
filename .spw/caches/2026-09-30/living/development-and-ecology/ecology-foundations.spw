# Ecology Foundations
#
# Populations, communities, and ecosystems as a prerequisite graph, with energy thinning at each trophic step while nutrients cycle.

#>development_ecology_foundations
#:layer #!reference
#:domain #!development_ecology
#:form #!curriculum
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Ecology Foundations"
 ~#claim: "Ecology climbs from populations to communities to ecosystems; nutrients cycle, while energy thins at each trophic step of its one-way flow."
 ~#proof: "Ecosystem from Tansley 1935; trophic dynamics from Lindeman 1942; transfer efficiency near one tenth from Pauly and Christensen 1995; keystone predation from Paine 1966."
 ~#door: "Walk the graph from populations to energy flow, then draw a food web from a park or garden."
 ~#audience: "readers with high-school biology"
 continuity: "Ecology Foundations | energy thins"
 cold_open: "Energy thins at every step up a food chain, which is why there are few wolves and many rabbits."
}

