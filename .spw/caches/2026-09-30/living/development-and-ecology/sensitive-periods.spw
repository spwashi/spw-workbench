 primary: [ #sensitive_period, #imprinting, #vernalization ]
 transfers: [ #plasticity, #phenology ]
 tensions: [ #overclaim ]
}

^["scope"]{
 #>development_ecology_sensitive_periods_guard
 ^["guard"]{
  #:valence #!honk
  warning: "a closing window in kittens or sparrows does not mean a person has missed a chance; human windows are wider and less certain"
 }
 what: "how biologists and psychologists study windows of heightened plasticity"
 not_advice: "nothing here tells a parent, teacher, or learner what to do at any age"
 where_to_ask: "concerns about a child's vision, hearing, or language go to a pediatric clinician or audiologist"
}

^["animals"]{
 #>development_ecology_sensitive_periods_imprinting
 ^["imprinting"]{
  #:claim #!settled
  statement: "Lorenz described young geese and ducks that follow and attach to the first suitable moving object they meet early in life, calling the process imprinting."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_lorenz_1935"
 }
 #>development_ecology_sensitive_periods_graded
 ^["graded_windows"]{
  #:claim #!settled
  statement: "Bateson argued that sensitive periods are graded, and that their end often depends on the experience itself, because learning one thing narrows what is learned next."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_bateson_1979"
 }
 #>development_ecology_sensitive_periods_song
 ^["birdsong"]{
  #:claim #!settled
  statement: "Marler found that white-crowned sparrows must hear adult song during an early window to sing it later; birds raised without that experience sing abnormal songs."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_marler_1970"
 }
 ^["vision"]{
  #>development_ecology_sensitive_periods_ocular
  ^["ocular_dominance"]{
   #:claim #!settled
   statement: "Closing one eye of a young kitten shifted cortical neurons to respond to the open eye; the same closure in adult cats had little effect."
   sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_wiesel_hubel_1963", ~"../../registries/sources/plants-ecology-care.spw#src_eco_hubel_wiesel_1970" ]
  }
  #>development_ecology_sensitive_periods_brakes
  ^["opening_and_brakes"]{
   #:claim #!settled
   statement: "In rodent visual cortex, maturing inhibitory circuits open the critical period and molecular brakes close it; lifting a brake can reopen plasticity in adult animals."
   source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_hensch_2005"
   ^["limits"]{
    holds: "mice and rats under laboratory conditions"
    fails: "whether the same brakes can be lifted safely in people is not established"
   }
  }
 }
}

^["plants"]{
 #>development_ecology_sensitive_periods_flc
 ^["winter_repressor"]{
  #:claim #!settled
  statement: "In Arabidopsis the FLC gene blocks flowering; a long spell of cold silences it, so plants that have lived through winter flower when spring comes."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_michaels_amasino_1999"
 }
 #>development_ecology_sensitive_periods_vin3
 ^["winter_memory"]{
  #:claim #!settled
  statement: "VIN3 rises only after weeks of cold and helps lay down chromatin marks that keep FLC off, a cellular memory of winter that lasts after warm weather returns."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_sung_amasino_2004"
  ~#say(the plant counts the cold and remembers it)
 }
}

^["humans"]{
 #>development_ecology_sensitive_periods_lenneberg
 ^["critical_period_hypothesis"]{
  #:claim #!contested
  statement: "Lenneberg proposed that language is acquired most readily before puberty, a critical period hypothesis later tested on second-language learners."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_lenneberg_1967"
  counter: ~"../../registries/sources/plants-ecology-care.spw#src_eco_hakuta_2003"
 }
 #>development_ecology_sensitive_periods_l2
 ^["second_language"]{
  #:claim #!contested
  statement: "Johnson and Newport found grammar scores fell with age of arrival in childhood; census data analyzed by Hakuta and colleagues showed a steady decline with no sharp break at puberty."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_johnson_newport_1989"
  counter: ~"../../registries/sources/plants-ecology-care.spw#src_eco_hakuta_2003"
 }
 #>development_ecology_sensitive_periods_late
 ^["late_window"]{
  #:claim #!emerging
  statement: "A large online study estimated that the ability to learn grammar stays high into late adolescence and declines after, later than many earlier estimates."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_hartshorne_2018"
  ^["limits"]{
   holds: "English grammar judgments from a very large volunteer sample"
   fails: "the estimate rests on model assumptions about exposure, and the sample was self-selected"
  }
 }
 #>development_ecology_sensitive_periods_three
 ^["first_three_years"]{
  #:claim #!contested
  statement: "Campaigns of the 1990s said brain wiring is set by age three; Bruer argued that synapse counts and animal deprivation studies do not support that claim for ordinary childhoods."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_bruer_1999"
  counter: ~"../../registries/sources/plants-ecology-care.spw#src_eco_knudsen_2004"
 }
}

^["try"]{
 #>development_ecology_sensitive_periods_try_cold
 ^["cold_memory"]{
  materials: [ "untreated winter wheat or winter rye seed", "two zip bags", "paper towels", "a refrigerator", "two pots of soil" ]
  steps: << "soak a dozen seeds overnight" ; "seal half in a damp towel in the refrigerator and keep half at room temperature until sowing" ; "after six weeks sow both lots side by side" ; "watch which lot sends up heads first" >>
  time: .{ n: 20, unit: "minutes of setup, then about three months" }
  safety: "label the refrigerator bag clearly; treated seed is dyed and toxic, so use untreated seed and keep it from children"
  shows: ~"./sensitive-periods.spw#development_ecology_sensitive_periods_vin3"
 }
}

#>development_ecology_sensitive_periods_plant_q
?["Do plants have a sensitive period in the same sense as sparrows and kittens?"]{
 #:depth #!physical ~#lens(living system)
 #:claim #!speculative
 ~#hypothesis: "Vernalization behaves less like a closing window and more like a counter, so extra cold beyond saturation should change little while missing cold delays flowering."
 !probe{ "compare published flowering times across cold durations in vernalization studies" =id[p_eco_sensitive_winter] =kind[lit] }
 breaks: "plant winter memory is counted cell by cell and reset in each generation, while an animal window shapes a circuit once"
 ~"./sensitive-periods.spw#development_ecology_sensitive_periods_vin3" ~#neighbor(nearest)
}
