^["edges"]{
 grounds: [ ~"../../registries/quantities/plants-ecology-care.spw#q_eco_scaling" ]
 needs: [ ~"./ecology-foundations.spw#development_ecology_foundations" ]
 see: [ ~"./development-as-succession.spw#development_ecology_parallels_human" ]
}

^["concepts"]{
 primary: [ #life_history, #trade_off, #allometry ]
 transfers: [ #selection, #energy_budget ]
 tensions: [ #metabolic_exponent ]
}

^["scope"]{
 #>development_ecology_life_history_guard
 ^["guard"]{
  #:valence #!honk
  warning: "species-level patterns of growth and lifespan say nothing about how long a particular person will live or how they should live"
 }
 what: "evolutionary and comparative biology of life schedules and body size"
 not_advice: "nothing here is guidance on aging, fertility, or longevity for a person"
}

^["paradigms"]{
 #>development_ecology_life_history_rk
 ^["r_and_k"]{
  #:claim #!superseded
  statement: "MacArthur and Wilson named r and K selection, and Pianka listed traits said to go with each: many small fast-maturing offspring versus few large slow ones."
  sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_macarthur_wilson_1967", ~"../../registries/sources/plants-ecology-care.spw#src_eco_pianka_1970" ]
 }
 #>development_ecology_life_history_demographic
 ^["demographic_theory"]{
  #:claim #!settled
  statement: "Life-history theory came to predict schedules from age-specific mortality and trade-offs; Reznick and colleagues argue density regulation still belongs in those models."
  sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_stearns_1992", ~"../../registries/sources/plants-ecology-care.spw#src_eco_reznick_2002" ]
  ~#say(who dies when shapes how lives are spent)
 }
}

^["trade_offs"]{
 #>development_ecology_life_history_costs
 ^["cost_of_reproduction"]{
  #:claim #!settled
  statement: "Energy and time spent on reproduction are unavailable for growth and maintenance, so more offspring now tends to mean lower survival or fewer offspring later."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_stearns_1992"
 }
 #>development_ecology_life_history_cole
 ^["coles_paradox"]{
  #:claim #!settled
  statement: "Cole showed that an annual adding one offspring could match a perennial that breeds forever, so the common perennial habit needed explaining."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_cole_1954"
  ^["limits"]{
   holds: "a model in which juveniles and adults survive equally well"
   fails: "once adult survival exceeds juvenile survival, breeding again becomes worth more than one extra offspring"
  }
 }
 #>development_ecology_life_history_csr
 ^["plant_strategies"]{
  #:claim #!settled
  statement: "Grime proposed three primary plant strategies: competitors in rich undisturbed sites, stress tolerators in poor sites, and ruderals in disturbed sites."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_grime_1977"
  ^["limits"]{
   holds: "as a map for comparing plant traits across habitats"
   fails: "other ecologists, notably in resource-competition theory, dispute how competition works in poor sites"
  }
 }
 #>development_ecology_life_history_grandmother
 ^["grandmothering"]{
  #:claim #!contested
  statement: "Hawkes and colleagues proposed that grandmothers who help feed grandchildren favored long human post-reproductive life; a later simulation found grandmothering alone too weak to explain it."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_hawkes_1998"
  counter: ~"../../registries/sources/plants-ecology-care.spw#src_eco_kachel_2011"
 }
}

^["scaling"]{
 #>development_ecology_life_history_allometry
 ^["allometry"]{
  #:claim #!settled
  statement: "Huxley wrote relative growth as a power law, one part growing as a fixed power of another, the allometric equation still used across biology."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_huxley_1932"
  ~#(Thompson had argued in On Growth and Form that size changes demand changes of shape)
  context: ~"../../registries/sources/plants-ecology-care.spw#src_eco_thompson_1917"
 }
 #>development_ecology_life_history_kleiber
 ^["kleiber_exponent"]{
  #:claim #!contested
  statement: "Kleiber proposed that metabolic rate scales with body mass to the three-quarter power; White and Seymour found two thirds for mammalian basal rate after correcting for temperature and digestion."
  reads: %[eco.scaling.kleiber_exp, eco.scaling.geometric_exp]
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_kleiber_1932"
  counter: ~"../../registries/sources/plants-ecology-care.spw#src_eco_white_seymour_2003"
 }
 #>development_ecology_life_history_wbe
 ^["network_model"]{
  #:claim #!contested
  statement: "West, Brown, and Enquist derived a three-quarter exponent from branching supply networks; Glazier reviewed exponents that vary between about two thirds and one with taxon and activity."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_west_1997"
  counter: ~"../../registries/sources/plants-ecology-care.spw#src_eco_glazier_2005"
 }
}

^["try"]{
 #>development_ecology_life_history_try_seeds
 ^["seed_count"]{
  materials: [ "three fruits with different seed sizes, such as a tomato, an apple, and an avocado", "a cutting board and knife", "a kitchen scale" ]
  steps: << "cut each fruit and count its seeds" ; "weigh the seeds from each fruit together" ; "divide to get the mass of one seed" ; "set seed number beside seed mass and look for the trade" >>
  time: .{ n: 30, unit: "minutes" }
  safety: "cut on a board, away from your hand; apple seeds and avocado pits are not for eating"
  shows: ~"./life-history-and-scaling.spw#development_ecology_life_history_costs"
 }
}

#>development_ecology_life_history_exponent_q
?["Does one species shift its metabolic exponent between rest and activity?"]{
 #:depth #!mathematical ~#lens(energy budget)
 #:claim #!speculative
 ~#hypothesis: "Within one species, the exponent should rise toward one during sustained activity, when muscle mass rather than surface or network sets the demand."
 !probe{ "refit published resting and active metabolic rates within single species" =id[p_eco_life_history_exponent] =kind[calc] }
 $%[eco.scaling.kleiber_exp, eco.scaling.geometric_exp]
 ~"./life-history-and-scaling.spw#development_ecology_life_history_wbe" ~#neighbor(nearest)
}
