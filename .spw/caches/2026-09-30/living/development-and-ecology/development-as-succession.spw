  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 revision_2026_10_03: "r6 redated the r4 fact-check to 2026-10-02, the day its sources were read"
 corrections: #[
  "the raw wonder said delaying puberty through diet would raise adult bone density; the direction was backwards and it invited changing childrens diets, so it was dropped and logged in the harm register (raw line 81)",
  "raw invariants requiring particular nutrients and hormone levels at each stage were advice, not description, and were dropped (raw lines 73 and 74)",
  "the raw file is quarantined; only its stage names informed this matrix, and every claim here comes from a named source"
 ]
}

^["edges"]{
 needs: [ ~"./ecology-foundations.spw#development_ecology_foundations" ]
 feeds: [ ~"./succession-and-resilience.spw#development_ecology_resilience" ]
 see: [ ~"../plants/horticultural-science.spw#plant_science_horticulture" ]
}

^["concepts"]{
 primary: [ #succession, #life_stage, #metamorphosis ]
 transfers: [ #phenology, #sensitive_period ]
 tensions: [ #climax ]
}

^["scope"]{
 #>development_ecology_parallels_guard
 ^["guard"]{
  #:valence #!honk
  warning: "a stage borrowed from a forest or a moth says nothing about what a person should do or eat"
 }
 what: "a descriptive comparison of how biologists name stages in four kinds of development"
 not_advice: "nothing here is guidance on a child or adult, on puberty, growth, diet, or exercise"
 where_to_ask: "a concern about a particular child goes to a pediatric clinician"
}

^["sources_of_stages"]{
 #>development_ecology_parallels_human
 ^["human_stages"]{
  #:claim #!settled
  statement: "Bogin divides human growth into infancy, childhood, juvenile, adolescent, and adult stages, each with its own pace of growth and dependence."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_bogin_1999"
  ^["limits"]{
   holds: "as a description of growth curves and life-history stages"
   fails: "his argument that childhood and adolescence are new stages in human evolution is debated"
  }
 }
 #>development_ecology_parallels_climax
 ^["climax"]{
  #:claim #!superseded
  statement: "Clements described succession as a community developing like an organism toward a single climax set by climate."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_clements_1916"
 }
 #>development_ecology_parallels_individualistic
 ^["individualistic"]{
  #:claim #!settled
  statement: "Gleason argued that each plant species responds to the environment on its own, so communities are loose, shifting mixtures rather than organisms."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_gleason_1926"
 }
 #>development_ecology_parallels_odum
 ^["ecosystem_development"]{
  #:claim #!settled
  statement: "Odum tabulated trends expected as ecosystems develop: more biomass and structure, slower nutrient turnover, and production closer to respiration."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_odum_1969"
  ^["limits"]{
   holds: "as a set of predictions for undisturbed succession"
   fails: "field tests support some trends and not others, and disturbance resets many of them"
  }
 }
 #>development_ecology_parallels_bbch
 ^["plant_stages"]{
  #:claim #!settled
  statement: "The BBCH scale codes plant development in ten principal growth stages, from germination through leaf growth, flowering, fruit, and ripening to senescence, shared across crops."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_meier_2001"
 }
 #>development_ecology_parallels_hormones
 ^["insect_hormones"]{
  #:claim #!settled
  statement: "In insects, ecdysone pulses trigger each molt, and juvenile hormone decides whether a molt makes a larger larva or begins metamorphosis."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_truman_riddiford_1999"
 }
}

^["matrix"]{
 #>development_ecology_parallels_row_establish
 ^["establishment"]{
  #:claim #!interpretive
  human: "infancy: rapid growth and full dependence on carers"
  succession: "pioneer colonists on bare ground or after a fire"
  plant: "germination and the first leaves"
  insect: "the egg and first larval instar"
  ^["breaks"]{ where: "pioneer species are replaced by other species; an infant is the same organism that grows on" }
 }
 #>development_ecology_parallels_row_growth
 ^["growth"]{
  #:claim #!interpretive
  human: "childhood and the juvenile years: slower growth, learning, play"
  succession: "fast-growing shrubs and young trees fill the gap"
  plant: "leaf development, side shoots, stem elongation"
  insect: "feeding larval instars, each ended by a molt"
  ^["breaks"]{ where: "a child learns from others across generations; a thicket has no teachers" }
 }
 #>development_ecology_parallels_row_reorganize
 ^["reorganization"]{
  #:claim #!interpretive
  human: "adolescence: a growth spurt and reproductive maturation"
  succession: "mid-succession turnover as shade-tolerant species take over"
  plant: "the switch from leaves to flowers"
  insect: "the pupa, where larval tissues are broken down and adult tissues built"
  ^["breaks"]{ where: "a pupa dissolves and rebuilds much of its body; an adolescent remodels without dissolving anything" }
 }
 #>development_ecology_parallels_row_mature
 ^["maturity"]{
  #:claim #!interpretive
  human: "adulthood: reproduction and care for others"
  succession: "late succession, once called climax, still changing slowly"
  plant: "fruit development and ripening"
  insect: "the winged adult, often short-lived and built to reproduce"
  ^["breaks"]{ where: "late succession has no fixed endpoint, while an adult body stops growing in height" }
 }
 #>development_ecology_parallels_row_senesce
 ^["senescence"]{
  #:claim #!interpretive
  human: "older age, with grandparenting in many societies"
  succession: "old growth, gaps from fallen trees, eventual disturbance"
  plant: "leaf yellowing, seed shed, and death of annual shoots"
  insect: "the end of a brief adult life"
  ^["breaks"]{ where: "an old forest renews itself in its own gaps; a person does not regrow" }
 }
 columns: #[ human, succession, plant, insect ]
}

^["try"]{
 #>development_ecology_parallels_try_phenology
 ^["phenology_walk"]{
  materials: [ "one tree or garden plant you can visit weekly", "a notebook or phone camera" ]
  steps: << "pick one plant and photograph the same branch" ; "write the stage you see: leaf, flower, fruit, color change, leaf drop" ; "repeat each week through October and November" ; "line the photos up and name the stage changes" >>
  time: .{ n: 10, unit: "minutes per weekly visit" }
  safety: "look without picking or tasting; some ornamental fruits are poisonous"
  shows: ~"./development-as-succession.spw#development_ecology_parallels_bbch"
 }
}

#>development_ecology_parallels_reading_q
?["Does a life read better as succession or as metamorphosis?"]{
 #:depth #!experiential ~#lens(living system)
 #:claim #!speculative
 ~#hypothesis: "Readers who describe their own lives by turning points will reach for metamorphosis, and readers who describe gradual change will reach for succession."
 !probe{ "ask readers to choose a frame for their own life story and code their explanations" =id[p_eco_parallels_reading] =kind[interview] }
 breaks: "a person keeps one body and one memory across every stage, while a succession replaces its members"
 ~"./development-as-succession.spw#development_ecology_parallels_row_reorganize" ~#neighbor(nearest)
}
