# Development as Succession
#
# Human life stages set beside ecological succession, plant growth stages, and insect metamorphosis, as a descriptive matrix where every row names where the parallel breaks.

#>development_ecology_parallels
#:layer #!reference
#:domain #!development_ecology
#:form #!comparison
#:level #!intro
#:review #!adversarial_checked
#:valence #!boon

^"emit"{
 ~#title: "Development as Succession"
 ~#claim: "A human life, a regrowing forest, a flowering plant, and a moth each pass through stages, and the stages line up loosely enough to teach and tightly enough to mislead."
 ~#proof: "Human stages after Bogin; succession after Clements, Gleason, and Odum; plant stages from the BBCH scale; metamorphosis from Truman and Riddiford."
 ~#door: "Read one row across, then read its breaks line, then try a phenology walk."
 ~#audience: "curious readers and writers"
 continuity: "Development as Succession | stages line up loosely"
 cold_open: "A life, a forest, a plant, and a moth all pass through stages, and the stages line up loosely."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/physiological-development/developmental-stages.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
