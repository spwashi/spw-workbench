# Plant Genomics
#
# Graduate plant genetics as a claim ledger: mapping and genomic selection, genome editing and what each editor can write, plant immunity and the contested origin of NLRs, ripening, and stress.

#>plant_science_genomics
#:layer #!reference
#:domain #!plant_science
#:form #!ledger
#:level #!graduate
#:review #!adversarial_checked
#:valence #!bonk

^"emit"{
 ~#title: "Plant Genomics"
 ~#claim: "Breeders now predict breeding values from genome-wide markers and edit single bases, and base editors make transitions while prime editing reaches transversions."
 ~#proof: "Genomic selection from Meuwissen and colleagues 2001; base editors from Komor 2016 and Gaudelli 2017; prime editing from Anzalone 2019; NLR origins from Urbach and Ausubel 2017."
 ~#door: "Read the editing ledger first, then the immunity claims, then the stress pathways."
 ~#audience: "graduate students in plant science"
 continuity: "Plant Genomics | base editors"
 cold_open: "Classic base editors swap one letter for its chemical cousin, a transition, and other tools were built for the rest."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/horticulture-and-botany/masters-horticulture-and-plant-genomics.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #corrected }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 revision_2026_10_03: "r6 redated the r4 fact-check to 2026-10-02, the day its sources were read; the NLR correction line now matches the contested grade of the claim it records"
 corrections: #[
  "cytosine and adenine base editors install transitions, not transversions (raw line 33)",
  "the raw stated as fact that plant and animal NLRs descend from one ancestral receptor; the main phylogenetic test finds the joined architecture arose independently (raw line 70)",
  "edited lines are not uniformly classed non-GMO; regulation differs by jurisdiction and changes (raw line 32)",
  "the raw wonder claimed complete non-host resistance without yield penalty from SWEET promoter edits; the study reports broad-spectrum resistance to bacterial blight",
  "fact-check: the NLR convergence was marked settled and the shared-ancestor claim refuted on one 2017 analysis; the NTPase domains share an ancestor, the joined architecture is argued to be independent, and the grades are now emerging and contested",
  "fact-check: ACC synthase alone is the committed step; ACC oxidase makes ethylene from ACC",
  "fact-check: hybrid seed, doubled haploid, Agrobacterium, and biolistic fields were unsourced; each is now a sourced claim"
 ]
}

^["edges"]{
 needs: [ ~"./botany-core.spw#plant_science_botany" ]
}

^["concepts"]{
 primary: [ #genomic_selection, #base_editing, #plant_immunity ]
 transfers: [ #selection, #feedback ]
 tensions: [ #edit_regulation ]
}

^["scope"]{
 #>plant_science_genomics_guard
 ^["guard"]{
  #:valence #!honk
  warning: "edited and engineered crops are regulated differently in each jurisdiction and the rules change; nothing here states the legal status of a product"
 }
 what: "graduate plant genetics as a claim ledger"
}

^["selection"]{
 #>plant_science_genomics_qtl
 ^["interval_mapping"]{
  #:claim #!settled
  statement: "Lander and Botstein introduced interval mapping in 1989, scanning between linked markers to locate loci behind quantitative traits."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_lander_botstein_1989"
 }
 #>plant_science_genomics_gs
 ^["genomic_selection"]{
  #:claim #!settled
  statement: "Genomic selection fits all genome-wide markers at once to predict breeding values, skipping the search for individual significant loci."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_meuwissen_2001"
  ^["limits"]{
   holds: "a training population related to the candidates and grown in similar environments"
   fails: "accuracy decays across generations and environments, so models are retrained and validated in multi-environment trials"
  }
 }
 #>plant_science_genomics_hybrid_seed
 ^["hybrid_seed"]{
  #:claim #!settled
  statement: "Cytoplasmic male sterility paired with nuclear restorer genes lets seed companies make F1 hybrid seed at scale."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_acquaah_2012"
 }
 #>plant_science_genomics_doubled_haploids
 ^["doubled_haploids"]{
  #:claim #!settled
  statement: "Doubled haploids give fully homozygous lines in one generation instead of several rounds of selfing."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_acquaah_2012"
 }
}

^["editing"]{
 ^["delivery"]{
  #>plant_science_genomics_rnp
  ^["ribonucleoprotein"]{
   #:claim #!settled
   statement: "Preassembled Cas9 ribonucleoproteins can edit plant protoplasts without delivering DNA, so no transgene must be bred out afterward."
   source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_woo_2015"
  }
  #>plant_science_genomics_agrobacterium
  ^["agrobacterium"]{
   #:claim #!settled
   statement: "Agrobacterium moves T-DNA from its Ti plasmid into the plant genome; Stachel and colleagues found that acetosyringone from wounded plant cells switches on the vir genes that drive the transfer."
   source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_stachel_1985"
  }
  #>plant_science_genomics_biolistics
  ^["biolistics"]{
   #:claim #!settled
   statement: "Klein and colleagues fired DNA-coated microprojectiles into living plant cells in 1987 and into maize cells in 1988, a route into cereals that Agrobacterium then reached poorly."
   sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_klein_1987", ~"../../registries/sources/plants-ecology-care.spw#src_eco_klein_1988" ]
  }
 }
 ^["what_editors_write"]{
  #>plant_science_genomics_base_editors
  ^["base_editors"]{
   #:claim #!settled
   statement: "Cytosine base editors convert C-G to T-A and adenine base editors convert A-T to G-C; both changes are transitions, made without a double-strand break."
   sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_komor_2016", ~"../../registries/sources/plants-ecology-care.spw#src_eco_gaudelli_2017" ]
   ~#say(base editors swap a letter for its chemical cousin)
  }
  #>plant_science_genomics_transversions
  ^["transversions"]{
   #:claim #!emerging
   statement: "Transversions arrived later: glycosylase-based editors make C-to-G changes, and prime editing can write all twelve substitutions plus small insertions and deletions."
   sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_kurt_2021", ~"../../registries/sources/plants-ecology-care.spw#src_eco_anzalone_2019" ]
   ^["limits"]{
    holds: "the cell systems in which each editor was first shown"
    fails: "efficiency in crop species varies widely and is still being raised"
   }
  }
  #>plant_science_genomics_cis_tuning
  ^["cis_tuning"]{
   #:claim #!settled
   statement: "Editing the tomato CLV3 promoter with many guides produced a graded series of locule numbers and fruit sizes, tuning a trait rather than knocking it out."
   source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_rodriguez_leal_2017"
  }
 }
 regulation: "edited crops are regulated differently by jurisdiction and the rules have changed in recent years; treat any statement of status as verify as of 2026-10-01"
}

^["immunity"]{
 #>plant_science_genomics_two_tiers
 ^["two_tiers"]{
  #:claim #!settled
  statement: "Plants detect conserved microbial patterns with surface receptors and specific pathogen effectors with intracellular NLR receptors, the two tiers Jones and Dangl described in 2006."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_jones_dangl_2006"
  ^["limits"]{
   holds: "as a map of recognition"
   fails: "the tiers potentiate each other rather than acting in a strict sequence"
   source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_ngou_2021"
  }
 }
 #>plant_science_genomics_resistosome
 ^["resistosome"]{
  #:claim #!settled
  statement: "An activated ZAR1 NLR assembles into a wheel-shaped resistosome, a structure solved in 2019 that links recognition to cell death at the membrane."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_wang_2019"
 }
 ^["nlr_origins"]{
  #>plant_science_genomics_nlr_raw
  ^["common_ancestor"]{
   #:claim #!contested
   statement: "Plant and animal NLRs inherited their nucleotide-binding plus leucine-rich-repeat plan from one shared ancestral receptor; the main phylogenetic test, Urbach and Ausubel 2017, does not support this."
   source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_urbach_ausubel_2017"
   note: "the raw generation stated this as fact with an unsourced age; it rests against one analysis, so it is graded contested rather than refuted"
  }
  #>plant_science_genomics_nlr_convergent
  ^["convergent"]{
   #:claim #!emerging
   statement: "Plant R-proteins carry the NB-ARC domain also found in animal APAF-1 and CED-4, and their NTPase domains share an ancestor with animal NLRs, but pairing them with leucine-rich repeats evolved at least twice."
   sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_urbach_ausubel_2017", ~"../../registries/sources/plants-ecology-care.spw#src_eco_van_der_biezen_1998" ]
   ^["limits"]{
    holds: "the domain phylogeny in one 2017 analysis"
    fails: "bacteria carry NACHT immune proteins with NLR-like domain plans, and whether plants or animals took theirs by horizontal transfer is open"
    source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_kibby_2023"
   }
  }
 }
 #>plant_science_genomics_sweet
 ^["sweet_promoters"]{
  #:claim #!settled
  statement: "Editing effector-binding elements in rice SWEET promoters stopped bacterial TAL effectors from switching on sugar export and gave broad-spectrum blight resistance."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_oliva_2019"
 }
}

^["postharvest"]{
 #>plant_science_genomics_ethylene
 ^["ethylene_path"]{
  #:claim #!settled
  statement: "Plants make ethylene from methionine through S-adenosylmethionine and ACC; ACC synthase is the committed and usually rate-limiting step, and ACC oxidase converts ACC to ethylene."
  sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_adams_yang_1979", ~"../../registries/sources/plants-ecology-care.spw#src_eco_taiz_2015" ]
 }
 #>plant_science_genomics_mcp
 ^["receptor_block"]{
  #:claim #!settled
  statement: "1-Methylcyclopropene binds ethylene receptors and blocks the ripening response, which slows climacteric fruit such as apples in storage."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_sisler_serek_1997"
 }
}

^["stress"]{
 #>plant_science_genomics_sos
 ^["salt_pathway"]{
  #:claim #!settled
  statement: "In the SOS pathway a calcium sensor activates the SOS2 kinase, which activates the SOS1 sodium-proton antiporter to push sodium out of root cells."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_zhu_2002"
 }
 #>plant_science_genomics_vavilov
 ^["centers_of_origin"]{
  #:claim #!settled
  statement: "Vavilov proposed in 1926 that crop diversity clusters in a few centers of origin; wild relatives there still supply resistance genes to breeders."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_vavilov_1926"
  ^["limits"]{
   holds: "as the founding map of crop genetic resources"
   fails: "later work found diffuse and multiple domestication areas that his centers do not cover"
  }
 }
}

#>plant_science_genomics_stacking_q
?["Does stacking promoter edits for disease resistance cost yield in the field?"]{
 #:depth #!computational ~#lens(molecular binding)
 #:claim #!speculative
 ~#hypothesis: "Promoter edits that block one pathogen's switch cost less yield than knockouts, because the host still expresses the transporter for its own sugar needs."
 !probe{ "multi-site field trial of promoter-edited and knockout lines, disease pressure and yield" =id[p_eco_genomics_stacking] =kind[field] }
 ~"./plant-genomics.spw#plant_science_genomics_sweet" ~#neighbor(nearest)
}
