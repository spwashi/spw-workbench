# Plant Science
#
# Botany, horticulture, and plant genomics, with a seed-sovereignty stance kept as an interpretive note and its contested numbers kept with their counter-sources.

#>plant_science_index
#:layer #!reference
#:domain #!plant_science
#:form #!index
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Plant Science"
 ~#claim: "Plant science runs from tissues and water to working numbers in the greenhouse to genome editing, and the seed sits under all three."
 ~#proof: "Each leaf links its claims to the plants, ecology, and care sources registry; the seed stance cites Kloppenburg, the 2001 plant treaty, and Haudenosaunee agronomy."
 ~#door: "New to plants: botany core. Growing something this season: horticultural science. Breeding or editing: plant genomics."
 ~#audience: "students, growers, and curious readers"
 continuity: "Plant Science | the seed"
 cold_open: "Plant science runs from root to greenhouse to genome, and the seed sits under all three."
}

