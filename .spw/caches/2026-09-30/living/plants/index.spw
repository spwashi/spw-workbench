 corrections: #[
  "the raw loss figure for vegetable varieties is kept as contested with its counter-source (raw line 26)",
  "health claims for horticultural therapy and biophilia were unsourced and dropped (raw lines 33 and 37)",
  "the raw facade wonder carried invented cooling and yield percentages and was dropped",
  "the raw masting wonder asserted continent-wide chemical signaling without evidence and was dropped",
  "fact-check 2026-10-03: the Three Sisters claim set hoe culture against plow farming; Mt. Pleasant compares Iroquois maize with European wheat, three to five times per acre, and credits both unplowed soil and the yield potential of maize, so the claim now says so and is graded emerging as one reconstruction"
 ]
}

^["tree"]{
 botany: ~"./botany-core.spw"
 horticulture: ~"./horticultural-science.spw"
 genomics: ~"./plant-genomics.spw"
}

^["bundle"]{
 ={ ~"./botany-core.spw#plant_science_botany" }
 ={ ~"./horticultural-science.spw#plant_science_horticulture" }
 ={ ~"./plant-genomics.spw#plant_science_genomics" }
}

^["ladder"]{
 rungs: << "foundation: botany core" ; "practitioner: horticultural science" ; "graduate: plant genomics" >>
 note: "practitioner sits before graduate here because the calendar is usable without the genetics"
}

^["facets"]{
 order: "leaves by matter, then form, then level"
 rows: #[
  .{ leaf: "botany-core", matter: "cohesion tension, Casparian strip", form: "ledger", level: "foundation" },
  .{ leaf: "horticultural-science", matter: "photoperiodism, propagation", form: "calendar", level: "practitioner" },
  .{ leaf: "plant-genomics", matter: "genomic selection, base editing", form: "ledger", level: "graduate" }
 ]
}

^["stance"]{
 #>plant_science_index_seed
 ^["seed_sovereignty"]{
  #:claim #!interpretive
  statement: "Seed is both a living inheritance and a property object; this branch reads breeding and editing alongside the farmers who saved and shared seed first."
  sources: [ ~"../../registries/sources/plants-ecology-care.spw#src_eco_kloppenburg_2004", ~"../../registries/sources/plants-ecology-care.spw#src_eco_itpgrfa_2001" ]
  law: "in the United States patent rights reach saved seed of a patented variety, as Bowman v. Monsanto held in 2013"
  law_source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_bowman_2013"
  benefit_sharing: "the Nagoya Protocol of 2010 sets prior informed consent and benefit-sharing for genetic resources and associated traditional knowledge"
  benefit_source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_nagoya_2010"
 }
 #>plant_science_index_three_sisters
 ^["three_sisters"]{
  #:claim #!emerging
  statement: "Haudenosaunee (Iroquois) maize farmers of the seventeenth and eighteenth centuries produced three to five times more grain per acre than wheat farmers in Europe, by Mt. Pleasant's agronomic reconstruction."
  causes: "Mt. Pleasant credits two factors: soil organic matter kept high because no plow turned the ground, and the higher yield potential of maize as a C4 crop"
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_mt_pleasant_2011"
  origins: "polyculture of maize, beans, and squash is Indigenous knowledge of the Americas, carried in Haudenosaunee and many other nations"
  ~#(Kimmerer writes the Three Sisters as a teaching of reciprocity)
  reading: ~"../../registries/sources/plants-ecology-care.spw#src_eco_kimmerer_2013"
  ^["limits"]{
   holds: "seventeenth and eighteenth century northeastern North America, reconstructed from period accounts and agronomic data"
   fails: "a single reconstruction of yields, not a field trial run in the period"
   confound: "the comparison sets maize against wheat, so the full gap mixes crop and tillage; she assigns a significant share, not all of it, to the absence of plowing"
  }
 }
 #>plant_science_index_variety_loss
 ^["variety_loss"]{
  #:claim #!contested
  statement: "A widely repeated figure says most vegetable varieties sold around 1900 vanished by the 1980s; it compares old catalogs with seed-bank holdings, a method later critics dispute."
  source: ~"../../registries/sources/plants-ecology-care.spw#src_eco_fowler_mooney_1990"
  counter: ~"../../registries/sources/plants-ecology-care.spw#src_eco_heald_chapman_2011"
 }
}

^["gaps"]{
 predicted: #[
  "agriculture and soil science beyond horticulture, expected beside horticultural science",
  "plant pathology field practice, expected beside plant genomics",
  "ethnobotany with community consent, expected beside the seed stance"
 ]
}

^["doors"]{
 student: "botany core, then plant genomics"
 grower: "horticultural science, then botany core"
 reader_of_the_season: "the calendar frame in horticultural science"
}
