# Horticultural Science
#
# Working numbers, propagation, photoperiod control, and pest thresholds, set on a growing calendar from 1 October 2026 to early January 2027.

#>plant_science_horticulture
#:layer #!pragmatics
#:domain #!plant_science
#:form #!calendar
#:level #!practitioner
#:review #!sourced
#:valence #!boon
#:season #!reflection

^"emit"{
 ~#title: "Horticultural Science"
 ~#claim: "Autumn is short-day season: lengthening nights set poinsettia flowers, long or cool nights set holiday cactus buds, and soil water, compost, and propagation run on a few working numbers."
 ~#proof: "Photoperiodism from Garner and Allard 1920; far-red elongation from Kasperbauer 1971; soil and compost values from Weil and Brady and the NRAES handbook; seed storage from Ellis and Roberts 1980."
 ~#door: "Read the calendar from 1 October, then the photoperiod claims, then try a germination test."
 ~#audience: "home growers and horticulture students"
 continuity: "Horticultural Science | short-day season"
 cold_open: "October opens short-day season, when long nights tell poinsettias to flower and long or cool nights set holiday cactus buds."
}

