# Symmetry
#
# Changes that leave something the same, gathered from physics, crystals, ornament, chemistry, film, measurement, and proposed Spw container laws, with each pairing naming where it breaks.

#>concepts_symmetry
#:layer #!reference
#:domain #!concepts
#:form #!comparison
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Symmetry"
 ~#claim: "A symmetry is a change that leaves something the same; continuous ones in physics protect conserved quantities, finite group lists sort crystals and ornament, and Spw container swaps remain proposals."
 ~#proof: "Noether for the physics pairs, the International Tables and Grunbaum for the pattern groups, Weyl for the bridge between ornament and physics, and the symmetries registry for the group tests on Spw spellings."
 ~#door: "Read the lattice and ornament pairing first, then ask which of its breaks a physicist would accept."
 ~#audience: "physics students and designers who cluster ideas by invariance"
 continuity: "Symmetry | leaves something the same"
 cold_open: "A symmetry is a change that leaves something the same, and every field names that something differently."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new", "persona study tree_amendments[17] and [18], references/studies/persona-synthesis.json" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the invariant break said a fixed number conserves something only if its maps are the time evolution; Noether needs continuous symmetries of the action, such as rotations, and invariance under the time evolution itself is trivial",
  "the container reading listed composition as the fourth group test; the group axioms are closure, associativity, identity, and inverse, and the hub now says canon names composition instead"
 ]
 rule: "a hub links keystones and names where each pairing breaks; group counts live in the contraptions registry and the pairs in the symmetries registry"
 gap: "no making or visual-arts surface yet treats ornament or tiling, so the design side of this hub rests on the symmetries registry rows"
}

^["edges"]{
 grounds: [ ~"../registries/symmetries.spw#registry_symmetries" ]
 see: [ ~"./conservation.spw#concepts_conservation", ~"./phase-and-transition.spw#concepts_phase_and_transition" ]
}

^["concepts"]{
 primary: [ #symmetry, #invariant ]
 transfers: [ #crystal_structure, #closure ]
 tensions: [ #false_analogy ]
}

^["fed_by"]{
 tags: [ #symmetry, #invariant, #closure, #crystal_structure, #duality ]
 rule: "a tag feeds this hub when the concepts frames of at least two surfaces carry it"
}

^["pairings"]{
 #>concepts_symmetry_invariant
 ^["invariant_and_conserved"]{
  ^["edges"]{
   analog: [
    ~"../physical/physics/core-sequence.spw#physics_core_noether",
    ~"../formal/formal-glossary.spw#formal_term_invariant"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A symmetry names a change and an invariant names what survives it; Noether turned a continuous family of such changes into a quantity kept over time."
  }
  breaks: "a formal invariant needs no dynamics, so a number fixed under a class of maps conserves nothing over time unless those maps are continuous symmetries of the action that governs the motion"
  source: ~"../registries/sources/spw-contraptions.spw#src_contrap_kosmann_schwarzbach_2011"
  origin: ~"../formal/mathematics/analysis-and-algebra-core.spw#mathematics_core_quintic"
  ~#(groups entered mathematics as the permutations of roots an equation allows)
 }
 #>concepts_symmetry_ornament
 ^["lattice_and_ornament"]{
  ^["edges"]{
   analog: [
    ~"../physical/materials/materials-core.spw#materials_core_lattices",
    ~"../registries/symmetries.spw#registry_sym_plane_groups",
    ~"../registries/symmetries.spw#registry_sym_alhambra"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "Finite lists of groups sort every periodic arrangement: the space groups for atoms in a crystal, the plane groups for tiles on a palace wall."
  }
  breaks: "a crystal group is read from how atoms diffract, while a wallpaper count depends on what a viewer chooses to count, such as colour and interlace, which is why the Alhambra count is contested"
  reads: %[contrap.sym.plane_groups, contrap.sym.space_groups_3d]
  sources: [ ~"../registries/sources/materials-and-engineering.spw#src_mateng_itc_vol_a_2016", ~"../registries/sources/spw-contraptions.spw#src_contrap_grunbaum_2006" ]
  counter: ~"../registries/sources/spw-contraptions.spw#src_contrap_montesinos_1987"
  bridge: ~"../registries/sources/concepts.spw#src_concepts_weyl_1952"
  ~#(Nasrid artisans in Granada found these patterns by craft, before any group list)
 }
 #>concepts_symmetry_mirror
 ^["mirror_labels"]{
  ^["edges"]{
   analog: [
    ~"../registries/symmetries.spw#registry_sym_parity",
    ~"../physical/chemistry/index.spw#chemistry_stance_chirality",
    ~"../spw/contraptions/sign-walker.spw#spw_lab_sign_walker_parity"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A mirror flip done twice returns the start, so each thing it acts on carries a plus or minus label that multiplies."
  }
  breaks: "physical parity is a symmetry the weak interaction breaks, a chiral molecule is not its own mirror image so reflection makes a different substance, and screen direction is an editing convention a cut may cross on purpose"
  sources: [ ~"../registries/sources/spw-contraptions.spw#src_contrap_wu_1957", ~"../registries/sources/spw-contraptions.spw#src_contrap_arijon_1976" ]
  see: ~"../registries/symmetries.spw#registry_sym_parity_violation"
 }
 #>concepts_symmetry_breaking
 ^["broken_symmetry"]{
  ^["edges"]{
   analog: [
    ~"../living/cells/cell-cycle-and-stem-cells.spw#cell_biology_cell_cycle_turing",
    ~"../physical/physics/graduate-topics.spw#physics_graduate_universality",
    ~"../physical/physics/graduate-topics.spw#physics_graduate_mermin_wagner"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "Structure appears when a uniform state gives up a symmetry: stripes from an even chemical mix, order from a disordered magnet."
  }
  breaks: "Landau tied equilibrium transitions to an order parameter and a free energy, while a Turing pattern breaks symmetry far from equilibrium through reaction and diffusion, with no free energy to minimize"
  sources: [ ~"../registries/sources/concepts.spw#src_concepts_landau_1937", ~"../registries/sources/physical-sciences-and-image.spw#src_phys_turing_1952" ]
 }
 #>concepts_symmetry_scales
 ^["meaningful_statements"]{
  ^["edges"]{
   analog: [
    ~"../spw/contraptions/band-coverage.spw#spw_lab_band_coverage_scales",
    ~"../spw/contraptions/rubric-lens.spw#spw_lab_rubric_lens_min_invariant",
    ~"../language-and-mind/cognition/perception-and-attention.spw#cognition_perception_power_law"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A statement about measured values is meaningful when it survives every relabeling its scale allows, a symmetry of measurement rather than of motion."
  }
  breaks: "these invariances belong to statements about numbers, not to any process, so nothing is conserved and no Noether argument applies"
  source: ~"../registries/sources/spw-contraptions.spw#src_contrap_stevens_1946"
 }
 #>concepts_symmetry_spw
 ^["container_conversions"]{
  status: #proposed
  ^["edges"]{
   analog: [
    ~"../registries/symmetries.spw#registry_sym_bracket_swap",
    ~"../spw/contraptions/automaton-loom.spw#spw_lab_automaton_loom_orbits"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A container conversion would be a symmetry of Spw only if it passed closure, associativity, identity, and inverse on meaning, as reflecting a rule table maps automata onto automata."
  canon_wording: "canon's register-geometry list names composition in place of associativity, and the symmetries registry rows follow canon"
  }
  breaks: "the bracket swap forms a group on spellings, since swaps compose as functions and so associate, yet it changes the parse tree, so it is a symmetry of strings, not of meaning"
  cites: [ "docs/theory/spw/register-geometry.spw:104-116" ]
  source: ~"../registries/sources/spw-contraptions.spw#src_contrap_canon_register_geometry"
 }
}

^["try"]{
 #>concepts_symmetry_try_floor
 ^["read_a_floor"]{
  materials: [ "a tiled floor, a printed wallpaper, or a textile with a repeat", "a pencil", "a sheet of tracing paper" ]
  steps: << "trace the smallest patch that repeats" ; "mark each point the pattern turns about and count how many turns bring it home" ; "draw every mirror line" ; "check that no turn needs five steps" >>
  time: .{ n: 20, unit: "minutes" }
  safety: "no hazard worth naming; stay off wet or polished floors while you trace"
  shows: ~"../registries/symmetries.spw#registry_sym_point_groups"
 }
}

#>concepts_symmetry_design_q
?["Does naming the group of a pattern help a designer predict which edits keep its repeat?"]{
 #:depth #!stylistic ~#lens(symmetry and invariance)
 #:claim #!speculative
 ~#hypothesis: "Designers who name a tile's group before editing it should break its repeat less often than designers who edit by eye."
 !probe{ "give two groups of design students one tile, ask one group to name its plane group first, and count edits that break the repeat in each group" =id[p_concepts_symmetry_name_group] =kind[field] }
 $%[contrap.sym.plane_groups, contrap.sym.frieze_groups]
 ~"./symmetry.spw#concepts_symmetry_ornament" ~#neighbor(nearest)
 breaks: "a group names which motions map a pattern onto itself, while its look also depends on colour, scale, and contrast that no group records"
}
