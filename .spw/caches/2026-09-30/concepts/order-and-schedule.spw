# Order and Schedule
#
# What comes first and why it matters, gathered from cue pages, run sheets, sound-change rules, curricula, numerical splitting, animation rigs, and calendars, with each pairing naming where it breaks.

#>concepts_order_and_schedule
#:layer #!reference
#:domain #!concepts
#:form #!comparison
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Order and Schedule"
 ~#claim: "Cue pages, sound-change rules, curricula, and numerical splitting all decide what comes first, and in each the order is part of the result, though only splitting has an error order to measure."
 ~#proof: "Kiparsky for rule interactions, Strang and Trotter for splitting, the curriculum graph for prerequisites, and the order counter for cue pages."
 ~#door: "Count the orders of one cue page with the order counter, then read the splitting pairing."
 ~#audience: "stage managers, broadcasters, linguists, teachers, numerical analysts, and animators"
 continuity: "Order and Schedule | what comes first"
 cold_open: "When two steps do not commute, deciding what comes first is part of the answer."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new", "persona study tree_amendments[18] and metaphor_limits, references/studies/persona-synthesis.json" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the rule-order break said mathematics fixes the order of two noncommuting flows; either order is a valid first-order splitting, and mathematics fixes only the error each schedule costs"
 ]
 rule: "a hub links keystones and names where each pairing breaks; the splitting orders are read from this package registry"
}

^["edges"]{
 grounds: [ ~"../registries/quantities/concepts.spw#q_concepts_splitting" ]
 see: [ ~"./phase-and-transition.spw#concepts_phase_and_transition", ~"./gaps-and-prediction.spw#concepts_gaps_and_prediction" ]
}

^["concepts"]{
 primary: [ #ordering, #partial_order ]
 transfers: [ #prerequisite, #commutation ]
 tensions: [ #schedule_pressure ]
}

^["fed_by"]{
 tags: [ #ordering, #partial_order, #prerequisite, #commutation, #run_sheet ]
 rule: "a tag feeds this hub when the concepts frames of at least two surfaces carry it"
}

^["pairings"]{
 #>concepts_order_cue_page
 ^["cue_page"]{
  ^["edges"]{
   analog: [
    ~"../spw/contraptions/order-counter.spw#spw_lab_order_counter_cues",
    ~"../making/broadcast/episode-run-sheet.spw#broadcast_run_sheet_overflow"
   ]
   see: [ ~"../spw/perspectives/production-crews.spw#spw_perspectives_crews_schedule" ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A page fixes some orders and leaves others free, and grouping steps under one call shrinks the orders left to go wrong."
  }
  breaks: "a GO is an event in time that a stage manager calls and a run sheet window is a target in minutes, while a Spw schedule records an order and nothing keeps time for it"
  source: ~"../registries/sources/spw-doors-perspectives.spw#src_doors_seed_grammar"
 }
 #>concepts_order_rule_order
 ^["rule_order"]{
  ^["edges"]{
   analog: [
    ~"../spw/contraptions/order-counter.spw#spw_lab_order_counter_kiparsky",
    ~"../language-and-mind/linguistics/phonetics-and-phonology.spw#linguistics_phonology_spe",
    ~"../language-and-mind/linguistics/historical-linguistics.spw#linguistics_historical_verner"
   ]
   contrasts: [ ~"../language-and-mind/linguistics/phonetics-and-phonology.spw#linguistics_phonology_ot" ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "Two rules applied in different orders give different words, so in an ordered-rule grammar the order is part of the grammar."
  }
  breaks: "rule order is a hypothesis about grammars that Optimality Theory recast as ranked constraints judged on whole candidates at once, while for two noncommuting flows either order is a valid splitting and mathematics fixes only the error order each schedule costs"
  sources: [ ~"../registries/sources/spw-contraptions.spw#src_contrap_kiparsky_1968", ~"../registries/sources/language-and-communities.spw#src_lang_prince_smolensky_2004", ~"../registries/sources/spw-contraptions.spw#src_contrap_hairer_lubich_wanner_2006" ]
 }
 #>concepts_order_prerequisites
 ^["prerequisites"]{
  ^["edges"]{
   analog: [
    ~"../formal/computing/curriculum-dag.spw#computing_curriculum_dag",
    ~"../learning/institutions/curricular-architecture.spw#institutions_curric_math_chain",
    ~"../spw/contraptions/dag-walker.spw#spw_lab_dag_walker"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A curriculum is a partial order, so any sequence that respects every needs edge is a legal path through it."
  }
  breaks: "a needs edge is a teaching judgment that some students skip with success, while a walker treats it as hard, and counting the legal sequences of a partial order is #P-complete in general"
  source: ~"../registries/sources/spw-contraptions.spw#src_contrap_brightwell_winkler_1991"
  see: ~"../spw/contraptions/order-counter.spw#spw_lab_order_counter_hard"
 }
 #>concepts_order_splitting
 ^["splitting"]{
  ^["edges"]{
   analog: [
    ~"../spw/contraptions/law-lab.spw#spw_lab_law_lab_splitting",
    ~"../spw/contraptions/law-lab.spw#spw_lab_law_lab_transforms",
    ~"../making/visual/animation-principles.spw#visual_arts_anim_pose_to_pose"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "When two operations do not commute the schedule decides the result, and a symmetric schedule cancels the leading error."
  }
  breaks: "splitting error shrinks with the step and has an order, a rig that rotates before it translates is wrong at any size, and choosing straight ahead or pose to pose orders the drawing work, not the motion on screen"
  reads: %[concepts.splitting.lie_trotter_order, concepts.splitting.strang_order]
  sources: [ ~"../registries/sources/spw-contraptions.spw#src_contrap_strang_1968", ~"../registries/sources/spw-contraptions.spw#src_contrap_trotter_1959", ~"../registries/sources/film-stage-visual.spw#src_film_thomas_johnston_1981" ]
  see: ~"../spw/contraptions/law-lab.spw#spw_lab_law_lab_symplectic"
 }
 #>concepts_order_clock
 ^["order_and_clock"]{
  ^["edges"]{
   analog: [
    ~"../season/production-cadence.spw#season_cadence_beat",
    ~"../living/development-and-ecology/biological-clocks.spw#development_ecology_clocks_human_tau"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A cadence adds a clock to an order: the same steps, each now pinned to a day or an hour."
  }
  breaks: "a body clock runs on its own and light resets it each day, while a production week is set by agreements and deadlines and stops when people stop"
  source: ~"../registries/sources/plants-ecology-care.spw#src_eco_czeisler_1999"
 }
}

^["try"]{
 #>concepts_order_try_cards
 ^["three_cards"]{
  materials: [ "three index cards", "a pen", "a friend" ]
  steps: << "write lights, sound, and curtain on the cards" ; "list every order the three could go in" ; "group lights and sound under one call and list the orders again" ; "say which orders a mistake could still produce" >>
  time: .{ n: 15, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"../spw/contraptions/order-counter.spw#spw_lab_order_counter_cues"
 }
}

#>concepts_order_review_q
?["Does a lesson that reviews before and after new material work like a symmetric splitting?"]{
 #:depth #!educational ~#lens(production cadence)
 #:claim #!speculative
 ~#hypothesis: "Splitting review around new material should help later recall more than putting all review first, if the analogy carries any weight."
 !probe{ "search the spacing and retrieval literature for studies that compare review placed before and after new material with review placed only before" =id[p_concepts_order_split_review] =kind[lit] }
 $%[concepts.splitting.lie_trotter_order, concepts.splitting.strang_order]
 ~"./order-and-schedule.spw#concepts_order_splitting" ~#neighbor(nearest)
 breaks: "splitting error cancels because two flows run in mirror order; a lesson has no flows, so any gain would come from spacing and retrieval, not from symmetry"
}
