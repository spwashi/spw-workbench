# Gaps and Prediction
#
# Empty cells that predict and empty cells that invite, gathered from the periodic table, the laryngeals, the Dirac equation, game tables, defective paradigms, curriculum grids, and Spw particle aims, with each pairing naming where it breaks.

#>concepts_gaps_and_prediction
#:layer #!reference
#:domain #!concepts
#:form #!comparison
#:level #!foundation
#:review #!adversarial_checked
#:valence #!boon

^"emit"{
 ~#title: "Gaps and Prediction"
 ~#claim: "An empty cell predicts its occupant only when a law orders the grid; Mendeleev and Saussure had one, while a game table, a defective paradigm, and a curriculum grid mark coverage or an invitation."
 ~#proof: "Scerri for the periodic table, Saussure and Kurylowicz for the laryngeals, Anderson for the positron, Robinson and Goforth for the closed game table, and Baerman and coauthors for defective paradigms."
 ~#door: "Read the predicted and found pairing, then the game table, and say which kind of gap an empty cell is."
 ~#audience: "chemistry and linguistics students, game theorists, teachers, and designers who build grids"
 continuity: "Gaps and Prediction | an empty cell"
 cold_open: "An empty cell is a prediction only when a law orders the grid; otherwise it is an invitation."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new", "persona study tree_amendments[18] and metaphor_limits, references/studies/persona-synthesis.json" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the predicted-and-found pairing credited the finders of three elements and of the laryngeal evidence but not Carl D. Anderson, who found the positron Dirac's equation predicted; the credit and his 1932 and 1933 papers are now in place",
  "the break said Mendeleev ordered elements by recurring properties; he ordered them by atomic weight and grouped them by recurring properties, letting properties overrule weight in a few places"
 ]
 rule: "a hub links keystones and names where each pairing breaks; the gap table panel counts the plan, and this hub sorts kinds of gap"
}

^["edges"]{
 grounds: [ ~"../spw/contraptions/grid-gap-finder.spw#spw_lab_grid_gap" ]
 see: [ ~"../panels/gap-table.spw#panel_gap_table", ~"./order-and-schedule.spw#concepts_order_prerequisites" ]
}

^["concepts"]{
 primary: [ #visible_gap, #prediction ]
 transfers: [ #periodic_table, #hole ]
 tensions: [ #overclaim ]
}

^["fed_by"]{
 tags: [ #visible_gap, #prediction, #periodic_table, #hole, #reconstruction ]
 rule: "a tag feeds this hub when the concepts frames of at least two surfaces carry it"
}

^["pairings"]{
 #>concepts_gaps_predicted
 ^["predicted_and_found"]{
  kind: #prediction
  ^["edges"]{
   analog: [
    ~"../record/information/reference-works-lineage.spw#information_science_lineage_mendeleev",
    ~"../language-and-mind/linguistics/historical-linguistics.spw#linguistics_historical_laryngeal_confirmed",
    ~"../physical/physics/graduate-topics.spw#physics_graduate_dirac"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A structure with a law behind it left a slot, the slot described its occupant, and later evidence filled it."
  }
  breaks: "Mendeleev ordered elements by atomic weight and grouped them by recurring properties, letting properties overrule weight for tellurium and iodine, Saussure reasoned from regular alternations in roots, and Dirac from an equation; each gap followed from a theory, not from the shape of a table"
  reads: %[prov.mendeleev.confirmed_prediction_count]
  sources: [ ~"../registries/sources/provenance-and-reference.spw#src_prov_scerri_2007", ~"../registries/sources/language-and-communities.spw#src_lang_saussure_1879", ~"../registries/sources/language-and-communities.spw#src_lang_hrozny_1917", ~"../registries/sources/language-and-communities.spw#src_lang_kurylowicz_1927", ~"../registries/sources/concepts.spw#src_concepts_anderson_1932", ~"../registries/sources/concepts.spw#src_concepts_anderson_1933" ]
  see: ~"../language-and-mind/linguistics/historical-linguistics.spw#linguistics_historical_laryngeal_prediction"
  credit: "Lecoq de Boisbaudran, Nilson, and Winkler found gallium, scandium, and germanium; Anderson found the positron; Hrozny showed Hittite was Indo-European; Kurylowicz matched its h to Saussure's lost sounds"
 }
 #>concepts_gaps_coverage
 ^["coverage"]{
  kind: #coverage
  ^["edges"]{
   analog: [
    ~"../spw/contraptions/grid-gap-finder.spw#spw_lab_grid_gap_closed",
    ~"../panels/gap-table.spw#panel_gap_table_counts"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A table whose cells are all defined in advance shows which ones nobody has studied or written yet."
  }
  breaks: "every strict ordinal two-by-two game exists by construction, so an empty cell marks missing study, never a new game, and an empty cell in the cut plan marks writing not yet done"
  reads: %[contrap.games.strict_ordinal_2x2_count]
  source: ~"../registries/sources/spw-contraptions.spw#src_contrap_robinson_goforth_2005"
 }
 #>concepts_gaps_paradigm
 ^["paradigm_gaps"]{
  kind: #absence
  ^["edges"]{
   analog: [
    ~"../spw/contraptions/grid-gap-finder.spw#spw_lab_grid_gap_defective",
    ~"../spw/contraptions/grid-gap-finder.spw#spw_lab_grid_gap_particles"
   ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A grammar's rules seem to allow a form that the language or the lexer never produces."
  }
  breaks: "a defective verb is a lasting fact about a language its speakers keep, not a forecast that the form will appear, while a Spw particle hole is an aim canon names that the lexer could gain by a code change"
  reads: %[gloss.lexer.particle_aims_n, gloss.lexer.lattice_aims_n]
  source: ~"../registries/sources/spw-contraptions.spw#src_contrap_baerman_2010"
 }
 #>concepts_gaps_invitation
 ^["invitation"]{
  kind: #invitation
  ^["edges"]{
   analog: [
    ~"../spw/contraptions/grid-gap-finder.spw#spw_lab_grid_gap_draft",
    ~"../spw/contraptions/closure-atlas.spw#spw_lab_closure_atlas",
    ~"../learning/institutions/curricular-architecture.spw#institutions_curric_gateway"
   ]
   see: [ ~"../spw/contraptions/grid-gap-finder.spw#spw_lab_grid_gap_intrigue" ]
  }
  ^["reading"]{
   #:claim #!interpretive
   statement: "A hole flanked by filled cells invites a draft its neighbours can almost write, and an undecided pair of properties invites a missing example."
  }
  breaks: "a curriculum grid has no law behind it, so a hole may be a deliberate omission and only a teacher decides whether a draft belongs, while an undecided pair in the closure atlas closes once someone finds the example or theorem it lacks"
  source: ~"../registries/sources/spw-contraptions.spw#src_contrap_canon_dimensional_axes"
 }
}

^["sorting"]{
 #>concepts_gaps_kinds
 ^["four_kinds"]{
  #:claim #!interpretive
  statement: "A gap predicts when a law orders the grid, marks coverage when the grid is closed, records an absence when speakers keep it, and invites when nothing orders it."
  order: << "prediction" ; "coverage" ; "absence" ; "invitation" >>
  ~#(the same blank square on paper can be any of the four)
 }
}

#>concepts_gaps_particle_q
?["Could the laryngeal story repeat for Spw, with a canon aim the lexer later emits?"]{
 #:depth #!historical ~#lens(formal structure)
 #:claim #!speculative
 ~#hypothesis: "If canon names a particle aim the lexer lacks, a later lexer change that fills the hole should give it the reading canon described, as Hittite matched what Saussure posited."
 !probe{ "after each lexer change, compare emitted particle aims with the canon list and log which holes filled and whether their readings matched canon" =id[p_concepts_gaps_particle_fill] =kind[census] }
 $%[gloss.lexer.particle_aims_n, gloss.lexer.lattice_aims_n]
 ~"./gaps-and-prediction.spw#concepts_gaps_paradigm" ~#neighbor(nearest)
 breaks: "the lost sounds existed in a language spoken millennia earlier and waited to be found, while a Spw aim exists only once someone builds it, so filling the hole confirms a plan, not a prediction"
}
