# Micro and Macro Core
#
# The intermediate core as a prerequisite graph: consumers and firms, market structure and price discrimination, then IS-LM, expectations, and Solow growth.

#>economics_core
#:layer #!reference
#:domain #!economics
#:form #!curriculum
#:level #!foundation
#:review #!sourced
#:valence #!bone

^"emit"{
 ~#title: "Micro and Macro Core"
 ~#claim: "Intermediate economics is a graph: duality and market structure feed price discrimination, while IS-LM, expectations, and Solow growth build the macro side."
 ~#proof: "Each node cites its originator, from Slutsky and Cournot to Hicks, Friedman, Phelps, Solow, and Swan."
 ~#door: "Walk the nodes in order, run the Solow kit, then cross to revenue management for price discrimination in practice."
 ~#audience: "students in intermediate micro and macro"
 continuity: "Micro and Macro Core | price discrimination"
 cold_open: "Learn how one firm prices, how a whole economy grows, and why price discrimination links the two halves of the course."
}

