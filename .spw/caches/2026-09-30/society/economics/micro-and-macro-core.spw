^["edges"]{
 needs: [ ~"../../formal/mathematics/engineering-core/calculus-and-linear-algebra.spw#mathematics_calc_linalg" ]
 feeds: [ ~"../management/revenue-management.spw#management_revenue", ~"./econometrics-and-data.spw#economics_econometrics" ]
 contrasts: [ ~"../../language-and-mind/cognition/reasoning-and-decision.spw#cognition_reasoning" ]
