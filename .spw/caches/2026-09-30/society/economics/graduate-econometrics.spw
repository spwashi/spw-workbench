^["edges"]{
 needs: [ ~"./econometrics-and-data.spw#economics_econometrics", ~"../../formal/mathematics/engineering-core/probability-and-statistics.spw#mathematics_probstat" ]
 extends: [ ~"./econometrics-and-data.spw#economics_econometrics_weak_iv" ]
