# Economics
#
# Choice under constraint, from intermediate micro and macro through identification and the graduate cores, with one interpretive note on what efficiency does and does not decide.

#>economics_index
#:layer #!reference
#:domain #!economics
#:form #!index
#:level #!foundation
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Economics"
 ~#claim: "Economics here runs from optimization and growth to causal identification and the graduate theorems, and every theorem keeps its hypotheses beside it."
 ~#proof: "Leaves cite the original papers and standard texts through the registry; the weak-instrument rule and welfare theorems carry dated qualifiers."
 ~#door: "Start with the micro and macro core, then read the identification matrix before any graduate leaf."
 ~#audience: "students from intermediate courses through the first graduate year"
 continuity: "Economics | hypotheses beside"
 cold_open: "Economics keeps its hypotheses beside every theorem, so you can see where an efficient answer stops being a just one."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5"
 lineage: #[ ".spw/caches/university-education/economics/taste.spw", ".spw/caches/university-education/economics/index.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the raw dispatch table and duplicate roots are replaced by one tree",
  "the 99.9 percent tyrant figure is dropped; the structural point that efficiency allows extreme inequality stays, sourced to standard theory",
  "invented metric handles such as a Pareto Gini coefficient are dropped",
  "taste lines that assert motives of economists are kept only as an interpretive stance"
 ]
}

^["tree"]{
 core: ~"./micro-and-macro-core.spw"
 econometrics: ~"./econometrics-and-data.spw"
 graduate_micro: ~"./graduate-micro-theory.spw"
 graduate_macro: ~"./graduate-macro.spw"
 graduate_econometrics: ~"./graduate-econometrics.spw"
}

^["bundle"]{
 ={
  ~"./micro-and-macro-core.spw#economics_core"
  ~"./econometrics-and-data.spw#economics_econometrics"
  ~"./graduate-micro-theory.spw#economics_grad_micro"
  ~"./graduate-macro.spw#economics_grad_macro"
  ~"./graduate-econometrics.spw#economics_grad_econometrics"
 }
}

^["order"]{
 reading: << "core" ; "econometrics" ; "graduate micro" ; "graduate macro" ; "graduate econometrics" >>
 forms: "curriculum, comparison, ledger, timeline, comparison"
}

^["calendars"]{
 fiscal: ~"../../season/fiscal-and-academic-years.spw#season_fiscal_academic"
 note: "fiscal and academic year boundaries live in the season hub; economics links there instead of keeping its own calendar"
}

#>economics_stance
^["stance"]{
 #:claim #!interpretive
 statement: "Efficiency is a property of an allocation, not a verdict on it; which endowments a market starts from is a moral and political question the welfare theorems do not answer."
 grounds: ~"./graduate-micro-theory.spw#economics_grad_micro_unequal"
 humility: "institutions, law, and history shape property rights before any market clears"
 behavior: "bounded and social choosers are the rule; the cognition branch carries that evidence"
 causal: "a correlation earns a causal reading only through a stated identification strategy"
 voice: "the raw taste file said this as a sermon; the note keeps its substance and drops claims about motives"
}

^["gaps"]{
 io: "industrial organization beyond the price discrimination bridge"
 labor: "labor economics, including minimum wage evidence beyond the Card and Krueger case"
 behavioral: "a behavioral economics surface; today only typed edges reach cognition"
 history: "history of economic thought outside the Anglo-American canon"
}
