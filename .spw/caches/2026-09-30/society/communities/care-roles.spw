# Community Care Roles
#
# Role dossiers for community health workers, promotoras, doulas, peer specialists, harm reduction workers, and death cafe hosts: what each role does, how it is trained and paid, and what the evidence shows.

#>communities_care_roles
#:layer #!reference
#:domain #!communities
#:form #!dossier
#:level #!intro
#:review #!adversarial_checked
#:valence #!honk
#:era #!contemporary

^"emit"{
 ~#title: "Community Care Roles"
 ~#claim: "Lay care roles carry health systems into homes and hard moments, and the best-studied one, continuous support in labor, lowers caesarean risk modestly on low-quality evidence."
 ~#proof: "WHO 2018 guideline on community health workers, CMS 2007 peer support letter, Cochrane review CD003766 version 2017, and Sisco 2024 on drug test strips."
 ~#door: "Read the scope frame first, then the doula evidence, then follow the roles into the lattice."
 ~#audience: "neighbors, students, and organizers learning what community care roles are"
 continuity: "Community Care Roles | continuous support"
 cold_open: "Community care roles bring health work home, and continuous support in labor is the role with the strongest evidence behind it."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/community-roles/care-and-health-stewards.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: [
  "the raw wonder said a doula cuts emergency caesarean rates by 50 percent; the Cochrane review reports a risk ratio of 0.75 on low-quality evidence",
  "the raw hypothesis that doula care cuts preterm births by 28 percent and NICU admissions by 35 percent was invented and is removed; the review found no apparent effect on special care nursery admission",
  "the raw file promised spectroscopic instructions for test strips; drug test strips are immunoassays, and this surface gives no instructions",
  "raw lines on dietary substitutions, postpartum herbs and broths, and depression screening are removed as health advice outside a role dossier",
  "raw vigil, home funeral, and crisis-team lines without sources are dropped; death cafe is kept with its founders credited",
  "fact check: the Guatemala trial was marked settled as a clinical effect; it is kept as history with its exclusion imbalance, and effects come only from the Cochrane review",
  "fact check: Raphael read as a later adopter of doula; she introduced the word by 1969, and Klaus and Kennell later applied it to labor support",
  "fact check: the test strip claim omitted cross-reactivity, the main limit Sisco and colleagues report"
 ]
}

^["scope"]{
 frame: "educational reference on community care roles: what each role does, how it is trained and paid, and what the evidence says"
 never: "no clinical advice, doses, diets, supplements, protocols, or instructions for using any drug, device, or test"
 guidelines: "WHO guideline on community health worker programmes, 2018; CMS letter SMDL 07-011, 2007; Cochrane review CD003766, version 2017"
 questions: "a reader with a health question goes to a clinician, a pharmacist, or a public health agency"
}

^["edges"]{
 contrasts: [ ~"../../living/nursing/ethics-and-presence.spw#nursing_ethics" ]
 grounds: [ ~"../../registries/quantities/language-and-communities.spw#q_lang_labor_support" ]
 see: [ ~"../../provenance/harm-register.spw#provenance_harm_register", ~"./roles-lattice.spw#communities_role_chw" ]
}

^["concepts"]{
 primary: [ #community_health_worker, #continuous_support, #peer_support ]
 transfers: [ #lived_experience, #immunoassay ]
 tensions: [ #uncommodified_care ]
}

^["dossiers"]{
 ^["community_health_workers"]{
  #>communities_care_chw
  ^["who_guideline"]{
   #:claim #!settled
   statement: "The WHO 2018 guideline on community health worker programmes sets recommendations on selecting, training, certifying, supervising, and paying community health workers and on engaging the communities they serve."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_who_chw_2018"
   as_of: "2018 edition, read 2026-10-02"
  }
  #>communities_care_alma_ata
  ^["alma_ata"]{
   #:claim #!settled
   statement: "The 1978 Declaration of Alma-Ata placed community workers, and traditional practitioners where needed, inside primary health care teams."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_alma_ata_1978"
  }
  #>communities_care_promotoras
  ^["promotoras"]{
   #:claim #!settled
   statement: "Promotora and promotor de salud are Spanish names for community health workers; Where There Is No Doctor grew from village health work in Sinaloa, Mexico, and appeared in Spanish in 1973."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_werner_1977"
   credit: "written with village health workers in the Sierra Madre of western Mexico, not for them alone"
  }
 }
 ^["doulas"]{
  #>communities_care_doula_role
  ^["continuous_support"]{
   #:claim #!settled
   statement: "Continuous labor support means emotional support, comfort, information, and advocacy from one person throughout labor; a doula gives it without clinical duties."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_bohren_2017"
  }
  #>communities_care_doula_origin
  ^["origin"]{
   #:claim #!settled
   statement: "Anthropologist Dana Raphael introduced doula, from Greek doule, servant-woman, by 1969 for a woman who supports a new mother, chiefly so breastfeeding succeeds, and popularized it in The Tender Gift in 1973."
   sources: [
    ~"../../registries/sources/language-and-communities.spw#src_lang_wiki_doula",
    ~"../../registries/sources/language-and-communities.spw#src_lang_raphael_1973",
    ~"../../registries/sources/language-and-communities.spw#src_lang_etymonline"
   ]
   later: "physician-researchers Marshall Klaus and John Kennell applied the word to continuous labor support"
   charge: ~"./semiotic-charge.spw#communities_charge_doula"
  }
  #>communities_care_doula_guatemala
  ^["first_trial"]{
   #:claim #!emerging
   statement: "A 1980 Guatemala City trial by Sosa, Kennell, Klaus and colleagues called its lay labor companion a doula and reported shorter labors, and its authors called the benefits suggestive."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_sosa_1980"
   design: "to reach 20 uncomplicated deliveries per arm the trial admitted 103 control and 33 supported mothers, so the arms were compared after heavy, unequal exclusions"
   effects: ~"./care-roles.spw#communities_care_doula_evidence"
   ^["limits"]{
    holds: "as history: the trial that carried the word doula into labor support research"
    fails: "as an effect estimate; effects of continuous support come from the 2017 Cochrane review"
   }
  }
  #>communities_care_doula_evidence
  ^["cochrane_effect"]{
   #:claim #!settled
   statement: "In the 2017 Cochrane review, women with continuous labor support were less likely to have a caesarean birth, risk ratio 0.75, interval 0.64 to 0.88, on low-quality evidence."
   reads: %[
    lang.labor_support.cesarean_rr,
    lang.labor_support.cesarean_ci_low,
    lang.labor_support.cesarean_ci_high
   ]
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_bohren_2017"
   ~#say(continuous support makes a caesarean somewhat less likely)
   ^["limits"]{
    holds: "labor support in the trials the review pooled, from many countries and hospital settings"
    fails: "prenatal and postpartum doula visits are outside the review, and it found no apparent effect on special care nursery admission"
   }
  }
  #>communities_care_doula_who
  ^["who_provides"]{
   #:claim #!settled
   statement: "In subgroup analyses, support lowered caesarean birth most when the provider served in a doula role and where epidurals were not routine; the review found no evidence of harm."
   reads: %[lang.labor_support.trials_count, lang.labor_support.women_count]
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_bohren_2017"
   version: "review version 2017; check the Cochrane Library for a later update before quoting"
  }
 }
 ^["peer_support"]{
  #>communities_care_peer_medicaid
  ^["medicaid_letter"]{
   #:claim #!settled
   statement: "A 2007 federal letter, SMDL 07-011, told US states that peer support services could be billed to Medicaid when peers are supervised, coordinated with care, and trained and certified."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_cms_peer_2007"
   as_of: "letter dated 2007-08-15; state certification rules vary and change"
  }
  #>communities_care_hearing_voices
  ^["hearing_voices"]{
   #:claim #!settled
   statement: "Romme and Escher reported in 1989 on people who hear voices and had learned to live with them, work that helped seed peer-led hearing voices groups."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_romme_escher_1989"
   credit: "the groups are led by voice hearers; psychiatrists documented and supported them"
  }
 }
 ^["harm_reduction"]{
  #>communities_care_test_strips
  ^["test_strips"]{
   #:claim #!settled
   statement: "Drug test strips are antibody immunoassays giving a yes or no above a cutoff: they do not measure amount, can miss related compounds, and nearly all types tested in 2024 reacted to non-target compounds."
   caution: "a positive strip does not identify which substance is present"
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_sisco_2024"
   ^["limits"]{
    holds: "lateral-flow urine test strips used for drug checking, as studied in 2024"
    fails: "laboratory and spectroscopic drug checking are different methods with different limits"
   }
  }
 }
 ^["end_of_life"]{
  #>communities_care_death_cafe
  ^["death_cafe"]{
   #:claim #!settled
   statement: "Jon Underwood and Sue Barsky Reid held the first Death Cafe in London in 2011, after Swiss sociologist Bernard Crettaz; it is a discussion group about death, not grief counselling."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_deathcafe_model"
  }
 }
}

^["stance"]{
 #>communities_care_presence
 ^["presence"]{
  #:claim #!interpretive
  statement: "What these roles share is staying beside a person through a hard passage; the evidence for the doula suggests that presence itself does measurable work."
  counter: "presence is not a substitute for clinical care, and the review measured support alongside hospital care, not instead of it"
 }
}

#>communities_care_independence_q
?["Does support from someone outside the hospital staff matter more than the training of the person giving it?"]{
 #:depth #!social ~#lens(bodily rhythm)
 #:claim #!speculative
 ~#hypothesis: "The caesarean effect tracks the independence of the support person from hospital routine more than the length of their training."
 !probe{ "tabulate the review subgroups by provider type and training hours where trials report them" =id[p_lang_communities_doula_independence] =kind[lit] }
 $%[lang.labor_support.cesarean_rr, lang.labor_support.trials_count]
 ~"./care-roles.spw#communities_care_doula_who" ~#neighbor(nearest)
}

#>communities_care_bridge_q
?["Is a community health worker a broker between two networks?"]{
 #:depth #!social ~#lens(information flow)
 #:claim #!speculative
 ~#hypothesis: "Health workers drawn from the neighborhood they serve carry more information both ways between clinic and household than workers assigned from outside."
 breaks: "a network broker profits from the gap between groups; a community health worker is asked to close it"
 !probe{ "find studies that compare community health workers recruited locally with those assigned from outside on referrals completed" =id[p_lang_communities_chw_broker] =kind[lit] }
 ~"./care-roles.spw#communities_care_chw" ~#neighbor(nearest)
}
