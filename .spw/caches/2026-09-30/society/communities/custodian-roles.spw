# Custodian Roles
#
# Role dossiers for elders, storytellers, mentors, coaches, and muralists, described by what they keep and pass on, with the practices and evidence behind each.

#>communities_custodian_roles
#:layer #!reference
#:domain #!communities
#:form #!dossier
#:level #!intro
#:review #!adversarial_checked
#:valence #!boon
#:era #!contemporary

^"emit"{
 ~#title: "Custodian Roles"
 ~#claim: "Elders, storytellers, mentors, coaches, and muralists keep a community memory and pass it on, and formal mentoring shows modest average benefits for young people."
 ~#proof: "Hale on griots; Wigginton on Foxfire; the Oral History Association principles of 2018; DuBois and colleagues 2011 and Grossman and Tierney 1998 on mentoring; Cockcroft and Alkalimat on murals."
 ~#door: "Read the storytellers first, then carry their consent practice into the interview protocol."
 ~#audience: "families, mentors, artists, and students of community memory"
 continuity: "Custodian Roles | pass it on"
 cold_open: "Some neighbors keep what a community remembers and pass it on, in stories, in mentoring, and on its walls."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/community-roles/intergenerational-and-cultural-custodians.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: [
  "the raw coach dossier framed neighborhood gyms as an alternative to gang recruitment and despair; that stereotype is removed and coaches are described by function",
  "the raw elder councils were gendered as grandmothers; elders are described by what they do, whoever they are",
  "the raw hypothesis that storytelling circles cut adolescent depression 35 percent and elder loneliness 40 percent was invented and is removed",
  "the raw stance that ancestral memory is the most potent shield against gentrification is dropped as an unsourced superlative",
  "oral memory salons are kept only as recording with consent, which the interview protocol carries",
  "fact check: the oral history claim said the OHA principles put informed consent first; they ask that respect for narrators guide the process, with ongoing consent and explicit permission to publish"
 ]
}

^["scope"]{
 people: "roles are described by function; private people are never named, and recordings stay with the people recorded"
 recording: "anyone recording an elder or storyteller follows a consent practice such as the interview protocol"
}

^["edges"]{
 feeds: [ ~"../../learning/intergenerational-kit/interview-protocol.spw#generations_kit_interview" ]
 see: [
  ~"../../language-and-mind/linguistics/sociolinguistics-and-documentation.spw#linguistics_sociolinguistics_nests",
  ~"./crew-crosswalk.spw#communities_crosswalk_keeper"
 ]
}

^["concepts"]{
 primary: [ #oral_history, #mentoring, #community_custody ]
 transfers: [ #consent, #public_art ]
 tensions: [ #stereotype ]
}

^["dossiers"]{
 ^["elders"]{
  #>communities_custodian_elder
  ^["elder_by_function"]{
   #:claim #!interpretive
   statement: "An elder in this cut is whoever a community turns to for memory, advice, and settling disputes; age is common but not sufficient, and the word carried authority by the 1300s."
   charge: ~"./semiotic-charge.spw#communities_charge_elder"
  }
 }
 ^["storytellers"]{
  #>communities_custodian_griots
  ^["griots"]{
   #:claim #!settled
   statement: "In many West African societies, griots and griottes carry genealogies, histories, and praise in words and music, often as a hereditary profession serving patrons."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_hale_griots_1998"
   credit: "a West African institution with its own names, such as jeli among Mande peoples"
  }
  #>communities_custodian_foxfire
  ^["foxfire"]{
   #:claim #!settled
   statement: "High school students in Rabun Gap, Georgia, interviewed Appalachian elders about crafts and ways of life and published the results as The Foxfire Book in 1972."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_wigginton_1972"
  }
  #>communities_custodian_oral_history
  ^["oral_history_principles"]{
   #:claim #!settled
   statement: "The Oral History Association principles adopted in October 2018 ask that the process be guided by respect for narrators and their communities, with ongoing consent and explicit permission before an interview is made public."
   process: "the interview process must be transparent, with ongoing participation and consent from the first encounter to the end products"
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_oha_2018"
   as_of: "principles adopted October 2018; core principles page read 2026-10-02"
  }
 }
 ^["mentors"]{
  #>communities_custodian_mentoring
  ^["mentoring_evidence"]{
   #:claim #!settled
   statement: "A 2011 review of youth mentoring evaluations found benefits across behavioral, social, emotional, and academic outcomes that were modest on average and varied with how programs matched and supported mentors."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_dubois_2011"
   ^["limits"]{
    holds: "formal programs that were evaluated, mostly in the United States"
    fails: "informal mentoring by neighbors and relatives is far less studied"
   }
  }
  #>communities_custodian_bbbs
  ^["big_brothers_big_sisters"]{
   #:claim #!settled
   statement: "In a randomized study of Big Brothers Big Sisters, youth matched with a mentor were less likely to start using drugs or alcohol and to skip school after about eighteen months."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_grossman_tierney_1998"
  }
  #>communities_custodian_coach
  ^["coach_by_function"]{
   #:claim #!interpretive
   statement: "A coach is a mentor whose practice is a shared skill; what makes the role custodial is reliability, showing up season after season, more than the sport."
  }
 }
 ^["muralists"]{
  #>communities_custodian_murals
  ^["mural_movement"]{
   #:claim #!settled
   statement: "Community muralists in the United States from the late 1960s painted walls with and for neighborhoods, drawing on the Mexican mural movement of the 1920s and 1930s."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_cockcroft_1977"
  }
  #>communities_custodian_wall_of_respect
  ^["wall_of_respect"]{
   #:claim #!settled
   statement: "Artists of the Organization of Black American Culture painted the Wall of Respect on Chicago's South Side in 1967, honoring Black heroes on a neighborhood building."
   source: ~"../../registries/sources/language-and-communities.spw#src_lang_alkalimat_2017"
  }
 }
}

#>communities_custodian_archive_q
?["Is an elder an archive with a voice?"]{
 #:depth #!historical ~#lens(curated collection)
 #:claim #!speculative
 ~#hypothesis: "Stories an elder retells many times stay stable in their core events and drift in their details, so repeated recordings show which parts a community treats as fixed."
 breaks: "an archive keeps records in their original order and does not change them; an elder retells and revises, which is the strength of memory and its risk"
 !probe{ "compare two recordings of the same story told years apart, with the narrator consent, and mark what held and what changed" =id[p_lang_communities_elder_retelling] =kind[interview] }
 ~"./custodian-roles.spw#communities_custodian_oral_history" ~#neighbor(nearest)
}

#>communities_custodian_wall_q
?["Does a mural keep a neighborhood memory longer than a plaque?"]{
 #:depth #!social ~#lens(historical layer)
 #:claim #!speculative
 ~#hypothesis: "Residents passing a community mural can name the people and events it shows more often than residents passing a plaque of the same age."
 !probe{ "ask passersby at matched murals and plaques what each one remembers, without recording names" =id[p_lang_communities_mural_memory] =kind[field] }
 ~"./custodian-roles.spw#communities_custodian_murals" ~#neighbor(nearest)
}
