# Communities
#
# Community roles as clustered meaning: who convenes, cares, keeps, and carries in a neighborhood, how the words for those roles change, and what the evidence says.

#>communities_index
#:layer #!reference
#:domain #!communities
#:form #!index
#:level #!intro
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Communities"
 ~#claim: "Community roles are compared here on shared facets and crew functions, with sourced dossiers for care, civic, commons, and custodian work."
 ~#proof: "Four dossiers with registry sources, a facet lattice, a crew crosswalk, dated attestations for eight role words, and a mapping kit."
 ~#door: "Start with the roles lattice, read the dossier closest to your own life, then map your block."
 ~#audience: "neighbors, organizers, and students of community life"
 continuity: "Communities | shared facets"
 cold_open: "Neighborhood roles from doula to block captain sit on shared facets, so you can compare them without ranking them."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/community-roles/taste.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: [
  "the raw taste wonder that 15 percent participation cuts dispute calls by over 60 percent was invented and is removed",
  "the raw taste wonder that stewardship lowers inflammatory markers like a medical intervention was invented and is removed",
  "the raw hope that state coercion becomes entirely obsolete is dropped as a claim; trust and uncommodified care are kept as interpretive stances",
  "fact check: the evidence gap named only the doula and greening trials and missed the randomized mentoring study in the custodian dossier"
 ]
}

^["tree"]{
 roles_lattice: ~"./roles-lattice.spw"
 crew_crosswalk: ~"./crew-crosswalk.spw"
 care: ~"./care-roles.spw"
 civic: ~"./civic-roles.spw"
 commons: ~"./commons-roles.spw"
 custodian: ~"./custodian-roles.spw"
 semiotic_charge: ~"./semiotic-charge.spw"
 role_map: ~"./community-role-map.spw"
}

^["bundle"]{
 ={
  ~"./roles-lattice.spw#communities_roles_lattice"
  ~"./crew-crosswalk.spw#communities_crew_crosswalk"
  ~"./care-roles.spw#communities_care_roles"
  ~"./civic-roles.spw#communities_civic_roles"
  ~"./commons-roles.spw#communities_commons_roles"
  ~"./custodian-roles.spw#communities_custodian_roles"
  ~"./semiotic-charge.spw#communities_semiotic_charge"
  ~"./community-role-map.spw#communities_role_map"
 }
}

^["ladder"]{
 rungs: << "intro" ; "foundation" ; "advanced" >>
 intro: [
  ~"./roles-lattice.spw#communities_roles_lattice",
  ~"./care-roles.spw#communities_care_roles",
  ~"./civic-roles.spw#communities_civic_roles",
  ~"./commons-roles.spw#communities_commons_roles",
  ~"./custodian-roles.spw#communities_custodian_roles",
  ~"./community-role-map.spw#communities_role_map"
 ]
 foundation: [ ~"./crew-crosswalk.spw#communities_crew_crosswalk" ]
 advanced: [ ~"./semiotic-charge.spw#communities_semiotic_charge" ]
}

^["stance"]{
 #>communities_index_trust
 ^["trust_as_infrastructure"]{
  #:claim #!interpretive
  statement: "Trust among neighbors works like infrastructure: it is built slowly by small repeated acts and shows its value mostly when something breaks."
  evidence: ~"./civic-roles.spw#communities_civic_collective_efficacy"
 }
 #>communities_index_care
 ^["uncommodified_care"]{
  #:claim #!interpretive
  statement: "Much community care is given freely, and that gift carries meaning a fee would change; the same branch records that WHO recommends paying community health workers."
  counter: ~"./care-roles.spw#communities_care_chw"
 }
}

^["gaps"]{
 #>communities_gap_discipline
 ^["disciplinary_home"]{
  cell: "community roles have no sociology, anthropology, or law surface beneath them yet"
  predicted_use: "a sociology leaf would ground collective efficacy and role theory; a law leaf would ground tenant and peer certification rules"
 }
 #>communities_gap_evidence
 ^["thin_evidence"]{
  cell: "few community roles here carry randomized evidence; labor support, vacant-lot greening, and formal youth mentoring are the exceptions represented, and most dossier claims are historical or descriptive"
  missing: "community health worker programmes have a large trial literature that no leaf here summarizes yet"
  exceptions: [
   ~"./care-roles.spw#communities_care_doula_evidence",
   ~"./commons-roles.spw#communities_commons_greening",
   ~"./custodian-roles.spw#communities_custodian_bbbs"
  ]
 }
 #>communities_gap_regions
 ^["regions"]{
  cell: "most dossiers describe United States practice; roles elsewhere carry other names and terms and deserve their own dossiers"
 }
}
