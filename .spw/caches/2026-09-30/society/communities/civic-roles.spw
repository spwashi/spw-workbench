# Civic Roles
#
# Role dossiers for block captains, mutual aid coordinators, assembly facilitators, and tenant organizers, with the traditions each draws on and the evidence about neighborhoods that hold together.

#>communities_civic_roles
#:layer #!reference
#:domain #!communities
#:form #!dossier
#:level #!intro
#:review #!adversarial_checked
#:valence #!boon
#:era #!contemporary

^"emit"{
 ~#title: "Civic Roles"
 ~#claim: "Neighbors organize through block clubs, mutual aid, assemblies, and tenant unions, and neighborhoods where people trust each other and act together see less violence."
 ~#proof: "Sampson, Raudenbush, and Earls 1997 on collective efficacy; Seligman on block clubs; Kropotkin and Spade on mutual aid; Robert, Sheeran, and Baiocchi on assemblies; Lawson on tenants."
 ~#door: "Read collective efficacy first, then the dossier for the role you already play."
 ~#audience: "neighbors, organizers, and students of local democracy"
 continuity: "Civic Roles | act together"
 cold_open: "Block clubs, mutual aid, assemblies, and tenant unions are how neighbors learn to trust each other and act together."
}

