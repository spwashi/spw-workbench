# Crew Crosswalk
#
# Six crew functions, convener, lead, second, keeper, carrier, and guardian, named across a film set, a podcast, a live stream, and a neighborhood.

#>communities_crew_crosswalk
#:layer #!reference
#:domain #!communities
#:form #!comparison
#:level #!foundation
#:review #!spot_checked
#:valence #!bone
#:era #!contemporary

^"emit"{
 ~#title: "Crew Crosswalk"
 ~#claim: "Film sets, podcasts, live streams, and neighborhoods all fill six functions: someone convenes, leads, seconds, keeps the record, carries the work out, and guards the people."
 ~#proof: "Cells name roles documented in the film, broadcast, streaming, and platform leaves; the script supervisor and the seconded motion are sourced here."
 ~#door: "Pick the column you work in, find your function, then read the same row in a column you do not know."
 ~#audience: "crews, hosts, and organizers who move between kinds of work"
 continuity: "Crew Crosswalk | six functions"
 cold_open: "A film set, a podcast, a stream, and a block meeting all run on the same six functions, under different names."
}

