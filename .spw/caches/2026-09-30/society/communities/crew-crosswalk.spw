^["matrix"]{
 columns: #[ film, podcast, live, community ]

 #>communities_crosswalk_convener
 ^["convener"]{
  gloss: "calls people together, sets the date, and decides who is in the room"
  film: "producer, with the unit production manager running the physical plan"
  podcast: "executive producer or the host who books guests"
  live: "the host who schedules the stream and invites co-hosts"
  community: "organizer, block captain, or the host of a death cafe"
 }
 #>communities_crosswalk_lead
 ^["lead"]{
  gloss: "holds the arc while the gathering runs and makes the calls that shape it"
  film: "director, who calls action and cut"
  podcast: "lead host, who keeps the arc and chapter pacing"
  live: "the host on camera"
  community: "chair or facilitator of the meeting"
 }
 #>communities_crosswalk_second
 ^["second"]{
  gloss: "stands beside the lead or the person served, backs them, and takes over the logistics"
  film: "first assistant director, who runs the floor for the director"
  podcast: "co-host, who stands in for the listener"
  live: "co-host or guest in a shared round"
  community: "the member who seconds a motion; a doula or peer beside one person"
 }
 #>communities_crosswalk_keeper
 ^["keeper"]{
  gloss: "keeps the record so the work can be checked, matched, or remembered"
  film: "script supervisor for continuity; second assistant camera for camera reports"
  podcast: "producer who marks chapters live"
  live: "whoever keeps the replay and the clip times"
  community: "secretary who takes minutes; elder, oral historian, or garden steward"
 }
 #>communities_crosswalk_carrier
 ^["carrier"]{
  gloss: "carries the work or the word beyond the room"
  film: "production assistants on set; distributor and publicist after delivery"
  podcast: "the feed, the distributor, and listeners who share"
  live: "clippers, and the host who sends a raid to a peer's channel"
  community: "phone-tree caller, community health worker, storyteller, muralist"
 }
 #>communities_crosswalk_guardian
 ^["guardian"]{
  gloss: "protects the people in the room and can stop the work to do it"
  film: "first assistant director and department heads on safety; intimacy coordinator for intimate scenes"
  podcast: "producer or editor who checks consent before release"
  live: "moderators the host appoints, with platform tools"
  community: "tenant union steward, harm reduction worker, sergeant at arms"
 }
}

^["anchoring_facts"]{
 #>communities_crosswalk_continuity
 ^["script_supervisor"]{
  #:claim #!settled
  statement: "On a film set the script supervisor records continuity for each take, so editors can match action, props, and dialogue across shots filmed hours or weeks apart."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_miller_1999"
 }
 #>communities_crosswalk_seconding
 ^["seconded_motion"]{
  #:claim #!settled
  statement: "Under Robert's Rules of Order, most motions need a second from another member before the assembly takes them up, which shows at least two people want the question discussed."
  source: ~"../../registries/sources/language-and-communities.spw#src_lang_roberts_rules_2020"
  as_of: "12th edition, 2020"
 }
 cut_call: ~"../../making/film/set-operations-and-crew.spw#film_set_cut_call"
 intimacy: ~"../../making/film/intimacy-coordination.spw#film_intimacy_role"
 run_sheet_roles: ~"../../making/broadcast/episode-run-sheet.spw#broadcast_run_sheet"
}

^["reading"]{
 #>communities_crosswalk_reading
 ^["why_six"]{
  #:claim #!interpretive
  statement: "Any gathering that must happen again needs someone to call it, hold it, back it, record it, carry it out, and protect it, so the six functions recur under local names."
  ~#say(every crew calls, holds, backs, keeps, carries, and guards)
  ^["limits"]{
   holds: "crews and groups that meet more than once and care who comes back"
   fails: "small crews fold several functions into one person, and a one-off crowd may fill none of them"
  }
 }
 #>communities_crosswalk_overload
 ^["role_overload"]{
  #:claim #!interpretive
  statement: "When one person holds lead, keeper, and guardian at once, the guardian function is the one most likely to slip, because it acts only when something goes wrong."
 }
}

#>communities_crosswalk_moderator_q
?["Is a chat moderator the first assistant director of a stream?"]{
 #:depth #!social ~#lens(production cadence)
 #:claim #!speculative
 ~#hypothesis: "Streams whose moderators also keep time and cue segments run closer to their planned schedule than streams whose moderators only remove messages."
 breaks: "a first assistant director is usually paid crew, often under a guild agreement, with authority over the floor; a moderator is often an unpaid viewer acting at the host request"
 !probe{ "interview hosts about what their moderators do besides removing messages, and sort the answers by crosswalk function" =id[p_lang_communities_moderator_ad] =kind[interview] }
 ~"./crew-crosswalk.spw#communities_crosswalk_guardian" ~#neighbor(nearest)
}

#>communities_crosswalk_keeper_q
?["Which function does a small crew drop first?"]{
 #:depth #!social ~#lens(social fabric)
 #:claim #!speculative
 ~#hypothesis: "Crews of three or fewer drop the keeper function before any other, so their second meeting starts from memory instead of a record."
 !probe{ "ask small crews and new block groups who kept notes at their first three meetings" =id[p_lang_communities_dropped_function] =kind[field] }
 ~"./crew-crosswalk.spw#communities_crosswalk_keeper" ~#neighbor(nearest)
}
