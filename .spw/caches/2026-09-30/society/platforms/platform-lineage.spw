# Live Platform Lineage
#
# From radio call-in and public access to Justin.tv, Twitch, Periscope, Musical.ly, and TikTok LIVE: each rung moved the audience closer to the controls.

#>live_platforms_lineage
#:layer #!reference
#:domain #!live_platforms
#:form #!timeline
#:level #!intro
#:review #!sourced
#:valence #!bonk
#:era #!modern

^"emit"{
 ~#title: "Live Platform Lineage"
 ~#claim: "Live platforms grew from audiences that could call in, to audiences that could program a channel, to audiences that chat, gift, and steer a stream in real time."
 ~#proof: "Dated rungs from public access law, the Justin.tv to Twitch spin-off, Periscope, and the Musical.ly merger into TikTok, each linked to a source."
 ~#door: "Read the room states next, then the Twitch Plays Pokemon case."
 ~#audience: "readers new to live streaming history"
 continuity: "Live Platform Lineage | real time"
 cold_open: "Audiences went from calling in to steering a stream in real time."
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["edges"]{
 needs: [ ~"../../record/carriers/digital/streaming-and-files.spw#media_carriers_streaming" ]
 feeds: [ ~"./live-platform-mechanics.spw#live_platforms_mechanics" ]
 see: [ ~"../communities/semiotic-charge.spw#communities_semiotic_charge" ]
}

^["concepts"]{
 primary: [ #audience_participation, #virtual_gift ]
 transfers: [ #parallel_input, #dated_receipt ]
 tensions: [ #platform_dependence ]
}

^["ladder"]{
 ^["broadcast_era"]{
  #>live_platforms_lineage_call_in
  ^["call_in"]{
   #:claim #!settled
   statement: "Talk radio that put listener telephone calls on the air made the audience audible to itself; a screener chose who reached the host."
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_douglas_1999"
   era: "mid twentieth century onward"
  }
  #>live_platforms_lineage_public_access
  ^["public_access"]{
   #:claim #!settled
   statement: "US public access television began with local experiments in 1968, and a 1972 FCC order required access channels in the top 100 cable markets."
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_wiki_public_access"
   credit: "George Stoney, Red Burns, and Sidney Dean built much of the practice; Canadian community media is a further root to verify"
  }
  #>live_platforms_lineage_cable_act
  ^["cable_act"]{
   #:claim #!settled
   statement: "The Supreme Court struck the FCC access rule in 1979; the 1984 Cable Act instead let franchise authorities require public, educational, and government channels."
   sources: [ ~"../../registries/sources/creators-and-platforms.spw#src_creator_midwest_video_1979", ~"../../registries/sources/creators-and-platforms.spw#src_creator_cable_act_1984" ]
   ^["limits"]{
    holds: "US cable franchises"
    fails: "community television elsewhere followed national rules and often other funding"
   }
  }
 }
 ^["streaming_era"]{
  #>live_platforms_lineage_afreeca
  ^["afreeca"]{
   #:claim #!settled
   statement: "AfreecaTV in South Korea opened as a beta in May 2005 and took its name in March 2006; its independent hosts are called broadcasting jockeys, BJs; it relaunched as SOOP in 2024."
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_wiki_afreeca"
   verify: "the year its virtual gift currency began"
  }
  #>live_platforms_lineage_justin_tv
  ^["justin_tv_to_twitch"]{
   #:claim #!settled
   statement: "Justin.tv launched in 2007; its gaming section spun off as TwitchTV in public beta on 2011-06-06; Justin.tv closed on 2014-08-05 and Amazon bought Twitch on 2014-08-25."
   reads: %[creator.twitch.amazon_price_musd]
   sources: [ ~"../../registries/sources/creators-and-platforms.spw#src_creator_wiki_twitch", ~"../../registries/sources/creators-and-platforms.spw#src_creator_taylor_2018" ]
  }
  #>live_platforms_lineage_bits
  ^["bits"]{
   #:claim #!settled
   statement: "Twitch added Cheering with Bits, a purchased in-site currency spent as animated emotes, in June 2016."
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_wiki_twitch"
  }
  #>live_platforms_lineage_youtube_live
  ^["youtube_live"]{
   #:claim #!settled
   statement: "YouTube staged a one-time live event in November 2008 and replaced its YouTube Live channel with a permanent live-streaming section in April 2011."
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_wiki_youtube_live"
  }
 }
 ^["mobile_era"]{
  #>live_platforms_lineage_periscope
  ^["periscope"]{
   #:claim #!settled
   statement: "Twitter acquired Periscope in January 2015 before launch; it launched on 2015-03-26 after Meerkat drew attention at South by Southwest, and left the app stores on 2021-03-31."
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_wiki_periscope"
  }
  #>live_platforms_lineage_musically
  ^["musically"]{
   #:claim #!settled
   statement: "Musical.ly, founded in Shanghai by Alex Zhu and Luyu Yang, launched in August 2014 and opened the Live.ly streaming app at VidCon on 2016-07-24."
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_wiki_musically"
  }
  #>live_platforms_lineage_merger
  ^["merger"]{
   #:claim #!settled
   statement: "ByteDance bought Musical.ly in November 2017 and merged it into TikTok on 2018-08-02, consolidating accounts into one app."
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_wiki_musically"
  }
  #>live_platforms_lineage_douyin
  ^["douyin_and_tiktok"]{
   #:claim #!settled
   statement: "ByteDance launched Douyin in China on 2016-09-20 and TikTok for international markets in September 2017."
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_wiki_tiktok"
  }
  #>live_platforms_lineage_tiktok_live
  ^["tiktok_live"]{
   #:claim #!settled
   statement: "TikTok LIVE pairs a host gate on age and followers with a gift economy in which viewers buy Coins, send Gifts, and hosts accrue Diamonds they can withdraw."
   reads: %[creator.live.host_min_age_years, creator.live.gift_min_age_years]
   source: ~"../../registries/sources/creators-and-platforms.spw#src_creator_tiktok_virtual_items"
   ^["limits"]{
    holds: "the policy page as read on 2026-10-01"
    fails: "gate values vary by region and change; the host cells stay verify"
   }
  }
 }
 #>live_platforms_lineage_reading
 ^["reading"]{
  #:claim #!interpretive
  statement: "Read as one ladder, each rung moves a control toward the audience: screeners pick callers, access lets citizens program, chat lets crowds steer, gifts let crowds pay to be seen."
 }
}

^["origins"]{
 korea: "AfreecaTV hosted broadcaster-centered live channels a decade before TikTok LIVE; when its tipping currency began is a verify cell"
 china: "showroom live streaming and livestream selling grew on Chinese platforms; see the Singles Day case for commerce at scale"
 credit_note: "the US timeline above is one strand; the Korean and Chinese strands are named so the ladder does not read as US-first"
 commerce_case: ~"../markets/singles-day-live-commerce.spw#markets_singles_day"
}

#>live_platforms_lineage_screener_q
?["Is a chat moderator the call-in screener moved after the microphone?"]{
 #:depth #!historical ~#lens(historical layer)
 #:claim #!speculative
 ~#hypothesis: "Gatekeeping moved from before air to after posting, so moderation shifted from choosing voices to removing them."
 breaks: "a screener sees one caller at a time before broadcast; a chat moderator acts on many messages already visible"
 !probe{ "compare published screener practice with moderator logs from one Twitch channel" =id[p_creator_lineage_screener] =kind[lit] }
 ~"./platform-lineage.spw#live_platforms_lineage_call_in" ~#neighbor(nearest)
}

#>live_platforms_lineage_value_q
?["Did the price paid for Twitch reflect the audience or the archive of play?"]{
 #:depth #!social ~#lens(market flow)
 #:claim #!speculative
 ~#hypothesis: "The acquisition priced a live audience that returns daily more than a library of past streams."
 !probe{ "read 2014 acquisition coverage for the stated rationale" =id[p_creator_lineage_twitch_value] =kind[lit] }
 $%[creator.twitch.amazon_price_musd]
 ~"./platform-lineage.spw#live_platforms_lineage_justin_tv" ~#neighbor(nearest)
}
