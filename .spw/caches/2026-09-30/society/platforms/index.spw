# Live Platforms
#
# Live streaming platforms as dated receipts: lineage, room states, money, moderation, and one famous crowd.

#>live_platforms_index
#:layer #!reference
#:domain #!live_platforms
#:form #!index
#:level #!practitioner
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Live Platforms"
 ~#claim: "Live platforms change their rules faster than reference works, so this branch records them as dated receipts beside a stable lineage and one well-documented case."
 ~#proof: "Every gate, gift value, and share is a registry cell with as_of and region; lineage rungs and the case cite sources."
 ~#door: "Start with the lineage, then the room states; read the receipt before repeating any gift figure."
 ~#audience: "readers studying live streaming as an institution"
 continuity: "Live Platforms | dated receipts"
 cold_open: "Live platforms move fast, so we keep them as dated receipts."
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["tree"]{
 lineage: ~"./platform-lineage.spw"
 mechanics: ~"./live-platform-mechanics.spw"
 monetization: ~"./monetization-receipt.spw"
 moderation: ~"./moderation-and-eligibility.spw"
 twitch_plays: ~"./twitch-plays-pokemon.spw"
}

^["bundle"]{
 ={
  ~"./platform-lineage.spw#live_platforms_lineage"
  ~"./live-platform-mechanics.spw#live_platforms_mechanics"
  ~"./monetization-receipt.spw#live_platforms_monetization"
  ~"./moderation-and-eligibility.spw#live_platforms_moderation"
  ~"./twitch-plays-pokemon.spw#live_platforms_twitch_plays"
 }
}

^["order"]{
 pmest: "domain live_platforms; matter in each leaf concepts; energy by form from timeline to dossier; time from modern to current"
 reading: << "lineage" ; "mechanics" ; "monetization" ; "moderation" ; "twitch plays" >>
}

^["currency"]{
 rule: "a platform figure without as_of and region is a question, not a fact"
 cells: "gates, gift prices, rates, and shares live in the creators-and-platforms quantities registry"
 review: "verify cells are re-read against current help pages before any republish"
}

^["gaps"]{
 contrasts: "Twitch, YouTube Live, and Kick comparison rows so TikTok receipts have contrasts"
 earnings: "sourced creator earnings and usage figures stay empty rather than estimated"
 regions: "a region axis is not declared in this cut; region lives in cell qualifiers"
}
