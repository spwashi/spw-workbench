# Society
#
# How people price, organize, serve, gather, and broadcast: economies, organizations, markets, platforms, and communities, with the disciplines this cut still lacks named as gaps.

#>society_index
#:layer #!reference
#:domain #!society
#:form #!index
#:level #!intro
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Society"
 ~#claim: "Economies, organizations, markets, platforms, and communities are read here as institutions with rules, roles, and receipts, each claim carrying its evidence status."
 ~#proof: "Branch leaves link registry sources for keystones; market and platform numbers are dated cells with publisher and as_of."
 ~#door: "Start with the glossary, then the economics core; read market numbers only after the report-reading protocol."
 ~#audience: "readers meeting economics, management, and platform studies for the first time"
 continuity: "Society | rules and receipts"
 cold_open: "Every market, office, and stream runs on rules and receipts, and this branch shows you where each one stops holding."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["tree"]{
 glossary: ~"./society-glossary.spw"
 economics: ~"./economics/index.spw"
 management: ~"./management/index.spw"
 markets: ~"./markets/index.spw"
 platforms: ~"./platforms/index.spw"
 communities: ~"./communities/index.spw"
}

^["bundle"]{
 ={
  ~"./society-glossary.spw#society_glossary"
  ~"./economics/index.spw#economics_index"
  ~"./management/index.spw#management_index"
  ~"./markets/index.spw#markets_index"
  ~"./platforms/index.spw#live_platforms_index"
  ~"./communities/index.spw#communities_index"
 }
}

^["order"]{
 pmest: "personality by domain: economics, management, markets, live_platforms, communities; matter in each leaf concepts frame; energy by form; time by era where a leaf declares one"
 reading: << "glossary" ; "economics" ; "management" ; "markets" ; "platforms" ; "communities" >>
 region: "no region axis is declared; region lives in claim qualifiers and cell at strings"
}

^["ladder"]{
 ^["intro"]{
  rung: "words and roles before models"
  stops: [ ~"./society-glossary.spw#society_glossary", ~"./communities/index.spw#communities_index" ]
 }
 ^["foundation"]{
  rung: "optimization, equilibrium, and service as a designed process"
  stops: [ ~"./economics/micro-and-macro-core.spw#economics_core", ~"./management/service-operations.spw#management_service_operations", ~"./markets/singles-day-live-commerce.spw#markets_singles_day" ]
  needs: "school algebra and a first course in probability"
 }
 ^["advanced"]{
  rung: "identification and pricing under capacity"
  stops: [ ~"./economics/econometrics-and-data.spw#economics_econometrics", ~"./management/revenue-management.spw#management_revenue", ~"./markets/market-hooks.spw#markets_hooks" ]
  needs: "regression and constrained optimization"
 }
 ^["graduate"]{
  rung: "theorems with their hypotheses, schools with their dates, estimators with their assumptions"
  stops: [ ~"./economics/graduate-micro-theory.spw#economics_grad_micro", ~"./economics/graduate-macro.spw#economics_grad_macro", ~"./economics/graduate-econometrics.spw#economics_grad_econometrics" ]
  needs: "real analysis and linear algebra"
 }
 ^["practitioner"]{
  rung: "reading a dated number and knowing which cell it moves"
  stops: [ ~"./markets/reading-market-reports.spw#markets_reading_reports", ~"./markets/market-probe-battery.spw#markets_probe_battery", ~"./markets/media-market-receipts.spw#markets_media_receipts", ~"./platforms/index.spw#live_platforms_index" ]
 }
}

^["gaps"]{
 #>society_gap_disciplines
 ^["disciplines"]{
  missing: [
   "law, including contract, labor, and competition law",
   "political science and public choice",
   "sociology and anthropology, which would give community roles a disciplinary home"
  ]
  neighbors: "communities and management leaves point here until a sourced surface exists"
 }
 #>society_gap_fields
 ^["fields"]{
  missing: [
   "industrial organization, where format wars and platform pricing would land",
   "labor economics, where turnaround rules, tip credits, and adjunct pay would land",
   "behavioral economics, which has typed edges into cognition but no surface of its own"
  ]
  neighbors: "micro-and-macro core, revenue management, and the cognition branch"
 }
 #>society_gap_math
 ^["math"]{
  missing: [
   "EMSR-b and overbooking derivations, held as gap cells in revenue management",
   "tip and wage law by state, held as a gap cell in leadership and ethics"
  ]
 }
}

^["stances"]{
 #:claim #!interpretive
 economics: "efficiency is a property of an allocation, not a verdict on it; the economics index carries that note"
 management: "hospitality is skilled labor with dignity owed in both directions; the management index carries that note"
 markets: "a market number is a hook to check, never a fact to repeat; the markets index carries that note"
}
