# Markets
#
# Market research as hooks rather than facts: a protocol for reading reports, a battery of dated probes, a registry of hooks into other classes, the receipts themselves, and one live commerce case.

#>markets_index
#:layer #!pragmatics
#:domain #!markets
#:form #!index
#:level #!practitioner
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Markets"
 ~#claim: "A market number is a hook to check, not a fact to repeat: each one names its publisher, period, method, and the cell it would change."
 ~#proof: "Receipts cite Edison, Nielsen, IAB, Pew, AAP, Circana, and Comscore by release; unread values stay empty with status verify."
 ~#door: "Read the report protocol first, then the probes, then the receipts, and only then the hooks."
 ~#audience: "writers, producers, and analysts who cite media and commerce numbers"
 continuity: "Markets | hook to check"
 cold_open: "Treat every market number as a hook to check, with its publisher and date beside it."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #pass }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 replaces: "the dropped raw podcasting market-research file, which inverted podcast platform shares against Edison and called RSS a W3C standard; nothing here is copied from it"
}

^["tree"]{
 reading_reports: ~"./reading-market-reports.spw"
 probe_battery: ~"./market-probe-battery.spw"
 hooks: ~"./market-hooks.spw"
 media_receipts: ~"./media-market-receipts.spw"
 singles_day: ~"./singles-day-live-commerce.spw"
}

^["bundle"]{
 ={
  ~"./reading-market-reports.spw#markets_reading_reports"
  ~"./market-probe-battery.spw#markets_probe_battery"
  ~"./market-hooks.spw#markets_hooks"
  ~"./media-market-receipts.spw#markets_media_receipts"
  ~"./singles-day-live-commerce.spw#markets_singles_day"
 }
}

^["order"]{
 reading: << "reading reports" ; "probe battery" ; "media receipts" ; "hooks" ; "singles day" >>
 forms: "protocol, probe battery, registry, registry, dossier"
 cells: "every number lives in the economy and markets quantities registry; leaves read handles"
}

#>markets_stance
^["stance"]{
 #:claim #!interpretive
 statement: "A market figure is a dated hook: it says who measured what, when, and how, and it earns reuse only after a reader checks those four things."
 decay: "media shares move monthly; a receipt older than its publisher cadence is history, not news"
 people: "reports describe audiences in aggregate; this branch never ranks or profiles a person"
}

^["gaps"]{
 #>markets_gap_coverage
 ^["coverage"]{
  missing: [
   "music streaming and recorded music revenue",
   "video game market reports",
   "markets outside the United States beyond the Singles Day case"
  ]
 }
}
