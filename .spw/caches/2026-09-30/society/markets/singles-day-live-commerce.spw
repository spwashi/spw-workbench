^["dossier"]{
 #>markets_singles_day_origin
 ^["origin"]{
  #:claim #!contested
  statement: "Singles Day is commonly traced to students at Nanjing University in the 1990s, often dated to 1993, as a celebration of being single on 11 November for its four ones."
  sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_wiki_singles_day", ~"../../registries/sources/economy-and-markets.spw#src_econ_wiki_daniel_zhang" ]
  account: "traditional account; one encyclopedia page tells a 1993 Nanjing University dormitory anecdote, another says only the 1990s among university students"
  disagreement: "popular accounts differ on year and setting, and neither page cites a scholarly or primary source"
 }
 #>markets_singles_day_alibaba
 ^["alibaba_2009"]{
  #:claim #!settled
  statement: "In 2009 Alibaba began using the day as a 24-hour online sale on Taobao Mall, later Tmall; Daniel Zhang, then running Taobao operations, launched it."
  sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_wiki_singles_day", ~"../../registries/sources/economy-and-markets.spw#src_econ_wiki_daniel_zhang", ~"../../registries/sources/economy-and-markets.spw#src_econ_wiki_alibaba" ]
  roles: "Zhang became Taobao chief operating officer in 2008, Tmall president in 2011, and Alibaba Group CEO in 2015; Jack Ma was group CEO until 2013, and Taobao Mall opened in April 2008"
 }
 #>markets_singles_day_scale
 ^["scale"]{
  #:claim #!settled
  statement: "Alibaba reported 268.4 billion yuan of gross merchandise volume for 2019 and 498.2 billion for 2020; in 2022 it stopped publishing a total."
  reads: %[econ.singles.alibaba_gmv_2019_byuan, econ.singles.alibaba_gmv_2020_byuan]
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_wiki_singles_day"
  ^["limits"]{
   holds: "as company-reported gross merchandise volume"
   fails: "as revenue or net sales; returns and cancellations are not netted out"
   window: "the cited page does not say which sale days each total covers; read a primary Alibaba release before comparing years"
  }
 }
 #>markets_singles_day_viya
 ^["streamer_sellers"]{
  #:claim #!settled
  statement: "Viya, Huang Wei, joined the Taobao livestreaming program in 2016 among its first channels and was dubbed the queen of livestreaming for selling almost any product."
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_wiki_viya"
  reported_sales: %[econ.singles.viya_2021_sales_byuan]
  sales_note: "the encyclopedia ties this total to Singles Day 2021; the sale day needs a primary report"
 }
 #>markets_singles_day_lineage
 ^["tv_shopping_lineage"]{
  #:claim #!settled
  statement: "Selling on air predates streams: Paxson and Speer started a local cable shopping channel in Florida in 1982 and took it national as the Home Shopping Club in 1985."
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_wiki_hsn"
  difference: "a stream adds live chat, instant checkout, and a host who answers buyers by name"
 }
}

#>markets_singles_day_regulation
^["regulation_2021"]{
 #>markets_singles_day_antitrust
 ^["alibaba_fine"]{
  #:claim #!settled
  statement: "In April 2021 the State Administration for Market Regulation fined Alibaba about 2.8 billion US dollars for anticompetitive practices, about 12 percent of its 2020 net profit."
  reads: %[econ.singles.alibaba_fine_2021_busd]
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_wiki_alibaba"
  context: "in November 2020 the Ant Group listing had been halted"
 }
 #>markets_singles_day_measures
 ^["live_marketing_measures"]{
  #:claim #!settled
  statement: "In April 2021 the Cyberspace Administration of China and six other departments issued trial measures for online live streaming marketing, effective in May 2021."
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_cac_2021_livestream"
  flag: "named from the writer; the text was not fetched in this pass, so duties under the measures are not listed"
 }
 #>markets_singles_day_tax
 ^["viya_penalty"]{
  #:claim #!settled
  statement: "In December 2021 authorities fined Viya 1.34 billion yuan for misreported income in 2019 and 2020, and her social media accounts were taken down."
  reads: %[econ.singles.viya_fine_2021_byuan]
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_wiki_viya"
 }
}

^["mechanics"]{
 status: "verify; interface names come from the raw file and change by platform and year"
 shop_entry: "a shopping bag icon opens the product list while the stream keeps playing"
 pinned_card: "the host pins the product being shown so viewers can buy it in one tap"
 timed_offer: "a countdown coupon or a limited quantity creates a short buying window"
 attribution: "orders carry a session tag so the host or affiliate can be credited"
}

^["try"]{
 #>markets_singles_day_try_log
 ^["log_one_stream"]{
  materials: [ "a phone or computer", "a notes file with four columns: time, product, price said, disclosure shown" ]
  steps: << "open one public live selling stream" ; "log each product pin for fifteen minutes" ; "note each price the host says aloud" ; "note whether an ad or affiliate label appears" ; "compare your log with the mechanics notes" >>
  time: .{ n: 20, unit: "minutes" }
  safety: "do not buy anything for the exercise, and do not record names of other viewers"
  shows: ~"./singles-day-live-commerce.spw#markets_singles_day_viya"
 }
}

#>markets_singles_day_returns_q
?["Do in-stream impulse purchases come back more often than store-page purchases?"]{
 #:depth #!social ~#lens(market flow)
 #:claim #!speculative
 ~#hypothesis: "Items bought inside a live stream are returned more often than the same items bought from a store page."
 !probe{ "find a seller or study that reports return rates by sales channel for the same products" =id[p_econ_singles_returns] =kind[lit] }
 $%[econ.singles.alibaba_gmv_2019_byuan]
 ~"./singles-day-live-commerce.spw#markets_singles_day_scale" ~#neighbor(nearest)
}

#>markets_singles_day_crier_q
?["Is a live seller closer to a market crier than to a catalog?"]{
 #:depth #!historical ~#lens(historical layer)
 #:claim #!speculative
 ~#hypothesis: "Live sellers use the crier moves of naming a price aloud, answering the crowd, and calling a deadline far more than catalog copy does."
 !probe{ "code a sample of live selling transcripts and catalog pages for spoken price, crowd reply, and deadline calls" =id[p_econ_singles_crier] =kind[census] }
 breaks: "a crier sold to people standing in one place; a stream sells to a scattered audience the platform selects"
 ~"./singles-day-live-commerce.spw#markets_singles_day_lineage" ~#neighbor(nearest)
}
