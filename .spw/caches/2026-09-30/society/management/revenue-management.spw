 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5"
 lineage: #[ ".spw/caches/university-education/hospitality-and-management/revenue-management-and-dynamic-pricing.spw" ]
 ^["receipts"]{
