# Service Operations
#
# A guest stay as a service blueprint and a state machine: front stage and backstage, fail points and their guards, waits and queues, and recovery when something breaks.

#>management_service_operations
#:layer #!pragmatics
#:domain #!management
#:form #!protocol
#:level #!foundation
#:review #!sourced
#:valence #!bone

^"emit"{
 ~#title: "Service Operations"
 ~#claim: "A service is a designed process with a visible front stage, a hidden backstage, and known fail points, and recovery after a failure rarely beats getting it right."
 ~#proof: "Shostack named blueprints and fail points; Bitner, Hochschild, and Parasuraman, Zeithaml, and Berry framed setting, emotional labor, and quality gaps; McCollough and de Matos tested the recovery paradox."
 ~#door: "Walk the journey states, blueprint a cafe visit with the kit, then cross to queueing in industrial engineering."
 ~#audience: "hospitality and service design students, and anyone running a front desk"
 continuity: "Service Operations | fail points"
 cold_open: "Every stay runs through states with fail points, and fixing a failure rarely beats never having it."
}

