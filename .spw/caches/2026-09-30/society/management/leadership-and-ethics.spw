# Leadership and Ethics
#
# Hospitality leadership read through cases: servant leadership, frontline authority at Ritz-Carlton, staff conduct at the Taj in 2008, turnover, child protection, and food donation, with tip law left as a visible gap.

#>management_leadership
#:layer #!reference
#:domain #!management
#:form #!dossier
#:level #!foundation
#:review #!spot_checked
#:valence #!honk

^"emit"{
 ~#title: "Leadership and Ethics"
 ~#claim: "Hospitality leadership is best judged in cases, where frontline authority, staff safety, and fair pay meet; the evidence for servant leadership is promising but mostly correlational."
 ~#proof: "Cases cite Greenleaf and the Eva review, Michelli on Ritz-Carlton, Deshpande and Raina on the Taj, BLS JOLTS, The Code, and the Fair Labor Standards Act."
 ~#door: "Read the cases in order, run the authority card exercise, then check the tip law gap before generalizing."
 ~#audience: "hospitality managers, students, and anyone designing frontline work"
 continuity: "Leadership and Ethics | frontline authority"
 cold_open: "Read leadership through real cases, where frontline authority, staff safety, and fair pay are tested."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5"
 lineage: #[ ".spw/caches/university-education/hospitality-and-management/organizational-leadership-and-hospitality-ethics.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #pass }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the industry turnover figure of more than 70 percent had no source; it is a verify cell tied to BLS JOLTS",
  "the 25 to 35 percent energy savings and a named food waste product had no source and are dropped",
  "the raw empowerment wonder asserted that frontline authority lowers total payouts; it is now a speculative probe",
  "The Code is credited to ECPAT Sweden with UNWTO and Swedish tour operators, developed after the 1996 World Congress, with its six criteria read from the Code site",
  "tip and wage law, absent from the raw file, is added as a federal floor plus a visible state gap"
 ]
}

^["edges"]{
 needs: [ ~"./service-operations.spw#management_service_ops_emotional_labor" ]
 see: [ ~"../../registries/quantities/economy-and-markets.spw#q_econ_hotel", ~"../../making/film/labor-agreements-ledger.spw#film_labor_ledger" ]
}

^["concepts"]{
 primary: [ #servant_leadership, #frontline_authority, #accountability ]
 transfers: [ #emotional_labor, #virtual_gift, #dated_receipt ]
 tensions: [ #tipping ]
}

^["dossier"]{
 #>management_leadership_servant
 ^["servant_leadership"]{
  #:claim #!emerging
  statement: "Greenleaf proposed that leaders serve the people they lead; a 2019 review found positive associations with follower outcomes but warned that most studies are cross-sectional."
  sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_greenleaf_1977", ~"../../registries/sources/economy-and-markets.spw#src_econ_eva_2019" ]
  ^["limits"]{
   holds: "as an association in survey studies"
   fails: "as proof that adopting the style causes better service"
  }
 }
 #>management_leadership_ritz
 ^["ritz_carlton"]{
  #:claim #!settled
  statement: "Michelli described Ritz-Carlton letting any employee spend up to 2000 dollars per guest per incident to fix a problem without asking a manager."
  reads: %[econ.hotel.ritz_empowerment_usd]
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_michelli_2008"
  credo: "Horst Schulze framed staff as ladies and gentlemen serving ladies and gentlemen"
  ^["limits"]{
   holds: "the policy as described in 2008"
   fails: "current policy and how often staff use the authority are not reported here"
  }
 }
 #>management_leadership_taj
 ^["taj_2008"]{
  #:claim #!settled
  statement: "During the November 2008 Mumbai attacks, staff of the Taj Mahal Palace hotel helped guests escape at great risk, and some died; Deshpande and Raina traced the conduct to hiring and training."
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_deshpande_raina_2011"
  care: "this is a case of staff courage and loss, not a model of what any employer may ask of workers"
 }
 #>management_leadership_turnover
 ^["turnover"]{
  #:claim #!settled
  statement: "The BLS Job Openings and Labor Turnover Survey publishes hires, quits, and separations by industry, including accommodation and food services, monthly and as annual rates."
  reads: %[econ.hotel.lodging_separation_rate_pct]
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_bls_jolts"
  value_note: "no rate is printed until it is read from a dated JOLTS release"
 }
 #>management_leadership_child_protection
 ^["the_code"]{
  #:claim #!settled
  statement: "The Code, developed by ECPAT Sweden with UNWTO and Swedish tour operators after the 1996 World Congress against child sexual exploitation, commits members to six criteria, including staff training and annual reporting."
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_the_code"
  scope: "hotels train front desk and housekeeping staff to recognize and report suspected exploitation through set channels"
 }
 #>management_leadership_food_donation
 ^["food_donation"]{
  #:claim #!settled
  statement: "The Bill Emerson Good Samaritan Food Donation Act of 1996 shields US donors of apparently wholesome food from civil and criminal liability except for gross negligence or intentional misconduct."
  source: ~"../../registries/sources/economy-and-markets.spw#src_econ_emerson_act_1996"
  as_of: "2026-10-02; later amendments widened who may donate and how"
 }
}

^["gap_cells"]{
 #>management_leadership_gap_tips
 ^["tip_law"]{
  #:claim #!settled
  statement: "Federal law lets employers pay tipped workers a cash wage of 2.13 dollars an hour if tips make up the minimum wage, and bars employers from keeping workers tips."
  reads: %[econ.hotel.flsa_tipped_cash_wage_usd]
  sources: [ ~"../../registries/sources/economy-and-markets.spw#src_econ_flsa_203m", ~"../../registries/sources/economy-and-markets.spw#src_econ_dol_fs15" ]
  as_of: "2026-10-02"
  status: "gap"
  owed: "a dated table of state cash wages and tip credits; several states allow no tip credit at all"
 }
}

^["try"]{
 #>management_leadership_try_card
 ^["authority_card"]{
  materials: [ "index cards", "a pen", "three guest problems from your own work or reading" ]
  steps: << "write one guest problem per card" ; "write what a frontline worker may do without asking anyone" ; "write the spending limit and who reviews it later" ; "trade cards with a partner and find one gap" >>
  time: .{ n: 20, unit: "minutes" }
  safety: "none worth naming; leave out real guest names"
  shows: ~"./leadership-and-ethics.spw#management_leadership_ritz"
 }
}

#>management_leadership_authority_q
?["Does frontline spending authority lower what a hotel pays out per complaint?"]{
 #:depth #!social ~#lens(social fabric)
 #:claim #!speculative
 ~#hypothesis: "Properties that give frontline staff spending authority pay less per resolved complaint than properties that route every remedy through a manager."
 !probe{ "compare complaint logs and remedy costs across properties with and without frontline authority over one year" =id[p_econ_leadership_authority] =kind[field] }
 $%[econ.hotel.ritz_empowerment_usd]
 ~"./leadership-and-ethics.spw#management_leadership_ritz" ~#neighbor(nearest)
}

#>management_leadership_tip_q
?["Is a restaurant tip closer to a live stream gift than to a price?"]{
 #:depth #!social ~#lens(market flow)
 #:claim #!speculative
 ~#hypothesis: "Tips, like live gifts, rise when the giver is seen by others and fall when the payment is private."
 !probe{ "compare tip shares for counter screens shown face up to the queue and face down" =id[p_econ_leadership_tip] =kind[field] }
 breaks: "a tip often makes up a legal wage floor; a live gift is optional income split with a platform"
 ~"./leadership-and-ethics.spw#management_leadership_gap_tips" ~#neighbor(nearest)
}
