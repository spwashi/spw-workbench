# Management
#
# Hospitality and service management as designed processes: service operations, revenue management, food and beverage systems, and leadership, with one interpretive note on the dignity owed to the people who serve.

#>management_index
#:layer #!reference
#:domain #!management
#:form #!index
#:level #!foundation
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Management"
 ~#claim: "Hospitality management is four designed systems, service, pricing, food safety, and leadership, and each one stands on labor that deserves dignity."
 ~#proof: "Leaves cite Shostack, Littlewood, Kasavana and Smith, NACMCF, and Greenleaf; contested claims such as the recovery paradox and menu tricks carry their replications."
 ~#door: "Start with service operations, then revenue management, and read the leadership cases before any pricing tactic."
 ~#audience: "hospitality students, managers, and readers of service design"
 continuity: "Management | labor that deserves dignity"
 cold_open: "Behind every smooth stay is designed work and labor that deserves dignity, and this branch shows both."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5"
 lineage: #[ ".spw/caches/university-education/hospitality-and-management/taste.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #pass }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the raw dispatch table and roots are replaced by one tree",
  "the raw taste file spoke of a sacred, magical hospitality; the note keeps the dignity claim and drops the reverence",
  "the commensality wonder asserted oxytocin and parasympathetic mechanisms without a source; it is dropped",
  "the concierge memory wonder asserted brain encoding without a source; it is dropped",
  "the service recovery paradox, stated in the raw index as a loyalty law, is contested in service operations"
 ]
}

^["tree"]{
 service_operations: ~"./service-operations.spw"
 revenue_management: ~"./revenue-management.spw"
 food_and_beverage: ~"./food-and-beverage-systems.spw"
 leadership: ~"./leadership-and-ethics.spw"
}

^["bundle"]{
 ={
  ~"./service-operations.spw#management_service_operations"
  ~"./revenue-management.spw#management_revenue"
  ~"./food-and-beverage-systems.spw#management_food_beverage"
  ~"./leadership-and-ethics.spw#management_leadership"
 }
}

^["order"]{
 reading: << "service operations" ; "revenue management" ; "food and beverage" ; "leadership and ethics" >>
 forms: "protocol, comparison, ledger, dossier"
 bridges: "queueing to industrial engineering, price discrimination to the economics core, menu psychology to the replication ledger"
}

#>management_stance
^["stance"]{
 #:claim #!interpretive
 statement: "Hospitality is skilled work owed dignity in both directions; guest and worker meet as equals, and a design that hides labor backstage must not hide its cost."
 xenia: "the Greek norm of guest-friendship in the Homeric poems obliged a host to feed and shelter a stranger before asking a name"
 origins: "many traditions keep strong hospitality norms; this branch names them where a source does and avoids ranking them"
 source_for_xenia: ~"../../registries/sources/economy-and-markets.spw#src_econ_homer_wilson_2017"
 labor: "emotional labor, tips, and turnover are part of the product; the leadership leaf carries the evidence"
 voice: "the raw taste file said this as a hymn; the note keeps its substance and drops the reverence"
}

^["gaps"]{
 #>management_gap_law
 ^["law"]{
  missing: [
   "tip credit and tip pooling rules by state, held as a gap cell in leadership and ethics",
   "labor scheduling and predictive scheduling laws",
   "accessibility law for lodging and dining"
  ]
 }
 #>management_gap_methods
 ^["methods"]{
  missing: [
   "EMSR-b seat protection and overbooking derivations, held as gap cells in revenue management",
   "menu engineering beyond Kasavana and Smith, with only one alternative named"
  ]
 }
}
