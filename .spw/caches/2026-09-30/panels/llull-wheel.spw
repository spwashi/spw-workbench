# Llull Wheel
#
# Four rings drawn from the closed vocabulary, lens, class, probe kind, and era, turned by a fixed rule to generate question stems; every stem is a prompt to test, never a claim.

#>panel_llull_wheel
#:layer #!creative
#:domain #!panel
#:form #!probe_battery
#:level #!intro
#:review #!adversarial_checked
#:valence #!boon

^"emit"{
 ~#title: "Llull Wheel"
 ~#claim: "Turning rings of lens, class, probe kind, and era by a fixed rule yields question stems, each a prompt to test and none of them a finding."
 ~#proof: "The rings are the closed sets in the vocabulary; the device follows the rotating figures of Ramon Llull as Bonner describes them."
 ~#door: "Read one turn, ask what anchor it would update, then build your own paper wheel."
 ~#audience: "writers looking for a next question, streamers turning chat topics into prompts, and teachers"
 continuity: "Llull Wheel | a prompt to test"
 cold_open: "Turn the rings and you get a question, and every question here is a prompt to test, never a finding."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{
   event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #partial
   note: "forward ref to a planned graph idioms surface another package had not written yet"
  }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "turns and coverage confirmed; the purpose claim split into a settled clause and an interpretive one"
  }
  ^["r5"]{
   event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #partial
   note: "only the forward ref to the planned graph idioms surface remains"
  }
 }
 checked: "turns and coverage were computed by script from the ring order below on 2026-10-02"
}

^["edges"]{
 needs: [ ~"../record/information/reference-works-lineage.spw#information_science_lineage_llull" ]
 grounds: [ ~"../vocabulary.spw#cut_vocabulary" ]
 see: [ ~"../making/streaming/prompt-deck.spw#streaming_prompt_deck_llull" ]
}

^["concepts"]{
 primary: [ #combinatorial_prompt, #closed_vocabulary ]
 transfers: [ #prediction ]
 tensions: [ #false_analogy ]
}

^["origin"]{
 #>panel_llull_figures
 ^["figures"]{
  #:claim #!settled
  statement: "In the Ars brevis, Llull lettered his principles B to K; a fixed figure lists every pair, and a rotating figure of three circles combines them in threes, so a reader can read off questions."
  reads: %[prov.llull.alphabet_letter_count]
  source: ~"../registries/sources/provenance-and-reference.spw#src_prov_bonner_2007"
 }
 #>panel_llull_purpose
 ^["purpose"]{
  #:claim #!settled
  statement: "Llull meant the Art to argue for Christian doctrine with reasons that readers of other faiths could follow."
  source: ~"../registries/sources/provenance-and-reference.spw#src_prov_bonner_2007"
 }
 #>panel_llull_finding_truth
 ^["finding_truth"]{
  #:claim #!settled
  statement: "Llull named early versions an art of finding truth, the Ars compendiosa inveniendi veritatem, and applied the Art to every field of learning he knew."
  source: ~"../registries/sources/provenance-and-reference.spw#src_prov_bonner_2007"
 }
 #>panel_llull_inquiry_inside
 ^["inquiry_inside_doctrine"]{
  #:claim #!interpretive
  statement: "The Art was real inquiry, but its inquiry ran inside doctrine Llull held true."
 }
}

^["rings"]{
 lens: #[ "ecological zone", "molecular binding", "formal structure", "material grain", "curated collection", "living system", "signal path", "market flow", "social fabric", "historical layer", "bodily rhythm", "craft practice", "information flow", "energy budget", "semiotic charge", "production cadence" ]
 class: #[ formal, physical, living, language_and_mind, society, making, record, learning, spw ]
 probe_kind: #[ thought, lookup, calc, sim, census, lit, interview, field, build ]
 era: #[ deep_time, prehistory, ancient, classical, medieval, early_modern, industrial, modern, contemporary, current ]
 settings: "sixteen lenses, nine classes, nine probe kinds, and ten eras give 12960 settings"
}

^["turning_rule"]{
 #>panel_llull_rule
 ^["rule"]{
  turn: "turn n reads lens n mod 16, class 2n mod 9, probe kind 4n plus floor of n over 9, mod 9, and era 3n mod 10"
  slip: "the probe ring slips one place every nine turns, so every class meets every probe kind within 81 turns"
  coverage: "the rule repeats after 6480 turns, half the settings; adding one to the era index reaches the other half"
  check: "computed by script on 2026-10-02; recompute after any change to a ring"
 }
 sieve: [
  "keep a stem only if a writer can name one anchor it would update",
  "keep a stem only if a probe could come back with an answer that disappoints",
  "a kept stem enters the cut as a wonder block with a speculative status and a probe id"
 ]
}

^["turns"]{
 #>panel_llull_t0
 ^["t0"]{
  #:claim #!speculative
  setting: .{ lens: "ecological zone", class: #formal, probe: #thought, era: #deep_time }
  stem: "If mathematical ideas filled niches like species, which proofs would a thought experiment show surviving every change of notation, and which would die out?"
  updates: ~"../formal/mathematics/analysis-and-algebra-core.spw#mathematics_core"
 }
 #>panel_llull_t1
 ^["t1"]{
  #:claim #!speculative
  setting: .{ lens: "molecular binding", class: #living, probe: #census, era: #classical }
  stem: "Counting the plant and pollinator pairings a classical natural history names, how many still hold as tightly as a ligand in its receptor?"
  updates: ~"../living/plants/botany-core.spw#plant_science_botany"
 }
 #>panel_llull_t2
 ^["t2"]{
  #:claim #!speculative
  setting: .{ lens: "formal structure", class: #society, probe: #build, era: #industrial }
  stem: "Could a small build of an industrial work schedule as a state machine show where the formal structure breaks once workers improvise around it?"
  updates: ~"../society/management/service-operations.spw#management_service_operations"
 }
 #>panel_llull_t3
 ^["t3"]{
  #:claim #!speculative
  setting: .{ lens: "material grain", class: #record, probe: #sim, era: #current }
  stem: "Would a simulation of current storage media, layer by layer, predict which carrier in a home archive fails first when left alone?"
  updates: ~"../record/carriers/carrier-decay-and-fixity.spw#media_carriers_decay"
 }
 #>panel_llull_t4
 ^["t4"]{
  #:claim #!speculative
  setting: .{ lens: "curated collection", class: #spw, probe: #field, era: #ancient }
  stem: "If an ancient library list were transcribed as anchors and edges, what would notes from a reader using it show about which links people follow?"
  updates: ~"../spw/graph-idioms.spw#spw_graph_idioms"
 }
 #>panel_llull_t5
 ^["t5"]{
  #:claim #!speculative
  setting: .{ lens: "living system", class: #physical, probe: #calc, era: #early_modern }
  stem: "Treating an early modern water mill as a living system, would a calculation of its energy flows show where it acts like an organism and where it does not?"
  updates: ~"../physical/engineering/transport-phenomena.spw#engineering_transport"
 }
 #>panel_llull_t6
 ^["t6"]{
  #:claim #!speculative
  setting: .{ lens: "signal path", class: #language_and_mind, probe: #interview, era: #contemporary }
  stem: "Tracing the path of a rumor through a group chat, what would interviews with its members show about where the meaning changed?"
  updates: ~"../language-and-mind/linguistics/sociolinguistics-and-documentation.spw#linguistics_sociolinguistics"
 }
 #>panel_llull_t7
 ^["t7"]{
  #:claim #!speculative
  setting: .{ lens: "market flow", class: #making, probe: #lookup, era: #prehistory }
  stem: "What could a lookup in the archaeological record show about pigments or shells moving between makers before writing, and where does a market picture break?"
  updates: ~"../physical/materials/pigments-and-binders.spw#materials_pigments"
 }
 #>panel_llull_t8
 ^["t8"]{
  #:claim #!speculative
  setting: .{ lens: "social fabric", class: #learning, probe: #lit, era: #medieval }
  stem: "What does the literature on medieval apprenticeship say about how skill passed between generations, and which threads of that fabric survive in schools?"
  updates: ~"../learning/generations/continuities-matrix.spw#generations_continuities"
 }
}

^["try"]{
 #>panel_llull_try_paper_wheel
 ^["paper_wheel"]{
  materials: [ "four paper circles of shrinking size", "a paper fastener", "a pencil", "scissors" ]
  steps: << "write the lenses around the largest circle and the eras around the smallest" ; "stack the circles and pin their centers" ; "turn each ring by its step and read one setting" ; "write a stem, then name the anchor it would update" >>
  time: .{ n: 30, unit: "minutes" }
  safety: "take care with scissor points and the fastener tips"
  shows: ~"./llull-wheel.spw#panel_llull_rule"
 }
}

#>panel_llull_distance_q
?["Do far-apart ring settings produce questions no surface in the cut asks yet?"]{
 #:depth #!educational ~#lens(information flow)
 #:claim #!speculative
 ~#hypothesis: "Settings that pair a class with a distant era and an unusual probe kind should yield more new questions than settings near a writer's home class."
 !probe{ "turn the wheel fifty times, then mark each stem as new or already asked by an existing wonder" =id[p_prov_llull_novelty] =kind[census] }
 $%[prov.llull.alphabet_letter_count]
 ~"./llull-wheel.spw#panel_llull_rule" ~#neighbor(nearest)
}

#>panel_llull_persuasion_q
?["Would rings filled with beliefs produce more one-sided questions than rings filled with working categories?"]{
 #:depth #!historical ~#lens(semiotic charge)
 #:claim #!speculative
 ~#hypothesis: "Rings whose values are held true should steer stems toward confirming them, while rings of neutral categories should leave the answer open."
 !probe{ "fill one paper wheel with value words and one with this cut's lenses, turn each twenty times, and count stems a skeptic could answer no" =id[p_prov_llull_persuasion] =kind[thought] }
 ~"./llull-wheel.spw#panel_llull_purpose" ~#neighbor(nearest)
 breaks: "Llull ran his inquiry inside principles he held true, while these rings hold working categories that assert nothing"
}
