# Gap Table
#
# A Mendeleev grid for this cut: subject classes against forms and against rungs, with each empty cell naming the neighbors that predict what could fill it, and the authored gaps listed beside the computed ones.

#>panel_gap_table
#:layer #!reference
#:domain #!panel
#:form #!comparison
#:level #!intro
#:review #!adversarial_checked
#:valence #!bane

^"emit"{
 ~#title: "Gap Table"
 ~#claim: "Crossing the nine subject classes with ten forms and five rungs leaves about two dozen empty cells, and each one names neighbors that predict what could fill it."
 ~#proof: "Cells are counted from the plan v2 tree; authored gaps come from the plan gap list; the method follows Mendeleev and Ranganathan."
 ~#door: "Find your class row, read its empty cells, then follow one neighbor to see what the gap would hold."
 ~#audience: "writers choosing what to add next, and readers wondering what the cut leaves out"
 continuity: "Gap Table | names neighbors"
 cold_open: "Every empty cell in this grid names neighbors, so a gap reads as a prediction instead of a silence."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #computed
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{
   event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #partial
   note: "forward refs to planned panel and cognition files another package had not written yet"
  }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "form and rung cell counts confirmed; gate receipt corrected from pass to partial"
  }
  ^["r5"]{
   event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #partial
   note: "only the forward ref to the planned facet census remains"
  }
  ^["r6"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "declared gaps restated as missing subjects, not forms; laryngeal row credits Saussure with lost segments and Kurylowicz with the Hittite match"
  }
  ^["r7"]{
   event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #partial
   note: "only the forward ref to the planned facet census remains"
  }
 }
 computed_from: "the plan v2 tree of planned paths, counted on 2026-10-02; the written cut was mid-wave, so live counts belong to the facet census"
}

^["edges"]{
 needs: [ ~"../record/information/reference-works-lineage.spw#information_science_lineage_mendeleev" ]
 grounds: [ ~"../vocabulary.spw#cut_vocabulary" ]
 see: [ ~"./facet-census.spw#panel_facet_census" ]
}

^["concepts"]{
 primary: [ #visible_gap, #faceted_classification ]
 transfers: [ #prediction ]
 tensions: [ #ossified_taxonomy ]
}

^["method"]{
 #>panel_gap_table_counts
 ^["grid_counts"]{
  #:claim #!settled
  statement: "Of the class and form cells in the plan, seventeen hold no planned file; of the class and rung cells, eight hold none."
  reads: %[
   prov.gap.class_form_cell_count,
   prov.gap.class_form_empty_count,
   prov.gap.class_level_cell_count,
   prov.gap.class_level_empty_count
  ]
  source: ~"../registries/sources/provenance-and-reference.spw#src_prov_plan_v2"
  ^["limits"]{
   holds: "the plan v2 tree; try kits inside leaves and frames inside indexes are not counted as forms"
   fails: "the written cut, which fills over time; recount with the facet census before quoting"
  }
 }
 rows: #[ formal, physical, living, language_and_mind, society, making, record, learning, spw ]
 columns: #[ glossary, curriculum, timeline, comparison, ledger, protocol, dossier, calendar, probe_battery, story_kit ]
 rungs: #[ intro, foundation, advanced, graduate, practitioner ]
 mapping: "plan forms map to vocabulary forms: prerequisite DAG to curriculum, state machine to protocol, cadence schedule to calendar, kit to story kit, case dossier to dossier"
 status_kinds: .{ computed: "no planned file", declared: "no planned file, and the plan names this gap by hand" }
 firewall: "in the living row, probes and kits on human bodies stay out under the harm firewall; other kinds may fill those cells"
 spw_row: "the spw class has every form planned, so it has no empty cell to list"
}

^["form_cells"]{
 #>panel_gap_form_formal
 ^["formal"]{
  ^["protocol"]{ status: #computed, neighbors: [ ~"../formal/computing/curriculum-dag.spw#computing_curriculum_dag", ~"../formal/mathematics/engineering-core/numerical-methods.spw#mathematics_numerics" ], predicts: "a step-by-step check, such as how a proof assistant accepts a proof" }
  ^["dossier"]{ status: #computed, neighbors: [ ~"../formal/computing/spec-lineage.spw#computing_spec_lineage" ], predicts: "one sourced case where a proof or a specification changed practice" }
  ^["story_kit"]{ status: #computed, neighbors: [ ~"../formal/formal-glossary.spw#formal_glossary" ], predicts: "a paper-and-pencil kit that makes one proof idea tangible" }
 }
 #>panel_gap_form_physical
 ^["physical"]{
  ^["dossier"]{ status: #computed, neighbors: [ ~"../physical/engineering/mechanical-advanced.spw#engineering_mechanical_advanced", ~"../physical/materials/steel-and-iron.spw#materials_steel" ], predicts: "an engineering failure read back through its physics" }
  ^["calendar"]{ status: #computed, neighbors: [ ~"../physical/physics/core-sequence.spw#physics_core" ], predicts: "a sky or tide observing calendar once astronomy and earth science have nodes" }
  ^["story_kit"]{ status: #computed, neighbors: [ ~"../physical/materials/water.spw#materials_water" ], predicts: "a standalone kit; try frames inside leaves carry this role today" }
 }
 #>panel_gap_form_living
 ^["living"]{
  ^["probe_battery"]{ status: #computed, neighbors: [ ~"../language-and-mind/cognition/perception-and-attention.spw#cognition_perception", ~"../living/development-and-ecology/forms-for-scripts.spw#development_ecology_script_forms" ], predicts: "probes on plants or ecosystems; probes on human bodies stay out under the harm firewall" }
  ^["story_kit"]{ status: #computed, neighbors: [ ~"../living/development-and-ecology/development-as-succession.spw#development_ecology_parallels" ], predicts: "an ecology kit is possible; a health or diet kit is not" }
 }
 #>panel_gap_form_language_mind
 ^["language_and_mind"]{
  ^["curriculum"]{ status: #declared, neighbors: [ ~"../language-and-mind/cognition/cognitive-development.spw#cognition_development", ~"../language-and-mind/linguistics/phonetics-and-phonology.spw#linguistics_phonology" ], predicts: "first and second language acquisition as a prerequisite path" }
  ^["protocol"]{ status: #computed, neighbors: [ ~"../language-and-mind/linguistics/sociolinguistics-and-documentation.spw#linguistics_sociolinguistics", ~"../learning/intergenerational-kit/interview-protocol.spw#generations_kit_interview" ], predicts: "a consent and recording protocol for language documentation" }
  ^["calendar"]{ status: #computed, neighbors: [ ~"../living/development-and-ecology/biological-clocks.spw#development_ecology_clocks" ], predicts: "may rightly stay empty; developmental timing is not a calendar" }
  ^["story_kit"]{ status: #computed, neighbors: [ ~"../language-and-mind/linguistics/historical-linguistics.spw#linguistics_historical" ], predicts: "a kit for hearing sound change in family recordings" }
 }
 #>panel_gap_form_society
 ^["society"]{
  ^["calendar"]{ status: #computed, neighbors: [ ~"../season/calendar-2026q4.spw#season_calendar_2026q4", ~"../society/platforms/live-platform-mechanics.spw#live_platforms_mechanics" ], predicts: "market and platform dates, which live in the season calendar today" }
 }
 #>panel_gap_form_making
 ^["making"]{
  ^["story_kit"]{ status: #computed, neighbors: [ ~"../making/streaming/prompt-deck.spw#streaming_prompt_deck", ~"../making/broadcast/episode-run-sheet.spw#broadcast_run_sheet" ], predicts: "a kit for recording and publishing a first short episode" }
 }
 #>panel_gap_form_record
 ^["record"]{
  ^["calendar"]{ status: #computed, neighbors: [ ~"../record/information/archives-and-preservation.spw#information_science_archives_s_check" ], predicts: "a fixity and media-refresh schedule for a home archive" }
  ^["probe_battery"]{ status: #computed, neighbors: [ ~"../record/carriers/carrier-decay-and-fixity.spw#media_carriers_decay", ~"../record/information/retrieval-systems.spw#information_science_retrieval" ], predicts: "probes that test playback, decay, and findability on real carriers" }
 }
 #>panel_gap_form_learning
 ^["learning"]{
  ^["dossier"]{ status: #computed, neighbors: [ ~"../learning/generations/curriculum-wars-matrix.spw#generations_curriculum_wars", ~"../learning/institutions/governance-and-tenure.spw#institutions_governance" ], predicts: "one sourced public case of a curriculum dispute, never a family story" }
 }
}

^["rung_cells"]{
 #>panel_gap_rung_cells
 ^["empty_rungs"]{
  formal_practitioner: .{ status: #declared, neighbor: ~"../physical/engineering/engineering-economics.spw#engineering_economics", predicts: "actuarial and industrial practice" }
  language_and_mind_graduate: .{ status: #computed, neighbor: ~"../living/neuroscience/cognitive-and-computational.spw#neuroscience_computational", predicts: "research-methods rung for cognition" }
  language_and_mind_practitioner: .{ status: #computed, neighbor: ~"../language-and-mind/linguistics/sociolinguistics-and-documentation.spw#linguistics_sociolinguistics", predicts: "interpreting, translation, and documentation work" }
  making_graduate: .{ status: #declared, neighbor: ~"../making/film/film-school-sequence.spw#film_school", predicts: "producing programs for film and publishing" }
  record_graduate: .{ status: #computed, neighbor: ~"../record/information/archives-and-preservation.spw#information_science_archives", predicts: "archival theory at graduate depth" }
  record_practitioner: .{ status: #computed, neighbor: ~"../record/carriers/media-object-dating.spw#media_carriers_object_dating", predicts: "cataloging and preservation practice" }
  learning_graduate: .{ status: #computed, neighbor: ~"../learning/institutions/research-funding.spw#institutions_research_funding", predicts: "education research methods" }
  learning_practitioner: .{ status: #computed, neighbor: ~"../learning/institutions/pedagogical-scaffolding.spw#institutions_pedagogy", predicts: "classroom practice written with teachers" }
 }
}

^["declared"]{
 #>panel_gap_declared
 ^["plan_gaps"]{
  #:claim #!settled
  statement: "The plan names twenty-one gaps by hand, from databases and security in computing to a southern-hemisphere season and a region facet."
  reads: %[prov.plan.authored_gap_count]
  source: ~"../registries/sources/provenance-and-reference.spw#src_prov_plan_v2"
 }
 beside_computed: [
  "language acquisition is both declared and a computed empty curriculum cell",
  "the practitioner rung for mathematics is both declared and a computed empty rung",
  "the graduate rung for film and publishing is both declared and a computed empty rung",
  "astronomy and earth science are declared; the empty physical calendar is where they would surface",
  "a region facet is declared empty in the vocabulary and has no cell here, because the grid has no space column"
 ]
 only_declared: "most declared gaps, such as law, music production, and still photography, are missing subjects, not missing forms, so a class-by-form grid cannot show them even in rows with empty form cells"
}

^["found"]{
 #>panel_gap_found_gallium
 ^["gallium"]{
  #:claim #!settled
  statement: "Mendeleev named eka-aluminium from its neighbors in 1871; gallium, found in 1875, matched most of the predicted properties."
  reads: %[prov.mendeleev.confirmed_prediction_count]
  source: ~"../registries/sources/provenance-and-reference.spw#src_prov_scerri_2007"
 }
 #>panel_gap_found_laryngeals
 ^["laryngeals"]{
  #:claim #!settled
  statement: "Saussure inferred lost Proto-Indo-European segments in 1879; later scholars read them as consonants, and in 1927 Kuryłowicz showed that Hittite ḫ appears where one of them was posited."
  sources: [ ~"../registries/sources/provenance-and-reference.spw#src_prov_fortson_2010", ~"../registries/sources/language-and-communities.spw#src_lang_saussure_1879", ~"../registries/sources/language-and-communities.spw#src_lang_kurylowicz_1927" ]
  ^["limits"]{
   holds: "Saussure posited abstract sonant coefficients, not consonants"
   fails: "as a story of one predicted consonant; the consonant reading came from Möller and others before Hittite was read"
  }
  see: ~"../language-and-mind/linguistics/historical-linguistics.spw#linguistics_historical"
 }
}

^["try"]{
 #>panel_gap_try_shelf
 ^["grid_your_shelf"]{
  materials: [ "a shelf of books or records", "a sheet of paper ruled into a grid", "a pencil" ]
  steps: << "pick two ways to sort them, such as subject and decade" ; "write a count in each cell" ; "for each empty cell, name the two nearest full cells" ; "write what the empty cell predicts you would enjoy" >>
  time: .{ n: 25, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"./gap-table.spw#panel_gap_form_record"
 }
}

#>panel_gap_table_fill_q
?["Will the empty cells fill first where their neighbors are largest?"]{
 #:depth #!computational ~#lens(curated collection)
 #:claim #!speculative
 ~#hypothesis: "Cells beside large rows should fill sooner, because writers extend what they already know, while cells beside thin rows should stay empty longer."
 !probe{ "recount the grid after each wave and compare which empty cells filled against the size of their rows" =id[p_prov_gap_fill_order] =kind[census] }
 $%[prov.gap.class_form_empty_count, prov.gap.class_form_cell_count]
 ~"./gap-table.spw#panel_gap_table_counts" ~#neighbor(nearest)
}

#>panel_gap_table_element_q
?["Does an empty cell in a knowledge grid predict its occupant as well as a gap in the periodic table did?"]{
 #:depth #!historical ~#lens(formal structure)
 #:claim #!speculative
 ~#hypothesis: "Neighbors should predict a missing form better than a missing subject, since forms recur across classes while subjects do not."
 !probe{ "for cells filled in later waves, compare the predicts line with what was written and score form and subject separately" =id[p_prov_gap_prediction_check] =kind[thought] }
 $%[prov.mendeleev.confirmed_prediction_count]
 ~"./gap-table.spw#panel_gap_found_gallium" ~#neighbor(nearest)
 breaks: "an element must have the properties physics allows, while a cell in this grid is filled by whatever writers choose to write"
}
