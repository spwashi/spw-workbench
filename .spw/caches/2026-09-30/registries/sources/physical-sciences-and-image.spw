# Sources: Physical Sciences and Image
#
# Bibliography anchors for physics, chemistry, optics, and moving-image carriers. Claims link here; each entry names a work a reader can find.

#>registry_src_physical_sciences_and_image
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!practitioner
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5 writer"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "web checks 2026-10-01 against Wikipedia articles: C-41 process, E-6 process, ECN-2, Landauer principle, Arri Alexa, helical scan, quadruplex videotape, U-matic, Video8, DV, Betamax, Rietveld refinement, Lorenz gauge condition, two-dimensional NMR",
  "web checks 2026-10-02 against Wikipedia articles: Landauer principle, double-Gauss lens, Petzval field curvature, anamorphic format, 35 mm and 16 mm film, Super 8, Super 16, T-grain, helical scan, metal-organic framework",
  "web checks 2026-10-02 in the fact-check fix pass: NIST constants database for the vacuum impedance, arXiv 2409.03787, German Wikipedia Abbe-Zahl, Angenieux retrofocus, extremal principles in non-equilibrium thermodynamics, fatigue limit, Bhopal disaster, helical scan, videotape",
  "Crossref record 2026-10-02 for the CODATA 2022 journal version: Reviews of Modern Physics 97, 025002, published 30 April 2025",
  "Crossref records 2026-10-03 for Joule and Thomson 1854, Rietveld 1967, the Ernst 1992 Nobel lecture, and Suzuki, Measday, and Roalsvig 1987; web checks 2026-10-03 against Wikipedia articles Kelvin, Two-dimensional NMR, Rietveld refinement, Nitrocellulose film, and Bhopal disaster, and the Kodak History of Film page",
  "page reads 2026-10-03: the BBC News report of 2 January 2025 on the Bhopal site waste, and the ACS bachelor's guidelines page as archived on 2023-05-29, which names the 2023 edition",
  "every other entry is named from writer knowledge; titles, authors, years, and venues were not web-verified, which keeps this registry at spot_checked"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #partial }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r6"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass, note: "re-run after the 2026-10-03 fact-check fixes; no failing lines" }
 }
 corrections: #[
  "fact-check: Gibbs, On the Equilibrium of Heterogeneous Substances, is dated to its two installments of 1876 and 1878; the phase rule is in the 1876 part",
  "fact-check: added CODATA 2022, Prigogine 1945, Sagawa and Ueda 2008, Kelvin 1848, Clausius 1850, Bathias 1999, the OSH Act, Salmeron and Schloegl 2008, and dated web checks for the Abbe bounds, retrofocus, Video8, and Bhopal",
  "fact-check 2026-10-03: added Joule and Thomson 1854 for the explicit Carnot form, Suzuki 1987 for negative-muon capture, the Ernst 1992 Nobel lecture for the Jeener credit, Rietveld 1967, the Kodak History of Film page, and Wikipedia Nitrocellulose film; Kelvin 1848 now says it is context only",
  "fact-check 2026-10-03: the r4 fact-check receipt was dated 2026-10-01, before the receipts it followed; it is re-dated 2026-10-02, the day that pass ran",
  "fact-check 2026-10-03: the 2015 ACS guidelines entry said later revisions were unverified; a 2023 edition superseded it and now has its own entry, and BBC News 2025 sources the Bhopal site-waste removal"
 ]
}

