# Sources: Spw Hosts and History
#
# Bibliography anchors for the editor hosts and workbench history surfaces. Repository entries pin a path at commit 1aa1dc23; claims add the exact lines in a cites string.

#>src_hosts_registry
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!mixed
#:review #!sourced
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #sourced, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 checked: "every repository path was opened at commit 1aa1dc23 on 2026-10-02; the four web documents were fetched the same day"
 added: "on 2026-10-03 the commit gate, mutation, cut stream, and contract entries were opened in place; the two HOPL papers were matched against Crossref, the SVG and ECMA-48 records against their publisher pages, and the GQL date against its public record"
 kinds: "code and canon entries name a file and a commit; study entries are internal reports; web entries carry a url and an access date"
 groups: #[ vscode, lsp, jetbrains, neovim, canon, history, external, curriculum_precedents ]
}

