# Sources: Formal
#
# Bibliography anchors for mathematics and computing. Claims link here; each entry names a work a reader can find by title, author, year, and venue.

#>src_formal_registry
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!mixed
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[ "web checks 2026-10-01: V8 blog posts on Turboshaft and Maglev, Rocq 9.0 release page, kernelnewbies Linux 6.6, LWN EEVDF article, Ecma-262 edition list, Wasm 3.0 announcement, POSIX.1-2024 front matter, RFC 9293, RFC 9114, RFC 8831, RFC 9438, W3C and WHATWG MOU, Rust 1.85 announcement, Zig 0.14 release notes, ABET 2025-2026 criteria, GAO Patriot summary", "other entries written from the writer knowledge of standard texts and papers; titles and venues not web-checked are spot_checked, not audited" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

