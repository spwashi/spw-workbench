# Sources: Spw Glossary and Specimens
#
# Bibliography anchors for the glossary and specimen surfaces: the writer probe run, repository readers pinned to a commit, the notation standards behind each field habit, and the works that define each borrowed term.

#>src_gloss_registry
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!mixed
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #pass }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 checked: "EDTF, MARC 21, CommonMark, Unicode, the Leipzig rules, and the Fahlman page were read on their publisher sites on 2026-10-02; the rest come from the writer and keep the registry at spot_checked"
 rechecked: "on 2026-10-03 the Unicode 18.0.0 release was confirmed against the Unicode blog announcement of 2026-09-16, and every repository locator was re-read at 1aa1dc23"
 added: "seed_lexer, lsp_display, cli_readers, and diagnostics were added on 2026-10-03 for the particle, false-friend, and term glossaries"
 reuse: "works already held by other registries are cited there, not copied: Hecht, Kittel, Griffiths, Pauling, Folland, Rudin, Casella and Berger, Tesniere, Biber and Conrad, Tversky and Kahneman, Chomsky and Halle, Dewey, Murch, Palmer, Stevens, Ranganathan, Kernighan and Ritchie, Klabnik and Nichols, ECMA-262, RFC 3986, the SI Brochure, and the Leipzig rules"
 uncited: "diestel_2017 is cited by no row yet; it stays because its anchor is already published"
 groups: #[ repository, notation, terms, linguistics ]
}

