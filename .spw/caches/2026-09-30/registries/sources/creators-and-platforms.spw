# Sources: Creators and Platforms
#
# Bibliography anchors for authorship, broadcast, streaming, and live platforms. Claims link here; each entry names a work or page a reader can find.

#>registry_src_creators_and_platforms
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!practitioner
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 tiers: "primary pages and works first; encyclopedia entries are marked kind encyclopedia and carry an accessed date"
 accessed_note: "web pages were read on 2026-10-01; platform help pages change without notice, so each carries accessed"
}

^["platform_pages"]{
 #>src_creator_kdp_royalty
 ^["kdp_royalty"]{ title: "eBook Royalty Options", publisher: "Amazon Kindle Direct Publishing, KDP Help", url: "https://kdp.amazon.com/en_US/help/topic/G200644210", accessed: "2026-10-01", kind: #platform_page }
 #>src_creator_kdp_price
 ^["kdp_price"]{ title: "eBook List Price Requirements", publisher: "Amazon Kindle Direct Publishing, KDP Help", url: "https://kdp.amazon.com/en_US/help/topic/G200634560", accessed: "2026-10-01", note: "states the 70 percent band on Amazon.com moved from 2.99-9.99 to 2.99-12.99 USD effective 2026-07-07", kind: #platform_page }
 #>src_creator_kdp_select
 ^["kdp_select"]{ title: "KDP Select; How to enroll in KDP Select", publisher: "Amazon Kindle Direct Publishing, KDP Help", url: "https://kdp.amazon.com/en_US/help/topic/GD9PMU58BV24QFZ7", accessed: "2026-10-01", note: "90-day term; the Kindle eBook must be exclusive to the Kindle Store for the enrollment period; print and audio may go elsewhere", kind: #platform_page }
 #>src_creator_kdp_formats
 ^["kdp_formats"]{ title: "What file formats are supported for eBook manuscripts?", publisher: "Amazon Kindle Direct Publishing, KDP Help", url: "https://kdp.amazon.com/en_US/help/topic/G200634390", accessed: "2026-10-01", kind: #platform_page }
 #>src_creator_kdp_mobi
 ^["kdp_mobi"]{ title: "MOBI Support for eBooks Frequently Asked Questions", publisher: "Amazon Kindle Direct Publishing, KDP Help", url: "https://kdp.amazon.com/help/topic/GULSQMHU5MNH4EZM", accessed: "2026-10-01", note: "MOBI ended for reflowable eBooks on 2021-08-01 and for fixed-layout eBooks on 2025-03-18", kind: #platform_page }
 #>src_creator_kdp_quality
 ^["kdp_quality"]{ title: "Guide to Kindle Content Quality", publisher: "Amazon Kindle Direct Publishing, KDP Help", url: "https://kdp.amazon.com/en_US/help/topic/G200952510", accessed: "2026-10-01", kind: #platform_page }
 #>src_creator_kdp_sales_rank
 ^["kdp_sales_rank"]{ title: "Sales Ranking", publisher: "Amazon Kindle Direct Publishing, KDP Help", url: "https://kdp.amazon.com/en_US/help/topic/G201648140", accessed: "2026-10-01", note: "ranks reflect recent and historical activity, recent weighted more heavily, updated at least daily", kind: #platform_page }
 #>src_creator_tiktok_virtual_items
 ^["tiktok_virtual_items"]{ title: "Virtual Items Policy", publisher: "TikTok", url: "https://www.tiktok.com/legal/page/global/virtual-items/en", accessed: "2026-10-01", note: "global page as served on the access date showed last updated December 2019; regional versions may differ", kind: #platform_page }
 #>src_creator_iab_podcast
 ^["iab_podcast"]{ title: "Podcast Measurement Technical Guidelines", publisher: "IAB Tech Lab", url: "https://iabtechlab.com/standards/podcast-measurement-guidelines/", accessed: "2026-10-01", note: "version 1.0 September 2016 and version 2.0 December 2017; later versions listed on the page are verify", kind: #standard }
}

^["standards_and_law"]{
 #>src_creator_epub33
 ^["epub33"]{ title: "EPUB 3.3", publisher: "W3C, Publishing Maintenance Working Group", status: "W3C Recommendation; version dated 2026-01-13 read on the access date", url: "https://www.w3.org/TR/epub-33/", accessed: "2026-10-01", kind: #standard }
 #>src_creator_ftc_endorsement_guides
 ^["ftc_endorsement_guides"]{ title: "Guides Concerning the Use of Endorsements and Testimonials in Advertising", publisher: "US Federal Trade Commission", citation: "16 CFR Part 255, revised 2023", kind: #regulation }
