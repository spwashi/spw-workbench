 #>src_creator_ftc_reviews_rule
 ^["ftc_reviews_rule"]{ title: "Trade Regulation Rule on the Use of Consumer Reviews and Testimonials", publisher: "US Federal Trade Commission", citation: "16 CFR Part 465; final rule announced 2024-08-14", kind: #regulation }
 #>src_creator_midwest_video_1979
 ^["midwest_video_1979"]{ title: "FCC v. Midwest Video Corp.", citation: "440 U.S. 689", year: 1979, publisher: "Supreme Court of the United States", kind: #primary }
 #>src_creator_cable_act_1984
 ^["cable_act_1984"]{ title: "Cable Communications Policy Act of 1984", citation: "Pub. L. 98-549; 47 U.S.C. 531 on public, educational, and governmental channels", year: 1984, kind: #primary }
}

