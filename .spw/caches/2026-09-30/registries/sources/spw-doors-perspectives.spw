# Sources: Spw Doors and Perspectives
#
# Bibliography anchors for the fragment doors and the practitioner perspectives: repository code and canon pinned to a commit, the owner note, the persona study, keyboard layout documents, and the field references each perspective leans on.

#>src_doors_registry
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!mixed
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 namespace: "doors: handles %doors.*, sources src_doors_*, probes p_doors_*; the spw namespace belongs to the spw-branch package"
 evidence: #[
  "repository rows re-read at commit 1aa1dc23 on 2026-10-02; claims quote the path:line they use",
  "keyboard rows read on 2026-10-02 from the Microsoft Learn layout pages and the kbdlayout.info tables of KBDUS.DLL and KBDUK.DLL",
  "the ISO/IEC 9995 page refused the fetch on 2026-10-02; its row rests on the writer and a Wikipedia summary of the parts and the key grid",
  "research rows come from the writer; on 2026-10-03 Crossref matched Le Novere 2009, den Dunnen 2016, Guyatt 2008, Harel 1987, Wilkinson and Rogers 1973, and Stevens 1946, and the rest stay unmatched",
  "the Fountain row was read from fountain.io on 2026-10-03; Likert 1932 is a monograph Crossref does not index, and its row rests on the writer"
 ]
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the Cajori entry gave one year for two volumes; volume one appeared in 1928 and volume two in 1929"
 ]
 added: "Stevens 1946, Likert 1932, JCGM 100 of 2008, the Fountain syntax, the canon apposition surface, and the cut vocabulary were added on 2026-10-03 for the perspectives written that day"
 groups: #[ repository, canon, owner_and_studies, keyboards, programming, physics_and_math, engineering_and_life, design_and_language, society_and_record, media_and_learning ]
}

