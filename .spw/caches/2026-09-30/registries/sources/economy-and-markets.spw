# Sources: Economy and Markets
#
# Bibliography anchors for economics, management, and market reading. Claims link here; each entry names a work, page, or dataset a reader can find.

#>registry_src_economy_and_markets
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!mixed
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  "Crossref metadata checks 2026-10-01 for Belobaba 1989, Littlewood reprint, Rothstein 1971, Yang 2009 and 2012, McCollough 2000, de Matos 2007, Bitner 1992 and 2008, Roth 2023, Lodder 2019, Rohrer 2015, Vadillo 2016, Vohs 2006, Knutson 2007, Hulsheger 2011, Eva 2019, Cronin 1992, Montiel Olea 2013, Andrews 2019, Mellstrom 2008, Gneezy 2000, Rochet 2003, Keane 2010, Cameron 2015, Blanchard 2018, Smith 1992",
  "web reads 2026-10-01: Lee et al. abstract on arXiv, Edison platform page, Nielsen Gauge and May 2025 release, IAB 2024 and 2025 report pages, Pew 2023 podcast report, FDA Food Code 2026 summary, Wikipedia pages marked encyclopedia",
  "web reads 2026-10-02: Edison platform page again (no fieldwork quarter printed), FDA 2026 Food Code change summary dated 2026-09-17, Digital Markets Act and Booking.com encyclopedia pages, RSS Advisory Board specification, The Code about page, Singles Day, Viya, Alibaba, and HSN encyclopedia pages",
  "entries added 2026-10-02 without a fetch are named from the writer and keep this registry at spot_checked; each carries checked: writer where that applies",
  "fact check fixes 2026-10-02: IAB full year 2024 report PDF read for the exact total; Crossref records read for Smith 1992 abstract, Diamond 1982 in RES, Caruso 2013, and Pavesic 1983; Daniel Zhang encyclopedia page read",
  "web re-reads 2026-10-03: Edison platform page, Nielsen May 2025 release at its nielsen.com address, IAB 2025 report page, Pew 2023 methodology line, and the Alibaba encyclopedia fine passage; each matched the registry"
 ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #partial }
  ^["r4"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r5"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #corrected }
  ^["r6"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r7"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r8"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "fact check: the search rung cited Diamond 1982 in the JPE, the coconut model of search externalities; the wage-bargaining paper in the Review of Economic Studies is added",
  "fact check: Caruso and colleagues 2013 is added, since Many Labs 1 and Rohrer and colleagues replicated that study and not Vohs 2006",
  "fact check: Pavesic 1983, the 2024 Court of Justice judgment, and the Emerson Act are no longer marked checked by the writer alone"
 ]
 tiers: "primary papers and statutes first; encyclopedia pages are kind encyclopedia and carry accessed"
}

