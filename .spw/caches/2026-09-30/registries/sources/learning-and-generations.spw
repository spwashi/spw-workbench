# Sources: Learning and Generations
#
# Bibliography anchors for the learning class. Claims link here; each entry names a statute, regulation, report, article, book, or dated web page a reader can find.

#>registry_src_learning_and_generations
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!mixed
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #sourced, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #pass }
  ^["r2"]{ event: #fact_checked, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #partial }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 checked_online: #[ src_learn_asca_ratios, src_learn_nsf_budget, src_learn_colby_2023, src_learn_naep_ltt_2022, src_learn_nih_simplified_review, src_learn_gao_2017, src_learn_exeter_harkness, src_learn_dimock_2019, src_learn_parker_2023, src_learn_ferpa_hipaa_2019, src_learn_oha_2018, src_learn_ceda, src_learn_nsda ]
 note: "web entries carry an accessed date; statutes and regulations name the citation a reader can look up"
}

^["kinds"]{
 tiers: <<
  "statute, regulation, or court case" ;
  "official report or policy statement" ;
  "peer-reviewed article or scholarly book" ;
  "dated web page or survey series" ;
  "journalism"
 >>
}

