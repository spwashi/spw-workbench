 method: #authored
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r4"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r5"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #corrected
  }
  ^["r6"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 checked: "abstracts and bibliographic records for Bohren 2017, Sampson 1997, Branas 2018, Saifullah 2009, Sisco 2024, Papafragou 2007, Purnell 1999, Senghas 2004 were read on 2026-10-01; on 2026-10-02 the Bohren 2017 and Branas 2018 abstracts, Sisco 2024 Crossref metadata, Seligman 2016 Open Library record, eight etymology entries, four Wiktionary entries, and the Death Cafe, Repair Cafe, tool library, and EPA lead pages were read; web pages carry accessed dates and change without notice"
 fact_checked: "the r5 pass checked every record against Crossref, Europe PMC, Open Library, or a known record and found none fabricated; Branas 2018 was read in full text (PMC5866574, Table 2 and the CA-ITT paragraph) and the OHA core principles, Sosa 1980 abstract, and Wikipedia doula, kohanga reo, and Aha Punana Leo pages on 2026-10-02; the remaining bibliography was checked from bibliographic knowledge, not re-fetched one by one"
 corrections: [
  "Sisco 2024 third author is Elise M. Pyfrom, not Elizabeth; the full author list replaces et al.",
  "Gladwell 2000 is context for the influencer date, not an attestation of the word; the dated sense rests on the Online Etymology Dictionary"
 ]
}

