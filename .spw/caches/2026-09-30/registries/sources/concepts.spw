# Sources: Concepts
#
# Bibliography anchors for the concept hubs and plates. Hubs mostly cite works other registries already hold; the entries here are the few a breaks line or a credit needs that no other package carries.

#>registry_src_concepts
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!mixed
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 checked: "entries marked crossref were matched against Crossref metadata on 2026-10-03 and entries marked openlibrary against Open Library records that day; the Russian original of Landau 1937 comes from the writer beside its matched English translation"
 fact_check: "the 2026-10-03 fact-check found every earlier entry; it added Anderson 1932 and 1933 so the positron finder is credited and Bertotti 1998 so the magnet loop has a source, each matched against Crossref that day"
 code_pin: "the code entry quotes path:line at commit 651b535b; line numbers drift with edits, so recheck them against that commit"
 reuse: "works another registry already holds are cited there, not copied: Noether, Kosmann-Schwarzbach, Grunbaum, Polya, International Tables, Buckingham, Bridgman, Thompson, Kleiber, Glazier, Reynolds, Lindeman, Begon, Orth, Blakley, Scheffer, Gunderson and Holling, Strang, Trotter, Hairer, Kiparsky, Prince and Smolensky, Black, Nyquist, Thomas, Elowitz and Leibler, Bullard and Mitra, Arijon, Scerri, Saussure, Kurylowicz, Baerman, Robinson and Goforth, Stevens, Gombrich"
 groups: #[ balance, symmetry_and_scale, transition_and_feedback, prediction, plates, repository ]
}

