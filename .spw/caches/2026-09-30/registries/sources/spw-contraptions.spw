# Sources: Spw Contraptions
#
# Bibliography anchors for the contraptions bench: repository code and canon pinned to a commit, and the published works each instrument borrows its method from.

#>registry_src_spw_contraptions
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!mixed
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #partial }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r8"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
 }
 checked: "journal entries marked crossref were matched against Crossref metadata on 2026-10-02; web entries were fetched that day; books marked writer come from the writer and keep this registry at spot_checked"
 code_pin: "code and canon entries quote path:line at commit 1aa1dc23; line numbers drift with edits, so recheck them against that commit"
 fact_check: "on 2026-10-03 an adversarial pass refetched Grunbaum, the Leipzig rules, Barina, Media Queries, and the Met Office page, matched Bruns, Thomas, and Robinson and Goforth in Crossref, and read every code and canon line at 1aa1dc23; the other books were checked from reviewer knowledge only, so the registry stays spot_checked"
 reuse: "works already held by another registry are cited there, not copied: Noether, the SI Brochure, International Tables volume A, Reynolds, Scerri, Grimm, Verner, Munkres, Plofker, PREMIS, FIPS 180-4, Salton, Sakurai, Goldstein, Seborg"
 added_late: "on 2026-10-03 the third wave added Zwicky and Pullum, matched against Crossref, Perlmutter from the writer, the cut contract, a bench-runs observation entry, and six code entries read at 1aa1dc23: voice, inventory, cite, beat, particles, and the widened gate entry"
 code_drift: "inventory.ts changed in c79a096a before 651b535b, so its census columns sit at 337-342 there and its cited 333-338 hold only at 1aa1dc23; the other five files are unchanged at 651b535b"
 added_fix: "on 2026-10-03 the fact-check pass added the grammar entry, quoting the Stream and Wildcard builders at 1aa1dc23, unchanged at f22c12bb"
 added: "on 2026-10-03 eleven works were added for the second wave of contraptions; journal entries were matched against Crossref and books against Open Library before entry"
 corrections: #[
  "the third-wave note said all six code entries were unchanged at 651b535b; inventory.ts moved four lines in c79a096a, and the note now says so",
  "the parse-runs entry was dated 2026-10-02 while surfaces cited it for parses made on 2026-10-03; it now spans both days, and the bench-runs entry names the interpretSeed runs and claim-frame counts that the number garden and coupling map now cite",
  "the Leipzig Glossing Rules entry now records that the rules are the February 2008 revision inside a document last changed 31 May 2015, and that the Tagalog infix gloss there is ACTFOC",
  "the Grunbaum entry now carries its pages and the count it reports, read from the fetched article text on 2026-10-03",
  "the Met Office, Media Queries, and CGPM entries were fetched again on 2026-10-03 and their quoted contents rechecked"
 ]
 groups: #[ repository, dimension_and_symmetry, graphs_and_order, notation_and_reference, numbers_and_automata ]
}

