# Sources: Provenance and Reference
#
# Bibliography anchors for provenance, the panels, and library and information science. Each row names a work, record, or repository path a reader can find.

#>registry_src_provenance_and_reference
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!mixed
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[ "fix-pass reads 2026-10-03: PubMed efetch for PMIDs 30190309, 36250645, and 19564476, and for 41869847, which carries no abstract; ARTFL Encyclopedie home page; Wikipedia Open Archival Information System page", "fix-pass reads 2026-10-02: PubMed esummary for PMIDs 41869847, 41870560, 40014670, 40811497, 41824552, 32690970, and 30573670; Cornell LII 18 U.S.C. 2709 amendment notes; rssboard.org RSS history; National Archives Thanksgiving page; Wikipedia LitRPG, Federal holidays, Phonograph cylinder, and IATSE pages", "web checks 2026-10-02: Zig 0.14.0 release notes, V8 Sea of Nodes post, Linux 6.6 KernelNewbies page, TypeScript 4.9 notes, RSS 2.0.11 page, Uiua tour source, Rocq site, Spotify Wrapped and infinite scrolling articles", "web checks 2026-10-01: TREC-COVID arXiv record, OAIS edition history, PREMIS 3.0 date, Yongle Encyclopedia, Brian Deer scheme, Wikidata launch, Hachette v. Internet Archive, OA Diamond study, Library Bill of Rights, Doe v. Gonzales, Luhmann card index, Foxfire" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #partial }
  ^["r5"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "usc18_2709 and rss_2003 misattributed; four guideline rows superseded; eight rows added"
  }
  ^["r6"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r7"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "folio volume counts moved from Darnton to the ARTFL project; Pan 2018 and the OAIS edition page added; editor locators pinned to 1aa1dc23"
  }
  ^["r8"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 checked: "entries added on 2026-10-02 were matched against a publisher or project page where a check is named in evidence; the rest come from the writer and keep the registry at spot_checked"
 superseded_rule: "a guideline replaced by a newer edition keeps its row and anchor, with superseded_by pointing at the successor"
}

