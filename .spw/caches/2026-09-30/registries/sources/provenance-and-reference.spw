# Sources: Provenance and Reference
#
# Bibliography anchors for provenance, the panels, and library and information science. Each row names a work, record, or repository path a reader can find.

#>registry_src_provenance_and_reference
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!mixed
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[ "web checks 2026-10-01: TREC-COVID arXiv record, OAIS edition history, PREMIS 3.0 date, Yongle Encyclopedia, Brian Deer scheme, Wikidata launch, Hachette v. Internet Archive, OA Diamond study, Library Bill of Rights, Doe v. Gonzales, Luhmann card index, Foxfire" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

