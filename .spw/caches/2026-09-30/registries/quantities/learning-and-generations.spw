# Quantities: Learning and Generations
#
# World metric cells for the learning class. Rules, ratios, budgets, and survey readings live here once; a cell with status verify stays empty until a reader fills it from the named source.

#>registry_qty_learning_and_generations
#:layer #!reference
#:domain #!registry
#:form #!registry
#:level #!mixed
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #partial }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 checked_online: #[ counsel, fund, faculty, naep ]
 verify_rule: "a cell with status verify has no value; fill it from its src and set as_of"
}

^["family"]{
 id: learn
 operator: "%"
 identifier: learn
 plane: world
 scope: corpus
 groups: #[ counsel, idea, aaup, faculty, fund, credit, carnegie, active, ib, transfer, cep, naep, poll, policy ]
 scheme: tol
 algorithm: world.registry_lookup
 form: scalar
}

#>q_learn_counseling
^["counseling"]{
 %learn.counsel.asca_ratio_students{
  value: 250, abs: 0, unit: "students per school counselor"
  at: "ASCA recommended caseload", as_of: "2026-10-01"
  src: ~"../sources/learning-and-generations.spw#src_learn_asca_ratios"
  status: #settled
 }
 %learn.counsel.us_ratio_students{
  value: 372, abs: 0, unit: "students per school counselor"
  at: "US national average, 2024-25 school year", as_of: "2026-10-01"
  src: ~"../sources/learning-and-generations.spw#src_learn_asca_ratios"
  status: #settled
 }
}

#>q_learn_idea
^["idea"]{
 %learn.idea.initial_eval_days{
  value: 60, abs: 0, unit: "days"
  at: "parental consent to completed initial evaluation, unless the state sets its own timeframe; 34 CFR 300.301(c)"
  src: ~"../sources/learning-and-generations.spw#src_learn_idea_regs"
  status: #settled
 }
 %learn.idea.iep_meeting_days{
  value: 30, abs: 0, unit: "days"
  at: "eligibility determination to the meeting that develops the IEP; 34 CFR 300.323(c)(1)"
  src: ~"../sources/learning-and-generations.spw#src_learn_idea_regs"
  status: #settled
 }
 %learn.idea.iep_review_months{
  value: 12, abs: 0, unit: "months"
  at: "the IEP team reviews the IEP periodically and not less than annually; 34 CFR 300.324(b)"
  src: ~"../sources/learning-and-generations.spw#src_learn_idea_regs"
  status: #settled
 }
 %learn.idea.reeval_years{
  value: 3, abs: 0, unit: "years"
  at: "reevaluation at least this often unless parent and agency agree it is unnecessary; 34 CFR 300.303(b)"
  src: ~"../sources/learning-and-generations.spw#src_learn_idea_regs"
  status: #settled
 }
}

#>q_learn_faculty
^["faculty"]{
 %learn.aaup.probation_max_years{
  value: 7, abs: 0, unit: "years"
  at: "maximum full-time probationary period recommended by the 1940 Statement"
  src: ~"../sources/learning-and-generations.spw#src_learn_aaup_1940"
  status: #settled
 }
 %learn.faculty.contingent_2021_percent{
  value: 68, abs: 1, unit: "percent of US faculty appointments"
  at: "part-time plus full-time non-tenure-track, fall 2021", as_of: "2023"
  src: ~"../sources/learning-and-generations.spw#src_learn_colby_2023"
  status: #settled
 }
 %learn.faculty.contingent_1987_percent{
  value: 47, abs: 1, unit: "percent of US faculty appointments"
  at: "part-time plus full-time non-tenure-track, fall 1987, as reported in 2023", as_of: "2023"
  src: ~"../sources/learning-and-generations.spw#src_learn_colby_2023"
  status: #settled
 }
}

