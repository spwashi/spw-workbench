  status: #contested
 }
}

#>q_learn_credit
^["credit"]{
 %learn.credit.semester_weeks{
  value: 15, abs: 0, unit: "weeks"
  at: "approximate length of a semester in the federal credit hour definition; 34 CFR 600.2"
  src: ~"../sources/learning-and-generations.spw#src_learn_credit_hour_cfr"
  status: #settled
 }
 %learn.credit.outside_hours_per_class_hour{
  value: 2, abs: 0, unit: "hours of out-of-class work per hour of instruction, minimum"
  at: "federal credit hour definition; 34 CFR 600.2"
  src: ~"../sources/learning-and-generations.spw#src_learn_credit_hour_cfr"
  status: #settled
 }
 %learn.carnegie.unit_contact_hours{
  value: 120, abs: 0, unit: "hours of instruction in one high school subject over a year"
  at: "Carnegie Unit as defined in the early twentieth century"
