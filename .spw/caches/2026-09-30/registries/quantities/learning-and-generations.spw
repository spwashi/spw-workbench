  status: #settled
 }
 %learn.credit.bachelor_typical_semester_credits{
  unit: "semester credit hours"
  at: "common total for a US bachelor degree; set by each institution, state system, and accreditor", as_of: "2026-10-01"
  src: ~"../sources/learning-and-generations.spw#src_learn_shedd_2003"
  status: #verify
 }
}

#>q_learn_active
^["active_learning"]{
 %learn.active.fail_risk_ratio{
  value: 1.5, rel: 0.05, unit: "ratio of failure risk, lecture to active learning"
  at: "meta-analysis of 225 STEM course studies"
  src: ~"../sources/learning-and-generations.spw#src_learn_freeman_2014"
  status: #settled
 }
 %learn.active.exam_effect_sd{
  value: 0.47, rel: 0.05, unit: "standard deviations"
  at: "weighted mean effect of active learning on exam scores in the same meta-analysis"
  src: ~"../sources/learning-and-generations.spw#src_learn_freeman_2014"
  status: #settled
 }
}

