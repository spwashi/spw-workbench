#>q_media_paper
^"paper"{
 %media.paper.iso9706_ph_min{
  value: 7.5
  unit: "pH"
  at: "lower bound for the cold-water extract of permanent paper, ISO 9706:1994; that edition was withdrawn on 29 May 2025 and replaced by ISO 9706:2025"
  abs: 0
  src: ~"../sources/record-and-carriers.spw#src_media_iso_9706_1994"
  edition: "ISO 9706:1994 limits; whether ISO 9706:2025 keeps them was not confirmed"
  as_of: "2026-10-03"
  status: #settled
 }
 %media.paper.iso9706_ph_max{
  value: 10.0
  unit: "pH"
  at: "upper bound for the cold-water extract of permanent paper, ISO 9706:1994; that edition was withdrawn on 29 May 2025 and replaced by ISO 9706:2025"
  abs: 0
  src: ~"../sources/record-and-carriers.spw#src_media_iso_9706_1994"
  edition: "ISO 9706:1994 limits; whether ISO 9706:2025 keeps them was not confirmed"
  as_of: "2026-10-03"
  status: #settled
 }
 %media.paper.iso9706_alkali_reserve_mol_per_kg{
  value: 0.4
  unit: "mol acid per kg paper"
  at: "minimum alkali reserve, ISO 9706:1994, about 2 percent calcium carbonate equivalent; that edition was withdrawn on 29 May 2025 and replaced by ISO 9706:2025"
  abs: 0
  src: ~"../sources/record-and-carriers.spw#src_media_iso_9706_1994"
  edition: "ISO 9706:1994 limits; whether ISO 9706:2025 keeps them was not confirmed"
  as_of: "2026-10-03"
  status: #settled
 }
 %media.paper.iso9706_kappa_max{
  value: 5.0
  unit: "kappa number"
  at: "upper bound on oxidizable matter such as lignin, ISO 9706:1994; that edition was withdrawn on 29 May 2025 and replaced by ISO 9706:2025"
  abs: 0
  src: ~"../sources/record-and-carriers.spw#src_media_iso_9706_1994"
  edition: "ISO 9706:1994 limits; whether ISO 9706:2025 keeps them was not confirmed"
  as_of: "2026-10-03"
  status: #settled
 }
}

#>q_media_print
^"print"{
 %media.print.b42_sort_count{
  value: 290
  unit: "distinct characters"
  at: "type of the 42-line Bible, letters plus ligatures and abbreviations, approximate"
  rel: 0.05
  src: ~"../sources/record-and-carriers.spw#src_media_enc_gutenberg_bible"
  status: #settled
 }
 %media.print.ink_water_surface_tension_mn_m{
  value: 71.99
  unit: "mN/m"
  at: "pure water against air, 25 C; the base of water-borne writing inks"
  rel: 0.001
  src: ~"../sources/materials-and-engineering.spw#src_mateng_crc_handbook"
  status: #settled
 }
}

#>q_media_reading
^"reading"{
 %media.reading.kindle_launch_price_usd{
  value: 399
  unit: "USD, nominal"
  at: "first Amazon Kindle at launch, 19 November 2007"
  abs: 0
  src: ~"../sources/record-and-carriers.spw#src_media_enc_kindle"
  status: #settled
 }
}
