# Quantities: Provenance and Reference
#
# World metric cells for provenance, review, plan, and reference-library surfaces. Each handle names one counted or sourced value; files read it instead of restating it.

#>registry_qty_provenance_and_reference
#:layer #!reference
#:domain #!registry
#:form #!registry
#:level #!practitioner
#:review #!sourced
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[ "raw counts computed with git show at commit 229aedcf and sha256 per path", "migration counts tallied from the plan v2 migration rows", "gap cells counted from the plan v2 tree on 2026-10-02 with the form mapping stated in the gap table" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r5"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "invented-effect count moved to verify; round-two and keep cells reworded to match the record"
  }
  ^["r6"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r7"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "Encyclopedie volume cells now cite the ARTFL project for the folio; Darnton covers the later quarto and octavo editions"
  }
  ^["r8"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 status_legend: "settled cells were counted or read from the linked source; verify cells hold a reported value that must be checked against the source table before use"
}

^["family"]{
 operator: "%"
 plane: world
 scope: corpus
 scheme: tol
 algorithm: world.registry_lookup
 form: scalar
 ^["raw"]{ id: prov_raw, identifiers: #[ prov.raw ] }
 ^["migration"]{ id: prov_migration, identifiers: #[ prov.migration ] }
 ^["review"]{ id: prov_review, identifiers: #[ prov.review ] }
 ^["plan"]{ id: prov_plan, identifiers: #[ prov.plan ] }
 ^["gap"]{ id: prov_gap, identifiers: #[ prov.gap ] }
 ^["reference"]{
  id: prov_reference
  identifiers: #[ prov.yongle, prov.encyclopedie, prov.luhmann, prov.mendeleev, prov.dcmes, prov.oais, prov.bm25, prov.oa, prov.ddc, prov.wilkins, prov.llull ]
 }
}

#>q_prov_raw
^"raw"{
 %prov.raw.file_count{
  value: 208
  unit: "file"
  at: "paths under .spw/caches in migration scope at commit 229aedcf, the shelf index included and resume/ excluded"
  abs: 0
  src: ~"../sources/provenance-and-reference.spw#src_prov_raw_shelf"
  status: #settled
 }
 %prov.raw.line_count{
  value: 14266
  unit: "line"
  at: "newline count summed over the 208 paths at commit 229aedcf"
  abs: 0
  src: ~"../sources/provenance-and-reference.spw#src_prov_raw_shelf"
  status: #settled
 }
 %prov.raw.quarantine_file_count{
  value: 9
  unit: "file"
  at: "files the shelf index lists as do-not-cite at commit 229aedcf"
  abs: 0
  src: ~"../sources/provenance-and-reference.spw#src_prov_shelf_index"
  status: #settled
 }
}

#>q_prov_migration
^"migration"{
 %prov.migration.keep_count{
  value: 83
  unit: "file"
  at: "raw paths the plan migration marks keep, the shelf index included; the manifest writes that row as out of scope, so 82 keep rows appear there"
  abs: 0
  src: ~"../sources/provenance-and-reference.spw#src_prov_plan_v2"
  status: #settled
 }
 %prov.migration.merge_count{
  value: 47
  unit: "file"
  at: "raw paths the plan folds into another surface"
  abs: 0
  src: ~"../sources/provenance-and-reference.spw#src_prov_plan_v2"
  status: #settled
 }
 %prov.migration.drop_count{
  value: 42
  unit: "file"
  at: "raw paths dropped from the authored tree and recorded only in the manifest"
  abs: 0
  src: ~"../sources/provenance-and-reference.spw#src_prov_plan_v2"
  status: #settled
 }
 %prov.migration.split_count{
  value: 16
  unit: "file"
  at: "raw paths split across two or more surfaces"
  abs: 0
  src: ~"../sources/provenance-and-reference.spw#src_prov_plan_v2"
  status: #settled
 }
 %prov.migration.reframe_count{
  value: 11
  unit: "file"
  at: "raw paths rewritten under a new frame"
  abs: 0
  src: ~"../sources/provenance-and-reference.spw#src_prov_plan_v2"
  status: #settled
 }
 %prov.migration.quarantine_count{
  value: 9
  unit: "file"
  at: "raw paths quarantined by the owner; successors are written from sources"
  abs: 0
  src: ~"../sources/provenance-and-reference.spw#src_prov_plan_v2"
  status: #settled
 }
}

