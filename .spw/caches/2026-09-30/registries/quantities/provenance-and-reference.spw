  value: 49
  unit: "claim"
  at: "invented effect sizes in round-one wonder hypotheses; the scorecard writes about 49, a reviewer estimate, not a recount"
  abs: 5
  src: ~"../sources/provenance-and-reference.spw#src_prov_scorecard"
  status: #verify
 }
 %prov.review.r2_file_count{
  value: 52
  unit: "file"
  at: "files the 13:28 round-two snapshot held beyond round one, as the scorecard header counts them; the shelf at 229aedcf holds 55 paths in the round-two folders"
  abs: 0
  src: ~"../sources/provenance-and-reference.spw#src_prov_scorecard"
  status: #settled
 }
}

