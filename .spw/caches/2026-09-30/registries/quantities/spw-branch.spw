# Quantities: Spw Branch
#
# Counts the reflexive spw class reads: code inventories pinned to a commit, study measurements still to recheck, persona verdict tallies, cut receipts pinned to a commit, and the research numbers the reading surfaces cite.

#>q_spw_registry
#:layer #!reference
#:domain #!registry
#:form #!registry
#:level #!mixed
#:review #!adversarial_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r8"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r9"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 status_legend: "settled cells were counted at the named commit or read from the linked source; verify cells hold a study measurement or vendor fact that must be re-run or re-read before use"
 recount: "code and cut counts are dated stills; rerun the command in at, at the commit it names, before citing a cell in a later revision"
 corrections: #[
  "the critic count of 1,091 receipts was itself a still; the live cut cells below were recounted at write time and will drift as wave 3 lands",
  "the three editor cells moved from verify to settled after a recount of package.json and a recomputed contrast on 2026-10-03",
  "the two census cells are superseded: since c79a096a census resolves anchored links as spw resolve does, and a rerun reports none broken",
  "the LSP legend moved to semantic-tokens.ts:101-104 at 651b535b with the same types and modifiers",
  "the cut counts and probe ids were recounted over 651b535b on 2026-10-03, and the probe cells were added for the probe registry",
  "the cut and probe cells were working-tree stills marked settled with no commit; the fact check found 2305 receipts later that day, so every cut cell is now pinned to commit 651b535b",
  "the hash-prose, wonder-anchor, read-aloud, wip-file, and Meyer cells moved from verify to settled after a rerun or a re-read on 2026-10-03",
  "the raw-shelf lens and handle counts and the VS Code command and setting counts became cells, so the claims that print them read them"
 ]
}

^["families"]{
 ^["shared"]{ operator: "%", plane: world, scope: corpus, scheme: tol, form: scalar }
 ^["seed"]{ id: spw_seed, identifier: spw.seed }
 ^["cli"]{ id: spw_cli, identifier: spw.cli }
 ^["lsp"]{ id: spw_lsp, identifier: spw.lsp }
 ^["editor"]{ id: spw_editor, identifier: spw.editor }
 ^["corpus"]{ id: spw_corpus, identifier: spw.corpus }
 ^["fam"]{ id: spw_fam, identifier: spw.fam }
 ^["cut"]{ id: spw_cut, identifier: spw.cut }
 ^["research"]{ id: spw_research, identifier: spw.research }
 ^["keys"]{ id: spw_keys, identifier: spw.keys }
 ^["probes"]{ id: spw_probes, identifier: spw.probes }
}

