# Quantities: Economy and Markets
#
# World metric cells for economics, management, and market reading. A dated market number lives here once with its publisher and as_of; files read the handle.

#>registry_qty_economy_and_markets
#:layer #!reference
#:domain #!registry
#:form #!registry
#:level #!mixed
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the DMA fine ceiling now cites the regulation instead of an encyclopedia page",
  "Edison 2024 shares carry a note that the survey wave is not printed on the source page",
  "the 2020 Singles Day cell no longer asserts a window the cited table does not state",
  "fact check: the 2020 Singles Day cell still said the festival ran several days; that unsourced window is removed",
  "fact check: IAB 2024 was 258 with a note that the page truncates; the report gives 258.6, and the page headline rounds to 259"
 ]
 rule: "a market cell names its publisher, period, and as_of; a value nobody has read from its source stays unset with status verify"
 recheck: "on 2026-10-03 the Edison 2024 shares, the four Gauge May 2025 shares, IAB 2025 growth, the Pew sample size, and the Alibaba fine were re-read at their sources and matched; verify cells stay unset"
}

^["families"]{
 ^["iv"]{
  id: econ_iv, operator: "%", identifier: econ.iv, plane: world, scope: corpus
  scheme: tol, algorithm: world.registry_lookup, form: scalar
  keys: #[ staiger_stock_rule_f, lmmp_t5_f ]
 }
 ^["taylor"]{
  id: econ_taylor, operator: "%", identifier: econ.taylor, plane: world, scope: corpus
  scheme: tol, algorithm: world.registry_lookup, form: scalar
  keys: #[ inflation_coeff, output_gap_coeff ]
 }
 ^["food"]{
  id: econ_food, operator: "%", identifier: econ.food, plane: world, scope: corpus
  scheme: tol, algorithm: world.registry_lookup, form: scalar
  keys: #[ cold_hold_max_c, hot_hold_min_c, cool_stage_one_h, cool_total_h, haccp_principles, menu_popularity_factor ]
 }
 ^["hotel"]{
  id: econ_hotel, operator: "%", identifier: econ.hotel, plane: world, scope: corpus
  scheme: tol, algorithm: world.registry_lookup, form: scalar
  keys: #[ ota_commission_pct, lodging_separation_rate_pct, flsa_tipped_cash_wage_usd, dma_max_fine_pct, ritz_empowerment_usd ]
 }
 ^["podcast"]{
  id: econ_podcast, operator: "%", identifier: econ.podcast, plane: world, scope: corpus
  scheme: tol, algorithm: world.registry_lookup, form: scalar
  keys: #[ edison_2024_youtube_pct, edison_2024_spotify_pct, edison_2024_apple_pct, edison_latest_youtube_pct, infinite_dial_monthly_pct, pew_2022_sample_n ]
 }
 ^["tv"]{
  id: econ_tv, operator: "%", identifier: econ.tv, plane: world, scope: corpus
  scheme: tol, algorithm: world.registry_lookup, form: scalar
  keys: #[ gauge_2025_05_streaming_pct, gauge_2025_05_cable_pct, gauge_2025_05_broadcast_pct, gauge_2025_05_youtube_pct, gauge_latest_youtube_pct ]
 }
 ^["ads"]{
  id: econ_ads, operator: "%", identifier: econ.ads, plane: world, scope: corpus
  scheme: tol, algorithm: world.registry_lookup, form: scalar
  keys: #[ iab_us_internet_2024_busd, iab_us_internet_2025_growth_pct ]
 }
 ^["media"]{
  id: econ_media, operator: "%", identifier: econ.media, plane: world, scope: corpus
  scheme: tol, algorithm: world.registry_lookup, form: scalar
  keys: #[ us_print_units_latest_m, us_publishing_revenue_latest_busd, us_box_office_latest_busd, window_2019_home_video_days, window_wb_regal_2022_days ]
 }
 ^["singles"]{
  id: econ_singles, operator: "%", identifier: econ.singles, plane: world, scope: corpus
  scheme: tol, algorithm: world.registry_lookup, form: scalar
  keys: #[ alibaba_gmv_2019_byuan, alibaba_gmv_2020_byuan, alibaba_fine_2021_busd, viya_fine_2021_byuan, viya_2021_sales_byuan ]
 }
}

#>q_econ_iv
^"iv"{
 %econ.iv.staiger_stock_rule_f{
  value: 10, unit: "first-stage F statistic", abs: 0, status: #superseded
  at: "rule of thumb for one endogenous regressor, from Staiger and Stock 1997"
  src: ~"../sources/economy-and-markets.spw#src_econ_staiger_stock_1997"
 }
 %econ.iv.lmmp_t5_f{
  value: 104.7, unit: "first-stage F statistic", abs: 0.1, status: #settled
  at: "F needed for a conventional 2SLS t-test to have a true 5 percent level, one instrument"
  src: ~"../sources/economy-and-markets.spw#src_econ_lee_mccrary_moreira_porter_2022"
 }
}

#>q_econ_taylor
^"taylor"{
 %econ.taylor.inflation_coeff{
  value: 1.5, unit: "1", abs: 0, status: #settled
  at: "implied response of the policy rate to inflation in the Taylor 1993 rule"
  src: ~"../sources/economy-and-markets.spw#src_econ_taylor_1993"
 }
 %econ.taylor.output_gap_coeff{
  value: 0.5, unit: "1", abs: 0, status: #settled
  at: "response of the policy rate to the output gap in the Taylor 1993 rule"
  src: ~"../sources/economy-and-markets.spw#src_econ_taylor_1993"
 }
}

