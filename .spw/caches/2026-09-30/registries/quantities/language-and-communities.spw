# Quantities: Language and Communities
#
# World metric cells for linguistics and community roles. Vowel formants, one review of labor support, and two neighborhood studies, each read many times.

#>q_lang_registry
#:layer #!reference
#:domain #!registry
#:form #!registry
#:level #!mixed
#:review #!adversarial_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r5"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #corrected
  }
  ^["r6"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 rechecked: "labor_support cells against the Bohren 2017 abstract on 2026-10-02; vacant-lot cells against the Branas 2018 full text, Table 2 and the CA-ITT paragraph, on 2026-10-02"
 corrections: [
  "the r4 recheck read only the Branas abstract and labeled 29.1 as greening alone over a 38-month window; it is the complier-adjusted estimate for any lot treatment, greening or cleanup, over an 18-month follow-up",
  "the misnamed handle greening_gun_violence_decrease_pct is kept as superseded; intention-to-treat cells now sit beside the complier-adjusted one"
 ]
 note: "few cells on purpose: the raw shelf minted one invented handle per wonder; these are measured values with named sources"
}

^["families"]{
 ^["vowel"]{
  id: lang_vowel, operator: "%", identifier: lang.vowel, plane: world, scope: corpus
  keys: #[ i_f1_hz, i_f2_hz, i_f3_hz, u_f1_hz, u_f2_hz, a_f1_hz, a_f2_hz, er_f3_hz ]
 }
 ^["labor_support"]{
  id: lang_labor_support, operator: "%", identifier: lang.labor_support, plane: world
  keys: #[ cesarean_rr, cesarean_ci_low, cesarean_ci_high, trials_count, women_count ]
 }
 ^["neighborhood"]{
  id: lang_neighborhood, operator: "%", identifier: lang.neighborhood, plane: world
  keys: #[ efficacy_residents_count, efficacy_neighborhoods_count, greening_lots_count ]
  trial_keys: #[ lot_gun_assault_caitt_drop_pct, lot_gun_assault_itt_drop_pct ]
  arm_keys: #[ greening_gun_assault_itt_drop_pct ]
  superseded_keys: #[ greening_gun_violence_decrease_pct ]
 }
 scheme: tol
 algorithm: world.registry_lookup
 form: scalar
}

#>q_lang_vowel
^"vowel"{
 %lang.vowel.i_f1_hz{
  value: 270
  unit: "Hz"
  at: "first formant of the vowel in heed, mean of adult male speakers, American English"
  abs: 5
  src: ~"../sources/language-and-communities.spw#src_lang_peterson_barney_1952"
  status: #settled
 }
