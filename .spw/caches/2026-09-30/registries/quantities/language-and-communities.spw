#>q_lang_labor_support
^"labor_support"{
 %lang.labor_support.cesarean_rr{
  value: 0.75
  unit: "risk ratio"
  at: "caesarean birth, continuous labor support vs usual care, 24 trials, low-quality evidence, review version 2017"
  rel: 0
  src: ~"../sources/language-and-communities.spw#src_lang_bohren_2017"
  status: #settled
 }
 %lang.labor_support.cesarean_ci_low{
  value: 0.64
  unit: "risk ratio"
  at: "lower bound of the 95 percent confidence interval for the caesarean risk ratio"
  rel: 0
  src: ~"../sources/language-and-communities.spw#src_lang_bohren_2017"
  status: #settled
 }
 %lang.labor_support.cesarean_ci_high{
  value: 0.88
  unit: "risk ratio"
  at: "upper bound of the 95 percent confidence interval for the caesarean risk ratio"
  rel: 0
  src: ~"../sources/language-and-communities.spw#src_lang_bohren_2017"
  status: #settled
 }
 %lang.labor_support.trials_count{
  value: 26
  unit: "trial"
  at: "trials contributing data to the 2017 review, across 17 countries"
  abs: 0
  src: ~"../sources/language-and-communities.spw#src_lang_bohren_2017"
  status: #settled
 }
 %lang.labor_support.women_count{
  value: 15858
  unit: "person"
  at: "women in the trials contributing data to the 2017 review"
  abs: 0
  src: ~"../sources/language-and-communities.spw#src_lang_bohren_2017"
  status: #settled
 }
}

#>q_lang_neighborhood
^"neighborhood"{
 %lang.neighborhood.efficacy_residents_count{
  value: 8782
  unit: "person"
  at: "residents surveyed in 1995 for the Chicago collective-efficacy study"
  abs: 0
  src: ~"../sources/language-and-communities.spw#src_lang_sampson_1997"
  status: #settled
 }
 %lang.neighborhood.efficacy_neighborhoods_count{
  value: 343
  unit: "neighborhood cluster"
  at: "Chicago neighborhood clusters in the collective-efficacy study"
  abs: 0
  src: ~"../sources/language-and-communities.spw#src_lang_sampson_1997"
  status: #settled
 }
 %lang.neighborhood.greening_lots_count{
  value: 541
  unit: "vacant lot"
  at: "randomly sampled Philadelphia vacant lots assigned to greening, trash cleanup, or no intervention"
  abs: 0
  src: ~"../sources/language-and-communities.spw#src_lang_branas_2018"
  status: #settled
 }
 %lang.neighborhood.greening_gun_violence_decrease_pct{
  value: 29.1
  unit: "percent decrease"
  at: "gun violence near greened lots in neighborhoods below the poverty line, 38-month window"
  abs: 0.1
  src: ~"../sources/language-and-communities.spw#src_lang_branas_2018"
  status: #settled
 }
}
