  abs: 0
  src: ~"../sources/materials-and-engineering.spw#src_mateng_bsl_2002"
  status: #settled
 }
}

#>q_mateng_quality
^"quality"{
 %mateng.quality.six_sigma_dpmo{
  value: 3.4
  unit: "defects per million opportunities"
  at: "six sigma convention that assumes a 1.5 sigma long-term drift of the mean"
  abs: 0.1
  src: ~"../sources/materials-and-engineering.spw#src_mateng_montgomery_2020"
  status: #settled
 }
}
