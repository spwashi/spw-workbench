  status: #settled
 }
 %mateng.transport.pump_power_d_exp_blasius{
  value: 4.75
  unit: "1"
  at: "same exponent for smooth-pipe turbulent flow with the Blasius friction factor"
  abs: 0
  src: ~"../sources/materials-and-engineering.spw#src_mateng_bsl_2002"
  status: #settled
 }
 %mateng.transport.pump_power_d_exp_rough{
  value: 5
  unit: "1"
