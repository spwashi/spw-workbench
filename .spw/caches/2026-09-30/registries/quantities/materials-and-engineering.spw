# Quantities: Materials and Engineering
#
# World metric cells for the materials and engineering branches. A handle names one cell; files read it instead of restating the number, and a verify cell is a question, not a fact.

#>q_mateng_registry
#:layer #!reference
#:domain #!registry
#:form #!registry
#:level #!mixed
#:review #!sourced
#:valence #!bone

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "claude-opus-5.5", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the water triple point carried abs 0 as if exact; since the 2019 SI redefinition it is measured, near 0.1 mK standard uncertainty, and the cell now cites the SI Brochure",
  "the Dzudzuana fiber age cell is marked contested, since the identification of the fibers as flax is disputed",
  "cells are written four lines each so the registry stays near the size advisory; values and handles are unchanged"
 ]
 added: "gamma_delta_t_c and fe_melt_t_c complete the pure-iron ladder; n_hydrocerussite_omega gives the lead white index the pentimento wonder reads"
 status_legend: "settled cells were read from the linked source; verify cells hold a reported value that must be checked against the current edition before use"
}

^["families"]{
 ^["shared"]{ operator: "%", plane: world, scope: corpus, scheme: tol, form: scalar }
 ^["lookup"]{ algorithm: world.registry_lookup }
 ^["water"]{ id: mateng_water, identifier: mateng.water }
 ^["fe_c"]{ id: mateng_fe_c, identifier: mateng.fe_c }
 ^["steel"]{ id: mateng_steel, identifier: mateng.steel }
 ^["silicon"]{ id: mateng_silicon, identifier: mateng.silicon }
 ^["polymer"]{ id: mateng_polymer, identifier: mateng.polymer }
 ^["pigment"]{ id: mateng_pigment, identifier: mateng.pigment }
 ^["chron"]{ id: mateng_chron, identifier: mateng.chron }
 ^["nano"]{ id: mateng_nano, identifier: mateng.nano }
 ^["transport"]{ id: mateng_transport, identifier: mateng.transport }
 ^["quality"]{ id: mateng_quality, identifier: mateng.quality }
 ^["co2"]{ id: mateng_co2, identifier: mateng.co2 }
 ^["cpu"]{ id: mateng_cpu, identifier: mateng.cpu }
 ^["econ"]{ id: mateng_econ, identifier: mateng.econ }
}

^["keys"]{
 water: #[ cp_j_per_g_k, t_rho_max_c, rho_ice_g_cm3, rho_liquid_max_g_cm3, epsilon_r, dipole_debye, hoh_angle_deg, dh_vap_kj_per_mol, triple_point_k, triple_point_pa, critical_t_k, critical_p_mpa ]
 fe_c: #[ eutectoid_t_c, eutectoid_c_wt_pct, austenite_c_max_wt_pct, ferrite_c_max_wt_pct, alpha_gamma_t_c, gamma_delta_t_c, fe_melt_t_c ]
 steel: #[ stainless_cr_min_wt_pct, co2_share_energy_pct ]
 silicon: #[ bandgap_ev ]
 polymer: #[ pmma_tg_c, pmma_n_d, flory_nu_3d, eta_mw_exponent ]
 pigment: #[ n_rutile, n_hydrocerussite_omega, n_linseed_oil ]
 chron: #[ blombos_ochre_ka, sulawesi_stencil_min_ka, chauvet_early_start_ka, chauvet_early_end_ka, dzudzuana_flax_ka ]
 nano: #[ tbg_magic_angle_deg, stem_probe_pm ]
 transport: #[ pipe_laminar_re_max, pump_power_d_exp_laminar, pump_power_d_exp_blasius, pump_power_d_exp_rough ]
 quality: #[ six_sigma_dpmo ]
 co2: #[ triple_point_k, triple_point_mpa, critical_t_k, critical_p_mpa ]
 cpu: #[ classic_pipeline_stages ]
 econ: #[ macrs_5yr_y1_pct ]
}

#>q_mateng_water
^"water"{
 %mateng.water.cp_j_per_g_k{
  value: 4.181, unit: "J/(g K)", rel: 0.001
  at: "liquid water, 25 C, 1 atm", src: ~"../sources/materials-and-engineering.spw#src_mateng_crc_handbook", status: #settled
 }
 %mateng.water.t_rho_max_c{
  value: 3.98, unit: "C", abs: 0.01
  at: "liquid water, 1 atm", src: ~"../sources/materials-and-engineering.spw#src_mateng_crc_handbook", status: #settled
 }
 %mateng.water.rho_ice_g_cm3{
  value: 0.9167, unit: "g/cm^3", rel: 0.001
  at: "ice Ih, 0 C, 1 atm", src: ~"../sources/materials-and-engineering.spw#src_mateng_crc_handbook", status: #settled
 }
 %mateng.water.rho_liquid_max_g_cm3{
  value: 0.99997, unit: "g/cm^3", rel: 0.0001
  at: "liquid water at its density maximum, 1 atm", src: ~"../sources/materials-and-engineering.spw#src_mateng_crc_handbook", status: #settled
 }
 %mateng.water.epsilon_r{
  value: 78.4, unit: "1", rel: 0.005
  at: "static relative permittivity, liquid, 25 C", src: ~"../sources/materials-and-engineering.spw#src_mateng_crc_handbook", status: #settled
 }
 %mateng.water.dipole_debye{
  value: 1.85, unit: "D", rel: 0.01
  at: "isolated molecule, gas phase", src: ~"../sources/materials-and-engineering.spw#src_mateng_crc_handbook", status: #settled
 }
 %mateng.water.hoh_angle_deg{
  value: 104.5, unit: "degree", abs: 0.1
  at: "isolated molecule, gas phase", src: ~"../sources/materials-and-engineering.spw#src_mateng_eisenberg_kauzmann", status: #settled
 }
 %mateng.water.dh_vap_kj_per_mol{
  value: 40.65, unit: "kJ/mol", rel: 0.002
  at: "normal boiling point, 100 C, 1 atm", src: ~"../sources/materials-and-engineering.spw#src_mateng_crc_handbook", status: #settled
 }
 %mateng.water.triple_point_k{
  value: 273.16, unit: "K", abs: 0.0001
  at: "triple point of ordinary water; exact by definition before the 2019 SI redefinition, measured since, with standard uncertainty near 0.1 mK", src: ~"../sources/materials-and-engineering.spw#src_mateng_si_brochure_2019", status: #settled
 }
 %mateng.water.triple_point_pa{
  value: 611.657, unit: "Pa", abs: 0.01
  at: "triple point pressure, IAPWS-95", src: ~"../sources/materials-and-engineering.spw#src_mateng_wagner_pruss_2002", status: #settled
 }
 %mateng.water.critical_t_k{
  value: 647.096, unit: "K", abs: 0.001
  at: "critical temperature, IAPWS-95", src: ~"../sources/materials-and-engineering.spw#src_mateng_wagner_pruss_2002", status: #settled
 }
 %mateng.water.critical_p_mpa{
  value: 22.064, unit: "MPa", abs: 0.001
  at: "critical pressure, IAPWS-95", src: ~"../sources/materials-and-engineering.spw#src_mateng_wagner_pruss_2002", status: #settled
 }
}

#>q_mateng_fe_c
^"iron_carbon"{
 %mateng.fe_c.eutectoid_t_c{
  value: 727, unit: "C", abs: 1
  at: "eutectoid reaction on the Fe-Fe3C diagram", src: ~"../sources/materials-and-engineering.spw#src_mateng_callister_rethwisch_2018", status: #settled
 }
 %mateng.fe_c.eutectoid_c_wt_pct{
  value: 0.76, unit: "wt percent C", abs: 0.01
  at: "eutectoid composition, Fe-Fe3C diagram", src: ~"../sources/materials-and-engineering.spw#src_mateng_callister_rethwisch_2018", status: #settled
 }
 %mateng.fe_c.austenite_c_max_wt_pct{
  value: 2.14, unit: "wt percent C", abs: 0.01
  at: "maximum carbon solubility in austenite, at 1147 C", src: ~"../sources/materials-and-engineering.spw#src_mateng_callister_rethwisch_2018", status: #settled
 }
 %mateng.fe_c.ferrite_c_max_wt_pct{
  value: 0.022, unit: "wt percent C", abs: 0.001
  at: "maximum carbon solubility in alpha ferrite, at 727 C", src: ~"../sources/materials-and-engineering.spw#src_mateng_callister_rethwisch_2018", status: #settled
 }
 %mateng.fe_c.alpha_gamma_t_c{
  value: 912, unit: "C", abs: 1
  at: "alpha ferrite to austenite transition in pure iron", src: ~"../sources/materials-and-engineering.spw#src_mateng_callister_rethwisch_2018", status: #settled
 }
 %mateng.fe_c.gamma_delta_t_c{
  value: 1394, unit: "C", abs: 1
  at: "austenite to delta ferrite transition in pure iron", src: ~"../sources/materials-and-engineering.spw#src_mateng_callister_rethwisch_2018", status: #settled
 }
 %mateng.fe_c.fe_melt_t_c{
  value: 1538, unit: "C", abs: 1
  at: "melting point of pure iron, top of the Fe-Fe3C diagram", src: ~"../sources/materials-and-engineering.spw#src_mateng_callister_rethwisch_2018", status: #settled
 }
}

#>q_mateng_steel
^"steel"{
 %mateng.steel.stainless_cr_min_wt_pct{
  value: 10.5, unit: "wt percent Cr", abs: 0
  at: "minimum chromium in the European definition of stainless steel, EN 10088-1:2014", src: ~"../sources/materials-and-engineering.spw#src_mateng_en_10088_1", status: #settled
 }
 %mateng.steel.co2_share_energy_pct{
  value: 7, unit: "percent", abs: 1
  at: "iron and steel share of global energy-system CO2 as reported in the 2020 roadmap; recheck against the current IEA edition", src: ~"../sources/materials-and-engineering.spw#src_mateng_iea_2020_steel", status: #verify
 }
}

#>q_mateng_silicon
^"silicon"{
 %mateng.silicon.bandgap_ev{
  value: 1.12, unit: "eV", abs: 0.01
  at: "indirect band gap of silicon at 300 K", src: ~"../sources/materials-and-engineering.spw#src_mateng_sze_ng_2007", status: #settled
 }
}

#>q_mateng_polymer
^"polymer"{
 %mateng.polymer.pmma_tg_c{
  value: 105, unit: "C", abs: 5
  at: "glass transition of atactic PMMA; tacticity and molar mass shift it", src: ~"../sources/materials-and-engineering.spw#src_mateng_brandrup_1999", status: #settled
 }
 %mateng.polymer.pmma_n_d{
  value: 1.49, unit: "1", abs: 0.01
  at: "refractive index of PMMA at the sodium D line", src: ~"../sources/materials-and-engineering.spw#src_mateng_brandrup_1999", status: #settled
 }
 %mateng.polymer.flory_nu_3d{
  value: 0.588, unit: "1", abs: 0.001
  at: "size exponent of a self-avoiding chain in three dimensions; the Flory estimate is 3/5", src: ~"../sources/materials-and-engineering.spw#src_mateng_rubinstein_colby_2003", status: #settled
 }
 %mateng.polymer.eta_mw_exponent{
  value: 3.4, unit: "1", abs: 0.1
  at: "measured exponent of zero-shear viscosity on molar mass for entangled linear melts; pure reptation predicts 3", src: ~"../sources/materials-and-engineering.spw#src_mateng_rubinstein_colby_2003", status: #settled
 }
}

#>q_mateng_pigment
^"pigment"{
 %mateng.pigment.n_rutile{
  value: 2.7, unit: "1", abs: 0.15
  at: "titanium dioxide, rutile, mean of the two principal indices near 589 nm", src: ~"../sources/materials-and-engineering.spw#src_mateng_crc_handbook", status: #settled
 }
 %mateng.pigment.n_hydrocerussite_omega{
  value: 2.09, unit: "1", abs: 0.01
  at: "ordinary-ray index of hydrocerussite, the main phase of lead white; the extraordinary-ray index is 1.94", src: ~"../sources/materials-and-engineering.spw#src_mateng_anthony_2003", status: #settled
 }
 %mateng.pigment.n_linseed_oil{
  value: 1.48, unit: "1", abs: 0.02
  at: "dried linseed oil binder; value varies with age and oxidation", src: ~"../sources/materials-and-engineering.spw#src_mateng_mayer_1991", status: #verify
 }
}

#>q_mateng_chron
^"chronology"{
 %mateng.chron.blombos_ochre_ka{
  value: 100, unit: "ka", abs: 5
  at: "ochre-processing kit in abalone shells, Blombos Cave, South Africa", src: ~"../sources/materials-and-engineering.spw#src_mateng_henshilwood_2011", status: #settled
 }
 %mateng.chron.sulawesi_stencil_min_ka{
  value: 39.9, unit: "ka", abs: 0.1
  at: "minimum uranium-series age of the oldest dated hand stencil, Maros karsts, Sulawesi", src: ~"../sources/materials-and-engineering.spw#src_mateng_aubert_2014", status: #settled
 }
 %mateng.chron.chauvet_early_start_ka{
  value: 37, unit: "ka cal BP", abs: 1
  at: "start of the first human activity phase in Chauvet-Pont d Arc cave", src: ~"../sources/materials-and-engineering.spw#src_mateng_quiles_2016", status: #settled
 }
 %mateng.chron.chauvet_early_end_ka{
  value: 33.5, unit: "ka cal BP", abs: 0.5
  at: "end of the first human activity phase in Chauvet-Pont d Arc cave", src: ~"../sources/materials-and-engineering.spw#src_mateng_quiles_2016", status: #settled
 }
 %mateng.chron.dzudzuana_flax_ka{
  value: 30, unit: "ka BP", abs: 3
  at: "age named in the report title for fibers at Dzudzuana Cave, Georgia, layers dated 32 to 26 ka BP; their identification as flax is disputed by Bergfjord and coworkers 2010", src: ~"../sources/materials-and-engineering.spw#src_mateng_kvavadze_2009", status: #contested
 }
}

#>q_mateng_nano
^"nanoscale"{
 %mateng.nano.tbg_magic_angle_deg{
  value: 1.1, unit: "degree", abs: 0.1
  at: "twist angle of bilayer graphene showing correlated insulating and superconducting states", src: ~"../sources/materials-and-engineering.spw#src_mateng_cao_2018", status: #settled
 }
 %mateng.nano.stem_probe_pm{
  value: 50, unit: "pm", abs: 0
  at: "upper bound on the aberration-corrected electron probe size reported in 2009", src: ~"../sources/materials-and-engineering.spw#src_mateng_erni_2009", status: #settled
 }
}

#>q_mateng_transport
^"transport"{
 %mateng.transport.pipe_laminar_re_max{
  value: 2100, unit: "1", abs: 200
  at: "pipe Reynolds number below which flow is reliably laminar in the BSL convention; transition depends on disturbances", src: ~"../sources/materials-and-engineering.spw#src_mateng_bsl_2002", status: #settled
 }
 %mateng.transport.pump_power_d_exp_laminar{
  value: 4, unit: "1", abs: 0
  at: "exponent n in pumping power proportional to D to the minus n, fixed volumetric flow, Hagen-Poiseuille flow", src: ~"../sources/materials-and-engineering.spw#src_mateng_bsl_2002", status: #settled
 }
 %mateng.transport.pump_power_d_exp_blasius{
  value: 4.75, unit: "1", abs: 0
  at: "same exponent for smooth-pipe turbulent flow with the Blasius friction factor", src: ~"../sources/materials-and-engineering.spw#src_mateng_bsl_2002", status: #settled
 }
 %mateng.transport.pump_power_d_exp_rough{
  value: 5, unit: "1", abs: 0
  at: "same exponent for fully rough turbulent flow with a constant friction factor", src: ~"../sources/materials-and-engineering.spw#src_mateng_bsl_2002", status: #settled
 }
}

#>q_mateng_quality
^"quality"{
 %mateng.quality.six_sigma_dpmo{
  value: 3.4, unit: "defects per million opportunities", abs: 0.1
  at: "six sigma convention that assumes a 1.5 sigma long-term drift of the mean", src: ~"../sources/materials-and-engineering.spw#src_mateng_montgomery_2020", status: #settled
 }
}

