  value: 304.1282, unit: "K", abs: 0.015
  at: "critical temperature of carbon dioxide, Span-Wagner equation of state", src: ~"../sources/materials-and-engineering.spw#src_mateng_span_wagner_1996", status: #settled
 }
 %mateng.co2.critical_p_mpa{
  value: 7.3773, unit: "MPa", abs: 0.003
  at: "critical pressure of carbon dioxide, Span-Wagner equation of state", src: ~"../sources/materials-and-engineering.spw#src_mateng_span_wagner_1996", status: #settled
 }
}

#>q_mateng_cpu
^"cpu"{
 %mateng.cpu.classic_pipeline_stages{
  value: 5, unit: "stages", abs: 0
  at: "textbook RISC pipeline: fetch, decode, execute, memory, write-back", src: ~"../sources/materials-and-engineering.spw#src_mateng_patterson_hennessy_2017", status: #settled
 }
}

#>q_mateng_econ
^"economics"{
 %mateng.econ.macrs_5yr_y1_pct{
  value: 20, unit: "percent of basis", abs: 0
  at: "first-year rate, 5-year MACRS property, half-year convention, IRS Publication 946 Table A-1; recheck the current edition before use", src: ~"../sources/materials-and-engineering.spw#src_mateng_irs_pub_946", status: #verify
 }
}
