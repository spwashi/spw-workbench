# Quantities: Spw Glossary and Specimens
#
# Reflexive cells for the glossary and specimen surfaces: label spread across the operator naming tables, particle aims, and the loudness census of the specimen batteries. Every cell is computed from repository text at one commit.

#>q_gloss_registry
#:layer #!reference
#:domain #!registry
#:form #!registry
#:level #!mixed
#:review #!sourced
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 entropy_rule: "label spread is the Shannon entropy in bits of the first label word per table, case-folded, with integrate and integration, and config and configuration, counted as one stem"
 census_rule: "specimen counts come from the writer probe run; a row is validator when the parse warns, gate when it has a lexer error, a cross-line swallow, or a cut-banned character outside double quotes, and silent otherwise"
 recount: "on 2026-10-03 the writer replayed all specimen rows against the parser and recounted the batteries; rows, silent, gate, and validator counts matched every spec cell, and the five naming tables were re-read"
 status_legend: "every cell here is settled at commit 1aa1dc23; a later parser or canon change makes it a historical reading, not a wrong one"
}

^["families"]{
 ^["shared"]{ operator: "%", plane: world, scope: corpus, scheme: tol, form: scalar }
 ^["lookup"]{ algorithm: world.registry_lookup }
 ^["naming"]{ id: gloss_naming, identifier: gloss.naming }
 ^["lexer"]{ id: gloss_lexer, identifier: gloss.lexer }
 ^["spec"]{ id: gloss_spec, identifier: gloss.spec }
 ^["terms"]{ id: gloss_terms, identifier: gloss.terms }
}

^["keys"]{
 naming: #[ tables_n, hash_label_bits, dot_label_bits, equals_label_bits, amp_label_bits, caret_label_bits, dollar_label_bits ]
 lexer: #[ particle_aims_n, lattice_aims_n ]
 spec: #[ rows_n, silent_n, gate_n, validator_n ]
 terms: #[ lens_senses_n, cut_senses_n ]
}

#>q_gloss_naming
^"naming"{
 %gloss.naming.tables_n{
  value: 5, unit: "tables", abs: 0
  at: "operators.spw, type-affinities.ts, register-bank.spw, geometry-inspect.ts, form-ladders.ts at 1aa1dc23", src: ~"../sources/spw-glossary-specimens.spw#src_gloss_naming_tables", status: #settled
 }
 %gloss.naming.hash_label_bits{
  value: 1.371, unit: "bit", abs: 0.001
  at: "# named resonance three times, vibration once, annotation once", src: ~"../sources/spw-glossary-specimens.spw#src_gloss_naming_tables", status: #settled
 }
 %gloss.naming.dot_label_bits{
  value: 0.971, unit: "bit", abs: 0.001
  at: ". named ground three times and subject twice", src: ~"../sources/spw-glossary-specimens.spw#src_gloss_naming_tables", status: #settled
 }
 %gloss.naming.equals_label_bits{
  value: 0.971, unit: "bit", abs: 0.001
  at: "= named configuration three times and set twice", src: ~"../sources/spw-glossary-specimens.spw#src_gloss_naming_tables", status: #settled
 }
 %gloss.naming.amp_label_bits{
  value: 0.722, unit: "bit", abs: 0.001
  at: "& named confluence four times and subject once", src: ~"../sources/spw-glossary-specimens.spw#src_gloss_naming_tables", status: #settled
 }
 %gloss.naming.caret_label_bits{
  value: 0.722, unit: "bit", abs: 0.001
  at: "^ named integration four times and ascension once", src: ~"../sources/spw-glossary-specimens.spw#src_gloss_naming_tables", status: #settled
 }
 %gloss.naming.dollar_label_bits{
  value: 0.722, unit: "bit", abs: 0.001
  at: "$ named substrate four times and select once", src: ~"../sources/spw-glossary-specimens.spw#src_gloss_naming_tables", status: #settled
 }
}

#>q_gloss_lexer
^"lexer"{
 %gloss.lexer.particle_aims_n{
  value: 3, unit: "aims", abs: 0
  at: "aims lexed as PARTICLE tokens, packages/spw-seed/src/lexer/matchers/particles.ts:20", src: ~"../sources/spw-branch.spw#src_spw_seed_lexer", status: #settled
 }
 %gloss.lexer.lattice_aims_n{
  value: 5, unit: "aims", abs: 0
  at: "aims named in the canon lattice list, docs/theory/spw/apposition.spw:33", src: ~"../sources/spw-branch.spw#src_spw_canon_apposition", status: #settled
 }
}

#>q_gloss_spec
^"spec"{
 %gloss.spec.rows_n{
  value: 120, unit: "rows", abs: 0
  at: "six specimen batteries under spw/specimens, probed at 1aa1dc23", src: ~"../sources/spw-glossary-specimens.spw#src_gloss_parser_probes", status: #settled
 }
 %gloss.spec.silent_n{
  value: 79, unit: "rows", abs: 0
  at: "rows no tool reports", src: ~"../sources/spw-glossary-specimens.spw#src_gloss_parser_probes", status: #settled
 }
 %gloss.spec.gate_n{
  value: 28, unit: "rows", abs: 0
  at: "rows the cut gate fails while the validator passes", src: ~"../sources/spw-glossary-specimens.spw#src_gloss_parser_probes", status: #settled
 }
 %gloss.spec.validator_n{
  value: 13, unit: "rows", abs: 0
  at: "rows that degrade to prose, which the validator warns on and the gate fails", src: ~"../sources/spw-glossary-specimens.spw#src_gloss_parser_probes", status: #settled
 }
}

#>q_gloss_terms
^"terms"{
 %gloss.terms.lens_senses_n{
  value: 4, unit: "senses", abs: 0
  at: "the LSP case kind, the lens reading, the banned comment form, and the emit lenses list", src: ~"../sources/spw-branch.spw#src_spw_study_render", status: #settled
 }
 %gloss.terms.cut_senses_n{
  value: 3, unit: "senses", abs: 0
  at: "this dated cut, pulse --cut, and delta comparing two cuts", src: ~"../sources/spw-branch.spw#src_spw_cli_commands", status: #settled
 }
}
