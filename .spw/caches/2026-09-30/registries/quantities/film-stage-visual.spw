# Quantities: Film, Stage, and Visual Arts
#
# World cells for the making branch: rest rules, contract terms, copyright years, frame and loudness standards, craft counts, and one adaptation case.

#>registry_qty_film_stage_visual
#:layer #!reference
#:domain #!registry
#:form #!registry
#:level #!practitioner
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #sourced, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #partial }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-01", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
 }
 corrections: [ "the 95-year term from publication covers works published 1923 to 1977, not 1927 to 1977; works from 1923 to 1963 also needed renewal, and by 2026 the term still runs only for 1931 to 1977 publications" ]
 note: "cells marked verify hold a value the writer could not confirm against the current edition"
 rechecked: "the 2021 IATSE terms, the Martian timeline, and the worldwide gross were matched again on 2026-10-02; the WGA 2026 term was read on wga.org and the DGA 2026 start on dga.org"
}

^["families"]{
 labor: #[ iatse.turnaround_h, iatse.weekend_rest_h, sagaftra.rest_period_h, meal.first_meal_h ]
 terms: #[ iatse.ba_2021_term, iatse.ba_2024_expiry, wga.mba_2023_expiry, sagaftra.tvth_2023_expiry, dga.ba_2023_expiry, wga.mba_2026_term, dga.ba_2026_start ]
 strikes: #[ iatse.strike_vote_2021_pct, wga.strike_2023_window, sagaftra.strike_2023_window, guilds.cycle_2026_status ]
 rights: #[ us_copyright.term_years, us_pd.through_pub_year, us_pd.next_pub_year ]
 image: #[ aspect.silent_ratio, aspect.academy_ratio, aspect.scope_ratio, frame.sound_fps ]
 loudness: #[ loudness.ebu_r128_lufs, loudness.atsc_a85_lkfs, loudness.netflix_dialog_lkfs, loudness.cinema_ref_dbc ]
 craft: #[ animation.principles_count, animation.on_twos_drawings_s, comics.transition_types, viewpoints.overlie_count, viewpoints.physical_count ]
 case: #[ martian.serial_start_year, martian.kindle_price_usd, martian.kindle_copies_3mo, martian.rights_month, martian.crown_pub_month, martian.us_release, martian.worldwide_gross_usd, martian.oscar_noms ]
 design: #[ eu_battery.removable_from ]
 operator: "%"
 plane: world
 scope: corpus
 algorithm: world.registry_lookup
}

#>q_film_labor
^"labor"{
