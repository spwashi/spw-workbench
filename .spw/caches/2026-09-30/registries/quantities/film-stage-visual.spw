  at: "performer rest between work days, SAG-AFTRA TV and theatrical terms, before stated reductions"
  src: ~"../sources/film-stage-visual.spw#src_film_sagaftra_tvth_2023"
  status: #settled
 }
 %film.meal.first_meal_h{
