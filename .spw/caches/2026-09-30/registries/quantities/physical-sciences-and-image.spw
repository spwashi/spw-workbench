  src: ~"../sources/physical-sciences-and-image.spw#src_phys_smith_2008"
  status: #settled
 }
 %phys.optics.line_f_nm{
  value: 486.13, unit: "nm", abs: 0.01
  at: "hydrogen F line, blue end of the Abbe number"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_smith_2008"
  status: #settled
 }
 %phys.optics.line_c_nm{
  value: 656.27, unit: "nm", abs: 0.01
  at: "hydrogen C line, red end of the Abbe number"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_smith_2008"
  status: #settled
 }
 %phys.optics.crown_abbe_min{
  value: 50, unit: "1", abs: 0
  at: "glass-map convention: the lowest V_d a crown may have, allowed only for dense crowns with n_d above 1.60"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_wiki_abbe_zahl"
  status: #settled
 }
 %phys.optics.crown_abbe_ordinary_min{
  value: 55, unit: "1", abs: 0
  at: "glass-map convention: crowns with n_d below 1.60 need V_d above 55; glasses below the line are flints"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_wiki_abbe_zahl"
  status: #settled
 }
 %phys.optics.fresnel_r_n152{
  value: 0.0426, unit: "fraction per surface", abs: 0.0001
  at: "normal incidence from air onto glass with n = 1.52, ((n - 1)/(n + 1))^2"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_hecht_2017"
  status: #settled
 }
 %phys.optics.mgf2_n{
  value: 1.38, unit: "1", abs: 0.01
  at: "magnesium fluoride near 550 nm, the classic single-layer coating"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_hecht_2017"
  status: #settled
 }
 %phys.optics.cutoff_f16_lp_per_mm{
  value: 113.6, unit: "line pairs per mm", abs: 0.1
  at: "incoherent diffraction cutoff 1/(lambda N) at 550 nm and f/16"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_smith_2008"
  status: #settled
 }
}

