# Quantities: Physical Sciences and Image
#
# World metric cells for physics, chemistry, optics, and moving-image carriers. A handle names one cell; files read it instead of restating the number.

#>registry_qty_physical_sciences_and_image
#:layer #!reference
#:domain #!registry
#:form #!registry
#:level #!practitioner
#:review #!spot_checked
#:valence #!bone

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5 writer"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[ "derived cells were recomputed by hand: Landauer bound, kT at 300 K, Fresnel reflectance, diffraction cutoff, format diagonals", "process cells checked 2026-10-01 against Wikipedia summaries of Kodak publications; E-6 tolerance left verify" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r5"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
  }
  ^["r6"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass, note: "re-run after the 2026-10-03 fact-check fixes; no failing lines" }
 }
 corrections: #[
  "fact-check: the crown Abbe thresholds were swapped; crowns need V_d above 55 below n_d 1.60 and above 50 only past it, and a cell for the 55 bound was added",
  "fact-check: the vacuum impedance cell held the superseded CODATA 2018 value; it now holds CODATA 2022, checked against the NIST constants database",
  "fact-check 2026-10-03: the muon cell now says it is the free mean life measured with positive muons, so a scintillator lab with captured negative muons is not read against it uncaveated",
  "fact-check 2026-10-03: the r4 fact-check receipt was dated 2026-10-01, before the receipts it followed; it is re-dated 2026-10-02, the day that pass ran"
 ]
}

^["families"]{
 ^["const"]{
  id: phys_const, operator: "%", identifier: phys.const, plane: world, scope: corpus
  keys: #[ c_m_per_s, k_b_mev_per_k, r_j_per_mol_k, g_n_m_per_s2, e_charge_zc, z0_ohm, von_klitzing_ohm ]
 }
 ^["thermal"]{
  id: phys_thermal, operator: "%", identifier: phys.thermo, plane: world, scope: corpus
  keys: #[ water_triple_point_k, kt_300k_mev, ice_residual_entropy_j_per_mol_k ]
 }
 ^["information"]{
  id: phys_info, operator: "%", identifier: phys.info, plane: world, scope: corpus
  keys: #[ landauer_300k_zj, landauer_300k_mev ]
 }
 ^["statistical"]{
  id: phys_statmech, operator: "%", identifier: phys.statmech, plane: world, scope: corpus
  keys: #[ sun_teff_k, earth_teff_k, photon_mean_energy_kt, ising2d_tc_j_per_kb ]
 }
 ^["critical"]{
  id: phys_critical, operator: "%", identifier: phys.critical, plane: world, scope: corpus
  keys: #[ ising3d_nu, heisenberg3d_nu, water_tc_k, water_pc_mpa, iron_curie_k ]
 }
 ^["image"]{
  id: phys_image, operator: "%", identifier: phys.optics, plane: world, scope: corpus
  keys: #[ line_d_nm, line_f_nm, line_c_nm, crown_abbe_min, crown_abbe_ordinary_min, fresnel_r_n152, mgf2_n, cutoff_f16_lp_per_mm ]
 }
 ^["carriers"]{
  id: phys_carriers, operator: "%", identifier: phys.cine, plane: world, scope: corpus
  keys: #[ s16_diag_mm, s35_diag_mm, ff_diag_mm, lf_diag_mm, a65_diag_mm, full_gate_scope_ratio, cinemascope_1953_ratio, scope_delivered_ratio ]
 }
 ^["process"]{
  id: phys_process, operator: "%", identifier: phys.process, plane: world, scope: corpus
  keys: #[ ecn2_dev_c, ecn2_dev_min, c41_dev_c, c41_dev_min, e6_fd_c, e6_fd_min ]
 }
 ^["film"]{
  id: phys_film, operator: "%", identifier: phys.film, plane: world, scope: corpus
  keys: #[ frames_per_ft_35mm, frames_per_ft_16mm, sound_speed_fps ]
 }
 ^["video"]{
  id: phys_video, operator: "%", identifier: phys.video, plane: world, scope: corpus
  keys: #[ quad_width_mm, umatic_width_mm, half_inch_width_mm, dv_width_mm, dv_video_mbps ]
 }
 ^["safety"]{
  id: phys_safety, operator: "%", identifier: phys.safety, plane: world, scope: corpus
  keys: #[ flixborough_deaths, texas_city_2005_deaths ]
 }
 ^["lab"]{
  id: phys_lab, operator: "%", identifier: phys.lab, plane: world, scope: corpus
  keys: #[ muon_tau_us ]
 }
 ^["nmr"]{
  id: phys_nmr, operator: "%", identifier: phys.nmr, plane: world, scope: corpus
  keys: #[ noe_range_nm ]
 }
}

#>q_phys_const
^"constants"{
 %phys.const.c_m_per_s{
  value: 299792458, unit: "m/s", abs: 0
  at: "speed of light in vacuum; exact since the 1983 metre definition"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_bipm_si_2019"
  status: #settled
 }
 %phys.const.k_b_mev_per_k{
  value: 0.08617333262, unit: "meV/K", rel: 0.000000001
  at: "Boltzmann constant, exactly 1.380649e-23 J/K in the 2019 SI, shown in meV per kelvin"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_bipm_si_2019"
  status: #settled
 }
 %phys.const.r_j_per_mol_k{
  value: 8.314462618, unit: "J/(mol K)", rel: 0.000000001
  at: "molar gas constant, the product of the defined Avogadro and Boltzmann constants"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_codata_2018"
  status: #settled
 }
 %phys.const.g_n_m_per_s2{
  value: 9.80665, unit: "m/s^2", abs: 0
  at: "standard acceleration of gravity, a conventional value, not local gravity"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_codata_2018"
  status: #settled
 }
 %phys.const.e_charge_zc{
  value: 160.2176634, unit: "zC", abs: 0
  at: "elementary charge, exactly 1.602176634e-19 C in the 2019 SI; 1 zC is 1e-21 C"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_bipm_si_2019"
  status: #settled
 }
 %phys.const.z0_ohm{
  value: 376.730313412, unit: "ohm", abs: 0.000000059
  at: "characteristic impedance of vacuum, CODATA 2022, read 2026-10-02; measured, not exact, since 2019; the CODATA 2018 value 376.730313668 is superseded"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_codata_2022"
  status: #settled
 }
 %phys.const.von_klitzing_ohm{
  value: 25812.80745, unit: "ohm", abs: 0.00001
  at: "von Klitzing constant h over e squared, exact in the 2019 SI; the integer quantum Hall plateaus sit at this value over an integer"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_bipm_si_2019"
  status: #settled
 }
}

#>q_phys_thermal
^"thermal"{
 %phys.thermo.water_triple_point_k{
  value: 273.16, unit: "K", abs: 0.0001
  at: "triple point of water; exact by definition before 2019, now a measured value"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_bipm_si_2019"
  status: #settled
 }
 %phys.thermo.kt_300k_mev{
  value: 25.852, unit: "meV", abs: 0.001
  at: "thermal energy k_B T at 300 K, derived from the exact Boltzmann constant"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_bipm_si_2019"
  status: #settled
 }
 %phys.thermo.ice_residual_entropy_j_per_mol_k{
  value: 3.37, unit: "J/(mol K)", abs: 0.01
  at: "Pauling estimate R ln(3/2) for proton disorder in ice Ih at absolute zero"
  src: ~"../sources/physical-sciences-and-image.spw#src_phys_pauling_1935"
  status: #settled
 }
}

