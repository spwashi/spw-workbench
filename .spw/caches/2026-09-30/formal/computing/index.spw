# Computing
#
# The computing branch: a three-year curriculum in weekly rows, the graph that orders it, the specifications under it, and the stream models a live tool needs.

#>computing_index
#:layer #!reference
#:domain #!computing
#:form #!index
#:level #!foundation
#:review #!sourced
#:valence #!bone

^"emit"{
 ~#title: "Computing"
 ~#claim: "Three years of weekly rows run from browser to metal to theory, ordered by one prerequisite graph and anchored to dated specifications."
 ~#proof: "Each year file cites its specifications and founding papers; the curriculum graph resolves every prerequisite to an earlier week."
 ~#door: "Web developers start in year one; systems programmers start at the graph primer; theorists start with lambda calculus."
 ~#audience: "self-learners and teachers planning a long computing sequence"
 continuity: "Computing | browser to metal to theory"
 cold_open: "The computing branch runs from browser to metal to theory, one week at a time, and every week knows its prerequisites."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["tree"]{
 web: ~"./web-and-browser-internals.spw"
 systems: ~"./systems-programming.spw"
 abstract: ~"./abstract-computation.spw"
 curriculum_dag: ~"./curriculum-dag.spw"
 spec_lineage: ~"./spec-lineage.spw"
 stream_models: ~"./stream-processing-models.spw"
}

^["bundle"]{
 ={ ~"./web-and-browser-internals.spw#computing_web" }
 ={ ~"./systems-programming.spw#computing_systems" }
 ={ ~"./abstract-computation.spw#computing_abstract" }
 ={ ~"./curriculum-dag.spw#computing_curriculum_dag" }
 ={ ~"./spec-lineage.spw#computing_spec_lineage" }
 ={ ~"./stream-processing-models.spw#computing_stream_models" }
}

^["ladder"]{
 rungs: << "foundation" ; "advanced" ; "graduate" >>
 foundation: [ ~"./spec-lineage.spw#computing_spec_lineage" ]
 advanced: [ ~"./web-and-browser-internals.spw#computing_web", ~"./systems-programming.spw#computing_systems", ~"./curriculum-dag.spw#computing_curriculum_dag", ~"./stream-processing-models.spw#computing_stream_models" ]
 graduate: [ ~"./abstract-computation.spw#computing_abstract" ]
}

^["origin"]{
 #>computing_index_origin
 ^["from_syllabus"]{
  #:claim #!interpretive
  statement: "These rows began as a daily podcast syllabus; here they are kept as a curriculum, and the episode format lives with the broadcast bench."
 }
 see: [ ~"../../making/broadcast/episode-run-sheet.spw#broadcast_run_sheet" ]
}

^["gaps"]{
 logic: "mathematical logic as its own node, between the glossary and year three, instead of scattered through types and Goedel"
 databases: "relational theory, query optimization, and transactions beyond the year-one storage row"
 security: "threat models, cryptographic engineering, and secure design beyond TLS, Spectre, and zero-knowledge rows"
 hci: "human-computer interaction and accessibility, touched by no row"
 machine_learning: "statistical learning and neural networks, which would hang from probability and optimization"
}
