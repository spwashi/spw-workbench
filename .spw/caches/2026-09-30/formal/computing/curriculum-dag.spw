^["shape"]{
 roots: [ ~"./web-and-browser-internals.spw#computing_web_w01", ~"./web-and-browser-internals.spw#computing_web_w27" ]
 leaves: "20 weeks have no dependents, including Flexbox and Grid at week 7, Spectre at week 63, and the zero-knowledge and quantum weeks"
 counts: "62 nodes and 89 needs edges, recounted by script on 2026-10-02"
}

^["try"]{
 #>computing_dag_try_trace
 ^["trace_a_week"]{
  materials: [ "this file", "paper" ]
  steps: << "pick one year-three week" ; "write its needs, then their needs, until you reach a root" ; "count the weeks on the longest chain" ; "mark which chain crosses each year bridge" ; "find one week you would add as a prerequisite and say why" >>
  time: .{ n: 20, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"./curriculum-dag.spw#computing_dag_invariant"
 }
}

#>computing_dag_layout_leaf_q
?["Should the layout weeks feed anything later in the curriculum?"]{
 #:depth #!educational ~#lens(formal structure)
 #:claim #!speculative
 ~#hypothesis: "Layout weeks stay leaves because their constraint solving is never revisited; linking Grid track sizing to the optimization leaf would give year one a path into year three."
 !probe{ "add one edge from week 7 to a year-three or optimization node and recount leaves and longest chains" =id[p_formal_dag_layout_leaf] =kind[census] }
 $%[graph.in_degree, graph.out_degree]
 ~"./curriculum-dag.spw#computing_dag_invariant" ~#neighbor(nearest)
}
