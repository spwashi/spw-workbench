# Computing Curriculum DAG
#
# The three computing years as one prerequisite graph over week anchors: every needs edge resolves to a real week row and points to an earlier week.

#>computing_curriculum_dag
#:layer #!reference
#:domain #!computing
#:form #!curriculum
#:level #!advanced
#:review #!adversarial_checked
#:valence #!bone

^"emit"{
 ~#title: "Computing Curriculum DAG"
 ~#claim: "Sixty-two week rows form one acyclic graph in which every prerequisite resolves to an earlier week anchor."
 ~#proof: "Regenerated from the three year files on 2026-10-02 and checked by script: 89 needs edges, two roots, none pointing forward."
 ~#door: "Find a week, follow its needs back to a root, then follow a year bridge across."
 ~#audience: "learners planning a path, and tools that read prerequisite edges"
 continuity: "Computing Curriculum DAG | earlier week"
 cold_open: "Every prerequisite in this graph points to an earlier week, so nothing is ever taught on faith."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/podcasting/topical-index.spw", ".spw/caches/podcasting/curriculum-arc.spw" ]
 evidence: #[ "a script over the node list on 2026-10-02 found 62 nodes, 89 edges, roots at weeks 1 and 27, no forward edge, and no unresolved prerequisite" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #pass }
  ^["r5"]{ event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker",
   care: #adversarial, outcome: #pass }
 }
 corrections: #[
  "the topical index listed week numbers as episode numbers; nodes are now week anchors",
  "only 5 of 36 raw prerequisites and 2 of 48 raw leads_to targets resolved; every edge is now a path ref the gate resolves",
  "language-feature topics such as the Elixir pipe, Clojure HAMTs, Julia dispatch, and APL rank had no week row and are dropped here",
  "the curriculum arc promised nothing on faith while teaching Spectre before caches and compilers before graph theory; both orders are fixed in the year files",
  "the arc claim that compiler optimization is equivalent to abstract interpretation is narrowed to analyses as instances of it",
  "the raw example spw select --query flag does not exist and is dropped"
 ]
}

^["edges"]{
 grounds: [ ~"./web-and-browser-internals.spw#computing_web", ~"./systems-programming.spw#computing_systems", ~"./abstract-computation.spw#computing_abstract" ]
 see: [ ~"../mathematics/engineering-math-bridge.spw#mathematics_bridge" ]
}

^["concepts"]{
 primary: [ #prerequisite, #weekly_rung ]
 transfers: [ #curriculum_memory ]
 tensions: [ #ordering ]
}

^["stance"]{
 #>computing_dag_thesis
 ^["cost_and_law"]{
  #:claim #!interpretive
  statement: "The arc reads each abstraction through the physical cost it hides and each machine through the mathematics it obeys; that is a teaching stance, not a finding."
 }
 #>computing_dag_invariant
 ^["no_forward_edges"]{
  #:claim #!settled
  statement: "Every needs edge in this file points to a week with a smaller number, and every target is a week anchor in one of the three year files."
  source: ".spw/caches/2026-09-30/formal/computing/curriculum-dag.spw node list, computed by script on 2026-10-02; the cut gate rechecks resolution"
 }
}

^["bridges"]{
 #>computing_dag_bridge_one_two
 ^["web_to_metal"]{
  from: ~"./web-and-browser-internals.spw#computing_web_w51"
  to: ~"./systems-programming.spw#computing_systems_w053"
  climax: "a hand-written WAT module traced into the machine code the engine emits"
 }
 #>computing_dag_bridge_two_three
 ^["metal_to_form"]{
  from: ~"./systems-programming.spw#computing_systems_w103"
  to: ~"./abstract-computation.spw#computing_abstract_w105"
  climax: "a constant-propagation pass recast as a fixpoint over an abstract lattice"
 }
 #>computing_dag_bridge_graphs
 ^["graphs_forward"]{
  from: ~"./systems-programming.spw#computing_systems_w092"
  to: [ ~"./systems-programming.spw#computing_systems_w093", ~"./abstract-computation.spw#computing_abstract_w139", ~"./abstract-computation.spw#computing_abstract_w142" ]
  climax: "the graph primer serves the compilers first and returns at depth in year three"
 }
}

