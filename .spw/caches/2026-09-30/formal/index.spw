# Formal
#
# The formal class: mathematics and computing, laid out as a rung ladder from a shared glossary to graduate ledgers and a three-year computing curriculum.

#>formal_index
#:layer #!reference
#:domain #!formal
#:form #!index
#:level #!intro
#:review #!sourced
#:valence #!bone

^"emit"{
 ~#title: "Formal"
 ~#claim: "Mathematics and computing share one ladder, from a seven-term glossary to graduate theorem ledgers and year-three computation."
 ~#proof: "Each rung links a leaf whose theorems keep their hypotheses and whose dated facts carry as_of and a source."
 ~#door: "Read the glossary first, then pick the mathematics or computing branch by what you want to build or prove."
 ~#audience: "readers entering mathematics or computing at any level"
 continuity: "Formal | one ladder"
 cold_open: "Mathematics and computing share one ladder here, and every rung keeps its hypotheses and its dates attached."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["tree"]{
 glossary: ~"./formal-glossary.spw"
 mathematics: ~"./mathematics/index.spw"
 computing: ~"./computing/index.spw"
}

^["bundle"]{
 ={ ~"./formal-glossary.spw#formal_glossary" }
 ={ ~"./mathematics/index.spw#mathematics_index" }
 ={ ~"./computing/index.spw#computing_index" }
}

^["ladder"]{
 rungs: << "intro" ; "foundation" ; "advanced" ; "graduate" >>
 intro: [ ~"./formal-glossary.spw#formal_glossary" ]
 foundation: [ ~"./mathematics/engineering-core/calculus-and-linear-algebra.spw#mathematics_calc_linalg", ~"./mathematics/analysis-and-algebra-core.spw#mathematics_core", ~"./mathematics/engineering-core/probability-and-statistics.spw#mathematics_probstat", ~"./computing/spec-lineage.spw#computing_spec_lineage" ]
 advanced: [ ~"./mathematics/topology-and-complex-core.spw#mathematics_topology_complex", ~"./mathematics/engineering-core/numerical-methods.spw#mathematics_numerics", ~"./computing/web-and-browser-internals.spw#computing_web", ~"./computing/systems-programming.spw#computing_systems", ~"./computing/stream-processing-models.spw#computing_stream_models" ]
 graduate: [ ~"./mathematics/graduate-algebra-and-topology.spw#mathematics_grad_algebra", ~"./mathematics/graduate-analysis-and-geometry.spw#mathematics_grad_analysis", ~"./computing/abstract-computation.spw#computing_abstract" ]
}

^["doors"]{
 build: ~"./mathematics/engineering-math-bridge.spw#mathematics_bridge"
 prove: ~"./mathematics/analysis-and-algebra-core.spw#mathematics_core"
 program: ~"./computing/curriculum-dag.spw#computing_curriculum_dag"
}

^["gaps"]{
 logic: "mathematical logic and set theory as their own node; today they sit inside the Goedel note and the year-three type rows"
 databases: "databases as a node, touched only by the year-one storage row"
 security: "security engineering as a node, touched only by TLS, Spectre, and zero-knowledge rows"
 hci: "human-computer interaction, touched by no row"
 machine_learning: "machine learning as a node, which would need probability, optimization, and numerics together"
}
