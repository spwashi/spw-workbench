}

^["facets"]{
 order: "PMEST: domain, then primary concepts, then form, then era"
 domain: "mathematics throughout"
 forms: "curriculum for prerequisite graphs, ledger for theorem lists, comparison for method matrices, probe_battery for runnable numerics"
}

^["stance"]{
 #>mathematics_goedel
 ^["goedel_incompleteness"]{
  #:claim #!settled
  statement: "A consistent, effectively axiomatized theory that interprets basic arithmetic leaves some arithmetic sentence undecided, and under standard coding cannot prove its own consistency."
  sources: [ ~"../../registries/sources/formal.spw#src_formal_goedel_1931", ~"../../registries/sources/formal.spw#src_formal_rosser_1936" ]
  ~#(Goedel 1931 assumed omega consistency; Rosser 1936 weakened it to plain consistency)
  ^["limits"]{
   holds: "theories whose axioms a program can list and which interpret Robinson arithmetic, such as Peano arithmetic and ZFC"
   fails: "the set of all true arithmetic sentences is complete and consistent, but no program lists it, so the theorem does not apply"
  }
 }
 #>mathematics_goedel_raw_reading
 ^["goedel_raw_reading"]{
  #:claim #!refuted
  statement: "As the raw cache put it, any consistent system capable of arithmetic has true statements it cannot derive; without effective axiomatization that sentence is false."
  source: ~"../../registries/sources/formal.spw#src_formal_franzen_2005"
 }
 #>mathematics_lucas_penrose
 ^["lucas_penrose"]{
  #:claim #!contested
  statement: "Lucas and Penrose argue that Goedel shows human mathematical insight is not algorithmic; critics reply that the step assumes humans can know their own reasoning is consistent."
  sources: [ ~"../../registries/sources/formal.spw#src_formal_lucas_1961", ~"../../registries/sources/formal.spw#src_formal_penrose_1994" ]
  counter: ~"../../registries/sources/formal.spw#src_formal_feferman_1995"
  ~#counter(Franzen 2005 surveys the same gap at book length)
 }
 #>mathematics_validity_relative
 ^["validity_relative"]{
  #:claim #!interpretive
  statement: "A proof stays valid relative to its axioms and rules of inference; whether those axioms describe the world is a separate, empirical question."
 }
 #>mathematics_wigner
 ^["unreasonable_effectiveness"]{
  #:claim #!interpretive
  statement: "Wigner called the fit between mathematics built for its own sake and later physics unreasonable; the examples include Riemannian geometry in general relativity and Hilbert spaces in quantum mechanics."
  source: ~"../../registries/sources/formal.spw#src_formal_wigner_1960"
 }
 #>mathematics_euclid_primes
 ^["euclid_primes"]{
  #:claim #!settled
  statement: "Euclid Elements IX.20 shows there are more primes than any given finite list, and the argument still stands as written; Aigner and Ziegler open their Book of elegant proofs with it."
  source: ~"../../registries/sources/formal.spw#src_formal_aigner_ziegler_2018"
 }
}

^["origins"]{
 #>mathematics_origin_brahmagupta
 ^["zero_and_negatives"]{
  #:claim #!settled
  statement: "Brahmagupta in 628 CE gave arithmetic rules for zero and negative quantities in the Brahmasphutasiddhanta."
  source: ~"../../registries/sources/formal.spw#src_formal_plofker_2009"
 }
 #>mathematics_origin_kerala
 ^["kerala_series"]{
  #:claim #!settled
  statement: "Madhava of Sangamagrama and the Kerala school, around 1400, gave infinite series for arctangent, sine, and pi that Europe met again in the seventeenth century."
  source: ~"../../registries/sources/formal.spw#src_formal_plofker_2009"
 }
 #>mathematics_origin_kerala_transmission
 ^["kerala_transmission"]{
  #:claim #!contested
  statement: "Whether Kerala series reached Europe through Jesuit contacts is debated; Joseph argues the route was plausible, while Plofker finds no documentary evidence of transmission."
  source: ~"../../registries/sources/formal.spw#src_formal_joseph_2011"
  counter: ~"../../registries/sources/formal.spw#src_formal_plofker_2009"
 }
}

^["gaps"]{
 practitioner: "actuarial science, industrial statistics, and operations practice have no leaf; expected neighbors are probability-and-statistics and optimization"
 logic: "mathematical logic and set theory appear only in the Goedel note and the year 3 computing rows; a logic leaf would sit between the glossary and abstract computation"
 history: "a history-of-mathematics leaf beyond these origin notes, including Islamic-world algebra and Chinese and Mayan numeration"
}

#>mathematics_effectiveness_q
?["Is the effectiveness of mathematics partly a selection effect?"]{
 #:depth #!historical ~#lens(historical layer)
 #:claim #!speculative
 ~#hypothesis: "Physics keeps the mathematics that fits and leaves the rest unread, so the record overstates fit; a census of unused structures would shrink the mystery without removing it."
 !probe{ "sample pure results from one journal decade and count later physical applications" =id[p_formal_math_effectiveness] =kind[lit] }
 $%[graph.out_degree]
 ~"./index.spw#mathematics_wigner" ~#neighbor(nearest)
}
