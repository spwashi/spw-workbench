# Mathematics
#
# The mathematics branch: a pure ladder whose theorems keep their hypotheses, an engineering core, and a bridge to every class that computes.

#>mathematics_index
#:layer #!reference
#:domain #!mathematics
#:form #!index
#:level #!foundation
#:review #!sourced
#:valence #!bone

^"emit"{
 ~#title: "Mathematics"
 ~#claim: "Every theorem on the pure ladder keeps its hypotheses attached, and an engineering core feeds physics, engineering, economics, and computing."
 ~#proof: "Theorem ledgers cite standard graduate texts; the bridge names each downstream node; the Goedel note states effective axiomatization."
 ~#door: "Builders start at the engineering core; provers start at the analysis and algebra core."
 ~#audience: "students and self-learners choosing a way into mathematics"
 continuity: "Mathematics | hypotheses attached"
 cold_open: "Every theorem here travels with its hypotheses attached, because a result stripped of its conditions is only a rumor."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/mathematics/taste.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "Goedel first incompleteness now requires an effectively axiomatized consistent theory; the raw stated it for any consistent system capable of arithmetic",
  "the claim that Goedel proves human intuition transcends algorithms is moved to a contested Lucas-Penrose frame with its critics",
  "Euclid proof called the only contact with absolute immortality is dropped as rhetoric",
  "a valid deduction true across all possible universes is restated as validity relative to axioms and rules"
 ]
}

