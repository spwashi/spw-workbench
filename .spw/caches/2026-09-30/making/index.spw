# Making
#
# The making class: film, theatre, visual arts, independent authorship, broadcast, and the streamers bench, with a glossary, a rung ladder, and the gaps still open.

#>making_index
#:layer #!reference
#:domain #!making
#:form #!index
#:level #!intro
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Making"
 ~#claim: "Making gathers the crafts that turn a script, a sketch, a manuscript, or a live session into work an audience meets, each with its crews, rights, calendars, and lineages."
 ~#proof: "Each branch index cites its leaves; each leaf cites agreements, statutes, standards, or the practitioners' own books."
 ~#door: "Start with the glossary or the branch you work in, then climb the rung ladder."
 ~#audience: "makers, students, and readers curious how creative work is produced"
 cold_open: "Making gathers the crafts that turn an idea into something an audience can watch, read, or hear."
 continuity: "Making | crafts"
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #partial }
 }
}

^["tree"]{
 glossary: ~"./making-glossary.spw"
 film: ~"./film/index.spw"
 theatre: ~"./theatre/index.spw"
 visual: ~"./visual/index.spw"
 authorship: ~"./authorship/index.spw"
 broadcast: ~"./broadcast/index.spw"
 streaming: ~"./streaming/index.spw"
}

^["bundle"]{
 ={ ~"./making-glossary.spw#making_glossary" }
 ={ ~"./film/index.spw#film_index" }
 ={ ~"./theatre/index.spw#theatre_index" }
 ={ ~"./visual/index.spw#visual_arts_index" }
 ={ ~"./authorship/index.spw#authorship_index" }
 ={ ~"./broadcast/index.spw#broadcast_index" }
 ={ ~"./streaming/index.spw#streaming_index" }
}

^["facets"]{
 domains: #[ film, theatre, visual_arts, authorship, broadcast, streaming ]
 forms: #[ index, glossary, protocol, ledger, comparison, dossier, curriculum, calendar, timeline ]
 seasons: "film and authorship calendars carry #:season #!crescendo for October to January"
 space: "no region axis; most surfaces describe US practice and say so in their limits"
}

^["ladder"]{
 order: <<
  "intro" ;
  "foundation" ;
  "advanced" ;
  "graduate" ;
  "practitioner"
 >>

 #>making_ladder_intro
 ^["intro"]{
  rungs: [
   ~"./film/production-state-machine.spw#film_production_states",
   ~"./authorship/martian-serial-to-screen.spw#authorship_martian_case"
  ]
 }
 #>making_ladder_foundation
 ^["foundation"]{
  rungs: [
   ~"./making-glossary.spw#making_glossary",
   ~"./theatre/theatre-core.spw#theatre_core",
   ~"./visual/animation-principles.spw#visual_arts_animation",
   ~"./visual/illustration-and-visual-storytelling.spw#visual_arts_illustration",
   ~"./visual/industrial-design.spw#visual_arts_industrial_design"
  ]
 }
 #>making_ladder_advanced
 ^["advanced"]{
  rungs: [
   ~"./film/film-school-sequence.spw#film_school",
   ~"./theatre/directing-lineages.spw#theatre_directing"
  ]
 }
 #>making_ladder_graduate
 ^["graduate"]{
  rungs: [
   ~"./film/film-school-sequence.spw#film_school_thesis",
   ~"./film/film-school-sequence.spw#film_school_animation_direction"
  ]
  note: "graduate rungs live as nodes inside the film school graph; producing programs have none yet"
 }
 #>making_ladder_practitioner
 ^["practitioner"]{
  rungs: [
   ~"./film/set-operations-and-crew.spw#film_set_operations",
   ~"./film/crew-safety-and-culture.spw#film_crew_safety",
   ~"./film/intimacy-coordination.spw#film_intimacy",
   ~"./film/careers-and-representation.spw#film_careers",
   ~"./film/adaptation-and-rights.spw#film_adaptation",
   ~"./film/film-season-calendar.spw#film_season_calendar",
   ~"./film/labor-agreements-ledger.spw#film_labor_ledger"
  ]
 }
}

^["gaps"]{
 music: "music and audio production has no branch, though it has its own holiday release season"
 games: "game design has no branch"
 literary_craft: "authorship covers the business of books, not the craft of writing them"
 serial_writing: "newsletters and serialized writing appear only as cases"
 graduate_producing: "graduate producing programs for film and publishing have no rung"
 acoustics: "loudness standards in film school wait on an acoustics node in the physical class"
 streaming: "the streamers bench holds no observed session yet, so its claims stay speculative"
}
