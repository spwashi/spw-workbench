# Chat Torrent Pipeline
#
# Live chat read as a torrent of topics: a staged pipeline that ingests, dedupes, classifies, sorts into lanes, ranks, and surfaces, with shedding under load and a moderator lane held apart.

#>streaming_chat_torrent
#:layer #!pragmatics
#:domain #!streaming
#:form #!state_machine
#:level #!advanced
#:review #!adversarial_checked
#:valence #!bone
#:era #!current

^"emit"{
 ~#title: "Chat Torrent Pipeline"
 ~#claim: "A busy live chat reads as lanes of topics when a staged pipeline ingests, dedupes, classifies, clusters, ranks, and surfaces messages, with a moderator lane held apart."
 ~#proof: "Each stage borrows a stream technique with a published guarantee; throughput stays a named probe until a session is measured."
 ~#door: "Walk the state machine, read the pseudonym protocol, then sort a pile of invented chat cards into lanes by hand."
 ~#audience: "live hosts, moderators, and engineers building chat tools"
 continuity: "Chat Torrent Pipeline | lanes of topics"
 cold_open: "A busy chat turns into lanes of topics once a pipeline sorts it and moderators keep a lane of their own."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[
  ".agents/plans/caches-cut-2026-09-30/references/studies/tokens-synthesis.md section 4, chat privacy and the Spw.chat pack",
  ".agents/plans/caches-cut-2026-09-30/references/studies/persona-synthesis.json false friend rank 9, @ read as a mention",
  "birthday bounds computed by the writer on 2026-10-02"
 ]
 data: "no chat was collected or read for this surface; every handle and message named here is invented"
 ^["receipts"]{
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{ event: #revised, at: "2026-10-03", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r5"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
  }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the tokens study prototype kept 16 bits of a salted hash and raw mentions in its span map; this protocol requires a keyed hash of 64 bits or more and no raw handle anywhere",
