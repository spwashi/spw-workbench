^["canon"]{
 #>visual_arts_anim_twelve
 ^["the_twelve"]{
  #:claim #!settled
  statement: "Frank Thomas and Ollie Johnston set out twelve principles of animation in The Illusion of Life (1981), drawn from Disney studio practice since the 1930s."
  reads: %[film.animation.principles_count]
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_thomas_johnston_1981"
  members: #[ squash_and_stretch, anticipation, staging, straight_ahead_and_pose_to_pose, follow_through_and_overlap, slow_in_slow_out, arcs, secondary_action, timing, exaggeration, solid_drawing, appeal ]
 }
 #>visual_arts_anim_lasseter
 ^["into_3d"]{
  #:claim #!settled
  statement: "John Lasseter showed in 1987 how the same principles apply to 3D computer animation."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_lasseter_1987"
 }
}

^["terms"]{
 #>visual_arts_anim_squash
 ^["squash_and_stretch"]{
  sense: "deform a form to show weight and give while keeping its volume"
 }
 #>visual_arts_anim_anticipation
 ^["anticipation"]{
  sense: "a small opposite move that prepares the eye for the main action"
 }
 #>visual_arts_anim_staging
 ^["staging"]{
  sense: "present one idea at a time so it reads clearly, often in silhouette"
 }
 #>visual_arts_anim_pose_to_pose
 ^["straight_ahead_and_pose_to_pose"]{
  sense: "draw frame after frame in order, or set key poses first and fill between"
  see: [ ~"./animation-principles.spw#visual_arts_anim_key_frame" ]
 }
 #>visual_arts_anim_follow_through
 ^["follow_through_and_overlap"]{
  sense: "parts keep moving and settle at different times after the main body stops"
 }
 #>visual_arts_anim_slow_in
 ^["slow_in_slow_out"]{
  sense: "space drawings closer near key poses so motion eases in and out"
  see: [ ~"./animation-principles.spw#visual_arts_anim_tangents" ]
 }
 #>visual_arts_anim_arcs
 ^["arcs"]{
  sense: "most natural motion travels along curved paths"
 }
 #>visual_arts_anim_secondary
 ^["secondary_action"]{
  sense: "a smaller action that supports the main one without competing"
 }
 #>visual_arts_anim_timing
 ^["timing"]{
  sense: "the number of frames an action takes, which sets weight and mood"
 }
 #>visual_arts_anim_exaggeration
 ^["exaggeration"]{
  sense: "push a pose or move past realism so its idea reads more strongly"
 }
 #>visual_arts_anim_solid_drawing
 ^["solid_drawing"]{
  sense: "draw forms with weight, depth, and balance in three dimensions"
 }
 #>visual_arts_anim_appeal
 ^["appeal"]{
  sense: "a design and performance the audience wants to watch, hero or villain"
 }
 #>visual_arts_anim_key_frame
 ^["key_frame"]{
  sense: "a pose that defines an action; inbetweens fill the frames from one key to the next"
 }
}

^["timing_and_spacing"]{
 #>visual_arts_anim_twos
 ^["ones_and_twos"]{
  #:claim #!settled
  statement: "At 24 frames per second, animating on twos holds each drawing for two frames, giving 12 drawings a second; fast action often goes on ones."
  reads: %[film.frame.sound_fps, film.animation.on_twos_drawings_s]
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_williams_2001"
 }
 #>visual_arts_anim_tangents
 ^["graph_editor_tangents"]{
  #:claim #!settled
  statement: "A flat tangent gives a key zero slope, so the curve eases into and out of that key and cannot overshoot it there."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_parent_2012"
  ^["spline_overshoot"]{
   #:claim #!settled
   statement: "Smooth spline tangents through uneven keys can overshoot between them; flat tangents on both keys keep that segment between the two keyed values."
   source: ~"../../registries/sources/film-stage-visual.spw#src_film_parent_2012"
  }
 }
}

^["traditions"]{
 #>visual_arts_anim_reiniger
 ^["silhouette_feature"]{
  #:claim #!settled
  statement: "Lotte Reiniger made The Adventures of Prince Achmed (1926), a feature animated with cut-paper silhouettes."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_reiniger_1926"
 }
 #>visual_arts_anim_wan
 ^["chinese_feature"]{
  #:claim #!settled
  statement: "The Wan brothers directed Princess Iron Fan (1941), an animated feature made in China from an episode of Journey to the West."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_wan_1941"
 }
 #>visual_arts_anim_tezuka
 ^["limited_animation_tv"]{
  #:claim #!settled
  statement: "Osamu Tezuka's Astro Boy (1963) made weekly television animation in Japan workable with limited animation, reusing cels and holding drawings."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_clements_2013"
 }
 ~#(the twelve name one studio tradition; limited animation differs by design)
}

^["try"]{
 #>visual_arts_anim_try_ball
 ^["bouncing_ball"]{
  materials: [ "a sticky-note pad", "a pencil", "a phone that films at 24 frames per second" ]
  steps: <<
   "draw a ball falling and bouncing in twelve drawings" ;
   "film each drawing for two frames" ;
   "redraw it in twenty-four drawings and film each once" ;
   "squash the ball on contact in both versions" ;
   "compare which ball feels heavier"
  >>
  time: .{ n: 50, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"./animation-principles.spw#visual_arts_anim_twos"
 }
}

#>visual_arts_anim_weight_q
?["Does animating on ones or on twos change how heavy a ball feels?"]{
 #:depth #!experiential ~#lens(bodily rhythm)
 #:claim #!speculative
 ~#hypothesis: "Viewers judge the same bounce as snappier on ones and more stylized on twos, with the perceived weight set more by spacing than by drawing count."
 !probe{ "show viewers the same bounce on ones and on twos and ask them to rank weight" =id[p_film_anim_ones_twos] =kind[build] }
 $%[film.frame.sound_fps, film.animation.on_twos_drawings_s]
 ~"./animation-principles.spw#visual_arts_anim_twos" ~#neighbor(nearest)
}
