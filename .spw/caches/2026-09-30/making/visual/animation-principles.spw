# Animation Principles
#
# All twelve principles from The Illusion of Life as a glossary lattice, with timing on ones and twos, graph-editor tangents set right, and animation traditions beyond Disney.

#>visual_arts_animation
#:layer #!reference
#:domain #!visual_arts
#:form #!glossary
#:level #!foundation
#:review #!sourced
#:valence #!boon

^"emit"{
 ~#title: "Animation Principles"
 ~#claim: "Frank Thomas and Ollie Johnston named twelve principles of animation in 1981, from squash and stretch to appeal, and they still frame how animators judge motion."
 ~#proof: "The Illusion of Life lists all twelve; Lasseter carried them into 3D in 1987; Williams covers timing on ones and twos."
 ~#door: "Read the twelve terms, then animate a bouncing ball on ones and on twos."
 ~#audience: "animation students, illustrators, and anyone curious why cartoons feel alive"
 cold_open: "Animation feels alive when weight, timing, and intent read on screen, and the twelve principles name how."
 continuity: "Animation Principles | twelve principles"
}

