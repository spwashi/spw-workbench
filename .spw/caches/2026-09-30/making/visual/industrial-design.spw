# Industrial Design
#
# A timeline of design ideas from the Bauhaus to repairability law, and a glossary of surface continuity, affordance, and mistake-proofing for studio practice.

#>visual_arts_industrial_design
#:layer #!reference
#:domain #!visual_arts
#:form #!timeline
#:level #!foundation
#:review #!sourced
#:valence #!bone
#:era #!modern

^"emit"{
 ~#title: "Industrial Design"
 ~#claim: "Industrial design moved from Bauhaus form to human factors, usability, universal design, and repairability, and its studio vocabulary includes G0 to G3 surface continuity."
 ~#proof: "Whitford on the Bauhaus, Dreyfuss and Norman on people and use, Farin and Barsky and DeRose on continuity, and EU Regulation 2023/1542 on batteries."
 ~#door: "Walk the timeline, then test continuity with a striped reflection on a glossy object."
 ~#audience: "design students, makers, and readers curious why objects look and work as they do"
 cold_open: "An object is shaped by ideas about people, and its surfaces show their continuity to anyone who watches a reflection slide across them."
 continuity: "Industrial Design | continuity"
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/design-and-industrial-engineering/undergrad-industrial-design.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: [
  "G3 continuity matches the rate of change of curvature; the raw called it torsion rate continuity",
  "the raw 28 percent surgical-handle fatigue figure is removed as invented",
  "the raw curriculum list is restructured as a dated timeline with a glossary"
 ]
}

^["edges"]{
 grounds: [ ~"../../registries/quantities/film-stage-visual.spw#q_film_design" ]
 see: [ ~"./illustration-and-visual-storytelling.spw#visual_arts_illus_notan" ]
}

^["concepts"]{
 primary: [ #continuity_class, #affordance ]
 transfers: [ #mistake_proofing, #repairability ]
 tensions: [ #planned_obsolescence ]
}

^["timeline"]{
 order: <<
  "Bauhaus" ;
  "human factors" ;
  "mingei" ;
  "responsible design" ;
  "mistake-proofing" ;
  "less but better" ;
  "universal design" ;
  "usability" ;
  "repairability law"
 >>

 #>visual_arts_id_bauhaus
 ^["bauhaus"]{
  #:claim #!settled
  statement: "The Bauhaus, founded by Walter Gropius in Weimar in 1919 and closed in 1933, joined art, craft, and industrial production in one school."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_whitford_1984"
  era: 1919..1933
 }
 #>visual_arts_id_dreyfuss
 ^["human_factors"]{
  #:claim #!settled
  statement: "Henry Dreyfuss's Designing for People (1955) made body measurements and human factors a working basis for product design."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_dreyfuss_1955"
 }
 #>visual_arts_id_mingei
 ^["mingei"]{
  #:claim #!settled
  statement: "Soetsu Yanagi's mingei movement in Japan prized anonymous, everyday folk craft; The Unknown Craftsman (1972) carried it to English readers."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_yanagi_1972"
 }
 #>visual_arts_id_papanek
 ^["responsible_design"]{
  #:claim #!settled
  statement: "Victor Papanek's Design for the Real World (1971) argued that designers answer for social and environmental harm as well as form."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_papanek_1971"
 }
 #>visual_arts_id_poka_yoke
 ^["mistake_proofing"]{
  #:claim #!settled
  statement: "Shigeo Shingo described poka-yoke, devices that make a wrong action impossible or obvious, in Zero Quality Control (1986)."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_shingo_1986"
 }
 #>visual_arts_id_rams
 ^["less_but_better"]{
  #:claim #!settled
  statement: "Dieter Rams set out ten principles of good design from his work at Braun, summed up as less but better."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_klemp_2009"
 }
 #>visual_arts_id_universal
 ^["universal_design"]{
  #:claim #!settled
  statement: "The Center for Universal Design at NC State published seven Principles of Universal Design in 1997, aiming at use by as many people as possible without adaptation."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_ncsu_ud_1997"
 }
 #>visual_arts_id_norman
 ^["usability"]{
  #:claim #!settled
  statement: "Don Norman's The Design of Everyday Things (revised 2013) separates affordances, what an object allows, from signifiers, what tells a user how to act."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_norman_2013"
 }
 #>visual_arts_id_batteries
 ^["repairability_law"]{
  #:claim #!settled
  statement: "EU Regulation 2023/1542 requires portable batteries in appliances to be removable and replaceable by the end user, from a date set in its Article 11."
  reads: %[film.eu_battery.removable_from]
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_eu_batteries_2023"
  as_of: "2026-10-01"
 }
}

^["glossary"]{
 #>visual_arts_id_continuity
 ^["continuity_classes"]{
  #:claim #!settled
  statement: "G0 joins surfaces at an edge, G1 also matches tangent direction, G2 also matches curvature, and G3 also matches the rate of change of curvature."
  sources: [ ~"../../registries/sources/film-stage-visual.spw#src_film_farin_2002", ~"../../registries/sources/film-stage-visual.spw#src_film_barsky_derose_1989" ]
  ^["zebra"]{
   #:claim #!settled
   statement: "Reflection lines break at a G0 joint, kink at a G1 joint, and flow smoothly across a G2 joint, which is why studios check surfaces with zebra stripes."
   source: ~"../../registries/sources/film-stage-visual.spw#src_film_farin_2002"
  }
 }
 #>visual_arts_id_affordance
 ^["affordance"]{
  sense: "what an object physically allows a person to do"
  see: [ ~"./industrial-design.spw#visual_arts_id_norman" ]
 }
 #>visual_arts_id_dfm
 ^["design_for_manufacture"]{
  sense: "shaping a part for its process: draft for molding, even walls, and parting lines placed where they hide"
 }
 #>visual_arts_id_cmf
 ^["cmf"]{
  sense: "color, material, and finish, specified together for each surface"
 }
}

^["stance"]{
 #>visual_arts_id_repair_stance
 ^["repair"]{
  #:claim #!interpretive
  statement: "A product that opens with ordinary tools and takes a replaceable battery respects its owner's time and money; the cut reads repairability as a design value, not only a legal duty."
 }
}

^["try"]{
 #>visual_arts_id_try_zebra
 ^["reflection_check"]{
  materials: [ "a glossy object such as a mug or car panel", "a phone or monitor showing black and white stripes" ]
  steps: <<
   "show stripes on the screen" ;
   "hold the object so the stripes reflect" ;
   "slide the object slowly" ;
   "watch where stripes break, kink, or flow" ;
   "mark each joint G0, G1, or G2"
  >>
  time: .{ n: 15, unit: "minutes" }
  safety: "no hazard worth naming"
  shows: ~"./industrial-design.spw#visual_arts_id_continuity"
 }
}

#>visual_arts_id_touch_q
?["Can fingertips feel the difference between a G1 and a G2 blend?"]{
 #:depth #!experiential ~#lens(material grain)
 #:claim #!speculative
 ~#hypothesis: "A curvature jump at a G1 blend may be felt as an edge by sliding fingertips, though the threshold has not been measured here."
 !probe{ "mill paired blocks blended at G1 and G2 and run a blind touch test" =id[p_film_id_touch_blend] =kind[build] }
 ~"./industrial-design.spw#visual_arts_id_continuity" ~#neighbor(nearest)
}

#>visual_arts_id_battery_q
?["Will removable-battery rules lengthen how long phones stay in use?"]{
 #:depth #!ethical ~#lens(market flow)
 #:claim #!speculative
 ~#hypothesis: "Phones sold under the EU battery rule stay in use longer than earlier models, because battery wear stops forcing replacement of the whole device."
 !probe{ "compare device retirement ages before and after the Article 11 date in EU market surveys" =id[p_film_id_battery_life] =kind[census] }
 $%[film.eu_battery.removable_from]
 ~"./industrial-design.spw#visual_arts_id_batteries" ~#neighbor(nearest)
}
