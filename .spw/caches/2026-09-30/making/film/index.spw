# Film
#
# The film production branch: how a project moves, how a set runs, who protects whom, the rights and labor agreements underneath, and the season the work is released into.

#>film_index
#:layer #!reference
#:domain #!film
#:form #!index
#:level #!practitioner
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Film"
 ~#claim: "The film branch follows a project from rights and development through the shooting day to release, with safety, consent, and labor agreements as its load-bearing rules."
 ~#proof: "Each leaf cites guild agreements, safety bulletins, statutes, case law, or textbooks for its keystones."
 ~#door: "Start with the production state machine, then the shooting day."
 ~#audience: "film students, crew, producers, and readers following the industry"
 cold_open: "A film is made by a crew working under rules about rest, safety, consent, and rights, and this branch lays them out."
 continuity: "Film | crew"
}

