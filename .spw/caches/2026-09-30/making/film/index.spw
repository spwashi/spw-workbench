^["stance"]{
 #>film_index_care_stance
 ^["care_of_vulnerability"]{
  #:claim #!interpretive
  statement: "Performers expose themselves on camera and crews work long hours near real hazards, so this branch treats care for both as a condition of the work."
 }
 #>film_index_respect_stance
 ^["respect_across_departments"]{
  #:claim #!interpretive
  statement: "A take succeeds only when camera, sound, grip, electric, and cast move together, which is a practical reason to respect every department."
 }
}

^["gaps"]{
 producing_programs: "graduate producing programs and their rung wait for a leaf"
 distribution_math: "windows and box office receipts live in society markets, not here"
 acoustics: "loudness standards cite broadcast and cinema specs but no acoustics leaf grounds them yet"
}
