# Independent Authorship
#
# How independent authors write, package, publish, and reach readers, with routes, tools, genres, and cases dated and sourced.

#>authorship_index
#:layer #!reference
#:domain #!authorship
#:form #!index
#:level #!practitioner
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Independent Authorship"
 ~#claim: "Independent authorship is a business of routes, files, genres, and seasons, and this branch keeps each of them dated so an author can act on it."
 ~#proof: "Platform terms come from KDP help pages read on 2026-10-01; genre origins and cases cite published sources."
 ~#door: "Start with the manuscript graph, then the platforms matrix; read the Kindle Unlimited case before choosing exclusivity."
 ~#audience: "independent authors and readers curious about how books reach them"
 continuity: "Independent Authorship | routes, files, genres, and seasons"
 cold_open: "Independent authorship runs on routes, files, genres, and seasons, each with a date."
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5"
 lineage: #[ ".spw/caches/indie-author-ecosystem/taste.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: #[
  "the taste file is reduced to an interpretive stance; its claims about corporate homogeneity and perpetual ownership are not carried as facts",
  "the raw indie author index was routing only and is replaced by this tree"
 ]
}

^["tree"]{
 manuscript_dag: ~"./manuscript-to-market-dag.spw"
 platforms: ~"./platforms-and-business-models.spw"
 toolchain: ~"./author-toolchain.spw"
 genres: ~"./genre-conventions.spw"
 marketing: ~"./readers-and-marketing.spw"
 calendar: ~"./author-season-calendar.spw"
 kindle_unlimited: ~"./kindle-unlimited-case.spw"
 martian: ~"./martian-serial-to-screen.spw"
}

^["bundle"]{
 ={
  ~"./manuscript-to-market-dag.spw#authorship_manuscript_dag"
  ~"./platforms-and-business-models.spw#authorship_platforms"
  ~"./author-toolchain.spw#authorship_toolchain"
  ~"./genre-conventions.spw#authorship_genres"
  ~"./readers-and-marketing.spw#authorship_marketing"
  ~"./author-season-calendar.spw#authorship_season_calendar"
  ~"./kindle-unlimited-case.spw#authorship_kindle_unlimited"
  ~"./martian-serial-to-screen.spw#authorship_martian_case"
 }
}

^["order"]{
 pmest: "domain authorship; matter from routes to genres; energy from protocol to comparison to ledger to dossier; time current, with cases contemporary"
 reading: << "manuscript graph" ; "platforms" ; "toolchain" ; "genres" ; "marketing" ; "calendar" ; "cases" >>
}

^["stance"]{
 #>authorship_index_sovereignty
 ^["sovereignty"]{
  #:claim #!interpretive
  statement: "Independent publishing lets an author keep control of cover, price, and schedule, and lets genre pleasures stand without a gatekeeper to approve them."
 }
 #>authorship_index_patience
 ^["patience"]{
  #:claim #!interpretive
  statement: "Store momentum rewards fast series, and many authors guard craft against that speed; the tension is real and each author settles it differently."
 }
 #>authorship_index_communion
 ^["communion"]{
  #:claim #!interpretive
  statement: "Newsletters, serial comments, and crowdfunding updates put authors in direct contact with readers, and veteran authors often share tools and numbers with newcomers."
 }
}

^["gaps"]{
 craft: "literary craft itself; this branch covers the business and packaging of books"
 graduate: "a graduate rung for publishing and producing programs"
 serials: "newsletters and serialized writing as their own surfaces"
 non_us: "store terms here are mostly Amazon.com and US law; other markets are verify"
}
