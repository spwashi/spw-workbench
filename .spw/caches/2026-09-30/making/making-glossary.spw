# Making Glossary
#
# Short definitions for the working words of film, theatre, animation, publishing, and broadcast, linked to the leaves that use them and to each other where senses meet or split.

#>making_glossary
#:layer #!reference
#:domain #!making
#:form #!glossary
#:level #!foundation
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Making Glossary"
 ~#claim: "A small lattice of working words, from call sheet and turnaround to key frame, run sheet, and advance reader copy, each pointing to the leaf that uses it."
 ~#proof: "Definitions follow the leaves they link, which cite agreements, handbooks, and statutes."
 ~#door: "Look up a word, then follow its link into the leaf where it does work."
 ~#audience: "newcomers to any of the making crafts"
 cold_open: "Every craft has working words, and this glossary links each one to the place where it does its job."
 continuity: "Making Glossary | working words"
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["edges"]{
 grounds: [ ~"./film/set-operations-and-crew.spw#film_set_operations", ~"./film/adaptation-and-rights.spw#film_adaptation" ]
}

^["concepts"]{
 primary: [ #call_sheet, #turnaround, #option ]
 transfers: [ #key_frame, #blocking, #closed_set, #stripboard, #procurement ]
 tensions: [ #public_domain ]
}

^["film_terms"]{
 #>making_term_call_sheet
 ^["call_sheet"]{
  sense: "the next day's plan: scenes, call times, locations, and the nearest hospital"
  see: [ ~"./film/set-operations-and-crew.spw#film_set_call_sheet" ]
 }
 #>making_term_stripboard
 ^["stripboard"]{
  sense: "scene strips ordered across shooting days"
  see: [ ~"./film/set-operations-and-crew.spw#film_set_stripboard" ]
 }
 #>making_term_turnaround_rest
 ^["turnaround_rest"]{
  sense: "the rest period from wrap to the next call, set by each worker's agreement"
  see: [ ~"./film/set-operations-and-crew.spw#film_set_turnaround" ]
  contrasts: [ ~"./making-glossary.spw#making_term_turnaround_project" ]
 }
 #>making_term_turnaround_project
 ^["turnaround_project"]{
  sense: "a studio's release of a stalled project so a producer can set it up elsewhere, usually against repayment of costs"
  see: [ ~"./film/production-state-machine.spw#film_production_development" ]
  contrasts: [ ~"./making-glossary.spw#making_term_turnaround_rest" ]
 }
 #>making_term_golden_time
 ^["golden_time"]{
  sense: "premium pay after a long elapsed day; the threshold and rate depend on the agreement"
  see: [ ~"./film/set-operations-and-crew.spw#film_set_golden_time" ]
 }
 #>making_term_procurement
 ^["procurement"]{
  sense: "finding and negotiating employment for an artist, which California reserves to licensed talent agencies"
  see: [ ~"./film/careers-and-representation.spw#film_careers_taa" ]
 }
 #>making_term_closed_set
 ^["closed_set"]{
  sense: "a set limited to essential, agreed personnel, used for intimate and sensitive scenes"
  see: [ ~"./film/intimacy-coordination.spw#film_intimacy_closed_set" ]
 }
 #>making_term_picture_lock
 ^["picture_lock"]{
  sense: "the point in editing after which the cut no longer changes, so sound and effects can be fitted"
  see: [ ~"./film/production-state-machine.spw#film_production_post" ]
 }
}

^["rights_terms"]{
 #>making_term_option
 ^["option"]{
  sense: "a paid, exclusive right for a set period to buy film rights in a work"
  see: [ ~"./film/adaptation-and-rights.spw#film_rights_option" ]
  extends: [ ~"./making-glossary.spw#making_term_shopping" ]
 }
 #>making_term_shopping
 ^["shopping_agreement"]{
  sense: "permission to pitch a property without buying an option"
  see: [ ~"./film/adaptation-and-rights.spw#film_rights_shopping" ]
 }
 #>making_term_chain_of_title
 ^["chain_of_title"]{
  sense: "the documents showing who owns each right a film uses"
  see: [ ~"./film/adaptation-and-rights.spw#film_rights_chain" ]
 }
 #>making_term_public_domain
 ^["public_domain"]{
  sense: "works whose copyright has expired or never applied; in the US, works published through 1930 as of 2026"
  see: [ ~"./film/adaptation-and-rights.spw#film_rights_public_domain" ]
 }
}

^["stage_terms"]{
 #>making_term_blocking
 ^["blocking"]{
  sense: "planned movement of actors, on stage or for the camera"
  see: [ ~"./theatre/theatre-core.spw#theatre_core_blocking", ~"./film/set-operations-and-crew.spw#film_set_state_block" ]
 }
 #>making_term_given_circumstances
 ^["given_circumstances"]{
  sense: "the facts of the play an actor works within: who, where, when, and what has happened"
  see: [ ~"./theatre/theatre-core.spw#theatre_core_stanislavski" ]
 }
 #>making_term_prompt_book
 ^["prompt_book"]{
  sense: "the stage manager's master script with blocking and cues, used to call the show"
 }
}

^["animation_and_image_terms"]{
 #>making_term_key_frame
 ^["key_frame"]{
  sense: "a pose that defines an action; inbetweens fill the frames from one key to the next"
  see: [ ~"./visual/animation-principles.spw#visual_arts_anim_key_frame" ]
 }
 #>making_term_closure
 ^["closure"]{
  sense: "the reader's act of filling the gap between two panels"
  see: [ ~"./visual/illustration-and-visual-storytelling.spw#visual_arts_illus_mccloud" ]
  analog: [ ~"./film/film-school-sequence.spw#film_school_kuleshov" ]
 }
}

^["publishing_and_broadcast_terms"]{
 #>making_term_arc
 ^["advance_reader_copy"]{
  sense: "an early copy sent to reviewers and readers before release; reviews from it carry a disclosure"
  see: [ ~"./authorship/readers-and-marketing.spw#authorship_marketing" ]
 }
 #>making_term_run_sheet
 ^["run_sheet"]{
  sense: "a minute-by-minute plan for a live or recorded show: segments, roles, and timings"
  see: [ ~"./broadcast/episode-run-sheet.spw#broadcast_run_sheet" ]
 }
}

#>making_glossary_turnaround_q
?["Why does turnaround mean both a rest period and a stalled project?"]{
 #:depth #!historical ~#lens(semiotic charge)
 #:claim #!speculative
 ~#hypothesis: "Both senses describe a thing coming back around after a set time: a worker returning to call, a project returning to its owner."
 !probe{ "find the earliest trade-press uses of each sense of turnaround and date them" =id[p_film_glossary_turnaround] =kind[lit] }
 $%[film.iatse.turnaround_h]
 ~"./making-glossary.spw#making_term_turnaround_project" ~#neighbor(nearest)
}
