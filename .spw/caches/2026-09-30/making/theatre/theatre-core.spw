# Theatre Core
#
# Acting and staging methods side by side: where each came from, what it trains, and where its attention goes, with the Moscow Art Theatre founders set right.

#>theatre_core
#:layer #!reference
#:domain #!theatre
#:form #!comparison
#:level #!foundation
#:review #!sourced
#:valence #!bone

^"emit"{
 ~#title: "Theatre Core"
 ~#claim: "Acting methods differ by where they send attention: memory for Strasberg, imagination for Adler, the partner for Meisner, space and time for Viewpoints, the feet for Suzuki."
 ~#proof: "The teachers' own books, Benedetti on Stanislavski, and Overlie with Bogart and Landau on Viewpoints."
 ~#door: "Compare two rows, then try the repetition exercise with a partner."
 ~#audience: "theatre students, actors, directors, and curious audiences"
 cold_open: "Every acting method asks the actor to put attention somewhere, and the methods differ mainly in where."
 continuity: "Theatre Core | attention"
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/film-and-theatre/undergrad-theatre-and-dramatic-arts.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 corrections: [
  "the Moscow Art Theatre was founded by Stanislavski and Nemirovich-Danchenko; Chekhov was its playwright, not a founder",
  "Viewpoints are credited first to Mary Overlie, whose six viewpoints Bogart and Landau adapted into nine physical ones",
  "Adler and Strasberg rows are added; the raw named neither",
  "the raw 4 dB projection gain from Suzuki training is removed as invented"
 ]
}

^["edges"]{
 grounds: [ ~"../../registries/quantities/film-stage-visual.spw#q_film_craft" ]
 feeds: [ ~"./directing-lineages.spw#theatre_directing" ]
}

^["concepts"]{
 primary: [ #given_circumstances, #blocking ]
 transfers: [ #attention, #choreography, #ensemble ]
 tensions: [ #emotional_memory ]
}

^["roots"]{
 #>theatre_core_natyashastra
 ^["natyashastra"]{
  #:claim #!settled
  statement: "The Natyashastra, ascribed to Bharata, is an early Sanskrit treatise on drama that sets out rasa, the audience's savoring of emotion through performance."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_ghosh_1950"
 }
 #>theatre_core_zeami
 ^["zeami"]{
  #:claim #!settled
  statement: "Zeami's early fifteenth-century treatises set out the aesthetics and training of noh, including yugen and the actor's flower."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_zeami_1984"
 }
 #>theatre_core_mat
 ^["moscow_art_theatre"]{
  #:claim #!settled
  statement: "Stanislavski and Vladimir Nemirovich-Danchenko founded the Moscow Art Theatre in 1898; Anton Chekhov was its central playwright, beginning with The Seagull that year."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_benedetti_1999"
 }
}

^["methods"]{
 columns: #[ origin, trains, attention, key_text ]

 #>theatre_core_stanislavski
 ^["stanislavski"]{
  origin: "Moscow, from 1898 into the 1930s"
  trains: "given circumstances, objectives, the magic if, and later physical actions"
  attention: "the character's actions inside imagined circumstances"
  #:claim #!settled
  statement: "Stanislavski built a system around given circumstances and objectives, and in later work stressed physical actions as the way into feeling."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_stanislavski_2008"
 }
 #>theatre_core_strasberg
 ^["strasberg"]{
  origin: "Group Theatre, then the Actors Studio, New York"
  trains: "relaxation, sense memory, and affective memory"
  attention: "the actor's own remembered experience"
  #:claim #!settled
  statement: "Lee Strasberg's Method centered affective memory, drawing on the actor's own past to produce emotion on stage."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_strasberg_1987"
 }
 #>theatre_core_adler
 ^["adler"]{
  origin: "Group Theatre, then her own studio, New York"
  trains: "imagination, the text, and the given circumstances of the play"
  attention: "the imagined world of the play"
  #:claim #!settled
  statement: "Stella Adler taught that imagination and the play's circumstances, not the actor's private memories, should drive the role."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_adler_2000"
 }
 #>theatre_core_meisner
 ^["meisner"]{
  origin: "Neighborhood Playhouse, New York"
  trains: "repetition, emotional preparation, and independent activity"
  attention: "the scene partner, moment to moment"
  #:claim #!settled
  statement: "Sanford Meisner defined acting as living truthfully under imaginary circumstances and trained it through the repetition exercise."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_meisner_1987"
 }
 #>theatre_core_viewpoints
 ^["viewpoints"]{
  origin: "Mary Overlie in 1970s New York dance; adapted by Anne Bogart and Tina Landau"
  trains: "ensemble awareness of space and time"
  attention: "the room, the ensemble, and tempo"
  #:claim #!settled
  statement: "Mary Overlie developed six viewpoints in the 1970s; Anne Bogart and Tina Landau adapted them into nine physical viewpoints for actors."
  reads: %[film.viewpoints.overlie_count, film.viewpoints.physical_count]
  sources: [ ~"../../registries/sources/film-stage-visual.spw#src_film_overlie_2016", ~"../../registries/sources/film-stage-visual.spw#src_film_bogart_landau_2005" ]
 }
 #>theatre_core_suzuki
 ^["suzuki"]{
  origin: "Tadashi Suzuki, Tokyo and Toga, Japan"
  trains: "stamping, low center, and breath under strain"
  attention: "the feet, the floor, and the center of the body"
  #:claim #!settled
  statement: "Tadashi Suzuki built his actor training from the feet and lower body, drawing on noh and kabuki."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_suzuki_1986"
 }
 #>theatre_core_linklater
 ^["linklater"]{
  origin: "Kristin Linklater, from London to New York"
  trains: "breath and voice freed from habitual tension"
  attention: "the breath and the body as one instrument"
  #:claim #!settled
  statement: "Kristin Linklater's Freeing the Natural Voice (1976) trains the voice by releasing habitual tension."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_linklater_1976"
 }
 #>theatre_core_brecht
 ^["brecht"]{
  origin: "Bertolt Brecht, Berlin"
  trains: "showing the character while keeping the audience critical"
  attention: "the social situation the scene exposes"
  #:claim #!settled
  statement: "Brecht's estrangement effect makes the familiar strange so spectators judge the action instead of only identifying with it."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_brecht_willett_1964"
 }
}

^["text_and_stage"]{
 #>theatre_core_ball
 ^["script_analysis"]{
  #:claim #!settled
  statement: "David Ball reads a play as a chain of triggers and heaps, each event causing the next, read backward and forward."
  source: ~"../../registries/sources/film-stage-visual.spw#src_film_ball_1983"
 }
 #>theatre_core_blocking
 ^["blocking"]{
  definition: "the planned movement of actors on stage, set in rehearsal and written in the prompt book"
  stages: #[ proscenium, thrust, arena, black_box ]
 }
}

^["try"]{
 #>theatre_core_try_repetition
 ^["repetition"]{
  materials: [ "a partner", "two chairs", "a timer" ]
  steps: <<
   "sit facing your partner" ;
   "one names something they notice" ;
   "the other repeats it exactly" ;
   "keep repeating and let it change only when behavior changes" ;
   "switch who begins"
  >>
  time: .{ n: 10, unit: "minutes" }
  safety: "keep observations about behavior, not about bodies or identity"
  shows: ~"./theatre-core.spw#theatre_core_meisner"
 }
}

#>theatre_core_listening_q
?["Does repetition train listening faster than table analysis does?"]{
 #:depth #!educational ~#lens(craft practice)
 #:claim #!speculative
 ~#hypothesis: "Actors who start with repetition respond to a changed line reading sooner in scene work than actors who start with table analysis."
 !probe{ "change one line reading unannounced in scene work and time each actor's adjustment" =id[p_film_theatre_listening] =kind[field] }
 ~"./theatre-core.spw#theatre_core_meisner" ~#neighbor(nearest)
}

#>theatre_core_flock_q
?["Is an ensemble in a Viewpoints session like a flock?"]{
 #:depth #!physical ~#lens(living system)
 #:claim #!speculative
 ~#hypothesis: "Shared attention to spacing and tempo lets group patterns emerge from local responses, as in flocking."
 breaks: "birds follow fixed local rules; actors choose, and can break a pattern on purpose"
 !probe{ "track ensemble positions on video and compare spacing to a simple flocking simulation" =id[p_film_theatre_flock] =kind[sim] }
 $%[film.viewpoints.physical_count]
 ~"./theatre-core.spw#theatre_core_viewpoints" ~#neighbor(nearest)
}
