# Theatre
#
# The theatre branch: acting and staging methods compared, and the teacher-to-student lineages of modern directing.

#>theatre_index
#:layer #!reference
#:domain #!theatre
#:form #!index
#:level #!foundation
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Theatre"
 ~#claim: "The theatre branch compares acting methods by where they send attention and traces modern directing from teacher to student."
 ~#proof: "Each leaf cites the practitioners' own books and a biography or history for every dated rung."
 ~#door: "Start with the methods matrix, then climb the directing ladder."
 ~#audience: "theatre students, actors, directors, and audiences"
 cold_open: "Theatre happens live in a shared room, and its methods are about where performers put their attention."
 continuity: "Theatre | attention"
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/film-and-theatre/taste.spw" ]
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-01", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
  }
 }
 corrections: [
  "the raw hypotheses of audience breathing synchrony within three seconds and 80 millisecond suppression at cuts are dropped as invented numbers",
  "the taste frame is reduced to an interpretive stance"
 ]
}

^["tree"]{
 core: ~"./theatre-core.spw"
 directing: ~"./directing-lineages.spw"
}

^["bundle"]{
 ={ ~"./theatre-core.spw#theatre_core" }
 ={ ~"./directing-lineages.spw#theatre_directing" }
}

^["leaves"]{
 theatre_core: .{ domain: #theatre, form: #comparison }
 directing_lineages: .{ domain: #theatre, form: #timeline, era: #modern }
}

^["stance"]{
 #>theatre_index_live_stance
 ^["live_and_fixed"]{
  #:claim #!interpretive
  statement: "A stage performance happens once in a room shared with its audience, while a film fixes one performance for replay; the branch reads theatre methods with that difference in view."
 }
 #>theatre_index_safety_stance
 ^["rehearsal_room"]{
  #:claim #!interpretive
  statement: "The rehearsal room works when actors can fail safely, with physical and intimate contact choreographed as carefully as a fight."
 }
}

^["gaps"]{
 musical_theatre: "musical theatre training and its own lineages have no leaf yet"
 design: "scenic, lighting, sound, and costume design wait for a scenography leaf"
 stage_management: "the prompt book and cue calling are glossed only in the making glossary"
}
