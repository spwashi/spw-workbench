# Errata: Culture and Society
#
# Raw claims about film, authorship, the arts, economics, hospitality, libraries, schooling, live platforms, and the podcast market that the review found wrong, dated, or uncredited, with corrections and sources.

#>provenance_errata_culture
#:layer #!reference
#:domain #!provenance
#:form #!ledger
#:level #!advanced
#:review #!sourced
#:valence #!bane

^"emit"{
 ~#title: "Errata: Culture and Society"
 ~#claim: "The raw culture files carried dated rules, inverted market shares, uncredited frameworks, and findings that did not replicate."
 ~#proof: "Each row cites a labor agreement, statute, court ruling, survey, replication, or the originating book."
 ~#door: "Find the raw path and line, check whether the row is dated, wrong, or uncredited, then open the corrected surface."
 ~#audience: "practitioners and students who met a raw rule, number, or attribution"
 continuity: "Errata: Culture and Society | dated rules"
 cold_open: "Rules change and credit matters, so dated rules, wrong numbers, and missing credits from the raw shelf are fixed here."
}

^"provenance"{
 as_of: "2026-10-03"
 generator: "gemini-3.8-flash-high"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/university-education/taste.spw", ".spw/caches/podcasting/market-research.spw", ".spw/caches/university-education/hospitality-and-management/index.spw" ]
 method: #corrected
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #corrected }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "payout, LitRPG, RSS, and turnaround rows corrected; the 2024 IATSE terms remain unread"
  }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r6"]{
   event: #fact_checked, at: "2026-10-03", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "LitRPG label credited to a writer and editors working with EKSMO in late 2013; Academy ratio set to about 1.37; current IATSE turnaround marked verify"
  }
  ^["r7"]{ event: #gated, at: "2026-10-03", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 checked: "every raw line was re-read at its path and line on 2026-10-02; dated rows carry the date of the rule that replaced them"
}

^["edges"]{
 grounds: [ ~"./review-scorecard.spw#provenance_scorecard" ]
 see: [ ~"../making/film/labor-agreements-ledger.spw#film_labor_ledger", ~"../society/platforms/monetization-receipt.spw#live_platforms_monetization" ]
}

^["concepts"]{
 primary: [ #correction, #supersession ]
 transfers: [ #guild_floor ]
 tensions: [ #overclaim ]
}

^["ranks"]{
 refuted: "the raw line is wrong"
 superseded: "the raw line was true once and a later rule, release, or count replaced it"
 contested: "the raw line states a disputed or single-study finding as settled"
 uncredited: "the raw line uses a named framework, genre, or method without its originator"
 speculative: "the raw line states a number no source supports"
}

^["film_and_arts"]{
 #>provenance_errata_film
 ^["film_rules_and_credits"]{
  #:claim #!refuted
  statement: "The raw film and arts files gave crews a turnaround the 2021 agreement contradicts, gave managers the right to procure work, and dropped the originators of several frameworks."
  corrected_in: ~"../making/film/set-operations-and-crew.spw#film_set_operations"
  ^["turnaround"]{
   at: ".spw/caches/film-production-and-industry/set-operations-and-crew-hierarchy.spw:48"
   rank: #refuted
   was: "a 12-hour crew rest period"
   now: "the 2021 IATSE Basic Agreement set a 10-hour crew turnaround, and 12 hours is the SAG-AFTRA performer rest; the 2024 agreement now governs, and its turnaround is unread"
   reads: %[film.iatse.turnaround_h, film.sagaftra.rest_period_h]
   sources: [ ~"../registries/sources/film-stage-visual.spw#src_film_iatse_ba_2021", ~"../registries/sources/film-stage-visual.spw#src_film_sagaftra_tvth_2023" ]
   current: #verify
   verify: "read the turnaround and weekend-rest terms of the 2024 Basic Agreement, for 2024 to 2027, and cite them with year; the IATSE summary page returned 403 to the fact-checker on 2026-10-03"
   next_source: ~"../registries/sources/film-stage-visual.spw#src_film_iatse_ba_2024"
   as_of: "2026-10-03"
  }
  ^["mfa_turnaround"]{ at: ".spw/caches/university-education/film-and-theatre/graduate-film-directing-and-cinema-mfa.spw:73", rank: #refuted, was: "a 12-hour turnaround for all cast and crew", now: "rest rules differ by union agreement; there is no single rule for everyone on a set", sources: [ ~"../registries/sources/film-stage-visual.spw#src_film_iatse_ba_2021", ~"../registries/sources/film-stage-visual.spw#src_film_sagaftra_tvth_2023" ] }
  ^["managers"]{ at: ".spw/caches/film-production-and-industry/hollywood-careers-and-industry-navigation.spw:17", rank: #refuted, was: "managers are unbound by procurement law", now: "California lets only licensed agents procure work; Marathon v. Blasi let courts sever violations, not excuse them", sources: [ ~"../registries/sources/film-stage-visual.spw#src_film_cal_taa", ~"../registries/sources/provenance-and-reference.spw#src_prov_marathon_2008" ] }
  ^["public_domain"]{ at: ".spw/caches/film-production-and-industry/novel-adaptations-and-literary-translation.spw:19", rank: #superseded, was: "works before 1929 are public domain", now: "as of 1 January 2026, US works published in 1930 or earlier are public domain", source: ~"../registries/sources/film-stage-visual.spw#src_film_duke_pdd_2026" }
  ^["academy_ratio"]{
   at: ".spw/caches/university-education/film-and-theatre/graduate-film-directing-and-cinema-mfa.spw:80"
   rank: #refuted
   was: "the 1.33 Academy ratio is a vertical portrait frame"
   now: "the Academy ratio is about 1.37 to 1 and the silent 4:3 frame is 1.33 to 1; both are wider than tall, and the fixation gain attached to it has no source"
   reads: %[film.aspect.academy_ratio, film.aspect.silent_ratio]
   source: ~"../registries/sources/film-stage-visual.spw#src_film_asc_manual"
  }
  ^["loudness"]{ at: ".spw/caches/university-education/illustration-and-animation/masters-animation-and-visual-direction.spw:77", rank: #refuted, was: "theatrical mixes target minus 24 LUFS", now: "minus 24 LKFS is the US broadcast target; theatrical mixes are set by calibrated playback level", source: ~"../registries/sources/film-stage-visual.spw#src_film_atsc_a85" }
  ^["twelve_principles"]{ at: ".spw/caches/university-education/illustration-and-animation/undergrad-animation-principles-and-craft.spw:14", rank: #refuted, was: "a twelve-principles frame listing eight", now: "Thomas and Johnston list twelve principles", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_thomas_johnston_1981" }
  ^["panel_transitions"]{ at: ".spw/caches/university-education/illustration-and-animation/undergrad-illustration-and-visual-storytelling.spw:56", rank: #uncredited, was: "action-to-action and aspect-to-aspect transitions", now: "the transition taxonomy is Scott McCloud's", source: ~"../registries/sources/film-stage-visual.spw#src_film_mccloud_1993" }
  ^["three_acts"]{ at: ".spw/caches/university-education/film-and-theatre/undergrad-film-studies-and-production.spw:29", rank: #uncredited, was: "one paradigm with plot points and an all-is-lost beat", now: "plot points come from Syd Field; the all-is-lost beat comes from Blake Snyder", sources: [ ~"../registries/sources/film-stage-visual.spw#src_film_field_1979", ~"../registries/sources/film-stage-visual.spw#src_film_snyder_2005" ] }
  ^["mat"]{ at: ".spw/caches/university-education/film-and-theatre/undergrad-theatre-and-dramatic-arts.spw:53", rank: #refuted, was: "Chekhov's Moscow Art Theatre", now: "Stanislavski and Nemirovich-Danchenko founded the Moscow Art Theatre in 1898; Chekhov wrote for it", source: ~"../registries/sources/film-stage-visual.spw#src_film_benedetti_1999" }
  ^["ceremony"]{ at: ".spw/caches/film-production-and-industry/crew-morale-safety-and-culture.spw:18", rank: #speculative, was: "a named three-point clearance ceremony", now: "firearm checks follow the industry safety bulletin; the ceremony name has no source", source: ~"../registries/sources/film-stage-visual.spw#src_film_csatf_bulletin_1" }
 }
}

^["authorship"]{
 #>provenance_errata_authorship
 ^["indie_publishing"]{
  #:claim #!superseded
  statement: "The raw indie author files described platforms and formats as they stood before 2022 and dropped the origins of two genres."
  corrected_in: ~"../making/authorship/platforms-and-business-models.spw#authorship_platforms"
  ^["smashwords"]{ at: ".spw/caches/indie-author-ecosystem/publishing-platforms-and-business-models.spw:22", rank: #superseded, was: "Smashwords and Draft2Digital as separate aggregators", now: "Draft2Digital acquired Smashwords in 2022", source: ~"../registries/sources/creators-and-platforms.spw#src_creator_wiki_smashwords" }
  ^["mobi"]{ at: ".spw/caches/indie-author-ecosystem/author-software-and-production-tools.spw:34", rank: #superseded, was: "Kindle sideloading by mobi", now: "Amazon has phased MOBI out; KDP takes EPUB for reflowable ebooks", source: ~"../registries/sources/creators-and-platforms.spw#src_creator_kdp_mobi" }
  ^["cultivation"]{ at: ".spw/caches/indie-author-ecosystem/genre-conventions-and-cultural-trends.spw:22", rank: #uncredited, was: "Western authors synthesize Taoist cultivation", now: "cultivation fiction comes from Chinese xianxia web novels; the LitRPG label was coined in late 2013 by a writer and two editors working with the Russian publisher EKSMO, after earlier Japanese, Korean, Taiwanese, and Western game-world fiction", sources: [ ~"../registries/sources/creators-and-platforms.spw#src_creator_wiki_xianxia", ~"../registries/sources/creators-and-platforms.spw#src_creator_wiki_litrpg" ] }
  ^["cliff"]{ at: ".spw/caches/indie-author-ecosystem/marketing-readers-and-community-traditions.spw:18", rank: #speculative, was: "a 30-day visibility cliff", now: "the cliff is community folklore about an undisclosed algorithm" }
  ^["arcs"]{ at: ".spw/caches/indie-author-ecosystem/marketing-readers-and-community-traditions.spw:27", rank: #refuted, was: "review teams with no disclosure duty", now: "free review copies are a material connection that reviewers must disclose", source: ~"../registries/sources/creators-and-platforms.spw#src_creator_ftc_endorsement_guides" }
 }
}

^["economics_and_hospitality"]{
 #>provenance_errata_hospitality
 ^["markets_and_service"]{
  #:claim #!contested
  statement: "The raw economics and hospitality files kept a dated instrument rule, read a satisfaction effect as loyalty, and leaned on a priming result that did not replicate."
  corrected_in: ~"../society/management/service-operations.spw#management_service_operations"
  ^["weak_iv"]{ at: ".spw/caches/university-education/economics/undergrad-econometrics-and-data-methods.spw:30", rank: #superseded, was: "a first-stage F above 10 avoids weak instruments", now: "a 2022 analysis shows that rule does not secure valid t-tests; adjusted critical values replace it", source: ~"../registries/sources/economy-and-markets.spw#src_econ_lee_mccrary_moreira_porter_2022" }
  ^["recovery_paradox"]{ at: ".spw/caches/university-education/hospitality-and-management/index.spw:44", rank: #refuted, was: "a recovered failure yields more loyalty than no failure", now: "the meta-analysis finds the paradox in satisfaction but not in repurchase intention or word of mouth", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_de_matos_2007" }
  ^["rate_parity"]{ at: ".spw/caches/university-education/hospitality-and-management/index.spw:38", rank: #superseded, was: "pricing must honor rate parity contracts", now: "the EU Digital Markets Act bars parity clauses for designated gatekeepers, Booking among them since 2024", sources: [ ~"../registries/sources/economy-and-markets.spw#src_econ_dma_2022", ~"../registries/sources/economy-and-markets.spw#src_econ_wiki_booking" ] }
  ^["menu_priming"]{ at: ".spw/caches/university-education/hospitality-and-management/food-and-beverage-systems-and-procurement.spw:39", rank: #contested, was: "removing the dollar sign reliably raises spending through money priming", now: "one field study found a menu-format effect; money priming failed large replications", sources: [ ~"../registries/sources/economy-and-markets.spw#src_econ_yang_kimes_sessarego_2009", ~"../registries/sources/provenance-and-reference.spw#src_prov_klein_2014" ] }
  conflict: "the cognitive psychology taste file calls pain-of-paying tactics a dark pattern while this food and beverage file recommends one; the management surface records the tension instead of picking a side"
 }
}

^["libraries"]{
 #>provenance_errata_lis
 ^["library_and_information_science"]{
  #:claim #!refuted
  statement: "The raw library files mislabeled a biomedical benchmark as legal, misframed national security letters, equated gold open access with author fees, and mythologized Alexandria."
  corrected_in: ~"../record/information/information-policy.spw#information_science_policy"
  ^["trec_covid"]{ at: ".spw/caches/university-education/library-and-information-sciences/information-retrieval-and-search-systems.spw:41", rank: #refuted, was: "TREC-COVID as a legal corpus", now: "TREC-COVID is a biomedical test collection built on COVID-19 literature", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_voorhees_2020" }
  ^["nsl"]{ at: ".spw/caches/university-education/library-and-information-sciences/information-policy-intellectual-freedom-and-literacy.spw:17", rank: #refuted, was: "libraries resist letters lacking a judicial warrant", now: "a letter never needs a warrant; recipients may challenge it in court, and the statute excludes libraries unless they provide electronic communication service", sources: [ ~"../registries/sources/provenance-and-reference.spw#src_prov_usc18_2709", ~"../registries/sources/provenance-and-reference.spw#src_prov_doe_v_gonzales_2005" ] }
  ^["gold_oa"]{ at: ".spw/caches/university-education/library-and-information-sciences/information-policy-intellectual-freedom-and-literacy.spw:29", rank: #refuted, was: "gold open access means author-paid fees", now: "gold means the journal itself publishes openly; many gold journals charge no fee", sources: [ ~"../registries/sources/provenance-and-reference.spw#src_prov_suber_2012", ~"../registries/sources/provenance-and-reference.spw#src_prov_bosman_2021" ] }
  ^["alexandria"]{ at: ".spw/caches/university-education/library-and-information-sciences/taste.spw:40", rank: #contested, was: "one burning set science back a millennium", now: "the library declined over centuries; the single catastrophic fire is largely legend", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_bagnall_2002" }
 }
}

^["schooling"]{
 #>provenance_errata_schooling
 ^["schools_and_universities"]{
  #:claim #!refuted
  statement: "The raw schooling files overstated what law requires of parents, privacy statutes, debate leagues, transfer credit, faculty senates, budgets, and learning speed."
  corrected_in: ~"../learning/secondary/student-support.spw#secondary_schooling_support"
  ^["ferpa_hipaa"]{ at: ".spw/caches/secondary-education/family-and-community-wraparound.spw:82", rank: #refuted, was: "HIPAA and FERPA interoperability guidelines", now: "school-held student health records are usually FERPA education records, not HIPAA records", source: ~"../registries/sources/learning-and-generations.spw#src_learn_ferpa_hipaa_2019" }
  ^["fee_waivers"]{ at: ".spw/caches/secondary-education/family-and-community-wraparound.spw:34", rank: #refuted, was: "automatic waiver of all fees", now: "federal law requires removing barriers for homeless students; which fees are waived varies by state and district", source: ~"../registries/sources/learning-and-generations.spw#src_learn_ehcy_guidance" }
  ^["iep_parents"]{ at: ".spw/caches/secondary-education/student-support-services.spw:66", rank: #refuted, was: "parent participation is mandatory", now: "schools must offer parents the chance to take part and may proceed after documented attempts fail", source: ~"../registries/sources/learning-and-generations.spw#src_learn_idea_regs" }
  ^["ratio"]{
   at: ".spw/caches/secondary-education/student-support-services.spw:15"
   rank: #superseded
   was: "a national average above 400 students per counselor"
   now: "ASCA reports a lower national ratio and recommends 250"
   reads: %[learn.counsel.us_ratio_students, learn.counsel.asca_ratio_students]
   source: ~"../registries/sources/learning-and-generations.spw#src_learn_asca_ratios"
  }
  ^["dual_enrollment"]{ at: ".spw/caches/secondary-education/advanced-curricula.spw:41", rank: #refuted, was: "guaranteed credit transfer", now: "receiving colleges decide which credits transfer and how they count", source: ~"../registries/sources/learning-and-generations.spw#src_learn_gao_2017" }
  ^["ceda"]{ at: ".spw/caches/secondary-education/stem-and-humanities-pathways.spw:40", rank: #refuted, was: "CEDA as a high school league", now: "CEDA is intercollegiate; high school debate runs through the NSDA and state leagues", sources: [ ~"../registries/sources/learning-and-generations.spw#src_learn_ceda", ~"../registries/sources/learning-and-generations.spw#src_learn_nsda" ] }
  ^["senate"]{ at: ".spw/caches/university-education/governance-and-tenure.spw:69", rank: #refuted, was: "senate resolutions bind unless trustees veto", now: "faculty hold primary responsibility for curriculum, but governing boards keep final authority", source: ~"../registries/sources/learning-and-generations.spw#src_learn_aaup_1966" }
  ^["nsf"]{
   at: ".spw/caches/university-education/research-and-funding.spw:17"
   rank: #refuted
   was: "an NSF budget above ten billion dollars"
   now: "the enacted NSF budget was below that line in FY2024 and FY2025"
   reads: %[learn.fund.nsf_fy2024_usd_b, learn.fund.nsf_fy2025_usd_b]
   source: ~"../registries/sources/learning-and-generations.spw#src_learn_nsf_budget"
  }
  ^["five_times"]{ at: ".spw/caches/university-education/pedagogical-scaffolding.spw:68", rank: #speculative, was: "speaking in class makes learning five times faster", now: "active learning improves exam scores and lowers failure in a meta-analysis; no fivefold speed is shown", source: ~"../registries/sources/learning-and-generations.spw#src_learn_freeman_2014" }
  ^["hypatia"]{ at: ".spw/caches/university-education/taste.spw:35", rank: #refuted, was: "reading Hypatia", now: "no writing survives under Hypatia's name; she is known through others", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_dzielska_1995" }
 }
}

^["platforms_and_podcasting"]{
 #>provenance_errata_podcast_market
 ^["podcast_market"]{
  #:claim #!refuted
  statement: "The raw podcast market file inverted the listening-platform ranking, credited RSS to the W3C, and filled its frames with unsourced numbers."
  corrected_in: ~"../society/markets/media-market-receipts.spw#markets_media_receipts"
  ^["shares"]{
   at: ".spw/caches/podcasting/market-research.spw:53"
   rank: #refuted
   was: "Spotify first, Apple second, YouTube third"
   now: "in Edison's 2024 data YouTube led, then Spotify, then Apple"
   reads: %[
    econ.podcast.edison_2024_youtube_pct,
    econ.podcast.edison_2024_spotify_pct,
    econ.podcast.edison_2024_apple_pct
   ]
   source: ~"../registries/sources/economy-and-markets.spw#src_econ_edison_2024_platforms"
  }
  ^["rss"]{ at: ".spw/caches/podcasting/market-research.spw:84", rank: #refuted, was: "RSS is a W3C standard", now: "RSS 2.0 began at UserLand in 2002, was republished by the Berkman Center at Harvard in 2003, and is maintained by the RSS Advisory Board; it is not a W3C standard", source: ~"../registries/sources/provenance-and-reference.spw#src_prov_rss_2003" }
  unsourced: [
   ".spw/caches/podcasting/market-research.spw:11 market size",
   ".spw/caches/podcasting/market-research.spw:15 listener totals",
   ".spw/caches/podcasting/market-research.spw:17 listening contexts",
   ".spw/caches/podcasting/market-research.spw:22 completion rates",
   ".spw/caches/podcasting/market-research.spw:43 conversion rates"
  ]
 }
 #>provenance_errata_live_platforms
 ^["live_gifts"]{
  #:claim #!refuted
  statement: "The raw live-platform files stacked an unsourced 50 percent cut on an unsourced conversion, fabricated a ranking formula, and omitted the age and follower gates for hosting."
  source: ~"../registries/sources/creators-and-platforms.spw#src_creator_tiktok_virtual_items"
  corrected_in: ~"../society/platforms/monetization-receipt.spw#live_platforms_monetization"
  ^["payout"]{
   at: ".spw/caches/tiktok-live/virtual-economy.spw:29"
   rank: #speculative
   was: "a 50 percent share taken at cashout after conversion"
   now: "the policy publishes neither the Gift-to-Diamond rate nor the Diamond-to-cash rate, so no fixed 50 percent cut can be read off either step; the raw arithmetic has no source"
   reads: %[creator.live.coin_to_diamond, creator.live.diamond_to_usd]
   source: ~"../registries/sources/creators-and-platforms.spw#src_creator_tiktok_virtual_items"
  }
  ^["ranking"]{ at: ".spw/caches/tiktok-live/analytics-metrics.spw:23", rank: #speculative, was: "a diamonds-per-viewer-minute ranking formula", now: "no platform publishes such a formula" }
 }
}

#>provenance_errata_culture_q
?["Do dated rules outnumber plain errors in the culture files because rules change on a clock?"]{
 #:depth #!social ~#lens(production cadence)
 #:claim #!speculative
 ~#hypothesis: "Labor, platform, and publishing rows will be mostly superseded, while history and attribution rows will be mostly refuted or uncredited."
 !probe{ "count ranks per section of this ledger and compare superseded shares between rule-bound and history-bound sections" =id[p_prov_errata_culture_clock] =kind[census] }
 $%[prov.review.r1_file_count, prov.review.r2_file_count]
 ~"./errata-culture-and-society.spw#provenance_errata_schooling" ~#neighbor(nearest)
}
