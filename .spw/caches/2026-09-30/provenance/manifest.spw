#>provenance_manifest_drift_q
?["Which raw files will drift first if the shelf is left in place for years?"]{
 #:depth #!computational ~#lens(curated collection)
 #:claim #!speculative
 ~#hypothesis: "Rows whose action is drop drift least, because nothing points at them but this manifest; rows with many target anchors invite edits."
 !probe{ "rerun every checksum each quarter and count mismatches by action" =id[p_prov_manifest_drift] =kind[census] }
 $%[prov.raw.file_count, prov.migration.drop_count]
 ~"./manifest.spw#provenance_manifest_pin" ~#neighbor(nearest)
}
