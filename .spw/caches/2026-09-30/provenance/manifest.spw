# Raw Shelf Manifest
#
# One row per raw path under .spw/caches, pinned by sha256 and line count at commit 229aedcf, with the action and target anchors the cut plan assigned.

#>provenance_manifest
#:layer #!reference
#:domain #!provenance
#:form #!registry
#:level #!practitioner
#:review #!sourced
#:valence #!bone

^"emit"{
 ~#title: "Raw Shelf Manifest"
 ~#claim: "Every raw path the cut drew on is pinned in place by its sha256 and line count, with its disposition and target anchors."
 ~#proof: "Checksums computed from git show at commit 229aedcf; dispositions copied from the cut plan migration rows."
 ~#door: "Pick any row, recompute its checksum, then follow a target anchor to the surface that replaced it."
 ~#audience: "reviewers, archivists, and anyone tracing a claim back to the generated shelf"
 continuity: "Raw Shelf Manifest | pinned in place"
 cold_open: "Every raw file stays pinned in place by its fingerprint, so any claim can be traced back to the shelf it came from."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ ".spw/caches/ (208 raw paths at commit 229aedcf, one row each below)" ]
 method: #computed
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-09-30", agent: "gemini-3.8-flash-high", care: #glance, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["edges"]{
 grounds: [ ~"../registries/quantities/provenance-and-reference.spw#q_prov_raw" ]
 see: [ ~"./harm-register.spw#provenance_harm_register", ~"./review-scorecard.spw#provenance_scorecard" ]
}

^["concepts"]{
 primary: [ #fixity, #provenance ]
 transfers: [ #respect_des_fonds ]
 tensions: [ #shelf_drift ]
}

^["pin"]{
 #>provenance_manifest_pin
 ^["checksums"]{
  #:claim #!settled
  statement: "Each row pins a raw path by the sha256 of its bytes at commit 229aedcf; the 207 generated paths hash identically at 5acc5545."
  reads: %[prov.raw.file_count, prov.raw.line_count]
  sources: [ ~"../registries/sources/provenance-and-reference.spw#src_prov_raw_shelf", ~"../registries/sources/provenance-and-reference.spw#src_prov_fips_180_4" ]
  ^["limits"]{
   holds: "the bytes git stores for each path at commit 229aedcf"
   fails: "a later edit to a raw file changes its hash; recompute before each publish and treat any mismatch as drift"
  }
 }
 #>provenance_manifest_actions
 ^["dispositions"]{
  #:claim #!settled
  statement: "Actions and targets are copied from the cut plan migration: keep, merge, drop, split, reframe, or quarantine, each with its planned target anchors."
  reads: %[prov.migration.keep_count, prov.migration.merge_count, prov.migration.drop_count, prov.migration.split_count, prov.migration.reframe_count, prov.migration.quarantine_count]
  source: ~"../registries/sources/provenance-and-reference.spw#src_prov_plan_v2"
 }
 rules: [
  "no tarball is carried and no raw path is removed; the shelf stays where it is",
  "the shelf index row records its checksum and out-of-scope status only",
  "resume/ is owner-authored and is not listed",
  "a drop row points back at this manifest, which is the only place that path is named"
 ]
}

