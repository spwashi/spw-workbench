#>provenance_errata_technical_q
?["Do invented editor features cluster in the parts of a host the generator could not read?"]{
 #:depth #!computational ~#lens(information flow)
 #:claim #!speculative
 ~#hypothesis: "Features declared in plugin.xml or package.json came out right, while behavior hidden in method bodies was invented more often."
 !probe{ "tag each editor row by whether the true answer sits in a manifest or in code, then compare error rates" =id[p_prov_errata_editor_visibility] =kind[census] }
 $%[prov.review.r1_file_count, prov.migration.drop_count]
 ~"./errata-technical.spw#provenance_errata_jb_navigation" ~#neighbor(nearest)
}
