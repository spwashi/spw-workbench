# Reference Works Lineage
#
# A ladder of reference works and knowledge tools, from Chinese leishu and the wheels of Llull to Wikidata, each named for the working pattern it left to later librarians, archivists, and this cut.

#>information_science_reference_lineage
#:layer #!reference
#:domain #!information_science
#:form #!timeline
#:level #!intro
#:review #!adversarial_checked
#:valence #!boon

^"emit"{
 ~#title: "Reference Works Lineage"
 ~#claim: "Reference works across many centuries invented the habits this cut uses: compiled categories, combining wheels, cross-references, visible gaps, facets, trails, linked cards, fixity, and linked statements."
 ~#proof: "Histories of the Yongle Encyclopedia, Llull, the Encyclopedie, Mendeleev, Otlet, Warburg, Ranganathan, Bush, Luhmann, Foxfire, the Whole Earth Catalog, Britannica, OAIS, LOCKSS, and Wikidata."
 ~#door: "Climb the ladder and note the pattern at each rung, then open the patterns matrix."
 ~#audience: "anyone curious how reference works are built, and writers of this cut"
 continuity: "Reference Works Lineage | invented the habits"
 cold_open: "Long before search engines, librarians and compilers invented the habits this cut uses to cross-reference and mark its gaps."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #pass
   note: "Yongle, Encyclopedie, Mendeleev, Wilkins, Llull, Luhmann, and Wikidata dates confirmed"
  }
  ^["r5"]{ event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
 framing: "these works are read as library practice that later tools borrowed, not as rescue from collapse"
}

^["edges"]{
 grounds: [ ~"../../registries/quantities/provenance-and-reference.spw#q_prov_reference" ]
 feeds: [ ~"./archive-patterns-matrix.spw#information_science_patterns" ]
}

^["concepts"]{
 primary: [ #renvoi, #visible_gap ]
 transfers: [ #faceted_classification, #fixity ]
 tensions: [ #ossified_taxonomy ]
}

^["ladder"]{
 #>information_science_lineage_leishu
 ^["leishu"]{
  #:claim #!settled
  era: "from the third century; the Yongle Encyclopedia completed in 1408"
  statement: "Chinese leishu compiled excerpts under fixed categories for officials and scholars; the Ming Yongle Encyclopedia was the largest, and only a small part of it survives."
  reads: %[prov.yongle.volume_count]
  sources: [ ~"../../registries/sources/provenance-and-reference.spw#src_prov_wilkinson_2012", ~"../../registries/sources/provenance-and-reference.spw#src_prov_tsai_2001" ]
  pattern: "compiled categories, quoted rather than rewritten"
 }
 #>information_science_lineage_llull
 ^["llull"]{
  #:claim #!settled
  era: "about 1274 to 1308"
  statement: "Ramon Llull built his Art on rotating figures that combined a fixed set of principles, so a reader could generate questions mechanically."
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_bonner_2007"
  pattern: "combinatorial wheels that generate prompts"
 }
 #>information_science_lineage_commonplace
 ^["commonplaces"]{
  #:claim #!settled
  era: "sixteenth and seventeenth centuries"
  statement: "Early modern scholars managed too much to read with commonplace books, florilegia, indexes, and slips that could be cut and rearranged."
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_blair_2010"
  pattern: "excerpt under a heading, then index the headings"
 }
 #>information_science_lineage_encyclopedie
 ^["encyclopedie"]{
  #:claim #!settled
  era: "1751 to 1772"
  statement: "Diderot and d'Alembert's Encyclopedie ran to text and plate volumes, and its renvois, or cross-references, linked articles across the alphabet."
  reads: %[prov.encyclopedie.text_volume_count, prov.encyclopedie.plate_volume_count]
  sources: [ ~"../../registries/sources/provenance-and-reference.spw#src_prov_artfl_encyclopedie", ~"../../registries/sources/provenance-and-reference.spw#src_prov_diderot_1755" ]
  pattern: "typed cross-references across an alphabetical order"
 }
 #>information_science_lineage_mendeleev
 ^["mendeleev"]{
  #:claim #!settled
  era: "1869, confirmed 1875, 1879, and 1886"
  statement: "Mendeleev left gaps in his 1869 table and predicted their elements; gallium, scandium, and germanium filled three of them."
  reads: %[prov.mendeleev.confirmed_prediction_count]
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_scerri_2007"
  pattern: "an empty cell that names its expected neighbors"
 }
 #>information_science_lineage_otlet
 ^["otlet"]{
  #:claim #!settled
  era: "from 1895"
  statement: "Paul Otlet and Henri La Fontaine built a universal card bibliography and the Universal Decimal Classification to link facts across documents."
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_rayward_1975"
  pattern: "a card per fact, joined by classification signs"
 }
 #>information_science_lineage_warburg
 ^["warburg"]{
  #:claim #!settled
  era: "1924 to 1929"
  statement: "Aby Warburg's Mnemosyne Atlas pinned images from many eras to panels so their recurring gestures could be compared side by side."
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_gombrich_1970"
  pattern: "plates that set distant eras beside each other"
 }
 #>information_science_lineage_ranganathan
 ^["ranganathan"]{
  #:claim #!settled
  era: "1931 and 1933"
  statement: "S. R. Ranganathan stated five laws of library science and built Colon Classification from facets instead of a fixed list."
  sources: [ ~"../../registries/sources/provenance-and-reference.spw#src_prov_ranganathan_1931", ~"../../registries/sources/provenance-and-reference.spw#src_prov_ranganathan_1933" ]
  pattern: "closed facets combined per item"
 }
 #>information_science_lineage_bush
 ^["bush"]{
  #:claim #!settled
  era: "1945"
  statement: "Vannevar Bush imagined the memex, a desk where a reader could tie documents into named associative trails and pass them to others."
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_bush_1945"
  pattern: "ordered trails across a collection"
 }
 #>information_science_lineage_luhmann
 ^["luhmann"]{
  #:claim #!settled
  era: "about 1952 to 1997"
  statement: "Niklas Luhmann kept a card index with numbered cards that linked to each other, and he described it as a partner in his writing."
  reads: %[prov.luhmann.card_count]
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_schmidt_2016"
  pattern: "addressable cards with links between them"
 }
 #>information_science_lineage_foxfire
 ^["foxfire"]{
  #:claim #!settled
  era: "from 1966"
  statement: "Students at Rabun Gap-Nacoochee School in Georgia, with teacher Eliot Wigginton, recorded Appalachian elders' crafts and memories and published them as Foxfire."
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_wigginton_1972"
  pattern: "community knowledge gathered by interview and credited to its holders"
 }
 #>information_science_lineage_whole_earth
 ^["whole_earth"]{
  #:claim #!settled
  era: "from 1968"
  statement: "Stewart Brand's Whole Earth Catalog reviewed tools and books sent in by readers, under the motto access to tools."
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_turner_2006"
  pattern: "reader-submitted reviews organized by use"
 }
 #>information_science_lineage_britannica
 ^["britannica_tiers"]{
  #:claim #!settled
  era: "1974"
  statement: "The fifteenth Britannica split into an outline of knowledge, short ready-reference entries, and long articles, so a reader could choose a depth."
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_propaedia_1974"
  pattern: "one outline above two depths of entry"
 }
 #>information_science_lineage_oais
 ^["oais_and_lockss"]{
  #:claim #!settled
  era: "2001 onward; OAIS revised in 2024"
  statement: "Digital preservation settled on information packages with fixity metadata, and on many independent copies that check one another."
  sources: [ ~"../../registries/sources/provenance-and-reference.spw#src_prov_ccsds_2024", ~"../../registries/sources/provenance-and-reference.spw#src_prov_reich_rosenthal_2001" ]
  pattern: "pin each file by a hash and keep copies that compare"
 }
 #>information_science_lineage_wikidata
 ^["wikidata"]{
  #:claim #!settled
  era: "2012"
  statement: "Wikidata stores facts as statements with qualifiers and references, so each claim can carry its own source and rank."
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_vrandecic_2014"
  pattern: "a statement that carries its source and rank"
 }
}

^["schedule"]{
 steps: << "leishu" ; "Llull" ; "commonplaces" ; "Encyclopedie" ; "Mendeleev" ; "Otlet" ; "Warburg" ; "Ranganathan" ; "Bush" ; "Luhmann" ; "Foxfire" ; "Whole Earth" ; "Britannica" ; "OAIS and LOCKSS" ; "Wikidata" >>
 note: "dates overlap; the order is by first appearance"
}

^["gaps"]{
 islamic_bibliography: "Arabic catalogs and encyclopedias such as Ibn al-Nadim's Fihrist wait for a sourced rung"
 south_asian_and_african: "South Asian and African reference traditions beyond Ranganathan wait for sourced rungs"
}

#>information_science_lineage_survival_q
?["Which rung's pattern would a group chat reinvent first if it tried to keep its own history?"]{
 #:depth #!historical ~#lens(curated collection)
 #:claim #!speculative
 ~#hypothesis: "A chat would reach for pinned messages and threads, Luhmann-like addressed notes, before it reached for facets or fixity."
 !probe{ "look at three long-running group chats and list which keeping tools their members actually use" =id[p_prov_lineage_chat_keeping] =kind[field] }
 $%[prov.luhmann.card_count]
 ~"./reference-works-lineage.spw#information_science_lineage_luhmann" ~#neighbor(nearest)
 breaks: "a card index has one keeper, while a chat has many writers and no editor"
}
