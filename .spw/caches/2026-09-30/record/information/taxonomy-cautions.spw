# Taxonomy Cautions
#
# Why one hard taxonomy ossifies, read through Borges on Wilkins, Foucault, Bowker and Star, and the catalogers who corrected subject headings, with facets and visible gaps as the remedy this cut adopts.

#>information_science_cautions
#:layer #!reference
#:domain #!information_science
#:form #!ledger
#:level #!advanced
#:review #!adversarial_checked
#:valence #!bane

^"emit"{
 ~#title: "Taxonomy Cautions"
 ~#claim: "A single fixed taxonomy encodes the outlook of its makers and hardens as the world changes, so facets and declared gaps keep a classification open to revision."
 ~#proof: "Borges on Wilkins, Foucault, Eco, Bowker and Star, Berman, Olson, and Drabinski on the cautions; Ranganathan, Svenonius, and Mendeleev on the remedies."
 ~#door: "Read the Borges row, then the Bowker and Star row, then see which remedy this cut applies where."
 ~#audience: "catalogers, schema designers, and writers deciding how this cut is filed"
 continuity: "Taxonomy Cautions | hardens as the world changes"
 cold_open: "Any single taxonomy hardens as the world changes, so this cut files by facets and leaves its gaps in view."
}

^"provenance"{
 as_of: "2026-10-02"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-02", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{
   event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #partial
   note: "forward refs to planned theory and panel files another package had not written yet"
  }
  ^["r4"]{
   event: #fact_checked, at: "2026-10-02", agent: "claude-opus-5.5 fact-checker"
   care: #adversarial, outcome: #corrected
   note: "Wilkins and Borges rows confirmed; gate receipt corrected from pass to partial"
  }
  ^["r5"]{
   event: #gated, at: "2026-10-02", agent: "spw-cut-gate", care: #skim, outcome: #partial
   note: "only forward refs to the planned clustering theory and computed kin surfaces remain"
  }
 }
 framing: "an interpretive ledger: each row reports what a named author argued and marks the cut's own reading as interpretive"
}

^["edges"]{
 grounds: [ ~"../../spw/theory/clustering-hybrid.spw#spw_theory_clustering" ]
 contrasts: [ ~"./knowledge-organization.spw#information_science_ko_hospitality" ]
 see: [ ~"../../panels/gap-table.spw#panel_gap_table" ]
}

^["concepts"]{
 primary: [ #ossified_taxonomy, #faceted_classification ]
 transfers: [ #visible_gap ]
 tensions: [ #standards ]
}

^["ranks"]{
 settled: "the row reports what a cited author wrote or what a scheme did"
 interpretive: "the row is this cut reading those works for its own design"
}

^["cautions"]{
 #>information_science_cautions_borges
 ^["borges_on_wilkins"]{
  #:claim #!settled
  statement: "In a 1942 essay Borges recounted Wilkins dividing the universe into forty genera, then set beside it an invented Chinese encyclopedia whose animal classes cannot be reconciled."
  reads: %[prov.wilkins.genus_count]
  sources: [ ~"../../registries/sources/provenance-and-reference.spw#src_prov_borges_1952", ~"../../registries/sources/provenance-and-reference.spw#src_prov_wilkins_1668" ]
  ^["limits"]{
   holds: "the essay as a parable about arbitrary classification"
   fails: "as a report on Chinese reference works; Borges attributes the list to a translator, and no such encyclopedia is known"
  }
 }
 #>information_science_cautions_not_leishu
 ^["invented_not_leishu"]{
  #:claim #!interpretive
  statement: "Reading the invented encyclopedia as typical of China would repeat a stereotype; real leishu used careful topical categories built for officials and scholars."
  sources: [ ~"../../registries/sources/provenance-and-reference.spw#src_prov_wilkinson_2012", ~"../../registries/sources/provenance-and-reference.spw#src_prov_borges_1952" ]
  see: ~"./reference-works-lineage.spw#information_science_lineage_leishu"
 }
 #>information_science_cautions_foucault
 ^["foucault"]{
  #:claim #!settled
  statement: "Foucault opened Les Mots et les choses with the laughter the Borges list provoked, and asked what makes any order of things thinkable in a given period."
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_foucault_1966"
 }
 #>information_science_cautions_eco
 ^["perfect_language"]{
  #:claim #!interpretive
  statement: "Eco reads philosophical languages like Wilkins's as words tied to one classification, so any change in knowledge forces a change in the words themselves."
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_eco_1995"
 }
 #>information_science_cautions_bowker_star
 ^["infrastructure"]{
  #:claim #!settled
  statement: "Bowker and Star show classifications working as infrastructure that makes some work and people visible and others invisible, from disease codes and nursing tasks to apartheid race categories."
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_bowker_star_1999"
  ^["limits"]{
   holds: "classifications that sort people, work, or harm"
   fails: "the argument does not say every classification harms; it says each has consequences worth tracing"
  }
 }
 #>information_science_cautions_headings
 ^["subject_headings"]{
  #:claim #!settled
  statement: "Subject headings carry their maintainers' outlook: Berman listed prejudicial headings about people, Olson traced the limits of naming, and Drabinski argued that correction never finishes."
  sources: [ ~"../../registries/sources/provenance-and-reference.spw#src_prov_berman_1971", ~"../../registries/sources/provenance-and-reference.spw#src_prov_olson_2002", ~"../../registries/sources/provenance-and-reference.spw#src_prov_drabinski_2013" ]
 }
 #>information_science_cautions_other_centers
 ^["other_centers"]{
  #:claim #!settled
  statement: "The Brian Deer scheme orders Indigenous collections by community relationships and place, showing that a universal outline is one design among several."
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_cherry_mukunda_2015"
 }
}

^["remedies"]{
 #>information_science_cautions_facets
 ^["facets"]{
  #:claim #!settled
  statement: "A faceted scheme names a new compound subject from known parts, so the scheme can admit it before anyone revises the hierarchy."
  sources: [ ~"../../registries/sources/provenance-and-reference.spw#src_prov_ranganathan_1933", ~"../../registries/sources/provenance-and-reference.spw#src_prov_svenonius_2000" ]
  counter: ~"../../registries/sources/provenance-and-reference.spw#src_prov_chan_salaba_2016"
  ~#(long facet strings shelve badly, and citation order is itself a choice)
 }
 #>information_science_cautions_gaps
 ^["visible_gaps"]{
  #:claim #!settled
  statement: "Mendeleev left cells empty and named what should fill them, so an absence became a testable prediction instead of a silence."
  reads: %[prov.mendeleev.confirmed_prediction_count]
  source: ~"../../registries/sources/provenance-and-reference.spw#src_prov_scerri_2007"
 }
 #>information_science_cautions_in_cut
 ^["applied_here"]{
  #:claim #!interpretive
  statement: "This cut keeps its directory tree shallow, files level, form, era, and review as facets, lists gaps in every class index, and treats computed clusters as prompts."
  ^["where"]{
   facets: ~"../../vocabulary.spw#cut_vocabulary"
   gaps: ~"../../panels/gap-table.spw#panel_gap_table"
   clusters: ~"../../panels/computed-kin.spw#panel_computed_kin"
   second_view: ~"../../spw/theory/clustering-hybrid.spw#spw_theory_clustering"
  }
 }
}

^["try"]{
 #>information_science_cautions_try_drawer
 ^["sort_a_drawer_twice"]{
  materials: [ "fifteen small objects from a desk drawer", "a table", "sticky notes" ]
  steps: << "sort the objects into one tree of piles and subpiles" ; "note every object that could have gone in two places" ; "unsort, then tag each object with a material and a use on two notes" ; "compare which objects were hard to place each way" >>
  time: .{ n: 20, unit: "minutes" }
  safety: "leave blades and loose batteries out of the pile"
  shows: ~"./taxonomy-cautions.spw#information_science_cautions_facets"
 }
}

#>information_science_cautions_vocab_q
?["Will the closed vocabulary of this cut harden the way Wilkins's tables did?"]{
 #:depth #!historical ~#lens(formal structure)
 #:claim #!speculative
 ~#hypothesis: "Values added after the first wave should be used less than early ones, because writers copy the tags they already see in neighboring files."
 !probe{ "date each vocabulary value by the commit that added it and count its uses per wave" =id[p_prov_cautions_vocab_aging] =kind[census] }
 $%[prov.wilkins.genus_count, prov.review.r1_lens_value_count]
 ~"./taxonomy-cautions.spw#information_science_cautions_borges" ~#neighbor(nearest)
}

#>information_science_cautions_channel_q
?["Does a classification entrench the way a stream cuts its own channel deeper?"]{
 #:depth #!social ~#lens(ecological zone)
 #:claim #!speculative
 ~#hypothesis: "Each item filed under a heading makes the heading more costly to change, so heavily used headings should change least often."
 !probe{ "compare how often subject headings were revised against how many records each heading carries" =id[p_prov_cautions_entrenchment] =kind[lit] }
 ~"./taxonomy-cautions.spw#information_science_cautions_headings" ~#neighbor(nearest)
 breaks: "a stream has no maintainers who can decide to recut it, while catalogers can and do revise headings"
}
