# Retrieval Systems
#
# How search learned to rank: test collections, Boolean queries, term weighting, vector space, BM25, link analysis, and dense retrieval, as a ladder of dated rungs with a ledger of corrected raw claims.

#>information_science_retrieval
#:layer #!reference
#:domain #!information_science
#:form #!timeline
#:level #!advanced
#:review #!adversarial_checked
#:valence #!bonk
#:era #!modern

^"emit"{
 ~#title: "Retrieval Systems"
 ~#claim: "Ranking moved from exact Boolean matching to weighted terms, probabilistic BM25, link analysis, and learned dense vectors, and test collections judged each step."
 ~#proof: "Cleverdon, Sparck Jones, Salton, Robertson, Brin and Page, Karpukhin, Thakur, and Voorhees, each cited at its rung."
 ~#door: "Climb the ladder in order, then read the ledger for the TREC-COVID correction."
 ~#audience: "library and computing students, and builders of search over notes and chats"
 continuity: "Retrieval Systems | test collections judged each step"
 cold_open: "Search learned to rank in steps, and shared test collections judged each step before the next one won."
}

