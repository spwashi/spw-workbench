^["edges"]{
 needs: [ ~"../../../physical/chemistry/chemistry-core.spw#chemistry_core" ]
 feeds: [ ~"./photographic-processing.spw#media_carriers_processing" ]
 see: [ ~"../../../physical/physical-glossary.spw#physical_term_latent_image" ]
}

^["concepts"]{
 primary: [ #silver_halide, #latent_image, #coupler ]
 transfers: [ #crystal_structure, #defect ]
 tensions: [ #permanence ]
}

^["crystal"]{
 #>media_carriers_emulsion_lattice
 ^["silver_halide"]{
  #:claim #!settled
  statement: "Camera emulsions use silver bromide crystals with a small fraction of iodide, in the rock-salt structure, suspended in gelatin; interstitial silver ions move through the lattice."
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_james_1977"
 }
 #>media_carriers_emulsion_latent_image
 ^["latent_image"]{
  #:claim #!settled
  statement: "Light frees electrons that collect at sensitivity specks, mobile silver ions join them, and a cluster of a few silver atoms, about four, makes the grain developable."
  sources: [ ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_gurney_mott_1938", ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_james_1977" ]
  ~#say(a handful of atoms decides the whole grain)
  ^["limits"]{
   holds: "the Gurney-Mott picture of electron trapping then ionic neutralization"
   fails: "later work refined nucleation, recombination, and low-intensity reciprocity failure beyond the original model"
  }
 }
}

^["sensitization"]{
 #>media_carriers_emulsion_chemical_sens
 ^["chemical"]{
  #:claim #!settled
  statement: "Sulfur and gold compounds on the grain surface form sensitivity specks that trap electrons, raising speed without changing the color the grain responds to."
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_james_1977"
 }
 #>media_carriers_emulsion_dye_sens
 ^["spectral"]{
  #:claim #!settled
  statement: "Bare silver halide responds to blue and ultraviolet; Hermann Vogel found in 1873 that adsorbed dyes extend it, and cyanine dyes now make emulsions green- and red-sensitive."
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_james_1977"
 }
 #>media_carriers_emulsion_tabular
 ^["tabular_grains"]{
  #:claim #!settled
  statement: "Flat tabular grains lie parallel to the film, offering more area for sensitizing dye per unit of silver and scattering less light; they entered production in the 1980s."
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_wiki_t_grain"
 }
}

^["color"]{
 #>media_carriers_emulsion_tripack
 ^["tripack"]{
  #:claim #!settled
  statement: "A color film stacks blue-, green-, and red-sensitive layers; a yellow filter layer of colloidal silver keeps blue light out of the lower layers and is removed in processing."
  sources: [ ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_hunt_2004", ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_james_1977" ]
  layers: << "overcoat" ; "blue-sensitive, yellow coupler" ; "yellow filter" ; "green-sensitive, magenta coupler" ; "red-sensitive, cyan coupler" ; "base" ; "antihalation backing" >>
 }
 #>media_carriers_emulsion_couplers
 ^["couplers"]{
  #:claim #!settled
  statement: "Oxidized color developer reacts with couplers to form cyan, magenta, and yellow dyes where silver developed; Agfa built couplers into the layers, while Kodachrome added them during processing."
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_hunt_2004"
  era: 1935..1936
 }
 #>media_carriers_emulsion_orange_mask
 ^["orange_mask"]{
  #:claim #!settled
  statement: "Color negative films use colored masking couplers: those left unreacted stay yellowish or pinkish, giving an orange base that cancels the unwanted blue and green absorption of the magenta and cyan dyes."
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_hunt_2004"
  ~#say(the orange is a correction, not a stain)
  ^["limits"]{
   holds: "color negative camera and intermediate stocks"
   fails: "reversal films and print films carry no mask; scanners and printers must remove it with filtration or inversion"
  }
 }
 #>media_carriers_emulsion_remjet
 ^["remjet"]{
  #:claim #!settled
  statement: "Motion-picture color negative carries a carbon-black remjet backing that stops halation and static; it is softened and removed before development in ECN-2."
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_kodak_h2407"
  process: ~"./photographic-processing.spw#media_carriers_processing_ecn2"
 }
}

^["grain"]{
 #>media_carriers_emulsion_grain_random
 ^["random_placement"]{
  #:claim #!settled
  statement: "Grains sit at random positions and sizes in each frame, so the grain pattern changes from frame to frame instead of staying fixed like a sensor grid."
  source: ~"../../../registries/sources/physical-sciences-and-image.spw#src_phys_james_1977"
 }
 #>media_carriers_emulsion_grain_reading
 ^["organic_reading"]{
  #:claim #!interpretive
  statement: "Many filmmakers describe moving film grain as alive or organic and its highlight shoulder as forgiving; that is an aesthetic reading of a real physical difference."
  ~#(kept from the raw taste file as a reading, not a finding)
 }
}

#>media_carriers_emulsion_dither_q
?["Does grain that changes every frame let viewers see finer detail than any single frame holds?"]{
 #:depth #!experiential ~#lens(material grain)
 #:claim #!speculative
 ~#hypothesis: "Frame-to-frame grain should act like temporal dither, so viewers should judge fine texture sharper with moving grain than with a frozen grain layer of equal strength."
 !probe{ "show viewers matched clips with moving grain, frozen grain, and no grain, and ask which shows finer texture" =id[p_phys_emulsion_dither] =kind[field] }
 $%[phys.film.sound_speed_fps]
 breaks: "the eye has its own noise and adaptation; display dither does not map one to one onto vision"
 ~"./emulsion-chemistry.spw#media_carriers_emulsion_grain_random" ~#neighbor(nearest)
}
