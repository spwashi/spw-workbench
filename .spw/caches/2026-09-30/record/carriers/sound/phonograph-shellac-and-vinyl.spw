# Phonograph, Shellac, and Vinyl
#
# Sound as a groove: the phonautograph trace, tinfoil and wax cylinders, the stamped gramophone disc, shellac 78s, electrical recording, and vinyl microgroove.

#>media_carriers_disc_sound
#:layer #!reference
#:domain #!media_carriers
#:form #!timeline
#:level #!intro
#:review #!adversarial_checked
#:valence #!bonk
#:era #!industrial

^"emit"{
 ~#title: "Phonograph, Shellac, and Vinyl"
 ~#claim: "Recorded sound moved from cylinders to the stamped disc, then from acoustic shellac 78s to electrically cut vinyl LPs and singles."
 ~#proof: "Millard for the industry; Feaster for the phonautograph; Maxfield and Harrison for electrical recording; Copeland for speeds."
 ~#door: "Read the tape ladder next, or the manufacturing matrix for how one master becomes many discs."
 ~#audience: "readers who own or inherit records and want to know what they are"
 continuity: "Phonograph, Shellac, and Vinyl | stamped disc"
 cold_open: "Early cylinders were hard to copy in bulk, but a stamped disc could be pressed by the thousand."
}

