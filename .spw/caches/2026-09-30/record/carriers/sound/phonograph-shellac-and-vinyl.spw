^["ladder"]{
 ^["trace_before_playback"]{
  #>media_carriers_phonautograph
  ^["phonautograph"]{
   #:era #!industrial
   #:claim #!settled
   statement: "Edouard-Leon Scott de Martinville patented the phonautograph in 1857; it traced sound waves on soot-blackened paper but had no way to play them back."
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_feaster_2012"
   note: "researchers including Patrick Feaster and the First Sounds group educed audio from these traces in 2008"
  }
 }
 ^["cylinders"]{
  #>media_carriers_edison
  ^["tinfoil"]{
   #:era #!industrial
   #:claim #!settled
   statement: "Edison built a phonograph in 1877 that embossed sound into tinfoil wrapped on a cylinder and then played the indentations back through a second diaphragm and needle."
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_millard_2005"
   ~#say(the first machine that could record and replay a voice)
  }
  #>media_carriers_wax_cylinder
  ^["wax"]{
   #:claim #!settled
   statement: "Chichester Bell and Charles Sumner Tainter patented the graphophone in 1886, engraving sound into wax; Edison answered with solid wax cylinders by 1888."
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_millard_2005"
  }
 }
 ^["discs"]{
  #>media_carriers_berliner
  ^["gramophone"]{
   #:claim #!settled
   statement: "Emile Berliner patented the gramophone in 1887; its flat disc carried a lateral groove and, unlike early cylinders, could be stamped from a master in quantity."
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_millard_2005"
   detail: ~"../carrier-manufacturing.spw#media_carriers_mfg_disc"
  }
  #>media_carriers_78_speed
  ^["seventy_eight"]{
   #:claim #!settled
   statement: "Early disc speeds varied by label; the nominal 78 settled at slightly different speeds on 60 Hz and 50 Hz mains because synchronous motors and stroboscopes were geared to them."
   reads: %[media.disc.speed_78_rpm_60hz, media.disc.speed_78_rpm_50hz]
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_copeland_2008"
  }
  #>media_carriers_gauhar_jaan
  ^["recording_expeditions"]{
   #:claim #!settled
   statement: "Gramophone Company engineers made their first recording tour of India in 1902; in Calcutta that year the singer Gauhar Jaan was among the first Indian performers they recorded."
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_kinnear_1994"
  }
 }
 ^["electrical"]{
  #>media_carriers_electrical
  ^["microphone_and_amplifier"]{
   #:era #!modern
   #:claim #!settled
   statement: "Western Electric engineers Maxfield and Harrison replaced the acoustic horn with a microphone, amplifier, and electrically driven cutter; Victor and Columbia recorded electrically from spring 1925."
   sources: [ ~"../../../registries/sources/record-and-carriers.spw#src_media_maxfield_harrison_1926", ~"../../../registries/sources/record-and-carriers.spw#src_media_enc_phonograph_record" ]
  }
 }
 ^["microgroove"]{
  #>media_carriers_lp
  ^["long_playing"]{
   #:era #!modern
   #:claim #!settled
   statement: "Columbia unveiled the twelve-inch vinyl long-playing record at 33 and a third rpm on 21 June 1948, holding over twenty minutes a side."
   reads: %[media.disc.lp_speed_rpm]
   sources: [ ~"../../../registries/sources/record-and-carriers.spw#src_media_millard_2005", ~"../../../registries/sources/record-and-carriers.spw#src_media_enc_lp" ]
  }
  #>media_carriers_45
  ^["single"]{
   #:claim #!settled
   statement: "RCA Victor answered in early 1949 with a seven-inch vinyl single at 45 rpm with a large center hole, built for one song a side and fast changers."
   reads: %[media.disc.single_speed_rpm]
   sources: [ ~"../../../registries/sources/record-and-carriers.spw#src_media_millard_2005", ~"../../../registries/sources/record-and-carriers.spw#src_media_enc_phonograph_record" ]
  }
  #>media_carriers_stereo_disc
  ^["stereo"]{
   #:claim #!settled
   statement: "Blumlein filed a stereo patent covering two-channel groove cutting in December 1931, granted in 1933; commercial stereo LPs appeared in 1957 and 1958, cutting each channel on one groove wall."
   sources: [ ~"../../../registries/sources/record-and-carriers.spw#src_media_blumlein_1931", ~"../../../registries/sources/record-and-carriers.spw#src_media_enc_blumlein", ~"../../../registries/sources/record-and-carriers.spw#src_media_enc_phonograph_record" ]
  }
  #>media_carriers_78_end
  ^["end_of_shellac"]{
   #:claim #!settled
   statement: "In the United States, mass production of 78s ended in the summer of 1958; pressing continued longer in countries such as India and the Philippines."
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_enc_phonograph_record"
   playback: ~"../playback-dependency-dag.spw#media_carriers_dag_disc78"
  }
 }
}

^["pressing_dag"]{
 #>media_carriers_disc_step_master
 ^["master"]{
  what: "cut the groove into a master: wax in the acoustic and early electrical eras, lacquer later"
 }
 #>media_carriers_disc_step_father
 ^["father"]{
  what: "metallize the master and electroplate a negative nickel father"
  needs: [ =~[hard] ~"./phonograph-shellac-and-vinyl.spw#media_carriers_disc_step_master" ]
 }
 #>media_carriers_disc_step_mother
 ^["mother"]{
  what: "grow positive mothers from the father; a mother can be played to check the cut"
  needs: [ =~[hard] ~"./phonograph-shellac-and-vinyl.spw#media_carriers_disc_step_father" ]
 }
 #>media_carriers_disc_step_stamper
 ^["stamper"]{
  what: "grow negative stampers from a mother, one pair per press"
  needs: [ =~[soft] ~"./phonograph-shellac-and-vinyl.spw#media_carriers_disc_step_mother" ]
  soft_note: "a short run can press from the father itself and skip the mother"
 }
 #>media_carriers_disc_step_press
 ^["press"]{
  what: "squeeze a heated biscuit of shellac compound or vinyl between two stampers, then trim"
  needs: [ =~[hard] ~"./phonograph-shellac-and-vinyl.spw#media_carriers_disc_step_stamper" ]
  material: ~"../carrier-manufacturing.spw#media_carriers_mfg_vinyl"
 }
 source: ~"../../../registries/sources/record-and-carriers.spw#src_media_copeland_2008"
}

^["try"]{
 #>media_carriers_try_paper_cone
 ^["paper_cone_player"]{
  materials: [ "a sheet of stiff paper rolled into a cone", "a sewing needle", "tape", "a record you do not mind wearing", "a turntable, or a pencil through the hole to spin it by hand" ]
  steps: << "tape the needle through the narrow tip of the cone" ; "spin the record steadily" ; "rest the needle lightly in the groove, holding the cone by its wide end" ; "listen for music from the cone with no power at all" >>
  time: .{ n: 20, unit: "minutes" }
  safety: "the needle is sharp and it scratches the groove; use a record you do not value and keep fingers clear of the point"
  shows: ~"./phonograph-shellac-and-vinyl.spw#media_carriers_berliner"
 }
}

#>media_carriers_disc_late_78_q
?["Why did shellac 78s outlive the LP in some markets?"]{
 #:depth #!historical ~#lens(market flow)
 #:claim #!speculative
 ~#hypothesis: "Where record players were costly and replaced rarely, households kept 78 machines longer, so labels kept pressing 78s after microgroove arrived."
 !probe{ "set last-78 pressing years beside record-player import or production series for India, the Philippines, and the United States" =id[p_media_disc_late_78] =kind[lit] }
 $%[media.disc.speed_78_rpm_50hz, media.disc.lp_speed_rpm]
 ~"./phonograph-shellac-and-vinyl.spw#media_carriers_78_end" ~#neighbor(nearest)
}
