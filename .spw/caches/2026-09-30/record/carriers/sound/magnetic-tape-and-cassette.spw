^["ladder"]{
 ^["wire_and_paper"]{
  #>media_carriers_telegraphone
  ^["telegraphone"]{
   #:era #!industrial
   #:claim #!settled
   statement: "Valdemar Poulsen patented the telegraphone in Denmark in 1898, recording sound as varying magnetization along a steel wire."
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_daniel_mee_clark_1999"
  }
  #>media_carriers_pfleumer
  ^["coated_tape"]{
   #:era #!modern
   #:claim #!settled
   statement: "Fritz Pfleumer patented a paper strip coated with magnetic powder in 1928, the first coated tape; AEG took up the invention in the early 1930s."
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_daniel_mee_clark_1999"
  }
 }
 ^["studio_tape"]{
  #>media_carriers_magnetophon
  ^["magnetophon"]{
   #:claim #!settled
   statement: "AEG showed the Magnetophon recorder at the 1935 Berlin radio exhibition, running BASF tape with magnetic particles coated on a cellulose acetate base."
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_daniel_mee_clark_1999"
  }
  #>media_carriers_ac_bias
  ^["ac_bias"]{
   #:claim #!settled
   statement: "In 1940 Walter Weber and Hans Joachim von Braunmuhl at German state radio found that a high-frequency bias current sharply cut tape noise and distortion."
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_daniel_mee_clark_1999"
   note: "an earlier American patent by Carlson and Carpenter had described AC bias for recording telegraph signals on wire"
  }
  #>media_carriers_ampex
  ^["ampex"]{
   #:claim #!settled
   statement: "After the war John Mullin brought Magnetophons to the United States; Ampex delivered its Model 200 recorders in 1948, and radio and record studios moved to tape masters."
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_daniel_mee_clark_1999"
  }
  #>media_carriers_tape_speed
  ^["speed_and_quality"]{
   #:claim #!settled
   statement: "Studio open reel at fifteen inches per second spreads each second of sound over eight times more tape than a cassette, which is one reason studio tape sounds cleaner."
   reads: %[media.tape.studio_speed_cm_s, media.tape.cassette_speed_cm_s]
   sources: [ ~"../../../registries/sources/record-and-carriers.spw#src_media_daniel_mee_clark_1999", ~"../../../registries/sources/record-and-carriers.spw#src_media_enc_cassette" ]
  }
 }
 ^["cassette"]{
  #>media_carriers_cassette
  ^["compact_cassette"]{
   #:claim #!settled
   statement: "Philips introduced the compact cassette at the Berlin Radio Show on 28 August 1963, developed by a team in Hasselt, Belgium, led by Lou Ottens."
   reads: %[media.tape.cassette_width_mm]
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_enc_cassette"
  }
  #>media_carriers_cassette_license
  ^["free_license"]{
   #:claim #!settled
   statement: "Under pressure from Sony, Philips licensed the cassette format to other makers free of charge from 1966, which helped one shell become the world standard."
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_enc_cassette"
  }
  #>media_carriers_cassette_types
  ^["tape_types"]{
   #:claim #!settled
   statement: "Chromium dioxide cassettes arrived in 1970; shells mark tape type with notches, Type I having only write-protect notches and Type II and Type IV adding extra pairs."
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_enc_cassette"
  }
  #>media_carriers_walkman
  ^["walkman"]{
   #:era #!contemporary
   #:claim #!settled
   statement: "Sony put the TPS-L2 Walkman on sale on 1 July 1979, a pocket cassette player with headphones that made private listening in public ordinary."
   sources: [ ~"../../../registries/sources/record-and-carriers.spw#src_media_du_gay_1997", ~"../../../registries/sources/record-and-carriers.spw#src_media_enc_cassette" ]
  }
 }
 ^["cassette_cultures"]{
  #>media_carriers_cassette_india
  ^["north_india"]{
   #:claim #!settled
   statement: "Manuel shows that cheap cassettes in 1980s North India broke the dominance of one record company and film song, letting small labels sell regional, devotional, and folk music."
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_manuel_1993"
   ^["limits"]{
    holds: "North Indian markets in the 1980s, the period Manuel studied"
    fails: "the same cheapness also fed piracy, which Manuel documents alongside the new diversity"
   }
  }
  #>media_carriers_cassette_iran
  ^["iran"]{
   #:claim #!settled
   statement: "Before the 1979 revolution, cassette recordings of sermons by the exiled Ayatollah Khomeini were copied and passed hand to hand across Iran."
   source: ~"../../../registries/sources/record-and-carriers.spw#src_media_sreberny_mohammadi_1994"
   ~#say(small media can move faster than big ones)
   ^["limits"]{
    holds: "cassettes as one channel among mosques, leaflets, and networks of clergy and students"
    fails: "how much the tapes caused, rather than carried, the revolution is a matter of interpretation"
   }
  }
 }
 ^["digital_tape"]{
  #>media_carriers_dat
  ^["dat"]{
   #:era #!contemporary
   #:claim #!settled
   statement: "Sony launched digital audio tape in 1987; the US Audio Home Recording Act of 1992 required serial copy management in digital audio recorders and levied royalties on those recorders and their blank digital media."
   sources: [ ~"../../../registries/sources/record-and-carriers.spw#src_media_daniel_mee_clark_1999", ~"../../../registries/sources/record-and-carriers.spw#src_media_ahra_1992" ]
   ^["limits"]{
    holds: "digital audio recording devices and digital audio recording media as the statute defines them"
    fails: "analog cassettes and media marketed mainly for computer data fall outside the royalty"
   }
  }
 }
}

^["try"]{
 #>media_carriers_try_cassette_shell
 ^["read_a_shell"]{
  materials: [ "two or three cassettes", "a flashlight" ]
  steps: << "find the write-protect tabs on the back edge and see whether any are broken out" ; "look beside them for a second pair of notches" ; "look along the middle of the back edge for a third set" ; "match each shell to Type I, Type II, or Type IV" ; "check the label for chrome, ferric, or metal to confirm" >>
  time: .{ n: 10, unit: "minutes" }
  safety: "no hazard worth naming; do not pull loose tape from the shell"
  shows: ~"./magnetic-tape-and-cassette.spw#media_carriers_cassette_types"
 }
}

#>media_carriers_tape_publish_q
?["Did cheap duplication, more than cheap playback, decide who could publish music?"]{
 #:depth #!social ~#lens(social fabric)
 #:claim #!speculative
 ~#hypothesis: "Where cassette duplicators were cheap, the number of active small labels rose faster than where only players spread, because copying set who could publish."
 !probe{ "count active cassette labels by region and year from trade directories and compare with duplicator and player import figures" =id[p_media_tape_publish] =kind[lit] }
 $%[media.tape.cassette_speed_cm_s]
 ~"./magnetic-tape-and-cassette.spw#media_carriers_cassette_india" ~#neighbor(nearest)
}
