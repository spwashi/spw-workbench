 }
}

^["edges"]{
 needs: [ ~"./inks-and-inscription.spw#inscription_inks_oil_varnish", ~"./paper-and-pulp-manufacture.spw#inscription_paper" ]
 feeds: [ ~"../carriers/form-factor-ladder.spw#media_carriers_ladder" ]
 see: [ ~"../../making/authorship/platforms-and-business-models.spw#authorship_platforms" ]
}

^["concepts"]{
 primary: [ #movable_type, #print_culture ]
 transfers: [ #stamper, #mass_copy ]
 tensions: [ #fixity ]
}

^["ladder"]{
 ^["east_asia"]{
  #>inscription_print_dharani
  ^["early_block_prints"]{
   #:era #!medieval
   #:claim #!settled
   statement: "The oldest surviving block prints are Buddhist charms: a dharani sutra sealed in a Korean pagoda by 751 and the Japanese Hyakumanto Darani of 764 to 770."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_tsien_1985"
   note: "where the Korean dharani was printed is debated"
  }
  #>inscription_print_diamond_sutra
  ^["diamond_sutra"]{
   #:claim #!settled
   statement: "The Dunhuang Diamond Sutra, a woodblock scroll made by Wang Jie for his parents and dated to 868, is the earliest printed book bearing a date."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_wood_barnard_2010"
   note: "acquired by Aurel Stein in 1907; now in the British Library"
  }
  #>inscription_print_bi_sheng
  ^["bi_sheng"]{
   #:claim #!settled
   statement: "Shen Kuo records that the artisan Bi Sheng made movable type of fired clay in the 1040s, set in an iron frame with a wax and resin bed."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_tsien_1985"
  }
  #>inscription_print_wang_zhen
  ^["wang_zhen"]{
   #:claim #!settled
   statement: "Wang Zhen cut tens of thousands of wooden types around 1298 and sorted them on revolving tables, describing the method in a 1313 treatise."
   sources: [ ~"../../registries/sources/record-and-carriers.spw#src_media_tsien_1985", ~"../../registries/sources/record-and-carriers.spw#src_media_enc_movable_type" ]
  }
  #>inscription_print_jikji
  ^["jikji"]{
   #:claim #!settled
   statement: "Jikji, printed with metal movable type at Heungdeok temple in Cheongju in 1377, is the oldest surviving book printed from metal type."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_unesco_jikji_2001"
   note: "the surviving second volume is in the Bibliotheque nationale de France; Goryeo texts record metal-type printing as early as 1234, with no copy surviving"
  }
 }
 ^["mainz"]{
  #>inscription_print_gutenberg
  ^["gutenberg_system"]{
   #:era #!early_modern
   #:claim #!settled
   statement: "In Mainz, Gutenberg combined an adjustable hand mould for casting type, a lead-based alloy, oil-based ink, and a screw press into a working system."
   sources: [ ~"../../registries/sources/record-and-carriers.spw#src_media_kapr_1996", ~"../../registries/sources/record-and-carriers.spw#src_media_gaskell_1972" ]
   reads: %[media.print.b42_sort_count]
  }
  #>inscription_print_b42_dating
  ^["b42_dating"]{
   #:claim #!settled
   statement: "The 42-line Bible carries no printed date; a March 1455 letter by Enea Silvio Piccolomini reports its quires, and a rubricator dated a Paris copy in August 1456."
   sources: [ ~"../../registries/sources/record-and-carriers.spw#src_media_kapr_1996", ~"../../registries/sources/record-and-carriers.spw#src_media_enc_gutenberg_bible" ]
  }
  #>inscription_print_type_debate
  ^["type_casting_debate"]{
   #:claim #!contested
   statement: "Aguera y Arcas and Needham reported variation among early Mainz sorts suggesting temporary matrices built from smaller punches, challenging the single punch, matrix, and mould account."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_aguera_y_arcas_2003"
   counter: ~"../../registries/sources/record-and-carriers.spw#src_media_kapr_1996"
  }
  #>inscription_print_agent_of_change
  ^["agent_of_change"]{
   #:claim #!contested
   statement: "Eisenstein argued that print fixed texts and spurred the Reformation and the new science; Johns argues that fixity was a social achievement of printers and readers."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_eisenstein_1979"
   counter: ~"../../registries/sources/record-and-carriers.spw#src_media_johns_1998"
  }
 }
 ^["industrial"]{
  #>inscription_print_koenig
  ^["steam_cylinder"]{
   #:era #!industrial
   #:claim #!settled
   statement: "The Times of London was first printed on the steam-driven cylinder press of Friedrich Koenig and Andreas Bauer on 29 November 1814."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_moran_1973"
  }
  #>inscription_print_linotype
  ^["linotype"]{
   #:claim #!settled
   statement: "Ottmar Mergenthaler's Linotype, which cast a whole line of type from a keyboard, entered service at the New York Tribune in July 1886."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_kahan_2000"
  }
  #>inscription_print_lithography
  ^["lithography"]{
   #:claim #!settled
   statement: "Alois Senefelder developed lithography in Munich in the 1790s, printing from a flat stone whose image areas accept greasy ink while wet areas repel it."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_twyman_1970"
  }
  #>inscription_print_offset
  ^["offset"]{
   #:era #!modern
   #:claim #!settled
   statement: "Offset printing transfers the inked image to a rubber blanket before paper; Ira Rubel in the United States and Kaspar Hermann in Europe built paper offset presses around 1904."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_enc_offset"
  }
 }
 ^["digital"]{
  #>inscription_print_on_demand
  ^["print_on_demand"]{
   #:era #!current
   #:claim #!settled
   statement: "Print on demand became economical only with digital printing, which can print and bind a single copy after an order instead of a stocked run."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_enc_print_on_demand"
   as_of: "2026-10-01"
  }
 }
}

^["try"]{
 #>inscription_try_stamp_type
 ^["eraser_type"]{
  materials: [ "three plastic erasers", "a craft knife", "a stamp pad", "scrap paper", "a pencil" ]
  steps: << "draw the letters of a short word backward on the erasers" ; "cut away everything that is not a letter" ; "ink and stamp the word" ; "rearrange the letters to print a second word with no new carving" >>
  time: .{ n: 45, unit: "minutes" }
  safety: "the craft knife is sharp; cut away from your hand, and an adult should do the cutting for young children"
  shows: ~"./print-and-press.spw#inscription_print_gutenberg"
 }
}

#>inscription_print_script_q
?["Did the number of distinct characters decide where movable type displaced woodblocks?"]{
 #:depth #!historical ~#lens(craft practice)
 #:claim #!speculative
 ~#hypothesis: "Scripts needing a few hundred sorts favor movable type, while logographic scripts keep woodblocks competitive, so movable type should displace blocks faster where sort counts are small."
 !probe{ "compare share of type-printed versus block-printed titles by script and century in published imprint surveys" =id[p_media_print_script] =kind[lit] }
 $%[media.print.b42_sort_count]
 breaks: "Korean printers used metal type for Chinese characters for centuries, so script size cannot be the whole story"
 ~"./print-and-press.spw#inscription_print_jikji" ~#neighbor(nearest)
}
