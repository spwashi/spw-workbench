# Tablets, Scrolls, and Codices
#
# How clay, papyrus, bamboo, wax, parchment, palm leaf, bark paper, and knotted cord carried records, and how the bound codex overtook the roll.

#>inscription_surfaces
#:layer #!reference
#:domain #!inscription
#:form #!timeline
#:level #!intro
#:review #!sourced
#:valence #!bonk
#:era #!ancient

^"emit"{
 ~#title: "Tablets, Scrolls, and Codices"
 ~#claim: "Each early writing surface traded durability, portability, and cost; in the Mediterranean the bound codex reached parity with the roll around 300 CE."
 ~#proof: "Archaic Bookkeeping for the Uruk tablets; Roberts and Skeat for the codex; Tsien for bamboo slips; Urton for khipu."
 ~#door: "Follow the codex into inks and paper next."
 ~#audience: "curious readers with no background in archaeology"
 continuity: "Tablets, Scrolls, and Codices | bound codex"
 cold_open: "Clay kept accounts, papyrus rolled up, and the bound codex finally let a reader flip straight to the passage they wanted."
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 revised_by: "claude-opus-5.5 writer"
 lineage: #[ "new" ]
 method: #authored
 ^["receipts"]{
  ^["r1"]{ event: #generated, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #read, outcome: #raw }
  ^["r2"]{ event: #revised, at: "2026-10-01", agent: "claude-opus-5.5 writer", care: #audit, outcome: #pass }
  ^["r3"]{ event: #gated, at: "2026-10-01", agent: "spw-cut-gate", care: #skim, outcome: #pass }
 }
}

^["edges"]{
 feeds: [ ~"./inks-and-inscription.spw#inscription_inks", ~"./print-and-press.spw#inscription_print" ]
 see: [ ~"../carriers/form-factor-ladder.spw#media_carriers_ladder" ]
 analog: [ ~"../../physical/materials/fibers-and-textiles.spw#materials_fibers" ]
}

^["concepts"]{
 primary: [ #writing_surface, #codex ]
 transfers: [ #random_access, #bookkeeping ]
 tensions: [ #token_theory ]
}

^["ladder"]{
 ^["clay"]{
  #>inscription_rung_tablets
  ^["uruk_tablets"]{
   #:era #!ancient
   #:claim #!settled
   statement: "The earliest known writing, proto-cuneiform, was pressed into clay tablets at Uruk in the late fourth millennium BCE, and most of it records administrative accounts."
   when: "late fourth millennium BCE"
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_nissen_damerow_englund_1993"
   ~#say(the first writing we know of is bookkeeping in clay)
  }
  #>inscription_token_theory
  ^["token_theory"]{
   #:claim #!contested
   statement: "Schmandt-Besserat argued that clay counting tokens led directly to the earliest tablets; critics question her dating and reading of many token finds."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_schmandt_besserat_1992"
   counter: ~"../../registries/sources/record-and-carriers.spw#src_media_zimansky_1993"
  }
 }
 ^["papyrus"]{
  #>inscription_rung_papyrus
  ^["papyrus_rolls"]{
   #:era #!ancient
   #:claim #!settled
   statement: "Egyptians made papyrus by laying strips of reed pith crosswise and pressing them; a blank roll survives from a First Dynasty tomb at Saqqara."
   when: "about 3000 BCE"
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_parkinson_quirke_1995"
  }
  #>inscription_rung_merer
  ^["merer_diary"]{
   #:claim #!settled
   statement: "The oldest inscribed papyri yet found, from Wadi al-Jarf, include the logbook of an official named Merer from the reign of Khufu."
   when: "about 2560 BCE"
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_tallet_2017"
  }
 }
 ^["slips_and_boards"]{
  #>inscription_rung_slips
  ^["bamboo_slips"]{
   #:era #!classical
   #:claim #!settled
   statement: "In China, bamboo and wooden slips written in ink and bound with cord into rolls were the main book form until paper displaced them in the early centuries CE."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_tsien_1962"
  }
  #>inscription_rung_wax
  ^["wax_tablets"]{
   #:claim #!settled
   statement: "Greek and Roman writers used wooden tablets filled with wax for drafts, accounts, and school exercises, smoothing the wax to reuse the surface."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_suarez_woudhuysen_2013"
  }
 }
 ^["skins"]{
  #>inscription_rung_parchment
  ^["parchment"]{
   #:era #!classical
   #:claim #!settled
   statement: "Parchment is animal skin limed, scraped, and dried under tension; it takes ink on both sides and folds without cracking, which suits the codex."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_reed_1972"
  }
  #>inscription_pergamon_legend
  ^["pergamon_legend"]{
   #:claim #!refuted
   statement: "Parchment was invented at Pergamon when Egypt stopped exporting papyrus."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_reed_1972"
   counter: ~"../../registries/sources/record-and-carriers.spw#src_media_pliny_nh"
   note: "Pliny, citing Varro, tells the embargo story; written skins are older, so Pergamon at most refined or popularized the material"
  }
 }
 ^["codex"]{
  #>inscription_rung_codex
  ^["martial_codices"]{
   #:era #!classical
   #:claim #!settled
   statement: "Martial, writing in Rome in the 80s CE, advertises his poems and the classics in small parchment codices for travellers."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_roberts_skeat_1983"
  }
  #>inscription_codex_parity
  ^["codex_parity"]{
   #:claim #!settled
   statement: "Among surviving Greek literary texts from Egypt, the codex reaches rough parity with the roll around 300 CE and dominates afterward."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_roberts_skeat_1983"
   ^["limits"]{
    holds: "Greek literary papyri recovered from Egypt"
    fails: "survival is skewed by the dry Egyptian climate, so other regions and genres may have shifted at other rates"
   }
  }
  #>inscription_codex_christian
  ^["christian_preference"]{
   #:claim #!contested
   statement: "Early Christian scriptures survive almost entirely as codices; why Christians chose the codex so early is disputed."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_roberts_skeat_1983"
   counter: ~"../../registries/sources/record-and-carriers.spw#src_media_gamble_1995"
   note: "Roberts and Skeat proposed an early gospel codex as the model; Gamble argues an early codex edition of the letters of Paul set the precedent"
  }
 }
 ^["other_traditions"]{
  #>inscription_rung_palm_leaf
  ^["palm_leaf"]{
   #:era #!medieval
   #:claim #!settled
   statement: "Across South and Southeast Asia, texts were incised or inked on dried palm leaves, strung through holes, and kept between wooden boards."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_suarez_woudhuysen_2013"
  }
  #>inscription_rung_screenfold
  ^["screenfold_books"]{
   #:claim #!settled
   statement: "Mesoamerican scribes painted screenfold books on bark paper or deerskin coated with a white lime ground, folded like an accordion."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_suarez_woudhuysen_2013"
  }
  #>inscription_rung_khipu
  ^["khipu"]{
   #:claim #!settled
   statement: "Andean khipu recorded numbers as knots on hanging cords in a base-ten place system, kept and read by trained specialists."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_urton_2003"
  }
  #>inscription_khipu_narrative
  ^["khipu_narrative"]{
   #:claim #!contested
   statement: "Whether some khipu also encoded names, narratives, or language is unresolved; Urton proposed a binary coding reading that remains debated."
   source: ~"../../registries/sources/record-and-carriers.spw#src_media_urton_2003"
  }
 }
}

^["try"]{
 #>inscription_try_tablet
 ^["clay_tablet"]{
  materials: [ "a fist of air-dry clay", "a chopstick trimmed to a wedge", "a rolling pin or bottle", "a ruler" ]
  steps: << "roll a slab about a finger thick" ; "press wedge strokes for a tally of ten items" ; "write the same tally in pen on paper" ; "let the tablet dry overnight and compare which record you could carry, erase, or forge" >>
  time: .{ n: 40, unit: "minutes" }
  safety: "air-dry clay has no hazard worth naming; wash hands before eating"
  shows: ~"./surfaces-tablet-scroll-codex.spw#inscription_rung_tablets"
 }
}

#>inscription_codex_genre_q
?["Did random access, more than price, decide which texts moved to the codex first?"]{
 #:depth #!historical ~#lens(historical layer)
 #:claim #!speculative
 ~#hypothesis: "Texts readers consult out of order, such as scripture, law, and reference, should move to the codex earlier than texts read straight through."
 !probe{ "tabulate codex share by genre and century in the Leuven Database of Ancient Books" =id[p_media_codex_genre] =kind[census] }
 $%[particle.mood]
 ~"./surfaces-tablet-scroll-codex.spw#inscription_codex_parity" ~#neighbor(nearest)
}
