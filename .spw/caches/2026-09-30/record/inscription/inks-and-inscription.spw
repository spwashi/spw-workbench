^["edges"]{
 needs: [ ~"./surfaces-tablet-scroll-codex.spw#inscription_surfaces" ]
 feeds: [ ~"./print-and-press.spw#inscription_print", ~"./paper-and-pulp-manufacture.spw#inscription_paper" ]
 grounds: [ ~"../carriers/carrier-decay-and-fixity.spw#media_carriers_decay" ]
