# Inks and Inscription
#
# Carbon and iron-gall inks, how ink enters paper, the oil varnish of the printing press, and the route paper took from China through the Islamic world to Europe.

#>inscription_inks
#:layer #!reference
#:domain #!inscription
#:form #!ledger
#:level #!foundation
#:review #!adversarial_checked
#:valence #!bone
#:era #!medieval

^"emit"{
 ~#title: "Inks and Inscription"
 ~#claim: "Carbon ink sits on the surface while iron-gall ink darkens as it oxidizes and bites into the page, which is why it lasts and why it corrodes."
 ~#proof: "Kolar and Strlic on iron-gall chemistry and decay; Tsien on Chinese ink and paper; Bloom on the paper route through the Islamic world."
 ~#door: "Read the paper matrix next, then the decay ledger."
 ~#audience: "readers with high-school chemistry who handle old documents or write with dip pens"
 continuity: "Inks and Inscription | bites into the page"
 cold_open: "Soot ink rests on top, while iron-gall ink darkens in air and bites into the page it marks."
}

