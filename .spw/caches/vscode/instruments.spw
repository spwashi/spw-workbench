# VS Code Workbench Instruments
#
# Detailed cache of Workbench Instruments, live preview mechanics, and refactoring palettes in VS Code.

#>spw_cache_vscode_instruments
#:cache #!vscode
#:layer #!pragmatics

^"intent"{
  ~#goal: "Cache the operational mechanics, side-by-side previews, and refactoring gestures of Spw Instruments in VS Code."
  ~#source: "extensions/vscode-spw/src/instruments/commands.ts"
  ~#contract: ~"../../tooling/editor-instruments.spw"
}

^["actions"]{
  inspect_geometry: .{
    command_id: "spw.inspectGeometry"
    title: "Spw: Inspect Form"
    transport: "LSP custom request 'spw/geometry' with CLI fallback ('spw form <surface> --resonance --spw')"
    presentation: "Opens virtual document 'spw-form://<path>.spw' in ViewColumn.Beside with source-code syntax"
    asks: #brace_geometry_and_resonance
    live_buffer: true
  }[reg=facet]

  inspect_stack: .{
    command_id: "spw.showSurfaceProfile"
    title: "Spw: Inspect Surface Stack"
    transport: "LSP custom request 'spw/surfaceProfile' with CLI fallback ('spw stack <surface> --json')"
    presentation: "Opens virtual document 'spw-stack://<path>.json' in ViewColumn.Beside"
    asks: #surface_profile_and_dialect_stack
    live_buffer: true
  }[reg=facet]

  inspect_cache: .{
    command_id: "spw.inspectCache"
    title: "Spw: Inspect Cache"
    transport: "Hybrid: reads client probe cache stats, connects to LSP cacheReflection, and executes CLI inspect cache"
    presentation: "Opens virtual document 'spw-cache://<path>.card' rendering cache.layer/1 card"
    asks: #cache_layer_and_plane_accounting
    live_buffer: true
  }[reg=facet]

  rename_symbol: .{
    command_id: "spw.renameSymbol"
    title: "Spw: Rename Symbol"
    delegates_to: "vscode.commands.executeCommand('editor.action.rename')"
    transport: "Standard LSP textDocument/prepareRename and textDocument/rename"
    asks: #caret_symbol_change
    live_buffer: true
  }[reg=facet]

  plan_corpus_refactor: .{
    command_id: "spw.planCorpusRefactor"
    title: "Spw: Plan Corpus Refactor..."
    flow: #[
      "QuickPick: Select refactor kind (mark, anchor, case, mood)",
      "InputBox: Enter source identifier (from)",
      "InputBox: Enter replacement identifier (to)",
      "Execution: spw refactor . --rename <kind:from=to> --json",
      "Display: Opens virtual document 'spw-plan://refactor.json' beside editor"
    ]
    asks: #corpus_change_preview
    live_buffer: false
    safety_rule: "Never adds --write; output remains strictly inspectable JSON"
  }[reg=facet]

  clear_probe_cache: .{
    command_id: "spw.clearProbeCache"
    title: "Spw: Clear Probe Cache"
    behavior: "Clears client in-memory probe cache and notifies user with confirmation banner"
  }[reg=facet]
}

^["live_vs_saved_execution"]{
  live_preference: "Whenever the LSP client is connected, form and stack instruments sample the active editor text buffer, including unsaved changes."
  cli_fallback: "If the LSP is restarting or disconnected, instruments seamlessly fall back to executing the canonical Spw CLI on disk."
  dual_receipt: "Cache inspection displays both editor-local TTL probe cache hits and server-side runtime cache hits without conflating them."
}

^["quick_pick_refactoring"]{
  step_1_kind: .{
    prompt: "Select refactor kind"
    items: #[
      .{ label: "mark", description: "Rename syntactic marks across corpus" },
      .{ label: "anchor", description: "Rename unique #> anchor definitions and refs" },
      .{ label: "case", description: "Rename case tags and branch labels" },
      .{ label: "mood", description: "Rename mood indicators and modal tags" }
    ]
  }
  step_2_identifiers: "Validates non-empty from and to values before invoking CLI"
  step_3_preview: "Emits a formatted plan card outlining affected files and replacement diffs"
}

^["taste"]{
  ~#taste: "The instrument sequence flows naturally: form → stack → cache → rename → plan."
  ~#wonder: "Can side-by-side previews remain companion instruments without competing for primary focus?"

  reflections: #[
    "Virtual documents over file clutter: Generating in-memory URI schemes (spw-form://, spw-stack://) avoids littering the git workspace with scratch files.",
    "Column beside courtesy: Previews open in ViewColumn.Beside preserving editor focus, allowing the author to keep typing without clicking back.",
    "Truthful omissions: When a cache plane is unpopulated, state it clearly as an omission rather than inventing synthetic numbers."
  ]
}

^["invariants"]{
  "Preview buffers generated by instruments are marked read-only and disposed on editor tab close.",
  "Corpus refactor planning never modifies files on disk; apply requires a separate, conscious terminal act.",
  "Client probe cache flush commands immediately reset hit counters to 0.",
}

#>wonder_vscode_instruments_1
?["How does the quick-pick refactor workflow change an author's caution when renaming corpus anchors?"]{
  #:depth #!experiential ~#lens(refactoring_cadence)
  ~#hypothesis: "Multi-step quick pick prompts force the author to confirm the semantic kind (mark vs anchor vs case) before seeing the cross-corpus blast radius."
  !probe{ "Simulate renaming an anchor that appears in 20 files; measure how the JSON preview card communicates risk compared to an automatic IDE inline rename." }
  $%[plan.affected_file_count, author.cancellation_rate]
}
