# VS Code Feature Cache Index
#
# Root cache index for Visual Studio Code Spw language support, instruments, views, and wonder taste.

#>spw_cache_vscode_index
#:cache #!vscode
#:layer #!pragmatics

^"intent"{
  ~#goal: "Cache structural, semantic, and instrument features provided by the VS Code Spw extension."
  ~#host: "Visual Studio Code (1.80.0+)"
  ~#source_manifest: ~"../../../extensions/vscode-spw/package.json"
  ~#spec_owner: ~"../../tooling/vscode-spw.spw"
}

^"roots"{
  @features: ~"./features.spw"
  @instruments: ~"./instruments.spw"
  @navigation: ~"./navigation.spw"
  @views: ~"./views.spw"
  @decorations: ~"./decorations.spw"
  @probe_cache: ~"./probe-cache.spw"
  @syntax: ~"./syntax-highlighting.spw"
  @lsp: ~"./lsp-client.spw"
  @taste: ~"./taste.spw"
  @cache_layer: ~"./cache-layer.spw"
}

^"dispatch"{
  overview: @features
  instruments: @instruments
  navigation: @navigation
  views: @views
  decorations: @decorations
  probe_cache: @probe_cache
  syntax_highlighting: @syntax
  lsp_integration: @lsp
  taste_considerations: @taste
  cache_reflection: @cache_layer
}

^"taste"{
  ~#taste: "The VS Code host contour emphasizes live, side-by-side exploratory feedback, guided palettes, and quiet inquiry."
  ~#rule: "The extension is orchestration and projection; semantic truth remains strictly inside the shared Language Server."
}

^"invariants"{
  "VS Code thin-client never forks semantic analysis into a second editor-only engine.",
  "Live document instruments participate with unsaved buffers via LSP custom requests.",
  "Client-side TTL probe cache reports hits, misses, and expirations without masquerading as runtime memory.",
  "Activity Bar tree views (Atlas, Concepts) earn their interruption budget by answering repeated author questions.",
}

#>wonder_vscode_index_1
?["What is the fundamental difference in authoring rhythm between VS Code and JetBrains in Spw?"]{
  #:depth #!philosophical ~#lens(host_contour)
  ~#hypothesis: "VS Code favors continuous fluid resonance with live side-by-side previews; JetBrains favors structural contemplation and saved-file milestone discipline."
  !probe{ "Observe an author drafting an architectural plan: compare how often they run live form probes in VS Code vs inspecting Structure View in JetBrains." }
  $%[author.probe_frequency, editor.preview_duration]
}
