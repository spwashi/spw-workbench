# Resume direction — 2026-09-30
#
# Read this after the workbench revision that contains it is mounted.
# The consumer repository keeps its own canon. This note is a shelf item,
# not a site doctrine and not a command list.

#>spw_cache_resume_2026_09_30
#:cache #!resume
#:layer #!pragmatics

@caches: ~"../index.spw"
@plans: ~"../../../.agents/plans/index.spw"
@primed: ~"../../../.agents/plans/plan-ecology-clustering/plan-ecology-clustering.spw"
@samples: ~"../../../.agents/plans/syntax-hardware-alignment/syntax-hardware-alignment.spw"
@gate: ~"../../../scripts/analyzers/spw-cut-gate.ts"

expression = resume[direction]{wire.cost.fragment}<hold>

^"read_this_first"{
  where = `Mounted workbench, path .spw/caches/resume/2026-09-30-direction.spw under the mount.`
  when = `Credits resume in the consumer codebase, after this workbench revision is what the mount points at.`
  authority = `Consumer .spw owns the site. This file does not replace philosophy, slices, or mount.`
}

^"direction"{
  rule = `Nothing happens without a potential difference across a boundary. Charge, liminality, saturation, and phase are the four terms. Five registers speak for them and each is mute somewhere. Silence is a correct state.`
  crop = `A distinction that vanishes when cropped to one sigil is not a distinction. A still receives the patch; the crossing stays in the receipt.`
  cadence = `A shell may discharge once, then it is grounded. Repetition does not make a command more true.`
  selection = `A selection pins a coordinate and leaves the source in place. Projection hosts a guest notation. It does not erase it.`
  arrival = `A newcomer may land on one fragment. A practiced circuit is earned by holding attention. It is not the door.`
  product = `Current command names, cards, tables, and JSON envelopes are stills. They are not assumed to be the longitudinal product.`
}

^"this_revision"{
  shelf = `The topic folders under .spw/caches/ are the raw shelf. They are residue and curricula, not a dated cut.`
  ethics = `The shelf index discloses the generator and the review standing. A ^["quarantine"] frame names health and remediation files that must not be cited or followed. The cut gate warns, and fails on a sourced review surface, when a factual claim has no source link in its own frame, and it fails provenance that lacks as_of, generator, or lineage.`
  plans = `Primed tooling follows language samples and retained cost samples. See ^["primed_scrutiny"] in the plan ecology artifact.`
  lead = #[
    `syntax-hardware-alignment — seven samples, still samples, no parser change`,
    `cli-benchmarking-infra — retained samples before any mode contract`,
    `typescript-perf-audit-infra — one timed typecheck identity row`
  ]
  held = #[
    `cli-mode-overhaul — mode contract held`,
    `citation-navigation — resolve parity kept, journey held`,
    `lsp-custom-request-completions — method matrix and formContext held`,
    `neovim-spw-surfaces — evidence-state audit only`,
    `intellij-lsp4ij — stays on the 263 gate`,
    `apposition-cache-granules — leak test allowed, granule key unset`
  ]
  dormant = #[
    `vscode-plugin-performance — waits on a retained sample`,
    `geometric-analysis-tooling — operator counts still wrong on quoted sigils`
  ]
}

^"not_in_this_revision"{
  dated_cut = `There is no .spw/caches/2026-09-30/ cut. scripts/analyzers/spw-cut-gate.ts exits 2 when that directory is absent. Do not invent the cut on deploy.`
  local_worktrees = `Three local worktrees still hold uncommitted edits and are not in this commit: lens visibility in the LSP and the concepts tree; fragment navigation to an anchor line; fragment links in the corpus graph. Their branches are worktree-wf_7b1587d2-205-1, worktree-wf_7b1587d2-205-2, and worktree-wf_7b1587d2-205-3. A later pass put each into hardening for a fresh review plus a measured wire and cost. They were still unapplied when this note was written. They overlap server-index. If this machine is the only copy, preserve those worktrees before leaving it.`
  studies = `An ontology synthesis and three design studies were still in flight beside that hardening. Do not treat an empty task log as a finding.`
}

^"consumer_integration"{
  first = `Mount this revision. Read the consumer philosophy and slices before adding a surface.`
  do = #[
    `Let one existing slice be a fragment door: one sigil or one region, legible alone, the rest quiet.`,
    `Keep charge (what kind of difference) off the visit arc (how far along). Do not map valence onto spirit-cycle phases.`,
    `Cite a factual claim inside its own frame, and disclose as_of, generator, and lineage. Do not cite a quarantined file.`,
    `Treat host-feature caches as residue. Language, mathematics, physics, linguistics, and attention are the scrutiny shelf.`,
    `When a dated cut is warranted, write it as consumer-owned material and point the cut gate at that directory.`
  ]
  refuse = #[
    `A command tour as onboarding`,
    `A live gradient of every operator on arrival`,
    `Editor chrome that copies another host`,
    `Promoting a local worktree diff into the mount without a wire and a cost`
  ]
}

^"falsify"{
  #[
    `This note is treated as site doctrine`,
    `A dated cut is assumed to exist because the gate script does`,
    `The three local worktree branches are assumed to have deployed`,
    `A cache folder is taught as the language`
  ]
}
