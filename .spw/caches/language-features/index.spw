# Beloved Language Features & Developer Joy Cache Index
#
# Root cache index for features from other programming languages celebrated by software engineers and hobbyists.

#>spw_cache_language_features_index
#:cache #!languages
#:layer #!pragmatics

^"intent"{
  ~#goal: "Catalog, analyze, and synthesize programming language features that bring profound joy, safety, and expressive power to engineers and hobbyists."
  ~#scope: "Systems languages (Rust, Zig), functional runtimes (Elixir, Erlang), homoiconic environments (Clojure, Lisp), modern typed surfaces (TypeScript, Kotlin), and array/concatenative paradigms (APL, Forth, Uiua)."
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @systems_memory: ~"./systems-and-memory.spw"
  @functional_pipeline: ~"./functional-and-pipeline.spw"
  @structural_homoiconic: ~"./structural-and-homoiconic.spw"
  @type_ergonomics: ~"./type-systems-and-ergonomics.spw"
  @array_concatenative: ~"./array-and-concatenative.spw"
  @developer_joy: ~"./developer-joy.spw"
  @spw_resonance: ~"./spw-resonance.spw"
}

^"dispatch"{
  systems_and_memory: @systems_memory
  functional_and_pipeline: @functional_pipeline
  structural_and_homoiconic: @structural_homoiconic
  type_systems_and_ergonomics: @type_ergonomics
  array_and_concatenative: @array_concatenative
  developer_joy: @developer_joy
  spw_resonance: @spw_resonance
}

^"taste"{
  ~#taste: "The best language features eliminate friction between thought and execution without hiding physical reality."
  ~#wonder: "Why do certain programming language constructs feel like play while others feel like filling out tax forms?"
}

^"invariants"{
  "Every celebrated feature is analyzed for both its theoretical foundation and its daily ergonomic delight.",
  "Features are contrasted with common anti-patterns they were designed to replace.",
  "Cross-connections illustrate how these paradigms inform Spw operator physics, valence tags, and frame geometry.",
}

#>wonder_language_features_index_1
?["What common thread connects Zig comptime, Elixir pipes, and Clojure homoiconicity?"]{
  #:depth #!philosophical ~#lens(expressive_unification)
  ~#hypothesis: "Each feature collapses an artificial boundary: comptime collapses macro/runtime syntax; pipes collapse nesting into linear flow; homoiconicity collapses code and data."
  !probe{ "Compare how a developer manipulates an AST across Zig, Elixir, and Clojure; evaluate cognitive friction vs expressive power." }
  $%[syntax.boundary_collapse_score, developer.perceived_delight_index]
}
