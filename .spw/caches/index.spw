# Caches
#
# Root of the caches: a living tree kept true, and a journal of what was seen or made on a day.

#>caches_root
#:layer #!pragmatics

^["intent"]{
 ~#goal: "One root for every cache surface; the tree is a view over the journal and its sources."
 ~#taste: "a surface lives in the tree when someone should keep it true, and in the journal when it records a day"
}

^["layers"]{
 tree: ~"./tree/contract.spw"
 journal: ~"./journal/index.spw"
}

^["journal_entries"]{
 shelf: ~"./journal/2026-09-30-gemini-shelf/index.spw"
 resume: ~"./journal/2026-09-30-resume.spw"
 season_2026_q4: ~"./journal/2026-10-01-season-2026-q4/index.spw"
 snapshot: ~"./journal/2026-10-13-cut-snapshot.spw"
}
