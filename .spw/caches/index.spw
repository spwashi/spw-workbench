# Caches Index
#
# Root index for cached surfaces, receipts, host feature catalogs, language features, and domain curricula under .spw/caches/

#>spw_caches_index
#:cache #!index
#:layer #!pragmatics

^"intent"{
  ~#goal: "Provide a discoverable cache root for host features, evidence receipts, live streaming mechanics, educational curricula, and beloved language features."
  ~#retention: "Caches are derived and inspectable; they reflect underlying surfaces without replacing authoritative source."
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @jetbrains: ~"./jetbrains/index.spw"
  @vscode: ~"./vscode/index.spw"
  @tiktok_live: ~"./tiktok-live/index.spw"
  @podcasting: ~"./podcasting/index.spw"
  @language_features: ~"./language-features/index.spw"
  @university_education: ~"./university-education/index.spw"
  @secondary_education: ~"./secondary-education/index.spw"
  @community_roles: ~"./community-roles/index.spw"
  @physiological_development: ~"./physiological-development/index.spw"
  @chemistry_and_chemical_engineering: ~"./university-education/chemistry-and-chemical-engineering/index.spw"
  @physics_and_mechanical_engineering: ~"./university-education/physics-and-mechanical-engineering/index.spw"
  @materials_science: ~"./university-education/materials-science/index.spw"
  @thermodynamics: ~"./university-education/thermodynamics/index.spw"
  @electrical_and_computer_engineering: ~"./university-education/electrical-and-computer-engineering/index.spw"
  @horticulture_and_botany: ~"./university-education/horticulture-and-botany/index.spw"
  @illustration_and_animation: ~"./university-education/illustration-and-animation/index.spw"
  @design_and_industrial_engineering: ~"./university-education/design-and-industrial-engineering/index.spw"
  @film_chemistry_and_camera_optics: ~"./film-chemistry-and-camera-optics/index.spw"
  @film_production_and_industry: ~"./film-production-and-industry/index.spw"
  @indie_author_ecosystem: ~"./indie-author-ecosystem/index.spw"
  @film_and_theatre: ~"./university-education/film-and-theatre/index.spw"
  @linguistics: ~"./university-education/linguistics/index.spw"
  @economics: ~"./university-education/economics/index.spw"
  @mathematics: ~"./university-education/mathematics/index.spw"
  @cognitive_psychology: ~"./university-education/cognitive-psychology/index.spw"
  @neuroscience: ~"./university-education/neuroscience/index.spw"
  @molecular_and_cellular_biology: ~"./university-education/molecular-and-cellular-biology/index.spw"
  @bioengineering: ~"./university-education/bioengineering/index.spw"
  @nursing: ~"./university-education/nursing/index.spw"
  @hospitality_and_management: ~"./university-education/hospitality-and-management/index.spw"
  @library_and_information_sciences: ~"./university-education/library-and-information-sciences/index.spw"
  @materials_matter_and_history: ~"./materials-matter-and-history/index.spw"
  @resume_2026_09_30: ~"./resume/2026-09-30-direction.spw"
}

^"dispatch"{
  jetbrains: @jetbrains
  vscode: @vscode
  tiktok_live: @tiktok_live
  podcasting: @podcasting
  language_features: @language_features
  university_education: @university_education
  secondary_education: @secondary_education
  community_roles: @community_roles
  physiological_development: @physiological_development
  chemistry_and_chemical_engineering: @chemistry_and_chemical_engineering
  physics_and_mechanical_engineering: @physics_and_mechanical_engineering
  materials_science: @materials_science
  thermodynamics: @thermodynamics
  electrical_and_computer_engineering: @electrical_and_computer_engineering
  horticulture_and_botany: @horticulture_and_botany
  illustration_and_animation: @illustration_and_animation
  design_and_industrial_engineering: @design_and_industrial_engineering
  film_chemistry_and_camera_optics: @film_chemistry_and_camera_optics
  film_production_and_industry: @film_production_and_industry
  indie_author_ecosystem: @indie_author_ecosystem
  film_and_theatre: @film_and_theatre
  linguistics: @linguistics
  economics: @economics
  mathematics: @mathematics
  cognitive_psychology: @cognitive_psychology
  neuroscience: @neuroscience
  molecular_and_cellular_biology: @molecular_and_cellular_biology
  bioengineering: @bioengineering
  nursing: @nursing
  hospitality_and_management: @hospitality_and_management
  library_and_information_sciences: @library_and_information_sciences
  materials_matter_and_history: @materials_matter_and_history
  resume_2026_09_30: @resume_2026_09_30
}

^"taste"{
  ~#taste: "Caches exist to reduce latency and disclose state, never to usurp primary authorial authority."
  ~#wonder: "Can a unified symbolic workbench cache IDE features, interactive live platforms, multi-year curricula, and beloved language features under the same syntactic physics?"
}

^"scrutiny"{
  # 2026-09-30. Host catalogs are residue. They do not lead language or performance decisions.
  lead: [@resume_2026_09_30, @language_features, @mathematics, @physics_and_mechanical_engineering, @linguistics, @cognitive_psychology]
  residue: [@vscode, @jetbrains, @tiktok_live, @podcasting]
  law: "A cache earns retention when a reader can derive it from a crop and name its wire and its cost. A cache that only repeats a command name or an editor action stays cold."
}

^"disclosure"{
  generator: "gemini-3.8-flash-high"
  generated: "2026-09-30"
  review: "two review rounds on 2026-09-30 scored every file for depth, independent value, script value, tree fit, and accessibility; core lists ran about 85 to 90 percent accurate, with errors concentrated in taste and wonder layers"
  standing: "generated residue kept for provenance; claims here are unreviewed unless a revised surface cites them"
}

^"quarantine"{
  # Health and clinical files whose errors could harm a reader who acted on them. Kept for provenance; do not cite or follow.
  reason: "guideline drift, missing contraindications, and advice that steers away from standard care"
  files: [
    ~"./physiological-development/common-deficiencies.spw",
    ~"./physiological-development/nutritional-support-strategies.spw",
    ~"./physiological-development/developmental-stages.spw",
    ~"./physiological-development/circadian-and-metabolic-resilience.spw",
    ~"./physiological-development/taste.spw",
    ~"./university-education/nursing/pathophysiology-and-pharmacology-in-nursing.spw",
    ~"./university-education/nursing/critical-care-and-evidence-based-informatics.spw",
    ~"./university-education/nursing/ethical-care-and-therapeutic-presence.spw",
    ~"./community-roles/ecological-and-spatial-stewards.spw"
  ]
  examples: [
    "liver recommended with no pregnancy warning",
    "MTHFR carriers steered from folic acid to methylfolate",
    "vancomycin trough of 15 to 20 described as preventing nephrotoxicity",
    "chlorhexidine oral care presented as a current protocol",
    "sunflowers presented as lead remediation alongside free produce"
  ]
}

^"invariants"{
  "Cached surfaces remain derived projections; author source retains primary authority.",
  "Every cached entry declares its provenance, retention policy, and inspection path.",
  "Distinct cache planes stay named rather than flattened into a single hit or miss claim.",
  "Peer editor caches (JetBrains, VS Code) disclose comparable depth without copying each other's chrome.",
  "Domain curricula and language feature catalogs model real-world temporal, ergonomic, and economic systems with mathematical rigor.",
  "Host-feature caches do not outrank language and performance scrutiny.",
}

#>wonder_caches_index_1
?["What invariant holds across all cache domains in this workbench?"]{
  #:depth #!philosophical ~#lens(universal_lattice)
  ~#hypothesis: "Whether describing an IntelliJ action, a WebRTC video pipe, a 3-year type theory curriculum, or Zig comptime metaprogramming, Spw frames, anchors, and registers provide a single coherent ontology for modeling complex human and machine systems."
  !probe{ "Query all cached files for #> unique anchors; verify that cross-domain path references resolve cleanly across the entire .spw/caches/ tree." }
  $%[cache.total_file_count, cache.anchor_count, cache.cross_ref_validity]
}
