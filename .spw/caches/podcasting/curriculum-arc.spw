# Three-Year Technical Curriculum Master Arc
#
# Master architectural roadmap spanning Web Development → Lower-Level Systems → Abstract Computation.

#>spw_cache_podcast_curriculum
#:cache #!podcasting
#:layer #!pragmatics

^"intent"{
  ~#goal: "Define the pedagogical trajectory connecting high-level visual browser surfaces down to raw physical machine code, then ascending to formal mathematical and algorithmic abstractions."
  ~#duration: "3 Full Years (365 Episodes per Year · 1,095 Episodes total)"
  ~#philosophical_thesis: "You cannot understand an abstraction until you know what physical cost it is hiding; you cannot understand a physical machine until you see the mathematical laws it is executing."
}

^["grand_progression"]{
  year_1: .{
    theme: "The Surface & The Runtime: Web Development, Browsers, and Distributed Network Services"
    grounding: "Start with what the developer can see and touch in an inspector: HTML, CSS layout, JS event loop, DOM, HTTP, WebSockets, WASM."
    direction: "Inward & Downward: Tracing how browser rendering engines turn text strings into GPU pixels."
  }[reg=facet]

  year_2: .{
    theme: "The Metal & The Kernel: Systems Programming, Memory Topography, and Hardware Architecture"
    grounding: "C, Rust, Zig, CPU architectures, assembly, cache lines, memory allocators, OS syscalls, compilers, linkers."
    direction: "Down to the Silicon: Exploring the physical constraints of electrons, clock cycles, and memory hierarchies."
  }[reg=facet]

  year_3: .{
    theme: "The Form & The Logic: Abstract Computational Foundations, Type Theory, and Algorithmic Topology"
    grounding: "Lambda calculus, category theory, formal verification, distributed consensus, graph flows, complexity theory, cryptography, quantum algorithms."
    direction: "Upward to Pure Reason: Deriving the universal mathematical truths that govern all possible computation."
  }[reg=facet]
}

^["year_1_synthesis"]{
  episodes: "001 through 365"
  core_question: "How does human intent typed into an editor become an interactive experience distributed across millions of networked browser screens?"
  anchor_technologies: #[HTML5, CSS_Grid_Flexbox, JavaScript_ES2026, V8_Engine, WebAssembly, HTTP_3_QUIC, Node_Bun, PostgreSQL, Distributed_Edge]
}

^["year_2_synthesis"]{
  episodes: "366 through 730"
  core_question: "What actually happens when a piece of software touches the physical machine, and how do we wield direct control over memory and hardware?"
  anchor_technologies: #[C23, Rust_Edition_2024, Zig, x86_64_ARM64_Assembly, Linux_Kernel_6_x, LLVM_IR, MMU_Paging, jemalloc, epoll_io_uring, SIMD_AVX512]
}

^["year_3_synthesis"]{
  episodes: "731 through 1095"
  core_question: "What are the fundamental mathematical and algorithmic boundaries of what can be computed, proven, and verified?"
  anchor_technologies: #[Lambda_Calculus, Hindley_Milner_Types, Category_Theory, Coq_TLA_Plus, Raft_Paxos_BFT, P_vs_NP, Zero_Knowledge_Proofs, Abstract_Interpretation]
}

^["pedagogical_bridges"]{
  bridge_1_to_2: .{
    transition: "Episodes 350-365 (WebAssembly → Native Machine Code)"
    climax: "Writing a WebAssembly module by hand in text format (WAT), compiling it to native machine instructions, and peeling back the V8 runtime sandbox to reveal raw memory buffers."
  }[reg=facet]

  bridge_2_to_3: .{
    transition: "Episodes 715-730 (Compilers & Type Checkers → Type Theory & Formal Logic)"
    climax: "Constructing an optimizing compiler backend in Rust, implementing register allocation, and recognizing that compiler optimization is mathematically equivalent to abstract interpretation."
  }[reg=facet]
}

^["taste"]{
  ~#taste: "Never introduce an abstraction as a convenience; introduce it as an inescapable solution to a physical contradiction."
  ~#wonder: "Why does the deepest computing theory feel less like inventing arbitrary tools and more like discovering the laws of physics?"

  principles: #[
    "Continuous historical thread: From Ada Lovelace and Alan Turing to modern multicore chips, every tool answers a historical dilemma.",
    "Physical accountability: Every line of code consumes electrical energy, charges capacitor cells, and occupies physical space.",
    "Mathematical clarity: Complexity is not intelligence; simplicity won through deep understanding is the highest art."
  ]
}

^["invariants"]{
  "No topic is taught in isolation; every episode references its position on the grand 3-year progression map.",
  "Listeners are never asked to accept a mechanism on faith; every layer is unpacked until foundational axioms are reached.",
  "Episodes culminate in concrete executable code or formal mathematical proofs.",
}

#>wonder_podcast_curriculum_1
?["How does mastering the entire computing stack from web to silicon to mathematics reshape engineering judgment?"]{
  #:depth #!philosophical ~#lens(integrated_mastery)
  ~#hypothesis: "Engineers who understand the whole stack stop arguing about frameworks; they diagnose system bottlenecks at their true layer of origin."
  !probe{ "Ask a senior engineer to debug a 200ms web UI latency spike; track whether their mental model stops at React re-renders or traces through GC pauses, syscall context switches, and cache misses." }
  $%[diagnostic.layer_traversal_depth, root_cause.resolution_accuracy]
}
