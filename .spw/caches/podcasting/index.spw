# Podcasting Market Research & Three-Year Technical Curriculum Cache
#
# Root cache index for podcast market intelligence and a daily 3-hour technical curriculum across 3 years.

#>spw_cache_podcasting_index
#:cache #!podcasting
#:layer #!pragmatics

^"intent"{
  ~#goal: "Cache market research economics of podcasting alongside a complete 3-year daily 3-hour curriculum tracing computing from web development to systems programming to abstract computational theory."
  ~#format: "Daily 3-hour in-depth technical dialogue (1,095 episodes · 3,285 broadcasting hours)"
  ~#trajectory: "Year 1: Web Development & Runtimes → Year 2: Systems, Memory & Compilers → Year 3: Abstract Computation & Algorithmic Principles"
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @market: ~"./market-research.spw"
  @cadence: ~"./long-form-cadence.spw"
  @curriculum: ~"./curriculum-arc.spw"
  @year1: ~"./year1-web-development.spw"
  @year2: ~"./year2-systems-programming.spw"
  @year3: ~"./year3-abstract-computation.spw"
  @architecture: ~"./episode-architecture.spw"
  @topical: ~"./topical-index.spw"
  @taste: ~"./taste.spw"
}

^"dispatch"{
  market_research: @market
  cadence_and_endurance: @cadence
  curriculum_master_arc: @curriculum
  year1_web_development: @year1
  year2_systems_programming: @year2
  year3_abstract_computation: @year3
  episode_architecture: @architecture
  topical_index: @topical
  taste_considerations: @taste
}

^"taste"{
  ~#taste: "The deepest technical education is unhurried, rigorous, historically grounded, and mechanically verified."
  ~#wonder: "What happens to a listener's mental models when they spend 3,000 hours moving step-by-step from a CSS box model down to silicon logic gates and up to category theory?"
}

^"invariants"{
  "Curriculum progresses monotonically from empirical visual surfaces down to physical hardware, then upward to pure mathematical abstractions.",
  "Every daily 3-hour episode balances theoretical derivation, concrete mechanical trace, and historical context.",
  "Market research economics model sustainable long-tail creator independence free from intrusive sponsor distortion.",
}

#>wonder_podcasting_index_1
?["Why is the daily 3-hour long-form format uniquely suited for technical mastery compared to short-form tutorials?"]{
  #:depth #!philosophical ~#lens(cognitive_immersion)
  ~#hypothesis: "Short-form content provides recipes; long-form dialogue teaches how to think, demonstrating false starts, architectural tradeoffs, and mechanical debugging in real time."
  !probe{ "Survey listeners across 100 hours of programming audio: measure whether they retain syntax details or systematic problem-solving heuristics." }
  $%[learning.retention_heuristic_ratio, podcast.listener_immersion_index]
}
