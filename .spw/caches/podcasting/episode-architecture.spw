# Daily 3-Hour Episode Architecture & Segment Design
#
# Pedagogical blueprint, segment pacing, live coding protocols, and dialogue dynamics for a daily 3-hour episode.

#>spw_cache_podcast_architecture
#:cache #!podcasting
#:layer #!pragmatics

^"intent"{
  ~#goal: "Define the standardized architectural structure governing every single 3-hour daily broadcast to ensure intellectual depth, listener engagement, and cognitive sustainability."
  ~#format: "180 Minutes (3 Hours) divided into three distinct psychological and pedagogical phases"
}

^["the_three_hour_structure"]{
  hour_1_intuition_and_mental_model: .{
    segment_duration: "Minutes 00 - 60"
    role: "Foundational framing, motivating crisis, and intuitive physical metaphor"
    milestones: #[
      "00-10m: Cold open — introducing the core paradox or failure mode that necessitated the concept",
      "10-25m: Historical context — who created this, in what decade, and against what physical hardware limitations",
      "25-45m: The high-level mental model — building an intuitive spatial or physical analogy",
      "45-60m: Formal specification review — reading the exact RFC, ISO, or academic definition aloud"
    ]
  }[reg=facet]

  hour_2_mechanical_trace_and_live_code: .{
    segment_duration: "Minutes 60 - 120"
    role: "Deep mechanical trace: reading raw source code, disassembling instructions, memory profiling"
    milestones: #[
      "60-80m: Implementation walkthrough — line-by-line inspection of the reference implementation in C/Rust/JS/Lean",
      "80-100m: Disassembly & memory layout — tracing struct offsets, compiler IR, or AST reductions",
      "100-120m: Live benchmark & profiling — measuring cache misses, instruction counts, or execution latencies"
    ]
  }[reg=facet]

  hour_3_edge_cases_history_and_wonder: .{
    segment_duration: "Minutes 120 - 180"
    role: "Adversarial testing, production war stories, edge case falsification, and wonder inquiries"
    milestones: #[
      "120-145m: Breaking the model — identifying pathological edge cases where the abstraction collapses",
      "145-165m: Real-world catastrophe case study — famous outages caused by misunderstandings of this layer",
      "165-180m: Wonder synthesis & next-day bridge — asking open philosophical questions and connecting to tomorrow's episode"
    ]
  }[reg=facet]
}

^["whiteboard_and_diagramming_protocol"]{
  visual_accompaniment: "Studio equipped with digital high-framerate drawing tablet mirrored to video podcast streams."
  diagram_standards: #[
    "Memory diagrams must explicitly depict byte addresses, endianness, and padding boundaries.",
    "State machines must label all transition triggers and illegal state assertions.",
    "Category diagrams must clearly differentiate between objects (nodes) and morphisms (directed arrows)."
  ]
}

^["conversational_dynamics"]{
  role_separation: #[
    "Lead Host: Holds the structural narrative, leads derivations, and maintains chapter pacing.",
    "Co-Host: Represents the listener; interrupts when a step is skipped; actively plays the adversary.",
    "Rule of three: If a technical term is used that was not introduced in prior episodes, it must be defined immediately within 30 seconds."
  ]
}

^["taste"]{
  ~#taste: "The conversation should feel like sitting in an office after hours with two senior engineers who love their craft."
  ~#wonder: "Can an audio broadcast become a sacred temple of sustained intellectual attention in an age of fragmented dopamine clips?"

  principles: #[
    "Never rush: If a proof or explanation takes 40 minutes instead of 20, let it take 40 minutes.",
    "Respect the listener: Never dumb down mathematics or engineering reality; elevate the listener to meet the rigor.",
    "Warmth over cynicism: Technical critique should be rigorous, but free of haughtiness or contempt for junior developers."
  ]
}

^["invariants"]{
  "Every 3-hour episode includes exact timestamps and chapter titles matching the 3-phase structure.",
  "All code referenced in Hour 2 is committed to a public Git repository companion for the episode.",
  "Episodes conclude with at least one unanswered wonder inquiry to sustain curiosity for the next day.",
}

#>wonder_podcast_architecture_1
?["How does the three-hour progression from intuition to metal to philosophy alter how a listener retains knowledge?"]{
  #:depth #!experiential ~#lens(pedagogical_triad)
  ~#hypothesis: "Intuition gives the mind a scaffold; code trace gives it concrete evidence; philosophical edge testing gives it wisdom."
  !probe{ "Test listener comprehension 30 days after an episode: compare listeners who heard only Hour 1 vs listeners who experienced the full 3-hour journey." }
  $%[long_term.retention_score, practical.debugging_transfer_score]
}
