# Crew Morale, Safety Protocols & Set Culture Cache
#
# Firearms protocol, stunt safety, anti-fatigue measures, psychological safety, and union welfare standards.

#>spw_cache_film_prod_crew_morale
#:cache #!crew_morale_safety_and_culture
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model life-safety protocols, weapons procedures post-Rust, stunt safety engineering, crew fatigue mitigation, and healthy set culture."
  ~#protocol: "cache.layer/1"
}

^"life_safety_and_hazard_protocols"{
  "firearms_and_weapons_safety_bulletin_1": .{
    armorer_exclusive_custody: "The licensed Armorer maintains sole, continuous custody of all firearms on set; no weapon is handled by any crew member or actor until cleared immediately prior to the take",
    prohibition_of_live_ammunition: "Absolute ban on live ammunition anywhere on studio lots, prop trucks, or production locations; violation is a criminal offense and instant shutdown offense",
    three_point_clearance_ceremony: "Mandatory physical and visual chamber inspection performed jointly by Armorer, 1st AD, and actor: barrel cleared with cleaning rod, cylinder/magazine shown empty, and verbally called as 'cold gun'",
    post_rust_industry_transition: "Widespread transition to inert non-guns, solid resin replicas, or pneumatic gas-blowback props with digital CGI muzzle flash and sound added in post-production",
  }[reg=facet],
  "stunts_pyrotechnics_and_rigging_bulletin_38": .{
    stunt_coordinator_veto_authority: "The Stunt Coordinator has absolute safety veto power over any shot involving falls, vehicular motion, wire work, or physical combat",
    rigging_safety_factors: "All aerial trusses, wire work, and human-flying harnesses must maintain a minimum 10:1 engineering structural safety factor; secondary safety cable backups required on all suspended lights",
    mandatory_safety_briefings: "Pre-sequence all-hands safety meeting held before any explosion, car crash, or stunt sequence explaining evacuation paths, fire extinguisher stations, and medic positioning",
  }[reg=facet],
  "location_and_environmental_hazards": .{
    railroad_and_traffic_lockdowns: "Zero tolerance for unpermitted filming near active rail lines or open roads; mandatory dedicated railway flagmen, police traffic control, and physical safety barricades",
    water_and_confined_spaces: "Certified water rescue lifeguards on duty during marine scenes; air quality monitoring and emergency extraction teams on soundstages utilizing heavy atmospheric haze or smoke effects",
  }[reg=facet],
}

^"crew_fatigue_and_humanitarian_workplace_culture"{
  "combating_lethal_crew_fatigue": .{
    drowsy_driving_mitigation: "Production-funded hotel accommodations or rideshare vouchers mandatory when wrap occurs after midnight or when working hours exceed 14 hours to prevent vehicular fatalities",
    frat_day_elimination: "Curtailing the dangerous tradition of scheduling 16-hour shoots on Friday night rolling into Saturday morning ('frat days') that destroys human circadian rhythms and endangers lives",
    rest_period_enforcement: "Strict adherence to 12-hour turnaround between wrap and next crew call; resisting production pressure to buy out turnarounds with financial penalty pay",
  }[reg=facet],
  "psychological_safety_and_dignified_culture": .{
    eradicating_abusive_set_hierarchy: "Eliminating the legacy normalization of directors or actors screaming, throwing equipment, or publicly berating below-the-line crew members; enforcing strict anti-harassment codes",
    anonymous_safety_hotlines: "Direct, retaliation-free reporting lines (IATSE Safety Hotline, DGA confidential safety line) allowing any crew member to halt production over imminent hazards",
    nutritional_and_physical_welfare: "Recognizing craft services and hot catering not as mere perks, but as essential occupational sustenance maintaining physical stamina, mental focus, and departmental harmony",
  }[reg=facet],
}

^"wonder_probes"{
  #>wonder_film_prod_crew_morale_1
  ?["How does the tone and emotional demeanor of the director and 1st AD during the first 30 minutes of crew call dictate the safety and artistic outcome of a 14-hour shooting day?"]{
    #:depth #!sociological ~#lens(leadership_emotional_contagion)
    ~#hypothesis: "Set morale is governed by rapid affective contagion. When leadership exhibits grounded calm, transparent scheduling, and explicit gratitude toward technical crew during early morning blocking, panic and corner-cutting are suppressed, directly reducing safety incidents and fostering spontaneous creative problem-solving across departments."
    !probe{ "Correlate safety near-miss incident logs and crew turnover rates with standardized leadership emotional affect ratings across commercial and feature film sets." }
    $%[safety.near_miss_incident_frequency, production.crew_cohesion_and_morale_score]
  }
}
