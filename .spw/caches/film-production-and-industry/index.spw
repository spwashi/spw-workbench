# Film Production & Industry Cache Index
#
# Root cache index for film set hierarchy, crew operations, Hollywood industry career navigation, intimacy coordination, and literary adaptations.

#>spw_cache_film_prod_index
#:cache #!film_production_and_industry
#:layer #!pragmatics

^"intent"{
  ~#goal: "Model the operational realities, labor hierarchy, safety protocols, industry career structures, intimacy coordination standards, and literary adaptation mechanics of motion picture production."
  ~#domains: "Film production management, set operations, crew safety, Hollywood representation, intimacy coordination, and screen adaptation"
  ~#protocol: "cache.layer/1"
}

^"roots"{
  @set_operations: ~"./set-operations-and-crew-hierarchy.spw"
  @crew_morale: ~"./crew-morale-safety-and-culture.spw"
  @hollywood_careers: ~"./hollywood-careers-and-industry-navigation.spw"
  @intimacy_coordination: ~"./intimacy-coordination-and-consent.spw"
  @novel_adaptations: ~"./novel-adaptations-and-literary-translation.spw"
  @taste: ~"./taste.spw"
}

^"dispatch"{
  set_operations_and_crew_hierarchy: @set_operations
  crew_morale_safety_and_culture: @crew_morale
  hollywood_careers_and_industry_navigation: @hollywood_careers
  intimacy_coordination_and_consent: @intimacy_coordination
  novel_adaptations_and_literary_translation: @novel_adaptations
  taste_considerations: @taste
}

^"taste"{
  ~#taste: "A film set is a fragile city built in the dark, surviving on coffee, trust, and shared devotion to a single beam of light."
  ~#wonder: "How does an industrial machine comprising hundreds of disparate union artisans achieve the intimate emotional nuance of a personal poem?"
}

^"invariants"{
  "Operational and call-sheet protocols must respect union turnarounds, meal penalty rules, and safety bulletin procedures.",
  "Intimacy coordination models must uphold actor agency, closed-set sanctity, and SAG-AFTRA accredited protocols.",
  "Literary adaptation theory must distinguish between structural dramatic compression and mere illustrative transcription.",
}

^"wonder_probes"{
  #>wonder_film_prod_index_1
  ?["How does the rigid military-like discipline of a film set hierarchy enable, rather than stifle, radical improvisational acting performances?"]{
    #:depth #!sociological ~#lens(set_structure_as_creative_scaffolding)
    ~#hypothesis: "The strict division of labor and logistical certainty maintained by the 1st AD, gaffer, and sound mixer insulate the actors and director from ambient anxiety, creating a hermetically sealed psychological container where actors feel safe to take catastrophic emotional risks."
    !probe{ "Measure cortisol and psychological safety metrics across cast members on sets with highly structured 1st AD scheduling vs chaotic, unstructured indie sets." }
    $%[production.logistical_predictability_score, performance.vulnerability_depth_index]
  }
}
