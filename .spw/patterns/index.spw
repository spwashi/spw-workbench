# Patterns Index
#
# Scalable pattern catalog for literate architecture and query composition.

#>spw_patterns_index
#:pattern #!architecture
#:layer #!pragmatics

^"roots"{
  @literate_arch: ~"./literate-architecture.spw"
  @query_comp: ~"./query-composition.spw"
}

^"pattern_set"{
  literate_architecture: @literate_arch
  query_composition: @query_comp
}

^"invariant"{
  "Patterns must be executable as conventions and inspectable as literature.",
}


?["How does this convention shape the developer's experience?"]
  #:scope #!file
  ~#probe: "trace which workflows or tooling reference this surface"

