# Patterns Index
#
# Scalable pattern catalog for literate architecture, query composition, and literate UI.

#>spw_patterns_index
#:pattern #!architecture
#:layer #!pragmatics

^"roots"{
 @literate_arch: ~"./literate-architecture.spw"
 @query_comp: ~"./query-composition.spw"
 @literate_ui: ~"./literate-ui.spw"
}

^"pattern_set"{
 literate_architecture: @literate_arch
 query_composition: @query_comp
 literate_ui: @literate_ui
}

^"invariant"{
 "Patterns must be executable as conventions and inspectable as literature.",
}

#>wonder_spw_patterns_index_1
?["What invariant holds across every frame in Patterns Index?"]{
  #:depth #!computational // lens: living system
  $^["_"]@here => %[shared.property]
  ~#hypothesis: "all frames in this file share ____"
  !probe{ "extract the property common to roots's frames; if none exists, the file may lack cohesion or may be a deliberate collection." }
  $%[file.frame_count, file.annotation_density, file.brace_depth_max]
}

#>wonder_spw_patterns_index_2
?["What was Patterns Index before it was this, and what could it become?"]{
  #:depth #!mathematical // lens: curated collection
  ~#past: "git log --oneline -- .spw/patterns/index.spw | head -3"
  ~#future: "what frame would you add next?"
  !probe{ "the file's git history IS its evolutionary record; the next natural frame reveals the author's trajectory." }
  $%[file.frame_count, file.annotation_density, file.brace_depth_max]
  ~<.spw/patterns/literate-architecture.spw>  // nearest neighbor
}
