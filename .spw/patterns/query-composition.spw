# Query Composition Pattern
#
# Composed query pipeline for deep multi-file exploration.

#>spw_pattern_query_composition
#:pattern #!query
#:layer #!pragmatics

^"pipeline"{
  from: "select roots and adjacency surfaces"
  select: "choose fields to surface (file/kind/root/target/line/text)"
  where: "filter by sigil, kind, root, label, or text containment"
  probe: "apply sequence probe to estimate priming and realization"
  consequence: "record findings for replay and tuning"
}

^"sql_css_blend"{
  css: "scoped selector intuition for structure and adjacency"
  sql: "projection/filter composition over rows"
  spw: "operator + brace + label semantics as first-class query dimensions"
}

^"example"{
  command: "npm run spw -- query --from .spw,docs --selector navigable --where \"kind in PathRef|Reference,root=spw\" --select file,kind,root,target,line,column --summary"
  followup: "npm run spw -- ls --seq '?~@&*^' --probe '?(topic).[' --root .spw,docs --equiv soft --mode hybrid"
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
