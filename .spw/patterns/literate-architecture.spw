# Literate Architecture Pattern
#
# Pattern for layering concept, frame, body, and projection ownership.

#>spw_pattern_literate_architecture
#:pattern #!literate

^"module_shape"{
  manifest: "index and workspace references that expose ownership"
  scene: "operator sequence or intent context for why this module exists"
  frame: "containerized relation map with explicit roots/links"
  body: "materialized artifact or generated projection surface"
  consequence: "measured effect stored in consequence and harness surfaces"
}

^"projection_contract"{
  source: "canonical manifests + registries + pattern files"
  generated: ".spw/gen/* projection bodies"
  trace: ".spw/biome/ocean/trace.spw and harness run/probe records"
  rollback: "replay from snapshot + refs to rematerialize prior body state"
}

^"file_composition"{
  recommended: [
    "index.spw (entry)",
    "workspace.spw (contracts)",
    "conventions/*.spw (rules)",
    "patterns/*.spw (recipes)",
    "literate/architecture/*.spw (exhibits + templates)",
  ]
}

