# Literate Architecture Pattern
#
# Pattern for layering concept, frame, body, and projection ownership.

#>spw_pattern_literate_architecture
#:pattern #!literate
#:layer #!pragmatics

^"module_shape"{
 manifest: "index and workspace references that expose ownership"
 scene: "operator sequence or intent context for why this module exists"
 frame: "containerized relation map with explicit roots/links"
 body: "materialized artifact or generated projection surface"
 consequence: "measured effect stored in consequence and harness surfaces"
}

^"projection_contract"{
 source: "canonical manifests + registries + pattern files"
 generated: ".spw/gen/* projection bodies"
 trace: ".spw/biome/ocean/trace.spw and harness run/probe records"
 rollback: "replay from snapshot + refs to rematerialize prior body state"
}

^"file_composition"{
 recommended: [
 "index.spw (entry)",
 "workspace.spw (contracts)",
 "conventions/*.spw (rules)",
 "patterns/*.spw (recipes)",
 "literate/architecture/*.spw (exhibits + templates)",
 ]
}

^"ui_projection"{
 ~#claim: "a module's body stage has a UI projection — the literate-ui pattern governs how module shapes surface as navigable, queryable components"
 ~#pattern: ~"./literate-ui.spw"
 ~#mapping: "manifest → navigation root, scene → phase indicator, frame → expandable snippet, body → rendered component, consequence → measure gauge"
}

#>wonder_spw_patterns_literatearchitecture_1
?["What is the ecological temperature of reading Literate Architecture Pattern?"]{
  #:depth #!experiential // lens: ecological zone
  $%[line.operator_density, brace.nesting_rhythm] => ~#reading_feel
  ~#structure: "module_shape → projection_contract → file_composition" // frame flow
  !probe{ "read aloud for 30 seconds; where do you pause? pauses mark biome edges." }
}

#>wonder_spw_patterns_literatearchitecture_2
?["What concept is conspicuously absent from Literate Architecture Pattern?"]{
  #:depth #!computational // lens: molecular binding
  ~#present: [#pattern, #literate, #educational]
  ~#expected_but_missing: "?" // the reader fills this gap
  !probe{ "list what IS annotated; list what sibling files annotate; the difference is this file's blind spot or intentional boundary." }
  $%[file.frame_count, file.annotation_density, file.brace_depth_max]
  ~<".spw/patterns/index.spw"> ~#neighbor(nearest)
}
