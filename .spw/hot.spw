# Hot
#
# Workspace hot-interpretation convention.

#>spw_hot
#:convention #!runtime

^"owner"{
  source: @biome/query/hot.spw
  projections: @gen/index.spw
  trace: @biome/trace.spw
}

^"policy"{
  "hot tier may replace selector ids at interpretation time",
  "all replacements must be traceable to original selector ids",
  "hot projections are generated surfaces, not hand-edited",
}
