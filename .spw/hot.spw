# Hot
#
# Workspace hot-interpretation convention.

#>spw_hot
#:convention #!runtime
#:layer #!pragmatics

^"owner"{
 source: @biome/query/hot.spw
 projections: @gen/index.spw
 trace: @biome/trace.spw
}

^"policy"{
 "hot tier may replace selector ids at interpretation time",
 "all replacements must be traceable to original selector ids",
 "hot projections are generated surfaces, not hand-edited",
}

#>wonder_spw_hot_1
?["How does this file's voice differ from .spw/hot (.spw/hot)?"]{
  #:depth #!educational // lens: molecular binding
  ~<@biome> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]@biome
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}

#>wonder_spw_hot_2
?["What invariant holds across every frame in Hot?"]{
  #:depth #!experiential // lens: ecological zone
  $^["_"]@here => %[shared.property]
  ~#hypothesis: "all frames in this file share ____"
  !probe{ "extract the property common to owner's frames; if none exists, the file may lack cohesion or may be a deliberate collection." }
  $%[runtime.stage, runtime.queue_depth]
  ~<.spw/agents.spw>  // nearest neighbor
}
