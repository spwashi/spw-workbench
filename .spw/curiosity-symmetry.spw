# Curiosity Symmetry
#
# Native symmetry as a first-class data-structure mechanic.

#>spw_curiosity_symmetry
#:symmetry #!creative

^seed[Curiosity.Symmetry v:0.1 @profile:Spw.x~#[ops.register_frames,ops.probe,ops.matrix,ops.symmetry,phrase.inline,surface.hash] @intent:creative-ergonomic-composable]
.curiosity.symmetry {
  creative.syntax: ":inline + glyph probes + backtick phrases + symmetry facets"
  ergonomic.inspection: "x:?  or  ?@x  or  x?<inspect> — instant register lens"
  composable.curiosity: "?<> chaining + & confluence + ?# resonance"
  symmetry.mechanic: "any frame .{sym:D4} or #[D4] auto-applies dihedral group (rotations/reflections) as native data actions — mirrored updates preserved in register bank"
  example: "shape .{symmetry:D4} ?<rotate 90> → auto-reflects across axes"
}
