# Observable State
#
# Live metrics bound to $%[metric] hover values.
# The LSP reads this file on save and surfaces values in hover popups.

#>spw_observable_state
#:manifest #!metrics
#:layer #!pragmatics

^"cache"{
  .. %[hit_ratio]   null
  .. %[tier]        "warm"
}

^"convention"{
  .. %[adherence_score]  null
}

^"file"{
  .. %[annotation_density]  null
  .. %[brace_depth_max]     null
  .. %[frame_count]         null
}

^"harness"{
  .. %[pass_rate]   null
  .. %[run_count]   0
}

^"lock"{
  .. %[active_count]  0
}

^"lsp"{
  .. %[avg_response_ms]  null
  .. %[request_count]    0
}

^"phase"{
  .. %[index]  0
}

^"registry"{
  .. %[entry_count]     null
  .. %[referrer_count]  null
}

^"runtime"{
  .. %[stage]  "idle"
}

^"wonder"{
  .. %[total]         447
  .. %[unique_ratio]  0.987
}

^"_meta"{
  schema:          "spw.observable.v1"
  updated_at:      null
  updated_by:      null
  refresh_policy:  "on-save"
  ~"../agent-surface.spw#defaults"
}
