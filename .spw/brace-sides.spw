# Brace Sides
#
# Native left/right side selection on brace containers.

#>spw_brace_sides
#:brace #!selection

^seed[Brace.Sides.Select v:0.1 @profile:Spw.x~#[ops.register_frames,ops.probe,ops.matrix,ops.symmetry,ops.brace.sides,phrase.inline,surface.hash] @intent:select-intrinsic-extrinsic-keyvalue-chains]
.brace.sides {
  left: "intrinsic (inside brace) or extrinsic (?<left> / :left) — bound to opening brace"
  right: "value side — bound to closing brace"
  intrinsic: "payload native to frame (e.g. .{left:data})"
  extrinsic: "attached via probe or inline (data?left or data: left)"
  key.value: ":{key:left | value:right} — : splits sides"
  chains: "a.b.c.left propagates left-side selection; .right for value emergence"
  ergonomic: "x.left or x?left or x: left — auto-selects + symmetry mirrors"
  symmetry.tie: "under ops.symmetry any .left auto-reflects to .right (D4 preserved)"
}
