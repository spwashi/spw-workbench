# Probe Archive Index
#
# Archive of completed probes grouped by loop and theme.

#>spw_probe_archive
#:layer #!pragmatics

^"active"{
  ~#notes: "Probes listed here are declared/active/filled but not yet archived."
  probes: ["p001-current-at-observe"]
}

^"archive"{
  entries: [
    {
      probe_id: "p000-seed"
      archived_at: "2026-02-27T00:00:00Z"
      loop_phase: "^"
      beat_scale: "macro"
      summary: "Seed archive entry to validate lifecycle wiring."
      source: ".spw/harness/probes/probe-loop.spw"
    },
  ]
}

^"clustering"{
  ~#keys: ["loop_phase", "operator_focus", "lens_profile", "measure"]
  ~#goal: "Surface concept clusters from archived probes."
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
