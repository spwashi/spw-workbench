# Probe Archive Index
#
# Archive of completed probes grouped by loop and theme.

#>spw_probe_archive
#:layer #!pragmatics

^"active"{
  ~#notes: "Probes listed here are declared/active/filled but not yet archived."
  probes: ["p001-current-at-observe"]
}

^"archive"{
  entries: [
    {
      probe_id: "p000-seed"
      archived_at: "2026-02-27T00:00:00Z"
      loop_phase: "^"
      beat_scale: "macro"
      summary: "Seed archive entry to validate lifecycle wiring."
      source: ".spw/harness/probes/probe-loop.spw"
    },
  ]
}

^"clustering"{
  ~#keys: ["loop_phase", "operator_focus", "lens_profile", "measure"]
  ~#goal: "Surface concept clusters from archived probes."
}

?["How does this convention shape the developer's experience?"]
  #:scope #!file
  ~#probe: "trace which workflows or tooling reference this surface"

