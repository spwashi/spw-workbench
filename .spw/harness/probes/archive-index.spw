# Probe Archive Index
#
# Archive of completed probes grouped by loop and theme.

#>spw_probe_archive
#:layer #!pragmatics

^"active"{
 ~#notes: "Probes listed here are declared/active/filled but not yet archived."
 probes: ["p001-current-at-observe"]
}

^"archive"{
 entries: [
 {
 probe_id: "p000-seed"
 archived_at: "2026-02-27T00:00:00Z"
 loop_phase: "^"
 beat_scale: "macro"
 summary: "Seed archive entry to validate lifecycle wiring."
 source: ".spw/harness/probes/probe-loop.spw"
 },
 ]
}

^"clustering"{
 ~#keys: ["loop_phase", "operator_focus", "lens_profile", "measure"]
 ~#goal: "Surface concept clusters from archived probes."
}

#>wonder_spw_harness_probes_archiveindex_1
?["What invariant holds across every frame in Probe Archive Index?"]{
  #:depth #!computational // lens: ecological zone
  $^["_"]@here => %[shared.property]
  ~#hypothesis: "all frames in this file share ____"
  !probe{ "extract the property common to active's frames; if none exists, the file may lack cohesion or may be a deliberate collection." }
  $%[harness.run_count, harness.pass_rate]
}

#>wonder_spw_harness_probes_archiveindex_2
?["What was Probe Archive Index before it was this, and what could it become?"]{
  #:depth #!mathematical // lens: molecular binding
  ~#past: "git log --oneline -- .spw/harness/probes/archive-index.spw | head -3"
  ~#future: "what frame would you add next?"
  !probe{ "the file's git history IS its evolutionary record; the next natural frame reveals the author's trajectory." }
  $%[harness.run_count, harness.pass_rate]
  ~<.spw/harness/probes/probe-loop.spw>  // nearest neighbor
}
