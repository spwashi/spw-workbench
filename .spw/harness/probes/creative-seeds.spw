# Creative Seeds
# Optional prompts to make the next question less predictable and more useful.
#>agent_creative_seeds
#:layer #!pragmatics

^["roots"]{
 @route: ~"../../process/agent-development.spw"
 @geometry: ~"../../../.agents/plans/geometric-analysis-tooling/PLAN.md"
 @relationships: ~"../../../.agents/plans/relationship-contours/PLAN.md"
 @measure: ~"../../../.agents/plans/measure-invariant-generalization/PLAN.md"
 @forms: ~"../../../.agents/plans/form-geometry-editor/PLAN.md"
 @contours: ~"../../../docs/theory/spw/form-contours.spw"
 @bridge: ~"../../../lib/spw-v0.3.0/architecture/theory-bridge.spw"
 @runs: ~"../runs/runs-index.spw"
 @cognition: ~"../../tooling/cognitive-surfaces.spw"
 @ir: ~"../../../.agents/plans/precipitate-model-alignment/PLAN.md"
 @cache: ~"../../../.agents/plans/apposition-cache-granules/PLAN.md"
}

^["invitation"]{
 status: "declared; these experiments have not been run"
 use: "Pick one seed, alter it or leave it. First sketch the surprising possibility; then name the smallest example that could teach whether it works."
 permission: "These prompts propose work; they do not grant mutation or publication authority."
 memory: "Keep the interesting failure as well as the successful form. Append an actual run before promoting a proposed result to measured."
}

#>seed_counterexample_cabinet
?["What is the smallest specimen that makes our favorite explanation fail?"]{
 owner: @geometry
 companion: @measure
 hypothesis: "A contrast between two nearly identical specimens exposes an assumption hidden by corpus averages."
 sample: "Start with one real operator and sigils inside a quoted string; then vary comments, malformed input and Unicode one at a time."
 control: "Keep the real operator unchanged; record parse health separately from the count."
 make: "A small cabinet of source, expected distinction, observed result and the claim it challenges."
 reject: "If the explanation cannot distinguish data from operators, refuse the explanatory lesson even when the report is visually persuasive."
 next: "Pin one useful counterexample in the owner's regression suite; do not generate a large corpus before it earns its role."
}

#>seed_silence_lens
?["Can removing half the explanation reveal the next action more clearly?"]{
 owner: @relationships
 hypothesis: "A view organized around one question can reduce reading effort while preserving decision-relevant evidence."
 sample: "Use one plan card and two disclosures: full and reduced under a named policy. Preserve a failed expectation in both."
 control: "Same question, source revision and answer key; counterbalance view order in repeated human trials. Do not infer understanding from text length."
 make: "A compact door with an omission receipt and a route back to the full evidence."
 reject: "An incorrect next action, hidden failure or unresolvable omitted evidence defeats the reduction, regardless of brevity."
 next: "Run a door trial; retain measured effort separately from reported preference."
}

#>seed_domain_graft
?["What does a garden, a score or a workshop notice that the compiler vocabulary misses?"]{
 owner: @relationships
 theory: @bridge
 hypothesis: "A domain translation can suggest a useful question that the original vocabulary did not make salient."
 sample: "Translate one register or form example into a chosen domain, then translate it back with a mapping table. Name the point where the analogy breaks."
 control: "Tokens, AST, source identity and execution remain unchanged; the translation is an interpretive profile."
 make: "One new question plus a small exhibit that makes its value inspectable."
 reject: "If the only result is renamed nouns, retain it as a playful sketch rather than a language law or product requirement."
 next: "Route the surviving question to an existing owner; keep conflicting interpretations visible."
}

#>seed_reversible_postcard
?["How little context can travel while still letting the next reader recover what matters?"]{
 owner: @forms
 theory: @contours
 hypothesis: "A compact context packet with explicit omissions and source-backed expansion can preserve the next editing decision across readers."
 sample: "Take one caret-local form packet; reduce it, retain a failed expectation, and restore it from the receipt."
 control: "Same source revision, caret and task; compare restored input signature, decision correctness and disclosed omissions."
 make: "A postcard containing the question, source identity, visible evidence, omissions and expansion route."
 reject: "A guessed missing field, changed source revision or unsafe edit candidate invalidates the handoff."
 next: "Use the existing form/contour kernels; do not invent another parser or a new semantic identity."
}

#>seed_ir_journey
?["Where did this idea change on its way from source to value?"]{
 owner: @ir
 design: @cognition
 hypothesis: "Comparing intermediate products reveals a lost distinction that the final value conceals."
 sample: "Trace one labeled construct through source, parse output, ONF and value, then inspect a failure or unavailable stage."
 control: "Keep source revision and profile fixed; separate an actual mapping from a reader's analogy."
 make: "One annotated journey with stage products, missing links and a question for the theory owner."
 reject: "If a mapping is guessed, mark it interpretive; if the products cannot answer the question, name the missing instrument."
}

#>seed_memory_weather
?["What does memory keep warm, and what does that warmth hide?"]{
 owner: @cache
 design: @cognition
 hypothesis: "A retained-product difference makes an invalidation decision explainable without forcing the reader to reconstruct the cache implementation."
 sample: "Cold, warm, sibling edit, target edit and eviction for one document/query."
 control: "Compare semantic answers against cold recomputation; permit declared volatile fields to differ; record any observer effect."
 make: "A small memory weather report: retained, invalidated, recomputed, unknown; each reason points to evidence."
 reject: "A heat or age metaphor that implies validity without identity evidence is rejected as explanation."
}
