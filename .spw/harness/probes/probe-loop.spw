# Probe Loop
#
# Measurement probes are declared first, filled during loops, then archived.

#>spw_probe_loop
#:harness #!measurement
#:layer #!pragmatics

^"intent"{
 ~#goal: "Operationalize observations as measurable probes."
 ~#metaphor: "Operators act like windmills/current probes in a semantic flow field."
}

^"templates"{
 probe_template: {
 probe_id: "string"
 status: "declared|active|filled|archived"
 loop_phase: "?~|@|&|*|^"
 beat_scale: "micro|meso|macro"
 beat_unit: "event|phase|episode"
 operator_focus: "?, ~, @, &, *, ^"
 lens_profile: "focal_depth/aperture/magnification/aberration"
 measure: "what is sampled"
 aggregate_rule: "how repeated beats roll up into one measure value"
 source_refs: ["refs to files/fields"]
 fill_rule: "when and how values are recorded"
 archive_target: ".spw/harness/probes/archive-index.spw"
 }
}

^"examples"{
 p001: {
 probe_id: "p001-current-at-observe"
 status: "declared"
 loop_phase: "@"
 beat_scale: "meso"
 beat_unit: "phase"
 operator_focus: "@"
 lens_profile: "focal_depth=2 aperture=medium magnification=high aberration=low"
 measure: "count of stable refs resolved per observe cycle"
 aggregate_rule: "sum resolved refs per @ phase, then normalize by context ref count"
 source_refs: [".spw/workspace.spw#lsp", ".spw/process/loop-observation.spw#projection_refs"]
 fill_rule: "fill at end of each @ phase batch"
 archive_target: ".spw/harness/probes/archive-index.spw"
 }
}

^"archive_rule"{
 ~#trigger: "when status transitions to filled"
 ~#action: "append entry into archive-index and mark probe archived"

 %[observer_effect]{
 "each probe fill increments the target cell's measureDepth",
 "deep measureDepth signals heavy observation — candidate for caching",
 "probe results are warm-tier cached until the next fill cycle",
 }

 =probe_window: 10
}

?["What is the ecological temperature of reading Probe Loop?"]
 #:depth #!experiential // lens: ecological zone
 $%[line.operator_density, brace.nesting_rhythm] => ~#reading_feel
 ~#structure: "intent → templates →
 beat_scale: " // frame flow
 !probe{ "read aloud for 30 seconds; where do you pause? pauses mark biome edges." }

#>wonder_spw_harness_probes_probeloop_1
?["What concept is conspicuously absent from Probe Loop?"]{
  #:depth #!computational // lens: molecular binding
  ~#present: [#harness, #measurement, #experiential]
  ~#expected_but_missing: "?" // the reader fills this gap
  !probe{ "list what IS annotated; list what sibling files annotate; the difference is this file's blind spot or intentional boundary." }
  $%[harness.run_count, harness.pass_rate]
}
