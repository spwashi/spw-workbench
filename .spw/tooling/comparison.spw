# Tooling Comparison
#
# Evidence-oriented comparison of Spw editor projections.

#>spw_tooling_comparison
#:tooling #!editor
#:layer #!pragmatics

^["comparison_rule"]{
 compare: [#author_task, #owning_layer, #advertised, #observed, #failure_behavior, #interruption_cost]
 avoid: [#feature_parity_score, #editor_rank, #implementation_folklore]
 source: ~"./editor-surface-audit.spw"
}

^["shared_semantic_surface"]{
 owner: #lsp
 tasks: [#diagnose, #hover, #navigate, #reference, #rename, #complete, #format, #fold, #symbol, #code_action, #inlay_hint]
 rule: "A client may project shared semantics differently but does not redefine them."
}

^["client_projection"]{
 vscode: .{
  native: [#textmate, #snippets, #tree_views, #status, #quick_pick]
  custom_protocol: #typed_spw_requests
  audit_focus: [#mounted_startup, #view_utility, #refresh_cost, #accessible_feedback]
 }
 intellij: .{
  native: [#textmate, #structure_view, #folding, #gutter, #settings]
  custom_protocol: #not_yet_exposed
  audit_focus: [#mounted_startup, #claim_dialect, #navigation, #compatibility_evidence]
 }
 neovim: .{
  native: [#syntax, #commands, #keymaps, #quickfix, #foldexpr, #inlay_hints]
  custom_protocol: #not_yet_exposed
  audit_focus: [#mounted_startup, #root_discovery, #graceful_degradation, #request_cost]
 }
}

^["invariants"]{
 "Differences are evidence, not deficits to erase.",
 "A capability is current only when configured, invoked, and observed in an identity-free mounted fixture.",
 "Shared semantic truth stays in seed/LSP layers; client-native affordances remain client-owned.",
}
