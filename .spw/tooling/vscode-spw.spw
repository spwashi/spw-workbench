# Tooling VSCode
#
# Register of native Spw plugins and language features for VS Code.

#>spw_tooling_vscode
#:tooling #!editor
#:layer #!pragmatics

^seed[Tooling.VSCode v:0.3.2 @profile:Spw.b @intent:editor-support]
.tooling.vscode {
 extension.name: "spw-language"
 lsp.server: "packages/spw-lsp/src/stdio-server.ts"
 lsp.transport: "stdio"
 lsp.version: "0.3.2"
}

^"capabilities" {
 completion: "4-stage: @-root, annotation, sigil snippets ($=^!?~&#%*.), file-system paths; phase-aware ranking follows spirit sequence (see literate-ui pattern)"
 hover: "annotation metadata, @-root resolution, path peek, sigil semantics, materialization state"
 definition: "go-to-definition for ~\"path\" and @root/path references"
 references: "workspace-wide annotation and path reference search"
 rename: "workspace-wide rename for annotations, @roots, and frame names"
 document_links: "clickable navigation for all path references"
 symbols: "document symbols (frames, anchors, headings) + workspace symbols"
 code_lens: "metrics on anchors (reference count, usage)"
 inlay_hints: "path resolution, brace depth, operator census"
 diagnostics: "parse errors, broken refs, stale projections, brace physics, runtime"
 folding: "brace-depth, block comments, consecutive hash comments"
 formatting: "full-document formatting"
 code_actions: "trait/binding toggle, wrap-in-frame"
 snippets: "14 VS Code snippets (frame, seed, wonder, anchor, lens, trait, etc.); snippet economy governed by literate-ui pattern"
}

^"client_features" {
 semantic_tokens: "sigil + operator highlighting via SemanticTokensProvider"
 concepts_tree: "annotation-based sidebar panel (Spw Explorer)"
 color_scheme: "gruvbox-aligned palette (70+ TextMate scope rules)"
 on_enter_rules: "# and // comment continuation"
}

^"invariant" {
 "LSP server spawned per workspace via stdio, not shared across workspaces",
 "VS Code extension activates on .spw file open (auto-detected from contributions)",
 "Snippet contributions complement LSP completions; both available simultaneously",
}
