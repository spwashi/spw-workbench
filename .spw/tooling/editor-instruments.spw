# Editor Instruments

#>spw_tooling_editor_instruments
#:tooling #!editor
#:layer #!pragmatics

^["posture"]{
 contract: "One recognizable question set across VS Code, IntelliJ/WebStorm, and Neovim; each host keeps native presentation and cancellation behavior."
 semantic_owner: [#spw_seed, #spw_lsp, #spw_cli]
 projections: [#vscode, #intellij, #webstorm, #neovim]
 explicit_only: true
 idle_probe_traffic: 0
}

^["instrument_set"]{
 form: .{ cli = "spw form <surface>", live = "spw/geometry", asks = #brace_geometry_and_resonance, effect = #l0_measure }[reg=facet]
 stack: .{ cli = "spw stack <surface>", live = "spw/surfaceProfile", asks = #surface_profile, effect = #l0_measure }[reg=facet]
 cache: .{ cli = "spw inspect cache <surface>", live = "spw/cacheReflection", asks = #cache_state_and_cost, effect = #l0_measure }[reg=facet]
 rename: .{ protocol = #text_document_rename, asks = #caret_symbol_change, effect = #l2_workspace_edit }[reg=facet]
 refactor_plan: .{ cli = "spw refactor . --rename <kind:from=to> --json", asks = #corpus_change_preview, effect = #l0_plan }[reg=facet]
 sequence: "form → stack → cache → rename → refactor plan"
}

^["host_contours"]{
 vscode: .{
  strengths = [#guided_command_palette, #quick_pick, #side_by_side_live_preview, #inspectable_ttl_cache]
  creative_loop = "keep source visible while comparing live form and stack projections; use guided corpus-name prompts when a local idea wants broader consequence"
 }[reg=facet]
 intellij_webstorm: .{
  strengths = [#native_action_system, #structure_view, #folding, #typed_read_only_preview]
  creative_loop = "move between structural outline and reusable saved-file products; keep semantic rename inside the host refactoring gesture"
 }[reg=facet]
 neovim: .{
  strengths = [#terse_commands, #keyboard_composition, #scratch_split, #scriptable_arguments]
  creative_loop = "move quickly through Form → Stack → Cache, keep results in ordinary buffers, and compose plan specs without panel ceremony"
 }[reg=facet]
 rule: "Preserve common questions and evidence fields; let interaction rhythm differ enough to reveal what each substrate teaches about Spw."
}

^["routing"]{
 live_document: "VS Code and Neovim use the shared LSP so unsaved text participates."
 saved_document: "IntelliJ uses parameterized CLI forms and refuses dirty-buffer ambiguity with save-and-retry copy."
 corpus: "All editor corpus planning invokes the canonical CLI without --write."
 mounted_consumer: .{
  executable = "npm --prefix <tool-root> run --silent spw -- ..."
  process_cwd = #consumer_root
  input_identity = #consumer_relative_path
 }[reg=facet]
}

^["receipts"]{
 common: [#question, #source, #scope, #duration_when_measured, #exit_state, #effect]
 cache_layers: [#editor_probe_cache, #lsp_session_reflection, #runtime_cache]
 rule: "Name the cache layer; do not flatten distinct caches into one hit/miss claim."
 vscode: "The editor-local TTL cache reports entries, TTL, hits, misses, expirations, disabled reads, writes, and clears."
 neovim: "No additional probe cache; cache inspection identifies LSP session reflection."
 intellij: "Saved-file CLI cache JSON stays reusable as a read-only intermediate document."
}

^["refactoring"]{
 caret: "Standard LSP prepareRename/rename owns semantic edits and workspace edit previews."
 corpus: "The editor accepts mark|anchor|case|mood:from=to and opens the CLI plan as JSON."
 forbidden: [#implicit_write, #shell_interpolation, #editor_specific_rewrite_engine]
 future: ~"../../.agents/plans/refactor-experiment-lifecycle/PLAN.md"
}

^["privacy_and_authority"]{
 output: #local_only
 inference: #surface_and_process_not_person
 authority_effect: #none
 consumer_rule: "The mounted workbench supplies versioned instruments; the consumer repository owns document and corpus identity."
}

^["evidence"]{
 plan: ~"../../.agents/plans/editor-cli-instruments/PLAN.md"
 audit: ~"./editor-surface-audit.spw"
 tests: [#kotlin_invocation, #vscode_probe_cache, #neovim_headless_smoke]
 recovery: [#missing_npm_script, #missing_mount, #dirty_buffer, #cancelled_process, #nonzero_exit]
}

^["invariants"]{
 "Editor labels may mirror CLI vocabulary without implying that every host executes the same transport.",
 "A live LSP probe and a saved-file CLI probe may share a question while retaining distinct provenance.",
 "Corpus refactor planning never adds --write; application remains a separate, reviewable act.",
 "Instrumentation is invoked by a person and does not run on cursor motion or hidden-panel refresh.",
 "Cross-editor resonance preserves host contour; it does not manufacture panel parity.",
}
