# Cognitive Surfaces — IR and Memory
#>cognitive_surfaces
#:layer #!pragmatics
#:status #!proposed

^["roots"]{
 @disclosure: ~"../../docs/theory/spw/representational-disclosure.spw"
 @contours: ~"../../docs/theory/spw/form-contours.spw"
 @pipeline: ~"../runtime/precipitates.spw"
 @memory: ~"../harness/memory-surface.spw"
 @ir_owner: ~"../../.agents/plans/precipitate-model-alignment/PLAN.md"
 @cache_owner: ~"../../.agents/plans/apposition-cache-granules/PLAN.md"
 @reader_owner: ~"../../.agents/plans/relationship-contours/PLAN.md"
 @form_owner: ~"../../.agents/plans/form-geometry-editor/PLAN.md"
 @seeds: ~"../harness/probes/creative-seeds.spw"
}

^["direction"]{
 intent: "The owner is open to redesigning cognitive surfaces and exploring IR and memory insights. Begin with questions and observable products, then choose the interface."
 status: "proposed design and trial; no new UI or telemetry is implemented here"
 questions: ["Where did this result come from?", "What changed between stages?", "What was omitted?", "Why was this remembered?", "What would invalidate it?", "What action is justified now?"]
 constraint: "A view distinguishes known facts, derived summaries and interpretation. Unknown fields remain unknown."
}

^["ir_journey"]{
 owner: @ir_owner
 available: "Precipitate carries stage, at, input, output and delta; interpretation includes registersAfter. Parse output is ParseOutput; normalization receives its AST root."
 execution_boundary: "The stage receipt records ONF, while interpretation currently re-normalizes the AST. Distinguish a recorded product from an execution input witness."
 candidate: "Artifact passport: source revision and profile, producer/schema when known, input/output references, stage outcome, omitted information and next inspection action."
 compare: "Follow one source construct through desugared text, parse result, ONF and value; do not claim a one-to-one mapping unless a source-map witness exists."
 failure: "A stage that did not run has no successful product; display absent, skipped, failed or unavailable according to evidence."
 question: "Does the passport help a reader locate the first meaningful divergence more accurately than the current dump?"
}

^["memory_domains"]{
 harness: "Selected context and run receipts; optimize retrieval and resumption, disclose omissions and unavailable referenced revisions."
 lsp: "Derived document products; validity depends on content and producer/profile/dependency identity, not attention or age alone."
 runtime: "Register values and metadata plus session caches; evaluation and measurement may have observable effects."
 boundary: "These memories have different owners, lifetimes and effects. A common view does not make them one store or one truth score."
}

^["memory_difference"]{
 owner: @cache_owner
 candidate: "A before/after view of retained, invalidated and recomputed products, with reason when instrumentation provides one."
 experiment: "Hold source/profile/query fixed for cold and warm reads, then change a sibling, change the target, and evict the document. Compare semantic answers with cold recomputation."
 exclude: "Do not require timestamps, recency or hit counters to be equal; declare which fields are identity, answer and volatile bookkeeping."
 observation: "Use non-touching snapshots where available. If inspection changes recency or measureDepth, show that effect rather than pretending the act was passive."
 question: "Can a reader explain a stale answer or unexpected recomputation from the evidence shown?"
}

^["design_trials"]{
 variants: ["current dump", "artifact passport", "memory-difference view", "reversible context postcard"]
 tasks: ["locate an IR divergence", "explain invalidation", "recover omitted counterevidence", "resume the correct next action"]
 retain: "same fixture/revision/task, starting context, shown fields, correctness, fallbacks, measured effort and separately reported preference"
 selection: "Keep a redesign only when the trial reveals a useful advantage or a clearly stated preference without losing required evidence."
 stop: "One bounded comparison precedes a new pane or permanent default. Do not claim a human usability result from an agent's walkthrough."
}
