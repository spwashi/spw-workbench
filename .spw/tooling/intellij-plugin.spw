# Tooling IntelliJ
#
# Register of native Spw plugins and language features for IntelliJ.

#>spw_tooling_intellij
#:tooling #!editor
#:layer #!pragmatics

^seed[Tooling.IntelliJ v:0.1 @profile:Spw.b @intent:editor-support]
.tooling.intellij {
 folding: "SpwFoldingBuilder.kt — supports ^['frame'], ^[\"frame\"], ^\"frame\", ^type[…] with optional ^[Label] facets"
 structure.view: "SpwStructureViewFactory.kt — ^['name']/^[\"name\"]/^\"name\"/^type[…], #>anchor, # Heading"
 live.templates: "frame/intent/anno/subroot/prop"
 color.settings: "SpwColorSettingsPage.kt — full TextMate scope demo"
 line.markers: "SpwAnnotationLineMarkerProvider.kt — gutter icons on #>anchor and frame declarations"
}

#>wonder_spw_tooling_intellijplugin_1
?["What invariant holds across every frame in Tooling IntelliJ?"]{
  #:depth #!computational // lens: living system
  $^["_"]@here => %[shared.property]
  ~#hypothesis: "all frames in this file share ____"
  !probe{ "extract the property common to Tooling.IntelliJ v:0.1 @profile:Spw.b @intent:editor-support's frames; if none exists, the file may lack cohesion or may be a deliberate collection." }
  $%[tool.invocation_count, tool.response_p95_ms]
}

#>wonder_spw_tooling_intellijplugin_2
?["What was Tooling IntelliJ before it was this, and what could it become?"]{
  #:depth #!mathematical // lens: curated collection
  ~#past: "git log --oneline -- .spw/tooling/intellij-plugin.spw | head -3"
  ~#future: "what frame would you add next?"
  !probe{ "the file's git history IS its evolutionary record; the next natural frame reveals the author's trajectory." }
  $%[tool.invocation_count, tool.response_p95_ms]
  ~<.spw/tooling/comparison.spw>  // nearest neighbor
}
