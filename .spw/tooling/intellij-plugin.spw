# Tooling IntelliJ

#>spw_tooling_intellij
#:tooling #!editor
#:layer #!pragmatics

^["posture"]{
 client: #native_intellij_plugin
 syntax_fallback: #textmate
 semantic_owner: #lsp
 startup: "configurable command and working directory; mounted-workbench discovery remains an audit and implementation lane"
 custom_requests: #not_exposed_by_current_native_client
}

^["native_features"]{
 file_type: [#extension, #icon, #commenter, #spellcheck]
 structure: [#frame, #anchor, #heading, #claim_candidate]
 presentation: [#folding, #color_settings, #live_templates, #gutter_markers]
 configuration: [#lsp_command, #working_directory, #preflight_diagnostics]
}

^["audit_focus"]{
 capability_truth: [#plugin_registration, #lsp_initialize, #observed_result]
 mount: [#consumer_root, #workbench_root, #relative_server_resolution, #failure_copy]
 claims: [#shared_dialect, #declaration, #reference_chain, #navigation]
 compatibility: [#declared_build_range, #tested_platform, #degraded_behavior]
 evidence_contract: ~"./editor-surface-audit.spw"
}

^["invariants"]{
 "TextMate and native UI provide syntax and projection; the shared LSP owns semantic meaning.",
 "A gutter marker is not navigation unless it exposes a working target action.",
 "Platform compatibility copy stays narrower than the tested matrix.",
 "LSP client migration requires repeated utility evidence, not parity pressure.",
}
