# Tooling IntelliJ
#
# Register of native Spw plugins and language features for IntelliJ.

#>spw_tooling_intellij
#:tooling #!editor
#:layer #!pragmatics

^seed[Tooling.IntelliJ v:0.1 @profile:Spw.b @intent:editor-support]
.tooling.intellij {
  folding: "SpwFoldingBuilder.kt — supports ^['frame'], ^[\"frame\"], ^\"frame\", ^type[…] with optional ^[Label] facets"
  structure.view: "SpwStructureViewFactory.kt — ^['name']/^[\"name\"]/^\"name\"/^type[…], #>anchor, # Heading"
  live.templates: "frame/intent/anno/subroot/prop"
  color.settings: "SpwColorSettingsPage.kt — full TextMate scope demo"
  line.markers: "SpwAnnotationLineMarkerProvider.kt — gutter icons on #>anchor and frame declarations"
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
