# Tooling IntelliJ
#
# Register of native Spw plugins and language features for IntelliJ.

#>spw_tooling_intellij
#:tooling #!editor

^seed[Tooling.IntelliJ v:0.1 @profile:Spw.b @intent:editor-support]
.tooling.intellij {
  folding: "SpwFoldingBuilder.kt — regex ^[\"frame\"]{…} + ^subroot[…] + ^property[…] (brace-depth)"
  structure.view: "SpwStructureViewFactory.kt — ^\"name\", #>anchor, # Heading"
  live.templates: "frame/intent/anno/subroot/prop"
  color.settings: "SpwColorSettingsPage.kt — full TextMate scope demo"
  line.markers: "SpwAnnotationLineMarkerProvider.kt — gutter icons on #>anchor"
}
