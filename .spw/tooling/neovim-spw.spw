# Tooling NeoVim

#>spw_tooling_neovim
#:tooling #!editor
#:layer #!pragmatics

^["posture"]{
 client: #native_neovim_lsp
 syntax_fallback: #vim_syntax
 semantic_owner: #lsp
 dependency_posture: #builtins_first
 startup: "workspace-root command discovery exists; mounted-workbench resolution requires explicit audit"
}

^["current_features"]{
 filetype: [#detection, #comment_string, #folding, #suffix_resolution]
 lsp: [#diagnostics, #hover, #definition, #references, #rename, #formatting, #folding, #inlay_hints]
 navigation: [#open_reference, #peek_reference, #anchor_jump, #unresolved_quickfix, #tilde_quoted_path, #tilde_angle_path_compat, #root_path]
 control: [#restart, #stop, #toggle_inlay_hints, #code_action]
 commands: [#form, #stack, #cache, #rename, #refactor_plan, #operator_freq, #phase, #form_seq, #temperature, #insert_form_wrap]
 syntax: [#vim_syntax, #treesitter_queries]
}

^["instrument_projection"]{
 contract: ~"./editor-instruments.spw"
 contour: [#terse_commands, #keyboard_composition, #scratch_split, #scriptable_arguments]
 file_transport: #live_lsp_document
 cache: #lsp_session_reflection
 corpus_refactor: #plan_only_cli
 cli_override: #vim_g_spw_cli_root
}

^["earned_product"]{
 # Shared with VS Code via LSP — project, do not re-implement.
 status: #proposed
 plan: ~"../../.agents/plans/neovim-spw-surfaces/PLAN.md"
 roadmap: ~"../../.agents/plans/vscode-lsp-roadmap/PLAN.md"
 measure: ~"../../.agents/plans/measure-invariant-generalization/PLAN.md"
 slices: [
  "mass/authority/path diagnostics from spw-lsp (same codes as VS Code)",
  "exact-only mass fix via textDocument/codeAction",
  "cursor sites: %mass, !probe, wonder ?[], $%[metrics], plan wip open questions",
  ":SpwPlan thin context when URI under .agents/plans/<slug>/",
  "vim.g.spw_reading_profile = author|prompt|research|creative",
  "soft-fail phantom custom requests until protocol registry earns them",
 ]
 projections: .{
  diagnostics: "location list / [d ]d / float"
  code_actions: "<localleader>a and :SpwCodeAction"
  probes: ":SpwProbe when earned; else copy !probe text"
  status: "optional statusline helper — no required UI plugin"
 }
 anti_goals: [
  "VS Code Concepts/Atlas panel parity",
  "Lua re-parse of Spw for meaning",
  "hard dependency on telescope/nui",
 ]
}

^["audit_focus"]{
 root_discovery: [#consumer_root, #mount_manifest, #workbench_root]
 command_resolution: [#configured, #workspace_script, #mounted_server, #failure]
 interaction: [#keymap_collision, #quickfix_quality, #preview_lifecycle, #directory_creation]
 cost: [#cursor_hold, #request_rate, #fold_refresh]
 custom_requests: "earned only; demote wrappers that call unhandled spw/* methods"
 evidence_contract: ~"./editor-surface-audit.spw"
 author_tasks: [
  "open ~ path and @root from index.spw",
  "see mass drift without leaving the buffer",
  "act on wonder/probe sites",
  "orient inside a plan slug",
 ]
}

^["invariants"]{
 "Built-in Neovim affordances remain sufficient for the baseline client.",
 "Custom requests are added per demonstrated task, not as a panel-parity program.",
 "Configuration examples use placeholders or relative paths rather than machine-local locations.",
 "Measure truth is seed-owned; Neovim only projects LSP diagnostics and edits.",
 "Reading profiles change disclosure, not parse or reconcile truth.",
}
