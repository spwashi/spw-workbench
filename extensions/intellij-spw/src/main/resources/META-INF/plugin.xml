<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.spwashi.spw</id>
    <name>Spw Language Support</name>
    <vendor url="https://github.com/spwashi">spwashi</vendor>

    <description><![CDATA[
    Spw (Symbolic Processing Workbench) language support — operator physics, valence semantics, and structural containers.
    <br>
    Built against WebStorm 2024.2.1 and verified with WebStorm 2026.2.0.1 and 2026.2.1.
    Declared compatible with IntelliJ Platform builds 242 through 262.*.
    <br>
    <b>v0.3.0 features:</b>
    <ul>
      <li>Semantic TextMate highlighting — operators (<code>!</code>, <code>^</code>, <code>~</code>, <code>?</code>, <code>=</code>, <code>@</code>), valence modifiers (boon/bane/bone/bonk/honk), and container semantics</li>
      <li>File type support for <code>.spw</code> — architecture scaffolds, theory docs, wip streams</li>
      <li>Optional LSP integration (project or mounted-workbench discovery, with configurable command and working directory)</li>
      <li><b>Structure View</b> — navigable outline of frames, subroots, properties, anchors, and headings (Cmd+7)</li>
      <li><b>Code Folding</b> — fold <code>^["frame"]{}</code> blocks and <code># Heading</code> sections</li>
      <li><b>Live Templates</b> — <code>frame</code>, <code>intent</code>, <code>anno</code>, <code>subroot</code>, <code>prop</code>, <code>episode</code>, <code>stream</code> (type + Tab)</li>
      <li><b>Gutter Icons</b> — visual markers for <code>#&gt;anchor</code>, <code>^["frame"]</code>, and <code>^claim[...]</code> lines</li>
      <li><code>spwq</code> selector algebra — 15 presets for structural selection over AST</li>
      <li>@-root resolution — <code>@docs</code>, <code>@src</code>, <code>@lib</code>, <code>@theory</code>, <code>@scripts</code>, <code>@core</code>, <code>@runtime</code>, <code>@design</code>, <code>@infra</code>, <code>@here</code></li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>com.intellij.modules.spellchecker</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Spw"
                  implementationClass="com.spwashi.spw.SpwFileType"
                  fieldName="INSTANCE"
                  language="Spw"
                  extensions="spw"/>
        
        <platform.lsp.serverSupportProvider implementation="com.spwashi.spw.SpwLspServerSupportProvider"/>
        <notificationGroup id="Spw LSP" displayType="BALLOON"/>
        <projectConfigurable
            id="spw.lsp"
            groupId="tools"
            displayName="Spw LSP"
            instance="com.spwashi.spw.settings.SpwLspConfigurable"/>

        <!-- Native folding for ^["frame"]{} blocks and # headings -->
        <lang.foldingBuilder language="Spw"
                             implementationClass="com.spwashi.spw.SpwFoldingBuilder"/>

        <!-- Structure view (Cmd+7) -->
        <lang.psiStructureViewFactory language="Spw"
                                       implementationClass="com.spwashi.spw.SpwStructureViewFactory"/>

        <!-- Gutter icons for anchors and frames -->
        <codeInsight.lineMarkerProvider language="Spw"
                                         implementationClass="com.spwashi.spw.SpwAnnotationLineMarkerProvider"/>

        <!-- Live template context -->
        <liveTemplateContext implementation="com.spwashi.spw.SpwTemplateContext"/>
        <defaultLiveTemplates file="/liveTemplates/spwTemplates.xml"/>
        <!-- Cmd+/ toggle comment -->
        <lang.commenter language="Spw"
                        implementationClass="com.spwashi.spw.SpwCommenter"/>

        <spellchecker.support language="Spw" implementationClass="com.spwashi.spw.SpwSpellcheckingStrategy"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij.textmate">
        <bundleProvider implementation="com.spwashi.spw.SpwTextMateBundleProvider"/>
    </extensions>
</idea-plugin>
