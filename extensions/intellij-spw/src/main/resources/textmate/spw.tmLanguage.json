{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Spw",
    "scopeName": "source.spw",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#literals"
        },
        {
            "include": "#valences"
        },
        {
            "include": "#seeds"
        },
        {
            "include": "#projections"
        },
        {
            "include": "#vocab"
        },
        {
            "include": "#registers"
        },
        {
            "include": "#annotations"
        },
        {
            "include": "#wip-constructs"
        },
        {
            "include": "#sigils"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#containers"
        },
        {
            "include": "#punctuation"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.spw comment.line.double-slash",
                    "match": "//.*$"
                },
                {
                    "comment": "Decorative separator: # ──────",
                    "name": "comment.line.separator.spw comment.line",
                    "match": "^\\s*#\\s*[─━═─]{4,}.*$"
                },
                {
                    "name": "comment.line.phase-banner.spw comment.line",
                    "match": "^\\s*#\\s*---.*---\\s*$"
                },
                {
                    "comment": "File metadata: # Branch: / # Started:",
                    "name": "comment.line.metadata.spw comment.line",
                    "match": "^#\\s+(Branch|Started|Status|Author):.*$"
                },
                {
                    "comment": "File header: # wip — slug",
                    "name": "markup.heading.file-header.spw markup.heading",
                    "match": "^#\\s+wip\\s+—.*$"
                },
                {
                    "comment": "Section comment header: # MEMORY MODEL, # TEMPLATE, etc.",
                    "name": "markup.heading.section.spw markup.heading",
                    "match": "^\\s*#\\s+[A-Z][A-Z ]+$"
                },
                {
                    "name": "comment.line.number-sign.spw comment.line.number-sign",
                    "match": "^\\s*#.*$"
                },
                {
                    "name": "comment.block.spw comment.block",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.spw string.quoted.double",
                    "begin": "\"",
                    "end": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.spw punctuation.definition.string.begin"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.spw punctuation.definition.string.end"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.spw constant.character.escape",
                            "match": "\\\\."
                        },
                        {
                            "name": "constant.other.seed.spw constant.other",
                            "match": "\\^seed\\[[\\w]+\\]"
                        },
                        {
                            "name": "constant.other.sigil-frame.spw constant.other",
                            "match": "(?:&|vocab|![a-z])\\[[\\w]+\\]"
                        },
                        {
                            "name": "punctuation.separator.em-dash.spw punctuation.separator",
                            "match": "\u2014"
                        },
                        {
                            "name": "constant.other.lab-number.spw constant.other",
                            "match": "Lab \\d+\\.\\d+"
                        },
                        {
                            "name": "keyword.other.scaffold.spw keyword.other",
                            "match": "\\bscaffold\\b"
                        }
                    ]
                },
                {
                    "comment": "Tilde-string: ~\"./path\"",
                    "name": "string.quoted.tilde-ref.spw string.quoted.double",
                    "begin": "(~)(\")",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.operator.sigil.potential.tilde-ref.spw keyword.operator"
                        },
                        "2": {
                            "name": "punctuation.definition.string.begin.tilde-ref.spw punctuation.definition.string.begin"
                        }
                    },
                    "end": "(\")",
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.string.end.tilde-ref.spw punctuation.definition.string.end"
                        }
                    },
                    "patterns": [
                        {
                            "name": "string.unquoted.path.tilde-ref.spw string.unquoted",
                            "match": "[^\"]*"
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.spw string.quoted.single",
                    "begin": "'",
                    "end": "'",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.spw punctuation.definition.string.begin"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.spw punctuation.definition.string.end"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.spw constant.character.escape",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.other.backtick.spw string.quoted.other",
                    "begin": "`",
                    "end": "`",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.spw punctuation.definition.string.begin"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.spw punctuation.definition.string.end"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.spw constant.character.escape",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "literals": {
            "patterns": [
                {
                    "name": "constant.numeric.spw constant.numeric",
                    "match": "-?\\d+(\\.\\d+)?"
                },
                {
                    "name": "constant.language.boolean.spw constant.language.boolean",
                    "match": "\\b(true|false|null)\\b"
                },
                {
                    "name": "variable.other.placeholder.spw variable.other",
                    "match": "\\b_\\b"
                }
            ]
        },
        "valences": {
            "patterns": [
                {
                    "name": "keyword.other.valence.boon.spw keyword.other",
                    "match": "!boon\\b"
                },
                {
                    "name": "keyword.other.valence.bane.spw keyword.other",
                    "match": "!bane\\b"
                },
                {
                    "name": "keyword.other.valence.bone.spw keyword.other",
                    "match": "!bone\\b"
                },
                {
                    "name": "keyword.other.valence.bonk.spw keyword.other",
                    "match": "!bonk\\b"
                },
                {
                    "name": "keyword.other.valence.honk.spw keyword.other",
                    "match": "!honk\\b"
                }
            ]
        },
        "seeds": {
            "patterns": [
                {
                    "name": "keyword.control.seed.spw keyword.control",
                    "match": "\\^seed\\b"
                }
            ]
        },
        "projections": {
            "patterns": [
                {
                    "comment": "$[\"label\"] — introspection/projection operator",
                    "name": "keyword.operator.projection.spw keyword.operator",
                    "match": "\\$\\[\"[^\"]*\"\\]"
                },
                {
                    "comment": "$ sigil — introspection",
                    "name": "keyword.operator.sigil.introspection.spw keyword.operator",
                    "match": "\\$(?=[a-zA-Z_\\[])"
                }
            ]
        },
        "vocab": {
            "patterns": [
                {
                    "name": "keyword.other.vocab.spw keyword.other",
                    "match": "vocab\\[[^\\]]*\\]"
                }
            ]
        },
        "registers": {
            "patterns": [
                {
                    "name": "variable.other.register.spw variable.other",
                    "match": "\\bv:\\d+"
                },
                {
                    "name": "variable.other.register.spw variable.other",
                    "match": "@profile:\\S+"
                },
                {
                    "name": "variable.other.register.spw variable.other",
                    "match": "@region:\\S+"
                },
                {
                    "name": "variable.other.register.spw variable.other",
                    "match": "@reg:\\S+"
                },
                {
                    "name": "variable.other.register.spw variable.other",
                    "match": "@ghost:\\S*"
                }
            ]
        },
        "annotations": {
            "patterns": [
                {
                    "name": "entity.name.tag.annotation.focus.spw entity.name.tag",
                    "match": "~#focus"
                },
                {
                    "name": "entity.name.tag.annotation.taste.spw entity.name.tag",
                    "match": "~#taste"
                },
                {
                    "name": "entity.name.tag.annotation.goal.spw entity.name.tag",
                    "match": "~#goal"
                },
                {
                    "name": "entity.name.tag.annotation.status.spw entity.name.tag",
                    "match": "~#status"
                },
                {
                    "name": "entity.name.tag.annotation.spw entity.name.tag",
                    "match": "~#[a-zA-Z_][a-zA-Z0-9_-]*"
                }
            ]
        },
        "wip-constructs": {
            "patterns": [
                {
                    "comment": "File header: # wip — slug",
                    "name": "markup.heading.file-header.spw markup.heading",
                    "match": "^#\\s+wip\\s+—.*$"
                },
                {
                    "comment": "File metadata: # Branch: / # Started:",
                    "name": "comment.line.metadata.spw comment.line",
                    "match": "^#\\s+(Branch|Started|Status|Author):.*$"
                },
                {
                    "comment": "Section headers: ^[\"commits\"]",
                    "name": "markup.heading.section.spw markup.heading",
                    "match": "\\^\\[\"\\w+\"\\]"
                },
                {
                    "comment": "Stream entries: >>[timestamp] action —",
                    "name": "meta.stream.entry.spw meta",
                    "begin": "(>>)(\\[)([^\\]]+)(\\])\\s+(\\w+)\\s*(—)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.operator.stream-out.spw keyword.operator"
                        },
                        "2": {
                            "name": "punctuation.definition.bracket.spw punctuation.definition.bracket"
                        },
                        "3": {
                            "name": "constant.other.timestamp.spw constant.other"
                        },
                        "4": {
                            "name": "punctuation.definition.bracket.spw punctuation.definition.bracket"
                        },
                        "5": {
                            "name": "keyword.other.stream-action.spw keyword.other"
                        },
                        "6": {
                            "name": "punctuation.separator.em-dash.spw punctuation.separator"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "include": "#strings"
                        },
                        {
                            "include": "#annotations"
                        },
                        {
                            "include": "#sigils"
                        }
                    ]
                },
                {
                    "name": "variable.other.open-question.spw variable.other",
                    "match": "\\?\\[[^\\]]*\\]"
                },
                {
                    "comment": "Commit range: ~[1..10] — must precede commit-entry",
                    "name": "constant.other.commit-range.spw constant.other",
                    "match": "~\\[\\d+\\.\\.\\d+\\]"
                },
                {
                    "comment": "Commit entry: ~[1]",
                    "name": "constant.other.commit-entry.spw constant.other",
                    "match": "~\\[\\d+\\]"
                }
            ]
        },
        "sigils": {
            "patterns": [
                {
                    "comment": "Path access: word/word/word (file-like paths with dots, dashes, parent-traversal)",
                    "name": "string.unquoted.path.spw string.unquoted",
                    "match": "(?:\\.\\.|[A-Za-z_@])[A-Za-z0-9_.\\-]*(?:/(?:\\.\\.|[A-Za-z_@*])[A-Za-z0-9_.\\-*]*)+"
                },
                {
                    "name": "keyword.operator.sigil.action.spw keyword.operator",
                    "match": "!(?=[^bh\\[])|!(?=\\[)"
                },
                {
                    "comment": "Sigil-path: @docs/index.spw, @here/keyboard/index.ts",
                    "name": "string.unquoted.path.spw string.unquoted",
                    "match": "@[a-zA-Z_][a-zA-Z0-9_]*(?:/(?:\\.\\.|[A-Za-z_*])[A-Za-z0-9_.\\-*]*)+"
                },
                {
                    "name": "variable.other.sigil.perspective.spw variable.other",
                    "match": "@[a-zA-Z_][a-zA-Z0-9_.]*"
                },
                {
                    "name": "keyword.operator.sigil.integration.spw keyword.operator",
                    "match": "\\^[a-zA-Z_][a-zA-Z0-9_]*|\\^(?=[\\[{\"'])"
                },
                {
                    "name": "keyword.operator.sigil.wonder.spw keyword.operator",
                    "match": "\\?match\\b|\\?[a-zA-Z_][a-zA-Z0-9_.]*|\\?(?=[^a-zA-Z_])"
                },
                {
                    "name": "keyword.operator.sigil.potential.spw keyword.operator",
                    "match": "~[a-zA-Z_][a-zA-Z0-9_]*|~(?=[^#a-zA-Z_])|~$"
                },
                {
                    "name": "keyword.operator.sigil.value.spw keyword.operator",
                    "match": "\\*"
                },
                {
                    "name": "keyword.operator.sigil.schema.spw keyword.operator",
                    "match": "#[a-zA-Z_][a-zA-Z0-9_]*|#(?=[^a-zA-Z_])"
                },
                {
                    "name": "keyword.operator.sigil.subject.spw keyword.operator",
                    "match": "&[a-zA-Z_][a-zA-Z0-9_]*|&(?=[^a-zA-Z_])"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arrow.spw keyword.operator",
                    "match": "=>|->"
                },
                {
                    "name": "keyword.operator.comparison.spw keyword.operator",
                    "match": "[=!<>]="
                },
                {
                    "name": "keyword.operator.assignment.spw keyword.operator",
                    "match": "="
                },
                {
                    "name": "keyword.operator.spread.spw keyword.operator",
                    "match": "\\.\\.\\."
                },
                {
                    "name": "keyword.operator.range.spw keyword.operator",
                    "match": "\\d+\\.\\.\\d+"
                },
                {
                    "name": "keyword.operator.connector.spw keyword.operator",
                    "match": "\\.\\."
                },
                {
                    "name": "keyword.operator.stream-in.spw keyword.operator",
                    "match": "<<"
                },
                {
                    "name": "keyword.operator.stream-out.spw keyword.operator",
                    "match": ">>"
                },
                {
                    "comment": "List prefix: ..",
                    "name": "keyword.operator.list-prefix.spw keyword.operator",
                    "match": "\\.\\.(?=\\s)"
                },
                {
                    "name": "keyword.operator.n-range.spw keyword.operator",
                    "match": "\\(\\(|\\)\\)"
                },
                {
                    "name": "punctuation.separator.em-dash.spw punctuation.separator",
                    "match": "\u2014"
                }
            ]
        },
        "containers": {
            "patterns": [
                {
                    "name": "punctuation.definition.brace.spw punctuation.definition.brace",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.definition.bracket.spw punctuation.definition.bracket",
                    "match": "[\\[\\]]"
                },
                {
                    "name": "punctuation.definition.paren.spw punctuation.definition.paren",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.definition.angle.spw punctuation.definition.angle",
                    "match": "<(?![<=])"
                },
                {
                    "name": "punctuation.definition.angle.spw punctuation.definition.angle",
                    "match": "(?<![>=!])>"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "keyword.operator.chunk-binder.spw keyword.operator",
                    "match": "::"
                },
                {
                    "name": "punctuation.separator.colon.spw punctuation.separator",
                    "match": ":"
                },
                {
                    "name": "punctuation.separator.comma.spw punctuation.separator",
                    "match": ","
                },
                {
                    "name": "punctuation.separator.semicolon.spw punctuation.separator",
                    "match": ";"
                },
                {
                    "name": "punctuation.separator.pipe.spw punctuation.separator",
                    "match": "\\|"
                },
                {
                    "name": "punctuation.separator.dot.spw punctuation.separator",
                    "match": "\\."
                },
                {
                    "name": "punctuation.definition.fence.spw punctuation.definition",
                    "match": "^---$"
                }
            ]
        }
    }
}
