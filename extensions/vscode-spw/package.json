{
    "name": "spw-language",
    "displayName": "Spw Language Support",
    "description": "Syntax highlighting for the Spw (Symbolic Processing Workbench) language — operator physics, valence semantics, and structural containers.",
    "version": "0.3.0",
    "publisher": "spwashi",
    "icon": "icon.png",
    "main": "./dist/extension.js",
    "activationEvents": [],
    "engines": {
        "vscode": "^1.80.0"
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
        "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch"
    },
    "categories": [
        "Programming Languages"
    ],
    "commands": [
        {
            "command": "spwConcepts.refresh",
            "title": "Spw: Refresh Concepts Tree"
        },
        {
            "command": "spwConcepts.setGrouping",
            "title": "Spw: Set Concepts Grouping"
        },
        {
            "command": "spwConcepts.setFilter",
            "title": "Spw: Filter Concepts Tree"
        },
        {
            "command": "spwConcepts.clearFilter",
            "title": "Spw: Clear Concepts Filter"
        },
        {
            "command": "spwConcepts.openEntry",
            "title": "Spw: Open Concept Entry"
        }
    ],
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/vscode": "^1.80.0",
        "esbuild": "^0.19.0",
        "typescript": "^5.2.0"
    },
    "contributes": {
        "languages": [
            {
                "id": "spw",
                "aliases": [
                    "Spw",
                    "SPW"
                ],
                "extensions": [
                    ".spw"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "spw",
                "scopeName": "source.spw",
                "path": "./syntaxes/spw.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "spw",
                "path": "./snippets/spw.json"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "spw",
                "scopes": {
                    "operator": [ "keyword.operator.spw" ],
                    "type": [ "entity.name.type.spw" ],
                    "variable": [ "variable.other.spw" ],
                    "property": [ "variable.other.property.spw" ],
                    "function": [ "entity.name.function.spw" ],
                    "string": [ "string.quoted.spw" ],
                    "keyword": [ "keyword.control.spw" ],
                    "comment": [ "comment.line.spw" ]
                }
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "spw-explorer",
                    "title": "Spw",
                    "icon": "$(symbol-misc)"
                }
            ]
        },
        "views": {
            "spw-explorer": [
                {
                    "id": "spwConcepts",
                    "name": "Concepts"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "spwConcepts.refresh",
                    "when": "view == spwConcepts",
                    "group": "navigation@1"
                },
                {
                    "command": "spwConcepts.setGrouping",
                    "when": "view == spwConcepts",
                    "group": "navigation@2"
                },
                {
                    "command": "spwConcepts.setFilter",
                    "when": "view == spwConcepts",
                    "group": "navigation@3"
                },
                {
                    "command": "spwConcepts.clearFilter",
                    "when": "view == spwConcepts",
                    "group": "navigation@4"
                }
            ]
        }
    }
}
