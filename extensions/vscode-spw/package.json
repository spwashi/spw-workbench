{
    "name": "spw-language",
    "displayName": "Spw Language Support",
    "description": "Preview thin-client VS Code support for Spw — LSP-backed semantics, workspace evidence, and URI-native navigation.",
    "version": "0.3.0",
    "publisher": "spwashi",
    "license": "MIT",
    "preview": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/spwashi/spw-workbench"
    },
    "homepage": "https://github.com/spwashi/spw-workbench/tree/main/extensions/vscode-spw",
    "bugs": {
        "url": "https://github.com/spwashi/spw-workbench/issues"
    },
    "keywords": [
        "spw",
        "language",
        "lsp",
        "semantic-tokens",
        "concepts",
        "workbench"
    ],
    "icon": "icon.png",
    "main": "./dist/extension.js",
    "activationEvents": [
        "onLanguage:spw",
        "onView:spwConcepts",
        "onView:spwWorkspace"
    ],
    "engines": {
        "vscode": "^1.80.0"
    },
    "spw": {
        "server": "./dist/server/spw-lsp.cjs",
        "workspaceManifestMethod": "spw/workspaceManifest/v1"
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "typecheck": "tsc --noEmit",
        "compile:server": "esbuild ../../packages/spw-lsp/src/stdio-server.ts --bundle --platform=node --format=cjs --outfile=dist/server/spw-lsp.cjs",
        "compile:client": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --alias:@spwashi/spw-lsp/workspace-protocol=../../packages/spw-lsp/src/workspace-protocol.ts --format=cjs --platform=node",
        "compile": "npm run compile:server && npm run compile:client",
        "build": "npm run typecheck && npm run compile",
        "watch": "npm run compile:server && esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --alias:@spwashi/spw-lsp/workspace-protocol=../../packages/spw-lsp/src/workspace-protocol.ts --format=cjs --platform=node --watch"
    },
    "categories": [
        "Programming Languages"
    ],
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/vscode": "^1.80.0",
        "esbuild": "^0.19.0",
        "typescript": "^5.2.0"
    },
    "contributes": {
        "commands": [
            {
                "command": "spw.navigate",
                "title": "Spw: Navigate Roots and Landmarks"
            },
            {
                "command": "spw.showOperatorFrequency",
                "title": "Spw: Show Operator Frequency"
            },
            {
                "command": "spw.showPhaseContext",
                "title": "Spw: Show Phase Context at Cursor"
            },
            {
                "command": "spw.insertFormSequence",
                "title": "Spw: Insert Form Sequence"
            },
            {
                "command": "spw.showFormSequence",
                "title": "Spw: Explain Form Sequence"
            },
            {
                "command": "spw.showWorkspaceTemperature",
                "title": "Spw: Workspace Temperature"
            },
            {
                "command": "spw.inspectCache",
                "title": "Spw: Inspect Cache"
            },
            {
                "command": "spw.showReferenceHubs",
                "title": "Spw: Reference Hubs & Orphans"
            },
            {
                "command": "spw.restartLanguageServer",
                "title": "Spw: Restart Language Server"
            },
            {
                "command": "spw.inspectGeometry",
                "title": "Spw: Inspect Form"
            },
            {
                "command": "spw.showSurfaceProfile",
                "title": "Spw: Inspect Surface Stack"
            },
            {
                "command": "spw.renameSymbol",
                "title": "Spw: Rename Symbol"
            },
            {
                "command": "spw.planCorpusRefactor",
                "title": "Spw: Plan Corpus Refactor..."
            },
            {
                "command": "spw.showFlowProtocol",
                "title": "Spw: Flow Protocol (sigil × brace modules)"
            },
            {
                "command": "spw.showGeometricResonance",
                "title": "Spw: Geometric Resonance"
            },
            {
                "command": "spw.showProbeMeasure",
                "title": "Spw: Probe & Measure Census"
            },
            {
                "command": "spw.clearProbeCache",
                "title": "Spw: Clear Probe Cache"
            },
            {
                "command": "spwConcepts.refresh",
                "title": "Spw: Refresh Concepts Tree"
            },
            {
                "command": "spwConcepts.setGrouping",
                "title": "Spw: Set Concepts Grouping"
            },
            {
                "command": "spwConcepts.setFilter",
                "title": "Spw: Filter Concepts Tree"
            },
            {
                "command": "spwConcepts.clearFilter",
                "title": "Spw: Clear Concepts Filter"
            },
            {
                "command": "spwWorkspace.refresh",
                "title": "Spw: Re-ground Workspace Atlas",
                "icon": "$(refresh)"
            }
        ],
        "configuration": {
            "title": "Spw",
            "properties": {
                "spw.inlayHints.paths": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show path-resolution inlay hints for ~ and @ references."
                },
                "spw.inlayHints.annotations": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show annotation inlay hints (#, #:, #!, #>)."
                },
                "spw.inlayHints.frames": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show frame-depth inlay hints."
                },
                "spw.diagnostics.unresolvedRefs": {
                    "type": "string",
                    "enum": ["error", "warning", "hint", "off"],
                    "default": "warning",
                    "description": "Severity for unresolved path references."
                },
                "spw.trace.server": {
                    "type": "string",
                    "enum": ["off", "messages", "verbose"],
                    "default": "off",
                    "description": "Trace communication between VS Code and the Spw language server."
                },
                "spw.surface.highlightPathRefs": {
                    "type": "boolean",
                    "default": true,
                    "description": "Decorate ~path and @root references so Spw surfaces stand out from host code."
                },
                "spw.surface.highlightAnnotations": {
                    "type": "boolean",
                    "default": true,
                    "description": "Decorate # / #! / #: / #> annotations as distinct surface marks."
                },
                "spw.surface.highlightBraces": {
                    "type": "boolean",
                    "default": true,
                    "description": "Decorate paired bounds {}[]()<> to learn brace geometry."
                },
                "spw.surface.highlightOperators": {
                    "type": "boolean",
                    "default": true,
                    "description": "Decorate operator sigils by phase (? wonder, ! action, ^ frame, @ observer, ~ potential, * collapse, = constraint). Each gets its own theme color."
                },
                "spw.surface.highlightSemantics": {
                    "type": "boolean",
                    "default": true,
                    "description": "Decorate semantic constructs: pipe labels (|word, |^word), charge: keys, status: tier values, ~#key: compound properties, =exp[ slots."
                },
                "spw.compute.decorationRefreshMs": {
                    "type": "number",
                    "default": 120,
                    "minimum": 40,
                    "description": "Throttle (ms) for surface decoration recomputation after edits."
                },
                "spw.compute.geometryOnSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "On save, open Spw: Inspect Geometry for the active .spw buffer."
                },
                "spw.cache.probeTtlMs": {
                    "type": "number",
                    "default": 8000,
                    "minimum": 0,
                    "description": "TTL (ms) for client-side probe cache (geometry/frequency). 0 disables cache."
                },
                "spw.cli.toolRoot": {
                    "type": "string",
                    "default": "",
                    "description": "Optional workbench directory containing the npm spw script. Relative paths resolve from the consumer workspace; by default the workspace and .spw/_workbench are discovered."
                }
            }
        },
        "colors": [
            { "id": "spw.lens", "description": "Lens annotations (#:) — probing, measurement", "defaults": { "dark": "#4EC9B0", "light": "#267F7F", "highContrast": "#4EC9B0", "highContrastLight": "#267F7F" } },
            { "id": "spw.intent", "description": "Intent annotations (#!) — action, injection", "defaults": { "dark": "#CE9178", "light": "#A31515", "highContrast": "#CE9178", "highContrastLight": "#A31515" } },
            { "id": "spw.anchor", "description": "Anchor annotations (#>) — framing, integration", "defaults": { "dark": "#D16969", "light": "#795E26", "highContrast": "#D16969", "highContrastLight": "#795E26" } },
            { "id": "spw.topic", "description": "Topic annotations (#) — generic label", "defaults": { "dark": "#9CDCFE", "light": "#0070C1", "highContrast": "#9CDCFE", "highContrastLight": "#0070C1" } },
            { "id": "spw.promptRoot", "description": "Prompt root anchors (##>) — navigation landmark", "defaults": { "dark": "#C586C0", "light": "#AF00DB", "highContrast": "#C586C0", "highContrastLight": "#AF00DB" } },
            { "id": "spw.phaseWonder", "description": "Spirit phase: ? wonder / ~ potential", "defaults": { "dark": "#4EC9B0", "light": "#267F7F", "highContrast": "#4EC9B0", "highContrastLight": "#267F7F" } },
            { "id": "spw.phaseAction", "description": "Spirit phase: ! action / injection", "defaults": { "dark": "#CE9178", "light": "#A31515", "highContrast": "#CE9178", "highContrastLight": "#A31515" } },
            { "id": "spw.phaseIntegration", "description": "Spirit phase: ^ frame/synthesis operator", "defaults": { "dark": "#B07EE0", "light": "#6A35A8", "highContrast": "#B07EE0", "highContrastLight": "#6A35A8" } },
            { "id": "spw.phaseObserver", "description": "Spirit phase: @ observer/perspective operator", "defaults": { "dark": "#5DBADB", "light": "#0278AE", "highContrast": "#5DBADB", "highContrastLight": "#0278AE" } },
            { "id": "spw.phasePotential", "description": "Spirit phase: ~ potential/defer operator", "defaults": { "dark": "#57D6A3", "light": "#1B8F6A", "highContrast": "#57D6A3", "highContrastLight": "#1B8F6A" } },
            { "id": "spw.phaseMeta", "description": "Spirit phase: # meta / annotation", "defaults": { "dark": "#9CDCFE", "light": "#0070C1", "highContrast": "#9CDCFE", "highContrastLight": "#0070C1" } },
            { "id": "spw.tierHot", "description": "Hot memory tier", "defaults": { "dark": "#F44747", "light": "#CD3131", "highContrast": "#F44747", "highContrastLight": "#CD3131" } },
            { "id": "spw.tierWarm", "description": "Warm memory tier", "defaults": { "dark": "#CCA700", "light": "#BF8803", "highContrast": "#CCA700", "highContrastLight": "#BF8803" } },
            { "id": "spw.tierCold", "description": "Cold memory tier", "defaults": { "dark": "#3794FF", "light": "#006AB1", "highContrast": "#3794FF", "highContrastLight": "#006AB1" } },
            { "id": "spw.pathRef", "description": "Spw path/root references (~…, @root) — distinct surface", "defaults": { "dark": "#9CDCFE", "light": "#0451A5", "highContrast": "#9CDCFE", "highContrastLight": "#0451A5" } },
            { "id": "spw.annotation", "description": "Spw annotations (# #! #: #>) — distinct surface", "defaults": { "dark": "#C586C0", "light": "#AF00DB", "highContrast": "#C586C0", "highContrastLight": "#AF00DB" } },
            { "id": "spw.brace", "description": "Spw paired bounds {}[]()<> — geometry", "defaults": { "dark": "#DCDCAA", "light": "#795E26", "highContrast": "#DCDCAA", "highContrastLight": "#795E26" } },
            { "id": "spw.operator", "description": "Spw residual operator sigils ($, %) — receding neutral", "defaults": { "dark": "#7FBFB8", "light": "#357972", "highContrast": "#7FBFB8", "highContrastLight": "#357972" } },
            { "id": "spw.valenceBoon", "description": "Runtime valence: boon (growth, implemented state)", "defaults": { "dark": "#4EC9B0", "light": "#16825D", "highContrast": "#4EC9B0", "highContrastLight": "#16825D" } },
            { "id": "spw.valenceBane", "description": "Runtime valence: bane (hazard, error state)", "defaults": { "dark": "#F44747", "light": "#CD3131", "highContrast": "#F44747", "highContrastLight": "#CD3131" } },
            { "id": "spw.valenceBone", "description": "Runtime valence: bone (scaffold, partial state)", "defaults": { "dark": "#CCA700", "light": "#BF8803", "highContrast": "#CCA700", "highContrastLight": "#BF8803" } },
            { "id": "spw.valenceBonk", "description": "Runtime valence: bonk (conflict, boundary interruption)", "defaults": { "dark": "#CE9178", "light": "#A31515", "highContrast": "#CE9178", "highContrastLight": "#A31515" } },
            { "id": "spw.valenceHonk", "description": "Runtime valence: honk (telemetry, high-priority signal)", "defaults": { "dark": "#C586C0", "light": "#AF00DB", "highContrast": "#C586C0", "highContrastLight": "#AF00DB" } }
        ],
        "languages": [
            {
                "id": "spw",
                "aliases": [
                    "Spw",
                    "SPW"
                ],
                "extensions": [
                    ".spw"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "spw",
                "scopeName": "source.spw",
                "path": "./syntaxes/spw.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "spw",
                "path": "./snippets/spw.json"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "spw",
                "scopes": {
                    "operator": [ "keyword.operator.spw" ],
                    "operator.declaration": [ "punctuation.section.block.begin.spw", "keyword.operator.brace.open.spw" ],
                    "operator.definition": [ "keyword.operator.couple.spw", "keyword.operator.confluence.spw" ],
                    "operator.async": [ "keyword.operator.stream.spw" ],
                    "type": [ "entity.name.type.spw" ],
                    "type.definition": [ "entity.name.type.lens.spw" ],
                    "variable": [ "variable.other.spw" ],
                    "variable.definition": [ "entity.name.type.path-ref.spw" ],
                    "property": [ "variable.other.property.spw" ],
                    "property.declaration": [ "entity.name.tag.exp.spw", "variable.other.property.exp.spw" ],
                    "property.readonly": [ "variable.other.constant.spw", "keyword.operator.config.spw" ],
                    "function": [ "entity.name.function.spw" ],
                    "function.modification": [ "entity.name.function.action.spw", "markup.bold.spw" ],
                    "function.async": [ "entity.name.function.probe.spw" ],
                    "string": [ "string.quoted.spw" ],
                    "keyword": [ "keyword.control.spw" ],
                    "keyword.declaration": [ "keyword.control.frame.spw", "entity.name.function.frame.spw" ],
                    "keyword.definition": [ "keyword.control.dialect.spw", "entity.name.tag.dialect.spw" ],
                    "keyword.readonly": [ "keyword.operator.collapse.spw" ],
                    "comment": [ "comment.line.spw" ],
                    "number": [ "constant.numeric.spw" ]
                }
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "spw-explorer",
                    "title": "Spw",
                    "icon": "$(symbol-misc)"
                }
            ]
        },
        "views": {
            "spw-explorer": [
                {
                    "id": "spwWorkspace",
                    "name": "Workspace"
                },
                {
                    "id": "spwConcepts",
                    "name": "Concepts"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "spwConcepts.refresh",
                    "when": "view == spwConcepts",
                    "group": "navigation@1"
                },
                {
                    "command": "spwConcepts.setGrouping",
                    "when": "view == spwConcepts",
                    "group": "navigation@2"
                },
                {
                    "command": "spwConcepts.setFilter",
                    "when": "view == spwConcepts",
                    "group": "navigation@3"
                },
                {
                    "command": "spwConcepts.clearFilter",
                    "when": "view == spwConcepts",
                    "group": "navigation@4"
                },
                {
                    "command": "spwWorkspace.refresh",
                    "when": "view == spwWorkspace",
                    "group": "navigation@1"
                }
            ]
        }
    }
}
