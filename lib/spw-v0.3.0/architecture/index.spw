# v0.2.0 Library Architecture Supports

#:layer #!grammar

^"roots"{
 @here: ~"."
 @lib: ~".."
 @theory: ~"../../../docs/theory/spw"
}

^"supports"{
 .. ~<layout-md>"../LAYOUT.md"
 .. ~<arch-md>"../ARCHITECTURE.md"
 .. ~<layout>"./layout.spw"
 .. ~<theory>"./theory-bridge.spw"
}

^"thesis"{
 ual: "Unified Augmentation Language frames braces as primordial constructs",
 question: "What if braces had opposite spin and every operator were real?",
 method: "Pair markdown contracts with .spw architecture supports",
}

#>wonder_lib_spwv020alpha_architecture_index_1
?["What is the metabolic signature of reading v0.2.0 Library Architecture Supports?"]{
  #:depth #!experiential // lens: living system
  $%[line.operator_density, brace.nesting_rhythm] => ~#reading_feel
  ~#structure: "roots → supports → thesis" // frame flow
  !probe{ "read aloud for 30 seconds; where do you pause? pauses mark structural joints." }
}

#>wonder_lib_spwv020alpha_architecture_index_2
?["What concept is conspicuously absent from v0.2.0 Library Architecture Supports?"]{
  #:depth #!computational // lens: curated collection
  ~#present: [#educational, #mathematical]
  ~#expected_but_missing: "?" // the reader fills this gap
  !probe{ "list what IS annotated; list what sibling files annotate; the difference is this file's blind spot or intentional boundary." }
  $%[file.frame_count, file.annotation_density, file.brace_depth_max]
  ~<"lib/spw-v0.2.0-alpha/architecture/layout.spw"> ~#neighbor(nearest)
}
