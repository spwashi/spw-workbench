 }

 ^"toc"{
 .. ~<toc>"../../../docs/toc.spw"
 }
}

#>wonder_lib_spwv030_architecture_theorybrid_1
?["What ripples if #theory_bridge changes in this file?"]{
  #:depth #!mathematical // lens profile: dependency relation
  $#mathematical@workspace => %[reference.count, depth.downstream]
  ~#downstream: "trace all files that reference this surface"
  !probe{ "preview renaming #mathematical to #mathematical_v2; count resolved and unresolved references, then report the parser and corpus used." }
  $%[register.bank_size, register.active_bindings]
}

#>wonder_lib_spwv030_architecture_theorybrid_2
?["What happens when you project from token spans to workspace relations in the v0.3.0 Library Theory Bridge?"]{
  #:depth #!stylistic // lens profile: nested region
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "ual" // this file's atom
  !probe{ "starting from this source-mapped token, which parsed regions and references contain or address it?" }
  $%[register.bank_size, register.active_bindings]
  ~<lib/spw-v0.3.0/architecture/index.spw>  // nearest neighbor
}
