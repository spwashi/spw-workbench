 .. ~<operators>"../../../docs/theory/spw/operators.spw"
 .. ~<atlas>"../../../docs/theory/spw/operator-atlas.spw"
 .. ~<register>"../../../docs/theory/spw/register-geometry.spw"
 .. ~<onf>"../../../docs/theory/spw/onf.spw"
 .. ~<coupling>"../../../docs/theory/spw/coupling-constructors.spw"
 .. ~<composition>"../../../docs/theory/spw/operator-brace-composition.spw"
 .. ~<topography>"../../../docs/theory/spw/operational-topography.spw"
 .. ~<devices>"../../../docs/theory/spw/operational-devices.spw"
 .. ~<lens>"../../../docs/theory/md/lens-algebra.md"
 }

 ^"runtime-theory"{
 !boon["Execution and state models"]
 .. ~<valence>"../../../docs/theory/spw/valence-architecture.spw"
 .. ~<cognitive>"../../../docs/theory/spw/cognitive-laser.spw"
 .. ~<looper>"../../../docs/theory/spw/looper-architecture.spw"
 }

 ^"missing-theory"{
 !bone["Theory docs not yet linked to a specific stratum"]
 .. ~<phasor>"../../../docs/theory/spw/phasor.spw"
 .. ~<quality>"../../../docs/theory/spw/quality.spw"
 .. ~<physics>"../../../docs/theory/spw/semantics-physics.spw"
 .. ~<spatial>"../../../docs/theory/spw/spatial-model.spw"
 .. ~<audio>"../../../docs/theory/spw/audio-architecture.spw"
 .. ~<materials>"../../../docs/theory/spw/materials-ontology.spw"
 .. ~<scene>"../../../docs/theory/spw/scenes/dusk-oak.spw"
 }
}

^"doc_crosslinks"{
 !["Connecting lib architecture to docs/ category indexes"]

 ^"plans"{
 .. ~<architecture>"../../../docs/plans/spw/architecture.spw"
 .. ~<domains>"../../../docs/plans/spw/domains.spw"
 .. ~<directions>"../../../docs/plans/spw/directions.spw"
 .. ~<patterns>"../../../docs/plans/spw/patterns.spw"
 .. ~<deps>"../../../docs/plans/spw/dependencies.spw"
