 .. ~<design>"../../../docs/waypoints/spw/design-stage-system.spw"
 .. ~<infra>"../../../docs/waypoints/spw/infra-hardening.spw"
 .. ~<keyboard>"../../../docs/waypoints/spw/keyboard-field-guide.spw"
 .. ~<publishing>"../../../docs/waypoints/spw/publishing-atlas.spw"
 }

 ^"design"{
