# v0.3.0 Library Theory Bridge

#:layer #!grammar

^"ual"{
 name: "Unified Augmentation Language",
 status: "interpretive profile",
 thesis: "Paired boundaries can support reusable structural views without requiring one biological, physical, or linguistic metaphor."
}

^"status_discipline"{
 implemented: "Behavior present in the current lexer, parser, AST, normalizer, runtime, or editor implementation.",
 interpretive: "A selectable reading or rendering profile; not an intrinsic property of a glyph.",
 proposed: "A design candidate that must not be advertised as current behavior.",
 measured: "An observation accompanied by a method, corpus, and result."
}

^"boundary_reality"{
 implemented: "The parser retains distinct container node kinds; adjacent <> is also lexed as the Couple operator.",
 distinction: "The <> operator and a <...> capsule boundary are related glyph forms but not one lexical construct.",
 structural_projection: "ONF now treats <> and paired Bounds as a tagged coupling algebra while retaining distinct operator and boundary forms, kinds, register identities, and AST origins.",
 implemented_coordinates: "Operator coupling records arity; boundary coupling records occupancy, payload, surface, and placement when known.",
 proposed: "Add parser-owned pair identity/source spans and test named physical or mathematical profiles without embedding them as Seed law.",
 lowering_candidate: "Profiles may lower compatible boundary relations to an explicit <> coupling form when source maps and effects are preserved."
}

^"coupling_profiles"{
 "<...>": { interpretation: "concept capsule", question: "what relation is being formed?" }
 "(...)": { interpretation: "scene or ordered context", question: "what is grouped or observed together?" }
 "[...]": { interpretation: "mode or collection", question: "under what selection or framing?" }
 "{...}": { interpretation: "body or scoped material", question: "what is contained or enacted?" }
 status: "interpretive"
}

^"orientation"{
 implemented: "Open and close boundaries preserve source order and nesting.",
 interpretive: "Profiles may describe open/close, source/target, exterior/interior, or left/right affordances.",
 constraint: "A profile must not present objective/subjective charge or directional meaning as intrinsic unless an operation and measurement establish it.",
 experiment: "Rotate or swap a view, retain source identity, and measure whether navigation or editing performance changes."
}

^"boundary_symmetry"{
 ergonomic_goal: "Permit navigation from either boundary when a source-mapped editor operation can preserve pair identity.",
 semantic_constraint: "Symmetric selection does not imply symmetric execution or interchangeable delimiters.",
 status: "proposed"
}

^"operator_reality"{
 operators: ["!", "^", "~", "?", "*", "=", "@", "#", ".", "&", "$", "%", "<>"],
 implemented: "These thirteen operator kinds are recognized by Seed; parser position and runtime behavior remain operator-specific.",
 requirement: "Any advertised operation must state whether it is merely lexed, parsed, normalized, interpreted, or exposed through tooling."
}

^"accessor_polarity"{
 "#": { profile: "extrinsic accessor", tendency: "projection-facing" }
 ".": { profile: "intrinsic accessor", tendency: "reduction-facing" }
 status: "interpretive; inspect parser and runtime status before use as an operation"
}

^"suffix_directionality"{
 "expr#": "projection suffix candidate (emit/select outward-facing properties)",
 "expr.": "reduction suffix candidate (collapse/select inward-facing properties)",
 parser_reality: "Current operator parsing is prefix-oriented; suffix forms are not an implemented contract.",
 status: "proposed"
}

^"flow_implications"{
 binding: "A proposed binding profile may preserve accessor intent when the parser and trace make that intent observable.",
 indexing: "Proposed index operations should preserve selector kind and source spans in traces.",
 boundary_conditions: "Physical language is most useful at the interface: entry/exit conditions, permitted flow, effects, and conservation tests.",
 high_context_mode: "A future context-rich profile may accept selector sugar only through a disclosed parse or lowering step.",
 low_context_mode: "Exact tooling should prefer explicit operators and containers, complete parsing, and deterministic source maps."
}

^"plane_axes"{
 liminality: "transitional <-> resolved",
 tangibility: "abstract <-> concrete",
 conception: "generative <-> instantiated",
 familiarity: "recently encountered <-> repeatedly recognized (longitudinal observation, not glyph semantics)",
 salience: "background <-> foreground",
 objectivity_subjectivity: "external-grounded <-> perspectival",
 valence: "boon/bane/bone/bonk/honk",
 composition: "isolated <-> composite",
 status: "candidate descriptive dimensions; measurement definitions are required before quantitative use"
}

^"selection_pattern"{
 thesis: "Concept references should combine path + axis profile + brace context.",
 anti_pattern: "Path-only resolution in liminal spaces may create collisions; record counterexamples before generalizing."
}

^"falsify"{
 failure_signals: [
 "tooling advertises an operation at a stronger status than its implementation",
 "a boundary transform loses pair identity, source span, ordering, nesting, labels, or effects",
 "an interpretive profile is presented as intrinsic glyph physics",
 "a measured axis lacks an explicit method or corpus"
 ]
}

^"strata_scaffolds"{
 !["Navigable .spw index for each lib stratum"]
 .. ~<core>"../core/index.spw"
 .. ~<runtime>"../runtime/index.spw"
 .. ~<dialects>"../dialects/index.spw"
 .. ~<domains>"../domains/index.spw"
 .. ~<applications>"../applications/index.spw"
 .. ~<infra>"../infra/index.spw"
}

^"theory_crosslinks"{
 !["Connecting lib architecture to theory docs"]

 ^"core-theory"{
