# Core Stratum Architecture Support
# Navigable index for the language kernel

#:layer #!grammar

^["roots"]{
  @here: ~"."
  @lib:  ~".."
  @theory: ~"../../../docs/theory"
  @specs:  ~"../../../docs/specs"
  @seed:   ~"../../../src/seed"
}

# ── Ethos ────────────────────────────────────────────────────

meta: .{
  domain    = `core`
  initOrder = `0`
  kind      = `stratum-map`
  note      = `Kernel contracts — what must be true for any Spw implementation`
}[reg=facet]

purpose: .{
  role       = `Define the structural primitives that every Spw surface inherits`
  invariant  = `No core contract may depend on runtime, domain, or application concepts`
  philosophy = `The core is the algebra. Everything above is interpretation.`
}[reg=facet]

garden: .{
  is            = `10 contract stubs covering operators, containers, layers, capsules, seeds, boundaries, safety, integrity, conformance, and the SPEC`
  could_become  = `A standalone core spec publishable as @spw/core — the formal grammar + semantics`
  connects_to   = `runtime/ extends it with execution. dialects/ specializes it. domains/ reinterprets it.`
  growth_risk   = `Scope creep: adding runtime or domain concepts to core breaks the algebra boundary.`
}[reg=facet]

valence: .{
  boon = `Every operator has a single semantic role — no overloading`
  bane = `Contracts are stubs — semantic depth is thin until formalized`
  bone = `10 markdown contracts provide stable reference surface`
  bonk = `Adding a 13th operator would cascade through every downstream stratum`
  honk = `The operator algebra is the heartbeat of the language`
}[reg=quality]

# ── Contract Surfaces ───────────────────────────────────────

^["contracts"]{
  !["10 kernel contracts"]

  ^["operators"]{
    =file: "OPERATORS.md"
    =count: 12
    =sigils: ["!", "^", "~", "?", "*", "=", "@", "#", ".", "&", "$", "%"]
    ~<detail>"./OPERATORS.md"
    ~<atlas>"../../../docs/theory/spw/operator-atlas.spw"
    ~<canonical>"../../../docs/theory/spw/operators.spw"
  }

  ^["containers"]{
    =file: "CONTAINERS.md"
    =braces: ["<>", "()", "[]", "{}"]
    ~<detail>"./CONTAINERS.md"
    ~<geometry>"../../../docs/theory/spw/register-geometry.spw"
  }

  ^["layers"]{
    =file: "LAYERS.md"
    ~<detail>"./LAYERS.md"
    ~<phasor>"../../../docs/theory/spw/phasor.spw"
  }

  ^["capsules"]{
    =file: "CAPSULES.md"
    ~<detail>"./CAPSULES.md"
  }

  ^["seeds"]{
    =file: "SEEDS.md"
    ~<detail>"./SEEDS.md"
  }

  ^["boundaries"]{
    =file: "BOUNDARIES.md"
    ~<detail>"./BOUNDARIES.md"
  }

  ^["safety"]{
    =file: "SAFETY.md"
    ~<detail>"./SAFETY.md"
  }

  ^["integrity"]{
    =file: "INTEGRITY.md"
    ~<detail>"./INTEGRITY.md"
  }

  ^["conformance"]{
    =file: "CONFORMANCE.md"
    ~<detail>"./CONFORMANCE.md"
  }

  ^["spec"]{
    =file: "SPEC.md"
    ~<detail>"./SPEC.md"
  }
}

# ── Portable Parser ─────────────────────────────────────────

^["seed"]{
  !["src/seed — the extractable parser core"]
  =status: "shipped"
  =invariant: "zero workbench dependencies"

  ~<map>"../../../src/seed/docs/index.spw"

  ^["modules"]{
    .. @seed/lexer         # 12 operators, backtick strings, guillemets, holes
    .. @seed/grammar       # containers, operators, modifiers
    .. @seed/parser        # combinator-based recursive descent
    .. @seed/canonical     # Spw.l canonicalization
    .. @seed/query         # spwq selector algebra (15 presets)
  }

  ^["golden-snapshots"]{
    !["5 canonical parse outputs — changes need approval"]
    .. ~"../../../src/seed/__tests__/snapshots/phase-4-golden/example-1-inject.spw"
    .. ~"../../../src/seed/__tests__/snapshots/phase-4-golden/example-2-reflect.spw"
    .. ~"../../../src/seed/__tests__/snapshots/phase-4-golden/example-3-couple.spw"
    .. ~"../../../src/seed/__tests__/snapshots/phase-4-golden/example-4-capsule.spw"
    .. ~"../../../src/seed/__tests__/snapshots/phase-4-golden/example-5-mixed.spw"
  }
}

