# Domain Stratum Architecture Support
# Navigable index for domains: interpretive lenses, taste, posture

^["roots"]{
  @here: ~"."
  @lib:  ~".."
  @theory: ~"../../../docs/theory"
}

^["surfaces"]{
  .. ~<profiles>"./PROFILES.md"
  .. ~<taste>"./TASTE.md"
  .. ~<posture>"./POSTURE.md"
}

# ── Operator reinterpretation lenses ─────────────────────────

^["lenses"]{
  !["Domains are operator reinterpretation lenses"]
  !["Same 8 operators, different targets — substrate to story"]

  ^["Cognitive@"]{
    =character: "information processing"
    !"!": "encoding"
    !"^": "chunking"
    !"~": "rehearsal"
    !"?": "retrieval"
    !"=": "consolidation"
    !"@": "expression"
  }

  ^["Hardware@"]{
    =character: "physical substrate, component-level"
    !"!": "voltage source"
    !"^": "node label"
    !"~": "oscillator"
    !"?": "comparator"
    !"=": "reference voltage"
    !"@": "output driver"
    ~<detail>"../applications/HARDWARE.md"
  }

  ^["Theatre@"]{
    =character: "dramatic narrative, proximity-dominant"
    !"!": "entrance, action"
    !"^": "character naming"
    !"~": "recurring motif"
    !"?": "dramatic question"
    !"=": "character trait"
    !"@": "exit, emission"

    ^["modifiers"]{
      =boon: "triumphant action"
      =bone: "neutral direction"
      =bane: "tragic action"
      =bonk: "comic interruption"
      =honk: "climax"
    }

    ~<detail>"../applications/THEATRE.md"
  }

  ^["Broadcast@"]{
    =character: "signal flow, one-to-many"
    !"!": "signal source"
    !"^": "channel"
    !"~": "carrier modulation"
    !"?": "signal monitor"
    !"=": "parameter"
    !"@": "transmission"
    ~<detail>"../applications/BROADCAST.md"
  }
}

# ── Abstraction gradient ─────────────────────────────────────

^["gradient"]{
  !["From substrate to story — what does ! mean?"]

  ^["substrate"]{ =lens: "Hardware@", =inject: "voltage" }
  ^["signal"]{ =lens: "Broadcast@", =inject: "signal source" }
  ^["process"]{ =lens: "Cognitive@", =inject: "encoding to memory" }
  ^["story"]{ =lens: "Theatre@", =inject: "entrance, action" }

  ?["The operators don't change — only what they're applied to"]
  ?["Is this gradient measurable or just illustrative?"]
    ~#status: "open question — may relate to taste axes"
}

# ── Meta-domains ─────────────────────────────────────────────

^["Taste@"]{
  =kind: "evaluative (not interpretive)"
  =status: "convention — used in skills, not machined"

  ^["axes"]{
    .. ="density"     # sparse → dense
    .. ="valence"     # neutral → charged
    .. ="depth"       # flat → deep
    .. ="explicit"    # implicit → explicit
    .. ="abstract"    # concrete → abstract
    .. ="temporal"    # instant → processual
  }

  ^["profiles"]{
    .. ="Minimalist"  # dense, implicit
    .. ="Literate"    # explicit, balanced
    .. ="Poetic"      # high valence, rhythmic
    .. ="Mechanical"  # explicit, checkpointed
    .. ="Research"    # structured, linked
  }

  ?["Can spwq selectors filter by taste profile?"]
    ~#status: "not implemented"
}

^["Posture@"]{
  =kind: "behavioral (not aesthetic)"
  =status: "plan exists — not machined"

  ^["profiles"]{
    .. ="ResearchRigorous"   # full traceability
    .. ="StreamVelocity"     # low latency
    .. ="TeachingGentle"     # max ergonomics
    .. ="ProductionSafe"     # safety-first
    .. ="AuditComplete"      # full determinism
  }

  ?["How does posture interact with dialect gating?"]
    ~#status: "open question"
}

# ── Implementation status ────────────────────────────────────

^["implementation"]{
  !boon["shipped"]{
    @src/seed/query/presets   # DOMAIN_ROOTS preset — structural ^[_] matching
    @src/infra/shaders        # shader-renderer.ts — lens gain chain
    ~"../../../.agents/skills/spw-craft-quality/SKILL.md"  # taste conventions
  }

  !bone["deferred"]{
    .. ?"domain operator projection"
    .. ?"domain registration (canon:Spw.Domain.*)"
    .. ?"#domain: annotation"
    .. ?"taste scoring automation"
    .. ?"posture-gated evaluation"
  }
}

