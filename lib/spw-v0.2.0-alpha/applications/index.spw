^["theory"]{
  .. ~<lens>"../../../docs/theory/md/lens-algebra.md"
  .. ~<cognitive>"../../../docs/theory/spw/cognitive-laser.spw"
  .. ~<operators>"../../../docs/theory/spw/operators.spw"
  .. ~<valence>"../../../docs/theory/spw/valence-architecture.spw"
  .. ~<audio>"../../../docs/theory/spw/audio-architecture.spw"
}

