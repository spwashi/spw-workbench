# v0.2.0 Library Theory Bridge

#:layer #!grammar

^"ual"{
  name: "Unified Augmentation Language",
  claim: "The four brace constructs are primordial and broadly reusable across C-ish language ecosystems."
}

^"primordial_braces"{
  "<>": { register: "concept", question: "what is becoming?" }
  "()": { register: "scene", question: "who observes / from where?" }
  "[]": { register: "mode", question: "under what framing?" }
  "{}": { register: "definition", question: "what is materially asserted?" }
}

^"spin"{
  baseline: "left brace carries objective scaffold; right brace carries subjective capture",
  opposite_spin_prompt: "Swap the orientation and test whether semantic commitments invert predictably.",
  status: "research-active"
}

^"brace_symmetry"{
  claim: "Selectors should be ergonomic from either left-brace or right-brace anchor across all four primordial containers.",
  ergonomic_goal: "L/R symmetric selection grammar for projection and reduction moves.",
  status: "design-proposed"
}

^"operator_reality"{
  operators: ["!", "^", "~", "?", "*", "=", "@", "#", ".", "&", "$", "%"],
  claim: "Every operator must be semantically real: parseable, interpretable, and inspectable."
}

^"accessor_polarity"{
  "#": { role: "extrinsic accessor", tendency: "projection-facing" }
  ".": { role: "intrinsic accessor", tendency: "reduction-facing" }
}

^"suffix_directionality"{
  "expr#": "projection suffix candidate (emit/select outward-facing properties)",
  "expr.": "reduction suffix candidate (collapse/select inward-facing properties)",
  status: "design-proposed"
}

^"flow_implications"{
  binding: "Bindings should preserve accessor polarity: `#`-biased bindings keep extrinsic projection intent; `.`-biased bindings keep intrinsic reduction intent.",
  indexing: "Index operations should be selector-aware so projection and reduction indexes remain distinguishable in traces.",
  braces_as_charge: "Brace orientation can be treated as charge (L/R bias) to model selection ergonomics across containers.",
  high_context_mode: "Context-rich lex/parse tolerates selector sugar and implicit axis coupling.",
  low_context_mode: "Strict lex/parse keeps only explicit operators/containers to reduce ambiguity and maximize deterministic tooling."
}

^"plane_axes"{
  liminality: "transitional <-> resolved",
  tangibility: "abstract <-> concrete",
  conception: "generative <-> instantiated",
  familiarity: "novel <-> known",
  salience: "background <-> foreground",
  objectivity_subjectivity: "external-grounded <-> perspectival",
  valence: "boon/bane/bone/bonk/honk",
  composition: "isolated <-> composite"
}

^"selection_pattern"{
  thesis: "Concept references should combine path + axis profile + brace context.",
  anti_pattern: "Path-only resolution in liminal spaces creates semantic collisions."
}

^"falsify"{
  disproof_signals: [
    "an operator exists without runtime or spec meaning",
    "brace mappings differ across architecture supports",
    "plane-axis references cannot be represented in .spw architecture surfaces"
  ]
}

^"strata_scaffolds"{
