# v0.2.0 Library Layout Map

#:layer #!grammar

^"strata"{
  core: {
    role: "kernel contracts",
    path: "../core",
    status: "authored v0.2 stubs"
  }

  runtime: {
    role: "execution/state contracts",
    path: "../runtime",
    status: "authored v0.2 stubs"
  }

  dialects: {
    role: "syntax families",
    path: "../dialects",
    status: "authored v0.2 stubs"
  }

  domains: {
    role: "posture/profile/taste",
    path: "../domains",
    status: "authored v0.2 stubs"
  }

  applications: {
    role: "applied expression surfaces",
    path: "../applications",
    status: "authored v0.2 stubs"
  }

  infra: {
    role: "infra conformance",
    path: "../infra",
    status: "authored v0.2 stubs"
  }
}

^"pairings"{
  markdown: [
    "../README.md",
    "../ARCHITECTURE.md",
    "../LAYOUT.md",
    "../DELTAS.md"
  ]

  spw: [
    "./index.spw",
    "./layout.spw",
    "./theory-bridge.spw",
    "../core/index.spw",
    "../runtime/index.spw",
    "../dialects/index.spw",
    "../domains/index.spw",
    "../applications/index.spw",
    "../infra/index.spw"
  ]
}

^"normalization"{
  filename_policy: "kebab-case for architecture supports",
  review_policy: "keep layout edits adjacent to delta notes",
}

?["What parse-time guarantee does this surface provide?"]
  #:scope #!file
  ~#probe: "trace references to this surface"

