# v0.2.0 Library Layout Map

#:layer #!grammar

^"strata"{
  core: {
    role: "kernel contracts",
    path: "../core",
    status: "authored v0.2 stubs"
  }

  runtime: {
    role: "execution/state contracts",
    path: "../runtime",
    status: "authored v0.2 stubs"
  }

  dialects: {
    role: "syntax families",
    path: "../dialects",
    status: "authored v0.2 stubs"
  }

  domains: {
    role: "posture/profile/taste",
    path: "../domains",
    status: "authored v0.2 stubs"
  }

  applications: {
    role: "applied expression surfaces",
    path: "../applications",
    status: "authored v0.2 stubs"
  }

  infra: {
    role: "infra conformance",
    path: "../infra",
    status: "authored v0.2 stubs"
  }
}

^"pairings"{
  markdown: [
    "../README.md",
    "../ARCHITECTURE.md",
    "../LAYOUT.md",
    "../DELTAS.md"
  ]

  spw: [
    "./index.spw",
    "./layout.spw",
    "./theory-bridge.spw",
    "../core/index.spw",
    "../runtime/index.spw",
    "../dialects/index.spw",
    "../domains/index.spw",
    "../applications/index.spw",
    "../infra/index.spw"
  ]
}

^"normalization"{
  filename_policy: "kebab-case for architecture supports",
  review_policy: "keep layout edits adjacent to delta notes",
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
