#>wonder_agents_skills_spwontologyworkbench_asset_1
?["What ripples if #ontology_skeleton changes in this file?"]{
  #:depth #!mathematical // lens: formal structure
  $#educational@workspace => %[reference.count, depth.downstream]
  ~#downstream: "trace all files that reference this surface"
  !probe{ "imagine renaming #educational to #educational_v2; count broken references; the count reveals how deeply ^seed[ontology v:0.2 @profile:spw.b] is woven into the workspace." }
  $%[file.frame_count, file.annotation_density, file.brace_depth_max]
}

#>wonder_agents_skills_spwontologyworkbench_asset_2
?["What happens when you zoom from the workflow level to the workspace level in ^seed[ontology v:0.2 @profile:Spw.b]?"]{
  #:depth #!stylistic // lens: material grain
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "ontology v:0.2 @profile:Spw.b" // this file's atom
  !probe{ "the atom is workflow-scale; zoom out: what workspace-level pattern does this workflow participate in?" }
  $%[file.frame_count, file.annotation_density, file.brace_depth_max]
}
