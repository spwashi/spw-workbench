# Spw Domain Taxonomy
# version: 0.1.0

^["taxonomy"]{
  @physical: "The lowest substrate. Geometry, material properties, hardware registers."
  @symbolic: "Linguistic and symbolic relations. Lexemes, tokens, types."
  @logical: "Pure logic and combinatorics. Functions, constraints, proofs."
  @experiential: "The human-in-the-loop. UI, UX, affect, taste."
  @social: "Community and protocol. Commits, episodes, contributors, governance."
}

^["layer_flow"]{
  ~#direction: "infra ← platform ← app ← ui"
  ~#enforcement: "Inner layers must not import outer layers."
}
