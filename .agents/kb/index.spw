# Agent KB Index
# version: 0.1.0

#:layer #!pragmatics

^["entries"]{
  layering: .{
    file: ".agents/kb/layering.spw"
    purpose: "Local layer and boundary reminders for agent-facing work."
  }
  taxonomy: .{
    file: ".agents/kb/taxonomy.spw"
    purpose: "Local domain vocabulary for physical, symbolic, logical, experiential, and social readings."
  }
  valence: .{
    file: ".agents/kb/valence.spw"
    purpose: "Local boon/bane/bone/bonk/honk reference for change review."
  }
}
