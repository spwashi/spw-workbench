# Spw Valence Pentad
# version: 0.1.0

^["valence"]{
  @boon: "Positive growth, beneficial accumulation, healing, clarity."
  @bane: "Negative friction, destructive cost, entropy, noise."
  @bone: "Structural stability, skeletal invariant, neutral fact."
  @bonk: "Collision, hard limit, boundary violation, error."
  @honk: "Signal, attention call, emergent event, surprise."
}

^["usage"]{
  ~#intent: "Every component change should be described through how it affects these five qualities."
}
