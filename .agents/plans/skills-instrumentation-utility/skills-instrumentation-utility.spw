# Skills Instrumentation Utility Contract

#:layer #!pragmatics

^["utility_contract"]{
 file: "scripts/spw-lib.sh",
 purpose: "shared Spw output framing and argument parsing for skill scripts",
 guarantees: [
 "stable section/set/facet/affordance wrappers",
 "filter_path support for scoped scans",
 "portable file-count utilities"
 ]
}

^["instrumentation_affordances"]{
 baseline: [
 "npm run lint:spw",
 "npm run audit",
 "npm run analyze:perturb"
 ],
 release_gates: [
 "npm run lint:v020",
 "npm run lint:v020:runtime",
 "npm run lint:v020:architecture"
 ]
}

^["falsify"]{
 disproof: [
 "skill scripts fail due to missing shared utility",
 "skill tooling references commands not present in package scripts",
 "instrumentation output diverges across skills without shared wrappers"
 ]
}

#>wonder_agents_plans_skillsinstrumentationutilit_1
?["How would a biology portfolio express utility_contract?"]{
  #:depth #!stylistic // lens: living system
  ~#translation_target: "biology"
  ~#source_concept: "utility_contract"
  !probe{ "rewrite the root frame in biology vocabulary; where the translation breaks reveals Spw's untranslatable concepts." }
  $%[runtime.stage, runtime.queue_depth]
}

#>wonder_agents_plans_skillsinstrumentationutilit_2
?["How does this file's voice differ from skills-instrumentation-utility/skills-instrumentation-utility (skills-instrumentation-utility/skills-instrumentation-utility)?"]{
  #:depth #!educational // lens: curated collection
  ~<@_> // nearest neighbor
  $%[op.distribution]@here vs $%[op.distribution]@_
  !probe{ "compare operator frequencies; files with similar content but different operator ratios have different voices." }
}
