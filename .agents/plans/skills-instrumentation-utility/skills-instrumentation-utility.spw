# Skills Instrumentation Utility Contract

#:layer #!pragmatics

^["utility_contract"]{
  file: "scripts/spw-lib.sh",
  purpose: "shared Spw output framing and argument parsing for skill scripts",
  guarantees: [
    "stable section/set/facet/affordance wrappers",
    "filter_path support for scoped scans",
    "portable file-count utilities"
  ]
}

^["instrumentation_affordances"]{
  baseline: [
    "npm run lint:spw",
    "npm run audit",
    "npm run analyze:perturb"
  ],
  release_gates: [
    "npm run lint:v020",
    "npm run lint:v020:runtime",
    "npm run lint:v020:architecture"
  ]
}

^["falsify"]{
  disproof: [
    "skill scripts fail due to missing shared utility",
    "skill tooling references commands not present in package scripts",
    "instrumentation output diverges across skills without shared wrappers"
  ]
}

?["How does selector expansion compose across nested $-expressions?"]
  #:depth #!educational  // lens: collection
  $($@_ => $^[_]) => &[result.flatten]
  ~<@spw/conventions/selection.spw>
  !probe{ "expand $@biome/$^[algos] step by step; show intermediate selector states like a debugger" }

?["Is selector composition associative? Does ($a => $b) => $c equal $a => ($b => $c)?"]
  #:depth #!mathematical  // lens: formula
  ~#left_assoc: "$($@docs => $^[theory]) => $#concept"
  ~#right_assoc: "$@docs => $($^[theory] => $#concept)"
  !probe{ "enumerate cases where associativity breaks; these are the interesting compositional edges" }
