^["intent"]{
 ~#goal: "One reading of a line in seed, the browser reader and every host: a pair names its slot by its kind, never by its position"
 ~#taste: "The medial relation keeps its meaning wherever a word follows the capsule; only a pair after the capsule, or a capsule after an operation's own slots, changes reading"
}

