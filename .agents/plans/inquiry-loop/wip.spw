# wip — inquiry-loop
# Started: 2026-11-06

#>plan_inquiry_loop
#:plan #!execution_truth
#:layer #!pragmatics

!["card"]{
 phase: #seed
 gist: "A wonder can close: its probe runs read-only, the run is a result_ref receipt, and a reader writes the answer"
 touches: [~".spw/harness/claim-protocol.spw", ~"packages/spw-lsp/src/handlers/wonder.ts", ~".agents/plans/_schema/wip-template.spw"]
 entry: ~"./PLAN.md"
 next: "~[lifecycle_fixture]: a fixture wonder at each stage (open, probed, answered, retired) that the harvest and the editor read alike; then ?[wonder_is_claim] before receipts land on claims."
}

^["edges"]{
 shares: [~"../vscode-authoring-probe-loop/wip.spw", ~"../plan-plugin-integration/wip.spw", ~"../plan-tooling-design/wip.spw", ~"../first-plugin/wip.spw", ~"../ask-exchange/wip.spw"]
 needs: [~"../cli-mode-overhaul/wip.spw"]
}

^["roots"]{
 @plan: ~".agents/plans/inquiry-loop/PLAN.md"
 @claim_protocol: ~".spw/harness/claim-protocol.spw"
 @wonder_reader: ~"packages/spw-lsp/src/handlers/wonder.ts"
 @schema: ~".agents/plans/_schema/wip.spw"
 @template: ~".agents/plans/_schema/wip-template.spw"
}

^["intent"]{
 ~#goal: "Questions stop staying open only because nothing records that they were checked"
 ~#taste: "A run proposes, a reader decides; one vocabulary for an answered wonder and a confirmed claim, if the owner agrees they are one unit"
}

^["intake"]{
 # The capability asks a mounted consumer filed on 2026-10-27, and where each lives in this repo. Ranks are the consumer's.
 source: "consumer-relative .spw/reviews/upstream-workbench-recommendations/capabilities.spw, frame capabilities_asks; wonder_harvest in corpus-and-cli.spw; questions_as_facts in architecture.spw; plan_twinkle, probe_receipts and twinkle_lens in plugins-and-tooling.spw"
 inquiry_loop: .{ rank = 1 contract = "inquiry.loop/1" home = @plan status = #owned }
 axis_canon: .{ rank = 2 contract = "header.axes/1" home = ~"../naming-profile-convention-align/wip.spw" status = #routed }
 ground_edge_home: .{ rank = 3 contract = "reading.ground-edge/1" home = ~"../ground-edge-reading/wip.spw" status = #owned }
 nested_wonder: .{ rank = 4 contract = "wonder.nesting/1" home = ~"../vscode-authoring-probe-loop/wip.spw" status = #routed }
 plan_shape: .{ rank = 5 contract = "plan.shape/1" home = ~"../plan-plugin-integration/wip.spw" status = #routed }
 plan_rules: .{ rank = 6 contract = "plan.rules/1" home = ~"../plan-plugin-integration/wip.spw" status = #routed }
 probe_stream_type: .{ rank = 7 contract = "stream.types/1" home = @plan status = #owned }
 measure_or_answer: .{ rank = 8 contract = "wonder.answer_set/1" home = ~"../vscode-authoring-probe-loop/wip.spw" status = #routed }
 wonder_harvest: .{ home = @plan status = #owned }
 questions_as_facts: .{ home = @plan status = #owned }
 plan_twinkle: .{ rank = 15 home = ~"../first-plugin/wip.spw" status = #routed }
 probe_receipts: .{ rank = 16 home = @plan status = #owned }
 twinkle_lens: .{ rank = 17 home = ~"../plan-plugin-integration/wip.spw" status = #routed }
 slot_goal: .{ asked = "2026-11-05" home = ~"../brace-slot-reading/wip.spw" status = #owned }
 goal_per_ask: "From 2026-11-05 each consumer ask names the expressiveness goal it serves (consumer .spw/language/v04/roadmap.spw, frame expressiveness_goals); each home plan's intent names the goal it takes"
 wonder_list: .{ rank = 18 contract = "wonder.list/1" home = @plan status = #owned }
 wonder_editors: .{ rank = 19 contract = "wonder.list/1" home = ~"../editor-inspection-instruments/wip.spw" status = #routed }
}

^["replies"]{
 # Corrections the consumer can take on its next pin. Read from the consumer tree on 2026-11-06; not written there.
 ground_edge_home: "spw-beat-diff-precipitation was rescoped to cache TTLs before the ask was filed; the home is ground-edge-reading"
 axis_canon: "naming-profile-convention-align is dormant and holds no axis rows; the route stands, and the ask reheats it"
 parse_entrypoint_alignment: "parseExpression parses the whole expression or reports completeness since 85554442; the hub still reads it open, and the claim that it 'truncates 457 of 460 at the leading identifier' (.spw/caches/spw-design-improvements-2026-11.spw) does not reproduce: home[hook]{orient}<atlas> parses complete with frame, body and capsule at dbd138dd"
 pipe_mark: "seed already lexes | as a connector, and a | that ends its line opens a block scalar (packages/spw-seed/src/grammar/block-scalar.ts); | as a later mark meets those two readings first"
 slot_goal_scope: "seed reads [] {} () in any order already; the gap is <…> straight after the word, and <…> after an operation's own slots, which the consumer did not report (brace-slot-reading)"
 plans_root: "walkers read .agents since a4e548d; only the archive tier is still open"
 lone_dot_part: "kitchen{.bread{flour, water}} losing its mark (the consumer's cache brace-literal-local-law-2026-11, dot) is seed's line reader, not the canvas: partsOf splits at a dot that opens the body. Seed's parser already keeps the mark, so the fix follows the grammar (syntax-hardware-alignment p15, line-kit parts_as_parsed). Read from the consumer tree on 2026-11-09."
 shape_as_holes: "the canvas's structural formula (~·[]{,}<>) can be written with the hole seed already has: ~_[_]{_, _}<_> reads as one whole line in the line reader, so a shape can be a query with no second notation (syntax-hardware-alignment p17; wonder_trial_shape). Read on 2026-11-09."
 one_order: "all 387 single expression lines under the consumer's .spw tree are word first in one slot order, and five shapes cover 84% of them (journal 2026-11-09-reader-agreement); any-order slots are so far a canvas gesture"
}

^["open"]{
 # Unresolved questions. When resolved: log in stream, then move to ^["done"] as ~#resolved(label).
 ?[wonder_is_claim]: "Is an answered wonder a confirmed claim, or does a claim need a negative_control a wonder does not carry? (the consumer's question; 198 of its 321 claim units are written from a template and would close on nothing)"
 ?[verb_home]: "Does the harvest and runner live under spw wonder, under spw plan, or as the second plugin's runner?"
 ?[probe_line_type]: "Is a probe line an observe with a wonder attached, or a type of its own?"
 ?[lifecycle_spelling]: "Does a wonder's stage also print in its mode slot, ?name[probed]{…}, as a mounted consumer proposed for its contour, or stay derived from its marks only?"
 ?[never_closes]: "Is there a stage for a wonder kept open on purpose? One host refuses to fold a question's body, and a second mounted consumer closes a wonder by keeping or answering it and holds one that is never answered. open, probed, answered and retired has no rung for that."
}

^["commits"]{
 # Named, in order. Planned ~[name]; landed .[name](hash). Names are never reused.
 ~[lifecycle_fixture]: "![lsp,cli] — fixture wonders at each stage; the editor's wonder reader and the harvest report the same lifecycle"
 ~[lifecycle_reading]: "&[seed,lsp] — one lifecycle reader (open, probed, answered, retired) from ~#expect, a probe stream line naming the wonder, ~#answer and ~#retired"
 ~[probe_stream_type]: ".[plans] — probe joins the wip template's stream types, and a wonder id in a stream line links and hovers (after ?[probe_line_type])"
 ~[probe_runner_l0]: "&[cli] — run each ~#probe(run) whose command is read-only by a declared allowlist; hold and name the rest"
 ~[run_receipts]: "&[cli] — each run is kept as a result_ref candidate: date, command, exit, observation; no verdict"
 ~[answer_is_result_ref]: "#[harness] — claim-protocol.spw says an answered wonder's receipt is a claim's result_ref (after ?[wonder_is_claim])"
 ~[wonder_list_request]: "&[lsp] — spw/wonderList: one request returns every wonder in a workspace with its stage, anchor, file and what it unblocks, read by lifecycle_reading, so VS Code, IntelliJ and Neovim each show the same list in their own idiom (a mounted consumer lists 383 wonders by script; its ranks 18 and 19)"
}

^["stream"]{
 >>[2026-11-06 17:24] observe — A mounted consumer filed eight capability asks on 2026-10-27 and two more on 2026-11-05; no workbench plan read them. Its own loop runs: scripts/wonder.mjs --run executed 44 read-only probes in 13 s on 2026-10-27 and keeps receipts in .spw/gen/wonder-runs.spw. The workbench has the receipt shape (result_ref in .spw/harness/claim-protocol.spw) and a wonder reader (wonder.ts, BRACE_BODY_LINES = 11), but no runner and no lifecycle.
 >>[2026-11-06 17:24] decide — This plan owns the loop and the intake for the capability asks; every other ask joins the plan that owns its files, as first-plugin did for the plugin asks. ^["replies"] holds what the workbench would tell the consumer, kept here rather than written into the consumer tree.
 >>[2026-11-06 17:24] note — ^replies is the first content of ask-exchange replies_file, and this plan's ^intake becomes a citation into its intake (ask-exchange intake_moves); both stay here until those land.
 >>[2026-11-06 18:10] note — ?[lifecycle_spelling] and ?[wonder_is_claim] are held as an owner trial, interpretation-trials wonder_trial_question_state, grounded in interrogative mood and evidentiality.
 >>[2026-11-09 17:11] note — Three replies added from a read of the consumer tree on 2026-11-09: the lone dot part is in seed line reader and the parser already keeps the mark; a shape can be written with holes; and no typed line there departs from one slot order. Evidence: journal 2026-11-09-reader-agreement.
 >>[2026-11-09 18:12] observe — Wonder across three hosts, read 2026-11-09. The site consumer lists 383 wonders by script and asks for one request every editor can show (wonder_list_request planned; its ranks 18 and 19). The canvas host refuses to fold a question body. A second mounted consumer veils a wonder until a reader meets it, closes it by keeping or answering it, and holds one that is never answered. The lifecycle has no rung for a wonder kept open on purpose: never_closes opened. The three theory wonders in docs/theory/spw/threshold-distance.spw each carry a probe a runner could run read-only.
 >>[2026-11-09 18:28] observe — Counted here on 2026-11-09: 747 wonder anchors outside archives, 58 with an expect, 22 answered, 34 with the answer left as a hole, 1 retired; 1,448 probe blocks, 2 marked to run. Nearly every probe is a prompt, so a runner has almost nothing to run. docs/theory/spw/wonder-field.spw gives the reading (a wonder is one edit past a line that reads; a question is the set of its resolutions; three kinds of probe by what they leave) and seven wonders, five with a command that works in this repo today, as the first input for probe_runner_l0. Replies to keep for the consumers: the share fragment is text and not a tree in all five implementations; of a second consumer ten stress findings re-run on main in minimal form, six hold, two hold in part, two do not reproduce without its file.
 >>[2026-11-09 19:01] note — Reply to keep for a second mounted consumer: its valence_word_as_key finding is fixed in the working tree of 2026-11-09 (a valence word before a colon is a key; eight of its seventeen degraded surfaces read again), and reaches it on the pin after that commit. Its everyday_valence ask is met for keys and hyphenated names; a lone valence word as a whole value is still a charge.
}

