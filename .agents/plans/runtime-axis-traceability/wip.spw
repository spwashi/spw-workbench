#>wonder_agents_plans_runtimeaxistraceability_wip_1
?["Which of disclosure, affect, resolution and noise has a runtime constant that deserves a marker, given that none of the 9 landed markers names them?"]{
  #:depth #!computational // lens: audit coverage
  $^["open"]@here => $^["commits"]@here
  ~#hypothesis: "at most one of the four has a real constant behind it; the rest would be ornamental if added now."
  !probe{ "npm run audit:markers -- --tag=axis lists the 9 markers; then grep the runtime for thresholds, clamps and caps in packages/spw-runtime/src/state and pipeline and ask for each whether disclosure, affect, resolution or noise explains why it exists." }
  $%[axis.marker_count, axis.unmarked_constants]
}
