^["intent"]{
 ~#goal: "Make multi-file selection and refactoring a reversible experiment lifecycle: revisioned select → semantic plan as data → intermediate projections → hash-gated apply (worktree or workspace) → verify → git episode — one spine, many front-ends."
 ~#taste: "correctness under drift, plan-first honesty, intermediate Spw as human patch language, VCS as durability not second semantics"
 ~#why_now: "semantic-edit already promises patches-as-values; refactor/bias/mutate do not yet share a durable plan id or worktree sandbox"
 ~#non_goal: "auto-commit carnival; OT research project; replacing pulse single-file atomic path"
}

^["development"]{
 lane: #execution_truth
 ladder: #service
 develops: [#refactor_algebra, #vcs_ergonomics, #agent_handoff, #taste]
 review_surfaces: [@plan, @artifact, @semantic_edit, @refactor_cli, @pulse_doc, @curiosity]
 snippet_routes: [#plan_schema, #selection_hash, #worktree_apply, #episode_trailer]
 grows_judgment: [
  "when is a selection frozen enough to plan?",
  "when must apply refuse vs rebase?",
  "what belongs in Spw intermediate vs JSON only?",
 ]
}

^["concept_index"]{
 primary: [
  #refactor_plan,
  #selection_corpus,
  #content_hash,
  #intermediate_surface,
  #worktree_l1,
  #hash_gated_apply,
  #episode_record,
 ]
 surfaces: [#seed, #cli, #schemas, #docs, #lsp, #git, #gen]
 tensions: [
  #stale_plan,
  #multi_file_transaction,
  #mount_refuse,
  #gen_retention,
  #compat_oneshot_refactor,
 ]
 transfers: [
  #query_selection,
  #semantic_edit,
  #bias_patch,
  #pulse_health,
  #emit_brief,
  #curiosity_candidate,
  #lsp_workspace_edit,
 ]
 vocabulary: .{
  selection: "frozen set of uri + contentHash (+ optional revision)"
  plan: "spw.refactor.plan/1 — rules, edits, ceiling, parent_plan, selection hash"
  receipt: "apply result: applied edits, skipped, conflicts, tree kind"
  intermediate: "plan.json | patch.spw | emit brief | editor multi-diff — same plan.id"
  worktree_l1: "filesystem sandbox equivalent of effect.l1.memory for multi-file"
  workspace_l2: "durable consumer tree write under hash gate"
 }
}

^["lifecycle"]{
 stages: [
  .{ id: select, ceiling: effect.l0.measure, out: "selection.json" },
  .{ id: plan, ceiling: effect.l0.measure, out: "plan.json | patch.spw" },
  .{ id: check, ceiling: effect.l0.measure, out: "ok | stale | conflict" },
  .{ id: apply_worktree, ceiling: effect.l1.worktree, out: "worktree + receipt" },
  .{ id: apply_workspace, ceiling: effect.l2.workspace, out: "tree + receipt" },
  .{ id: verify, ceiling: effect.l0.measure, out: "report" },
  .{ id: record, ceiling: git, out: "episode commit + Spw-Plan trailer" },
 ]
 spine: "plan.id appears in every projection and the commit trailer"
 refuse: [
  "apply when any contentHash mismatches",
  "apply overlapping edits without conflict report",
  "write mounted infrastructure without explicit policy",
  "absolute paths in plan or commit body",
 ]
}

^["effect_matrix"]{
 # Align with pulse-mutate-beat; add worktree rung for multi-file experiment
 effect.l0.measure: "select, plan, check, verify — no durable write"
 effect.l1.memory: "stdin/buffer apply (existing mutate --stdin)"
 effect.l1.worktree: "NEW — apply plan into git worktree; main clean"
 effect.l2.workspace: "hash-gated multi-file write to consumer tree"
 effect.l3.external: "refused (same as pulse)"
 note: "pulse multi-file refuse stays; experiments use explicit refactor apply path"
}

^["intermediate_surfaces"]{
 plan_json: .{
  role: "agent review, CI artifact, LSP load"
  location: ".spw/gen/experiments/<id>/plan.json"
 }
 patch_spw: .{
  role: "human-editable bias/experiment surface"
  location: ".spw/gen/experiments/<id>/patch.spw"
  compile: "bias edges + metadata → SemanticRule[] → plan"
 }
 emit_brief: .{
  role: "PR / agent prose from plan summary"
  tool: "spw emit or thin formatter over plan.summary"
 }
 editor_diff: .{
  role: "WorkspaceEdit / neovim multi-diff from plan.edits"
  status: #proposed
 }
 receipt_json: .{
  role: "what actually applied; inputs to verify + episode"
  location: ".spw/gen/experiments/<id>/receipt.json"
 }
 policy: .{
  gen_default: "gitignore gen/experiments unless research pins patch.spw"
  canon: "gen is never second canon root without ~#status"
 }
}

^["selection_model"]{
 fields: #[uri, contentHash, revision?]
 hash: "content hash of file bytes (or normalized? decide — default raw utf8)"
 drift: "re-select → added | removed | changed | unchanged"
 filter: "optional SpwPattern — same vocabulary as spw query"
 excludes: "node_modules, dist, _workbench, .git — align fs-walk"
 canary: "first N files | single root | atlas hub cluster"
}

^["plan_model"]{
 schema: "spw.refactor.plan/1"
 fields: [
  id,
  created_at,
  selection_hash,
  files: "uri+contentHash[]",
  rules: "SemanticRule ids / serialized specs / bias path",
  edits: "SemanticEdit[] with reason, effectGrade, stratum",
  conflicts,
  effectCeiling,
  parent_plan,
  summary: "counts by file, by stratum, by grade",
 ]
 ops: #[compose, check, rebase]
 rebase: "re-select → re-plan rules → parent_plan link → conflict report"
}

^["vcs_integration"]{
 worktree: .{
  create: "git worktree add <path> -b spw/experiment/<id>"
  apply: "write files under worktree root only"
  discard: "git worktree remove + branch delete"
  merge: "human or agent merges branch — not silent"
 }
 commit: .{
  when: "after successful workspace apply OR explicit record of worktree accept"
  subject: "sigil[scope] — experiment <short-id>"
  body: "exactly one #[episode]{ … } block"
  trailer: "Spw-Plan: <id>"
  trailer_hash: "Spw-Selection-Hash: <selection_hash>"
  privacy: "no /Users/ or machine-local paths"
 }
 history: "git log --grep=Spw-Plan: for experiment archaeology"
}

