# ── Wonders (species: algebraic, reverse-edge, thrift, vcs) ──

#>wonder_refactor_experiment_lifecycle_1
?["What is the algebraic closure of a refactor plan under rebase?"]{
  ~#blocked_on: "rebase is a named omission in refactor-plan.ts; no parent_plan field exists yet"
  #:depth #!computational
  #:species #!algebraic_closure
  $^["plan_model"]@here => %[formula.compose]
  !probe{ "compose plan A then rebase onto moved selection: which fields are invariant (id lineage, rules) vs recomputed (edits, hashes)?" }
  $%[file.frame_count, plan.phase_progress]
  ~<packages/spw-seed/src/canonical/semantic-edit.ts>
}

#>wonder_refactor_experiment_lifecycle_2
?["Does plan-only refactor cost scale linearly with file count, and is the time in parsing or in rule evaluation?"]{
  #:depth #!computational
  #:species #!thrift
  ~#hypothesis: "about 0.12 to 0.14 s per file, dominated by parse, so a hash gate that re-reads every file at apply time doubles the cost."
  !probe{ "time npm run -s spw -- refactor docs --rename mark:present=presentX --json (149 files, 17 s when measured) against the same command on .spw (788 files, 112 s); then profile one file's planSemanticEdits against parse(); never pass --write." }
  $%[plan.files, plan.wall_seconds]
  ~<packages/spw-cli/src/refactor.ts>
}

#>wonder_refactor_experiment_lifecycle_4
?["When is an intermediate surface thriftless theater?"]{
  ~#blocked_on: "~[bias_plan_compile] — bias-apply.ts exists but no patch.spw compile to a plan does"
  #:depth #!mathematical
  #:species #!felt_rhythm
