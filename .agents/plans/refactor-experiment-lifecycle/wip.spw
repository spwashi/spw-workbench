 ?[subcommand_shape]: "spw refactor plan|check|apply vs spw experiment … as top-level group?"
 ?[partial_apply]: "allow non-overlapping subset apply on conflict, or always all-or-nothing for workspace l2?"
 ?[worktree_path]: "convention under repo .spw/gen/worktrees vs sibling directory — security and mount policy?"
 ?[selection_revision]: "is git blob oid worth storing alongside contentHash, or hash-only?"
 ?[bias_roundtrip]: "must patch.spw round-trip after plan compile, or one-way compile is enough for v1?"
 ?[lsp_when]: "WorkspaceEdit from plan in this branch or strictly editor follow-on?"
 ?[streaming]: "large monorepo selection — stream edits per file vs full plan in memory?"
}

