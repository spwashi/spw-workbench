# ── Wonders (species: algebraic, reverse-edge, thrift, vcs) ──

#>wonder_refactor_experiment_lifecycle_1
?["What is the algebraic closure of a refactor plan under rebase?"]{
  #:depth #!computational
  #:species #!algebraic_closure
  $^["plan_model"]@here => %[formula.compose]
  !probe{ "compose plan A then rebase onto moved selection: which fields are invariant (id lineage, rules) vs recomputed (edits, hashes)?" }
  $%[file.frame_count, plan.phase_progress]
  ~<packages/spw-seed/src/canonical/semantic-edit.ts>
}

#>wonder_refactor_experiment_lifecycle_2
?["What is conspicuously absent from multi-file mutate that plan lifecycle must supply?"]{
  #:depth #!educational
  #:species #!blind_spot
  ~#present: [#profile, #dry_run, #multi_path]
  ~#expected_but_missing: "frozen selection hash + durable plan id + worktree sandbox"
  !probe{ "list mutate flags; list pulse refuse conditions; the gap is the experiment spine" }
  $%[file.frame_count, file.annotation_density]
  ~<packages/spw-cli/src/mutate.ts>
  ~<docs/runtime/md/pulse-mutate-beat.md>
}

#>wonder_refactor_experiment_lifecycle_3
?["Does reversing apply direction (workspace → plan) change meaning?"]{
  #:depth #!stylistic
  #:species #!reverse_edge
  !probe{ "git diff after ad-hoc edit cannot always reconstitute SemanticRule; plan→tree is generative, tree→plan is archaeology — name the loss" }
  $%[line.operator_density]
  ~<.agents/plans/refactor-experiment-lifecycle/PLAN.md>
}

#>wonder_refactor_experiment_lifecycle_4
?["When is an intermediate surface thriftless theater?"]{
  #:depth #!mathematical
  #:species #!felt_rhythm
  !probe{ "if patch.spw is only JSON with braces, delete it; thrift = human can edit poles without fighting the format" }
  $%[file.brace_depth_max, line.operator_density] => ~#reading_feel
  ~<packages/spw-cli/src/bias-apply.ts>
}

#>wonder_refactor_experiment_lifecycle_5
?["How does effect.l1.worktree teach the practice circuit?"]{
  #:depth #!educational
  #:species #!ecological_zone
  // wonder → substrate(selection) → potentiation(plan) → cluster(canary)
  // → confluence(multi-file edits) → performance(apply) → evaluation(verify)
  // → metareference(episode + Spw-Plan trailer)
  !probe{ "map each lifecycle stage to the practice circuit; where do humans drop the thread today?" }
  $%[process.iteration_count]
  ~<.agents/plans/curiosity-mutation-ergonomics/curiosity-mutation-ergonomics.spw>
}
