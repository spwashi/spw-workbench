^["risk_model"]{
 hard_failures: [
  "apply with stale contentHash silently",
  "overlapping edits last-writer-wins without conflict",
  "worktree path outside policy / escapes repo",
  "plan stores absolute user paths",
  "mounted _workbench corpus rewritten by default",
 ]
 soft_failures: [
  "gen/experiments disk junk",
  "oneshot refactor and plan apply diverge in edge cases",
  "rebase produces empty plan after corpus delete",
  "large selection OOM — need streaming or canary",
 ]
 recoveries: [
  "refuse apply + print which uris drifted",
  "withhold conflict cluster; allow non-overlapping subset apply only if flagged",
  "worktree remove on failure optional",
  "compat path keeps legacy refactor --write",
 ]
 non_negotiables: [
  "plan-first default (no write without explicit apply)",
  "hash gate on workspace apply",
  "effect grade on every edit",
  "privacy: no absolute user paths in commits or plans",
  "seed stays portable (git worktree is CLI edge, not seed)",
 ]
}

^["validation"]{
 hypotheses: [
  "stale hash refuse prevents half-applied multi-file renames",
  "worktree experiments increase safe throughput vs dirty main",
  "Spw patch intermediate improves human review quality vs json-only",
  "plan.id in git trailer enables archaeology of experiments",
  "canary-first reduces refuse_health surprises on full apply",
 ]
 negative_controls: [
  "spw refactor oneshot --write still works",
  "spw pulse single-file --write policy unchanged",
  "spw query selector vocabulary unchanged",
  "semantic-edit pure functions remain host-free",
 ]
 metrics: [
  "plan check: stale rate on dirty tree",
  "apply: files changed / conflicts / duration",
  "worktree: create+apply+remove smoke",
  "compat: golden oneshot rename fixture",
 ]
 demo_path: [
  "1 select prompts/** with hashes → selection.json",
  "2 plan mark:old=new → plan.json + optional patch.spw",
  "3 touch one file → check → stale refuse",
  "4 rebase/replan → check ok",
  "5 apply --worktree → run tests in worktree",
  "6 apply --workspace → receipt",
  "7 record episode commit with Spw-Plan trailer",
  "8 verify: query count of new mark; optional mass",
 ]
}

^["cli_sketch"]{
 # Proposed shape — refine at implement time; keep oneshot flags working
 select: "spw refactor select <targets> [--selector …] --json"
 plan: "spw refactor plan --selection sel.json --rename mark:a=b --json"
 plan_bias: "spw refactor plan --selection sel.json --bias patch.spw --json"
 check: "spw refactor check plan.json"
 apply_wt: "spw refactor apply plan.json --worktree <path>"
 apply_ws: "spw refactor apply plan.json --workspace --write"
 rebase: "spw refactor rebase plan.json --selection sel.json"
 record: "spw refactor record receipt.json  # episode helper"
}

^["stream"]{
 >>[2026-07-27] observe — semantic-edit.ts explicitly designs for plan storage, composition, rebase, agent-authored rules
 >>[2026-07-27] observe — spw refactor is plan-first oneshot: print or --write; no durable plan id or hash gate across time
 >>[2026-07-27] observe — bias-apply lifts Spw edges to ordered rewrite rules; natural intermediate language
 >>[2026-07-27] observe — pulse refuses multi-file --write; correct for reckless path; experiments need explicit multi-file accept
 >>[2026-07-27] observe — envelope exists for structured CLI; not yet universal on refactor
 >>[2026-07-27] observe — LSP rename is workspace-wide for annotations/@roots — special case of plan, not general experiment bus
 >>[2026-07-27] decide — spine is spw.refactor.plan/1; all intermediates share plan.id
 >>[2026-07-27] decide — effect.l1.worktree is the VCS seam for multi-file sandbox (CLI edge, not seed)
 >>[2026-07-27] decide — extend refactor CLI rather than new top-level command soup; keep oneshot compat
 >>[2026-07-27] decide — gen/experiments/<id>/ for plan/patch/receipt; gitignore default; pin patch when research needs it
 >>[2026-07-27] decide — seed owns plan types + check; CLI owns selection IO, worktree, git episode
 >>[2026-07-27] taste — intermediate Spw should feel like authoring, not dumping JSON into a .spw file
 >>[2026-07-27] taste — refuse is a feature; silent partial apply is the failure mode we design against
 >>[2026-07-27] note — compose curiosity (candidates), measure (verify), form-geometry (mobility edits) without reimplementing
 >>[2026-07-27] note — exit.ts already has refactor-apply refuse code 4; align check/apply failures with exit taxonomy
 >>[2026-07-27] hygiene — plan artifacts only until feature branch; exclude package *.d.ts noise
 >>[2026-07-27] note — mutation-flow-automata.spw: φ_lower → plan id; * worktree handle; selection as cell filter
 >>[2026-07-27] revise — shape-syntax-ecology; imagination/play; dialect-honest selection hashes
 >>[2026-08-24] implement — oneshot --json now emits spw.refactor.plan/1 inside the CLI envelope, with effect grade and named omissions for hashes, parent plan, worktree apply, and rebase. This is the review card, not the full lifecycle.
}

^["open"]{
