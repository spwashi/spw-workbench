#>plan_lukewarm_backlog
#:plan #!principal_engineering
#:layer #!pragmatics

^["card"]{
 phase: #dormant
 gist: "Lower-priority findings that are real but not hot sit here with evidence, a home plan and a reheat trigger."
 touches: [~"package.json", ~".agents/skills", ~"packages/spw-seed/src/canonical/dream-schedule.ts", ~"packages/spw-runtime/src/pipeline/stages.ts"]
 entry: ~"./PLAN.md"
 next: "Reheat only on a named trigger: when a home plan lands the commit named in its row, strike the item into ^done."
}

^["edges"]{
 shares: [~"../typescript-upgrade-ladder/wip.spw", ~"../audit-fuzz-truthfulness/wip.spw", ~"../measure-invariant-generalization/wip.spw", ~"../seed-roundness-grades/wip.spw", ~"../syntax-hardware-alignment/wip.spw", ~"../syntax-profile-stack/wip.spw", ~"../curiosity-mutation-ergonomics/wip.spw", ~"../precipitate-model-alignment/wip.spw", ~"../spw-q-stabilization/wip.spw", ~"../gap-affinity-tooling/wip.spw", ~"../obsidian-spw/wip.spw", ~"../hygiene-index-consolidation/wip.spw", ~"../vscode-register-explorer/wip.spw", ~"../runtime-dx-foundation/wip.spw"]
}

^["roots"]{
 @cluster: ~".agents/plans/plan-ecology-clustering/plan-ecology-clustering.spw"
 @plan: ~".agents/plans/lukewarm-backlog/PLAN.md"
 @schema: ~".agents/plans/_schema/wip.spw"
}

^["intent"]{
 ~#goal: "Hold findings that are verified against the repo but not yet worth a commit, so they are queryable, owned, and reheated by a named event instead of rediscovered."
 ~#taste: "claim discipline: every row cites what was read; a wrong item is corrected or dropped, never kept"
}

^["development"]{
 lane: #principal_engineering
 ladder: #service
 develops: [#claim_discipline, #taste]
 review_surfaces: [@plan]
 snippet_routes: [#query, #status_copy]
}

^["concept_index"]{
 primary: [#lukewarm, #heat_trigger, #cost_class, #home_plan]
 surfaces: [#docs, #cli, #runtime, #editor]
 tensions: [#drift, #scope, #stale_claim]
 transfers: [#service]
}

^["recursive_improvement"]{
 loop: [
  "? recheck an item against the repo before acting on it",
  "< when its heat trigger fires, move it into the home plan as a commit",
  "$ strike it into ^done with the evidence",
  "^ fold any wrong claim back as a correction row",
  "% keep one claim per line and one home per item",
 ]
 gates: [#claim_discipline]
}

^["parallel_work"]{
 critical_path: [#none]
 parallelizable: [#every_item]
 shared_hot_files: []
 merge_risks: [#stale_claim]
 handoff_artifacts: [@plan]
}

^["supporting_documents"]{
 must_ship: [@plan]
 helpful: [@schema]
 carries: [#source_map]
}

^["interaction_depth"]{
 subjects: [#legibility, #trust]
 questions: [#what_is_primary, #what_is_visible]
 qualities: [#clarity, #containment]
}

^["risk_model"]{
 soft_failures: ["an item goes stale while cold and is acted on without a recheck"]
 recoveries: ["every item names the command or path that re-verifies it"]
 non_negotiables: ["no item is recorded without having been read in the repo"]
}

