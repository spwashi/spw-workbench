^["intent"]{
 ~#goal: "Name intermediate IRs; reorient verbs for composition; generalize measure; dense l/x serialization; streams + * crystallize; globs everywhere sense multi-files."
 ~#taste: "abstract navigation; functional composition; alias-safe renames"
}

^["ir_spine"]{
 #[PreprocessIR, ParseIR, StackIR, FormIR, GraphIR, MeasureIR, SelectionIR, PlanIR, StreamIR, PrecipitateIR, CacheIR, EnvelopeIR]
}

^["renames"]{
 invent => census  # also roster|inventory|survey - rec census
 mass => measure   # mass becomes subcommand family
 profile => surface  # stack thin; profile alias -> stack lens
 map => graph dual  # or keep map primary one release
}

^["naming_rec"]{
 surface: #[show, stack, form, graph, ego, thrift, mass, exp, outline, frames, dialect, review, format, health, all, dump]
 census: #[list, summary, hubs, leaves, orphans, bridges, adrift, roles, paths, dialects, profiles, frames, size, stale, export]
 measure: #[mass, thrift, size, authority, density, health, drift, claim, scheme, families, schemes, hits, formula, taste, diff, report]
 graph: #[show, hubs, orphans, leaves, cycles, components, bridges, ego, neighbors, path, paths, edges, nodes, degree, matrix, export]
 geometry: #[show, pairs, braces, ops, depth, lessons, fingerprint, ladder, mobility, compare]
 exp: #[list, show, used, search, related, missing, export]
 stream: #[read, follow, batch, window, cat, filter, head, tail, stats, export, crystallize]
 crystallize: #[window, op, out, into]
 bench: #[parse, query, pulse, surface, measure, graph, census, lsp_hover, all]
 atlas: #[summary, html, trend, advice, save, diff, show, graph, census]
}

^["naming_alts"]{
 surface_also: #[card, face, portrait, sheet, dossier, lens, who, inspect, describe]
 census_also: #[roster, inventory, survey, population, tally, ledger, rollcall, manifest]
 measure_also: #[gauge, meter, assay, thrift, reconcile, observe]
 graph_also: #[map, topo, lattice, mesh, net, deps, constellation, nav]
 crystallize_also: #[fold, seal, freeze, collapse, capture, snap, materialize]
 bench_also: #[perf, time, budget]
 never: #[profile_for_cpu, bare_m, bare_s, bare_p, unquoted_star_cli]
}

^["compose_styles"]{
 #[
  "verb_noun: spw measure mass x"
  "flag_family: spw measure x --family mass"
  "pipe_ir: spw census x --json | jq"
 ]
}

