 #[
  "spw surface path.spw"
  "spw census prompts/** --sort degree -n 30"
  "spw measure mass path.spw"
  "spw graph ego path.spw --depth 2"
  "<< ~ ; ? ; % ; ! ; * ; ^ >>"
 ]
}

^["open"]{
 ?[selection_contract]: "What does SelectionIR carry once built: uris only, or uris plus contentHashes and the originating globs, and may --json envelopes expose the glob that produced a selection?"
 ?[quoting]: "An unquoted prompts/** is expanded by the shell before the CLI sees it; should the CLI detect the already-expanded list and treat both forms identically, as the never: unquoted_star_cli entry already assumes?"
 ?[surface_composite]: "stack already answers to surface and profile; should surface become the identity+form+ego-graph composite PLAN.md describes, or stay a pure alias? Decides whether a composite commit exists."
 ?[measure_fold]: "Do authority, taste, and density (alias analyze) fold under spw measure, or stay top-level? Decides which aliases the next rename commit adds."
 ?[crystallize_cli]: "Ship crystallize as top-level spw crystallize or as spw stream crystallize? No stream verb exists in commands.ts yet; this fixes the name when the first stream producer lands."
 ?[task_verbs]: "Does the verb map gain the task verbs a mounted consumer names (eval an expression against data, explain each clause and its source, audit a spell's derived clauses, checks and pinned policy), and fold check-shaped verbs (lint, doctor, integrity, format --check) under one check and map-shaped ones (tree, roots, graph, census) under one map, keeping a verb only while a named host uses it?"
 ?[envelope_v2]: "At what point must every --json envelope carry ir and cache blocks? Decides the schemaVersion bump in envelope.ts."
 ?[grain_axis]: "Should a verb say what it moves by (a line, a surface, a corpus, a workspace, a change) beside its cost group, and should help be read by grain, by cost, or both? wonder_trial_grain asks what a step moves by in the language; this is the same question for the tools."
 ?[product_spelling]: "One spelling for choosing a product: subcommands (spw form rhymes, as spw inspect source) or flags (spw inspect --source, as spw form --rhymes)? Subcommands make each product its own help page; flags keep a verb's products side by side."
 ?[edge_stance]: "Does an unreached surface declare which edge it is on (arriving or leaving), or do tools infer it from last touch and supersession? wonder_trial_distance holds the readings."
}

^["commits"]{
 # Rescoped 2026-10-12: the SelectionIR globs commit split into glob_fixture_tests, shared_glob_resolver, then adopt_resolver_everywhere; progressive_product_census keeps its slot after the glob slice.
 .[file_sense_plan](08e2bc1c): "&[canon-rewrite-v2] — land tip capability on upstream; phase 0 field clocks (the plan, IR and verb map first appear here) (with sense_verb_aliases)"
 .[sense_verb_aliases](08e2bc1c): "&[canon-rewrite-v2] — land tip capability on upstream; phase 0 field clocks (census, measure and stack aliases first appear here) (with file_sense_plan)"
 .[declare_picomatch](e94b6bfb): "#[cli] — declare picomatch for the shared glob resolver"
 ~[output_contract_table]: "![cli] — one table test over every verb that prints rows: --json gives a versioned envelope, --quiet drops headers, and the chosen format is spelled one way; proof: the table fails today on query and select (--format beside --table) and on form (no --table), and passes once each is aligned"
 ~[lazy_command_modules]: "&[cli] — the registry imports a command's module only when that command runs or its help is asked for; proof: a timing test that loading the registry stays under a stated bound, and every command's help and run tests unchanged"
 ~[product_mode_rule]: "&[cli] — after ?[product_spelling]: the products form picks by flag become subcommands (spw form columns, spw form rhymes), or inspect's planes become flags, so one spelling holds; the old spelling routes for one era; proof: a test that each product is reached one way and the old way prints the new one"
 ~[grain_column]: "#[cli] — after ?[grain_axis]: each verb declares a grain (line, surface, corpus, workspace, change) beside its group, help --json carries it, and help can list by it; proof: a test that every verb has exactly one grain and the list by grain covers all 41"
 ~[glob_fixture_tests]: "![cli] — fixture tree and failing tests: a quoted glob, its directory form, and a no-match glob select the expected surfaces for census, graph and query"
 ~[shared_glob_resolver]: "#[cli] — one resolveSelection(globs, roots) beside collectSpwFiles in fs-walk.ts returning SelectionIR uris; census, graph and query call it"
 ~[adopt_resolver_everywhere]: "&[cli] — measure and the remaining private collectSpwFiles copies adopt resolveSelection (scope decided by ?[walker_fork])"
 ~[progressive_product_census]: "&[cli] — adopt spw.progressive-product/1 in one non-parser producer (census) with a compatibility test against the inspect source stages"
 ~[dense_serialization_docs]: ".[docs] — l/x dense serialization + * crystallize"
 ~[next_fills_roots]: "&[cli] — census, graph, density, and formula fill their next frame with the quoted roots, never a roots placeholder (render item 3)"
 ~[census_checks_anchor]: "&[cli] — census and graph count a link to a missing anchor as broken, with the same anchor check resolve uses (spw/theory/address-and-linking.spw, spw_theory_address_graph_files_only)"
 ~[hole_selector]: "#[cli] — spw select lists bare _ holes under a selector whose name is chosen against emit holes (spw/contraptions/index.spw gaps)"
 ~[holes_name_slots]: "&[cli] — emit holes names every hole by its key and line (_, a named slot, and an empty string in a labelled slot); expand quotes prose filled into a value position, a slot default may hold a closing brace, and the header ends its own line (five gaps found on a scaffold in tmp.spw, 2026-10-13)"
 ~[holes_brief]: "&[cli] — emit holes --brief packs each hole's context for an agent: the scaffold's name, its particles, the siblings already filled, the anchors it cites, and what the lexer and parser make of nearby keys"
 ~[outline_shows_omissions]: "&[cli] — outline shows anchors, lens and focus marks (#:claim #!settled), and wonders, and names what it omitted (render item 4; spw/inspection-and-ir.spw, spw_ir_trust_outline)"
 ~[predict_compare]: "&[cli] — census --blank and --against, and delta --facets plus a comparison of #! focus marks keyed by #> anchor, so a reader can predict and then compare (render items 7 and 8; the study calls the second flag --moods)"
 ~[explicit_paths_walk]: "&[cli] — a file or directory named on the command line is read even under .spw/gen/; the skip stays for walks that start at a root (fs-walk.ts, shouldSkipCorpusSurface at the explicit-path branch; mounted consumer rank 7, explicit_generated_paths)"
 ~[query_where_fields]: "&[cli] — spw query --where filters on AST node fields (placement, arm kinds, the lines a node spans) and --count-by groups by one, so a grammar census is one command; today --where placement=medial filters nothing (shares the node-field vocabulary with reading-drift)"
 ~[reach_product]: "&[cli] — census and graph report reach: hops from each declared root, unreached surfaces with their last touch, lines between anchors, and marks ranked against the corpus, from the corpus memo and one lex per file (spw.reach/1); --spread keeps its meaning (after ?[edge_stance]; docs/theory/spw/threshold-distance.spw)"
}

^["validation"]{
 !probe{ "before glob_fixture_tests: run spw census 'prompts/**', spw graph 'prompts/**' and spw query --from 'prompts/**' --skim against prompts as a directory; the glob forms must report the directory counts, and a glob that matches nothing must say so instead of printing a zero census." }
}

