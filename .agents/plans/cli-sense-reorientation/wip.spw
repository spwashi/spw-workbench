 census: #[list, summary, hubs, leaves, orphans, bridges, adrift, roles, paths, dialects, profiles, frames, size, stale, export]
 measure: #[mass, thrift, size, authority, density, health, drift, claim, scheme, families, schemes, hits, formula, taste, diff, report]
 graph: #[show, hubs, orphans, leaves, cycles, components, bridges, ego, neighbors, path, paths, edges, nodes, degree, matrix, export]
 geometry: #[show, pairs, braces, ops, depth, lessons, fingerprint, ladder, mobility, compare]
 exp: #[list, show, used, search, related, missing, export]
 stream: #[read, follow, batch, window, cat, filter, head, tail, stats, export, crystallize]
 crystallize: #[window, op, out, into]
 bench: #[parse, query, pulse, surface, measure, graph, census, lsp_hover, all]
 atlas: #[summary, html, trend, advice, save, diff, show, graph, census]
}

^["naming_alts"]{
 surface_also: #[card, face, portrait, sheet, dossier, lens, who, inspect, describe]
 census_also: #[roster, inventory, survey, population, tally, ledger, rollcall, manifest]
 measure_also: #[gauge, meter, assay, thrift, reconcile, observe]
