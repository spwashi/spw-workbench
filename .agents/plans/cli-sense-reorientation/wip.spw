 ~#taste: "abstract navigation; functional composition; alias-safe renames"
}

^["ir_spine"]{
 #[PreprocessIR, ParseIR, StackIR, FormIR, GraphIR, MeasureIR, SelectionIR, PlanIR, StreamIR, PrecipitateIR, CacheIR, EnvelopeIR]
}

^["renames"]{
 invent => census  # also roster|inventory|survey - rec census
 mass => measure   # mass becomes subcommand family
 profile => surface  # stack thin; profile alias -> stack lens
 map => graph dual  # or keep map primary one release
}

^["naming_rec"]{
 surface: #[show, stack, form, graph, ego, thrift, mass, exp, outline, frames, dialect, review, format, health, all, dump]
 census: #[list, summary, hubs, leaves, orphans, bridges, adrift, roles, paths, dialects, profiles, frames, size, stale, export]
