  // spw measure mass path.spw
  // spw measure authority path.spw
  // spw measure --family all --json

 graph: |
  // spw graph ego path.spw --depth 2
  // spw graph hubs prompts/** -n 12
  // alias: map, topo

 schedule_stream: |
  << ~ ; ? ; % ; ! ; * ; ^ >>
  // spw stream follow --stdin | spw crystallize --window 20

 hot: |
  // createHotSession({ channel: trial }).evaluate(src)
  // cacheHit on second evaluate

 recipes: #[
  "surface path.spw"
  "census prompts/** --sort degree -n 30"
  "measure mass path.spw"
  "graph ego path.spw --depth 2"
  "bench parse packages/** --budget ms=500"
 ]
}

^["open"]{
 ?[census_vs_roster]: "census (population) vs roster (list) - still rec census?"
 ?[surface_vs_stack]: "surface composite primary; stack thin - confirm?"
 ?[graph_rename]: "dual-primary map+graph one release then prefer graph?"
 ?[measure_fold]: "when fold authority/taste/analyze under measure only?"
 ?[crystallize_cli]: "top-level crystallize or spw stream crystallize?"
 ?[profile_compat]: "profile -> surface stack only, or full surface?"
 ?[ultra_short]: "ship inv/geom/topo only, or also g for graph?"
 ?[surface_p0]: "implement surface as HotSession.inspect wrapper first?"
 ?[envelope_v2]: "when require ir+cache blocks in every --json?"
}

#>wonder_cli_sense_naming_5
?["What is the first command a new agent should run on a folder?"]{
  !probe{ =id[p_first_cmd] }
  $%[census, surface, doctor]
}

#>wonder_cli_sense_naming_6
?["Does HotRuntimeSession.inspect replace spw profile?"]{
  !probe{ =id[p_inspect_profile] }
  $%[stack, phrases, exp]
}
