# wip — audit-css-tokens
# Branch: feature/audit-css-tokens
# Started: 2026-02-20

#:layer #!pragmatics

^["roots"]{
 @cluster: ~".agents/plans/plan-ecology-clustering/plan-ecology-clustering.spw"
 @plan: ~".agents/plans/audit-css-tokens/PLAN.md"
 @pattern: ~".spw/patterns/literate-ui.spw"
 @workspace: ~".spw/workspace.spw"
}

^["intent"]{
 ~#goal: "Perform a deep, curricular audit of CSS tokens to normalize the visual vocabulary across the app. This evolves the codebase from ad-hoc aesthetics to a rigorous mathematical design system."
 ~#taste: "correctness, clarity, and expressiveness through the cultivation of aesthetic taste and strict proportional constraints."
}

^["development"]{
 lane: #curriculum_formation
 ladder: #component
 develops: [#css_taste, #token_judgment, #semantic_transfer, #component_readability]
 review_surfaces: [@cluster, @plan, @pattern, @workspace]
 snippet_routes: [#token_example, #audit_excerpt, #css_probe, #component_note]
}

^["concept_index"]{
 primary: [#css, #tokens, #themes, #semantics, #component, #naming]
 surfaces: [#css, #dom, #docs, #audit]
 tensions: [#token_drift, #naming_bloat, #semantic_ambiguity, #style_overfit]
 transfers: [#component, #page]
}

^["recursive_improvement"]{
 loop: [
  "? reread token usage and UI patterns before widening the taxonomy",
  "< ship one naming or coverage refinement that clarifies a token role",
  "$ record which visual or semantic distinction became easier to reuse",
  "^ feed the stable token language into later components, pages, and docs",
  "% keep audits concrete enough to sharpen actual design taste",
 ]
 gates: [#naming_truth, #coverage, #transfer]
}

^["stream"]{
 # Append entries chronologically. Never edit prior entries.
 # >>[YYYY-MM-DD HH:MM] <type> — <content>
 >>[2026-02-20 01:54] observe — The codebase uses numerous CSS variables throughout UI elements and platform components, but their definitions and usages might be scattered or redundant.
 >>[2026-02-20 01:54] decide — This audit will focus on mapping existing token usage, identifying hardcoded values that should be tokens, and proposing a unified CSS custom property architecture.
 >>[2026-02-20 05:25] revise — Expanded plan to 26 commits to emphasize taste development and a masterclass-style refactor sequence.
}

^["open"]{
 # Unresolved questions. Remove when resolved (log resolution in stream first).
}

^["commits"]{
 ~[1]: "&[styles] — baseline: map and categorize all existing hardcoded hex and rgba values"
 ~[2]: "&[styles] — baseline: map existing spatial and typographic hardcoded values"
 ~[3]: "vocab[tokens] — define the Spw Color Valence vocabulary and nomenclature"
 ~[4]: "^seed[tokens] — establish the mathematical color scale (lightness/chroma progression)"
 ~[5]: "&[tokens] — generate canonical CSS custom properties for the Valence primitives"
 ~[6]: "&[tokens] — generate semantic (usage-based) color aliases mapped to primitives"
 ~[7]: "![tokens] — write visual regression tests/swatches for the Valence palette"
 ~[8]: "vocab[tokens] — define the typographic scale and rhythmic density vocabulary"
 ~[9]: "^seed[tokens] — establish fluid typography equations and line-height ratios"
 ~[10]: "&[tokens] — generate canonical CSS properties for the typography system"
 ~[11]: "vocab[tokens] — define the spatial containment and geometric metrics vocabulary"
 ~[12]: "^seed[tokens] — establish the 4px/8px spatial grid and border-radius scales"
 ~[13]: "&[tokens] — generate canonical CSS properties for grid, padding, and radii"
 ~[14]: "&[registry] — centralize token injection into the global application stylesheet"
 ~[15]: "&[elements] — refactor base layouts (header, sidebar) to consume fluid spatial tokens"
 ~[16]: "&[elements] — refactor interactive surfaces (cards, panels) to consume spatial/radii tokens"
 ~[17]: "&[elements] — refactor text components to consume standard typographic rhythm tokens"
 ~[18]: "&[elements] — refactor navigation links and buttons to use Valence semantic colors"
 ~[19]: "&[elements] — refactor form inputs and states (focus, disabled) to use Valence colors"
 ~[20]: "&[elements] — refactor alerts, badges, and status indicators to use specific Valences"
 ~[21]: "&[elements] — audit and remove legacy z-index hardcodes, applying elevation tokens"
 ~[22]: "&[elements] — audit and remove legacy box-shadow hardcodes, applying depth tokens"
 ~[23]: "&[styles] — delete the legacy unstructured CSS variable definitions"
 ~[24]: "![elements] — verify component rendering consistency across light/dark themes"
 ~[25]: ".[docs] — construct the interactive CSS token gallery UI for the workbench"
 ~[26]: ".[docs] — write the curriculum: 'Developing Taste in Spw CSS Architecture'"
}

^["cache"]{
 ~#status: "planning"
 ~#files_hot: ""
 ~#next_commit: "1"
 ~#open_count: "0"
 ~#last_stream: "2026-02-20 05:25"
 ~#taste_debt: ""
}

