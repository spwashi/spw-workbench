# wip — audit-css-tokens
# Branch: feature/audit-css-tokens
# Started: 2026-02-20
# Rescoped: 2026-10-12 from the lost src/ui/tokens layout onto the installable-book preset in the CLI templates

#>plan_audit_css_tokens
#:plan #!execution_truth
#:layer #!pragmatics

!["card"]{
 phase: #planning
 gist: "A season override re-themes every color in the installable-book preset, because no literal bypasses a token."
 touches: [~"packages/spw-cli/templates/init/presets/installable-book/public/assets", ~"packages/spw-cli/src/init-presets.ts"]
 will_touch: [~"packages/spw-cli/src/installable-book-tokens.test.ts"]
 entry: ~"./PLAN.md"
 next: "Answer ?[alpha_method], then land ~[name_preset_washes]: name the washes style.css hardcodes as substrate tokens."
}

^["edges"]{
 feeds: [~"../ecosystem-surface-governance/wip.spw"]
 shares: [~"../audit-data-attributes/wip.spw"]
}

^["roots"]{
 @cluster: ~".agents/plans/plan-ecology-clustering/plan-ecology-clustering.spw"
 @plan: ~".agents/plans/audit-css-tokens/PLAN.md"
 @code: ~"packages/spw-cli/templates/init/presets/installable-book/public/assets/substrate.css"
 @pattern: ~".spw/patterns/literate-ui.spw"
}

^["intent"]{
 ~#goal: "Make the installable-book preset's token layer complete: every color in style.css traces to a substrate.css token, so a season.css override re-themes the whole page."
 ~#taste: "correctness and clarity: one source of truth per color role, and a promise (swappable season) that a test can falsify."
}

^["development"]{
 lane: #execution_truth
 ladder: #component
 develops: [#css_taste, #token_judgment, #semantic_transfer]
 review_surfaces: [@cluster, @plan, @code, @pattern]
 snippet_routes: [#token_example, #css_probe]
}

^["concept_index"]{
 primary: [#css, #tokens, #themes, #season_layer, #oklch]
 surfaces: [#cli_templates, #css, #docs]
 tensions: [#token_drift, #hardcoded_hue, #naming_bloat, #browser_support]
 transfers: [#component, #page]
}

^["recursive_improvement"]{
 loop: [
  "? reread the preset literals before naming a token, so each new token has at least two uses",
  "< ship one token or one literal retirement per commit",
  "$ record which season override became possible",
  "^ feed the settled token roles back into the init preset docs",
  "% keep the guard test cheap enough to run in test:cli",
 ]
 gates: [#naming_truth, #coverage, #season_swap]
}

^["risk_model"]{
 hard_failures: ["a new token changes the rendered default palette"]
 soft_failures: ["color-mix is unavailable in an older consumer browser"]
 non_negotiables: ["the default look of a freshly initialized site stays visually the same"]
}

^["stream"]{
 # Append entries chronologically. Never edit prior entries.
 # >>[YYYY-MM-DD HH:MM] <type> — <content>
 >>[2026-02-20 01:54] observe — The codebase uses numerous CSS variables throughout UI elements and platform components, but their definitions and usages might be scattered or redundant.
 >>[2026-02-20 01:54] decide — This audit will focus on mapping existing token usage, identifying hardcoded values that should be tokens, and proposing a unified CSS custom property architecture.
 >>[2026-02-20 05:25] revise — Expanded plan to 26 commits to emphasize taste development and a masterclass-style refactor sequence.
 >>[2026-07-27 13:15] observe — plan-ecology sweep: every predicted path targets src/ui/tokens/, which no longer exists in this repo. src/ now holds only runtime, seed, and testing shims. This plan is stranded on a deleted layout, not in progress — disposition (relocate to a site repo, re-scope against packages/, or archive as superseded) is a user call.
 >>[2026-10-12 14:30] observe — re-ground: the named token surface that survives is the installable-book init preset in the CLI templates (substrate.css defines the --spw-* scale, season.css overrides six, style.css has 73 var() uses and 5 oklch literals, one tint oklch(55% 0.15 45 / 0.08) repeated twice); no hex values remain in docs/design/spw or the ocean style surface. A re-scope would target that preset, not src/ui/tokens.
 >>[2026-10-12 14:30] revise — commits trimmed from the copied 26 to ~[1], ~[2], ~[26]; ~[3]..~[25] target src/ui/tokens, src/styles and src/ui/elements, none of which exist, and are marked DROPPED. Disposition of the plan itself stays a human call, tracked once in hygiene-index-consolidation ?[stranded_fate].
 >>[2026-10-12 14:57] decide — User decided on 2026-10-12 to rescope this plan rather than archive it
 >>[2026-10-12 14:57] observe — Correction to the 14:30 note: season.css overrides no tokens, it holds a header comment, an empty layer season block, and a commented dark example. The five oklch literals in style.css hardcode hue 45 or 80, so a season override cannot reach them, and the callout border follows data-spw-affect while its background does not.
 >>[2026-10-12 14:57] revise — Rescoped to planning on the installable-book preset: goal is a complete token layer so a season override re-themes every color. Commits are now 1 to 4 (name the washes, retire the literals, add a guard test, optional type scale). Old 1 2 and 26 moved to done as dropped. Three questions open, one dark-season wonder carries a probe.
 >>[2026-10-12 15:36] revise — Commits named per the convention in 90c58bbc: 0 landed, 4 planned, 3 dropped.
}

^["open"]{
 # Unresolved questions. When resolved: log in stream, then move to ^["done"] as ~#resolved(label).
 ?[alpha_method]: "May the preset derive washes with color-mix(in oklch, var(--spw-accent) 8%, transparent), or must it stay on plain oklch() with a literal alpha for older browsers? Unblocks the form of ~[name_preset_washes]."
 ?[ground_lift]: "Is the page gradient start at style.css line 21 (oklch(97% 0.01 80)) meant to follow --spw-ground in a season, or is it a fixed highlight? Unblocks whether ~[name_preset_washes] adds --spw-ground-lift or derives it."
 ?[type_scale]: "Does the preset want a font-size scale token before a second season ships (style.css keeps 0.95rem and 0.78rem literals, and substrate.css has only leading tokens)? Unblocks ~[type_scale_tokens]."
}

^["commits"]{
 ~[name_preset_washes]: "#[cli] — name the preset washes in substrate.css: an accent wash, an ink wash, a figure veil, and the ground lift as tokens derived from the base tokens"
 ~[retire_oklch_literals]: "&[cli] — replace the five oklch literals in style.css (lines 20, 21, 47, 204, 218) with those tokens"
 ~[token_guard_test]: "![cli] — add installable-book-tokens.test.ts: style.css names no color literal, and every --spw-* in the season.css example block exists in substrate.css"
 ~[type_scale_tokens]: "#[cli] — add a font-size scale to substrate.css and retire the rem literals in style.css, only if ?[type_scale] is answered yes"
}

^["cache"]{
 ~#status: "planning"
 ~#base_ref: "main@551bb419"
 ~#rebased_at: "2026-10-12"
 ~#files_hot: ""
 ~#next_commit: "name_preset_washes"
 ~#open_count: "3"
 ~#last_stream: "2026-10-12 15:36"
 ~#taste_debt: ""
}

^["done"]{
 # Written at merge time, and incrementally while the plan runs.
 ~#dropped(baseline_literal_maps): "the original first two commits, baseline maps of hardcoded color, spacing and type literals; replaced by the 2026-10-12 measurement in ~#resolved(unnamed_tint) and the rescoped name_preset_washes, retire_oklch_literals and token_guard_test"
 ~#dropped(src_ui_token_refactor): "the original 23-step middle (valence color, type and spatial scales, element refactors, legacy cleanup, token gallery); targeted src/ui/tokens, src/styles and src/ui/elements, which no longer exist; evidence: stream 2026-10-12 14:30"
 ~#dropped(css_taste_curriculum): "the original last commit, curriculum prose 'Developing Taste in Spw CSS Architecture'; no grounded reader today; reopen as a .[docs] note once token_guard_test lands if wanted"
 ~#resolved(unnamed_tint): "Which color literals in the installable-book preset have no --spw-* token? — style.css holds five oklch literals (lines 20, 21, 47, 204, 218); four restate base tokens with an alpha or hardcoded hue (accent 55% 0.15 45 twice, ink 25% 0.02 80, figure 99% 0.01 80), one (97% 0.01 80 at line 21) names no token; evidence: grep of style.css against substrate.css, 2026-10-12"
 ~#resolved(hue_lock): "Do those literals follow a re-theme? — no: they hardcode hue 45 and 80, while substrate.css moves --spw-accent per data-spw-affect and the season.css example moves ground, figure, and ink; the callout border follows the token and its background does not; evidence: style.css line 203 vs 204, substrate.css lines 67-71"
 ~#resolved(season_overrides): "How many tokens does season.css override? — none: the file is a header comment, an empty @layer season, and a commented example; the 14:30 stream claim of six overrides is stale; evidence: read of season.css, 2026-10-12, git log shows only 3734eecc and d5031987 touching the assets"
}

#>wonder_audit_css_tokens_dark_season
?["Which rules in the preset keep their warm light colors when the commented dark-season example in season.css is applied?"]{
  #:depth #!computational // lens: token coverage
  ~#hypothesis: "the page gradient, pre, callout, and notice backgrounds stay light because they hardcode oklch literals"
  !probe{ "copy the commented :root block from season.css into @layer season in a scratch copy of the preset, serve public/, load index.html, and read getComputedStyle background-color for body, pre, .spw-callout, and .spw-notice (the notice appears only after a service-worker update, so inject one); rerun after ~[retire_oklch_literals] to see the set shrink to empty" }
  $%[plan.commit_count, plan.phase_progress]
}
