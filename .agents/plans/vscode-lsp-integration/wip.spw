^["intent"]{
 ~#goal: "Integrate the native node-based Spw language server into the VS Code extension so editor truth comes from the same semantic core as parser and runtime."
 ~#taste: "correctness, expressiveness, thin-client discipline"
}

^["development"]{
 lane: #execution_truth
 ladder: #service
 develops: [#editor_trust, #semantic_truth, #thin_client, #preview_truth]
 review_surfaces: [@cluster, @artifact, @references, @tooling, @editing, @navigation, @server, @extension]
