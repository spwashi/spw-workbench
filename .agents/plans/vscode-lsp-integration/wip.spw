}

^["recursive_improvement"]{
 loop: [
  "? reread tooling and live handlers before widening capability claims",
  "< ship one semantic editor behavior with preview, smoke, or tests",
  "$ record the surviving copy in artifact, docs, or snippet form",
  "^ feed the new contract into extension UX, install truth, and release copy",
  "% keep the extension thinner than the server",
 ]
 gates: [#preview_truth, #smoke_coverage, #client_thinness, #claim_discipline]
}

^["parallel_work"]{
 critical_path: [#server_truth, #preview_truth]
 parallelizable: [#completion, #rename, #document_link, #hover, #docs_copy]
 shared_hot_files: ["packages/spw-lsp/src/handlers/editing.ts", "packages/spw-lsp/src/handlers/navigation.ts", "packages/spw-lsp/src/stdio-server.ts", "extensions/vscode-spw/src/extension.ts"]
