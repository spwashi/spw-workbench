 @governance: ~".agents/plans/ecosystem-surface-governance/ecosystem-surface-governance.spw"
}

^["intent"]{
 ~#goal: "Convert the intended March 2026 alpha/beta/release cadence into a truthful release story for the packages-era rewrite, with v0.3.0 framed as the monorepo and structural decoupling milestone plus the first site-installable public shape."
 ~#taste: "clarity, layering, naming"
}

^["development"]{
 lane: #execution_truth
 ladder: #service
 develops: [#release_truth, #adoption_story, #discoverability, #public_discussion]
 review_surfaces: [@cluster, @plan, @artifact, @governance]
 snippet_routes: [#release_note, #quick_start, #waypoint_copy, #discoverability_claim]
}

^["concept_index"]{
 primary: [#release, #waypoint, #install, #discoverability, #migration, #truth_gate]
 surfaces: [#docs, #waypoints, #editor, #cli, #public_story]
 tensions: [#calendar_drift, #discoverability, #submodule_truth, #gate_sprawl]
 transfers: [#service, #governance]
}

^["recursive_improvement"]{
 loop: [
  "? reread install, governance, and discoverability surfaces before widening release claims",
  "< ship one externally visible release surface that becomes truer",
  "$ record what adopters can now understand or discuss more clearly",
  "^ propagate the stable wording into waypoints, quick-starts, and release notes",
  "% keep the release story narrower than the public behavior it names",
 ]
 gates: [#truth_gate, #discoverability_honesty, #install_alignment]
}

^["parallel_work"]{
 #spw_site_install: "release truth depends on install truth — the release is real when site codebases can mount"
 #ecosystem_surface_governance: "governance registry defines which surfaces are release-ready"
 #absorb_spwq_cli: "CLI verb stability is prerequisite for quick-start and migration docs"
 #vscode_lsp_integration: "extension marketplace metadata feeds discoverability lane"
 #runtime_dx_foundation: "runtime diagnostics feed verification story"
