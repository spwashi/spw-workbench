# Caches Living Tree
#
# Where the caches cut lives, where dated material goes, and what a lean cache surface keeps and derives.

#>caches_living_tree
#:layer #!pragmatics

^["extend"]{
 how: "add one key per finding in the right frame; measures carry as_of; never rewrite another agent's finding, add a counter instead"
}

^["baseline"]{
 as_of: "2026-10-13"
 at: "main 813444dc, .spw/caches/2026-09-30"
 files: 439
 lines: 86604
 string_share: "68 percent of characters sit inside strings"
 path_refs: "10239 refs, 663459 characters; 9845 carry a fragment whose anchor part is 246232 characters, so about 417 thousand characters are path prefix"
 card_and_provenance: "14724 lines in ^emit and ^provenance blocks, about 17 percent of lines"
 receipts: "2717 receipt lines"
 concepts: "322 of about 600 concept tags occur once"
 gate: "3 failing files, all refs to panels the apparatus has not written; 19 size warnings"
 statement_prose: "statement strings hold 451578 characters across 2958 claims; they are the knowledge and stay prose"
}

^["layout"]{
 tree: ~".spw/caches/index.spw"
 cut: "the living tree at .spw/caches/cut holds what is true now; a surface carries as_of on what changes"
 journal: "the canon-root journal at .spw/journal holds what was true on a day, one YYYY-MM-DD-slug.spw file per entry"
 snapshot: "a git tag caches-cut/YYYY.MM.DD names a state of the tree; a journal entry of the same day records the tag, its commit, and the counts"
 shelf: "the raw generation stays in its topic folders under .spw/caches as provenance"
 why: "a dated directory names when a cut opened, not what it holds; extension needs one place that is always current, and history needs one place that is never rewritten"
}

^["journal"]{
 naming: "YYYY-MM-DD-slug.spw, the date the entry records; flat until a year passes about a hundred entries, then one folder per year"
 append_only: "an entry is not edited after its day; a later entry corrects it with a supersedes edge"
 kinds: #[ resume, snapshot, receipts, decision ]
 resume: "where to pick up after a mount or a session limit"
 snapshot: "a tag, its commit, file and anchor counts, and the gate result"
 receipts: "inspection rows for one pass, grouped by event, date, agent, care, and outcome, with the files each row covers"
 decision: "an owner decision with its date, so plans and surfaces can cite it instead of restating it"
}

^["lean_surface"]{
 keeps: #[ "title comment", "file anchor", "axis stack", "claim, door, and cold_open", "as_of and lineage", "edges", "keystone claims with sources and limits", "try kits", "wonders" ]
 derives: #[ "the card title, from the title comment", "continuity, from the cold_open", "receipts, from journal ledgers", "the path of a ref, from a unique anchor", "proof, from the sources a claim cites" ]
 rule: "a field earns its line when no tool can derive it from another field in the same tree"
}

^["relevance"]{
 lead: #[ language, mathematics, physics, linguistics, attention, spw ]
 support: #[ season, making, learning, record, living, society, concepts, trails ]
 residue: #[ editor_hosts, live_platforms ]
 source: "owner decisions carried in the caches-cut-2026-09-30 plan: host-feature caches are residue, and TikTok LIVE is reframed rather than dropped"
 use: "the extension door sends new work to lead and support classes first; residue grows only through a wire and a cost"
}
