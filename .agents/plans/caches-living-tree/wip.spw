 ~[receipts_to_journal]: "&[caches] — p9: per-surface receipts move to journal ledgers; the #:review axis keeps the summary"
 ~[card_trim]: "&[caches] — p10: cards drop fields the title comment and the sources already carry; emit derivation is out of the current pass"
 ~[anchor_refs_migrate]: "&[caches] — p8, after citation-navigation ~[root_anchor_lsp]: refs inside the caches drop their path prefix and lineage becomes @journal anchor refs"
}

