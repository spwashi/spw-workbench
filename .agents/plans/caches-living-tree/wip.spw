^["recursive_improvement"]{
 loop: [
  "? measure the caches before each pass: lines, string characters, path-ref characters, receipt lines, concept singletons",
  "< ship one pass per commit, mechanical passes by script, never by hand across hundreds of files",
  "$ record the measures in the stream so thrift is a time series",
  "^ fold each settled form back into the contract, the vocabulary, and the gate",
  "% hold claim statements and anchors byte-identical through every mechanical pass",
 ]
 gates: [#claim_discipline, #permanence, #gate_green]
}

