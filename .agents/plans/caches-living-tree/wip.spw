!["card"]{
 phase: #active
 gist: "The caches become two layers, a living tree agents edit to keep true and an append-only journal of what was seen or made on a day, entered from one root and one door, with surfaces that carry less prose and address by anchor."
 touches: [~".spw/caches", ~".spw/workspace.spw", ~"scripts/analyzers/spw-cut-gate.ts", ~"packages/spw-lsp/src/handlers"]
 entry: ~"./PLAN.md"
 next: "Plugin pass: ~[journal_entry_lens] and ~[journal_append_only] now; ~[journal_backlinks] after citation-navigation lands ~[root_anchor_refs]. The p9 to p11 conventions passes wait for the owner review."
}

