#>wonder_plan_stream_parse_health_1
?["Does the plan lens alone, with no lexer change, account for the whole parse-health drop on plan files?"]{
 #:depth #!computational // lens: controlled comparison
 ~#hypothesis: "for each wip.spw, parse(source) errors minus parse(source, {path}) errors is nearly all of the error count, so the lexer rule needs no change"
 !probe{ "run: node --import tsx -e 'const fs=require(`fs`);import(`./packages/spw-seed/src/parser/parse.ts`).then(m=>{for(const d of fs.readdirSync(`.agents/plans`)){const f=`.agents/plans/${d}/wip.spw`;if(!fs.existsSync(f))continue;const s=fs.readFileSync(f,`utf8`);console.log(d,m.parse(s).errors.length,m.parse(s,{path:f}).errors.length)}})'  then compare the two columns" }
 !probe{ "baseline tally: npm run -s spw:pulse -- .agents/plans/*/wip.spw --json, then count reports[].beforeHealth by value (complete_structured, recovered, invalid)" }
 $%[plan.commit_count, plan.phase_progress]
}
