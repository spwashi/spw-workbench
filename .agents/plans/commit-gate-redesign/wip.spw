^["intent"]{
 ~#goal: "Redesign the commit gate so humans authorize a clearly summarized commit artifact, while hook-time review logic becomes shared, inspectable, and reusable by both the hook and poll-review surfaces."
 ~#taste: "clarity, layering, and trust — shrink the hook, centralize review truth, and make authorization feel like informed consent instead of a late interrupt."
}

^["development"]{
 lane: #execution_truth
 ladder: #service
 develops: [#commit_review_engine, #authorization_ceremony, #agent_attribution]
 review_surfaces: [@cluster, @plan, @hook, @poll]
