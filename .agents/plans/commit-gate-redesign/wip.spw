 transfers: [#service, #workflow, #policy]
}

^["recursive_improvement"]{
 loop: [
  "? reread the hook, poller, and workflow docs before changing the ceremony",
  "< ship one shared review primitive at a time so behavior stays explainable",
  "$ record what the human is actually authorizing, not just what the script computed",
  "^ fold stable summary/report logic back into both hook and polling surfaces",
  "% keep commit policy stable while improving how it is surfaced",
 ]
