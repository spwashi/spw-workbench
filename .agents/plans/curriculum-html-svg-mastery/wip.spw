# wip — curriculum-html-svg-mastery
# Branch: feature/curriculum-html-svg-mastery
# Started: 2026-02-20

#:layer #!pragmatics

^["intent"]{
  ~#goal: "Design a rigorous 50-commit curriculum focused on HTML and SVG spec mastery. Map vector graphics, coordinate systems, and visual filtering to Spw's visual architecture, enabling deep physiological mastery of web-native rendering capabilities."
  ~#taste: "expressiveness, depth, and mathematical clarity through the rigorous hand-authoring of spatial and graphical abstractions."
}

^["stream"]{
  >>[2026-02-20 02:32] observe — SVG is often treated as a black box (exported assets) rather than a hand-coded, deeply integrated extension of the DOM.
  >>[2026-02-20 02:32] decide — This curriculum will focus on raw, hand-authored SVG specs (coordinate math, path calculus, filter composition) and how they reflect Spw's rendering paradigms (lenses, shaders, stages).
  >>[2026-02-20 05:45] revise — Expanded plan to 50 commits to match the rigor of html-css-mastery, breaking the curriculum into 5 deep-dive phases of 10 commits each.
}

^["open"]{
}

^["commits"]{
  # --- Phase 1: Coordinate Systems vs. Spw Strata ---
  ~[1]: "^seed[curriculum] — scaffold Lab 1.01: Context Dimensions (svg element)"
  ~[2]: "^seed[curriculum] — scaffold Lab 1.02: User Space vs Viewport Space"
  ~[3]: "^seed[curriculum] — scaffold Lab 1.03: The viewBox attribute"
  ~[4]: "^seed[curriculum] — scaffold Lab 1.04: Aspect Ratio preservation mechanics"
  ~[5]: "^seed[curriculum] — scaffold Lab 1.05: Group transforms and matrix math"
  ~[6]: "^seed[curriculum] — scaffold Lab 1.06: Nested SVG coordinates"
  ~[7]: "^seed[curriculum] — scaffold Lab 1.07: Absolute vs Relative positioning"
  ~[8]: "^seed[curriculum] — scaffold Lab 1.08: Reusing elements via <use>"
  ~[9]: "^seed[curriculum] — scaffold Lab 1.09: Defs and shadow trees"
  ~[10]: "![curriculum] — establish Spw Reflection: Mapping viewBox logic to infinite Spw Strata"

  # --- Phase 2: Path Calculus vs. Spw Geometric Expressions ---
  ~[11]: "^seed[curriculum] — scaffold Lab 2.01: The Path (d) attribute foundation"
  ~[12]: "^seed[curriculum] — scaffold Lab 2.02: Lines (M, L, H, V)"
  ~[13]: "^seed[curriculum] — scaffold Lab 2.03: Strict relative syntax (m, l, h, v)"
  ~[14]: "^seed[curriculum] — scaffold Lab 2.04: Cubic Beziers (C, S)"
  ~[15]: "^seed[curriculum] — scaffold Lab 2.05: Quadratic Beziers (Q, T)"
  ~[16]: "^seed[curriculum] — scaffold Lab 2.06: Elliptical Arcs (A)"
  ~[17]: "^seed[curriculum] — scaffold Lab 2.07: Stroke properties (dasharray, linecap)"
