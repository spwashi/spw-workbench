 @pattern: ~".spw/patterns/literate-ui.spw"
 @workspace: ~".spw/workspace.spw"
}

^["intent"]{
 ~#goal: "Design a rigorous 50-commit curriculum focused on HTML and SVG spec mastery. Map vector graphics, coordinate systems, and visual filtering to Spw's visual architecture, enabling deep physiological mastery of web-native rendering capabilities."
 ~#taste: "expressiveness, depth, and mathematical clarity through the rigorous hand-authoring of spatial and graphical abstractions."
}

^["development"]{
 lane: #curriculum_formation
 ladder: #page
 develops: [#vector_taste, #geometry_literacy, #page_judgment, #transfer]
 review_surfaces: [@cluster, @plan, @references, @pattern, @workspace]
 snippet_routes: [#svg_lab, #path_example, #filter_note, #geometry_transfer]
}

^["concept_index"]{
 primary: [#svg, #viewBox, #paths, #filters, #animation, #foreignObject]
 surfaces: [#page, #vector, #docs, #labs]
 tensions: [#math_depth, #scope, #transfer, #curriculum_bloat]
 transfers: [#component, #page, #exhibit]
}

^["recursive_improvement"]{
 loop: [
  "? reread vector precedents and existing visual patterns before adding more labs",
  "< ship one SVG lesson that clarifies a real rendering or geometry concept",
  "$ record which vector or spatial idea became easier to transfer into Spw",
  "^ feed the stable lesson into components, pages, and exhibits",
  "% keep the curriculum in service of applied visual judgment rather than accumulation",
 ]
 gates: [#vector_truth, #transfer, #applied_learning]
}

^["parallel_work"]{
 critical_path: [#vector_braid, #reference_quality]
 parallelizable: [#coordinate_space, #path_calculus, #filter_atmosphere, #temporal_motion, #embedded_hybrids]
 shared_hot_files: [".agents/skills/spw-css-dom-lab/labs-svg/", ".agents/plans/curriculum-html-svg-mastery/PLAN.md", ".agents/plans/curriculum-html-svg-mastery/wip.spw"]
 merge_risks: [#lab_overlap, #snippet_drift, #spec_drift]
 handoff_artifacts: [@plan, @references, @pattern]
}

^["supporting_documents"]{
 must_ship: [@plan, @references]
 helpful: [@pattern, @workspace]
 carries: [#vector_braids, #source_map, #geometry_snippets, #heuristics]
}

^["interaction_depth"]{
 subjects: [#geometry, #motion, #filter_atmosphere, #containment, #page_feel, #interop]
 questions: [#what_changes_under_transform, #what_reads_as_continuous, #what_remains_experimental]
 qualities: [#expressiveness, #transfer, #mathematical_clarity]
}

^["stream"]{
 >>[2026-02-20 02:32] observe — SVG is often treated as a black box (exported assets) rather than a hand-coded, deeply integrated extension of the DOM.
 >>[2026-02-20 02:32] decide — This curriculum will focus on raw, hand-authored SVG specs (coordinate math, path calculus, filter composition) and how they reflect Spw's rendering paradigms (lenses, shaders, stages).
 >>[2026-02-20 05:45] revise — Expanded plan to 50 commits to match the rigor of html-css-mastery, breaking the curriculum into 5 deep-dive phases of 10 commits each.
 >>[2026-03-28 09:47] implement — added references/index.spw and richer development frames so SVG coordinates, paths, filters, animation, and foreignObject interop become topical anchors with reusable heuristics instead of diffuse reading memory.
}

^["open"]{
}

