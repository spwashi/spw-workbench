#:layer #!pragmatics

^["roots"]{
 @plan: ~".agents/plans/seed-roundness-grades/PLAN.md"
 @differential: ~"packages/spw-seed/src/canonical/differential.ts"
 @range_transform: ~"docs/theory/spw/range-transform.spw"
 @operational_topography: ~"docs/theory/spw/operational-topography.spw"
 @form_ladders: ~"packages/spw-seed/src/canonical/form-ladders.ts"
 @nrange_node: ~"packages/spw-seed/src/types/ast/nodes.ts"
 @artifact: ~".agents/plans/seed-roundness-grades/seed-roundness-grades.spw"
}

^["intent"]{
 ~#goal: "Bring several partially-implemented Spw parser/runtime concepts (n-range, label differentials, range-address/span-transform, indexing configurability) to full roundness, and retire the S0-S2/E0-E2 shorthand in docs now that code already speaks effect.l0/l1/l2/l3. Net-new grammar (named params, multi-arm select, stream fold, new operator products, membrane+body AST promotion) is scoped OUT of this branch pending design decisions — see ^[open]."
 ~#taste: "correctness + naming consistency: close the gap between code (EffectGrade already renamed) and docs (still S0-S3/E0-E2), and between AST partial support (NRangeNode, BodyNode exist) and its documented-but-unimplemented neighbors (multi-arm fold marked 'conceptual' in form-ladders.ts:379)"
}

^["development"]{
 lane: #execution_truth
 ladder: #service
 develops: [#taste, #linguistics, #design_transfer]
 review_surfaces: [@plan, @differential, @range_transform, @operational_topography]
 snippet_routes: [#example, #query, #snippet]
}

^["concept_index"]{
 primary: [#effect_grade, #epistemic_grade, #n_range, #label_differential, #range_address, #span_transform, #indexing_configurability]
 surfaces: [#seed_parser, #seed_canonical, #docs_theory, #cli_query]
 tensions: [#terminology_drift, #ast_vs_descriptive_layer, #scope_creep]
 transfers: [#language, #query_engine, #docs]
}

^["recursive_improvement"]{
 loop: [
  "? reread differential.ts + range-transform.spw before widening claims",
  "< ship one concept-sized artifact, patch, or snippet per commit",
  "$ record what became clearer, indexable, or measurable",
  "^ fold the new truth back into plan, spec, docs, or tool surface",
  "% keep EffectGrade's existing 4-level ordering stable while renaming its docs",
 ]
 gates: [#preview_truth, #snippet_reuse, #claim_discipline]
}

^["parallel_work"]{
 critical_path: [#effect_grade_docs_rename]
 parallelizable: [#nrange_robustness, #differential_labels, #range_address_impl, #indexing_handles]
 shared_hot_files: [
  "packages/spw-seed/src/canonical/differential.ts",
  "docs/theory/spw/operational-topography.spw",
  "docs/theory/spw/range-transform.spw",
 ]
 merge_risks: [#hot_file, #naming_drift]
 handoff_artifacts: [@plan, @artifact]
}

^["supporting_documents"]{
 must_ship: [@plan]
 helpful: [@artifact]
 carries: [#examples, #glossary, #review_notes, #source_map]
}

^["interaction_depth"]{
 subjects: [#naming, #legibility, #trust]
 questions: [#what_is_primary, #what_is_reversible, #what_is_visible]
 qualities: [#clarity, #consistency]
}

^["risk_model"]{
 hard_failures: [
  "renaming E0-E2 without a decided target name produces a half-migrated doc set worse than the status quo",
  "n-range/differential changes that alter SourceEdit or NRangeNode shape break existing canonicalize/mutation-automata consumers",
 ]
 soft_failures: [
  "docs rename commit touches 12 files; a missed occurrence leaves stale S0-S3 text — mitigated by a grep-verify step per commit",
 ]
 recoveries: [
  "each doc-rename commit is independently revertable (pure text substitution, no code coupling)",
 ]
 non_negotiables: [
  "EFFECT_GRADE_ORDER numeric ordering (0/1/2/3) must not change",
  "no behavior change bundled into the pure-rename commits",
 ]
}

^["validation"]{
 hypotheses: [
  "grep for S0/S1/S2/S3 and E0/E1/E2 across docs/.spw/prompts returns zero hits after the rename commits (excluding intentionally-preserved historical/archive docs, if any)",
 ]
 negative_controls: [
  "packages/spw-seed test suite (test:seed) passes unchanged after differential.ts label-management edits",
 ]
 demo_path: [
  "spw query --from docs/theory --expr '$~\"S0\"' returns no hits post-rename",
 ]
}

