^["intent"]{
 ~#goal: "Create a local-first observatory for TypeScript indexing, configuration, version, output-form, and release-surface experiments. The branch should make it easy to vary settings, compare stable TypeScript with optional preview/native surfaces, inspect bundle implications, and project the results into docs and .spw instead of leaving them as terminal residue."
 ~#taste: "clarity, measurement, release truth, communicability"
}

^["development"]{
 lane: #public_interest_research
