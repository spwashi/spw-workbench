# vscode-lsp-roadmap

#:layer #!pragmatics

^["roots"]{
 @plan: ~".agents/plans/vscode-lsp-roadmap/PLAN.md"
 @topography: ~".agents/plans/operational-topography/operational-topography.spw"
 @extension: ~"extensions/vscode-spw/src/extension.ts"
 @stdio: ~"packages/spw-lsp/src/stdio-server.ts"
 @client_rpc: ~"extensions/vscode-spw/src/lsp/custom-requests.ts"
}

^["orientation"]{
 lane: #execution_truth
 ladder: #service
 rule: "order Seed truth, LSP observation assembly, protocol honesty, and performance before new editor surfaces"
}

^["ladder"]{
 ~[0a]: "operational-topography — kernel largely landed; pair AST labels + editor projection remain"
 ~[0b]: "editor-contract — authority, payloads, invalidation"
 ~[0c]: "form-geometry-editor — coupling hover, mobility actions, formContext, pulse TextEdits"
 ~[1]: "protocol registry + capability matrix — earn formContext; no phantoms"
 ~[2]: "plugin-performance — startup, incremental, visibility"
 ~[3a]: "atlas-follow-up — extract, gate, earn resonance"
 ~[3b]: "register-explorer — server snapshot + liminality bridge UI"
 ~[4]: "authoring-probe-loop — consume mobility/pulse; not client geometry"
 ~[5]: "cognitive-surface — orientation polish"
 ~[||]: "typescript perf + upgrade ladder — toolchain, not editor paths"
}

^["kernel_landed"]{
 coupling: ~"packages/spw-seed/src/types/coupling.ts"
 form_geometry: ~"packages/spw-seed/src/canonical/form-geometry.ts"
 form_ladders: ~"packages/spw-seed/src/canonical/form-ladders.ts"
 mutation_pulse: ~"packages/spw-cli/src/pulse.ts"
 liminality_bridge: ~"packages/spw-runtime/src/state/liminality-bridge.ts"
}

^["doctrine"]{
 seed_owns_parse_structure: true
 lsp_assembles_revisioned_observations: true
 thin_client: true
 no_phantom_spw_methods: true
 visibility_budget: true
 incremental_over_debounce: true
 additive_spw_context: true
 extract_hot_files_before_grow: true
 shared_verified_differential: true
 geometry_seed_owned: true
 implemented_rules_only_as_actions: true
}

^["phantom_gap"]{
 client_only: [#resonance, #registerSnapshot, #operatorFrequency, #phaseContext]
 server_custom: [#select, #annotations, #contextAtPosition, #workspaceManifest, #workspaceTemperature]
 proposed_earn: [#formContext]
}

^["hot_files"]{
 display: ~"packages/spw-lsp/src/handlers/display.ts"
 server_index: ~"packages/spw-lsp/src/server-index.ts"
 atlas_tree: ~"extensions/vscode-spw/src/views/workspace-tree.ts"
 concepts_tree: ~"extensions/vscode-spw/src/views/concepts-tree.ts"
 stdio: ~"packages/spw-lsp/src/stdio-server.ts"
}
