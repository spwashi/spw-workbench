#>wonder_agents_plans_ecosystemsurfacegovernance_1
?["Does any machine check read the surface governance registry, or is the launch ladder prose only?"]{
  #:depth #!computational // lens: gate audit
  ~#warning: "taxonomy without launch discipline becomes ornamental bureaucracy"
  ~#baseline: "grep for surface-archetypes across packages, scripts, and extensions found no references; it is cited from docs/toc.spw, .spw/workspace.spw, .spw/index.spw, .spw/surfaces/index.spw, .spw/harness/evals/baseline-evals.spw, and six other plans"
  !probe{ "grep -rl surface-archetypes packages scripts extensions | grep -v node_modules; a hit outside tests means a gate consumes the registry, zero hits means the readiness-vector commit must also name the first reader that changes a launch decision." }
  $%[plan.commit_count, plan.phase_progress]
}
