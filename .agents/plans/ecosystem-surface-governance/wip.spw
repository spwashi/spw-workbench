}

^["intent"]{
 ~#goal: "Make the web-domain portfolio operational by tightening statuses, launch governance, and the adjacent plans that should carry QA, linguistic stability, and contributor formation."
 ~#taste: "clarity, layering, naming, correctness"
}

^["development"]{
 lane: #execution_truth
 ladder: #page
