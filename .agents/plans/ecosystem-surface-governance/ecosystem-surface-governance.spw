# Ecosystem Surface Governance
#
# Durable operating doctrine for turning domain names into governed surfaces.

#:layer #!pragmatics

^["goal"]{
 ~#intent: "Connect branding, literature, interaction, QA, and team shape so a planned surface can be reviewed before it is launched."
 ~#bar: "A public surface is not just a name or a route; it is a maintained contract."
}

^["launch_ladder"]{
 idea: {
  ~#meaning: "named surface exists in the portfolio but has no routed public contract"
  ~#requirements: "role + brief + why this surface exists"
 }
 internal_literature: {
  ~#meaning: "surface has canon/docs/spec support and can be reasoned about"
  ~#requirements: "literature mode + concept fit + initial QA questions"
 }
 internal_tool: {
  ~#meaning: "surface has codebase support or instrumentation but is not yet public"
  ~#requirements: "telemetry, failure modes, and maintenance owner"
 }
 public_beta: {
  ~#meaning: "surface is routed and intentionally discoverable"
  ~#requirements: "audience, interaction mode, launch gate, release note, support path"
 }
 governed_surface: {
  ~#meaning: "surface is part of the durable ecosystem"
  ~#requirements: "QA cadence, telemetry expectations, team shape, retirement rule"
 }
 sensitive_surface: {
  ~#meaning: "surface carries privacy, discretion, or reputational asymmetry"
  ~#requirements: "dedicated pipeline, discretion-first defaults, review gate beyond standard launch"
 }
}

^["required_metadata"]{
 ~#for_active_or_public: ["status", "audience", "literature_mode", "interaction_mode", "qa_gate", "team_shape"]
 ~#for_sensitive: ["sensitivity_tier", "privacy_mode", "pipeline_class", "review_gate"]
 ~#rule: "dormant surfaces may stay lightly specified; active or launchable surfaces must carry operating metadata."
}

^["status_semantics"]{
 active: {
  ~#meaning: "surface is routed or intentionally close to launch"
  ~#route_requirement: "must have a routing entry or an explicit blocked-by note"
 }
 dormant: {
  ~#meaning: "surface remains in the portfolio but should not consume launch attention"
  ~#route_requirement: "may remain unrouted"
 }
 sensitive_pending: {
  ~#meaning: "surface concept is retained, but its privacy/discretion contract is not yet ready"
  ~#route_requirement: "must not ride the ordinary public pipeline"
 }
}

^["spiritual_testing_path"]{
 ~#path: [
  "literature claim",
  "seed or selector expression",
  "parser/query interpretation",
  "runtime behavior or telemetry",
  "editor/workbench legibility",
  "publish pipeline projection",
  "public surface fit"
 ]
 ~#reading: "a software concept is spiritually tested when it survives passage through the whole stack without losing its name, its behavior, or its dignity."
}

^["boonhonk"]{
 ~#meaning: "Boonhonk is a genre meant to introduce multidimensional production wonder."
 ~#principles: [
  "recursively developmental linguistics",
  "performative reflection",
  "physical chemistry models",
  "genre hybridization targets"
 ]
 ~#biome_reading: "the boonhonk biome should behave like developmental physics for culture: states mature, collide, precipitate, and reorganize without losing narrative legibility."
 ~#reality_model: "narrative, rhetorical, and quantum-like realities can coexist as long as the surface declares which transitions are metaphorical, which are operational, and which are intentionally transreal."
 ~#governance_reading: "those principles should guide biome construction and long-term expansion capacity, not remain decorative vocabulary."
 ~#test: "a surface belongs to boonhonk when wonder survives translation into docs, code, interaction, QA, and stewardship."
}

^["snippet_economy"]{
 ~#direction: "Spw snippets should eventually tag items and concepts in a way that makes them instantiable, referenceable, and exchangeable across surfaces."
 ~#requirements: [
  "stable concept identity",
  "clear ownership and provenance",
  "instantiation semantics",
  "trade or transfer rules",
  "editor and publish affordances"
 ]
 ~#warning: "do not let snippet trade outrun the language's semantic rigor; tagging and exchange should follow trustworthy concept models."
}

^["functional_utility"]{
 ~#rule: "each governed surface should declare the concrete work it performs for users, editors, or the ecosystem rather than relying on concept aura alone."
 ~#minimums: ["entry action", "repeatable utility", "artifact produced", "feedback loop"]
 ~#reading: "wonder scales when a surface can be used, revisited, and measured without collapsing its imaginative range."
}

^["syntax_utilization"]{
 ~#rule: "Spw-native surfaces should say how the language appears in use: framing, tagging, probing, register display, snippet exchange, or projection."
 ~#target_forms: ["frames", "selectors", "probes", "register reads", "snippet references", "projection targets"]
 ~#warning: "do not advertise Spw syntax as ornament; name the operational affordance each form provides."
}

^["fingerprint_contract"]{
 =minimum: ["fingerprint", "lead_operator", "timing_profile", "token_shape", "concept_refs"]
 =uniqueness_rule: "every listed site needs a fingerprint that distinguishes its cadence, operator lean, and concept posture from every sibling surface"
 !["Portfolio fingerprints are conceptual operators, not branding slogans"]
 %[comparison_axes]{
  "fingerprint asks what the surface does to attention, not just what it is called",
  "lead_operator names the primary sigil pressure the surface exerts",
  "timing_profile makes cadence researchable",
  "token_shape makes snippet and language instrumentation comparable",
  "concept_refs make cross-surface tagging and instantiation possible"
 }
 ~<.spw/surfaces/domains.spw>
}

^["portfolio_operator_reference"]{
 =raw: "?~<#.>@(#.)&[#.]*{#.}^"
 =operators: ["!", "~", "?", "#", ".", "^", "@", "*", "&", "=", "$", "%"]
 %[site_readings]{
  "! introduces invitation, provocation, launch, or event pressure",
  "~ preserves latency, dormancy, privacy, or not-yet-materialized potential",
  "? turns a site into a guide, question, benchmark, or comparative instrument",
  "# stabilizes motifs, tags, trophies, and memory handles",
  ". grounds craft in material interface, texture, and baseline affordance",
  "^ lifts work into worldview, curriculum, or public orientation",
  "@ fixes the stance: audience, portal, observer, or protagonist",
  "* materializes artifacts, editions, badges, ownership, or concrete state",
  "& couples sites into bundles, constellations, collectives, and shared pipelines",
  "= binds explicit contracts for scope, readiness, exchange, and stewardship",
  "$ makes the surface reflect on language, media, or its own instrumentation",
  "% normalizes token density, timing cadence, and cross-surface comparability"
 }
}

^["experiment_hooks"]{
 ~#rule: "surfaces that make semantic, linguistic, or biome claims should expose at least one probeable experiment hook."
 ~#minimums: ["question", "surface set", "measurement idea", "negative control", "projection or review path"]
 timing: {
  ~#examples: ["cadence shifts", "phase-transition timing", "attention beats", "animation-style delay perception"]
 }
 tokens: {
  ~#examples: ["operator density", "token novelty", "snippet reuse", "tag propagation across surfaces"]
 }
 ~#falsification: "if a surface claims developmental physics or transreal utility, experiments should be able to show where the metaphor stops predicting usable behavior."
}

^["team_scaling"]{
 solo: "one builder can carry the surface with low operational burden"
 pair: "surface needs editorial + technical stewardship together"
 guild: "surface crosses docs, runtime, design, and release concerns and needs explicit coordination rituals"
}

^["sustainable_wonder"]{
 ~#principle: "wonder is sustainable when discovery produces maintainable structure instead of permanent novelty debt"
 ~#rule: "new surfaces should emerge more slowly than shared infrastructure and QA improve"
 ~#warning: "domain multiplication without launch discipline turns the portfolio into mythology detached from code"
 ~#boonhonk_reading: "Boonhonk stays real when genre energy survives implementation, review, and maintenance instead of evaporating at first contact with production."
 ~#probe_reading: "long-term probe surfaces should keep testing the border between story logic and physical-model language without pretending every metaphor is literally executable."
}

^["parallel_work"]{
 critical_path: [#launch_ladder, #required_metadata, #fingerprint_contract]
 parallelizable: [#boonhonk, #snippet_economy, #experiment_hooks, #portfolio_operator_reference]
 merge_risks: [#surface_sprawl, #launch_gate_drift, #fingerprint_blur]
 handoff_artifacts: [#surface_inventory, #launch_gate_note, #fingerprint_sheet]
}

^["supporting_documents"]{
 must_ship: [#surface_inventory, #launch_gate_note, #qa_review]
 helpful: [#boonhonk_probe_log, #snippet_catalog, #retirement_matrix]
 carries: [#audience_story, #support_path, #maintenance_owner, #sensitivity_rule]
}

^["interaction_depth"]{
 subjects: [#trust, #wonder, #audience_fit, #maintenance, #discretion]
 questions: [#what_makes_a_surface_real, #what_blocks_launch, #what_deserves_privacy_review]
 qualities: [#legibility, #restraint, #stewardship]
}

#>wonder_agents_plans_ecosystemsurfacegovernance_artifact_1
?["How would a healthy ecosystem reject a surface?"]{
  #:depth #!computational // lens: formal structure
  ~#premise: "saying no is part of keeping wonder alive"
  !probe{ "which launch-ladder stage should be the refusal point when a surface has voice but no operating contract?" }
  $%[plan.commit_count, plan.phase_progress]
}

#>wonder_agents_plans_ecosystemsurfacegovernance_artifact_2
?["What makes a domain feel governed rather than merely categorized?"]{
  #:depth #!educational // lens: instrument calibration
  ~#contrast: "category = label; governance = label plus thresholds plus consequences"
  !probe{ "identify the first consequence that should fire when a surface changes from dormant to active." }
  ~<.spw/surfaces/domains.spw>
}

#>wonder_agents_plans_ecosystemsurfacegovernance_artifact_3
?["What would disconfirm a timing or token claim in the boonhonk biome?"]{
  #:depth #!mathematical // lens: falsifiable instrumentation
  ~#measures: ["token cadence", "operator density", "probe completion lag", "snippet reuse"]
  ~#control: "static explanatory prose with no timing-sensitive interaction"
  !probe{ "where does a claimed biome effect disappear once timing and token structure are measured instead of narrated?" }
  $%[file.frame_count, file.annotation_density]
}
