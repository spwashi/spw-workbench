// Form Geometry → Editor Projection
//
// Distilled contract for LSP/plugin over Seed form-geometry + pulse.
// Braces as inspectable material; dual liminality; optimistic plugin ports.
//
// @see .agents/plans/form-geometry-editor/PLAN.md
// @see packages/spw-seed/src/canonical/form-geometry.ts
// @see packages/spw-runtime/src/state/liminality-bridge.ts

#:layer #!pragmatics
#:status #!proposed
@dialect:Spw.b

^seed[Spw.Plan.FormGeometry.Editor v:0.2 @profile:Spw.b @intent:project_geometry]

^["roots"]{
 @plan: ~".agents/plans/form-geometry-editor/PLAN.md"
 @wip: ~".agents/plans/form-geometry-editor/wip.spw"
 @ecology: ~".agents/plans/shape-syntax-ecology/shape-syntax-ecology.spw"
 @form_geometry: ~"packages/spw-seed/src/canonical/form-geometry.ts"
 @form_ladders: ~"packages/spw-seed/src/canonical/form-ladders.ts"
 @coupling: ~"packages/spw-seed/src/types/coupling.ts"
 @bridge: ~"packages/spw-runtime/src/state/liminality-bridge.ts"
 @pulse: ~"packages/spw-cli/src/pulse.ts"
 @range: ~"docs/theory/spw/range-transform.spw"
 @swap: ~"docs/theory/spw/swap-grace.spw"
 @roadmap: ~".agents/plans/vscode-lsp-roadmap/PLAN.md"
 @authoring: ~".agents/plans/vscode-authoring-probe-loop/vscode-authoring-probe-loop.spw"
}

^["status"]{
 kernel: "in main — form-geometry, ladders, pulse, topography probes, liminality bridge"
 editor: "partial/not full — do not claim full projection landed"
}

^["anatomy"]{
 // brace material sample
 . {
  bound: .{
   kinds: #[frame, body, scope, capsule, stream, nrange, couple]
   ports: #[before_open, open_boundary, inside, close_boundary, after_close]
   axes: #[kind, form, occupancy, payload, act_placement]
  }
  liminal_surface: #[exterior, void, chamber, hole, aperture, membrane, published]
  liminal_runtime: #[local, liminal, visible, global]
  bridge: .{
   id: Spw.Runtime.RegisterLiminalityBridge
   fixed_point: "published == global"
   effect: effect.l1.memory
   law: "parse never promotes; only explicit bridge call"
  }
  =exp[ id: form.material_packet , status: partial , runtimeHook: lint ]
  =exp[ id: form.formContext , status: proposed , runtimeHook: lower ]
 }
}

^["ownership"]{
 seed: #[apply, probes, ladders, SourceEdit]
 lsp: #[range_map, formContext, codeAction, hover]
 plugin: #[S2_accept, commands, strip, config]
 effect_vocab: "S0–S2 topography grades; effect.l1.memory = bridge only"
}

^["slices"]{
 P0: #[coupling_hover, mobility_code_actions]
 P1: #[formContext, context_strip, pulse_text_edits, range_transform]
 P2: #[prose_fallback_diagnostics, occupancy_token_modifiers]
 P3: #[hof_walk_ui, register_bridge_command]
}

^["protocol"]{
 formContext: .{
  method: "spw/formContext"
  grade: S0
  earns: "capability registry + handler + client type + test"
  payload: #[revision, coupling, boundaryLadder, labelSites, applicableRules, topography]
 }
 mobility_chain: "topic → @(topic) → $(topic)"
 forbid: #[direct_topic_to_register, phantom_methods, auto_HOF]
}

^["actions"]{
 only: "mobility rules status=implemented + apply success + receipt gates"
 preview: #required
 groups: #["refactor.rewrite.spw.label", "refactor.rewrite.spw.boundary"]
 sigma: << ~ ; ? ; % ; ! ; * ; ^ >>
}

^["synergy"]{
 @ecology: ~".agents/plans/shape-syntax-ecology/shape-syntax-ecology.spw"
 refactor: ~".agents/plans/refactor-experiment-lifecycle/refactor-experiment-lifecycle.spw"
 curiosity: ~".agents/plans/curiosity-mutation-ergonomics/curiosity-mutation-ergonomics.spw"
 cognitive: ~".agents/plans/vscode-cognitive-surface/vscode-cognitive-surface.spw"
 gestalt: "semantic tokens by brace/operator kind — shape literacy"
}

^["imagination"]{
 ide: "hover bound; preview mobility; refuse bare $(id) as promotion"
 shot: "nested brace silhouette; dual-read AST kinds"
 learn: "surface waypoints vs register stages — two ladders"
 falsify: "capacitance theatre; liminality axis collapse"
}

^["falsify"]{
 #[
  "register liminality claimed identical to LiminalShape without bridge"
  "header payload lost on $(L) projection"
  "implemented mobility without receipt/health/revision gates"
  "vision-only structure rewrite"
 ]
}

#>wonder_form_geometry_rich_1
?["Where does the inspectable material of a brace end and metaphor begin?"]{
  #:species #!algebraic_closure
  !probe{ =id[p_material] }
  $%[occupancy, payload, pair]
  ~<packages/spw-seed/src/types/coupling.ts>
}
