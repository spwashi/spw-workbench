// Form Geometry → Editor Projection
#
// Distilled contract for LSP/plugin surfaces over Seed form-geometry + pulse.
#
// @see .agents/plans/form-geometry-editor/PLAN.md
// @see packages/spw-seed/src/canonical/form-geometry.ts
// @see .agents/plans/vscode-lsp-roadmap/PLAN.md

#:layer #!pragmatics

^seed[Spw.Plan.FormGeometry.Editor v:0.1 @profile:agent_surface @intent:project_geometry]

^["status"]{
 kernel: "in main — form-geometry, ladders, pulse, topography probes, liminality bridge"
 editor: "not_started — hover/actions/formContext/pulse commands (do not claim landed)"
}

^["ownership"]{
 seed: "apply(), probes, ladders, SourceEdit plans"
 lsp: "range map, formContext assembly, codeAction/hover transport"
 plugin: "S2 accept, commands, strip, config"
 effect_vocab: "S0-S2 = topography workspace grades; effect.l1.memory = register liminality bridge only"
}

^["slices"]{
 P0: #[coupling_hover, mobility_code_actions]
 P1: #[formContext, context_strip, pulse_text_edits]
 P2: #[prose_fallback_diagnostics, occupancy_token_modifiers]
 P3: #[hof_walk_ui, register_bridge_command]
}

^["protocol"]{
 formContext: .{
  method: "spw/formContext"
  grade: S0
  earns: "capability registry row + server handler + client type + test"
  payload: #[revision, coupling, boundaryLadder, labelSites, applicableRules, topography]
 }
 mobility_chain: "topic → @(topic) → $(topic); reject direct topic → $(topic)"
 forbid_phantom: true
}

^["actions"]{
 only: "mobility rules with status=implemented and apply() success"
 preview: required
 groups: #["refactor.rewrite.spw.label", "refactor.rewrite.spw.boundary"]
}

^["pulse"]{
 parity: "CLI spw pulse --check / --write profiles"
 map: "SourceEdit offsets → LSP TextEdit ranges"
 range_transform: ~"docs/theory/spw/range-transform.spw"
 P1d: "range fragment #:L12-L28 + indent_lines on shared kernel"
}
