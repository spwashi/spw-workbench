# wip — spw-init-dx
# Branch: feature/spw-init-dx
# Started: 2026-03-20

#:layer #!pragmatics

^["intent"]{
 ~#goal: "Make spw the root CLI identity, move installer/bootstrap logic behind spw init, and preserve compatibility for spw-workbench install plus local install scripts."
 ~#taste: "naming, layering, correctness"
}

^["stream"]{
 >>[2026-03-20 16:20] observe — root package still publishes spw-workbench as the only bin and points it at scripts/spw-install.ts even though the command canon now treats spw as the umbrella surface.
 >>[2026-03-20 16:20] decide — package-owned init should own scaffold logic; scripts/spw-install.ts should become a compatibility wrapper instead of the canonical installer implementation.
 >>[2026-03-20 16:20] taste — the best DX shape is one CLI with explicit verbs; root identity should not force users into a bootstrap noun before they can reach the actual tool.
 >>[2026-03-20 16:20] hygiene — branch is clean on main@7e419c7e66816d7f5fc04a340dae94707f53d5d5; no unrelated drift to split.
 >>[2026-03-20 10:45] implement — moved bootstrap scaffolding into packages/spw-cli/src/init.ts and wired run.ts so init/install resolve through one package-owned implementation.
 >>[2026-03-20 10:48] normalize — rebound package bin toward scripts/spw.ts, added spw:init as the canonical local script, and made spw:install a pure alias over the umbrella CLI.
 >>[2026-03-20 10:49] verify — build, test:run, lint:docs, npm run spw -- help, npm run spw -- init --help, npm run spw:init, npm run spw:install, and node --import tsx scripts/spw-install.ts --help all passed.
}

^["open"]{
 ?[publish-hardening]: "When root spw becomes a public binary rather than a private workspace convenience, should the bin ship compiled JS instead of tsx-backed TS entrypoints?"
}

^["decisions"]{
 ~[bin-compat]: "Keep spw-workbench as a published compatibility alias to the same umbrella CLI while making spw the primary bin."
 ~[script-compat]: "Expose spw:init as the canonical local bootstrap and keep spw:install as a pure alias over spw install."
}

^["commits"]{
 ~[1]: ".[spw-init-dx] — plan the root-bin and init DX slice"
 ~[2]: "&[spw-init] — move bootstrap/install logic behind the package-owned init command"
 ~[3]: "&[spw-bin] — rebind package bin and compatibility wrappers to the root spw CLI"
 ~[4]: ".[spw-dx-docs] — update help and docs to prefer spw init while documenting compat aliases"
}

^["cache"]{
 ~#status: "implemented, verified, awaiting commit"
 ~#base_ref: "main@7e419c7e66816d7f5fc04a340dae94707f53d5d5"
 ~#rebased_at: "2026-03-20 10:49"
 ~#hygiene_split: "none"
 ~#files_hot: "package.json, packages/spw-cli/src/{init,run,index}.ts, packages/spw-cli/package.json, scripts/spw-install.ts, README.md, .spw/conventions/cli.spw"
 ~#next_commit: "2"
