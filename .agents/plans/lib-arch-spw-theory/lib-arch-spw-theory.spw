# Lib Architecture Theory Bridge

#:layer #!pragmatics

^["plane_axes"]{
 liminality: "how transitional vs resolved a concept is"
 tangibility: "how concrete vs abstract a concept is"
 conception: "how generative vs instantiated a concept is"
 familiarity: "how known vs novel a concept is"
 salience: "how foreground vs background a concept is"
 objectivity_subjectivity: "how externally grounded vs perspectival a concept is"
 valence: "boon/bane/bone/bonk/honk quality dynamics"
 composition: "how isolated vs composite a concept is"
}

^["selection_claim"]{
 claim: "Spw references should support selecting concepts by multi-axis profile, not only by path."
 counterexample: "A pure path reference without axis context can pick the wrong concept in a liminal scope."
}

^["falsify"]{
 evidence: [
 "architecture supports missing plane-axis map",
 "theory bridge absent operator-to-axis relation notes",
 "lint checks pass despite missing architecture support files"
 ]
}

#>wonder_agents_plans_libarchspwtheory_libarchspw_1
?["What happens when you zoom from the workflow level to the workspace level in Lib Architecture Theory Bridge?"]{
  #:depth #!mathematical // lens: living system
  $^["_"]@here => &[@workspace] // local → global projection
  ~#zoom_in: "plane_axes" // this file's atom
  !probe{ "the atom is workflow-scale; zoom out: what workspace-level pattern does this workflow participate in?" }
  $%[theory.claim_count, theory.proof_depth]
}

#>wonder_agents_plans_libarchspwtheory_libarchspw_2
?["What ripples if #lib_arch_spw_theory changes in this file?"]{
  #:depth #!stylistic // lens: curated collection
  $#educational@workspace => %[reference.count, depth.downstream]
  ~#downstream: "trace all files that reference this surface"
  !probe{ "imagine renaming #educational to #educational_v2; count broken references; the count reveals how deeply plane_axes is woven into the workspace." }
  $%[theory.claim_count, theory.proof_depth]
  ~<.agents/plans/lib-arch-spw-theory/wip.spw>  // nearest neighbor
}
