}

^["intent"]{
 ~#goal: "Strictly brand core ID types (Frame, Register, Domain) to enforce nominal safety."
 ~#taste: "safety without friction — zero runtime cost, minimal casting noise."
}

^["development"]{
 lane: #rewrite_recovery
 ladder: #language
 develops: [#type_safety, #identity_judgment, #naming_precision, #ownership]
 review_surfaces: [@cluster, @plan, @workspace, @pattern]
 snippet_routes: [#brand_type, #id_helper, #safety_note, #serialization_example]
}

^["concept_index"]{
 primary: [#branding, #ids, #types, #frames, #registers, #domains]
 surfaces: [#seed, #runtime, #lsp, #serialization]
 tensions: [#safety, #friction, #casting, #boundary_crossing]
 transfers: [#language, #service]
}

^["recursive_improvement"]{
 loop: [
  "? reread identifier boundaries before widening branding",
  "< ship one nominal distinction that prevents a real category mix-up",
  "$ record which runtime or editor surface became safer or easier to reason about",
  "^ feed the stable identity vocabulary into runtime, LSP, and docs surfaces",
  "% keep safety gains larger than the casting or ergonomics cost",
 ]
 gates: [#type_safety, #ergonomics, #boundary_clarity]
}

^["stream"]{
 >>[2026-03-19 00:00] observe — current IDs are `string` aliases. Mixing is easy and undetected by tsc.
 >>[2026-03-19 00:01] decide — use the `__brand` convention. Avoid `unique symbol` branding if it complicates interface/serialization.
}

^["open"]{
 ?[serialization]: "How do branded types play with JSON.stringify/parse across the LSP boundary?"
 ?[casting]: "Should we provide explicit `asFrameId()` helpers or rely on manual `as` casts for now?"
}

^["commits"]{
 ~[1]: "types[seed] — add branding utility and brand core identifiers (Frame, Register, Domain)"
 ~[2]: "types[runtime] — apply branded IDs to RegisterBank and Substrate"
 ~[3]: "test[runtime] — align tests to branded identifier types"
}

^["cache"]{
 ~#status: "planning"
 ~#files_hot: "src/seed/types/ast/nodes.ts, src/runtime/state/register-bank.ts"
 ~#next_commit: "1"
 ~#open_count: "2"
