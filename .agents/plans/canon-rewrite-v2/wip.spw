// ═══════════════════════════════════════════════════════════
// MEASURE PROTOCOL — %name + four landmarks
// ═══════════════════════════════════════════════════════════

^["measure_protocol"]{
 // % is measure (register bank: ratio / normalized instrument).
 // Name = what is measured. Landmarks = how to read/run it.
 // FORBIDDEN: %objective[foo]  →  use %foo { interprets: objective … }

 landmarks: .{
  interprets: "objective | subjective | mixed | interpretive — authority of the claim"
  considers: "basis, sample, profile, excluded noise"
  surfaces: "live | tree | template | card | cli | lsp | test | postings — disclosure site"
  run: "instrument / recipe / mode that produces the value"
 }

 interprets_authority: .{
  objective: "recomputable; may gate product keys and discharge"
  subjective: "literacy/rank/taste; must not enter IrRef identity"
  mixed: "both parts labeled; only objective part may gate writes"
  interpretive: "teaching profile; no gate"
 }

 surfaces_modes: .{
  live: "register/session working set; partial products; memory-lean"
  tree: "full AST/ONF materialize; exact spwq and AstDelta"
  template: "holes + preprocess blend; pattern capture/apply and format pulses"
  card: "Spw dual-read disclose"
  cli: "stdout/json command surface"
  lsp: "editor projection"
  test: "vitest / fuzz gate"
  postings: "index handle map"
 }

 // Compact catalog — scan vertically: name · interprets · considers · surfaces · run
 catalog: #[
  .{ id: %product_identity, interprets: objective, considers: #[contentHash, uri_span_rev, dialect, lex_profile, producer_schema, boundary, channel_eval], surfaces: #[live, tree, postings], run: "irRefKey" },
  .{ id: %key_excludes, interprets: objective, considers: #[request_epoch, soft_bc_tag, resonance_rank, cache_tier, attention], surfaces: #[test, types], run: "brand + law tests refuse these in IrRef" },
  .{ id: %layout_only_write, interprets: objective, considers: #[brace.equal, ast_structural_empty, lex.triviaOnly], surfaces: #[cli, test], run: "ChangeReport ∧ pulse gate" },
  .{ id: %craft_guard, interprets: objective, considers: #[file_lines, import_count], surfaces: #[test, review], run: "≤600 lines ∧ ≤12 imports else split" },
  .{ id: %gen_skip, interprets: objective, considers: #[.spw/gen, expanded_surfaces], surfaces: #[cli], run: "fs-walk shouldSkipCorpusSurface" },
  .{ id: %effect_ceiling, interprets: objective, considers: #[channel_policy], surfaces: #[runtime, cli], run: "crawl/discharge check" },
  .{ id: %parse_health, interprets: objective, considers: #[before_after_ParseHealth], surfaces: #[card, cli], run: "topography / ChangeReport" },
  .{ id: %path_receipt, interprets: objective, considers: #[dialect, producer_schema, preprocess_flags], surfaces: #[live, product], run: "stamp on every materialized quantum" },
  .{ id: %brand_separation, interprets: objective, considers: #[RequestEpoch, SessionBeat, ContentHash], surfaces: #[types, test], run: "non-assignability" },
  .{ id: %report_identity, interprets: objective, considers: #[beforeHash, afterHash, profileStackHash, producer], surfaces: #[card, test], run: "ChangeReport header" },
  .{ id: %structure_if_brace, interprets: objective, considers: #[brace_severity], surfaces: #[cli, test], run: "severity > layout_ok ⇒ structureMoved" },
  .{ id: %fuzzy_not_exact, interprets: objective, considers: #[fuzzy_hit], surfaces: #[cli, lsp], run: "apply requires spwq/handle revalidate" },
  .{ id: %scheme_version, interprets: objective, considers: #[SearchTuning.scheme], surfaces: #[postings], run: "score memo key only — not product key" },
  .{ id: %basis_tag, interprets: objective, considers: #[lite, full, mixed], surfaces: #[card], run: "tag every fuzzy report" },
  .{ id: %phase_gate, interprets: objective, considers: #[phase.acceptance, stream_evidence], surfaces: #[wip, test], run: "acceptance holds with evidence" },
  .{ id: %eviction_leak, interprets: objective, considers: #[document_evict, index_entries], surfaces: #[test], run: "cache-eviction red→green" },
  .{ id: %apposition_stable, interprets: objective, considers: #[~# names], surfaces: #[corpus, test], run: "stabilize before granule land" },
  .{ id: %temperature_ban, interprets: subjective, considers: #[public_activity_projection], surfaces: #[lsp, card], run: "grep/public API review" },
  .{ id: %resonance_rank, interprets: subjective, considers: #[bytecode, handles, ecology], surfaces: #[cli, live], run: "SearchTuning schedule only" },
  .{ id: %reading_profile, interprets: subjective, considers: #[author, prompt, research, creative], surfaces: #[grain, card], run: "reweight disclose + fuzzy gains" },
  .{ id: %domain_pack, interprets: subjective, considers: #[materials, flow, …], surfaces: #[SearchTuning], run: "feature gains not contentHash" },
  .{ id: %wonder_quality, interprets: subjective, considers: #[wonder_count, probe_depth], surfaces: #[corpus], run: "census open wonders; prefer few" },
  .{ id: %commit_narrative, interprets: subjective, considers: #[episode_scene], surfaces: #[git], run: "scene→change→verify taste" },
  .{ id: %rank_boosts, interprets: subjective, considers: #[sameFixity, sameLabelSite, minScore], surfaces: #[cli], run: "SearchTuning knobs" },
 ]

 law: "interprets:objective may gate keys/writes; interprets:subjective may rank/disclose only"
}

// ═══════════════════════════════════════════════════════════
// OPERATOR STANCES — labels on all sigils (not glyph rebinds)
// ═══════════════════════════════════════════════════════════

^["operator_stances"]{
 // Form: <sigil>_<stance>  e.g. *_subjective  &_objective
 // Stance is operational definition of *how the Act is used in this plan*,
 // not a new lexer token. Implements scannable dual-read of each op.

 law: "stance labels literacy and gate class; glyph runtime meaning stays operators.spw / register bank"

 table: #[
  .{ op: "!", name: action,
     _objective: "force apply / effect intent on discharge",
     _subjective: "urgency of review — does not raise effectCeiling" },
  .{ op: "?", name: wonder,
     _objective: "probe with instrumented !probe receipt",
     _subjective: "open question without instrument" },
  .{ op: "~", name: potential,
     _objective: "plan-only / potentiated product / deferred charge state",
     _subjective: "suspended reading — not yet attended" },
  .{ op: "*", name: value,
     _objective: "collapse bind value carrier into product",
     _subjective: "magnetic-bind literacy reading of *" },
  .{ op: "&", name: subject,
     _objective: "confluence merge / subject key for claims",
     _subjective: "WITH/OF rhetorical join — not automatic merge" },
  .{ op: "^", name: integration,
     _objective: "structural lift into published/header form",
     _subjective: "ascension metaphor for status — not liminality alone" },
  .{ op: "#", name: vibration,
     _objective: "resonate/category/set/particle lattice signal",
     _subjective: "electrical-bus reading — never rebind primary #" },
  .{ op: "@", name: perspective,
     _objective: "observer scope / ref handle",
     _subjective: "whose grain discloses the card" },
  .{ op: ".", name: ground,
     _objective: "path step / property ground",
     _subjective: "narrative ground — render-only orientation risk" },
  .{ op: "$", name: substrate,
     _objective: "register meta / session substrate id",
     _subjective: "felt substrate of work — not a second clock" },
  .{ op: "%", name: measure,
     _objective: "landmarked instrument (this protocol)",
     _subjective: "felt thrift without scheme id — refuse as gate" },
  .{ op: "=", name: configuration,
     _objective: "register write / declared config",
     _subjective: "preference as if law — refuse without channel" },
  .{ op: "<>", name: coupling,
     _objective: "bidirectional edge when keys allow",
     _subjective: "soft couple literacy" },
  .{ op: "_", name: hole,
     _objective: "AT site / pattern hole / ONF hole",
     _subjective: "deliberate under-specification for teaching" },
 ]

 // Diff-card triad (prepositional geometry) — always with stance if ambiguous
 diff_triad: .{
  _: "AT hole — often _objective on templates"
  &: "WITH subject — &_objective on authority; &_subjective on prose join"
  ^: "INTO integrate — ^_objective on structure promote"
 }

 charge_pair: .{
  ~_objective: "potentiated plan"
  *_objective: "value discharge bind"
  ~_subjective: "not yet cared about"
  *_subjective: "magnetic literacy only"
 }
}

// ═══════════════════════════════════════════════════════════
// REGISTERS — working set for live mode
// ═══════════════════════════════════════════════════════════

^["registers"]{
 // Align with @register_bank; plan uses registers as live-mode memory, not new physics.
 @bank: @register_bank

 plan_registers: .{
  // Named slots agents may hold without re-materializing trees
  $phase: "current phase id 0..7"
  $corpus_pass: "A..F or empty"
  $mode: "live | tree | template — active interpretation mode"
  $channel: "stability channel for next discharge"
  $grain: "resolved granularity card"
  $tuning: "SearchTuning scheme + weights"
  $last_report: "ChangeReport handle / @bc"
  $last_measure: "last %name + landmarks"
  $open_wonders: "set of #>wonder ids still open"
  $hot_files: "craft-guard watch list"
 }

 access: .{
  live: "read/write plan_registers + BeatCache inspect plane; avoid full AST"
  tree: "materialize AST/ONF into temporary registers; drop after op"
  template: "bind holes into $bindings; preprocess under dialect; optional tree for validate"
 }

 %register_pressure{
  interprets: objective
  considers: #[cache_max_entries, inspect_plane_size, open_docs]
  surfaces: #[live, runtime]
  run: "session.stats + BeatCache.stats; demote by session_beat only"
 }
}

// ═══════════════════════════════════════════════════════════
// INTERPRETATION MODES — live / tree / template
// ═══════════════════════════════════════════════════════════

^["interpretation_modes"]{
 // Three modes trade memory, exactness, and preprocess blend.
 // Select per op; stamp on %measure.surfaces and product producer notes.

 live: .{
  aim: "memory efficiency; streaming/working-set interpretation"
  materializes: #[tokens_window, handles, bytecode, phrase_census, registers]
  avoids: #[full_ast_unless_required, whole_corpus_parse]
  good_for: #[fuzzy_rank, cite_follow, activity, granule_validity_probe, census_skim]
  charge: "~_objective products stay potentiated; * only on explicit bind"
  %live_footprint{
   interprets: objective
   considers: #[open_docs, inspect_entries, postings_hot]
   surfaces: #[live, runtime]
   run: "session inspect plane caps"
  }
 }

 tree: .{
  aim: "exact structural truth"
  materializes: #[full_parse, onf, spwq, AstDelta, brace_projection]
  avoids: #[silent_partial_as_closed]
  good_for: #[exact_query, layout_only_gate, authority_subject, pattern_exact_apply_validate]
  charge: "*_objective after successful parse product"
  %tree_cost{
   interprets: objective
   considers: #[file_bytes, maxAstDepth]
   surfaces: #[tree, test]
   run: "parse + walkAST; budget by grain.depth"
  }
 }

 template: .{
  aim: "blended preprocessing + interpretation — holes, desugar, format pulses, pattern instantiate"
  materializes: #[preprocess_dialect, desugar?, hole_bindings, pulse_plan, snippet_hydrate]
  blend: "preprocess(dialect) → fill holes → optional tree validate → differential"
  good_for: #[pattern_capture_apply, format_pulses, mutate_plan, wonder_scaffold]
  charge: "~_objective until validate; *_objective on accepted after-text"
  %template_blend{
   interprets: mixed
   considers: #[dialect, holes, desugar_flag, bindings]
   surfaces: #[template, cli, card]
   run: "prepare → instantiate → compareLex/Ast → ChangeReport"
  }
 }

 mode_matrix: #[
  .{ op: "census/graph", prefer: live, escalate: tree },
  .{ op: "select/spwq exact", prefer: tree, escalate: none },
  .{ op: "fuzzy find", prefer: live, escalate: tree_revalidate },
  .{ op: "pulse plan", prefer: template, escalate: tree },
  .{ op: "pulse write", prefer: template_then_tree, escalate: refuse_if_structure },
  .{ op: "granule reuse", prefer: live, escalate: tree_on_envelope_miss },
  .{ op: "wonder probe", prefer: live, escalate: template_if_scaffold },
 ]

 dialect_flow: "modes ride SurfaceProfileStack; dialect preprocess is template/live shared; tree always stamps %path_receipt"
}

// ═══════════════════════════════════════════════════════════
// WONDER ARCHITECTURE
// ═══════════════════════════════════════════════════════════

^["wonder_architecture"]{
 // Enhance trailing ?[] footer pattern into navigable, measurable inquiry nodes.

 node: .{
  id: "#>wonder_<topic_stable>"  // not path-encoded
  body: "?[\"…\"]{ landmarks + optional !probe }"
  layer: pragmatics
  charge: ~_objective  // potentiated until answered
 }

 landmarks_on_wonder: .{
  // Same four as %measures so wonders are scannable instruments
  interprets: "usually subjective|interpretive; objective if !probe has method"
  considers: "axes, files, measures in scope"
  surfaces: "card|cli|registry|live"
  run: "manual | !probe recipe | template scaffold"
 }

 registry: .{
  home: "domain index.spw or domain/_wonder.spw list of ids + one-liner + status"
  status: #[open, answered, deferred, refused]
  edges: " ~#neighbor + pathref — ecological resonance"
 }

 probe: .{
  form: "!probe{ … }"
  stance: "!_objective when instrumented; !_subjective when rhetorical"
  receipt: "optional %name { … } result"
 }

 modes: .{
  live: "list open wonders from $open_wonders; no full parse"
  tree: "spwq for ? and #>wonder*"
  template: "scaffold new wonder from pattern capture"
 }

 quality: %wonder_quality  // see measure catalog

 anti_patterns: #[
  "path-encoded ids wonder_docs_theory_…",
  "auto pair of empty wonders per file",
  "wonder that claims grammar authority",
 ]

 // Embedded wonders for this branch — topic-stable ids
}

#>wonder_clocks
?["If request epoch and session beat shared a public name, which product key fails first?"]{
  interprets: objective
  considers: #[%key_excludes, %brand_separation]
  surfaces: #[test, card]
  run: "construct IrRef with epoch field — must refuse"
  !probe{ "assignability between RequestEpoch and SessionBeat brands." }
}

#>wonder_brace_bias
?["Brace equal but reader feels motion — missing lex stratum or subjective Δ?"]{
  interprets: mixed
  considers: #[%layout_only_write, %structure_if_brace, %temperature_ban]
  surfaces: #[cli, card]
  run: "ChangeReport on comment-only vs channel-tag edit"
  !probe{ "compare usefulness class and write gate." }
}

#>wonder_dialect_flow
?["Which combinator path does Spw.l close that Spw.b leaves open — same glyphs, different %path_receipt?"]{
  interprets: objective
  considers: #[%path_receipt, dialect_preprocess]
  surfaces: #[tree, test]
  run: "prepare under two dialects; compare product keys"
  !probe{ "hash preprocess output; stamp path receipts." }
}

#>wonder_nominal_vs_syntactic
?["After particle pass A, do nominal postings beat syntactic cosine for find-frame?"]{
  interprets: subjective
  considers: #[%resonance_rank, %rank_boosts, handles]
  surfaces: #[cli, live]
  run: "precision@k label query vs bytecode neighbors"
  !_subjective{ "rank only — exact apply still revalidates" }
}

#>wonder_star_magnetic
?["What falsifies treating * as physical force rather than *_objective value bind / *_subjective literacy?"]{
  interprets: interpretive
  considers: #[@charge, interpreter_*]
  surfaces: #[card]
  run: "trace * → ChargePacket claims"
  !probe{ "list instrumented vs named-only claims." }
}

#>wonder_hub_ecology
?["If workspace stops being graph sun, which indexes become stars — biome or accident?"]{
  interprets: subjective
  considers: #[ecological_resonance, pass_C]
  surfaces: #[cli]
  run: "spw graph before/after hub split"
  !probe{ "list hubs; wonder-bridge edges." }
}

#>wonder_obj_subj_delta
?["Can MutationVector and taste census disagree on 'nothing changed' — who opens effect.l2?"]{
  interprets: objective
  considers: #[%layout_only_write, %wonder_quality]
  surfaces: #[cli, test]
  run: "whitespace pulse vs particle-header edit"
  !probe{ "only objective layout_only may authorize --write." }
}

#>wonder_mode_memory
?["When does live mode lie by omission versus tree mode waste memory — who picks $mode?"]{
  interprets: mixed
  considers: #[%live_footprint, %tree_cost, grain]
  surfaces: #[live, runtime]
  run: "same query live vs tree; compare product set and RSS proxy"
  !probe{ "document escalate rules in mode_matrix." }
}

#>wonder_template_blend
?["Is pattern apply a template mode discharge or a tree mode rewrite — where does %template_blend stop?"]{
  interprets: mixed
  considers: #[%template_blend, %fuzzy_not_exact, channel]
  surfaces: #[template, cli]
  run: "instantiate → ChangeReport → ceiling check"
  !probe{ "refuse apply without exact revalidate." }
}

#>wonder_register_pressure
?["Which plan_registers must survive a session_beat demotion without invalidating %product_identity?"]{
  interprets: objective
  considers: #[%register_pressure, %product_identity]
  surfaces: #[live]
  run: "tick BeatCache; assert IrRef keys stable"
  !probe{ "retention ≠ identity." }
}

// ═══════════════════════════════════════════════════════════
// DIFFERENTIALS
// ═══════════════════════════════════════════════════════════

^["differentials"]{
 thesis: "Objective strata are the edit script; subjective strata are reader/ecology; brace and operational biases project; dialect flow chooses combinator path."

 objective: .{
  strata: #[source, lex, ast, onf, brace, ref, operation]
  carriers: #[SourceDifferential, LexDelta, AstDelta, BraceProjectionDelta, TopographyDelta, MutationVector]
  combinatorics: "op × boundary × fixity × path"
  measure: %report_identity
 }

 subjective: .{
  strata: #[taste, reading, wonder, ecological_role, literacy]
  law: "advise only — no layout-only, no cache hit"
  measure: %reading_profile
 }

 brace_bias: .{
  equal: "layout candidate with lex.triviaOnly"
  drift: #[kind, placement, channel, couple, medial]
  measure: %structure_if_brace
  stance: "&#_objective on structure; &#_subjective never softens severity"
 }

 operational_bias: .{
  sources: #[@dialect_policy, SearchTuning, dimensional_axes]
  law: "never mutates contentHash"
  measure: %rank_boosts
