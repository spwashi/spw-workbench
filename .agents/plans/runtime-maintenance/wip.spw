}

^["commits"]{
 # Named, in order. Planned ~[name]; landed .[name](hash). Names are never reused.
 .[plan](cfc0c9c9): ".[plans] — runtime-maintenance records the runtime survey and the moves no plan owned"
 .[legacy_tests_home](891e93b9): "![tests] — every legacy test moves beside the source it exercises: 12 runtime tests to packages/spw-runtime, 4 CLI tests to packages/spw-cli, 29 seed tests to packages/spw-seed, 3 analyzer tests beside their scripts, so tsc checks them all; the stage tests leave normalize.test.ts for the runtime package and can now fail"
 .[retire_src_shims](1a1b95bb): "&[packages] — 87 of the 88 re-export shims in src/seed and src/runtime are deleted; src/runtime/index.ts stays as a compatibility boundary for a mounted consumer, and .spw refs that resolved into shim directories point at the packages"
 ~[runtime_compat_index]: "&[packages] — src/runtime/index.ts is deleted once the mounted consumer that aliases it imports the package path or a typed build (parser-releases typed_variants)"
 ~[seed_docs_home]: ".[docs] — the four files in src/seed/docs move to a docs home or have their @here refs re-rooted at packages/spw-seed/src; docs/toc.spw, docs/index.spw, two v0.2.0-alpha surfaces and the lsp smoke test follow"
 ~[legacy_path_prose]: ".[docs] — the 133 prose mentions of retired src/seed and src/runtime paths in 52 files name their package twins; the 43 that name paths that never existed are fixed or dropped"
 ~[analyzer_test_twins]: "![analyzers] — the three analyzer tests moved from the seed tree and their newer twins in scripts/analyzers/__tests__ become one set; the twins' three failures (refactor-check 1, topography-scan 2) are fixed or the assertions retired with a reason"
 ~[layer_check_target]: "![review] — layer-check.sh and semantics-check.sh read packages/spw-seed/src and packages/spw-runtime/src, where the code is; they checked one-line shims before and check nothing now (with refactor-import-sprawl)"
 ~[wonder_axioms_test]: "![docs] — docs/library/__tests__/wonder-axioms.test.ts is rewritten against the runtime that exists or removed; it imports src/lang and an Interpreter class with a generator evaluate, neither of which is in this repo, and no config runs it"
 ~[runtime_value_module]: "vocab[runtime] — state/runtime-value.ts holds the value algebra (clone, merge, magnitude), record and frame guards, and nowIso for register-bank and the interpreter; the two magnitude formulas reconcile or are named for their difference"
 ~[split_register_bank]: "&[runtime] — register-bank.ts splits into the bank, a memory-budget facade, coupling, and marks with liminality, keeping the RegisterBank surface"
 ~[split_hot_session]: "&[runtime] — hot-session.ts moves its cite, follow, and collapse pointer store beside it, so evaluate and inspect stand alone; coordinated with fragment-pointers"
 .[one_hash_module](eb34e6c3): "&[seed] — one content hash: hashString, geometry cards, and transform preconditions take 16 hex of SHA-256 over UTF-8 bytes, and the CLI's own sha256 copies use seed's"
 .[node_free_seed_root](0bf89a77): "&[seed] — seed hashes with a synchronous SHA-256 over UTF-8 bytes and leaves node:crypto, so its whole package bundles for a browser"
 .[runtime_node_subpath](900e2b9c): "&[runtime] — the runtime root is portable: hashing moves to seed's SHA-256, and mount resolution and composition evaluation move to @spwashi/spw-runtime/node"
 ~[interpreter_handlers]: "&[runtime] — the evaluate switch becomes a handler table keyed by node kind, one handler per sigil family"
 ~[prune_dead_exports]: "&[runtime] — exports with no importer beyond the barrels (33 of 98 in the spot check) are dropped or marked internal, after ?[public_surface]"
}

