# wip — host-receipts
# Started: 2026-11-08

#>plan_host_receipts
#:plan #!projection_feedback
#:layer #!pragmatics

@["card"]{
 phase: #seed
 gist: "Every parser or tooling change lands with a receipt per host (spw.quest, factshift.center, two mounted consumers): what reads, what reads differently, where readers part, and a before/after an editor or docs page shows"
 touches: [~"packages/spw-cli/src", ~"packages/spw-lsp/src", ~".agents/plans/reading-drift/wip.spw", ~".agents/plans/plan-stream-parse-health/wip.spw"]
 will_touch: [~".spw/exchange"]
 entry: ~"./PLAN.md"
 next: "~[host_specimens]: minimal forms per host, starting from the three story-consumer causes and spw.quest's FORMS rows; then ~[degradation_census] once degradation_stop_position lands."
}

^["edges"]{
 needs: [~"../plan-stream-parse-health/wip.spw", ~"../reading-drift/wip.spw"]
 feeds: [~"../parser-releases/wip.spw", ~"../ask-exchange/wip.spw", ~"../commit-gate-redesign/wip.spw"]
 shares: [~"../interpretation-trials/wip.spw", ~"../editor-reading-hierarchy/wip.spw", ~"../first-plugin/wip.spw", ~"../line-kit/wip.spw"]
}

^["roots"]{
 @plan: ~".agents/plans/host-receipts/PLAN.md"
 @drift: ~".agents/plans/reading-drift/wip.spw"
 @health: ~".agents/plans/plan-stream-parse-health/wip.spw"
 @bench: ~".agents/plans/interpretation-trials/wip.spw"
 @intake: ~".agents/plans/ask-exchange/wip.spw"
 @warning: ~"packages/spw-seed/src/parser/parse-expression.ts"
}

^["intent"]{
 ~#goal: "An improvement counts by what it changes on the hosts that read Spw, and each host can see that change as a diff (the owner, 2026-11-08)"
 ~#taste: "A receipt is a count that falls or a reading that moves, never a green word; plugin and docs diffs are where interaction semantics, learnability and extensibility can be researched directly"
}

^["hosts"]{
 # Hosts by role. Corpora are read in place by explicit path; nothing is copied here.
 spw_quest: .{ role = "the bench: a line held in an address, one slot changed at a time" reader = "the site's slot reader, carried" specimens = "FORMS rows (contrasting cases)" }
 factshift_center: .{ role = "the canvas: a line as a field of pulls and pushes, edited byte for byte" reader = "line-anatomy.ts on a March workbench copy" specimens = "garden lines and carried scripts" }
 site_consumer: .{ role = "a mounted consumer: components read with scripts off, asks filed upstream" reader = "seed at its pin, plus expression-query.js" specimens = "route expressions, plane reports" }
 story_consumer: .{ role = "a second mounted consumer: canon records, bracework in prose, desk and map queries, spells with provenance" reader = "six browser readers and a vendored seed bundle" specimens = "chapter bracework, desk spells, map queries, canon surfaces" }
 # How the canvas and the story consumer differ, as read on 2026-11-09 (docs/theory/spw/threshold-distance.spw ^hosts). A receipt reads differently on each.
 contrast: .{ canvas = "Spw is the material: one hub rewrites the held line, in seconds, and everything arrives open" story = "Spw is the receipt and the rule: spells are written out as records, rooms take their law from a mark and a container, and meaning is earned over weeks" receipt = "a reading change moves what a hand can drag on the canvas, and what a room permits or a spell records in the story" }
}

^["open"]{
 # Unresolved questions. When resolved: log in stream, then move to ^["done"] as ~#resolved(label).
 ?[receipt_home]: "A verb of its own (spw receipt), or reading-drift's readings_check growing --hosts so one command answers both?"
 ?[host_weight]: "Does a receipt only list per host, or may it mark a change that helps one host and costs another as needing the owner's call?"
 ?[diff_surface]: "Where does the editor diff live: a page per receipt, a webview in the extension, or a docs page per release?"
 ?[specimen_source]: "Are specimens reduced by hand from each host, or harvested by a selector the host declares, so the host owns its set?"
}

^["commits"]{
 # Named, in order. Planned ~[name]; landed .[name](hash). Names are never reused.
 ~[host_specimens]: "#[exchange] — .spw/exchange/specimens.spw: per-host specimen sets as minimal forms written fresh (no consumer prose), each tagged with the reading its host expects; the story consumer's three causes and spw.quest's FORMS rows first"
 ~[degradation_census]: "&[cli] — lint over a corpus named by path counts surfaces read as prose, with the stop position and a cause class (valence word, typography in bare prose, quoted-name bracket, bare + in a value, phrase cut by a backtick, other); on 2026-11-08 main reads 22 of 59, 18 of 447 and 0 of 18 on three host corpora"
 ~[receipt_check]: "&[cli] — one parser revision against another over every named corpus: degraded before and after, lines whose reading changed (reading-drift readings_check), reader agreement on specimens (trial_bench); one table per host (after ?[receipt_home])"
 ~[editor_diff]: "&[lsp] — each changed specimen rendered as the editor shows it before and after: semantic tokens, diagnostics (degradation_diagnostic) and hover, on one page a person can inspect (after ?[diff_surface])"
 ~[docs_diff]: ".[docs] — docs examples re-read under the new revision; an example whose reading changed is listed with its old and new reading, and its prose is checked against the new one"
 ~[receipt_in_episode]: ".[commit-review] — a commit that changes reading cites its receipt in *[verify]: per host, degraded before and after and readings changed (with reading-drift grammar_receipt, one line, not two)"
 ~[runtime_read_surfaces]: "#[exchange] — the specimens name which of a host's surfaces running code reads, by which reader (the parser, a small reader, a regular expression), so a receipt can say a change reaches play and not only lint; one consumer's rules file is read by the parser for five frames and skipped for two that its game keeps in script"
}

^["stream"]{
 >>[2026-11-08 09:45] decide — The owner asked that parser and tooling improvements be developed as they become meaningful through spw.quest, factshift.center and two mounted consumers, and named plugin improvements and documentation as the most inspectable surface for those diffs, since their interaction semantics, learnability and extensibility can be researched directly. Opened this plan to hold the per-host receipt; it composes reading-drift, trial_bench and degradation_lint rather than adding a fourth measure.
 >>[2026-11-08 09:45] observe — Baseline at main@3d3181b4, seed prose profile, generated trees excluded: story consumer 22 of 59 surfaces read as prose, site consumer 18 of 447 (plans 4 of 388), factshift.center 0 of 18, workbench .spw 5 of 762, workbench plans 14 of 286 (12 in archived seed excerpts). The story consumer's lint reported 0 errors on its 22, and its pin sat 128 commits behind main on an archived branch; the site's pin is one behind.
 >>[2026-11-08 09:45] observe — Causes, isolated by removing one line at a time: story consumer 10 typography in bare prose (’ · — inside ~<rationale>{ blocks, where ASCII prose reads), 6 valence keys (one a cast member named bonk:), 6 quoted-name brackets followed by a line break; site consumer adds a bare + in a facet value and a backtick phrase cut short by an inner backtick. The consumer's own diagnosis named the frame openers instead, the misattribution degradation_stop_position predicts.
 >>[2026-11-09 18:12] observe — Both mounted consumers read on 2026-11-09. The second re-pinned to main at edbc5500 on a detached head; its own lint now reports 18 of 84 surfaces degraded to prose, where the baseline of 2026-11-08 read 22 of 59. Six of its runtime files are read by running code: one by the parser for five frames while two frames are skipped and kept in script, the rest by small readers or regular expressions; runtime_read_surfaces planned so a receipt can say a change reaches play. A contrast row for the canvas and the story consumer is in the hosts frame.
 >>[2026-11-09 19:01] observe — First receipt written by hand for a grammar change (2026-11-09, the valence fix in the working tree): per corpus, surfaces falling back to prose before and after (here 9 to 8, the site consumer 13 to 10, a second mounted consumer 17 to 9), surfaces reading worse (none), error counts (unchanged), and the healed surfaces by name. It took one scratch script that parses every surface twice and compares file by file, which is the degradation_census and receipt_check commits in miniature.
 >>[2026-11-10 23:02] observe — Second receipt by hand, for three parser changes (2026-11-10, landed as 7b8e2250, journal 2026-11-10-play-and-reach): a second mounted consumer 11 to 0 of 85 surfaces falling back to prose, the site consumer 18 to 18 of 483, here 45 to 45 of 1,212; none worse, errors unchanged. A fallback count is not enough, twice over: comparing trees caught four site surfaces moved from a medial capsule to an operation, and a value-position probe caught surfaces counted healed that had a value cut short with a stray chunk beside it. So a receipt needs read_differently as a column, and a healed surface needs its tree read. 10 of the site's 18 stop at a bare + in a value.
 >>[2026-11-12 09:19] observe — Evidence for ?[receipt_home], not a resolution: reading-drift's gate is uncommitted on main 2026-11-12 as spw fingerprint --readings with --write and --check, and it read the story consumer's corpus in place by path, keeping a fingerprint per line and a text hash per surface and no source text. It answers read_differently by line: the build before 7b8e2250 against today shows 74 lines in 4 of that consumer's 100 surfaces, all four prose before and whole after. What a receipt needs that it does not give: the snapshot keeps each surface's prose-fallback flag but the check does not report a change in it; it has no column for the slot a brace pair fills; separators are left out; and it says nothing of where readers part. Read the same day by excerpt, not run (journal 2026-11-12-pattern-fluency): spw.quest sets two readings side by side on five surfaces and its parser index lists one release, so no surface there compares two builds yet.
}

^["cache"]{
 ~#status: "seed"
 ~#base_ref: "main@3d3181b4"
 ~#rebased_at: ""
 ~#files_hot: ""
 ~#next_commit: "host_specimens"
 ~#open_count: "4"
 ~#last_stream: "2026-11-12 09:19"
}

^["done"]{
}
