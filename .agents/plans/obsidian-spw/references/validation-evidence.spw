# Validation Evidence — obsidian-spw

#:layer #!reference
@region:validation_evidence

^["research_question"]{
 ~#question: "Can obsidian-spw become a native-feeling interaction target by unifying syntax, views, and local intelligence without sacrificing privacy, durability, or reversibility?"
 ~#hypothesis: "the target will feel native when one syntax truth serves three render planes, the LSP bridge behaves like infrastructure, and degraded states remain explicit and local"
}

^["measurements"]{
 timings: [#lex_ms, #initialize_ms, #annotation_refresh_ms, #atlas_refresh_ms, #view_rebuild_ms]
 counts: [#process_restart_count, #pending_request_count, #view_instance_count]
 traces: [#failure_drill_notes, #reload_behavior, #restore_behavior]
}

^["negative_controls"]{
 control_1: "markdown notes without `spw` fences should not show additional editor churn or decoration residue"
 control_2: "plugin disable or reload should not leave duplicate leaves, duplicate listeners, or orphan child processes"
 control_3: "LSP absence should not prevent file-open syntax or reading-view rendering"
}

^["evidence_packet"]{
 visuals: [#direct_file_screenshot, #fence_preview_screenshot, #concepts_leaf_screenshot, #atlas_leaf_screenshot, #degraded_health_screenshot]
 diagrams: [#subsystem_diagram, #path_translation_diagram, #failure_surface_map]
 logs: [#latency_capture, #restart_capture, #restore_capture]
 prose: [#architecture_defense, #manifesto_trace, #tradeoff_record]
}

^["demo_path"]{
 step_1: "open a .spw file from the vault and show direct rendering"
 step_2: "open a markdown note with a `spw` fence and show reading/editing parity"
 step_3: "open Concepts and Atlas to show vault-local structure and transfer from existing targets"
 step_4: "kill or misconfigure the server and show honest degraded behavior plus operator recovery"
 step_5: "restore the plugin and show the system returns without residue"
}

^["proof_discipline"]{
 success: [#single_token_truth, #native_substrate_fit, #recoverable_process_model, #manifesto_alignment]
 anti_patterns: [#demo_only_hack, #unmeasured_latency_claim, #hidden_failure, #editor_target_copy_paste]
}

^["branch_narrative"]{
 shape: "one branch that owns file format, host substrate, protocol boundary, and failure posture as a single design"
 artifacts: [#plan, #artifact, #reference_dossier, #screenshots, #drill_notes]
}

#>wonder_agents_plans_obsidianspw_validationevidence_1
?["What evidence would make a skeptical staff interviewer believe the architecture is real?"]{
  #:depth #!educational // lens: proof conversion
  &[#measurements, #negative_controls, #evidence_packet, #demo_path] => $[#credible_claim]
  !probe{ "exclude screenshots without drills, claims without timings, and architecture diagrams without operational failure stories." }
  ~<.agents/plans/obsidian-spw/PLAN.md>
}
