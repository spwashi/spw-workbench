# obsidian-spw — vault-native interaction target

#:layer #!design
@region:obsidian_spw

^["thesis"]{
 ~#claim: "Obsidian is not merely the fourth editor target. It is the first Spw target whose native substrate is a local note graph, so the integration must honor files, fences, and views as equal truths."
 ~#bar: "make Spw feel native to the vault without cloud dependency, parser drift, or hidden operational fragility"
}

^["shape"]{
 syntax: [#single_token_truth, #token_map_adapter, #cm6_extension, #reading_renderer, #file_view]
 intelligence: [#stdio_bridge, #json_rpc, #custom_requests, #context_strip]
 views: [#concepts_leaf, #atlas_leaf, #vault_topology]
 substrate: [#markdown_co_presence, #workspace_leaf, #vault_relative_paths, #desktop_only_locality]
}

^["novelty"]{
 new_for_spw: [
  #three_render_pipelines,
  #custom_lsp_client,
  #vault_native_topology,
  #file_and_fence_coexistence,
 ]
 reusable: [
  #interaction_target_taxonomy,
  #token_map_bridge,
  #portable_request_types,
  #view_model_transfer,
 ]
}

^["guardrails"]{
 durable: "the file is the source of truth; rendering is disposable"
 private: "all intelligence stays local; no analytics, no network"
 malleable: "parser and completion internals may change without breaking the surface contract"
 graceful: "syntax remains useful when the LSP is absent"
 honest: "desktop-only constraints are declared, not obscured"
}

^["staff_signals"]{
 systems_thinking: "own host APIs, file model, protocol transport, and user-facing recovery as one design"
 boundary_ownership: "explicit seams between lexer, adapters, views, and process lifecycle"
 transfer_discipline: "reuse semantics and request models across targets while respecting target-specific substrates"
 proof_culture: "pair claims with drills, controls, and evidence surfaces"
}

^["proof"]{
 must_show: [#syntax_parity, #view_legibility, #recoverable_bridge, #manifesto_trace]
 must_not_do: [#copy_vscode_ui, #invent_parallel_grammar, #require_cloud, #hide_failure]
}

#>wonder_agents_plans_obsidianspw_artifact_1
?["Where does Obsidian force Spw to become more honest about its own abstractions?"]{
  #:depth #!computational // lens: target pressure
  &[#three_render_pipelines, #custom_lsp_client, #vault_native_topology] => $[#interaction_target_taxonomy, #staff_signals]
  !probe{ "look for the places where Obsidian refuses borrowed assumptions from VS Code, IntelliJ, or Neovim." }
  ~<.agents/plans/obsidian-spw/references/interaction-targets.spw>
}
