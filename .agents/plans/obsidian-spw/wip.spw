  #token_array_vs_stream,    // spw-seed lexer produces token array, CM6 expects character stream
  #vault_vs_filesystem,      // Vault API is vault-scoped; LSP uses file:// URIs
  #reading_vs_editing,       // two distinct rendering pipelines in Obsidian
  #desktop_only,             // child_process requires isDesktopOnly: true
  #recoverability,           // custom LSP client must fail honestly and restart cleanly
  #proof_burden,             // staff-level claims need drills, metrics, and negative controls
  #grammar_scope_boundary,   // Lezer syntax tree scope must not silently turn into a semantic parser rewrite
 ]
 transfers: [
  #protocol_types,           // SpwCustomRequestMap interfaces — portable, duplicate for now
  #annotation_index,         // AnnotationEntry schema, byName/byFile lookup — transfers directly
  #sigil_semantics,          // 23-sigil table with role/physics/phase — pure data, no adaptation
  #root_map,                 // 27 sigil→path mappings — adapt to vault-relative paths
  #context_snapshot,         // SpwCursorContextSnapshot cache logic — adapt to CM6 EditorView
  #density_bars,             // unicode block frequency encoding — transfers directly
  #co_occurrence,            // concept co-occurrence algorithm — transfers directly
  #braid_triples,            // framePath/local/ambient/delta structure — transfers directly
  #spirit_phases,            // 6-phase distribution with 6-char density bars — transfers directly
  #failure_drills,           // restart / restore / degraded-state discipline transfers as method
  #evidence_packet,          // screenshots + diagrams + logs transfers as interview proof method
  #portable_parser_package,  // syntax infrastructure belongs in packages/, not inside an editor target
 ]
}

