#>wonder_agents_plans_obsidianspw_w_1
?["Does a CM6 editor extension registered by an Obsidian plugin ever see the text of a spw fence inside a markdown note?"]{
  #:depth #!computational // lens: host activation
  $^["architecture"]@here => %[fence.extension_hit, note.decoration_residue]
  ~#hypothesis: "the extension sees the whole markdown document but not a nested language, so fence tokens need a decoration pass of our own"
  !probe{ "after ~[scaffold_plugin], register a logging extension that records the document ranges it is asked to decorate; open one note with a spw fence and one without; compare the logged ranges and any decoration left on the plain note." }
  $%[obsidian.version, fence.extension_hit, note.decoration_residue]
}
