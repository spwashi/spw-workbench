# Precipitate Model Alignment — Canonical Chemistry Note
# @spw:contract:canonical[system=runtime-chemistry,basis=v0.2.0-alpha]

#:layer #!semantics

^"model"{
  ~#molecule: "σ[frame]{body} — the fractal unit at every scale."
  ~#substrate: "The event-log and resonance medium for all runtime state."
  ~#enzyme: "Normalizer + combinators — reshape without consuming."
  ~#catalyst: "Query layer (spwq) — enables reactions without being consumed."
  ~#precipitate: "A stable artifact resulting from a transformation stage."
  ~#assay: "Instrumentation + telemetry — measures without interfering."
  ~#membrane: "<> operator — exchange boundary (coupling, capsule, stream)."
}

^"periodic_table"{
  ~#note: "See src/runtime/state/type-affinities.ts for the canonical table."
  elements: {
    "!": "Activation energy — triggers irreversible change",
    "^": "Covalent bonding — promotes into stable structure",
    "~": "Activation potential — energy stored, not yet released",
    "?": "Catalyst site — lowers barrier, not consumed",
    "*": "Saturation — precipitates at value scale, dissolves at pattern scale",
    "=": "Configuration — sets the conditions of the reaction",
    "@": "Observer/assay — measures without disturbing",
    "#": "Harmonic bond — aggregation by shared frequency",
    ".": "Extraction — pull component from mixture",
    "&": "Mixture — multiple streams merging",
    "$": "Substrate — the medium the reaction occurs in",
    "%": "Titration — quantitative measurement of concentration",
    "<>": "Membrane — exchange boundary (coupling, capsule, stream)",
  }
}

^"bonds"{
  ~#note: "Four brace pairs = four bond types, fractal at every scale."
  ionic: "[] — specification of conditions (frame)"
  covalent: "{} — shared containment (body)"
  hydrogen: "<> — weak exchange / membrane (capsule)"
  metallic: "() — delocalized perspective (scope)"
}

^"stages"{
  ~#note: "Implementation names kept. Chemistry is a parallel lens."
  desugar: "Wash — strip impurities from source material"
  parse: "Crystallize — structure emerges from dissolved source"
  normalize: "Refine — enzyme reduces crystal to canonical form (ONF)"
  interpret: "React — substrate + catalyst → precipitate"
}

^"fractal"{
  principle: "σ[frame]{body} repeats at every scale."
  scales: [
    "token:      ! — a single operator acting",
    "expression: ^[\"intent\"]{...} — operator + frame + body",
    "file:       #:layer #!semantics — the file itself is a molecule",
    "project:    package.json[scripts]{src/} — the repo is a molecule",
    "install:    .spw/_workbench — the workbench as molecule in another project",
  ]
  breaks: {
    "~": "Three uses (defer, path-ref, annotation) — coherent as 'not yet resolved'",
    "*": "Inverse at different scales — reframed as 'saturation'",
    "<>": "Three container grammars — unified as 'membrane / exchange boundary'",
  }
}

^"installation"{
  ~#note: "When the workbench is cloned into .spw/_workbench, it acts as:"
  solvent: "Substrate dissolves host concepts into Spw's operator grammar."
  enzyme: "Normalizer + grammar fold host concepts into ONF without consuming them."
  catalyst: "spwq enables pattern-matching reactions across the host's .spw files."
  assay: "Audit scripts measure the solution without changing it."
  precipitate: "Pipeline output — the crystals the host can consume."
}

^"invariants"{
  ![stage_continuity]: "Each stage MUST produce exactly one precipitate."
  ![telemetry_locality]: "Assays are local to the acting stage but buffered in the substrate."
  ![fractal_consistency]: "σ[frame]{body} must be recognizable at every scale."
}
