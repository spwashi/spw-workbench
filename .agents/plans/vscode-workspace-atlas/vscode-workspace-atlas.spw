# interaction spec — vscode-workspace-atlas

#:layer #!pragmatics

^["roots"]{
 @cluster: ~".agents/plans/plan-ecology-clustering/plan-ecology-clustering.spw"
 @references: ~".agents/plans/vscode-workspace-atlas/references/index.spw"
 @workspace: ~".spw/workspace.spw"
 @selection: ~".spw/conventions/selection.spw"
 @tooling: ~".spw/tooling/vscode-spw.spw"
}

^["cluster_role"]{
 lane: #speculative_editor_future
 ladder: #component
 rule: "the atlas is a component-scale map that should make workspace structure and query context discussable even when richer peers have not landed yet"
}

^["surface"]{
 ~#view_id: "spwWorkspace"
 ~#container: "spw-explorer"
 ~#purpose: "Render the workspace contract as a navigable atlas of roots, memory, generated surfaces, and harness locations."
 ~#empty_state_trigger: "no workspace folder or no readable manifest"
 ~#fallback_policy: "degrade to static roots plus indexed guesses when manifest data is absent"
 ~#rotation_model: "selected node can rotate between topology, contract, resonance, phase, and query lenses"
 ~#cross_plan_contract: ".agents/plans/vscode-workspace-atlas/vscode-interaction-contract.spw"
 ~#context_contributes: ["manifestState", "workspaceTemperature", "activeRoot"]
}

^["sections"]{
 root_manifest: {
  label: "Roots"
  child_nodes: ["workspace", "docs", "lib", "src/seed", ".agents"]
  item_copy: "open root, reveal path, show contract excerpt"
 }
 memory_map: {
  label: "Memory"
  child_nodes: ["hot", "warm", "cold", "generated"]
  item_copy: "open surface, explain ownership and mutation policy"
  declared_layer: "manifest placement — fixed paths from ^memory_locations with ownership descriptions"
  observed_layer: "index temperature — live cache tier, beat age since last access, write count"
  dual_presentation: "declared placement as section label, observed temperature as per-file detail"
 }
 projections: {
  label: "Generated"
  child_nodes: ["generated root", "spec owners", "projection targets"]
  item_copy: "open source spec, open generated target, show stale state"
 }
 harness: {
  label: "Harness"
  child_nodes: ["runs", "evals", "memory surface", "probe archive"]
  item_copy: "open root and summarize contract"
 }
 contracts: {
  label: "Contracts"
  child_nodes: ["cache", "ux", "dense dialect", "operator envelope"]
  item_copy: "open referenced contract surface"
 }
 graph_queries: {
  label: "Queries"
  child_nodes: ["neighbors", "cross-tree resonance", "projection lineage", "subtree focus"]
  item_copy: "run focused graph query from selected atlas node"
 }
}

^["materialization"]{
 #:semantics #!materialization_badges

 ~#cycle: "priming → concept → frame → body"
 ~#reversible: "body → frame via probe/archive replay"

 priming: {
  badge: "charging"
  icon: "$(loading~spin)"
  heuristic: "operator sequences without named ~ bindings"
  description: "register disposition being set"
 }
 concept: {
  badge: "potential"
  icon: "$(lightbulb)"
  heuristic: "named ~ bindings without containing ^ frames"
  description: "named potential, may remain unbound"
 }
 frame: {
  badge: "structured"
  icon: "$(symbol-structure)"
  heuristic: "^-declared container without corresponding ProjectionEntry"
  description: "structural spec, orients relations and probes"
 }
 body: {
  badge: "materialized"
  icon: "$(package)"
  heuristic: "file tracked in projections with valid generated target"
  description: "resolved artifact generated from a frame"
 }
 ungrounded: {
  badge: "ungrounded"
  icon: "$(warning)"
  heuristic: "body whose spec-owner frame has newer content hash"
  description: "projection disconnected from its spec owner"
 }
}

^["phase_perspective"]{
 #:semantics #!spirit_sequence_axis

 ~#sequence: "? ~ @ & * ^"
 ~#computation: "operator frequency analysis per file or root — dominant phase = highest-frequency spirit operator"
 ~#manifest_echo: "$%[op.distribution]@here — mirrors the workspace manifest's own probe"

 phase_nodes: {
  wonder: { sigil: "?", label: "? wonder/probe", description: "files dominated by probes and measurement" }
  potential: { sigil: "~", label: "~ potential/name", description: "files dominated by naming and deferred reference" }
  perspective: { sigil: "@", label: "@ perspective/scope", description: "files dominated by scope-pushing and observation" }
  confluence: { sigil: "&", label: "& confluence/merge", description: "files dominated by frame combination and entanglement" }
  value: { sigil: "*", label: "* value/collapse", description: "files dominated by concrete resolution and materialization" }
  integration: { sigil: "^", label: "^ integration/framing", description: "files dominated by upward binding and emission" }
 }

 binding_phases: {
  action: { sigil: "!", label: "! action", description: "files with high kinetic effect density" }
  config: { sigil: "=", label: "= config", description: "files dominated by constraint and bias" }
  measure: { sigil: "%", label: "% measure", description: "files dominated by quantification" }
  annotation: { sigil: "#", label: "# annotation", description: "files dominated by self-reference and meta" }
 }

 ~#grouping_rule: "phase perspective groups roots and files by dominant operator; binding phases appear as secondary group below spirit phases"
 ~#emission: "atlas.perspectiveRotated({ perspective: 'phase' }) — register explorer can match grouping"
}

^["resonance_presentation"]{
 #:semantics #!resonance_channels

 channels: {
  annotation_cooccurrence: {
   label: "Shared concepts"
   icon: "$(symbol-key)"
   source: "ConceptCluster.coOccurs"
  }
  root_cross_reference: {
   label: "Cross-root references"
   icon: "$(references)"
   source: "SpwSelectorHit cross-boundary paths"
  }
  projection_lineage: {
   label: "Projection links"
   icon: "$(git-compare)"
   source: "ProjectionEntry source → target"
  }
  register_coupling: {
   label: "Register coupling"
   icon: "$(link)"
   source: "shared bindings or provenance across files"
   availability: "requires register-explorer data"
  }
 }

 ~#query_endpoint: "spw/resonance — returns typed edges with channel, strength, and target URI"
 ~#presentation_rule: "strongest channel first; weaker channels expandable on demand"
 ~#inline_badge: "resonance count shown as description suffix on atlas nodes in resonance perspective"
}

^["parallel_work"]{
 critical_path: [#manifest_truth, #interaction_contract]
 parallelizable: [#memory_map, #phase_perspective, #resonance_presentation, #commands]
 shared_hot_files: [@workspace, @tooling]
 merge_risks: [#manifest_vs_index, #transport_cost, #shared_context]
 handoff_artifacts: [@selection, @tooling]
}

^["supporting_documents"]{
 must_ship: [@workspace, @tooling]
 helpful: [@selection, @references]
 carries: [#root_glossary, #fallback_copy, #phase_labels, #onboarding_note, #source_map]
}

^["interaction_depth"]{
 subjects: [#orientation, #navigation, #rotation, #fallback, #density, #legibility, #discoverability]
 questions: [#what_is_primary_context, #what_is_reversible, #what_is_safely_inferred]
 qualities: [#clarity, #containment, #low_noise]
}

^["review_contract"]{
 sources: [@cluster, @references, @workspace, @selection, @tooling]
 asks: [#root_truth, #phase_reading, #query_pivots, #fallback_legibility]
}

^["snippet_routes"]{
 stable: [
  "root contract snippets",
  "query pivot examples",
  "phase-perspective labels",
  "materialization badge copy",
 ]
 rule: "atlas snippets should help other editor surfaces keep the same root, phase, and query language"
}

^["states"]{
 no_workspace: {
  copy: "Open a folder to ground the workspace atlas."
  primary_action: "Open workspace manifest when available"
 }
 unprimed: {
  copy: "Workspace unprimed — no manifest at .spw/workspace.spw. Showing inferred roots."
  primary_action: "Create or open `.spw/workspace.spw`"
  note: "all manifest-strict sections (harness, contracts, generated) are hidden"
 }
 ready: {
  copy: "Atlas grounded — manifest roots and indexed surfaces resolved."
  affordance: "expand sections independently; preserve expansion across re-ground"
 }
 ungrounded: {
  copy: "Manifest changed since last atlas ground. Some surfaces may be stale."
  affordance: "title action promotes re-ground"
 }
}

^["commands"]{
 view_title: [
  "Re-ground Workspace Atlas",
  "Open Workspace Manifest",
  "Collapse Atlas Sections",
  "Rotate Atlas Lens",
 ]
 item_context: [
  "Open Surface",
  "Reveal In Finder",
  "Copy Root Sigil",
  "Open Contract Source",
  "Show Resonance Neighbors",
  "Probe Graph",
  "Show Phase Distribution",
  "Show Materialization State",
 ]
 command_palette: [
  "Spw: Reveal Workspace Atlas",
  "Spw: Open Workspace Manifest",
  "Spw: Re-ground Workspace Atlas",
  "Spw: Rotate Atlas Lens",
  "Spw: Probe Workspace Graph",
  "Spw: Show Phase Distribution",
 ]
}

^["flows"]{
 onboarding_flow: [
  "user opens workspace",
  "atlas resolves manifest and fallback roots",
  "Roots section is expanded by default",
  "selecting a root shows path, contract snippet, and related surfaces",
 ]
 memory_flow: [
  "user expands Memory",
  "each tier node shows ownership summary and target path",
  "open command jumps directly to the declared memory surface",
 ]
 generated_flow: [
  "user expands Generated",
  "spec owner and generated target are shown as siblings",
  "stale projections carry warning badge and open-source command",
 ]
 resonance_flow: [
  "user selects a root or contract node",
  "atlas reveals cross-tree resonances such as shared annotations, projection links, or harness references",
  "Run Graph Query narrows to a focused neighborhood instead of leaving the atlas context",
 ]
 rotation_flow: [
  "user invokes Rotate Atlas Perspective",
  "same selected node rotates between topology, contract, resonance, phase, and query views",
  "expansion state is preserved where node identity still exists",
  "atlas emits atlas.perspectiveRotated event for cross-surface coordination",
 ]
 phase_flow: [
  "user rotates to phase perspective",
  "roots and files regroup by dominant spirit-sequence operator",
  "each group shows operator frequency and phase description",
  "selecting a phase group reveals files dominated by that operator",
  "register-explorer can synchronize to show registers in the same phase",
 ]
 cross_surface_flow: [
  "user selects a root in the atlas",
  "atlas emits atlas.rootSelected event",
  "register-explorer filters to registers touched by files under that root",
  "authoring-loop scopes completions to the selected root's vocabulary",
  "selection context narrows; user drills deeper without losing place",
 ]
}

^["selection_details"]{
 title: "selected atlas node"
 fields: [
  "resolved path",
  "source contract field",
  "workspace plane or category if known",
  "materialization state (priming | concept | frame | body | ungrounded)",
  "dominant spirit-sequence phase and operator frequency",
  "related annotations or projections count",
  "cross-tree resonance count with channel breakdown",
  "live cache tier and beat age",
  "available query pivots",
 ]
}

^["cursor_context_surfaces"]{
 #:pragmatics #!display_language

 ~#principle: "atlas display language should harmonize with the new cursor-context surfaces without confusing manifest truth with observed state"
 ~#sources: ["spw/contextAtPosition", "boundary-entry inlay hints", "wonder synopsis hints", "status strip"]

 strip: {
  label: "Spw"
  role: "quiet, cursor-local atmosphere readout"
  copy_rule: "show frame path plus active facets or the strongest ambient field fragment"
 }

 hover: {
  role: "cursor-local context preamble before long-form semantic detail"
  copy_rule: "frame path first, then active facets, then ambient field"
 }

 atlas_detail: {
  role: "node-level orientation, not cursor-level atmosphere"
  copy_rule: "reuse context vocabulary only when the data is observational and scoped clearly as live/editor state"
  warning: "do not project cursor-local field state onto manifest-declared structure"
 }

 wording: {
  prefer: ["active facet", "ambient field", "field shift"]
  avoid: ["braid" as user-facing default when the substrate only carries atomic facets"]
 }
}

^["nesting_indicator_variants"]{
 #:pragmatics #!reading_rhythm

 ~#principle: "nesting indicators should help the reader feel semantic thresholds, not just count braces"

 variants: {
  structural_first: {
   inline: "show depth markers prominently; semantic hints are secondary"
   use: "debugging and malformed-structure orientation"
  }
  boundary_first: {
   inline: "show enter/inherit/activate or field-shift hints at boundaries"
   use: "semantic reading flow"
  }
  split_surface: {
   inline: "meaningful boundary deltas only"
   strip: "current field state"
   hover: "expanded inheritance story"
   use: "quiet feedback across multiple editor surfaces"
  }
 }

 evaluation_questions: [
  "How quickly does the reader answer where am I now?",
  "Does the indicator explain what changed here or only that nesting exists?",
  "How many hints appear versus how many are actually useful?",
  "Does the surface preserve manifest-vs-observed distinction even inside dense nesting?",
 ]

 ~#current_bias: "favor boundary-first or split-surface over structural-first"
}

^["site_install_considerations"]{
 #:pragmatics #!mounted_editor_future

 ~#principle: "atlas and context surfaces must remain truthful for sites that mount `.spw/_workbench` as infrastructure"

 current_truth: {
  ~#editor: "the current preview extension still assumes a workbench checkout for startup"
  ~#rule: "do not let display-layer work deepen that assumption into the semantic contract"
 }

 mounted_truth: {
  ~#consumer_authority: "the consumer owns `.spw/workspace.spw` and `.spw/mount.spw`"
  ~#workbench_role: "mounted `_workbench` is infrastructure and should read that way in atlas/status/hover surfaces"
 }

 review_prompts: [
  "Would this copy still make sense if the active repo were a site with mounted infrastructure?",
  "Does this status or hover accidentally narrate mounted workbench paths as consumer-owned structure?",
  "Could the same formatter survive a future resolveServerPath implementation that starts from `.spw/_workbench`?"
 ]
}

^["theming"]{
 section_tone: [
  "roots use neutral structural emphasis",
  "memory tiers use subdued temperature cues",
  "generated and stale nodes use caution accents",
  "query and resonance surfaces use accent only on active selection",
 ]
 caution: "the atlas should remain printable and terminal-legible in spirit; chroma cannot be the only carrier of state"
}

^["non_goals"]{
 ~#not_now: [
  "full file browser replacement",
  "editing manifest values from the atlas",
  "automatic root creation",
  "register snapshot transport (register-explorer scope)",
  "phase-aware completion (authoring-probe-loop scope)",
  "persistent resonance history (future slice)",
 ]
}
