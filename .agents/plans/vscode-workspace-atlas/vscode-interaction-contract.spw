# interaction contract — vscode surfaces
#
# Shared event vocabulary and context shape for the three VS Code
# experience plans: workspace-atlas, register-explorer, authoring-probe-loop.
# Each plan contributes fields to SpwContext and emits/consumes events
# defined here. The contract ensures the three surfaces compose into
# one continuous editing experience rather than three independent tabs.

#:layer #!pragmatics
#>vscode_interaction_contract

^["principle"]{
 ~#river: "where am I (atlas) → what is alive here (registers) → what can I do next (authoring)"
 ~#taste: "the three surfaces are one river, not three islands"
 ~#invariant: "every cross-surface navigation preserves the user's selection context and narrows rather than resets"
 ~#composition_rule: "each surface must solo-ship first; shared context, events, and pairwise integrations are additive"
}

^["shared_capabilities"]{
 #:contract #!capabilities

 ~#rule: "cross-surface integrations key off capabilities rather than fixed merge order"

 atlas: [
  "manifestState",
  "workspaceTemperature",
  "activeRoot",
 ]

 registers: [
  "registerSnapshot",
  "focusedRegister",
 ]

 authoring: [
  "activePhase",
  "materializationState",
  "probeHistory",
 ]
}

^["shared_context"]{
 #:contract #!SpwContext

 ~#existing: [
  "documentSelector",
  "annotationIndex",
  "resolveRoot",
  "ROOT_MAP",
  "SIGIL_SEMANTICS",
 ]

 ~#atlas_contributes: [
  "manifestState — parsed workspace.spw manifest or null",
  "workspaceTemperature — live cache tier snapshots from LSP index",
  "activeRoot — currently selected root in the atlas",
 ]

 ~#registers_contributes: [
  "registerSnapshot — latest runtime trial register state or null",
  "focusedRegister — currently inspected register identity",
 ]

 ~#authoring_contributes: [
  "activePhase — spirit-sequence phase at cursor position",
  "materializationState — priming|concept|frame|body for cursor context",
  "probeHistory — recent probe results for the active document",
 ]

 ~#evolution_rule: "each plan adds its fields without overwriting; shared interface grows additively across the three commit arcs"
}

^["event_vocabulary"]{
 #:contract #!events

 atlas_root_selected: {
  ~#emit_as: "atlas.rootSelected"
  payload: "{ sigil: string, resolvedPath: string, manifestFrame: string | null }"
  consumers: ["register-explorer (filter to root)", "authoring-loop (scope completions)"]
 }

 atlas_perspective_rotated: {
  ~#emit_as: "atlas.perspectiveRotated"
  payload: "{ perspective: 'topology' | 'contract' | 'resonance' | 'phase' | 'query' }"
  consumers: ["register-explorer (match perspective)", "status-bar (show active lens)"]
 }

 register_focused: {
  ~#emit_as: "register.focused"
  payload: "{ name: string, phase: number, provenance: string[], file: string }"
  consumers: ["atlas (highlight resonance neighbors)", "authoring-loop (show in code lens)"]
 }

 register_phase_changed: {
  ~#emit_as: "register.phaseChanged"
  payload: "{ name: string, previousPhase: number, currentPhase: number }"
  consumers: ["atlas (update phase view)", "authoring-loop (update status)"]
 }

 probe_completed: {
  ~#emit_as: "probe.completed"
  payload: "{ probeId: string, target: string, result: object, resonances: string[] }"
  consumers: ["atlas (update resonance counts)", "register-explorer (refresh snapshot)"]
 }

 authoring_phase_entered: {
  ~#emit_as: "authoring.phaseEntered"
  payload: "{ phase: number, sigil: string, cursorUri: string, line: number }"
  consumers: ["register-explorer (highlight phase group)", "status-bar (show phase)"]
 }

 materialization_advanced: {
  ~#emit_as: "materialization.advanced"
  payload: "{ uri: string, previousStage: string, currentStage: string }"
  consumers: ["atlas (update materialization badge)", "register-explorer (refresh)"]
 }
}

^["spirit_sequence_integration"]{
 #:semantics #!phase_axis

 ~#sequence: "? ~ @ & * ^"
 ~#phases: ["wonder/probe", "potential/name", "perspective/scope", "confluence/merge", "value/collapse", "integration/frame"]
 ~#binding_phases: ["! (action/injection)", "= (config/constraint)", "% (measure)", "# (annotation/resonance)"]

 atlas_axis: {
  ~#role: "phase is a rotation lens alongside topology, contract, resonance, query"
  ~#presentation: "group workspace nodes by the dominant phase of their content"
  ~#computation: "operator frequency analysis per file or root — dominant phase = highest-frequency spirit operator"
 }

 register_axis: {
  ~#role: "registers carry phase state; tree groups or filters by current phase"
  ~#presentation: "phase trajectory shown in detail view: what charged, what collapsed"
  ~#computation: "register.writes history mapped to spirit-sequence positions"
 }

 authoring_axis: {
  ~#role: "completions and code lenses are phase-aware"
  ~#presentation: "after ? suggest ~; after & suggest *; cursor-local phase shown in status"
  ~#computation: "look-back from cursor position to nearest unmatched spirit operator"
 }
}

^["materialization_integration"]{
 #:semantics #!materialization_cycle

 ~#stages: ["priming", "concept", "frame", "body"]
 ~#transition: "priming → concept → frame → body (reversible via probe/archive replay)"

 stage_heuristics: {
  priming: "operator sequence without a named binding — register disposition charging"
  concept: "named potential with ~ binding but no containing frame (^) — unbound reference"
  frame: "^-declared container with structure but no generated projection — structural spec"
  body: "materialized artifact in gen/* or resolved output — generated from a frame"
 }

 atlas_use: {
  ~#role: "each root or surface shows its materialization state"
  ~#badge: "priming=charging, concept=potential, frame=structured, body=materialized"
  ~#stale_detection: "body whose spec-owner frame has changed since generation"
 }

 register_use: {
  ~#role: "registers at different stages have different inspection affordances"
  ~#priming: "show charging operators and disposition"
  ~#concept: "show named potential and references"
  ~#frame: "show container structure and relations"
  ~#body: "show materialized value and projection lineage"
 }

 authoring_use: {
  ~#role: "code lens and status indicate materialization state for current context"
  ~#frame_without_body: "offer 'Generate body' lens"
  ~#body_with_stale_frame: "show 'Stale projection' warning"
  ~#breadcrumb: "status bar shows priming|concept|frame|body for cursor expression"
 }
}

^["resonance_definition"]{
 #:semantics #!resonance_computation

 ~#principle: "resonance is observable coupling between workspace nodes across tree boundaries"

 channels: {
  annotation_cooccurrence: {
   ~#source: "ConceptCluster.coOccurs in server-index"
   ~#signal: "concepts that appear in the same files or frames"
   ~#strength: "count of shared annotation names normalized by total annotations"
  }
  root_cross_reference: {
   ~#source: "SpwSelectorHit paths that resolve across root boundaries"
   ~#signal: "files under one root that reference paths under another root"
   ~#strength: "count of cross-root references"
  }
  projection_lineage: {
   ~#source: "ProjectionEntry in server-index"
   ~#signal: "spec owner → generated body links"
   ~#strength: "binary — linked or not, plus stale/fresh status"
  }
  register_coupling: {
   ~#source: "register snapshot from runtime trial"
   ~#signal: "registers that share bindings or provenance across files"
   ~#strength: "count of shared provenance entries"
  }
 }

 ~#lsp_endpoint: "spw/resonance — returns typed resonance edges for a given node"
 ~#atlas_command: "Show Resonance Neighbors queries all four channels"
 ~#collapse_rule: "present strongest channel first; let user expand weaker channels on demand"
}

^["perspective_visual_language"]{
 #:pragmatics #!rotation_design

 topology: {
  ~#icon_suffix: "$(list-tree)"
  ~#description_suffix: "structure"
  ~#content: "children are files and subdirectories, depth-first"
  ~#node_emphasis: "path depth and containment"
 }
 contract: {
  ~#icon_suffix: "$(law)"
  ~#description_suffix: "contract"
  ~#content: "declared invariants, surfaces, layer, relationship to other roots"
  ~#node_emphasis: "ownership and invariant text"
 }
 resonance: {
  ~#icon_suffix: "$(pulse)"
  ~#description_suffix: "resonance"
  ~#content: "which other roots reference this node, annotation overlap, projection dependencies"
  ~#node_emphasis: "coupling count and channel breakdown"
 }
 phase: {
  ~#icon_suffix: "$(symbol-event)"
  ~#description_suffix: "phase"
  ~#content: "dominant spirit-sequence phase, operator frequency, phase trajectory"
  ~#node_emphasis: "phase index and operator distribution"
 }
 query: {
  ~#icon_suffix: "$(search)"
  ~#description_suffix: "query"
  ~#content: "graph-query results: neighbors, lineage, subtree focus — scoped to selected node"
  ~#node_emphasis: "result count and query type"
 }
}

^["vocabulary_guidance"]{
 #:pragmatics #!naming

 ~#principle: "command names use Spw vocabulary, not generic VS Code vocabulary"

 prefer: {
  "Re-ground": "over Refresh — matches . ground operator"
  "Probe": "over Search/Find — matches ? operator"
  "Collapse": "over Resolve — matches * operator when scope narrows to concrete"
  "Rotate lens": "over Switch view — matches perspective/observer @ semantics"
  "Charge": "over Load/Initialize — matches priming semantics"
  "Unprimed": "over Not initialized — workspace without manifest"
  "Ungrounded": "over Stale/Invalid — projection disconnected from spec owner"
 }

 status_messages: {
  probe_result: "? → 3 resonances found"
  manifest_missing: "workspace unprimed — no manifest at .spw/workspace.spw"
  stale_projection: "body ungrounded — spec owner changed since generation"
  phase_indicator: "cursor phase: ~ potential"
 }
}

^["manifest_authority"]{
 #:contract #!authority_table

 ~#rule: "structural claims come from the manifest; behavioral observations come from the index"
 ~#taste_debt: "do not let inferred index data silently override manifest truth"

 roots: {
  authority: "manifest-strict"
  fallback: "degrade to ROOT_MAP hardcoded roots, labeled 'inferred'"
 }
 memory: {
  authority: "manifest for placement, index for temperature"
  fallback: "show only index-derived temperature; omit placement labels"
 }
 generated: {
  authority: "manifest for spec owners, index for stale detection"
  fallback: "hide section entirely — no manifest means no projection contract"
 }
 harness: {
  authority: "manifest-strict"
  fallback: "hide section — harness paths are explicitly declared"
 }
 contracts: {
  authority: "manifest-strict"
  fallback: "hide section — contracts are named references, not discoverable"
 }
 queries: {
  authority: "index-derived, manifest-scoped"
  fallback: "available but scoped to discovered files only"
 }
}

^["transport"]{
 #:pragmatics #!event_transport

 ~#principle: "extension-internal events are synchronous and free; LSP requests cross a process boundary and carry serialization cost"

 extension_internal: {
  ~#transport: "vscode.EventEmitter<T> on SpwContext"
  ~#cost: "synchronous, no serialization"
  events: [
   "atlas.rootSelected — UI selection state, no server data needed",
   "atlas.perspectiveRotated — UI lens state",
   "register.focused — UI selection state",
   "register.phaseChanged — derived from LSP snapshot diff, fired client-side",
   "authoring.phaseEntered — computed from cached AST client-side",
   "materialization.advanced — computed from cached AST client-side",
   "probe.completed — fired after LSP request returns, consumed client-side",
  ]
 }

 lsp_requests: {
  ~#transport: "custom LSP request via LanguageClient.sendRequest()"
  ~#cost: "crosses process boundary, async, serialized JSON"
  requests: [
   "spw/resonance — server computes resonance edges from index + projection graph",
   "spw/workspaceTemperature — server returns cache tier snapshots from ServerIndex",
   "spw/registerSnapshot — server executes runtime trial and returns register state",
   "spw/operatorFrequency — server computes operator distribution for a file or root",
   "spw/phaseContext — server returns spirit-sequence context at cursor offset",
  ]
 }

 ~#bus_pattern: "SpwContext carries a typed EventBus with per-event emitters; each surface registers listeners during activation and disposes them on deactivation"
}

^["capability_pattern"]{
 #:pragmatics #!type_design

 ~#principle: "SpwContext fields are T | null; each surface checks before using; type narrowing happens at consumption site"

 pattern: {
  ~#context_fields: "all contributed fields use union-with-null — manifestState: ManifestState | null, registerSnapshot: RegisterSnapshot | null, etc."
  ~#check_site: "consuming code does `if (spw.manifestState) { ... }` before accessing manifest-dependent affordances"
  ~#rationale: "optional fields is the simplest pattern that preserves additive growth; branded capability interfaces can be added later if type narrowing becomes noisy"
  ~#degradation: "when a field is null, the surface degrades to local scope (file-only, index-only, or cached-AST-only) rather than hiding the affordance"
 }

 example: {
  ~#atlas_consuming_registers: "if (spw.registerSnapshot) { showRegisterCouplingResonance() } else { labelChannelUnavailable('register coupling') }"
  ~#authoring_consuming_atlas: "if (spw.activeRoot) { scopeCompletionsToRoot(spw.activeRoot) } else { useWorkspaceWideCompletions() }"
 }
}

^["handler_registration"]{
 #:pragmatics #!lsp_architecture

 ~#problem: "stdio-server.ts is already 900+ lines; three plans each add new LSP handlers (workspace.ts, runtime.ts, editing.ts mods) — piling dispatch into one file creates a merge bottleneck and readability problem"

 ~#pattern: "extract a handler registration infrastructure as a substrate commit"
 ~#shape: "each handler cluster exports a register(server, index, context) function; stdio-server.ts calls registerWorkspaceHandlers(), registerRuntimeHandlers(), etc. instead of inlining dispatch"
 ~#existing_precedent: "handler clusters already exist in packages/spw-lsp/src/handlers/ (analysis.ts, display.ts, editing.ts, navigation.ts, semantic-tokens.ts) but are wired manually in stdio-server.ts"

 substrate_commit: {
  ~#description: "extract handler registration pattern from stdio-server.ts so new handlers plug in without growing the main dispatch file"
  ~#files: ["packages/spw-lsp/src/stdio-server.ts (MOD — extract dispatch)", "packages/spw-lsp/src/handlers/index.ts (NEW — registration entrypoint)"]
  ~#timing: "should land before or alongside the first VS Code surface plan that adds a new handler"
 }
}

^["phase_vocabularies"]{
 #:semantics #!vocabulary_reconciliation

 ~#problem: "two things are called 'phase' across the plans — spirit-sequence phase and register pipeline phase — they are orthogonal axes, not synonyms"

 spirit_sequence_phase: {
  ~#axis: "operator semantics — what the sigil means in the language model"
  ~#vocabulary: ["? wonder/probe", "~ potential/name", "@ perspective/scope", "& confluence/merge", "* value/collapse", "^ integration/frame"]
  ~#binding_operators: ["! action", "= config", "% measure", "# annotation"]
  ~#source: "SIGIL_SEMANTICS, workspace manifest ^spirit_sequence"
  ~#used_by: ["atlas phase perspective", "authoring phase-aware completion", "authoring phase indicator"]
 }

 register_pipeline_phase: {
  ~#axis: "pipeline position — when the register was enriched during runtime execution"
  ~#vocabulary: ["lex", "parse", "semantic", "optimize", "pragmatic"]
  ~#source: "register-phase-evolution plan, src/runtime/state/types.ts"
  ~#used_by: ["register explorer phase grouping", "register detail phase trajectory"]
 }

 ~#relationship: "orthogonal — a register at pipeline phase 'semantic' may have been charged by spirit operator '~' (potential). The spirit-sequence describes what the author wrote; the pipeline phase describes when the runtime processed it."
 ~#naming_rule: "when context is ambiguous, prefix: 'spirit phase' vs 'pipeline phase'. In the atlas and authoring surfaces, unqualified 'phase' means spirit-sequence. In the register explorer, unqualified 'phase' means pipeline phase. The detail view shows both when both are available."
 ~#cross_reference: "register-phase-evolution plan aligns pipeline phase vocabulary; spirit-sequence phase is defined in this contract's ^spirit_sequence_integration frame"
}

^["cross_theme_enrichments"]{
 #:pragmatics #!runtime_parser_dependencies

 ~#principle: "the VS Code surfaces solo-ship from local parse/index context; runtime and parser plans provide data that unlocks richer affordances when available"

 runtime_telemetry_canon: {
  ~#plan: ".agents/plans/runtime-telemetry-canon"
  ~#provides: "immutable substrate events, detected resonances, and register metadata from runSpw() and collectPrecipitates()"
  ~#enriches: [
   "register-explorer: richer register snapshots with provenance, events, resonances instead of shallow value dumps",
   "atlas resonance channel 4 (register coupling): needs resonances from pipeline results to detect cross-file register coupling",
   "authoring probe.completed: richer probe results when runtime returns full telemetry",
  ]
  ~#status: "ready-for-commit"
  ~#solo_ship_fallback: "register explorer shows value + phase from basic runtime trial; resonance channel 4 labeled unavailable; probe results are shallow"
 }

 register_phase_evolution: {
  ~#plan: ".agents/plans/register-phase-evolution"
  ~#provides: "canonical phase vocabulary (lex, parse, semantic, optimize, pragmatic) aligned across runtime, query, and docs; Spw-native selector grammar"
  ~#enriches: [
   "register-explorer: phase grouping uses canonical names instead of ad-hoc labels",
   "authoring phase-aware completion: can map between spirit-sequence operators and register pipeline phases for richer hover and suggestions",
   "atlas phase perspective: can show pipeline phase alongside spirit-sequence phase when both are available",
  ]
  ~#status: "planning"
  ~#solo_ship_fallback: "register explorer groups by spirit-sequence phase from SIGIL_SEMANTICS; pipeline phase shown only when runtime trial returns it"
 }

 absorb_spwq_cli: {
  ~#plan: ".agents/plans/absorb-spwq-cli"
  ~#provides: "normalized selector traversal, corpus-level coverage, package-owned CLI surface"
  ~#enriches: [
   "atlas graph queries: reliable selector resolution for cross-root and subtree-focus queries",
   "authoring selector trace: Trace Selector command uses the same repaired traversal",
  ]
  ~#status: "verifying"
  ~#solo_ship_fallback: "graph queries use current selector implementation; results may be incomplete for complex selectors"
 }

 monorepo_workspace_foundation: {
  ~#plan: ".agents/plans/monorepo-workspace-foundation"
  ~#provides: "package-boundary restructuring for @spwashi/spw-seed, @spwashi/spw-runtime, @spwashi/spw-cli, @spwashi/spw-lsp"
  ~#enriches: [
   "all VS Code plans: import paths for packages/spw-lsp/* and packages/spw-seed/* may shift when monorepo lands",
  ]
  ~#status: "ready_to_commit"
  ~#coordination: "if monorepo lands before VS Code surfaces, extension resolveServerPath() and LSP import references need updating; if after, compatibility wrappers in src/ handle the transition"
 }

 seed_phase_context: {
  ~#plan: "not yet scoped — targeted addition to @spwashi/spw-seed"
  ~#provides: "cursor-offset-to-phase-context query: given an offset in a parsed document, return the nearest enclosing spirit operator, its phase index, and the materialization stage of the enclosing expression"
  ~#enriches: [
   "authoring look-back rule: phase-aware completion needs to know the spirit-sequence context at cursor position",
   "authoring materialization breadcrumb: needs to know priming|concept|frame|body for cursor context",
   "authoring phase-aware hover: needs spirit-sequence position for the hovered operator",
  ]
  ~#status: "unscoped — should be added to absorb-spwq-cli or register-phase-evolution as a targeted scope extension, or scoped as a standalone micro-plan"
  ~#solo_ship_fallback: "LSP completion handler uses regex look-back from cursor position; less precise but functional for common patterns"
 }
}

^["composition"]{
 #:pragmatics #!parallel_synergy

 ~#recommended: [
  "0. handler-registration substrate commit extracts dispatch from stdio-server.ts so new handlers plug in cleanly",
  "1. shared interaction contract and any shared helper/types extraction land as a substrate commit when possible",
  "2. each surface maintains a solo-ship path that does not require the other two surfaces to render usefully",
  "3. pairwise integration commits land opportunistically (atlas x registers, atlas x authoring, registers x authoring)",
  "4. runtime/parser enrichments (runtime-telemetry-canon, register-phase-evolution, absorb-spwq-cli) land independently and are consumed opportunistically via capability checks",
  "5. all-up rotation polish is a final integration slice, not a prerequisite for any one surface",
 ]

 ~#shared_hot_files: [
  "extensions/vscode-spw/src/extension.ts",
  "extensions/vscode-spw/src/context.ts",
  "extensions/vscode-spw/package.json",
  "packages/spw-lsp/src/stdio-server.ts",
 ]

 ~#context_growth: "each plan adds to SpwContext additively; no plan removes fields another introduced"
 ~#integration_rule: "capability checks gate cross-surface affordances; missing peers degrade to local scope rather than disabling the surface"
 ~#cross_theme_rule: "runtime and parser plans are enrichment providers, not blockers; VS Code surfaces degrade gracefully when runtime telemetry or parser phase-context is unavailable"
}

^["parallel_work"]{
 ~#critical_path: [#shared_context, #event_vocabulary, #transport]
 ~#parallelizable: [#phase_vocabularies, #cross_theme_enrichments, #capability_pattern, #perspective_visual_language]
 ~#shared_hot_files: ["extensions/vscode-spw/src/context.ts", "extensions/vscode-spw/src/extension.ts", "packages/spw-lsp/src/stdio-server.ts"]
 ~#merge_risks: [#event_drift, #phase_name_collision, #hot_file_pressure, #capability_fork]
 ~#handoff_artifacts: [#event_table, #context_fields, #transport_rules, #capability_checks]
}

^["supporting_documents"]{
 ~#must_ship: [#event_table, #context_growth_note, #phase_glossary]
 ~#helpful: [#handler_registration_note, #degradation_examples, #transport_matrix]
 ~#carries: [#selection_identity_examples, #rotation_contract, #fallback_rules]
}

^["interaction_depth"]{
 ~#subjects: [#continuity, #selection_preservation, #rotation_legibility, #fallback_behavior, #phase_naming, #latency]
 ~#questions: [#what_context_must_survive, #what_degrades_locally, #what_crosses_process_boundary]
 ~#qualities: [#continuity, #predictability, #composability]
}
