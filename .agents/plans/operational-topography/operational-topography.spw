# Operational Topography
# Distilled planning contract for orientation, layout, scans, hydration, and evidence.

#>operational_topography
#:layer #!semantics

^seed[Spw.Operational.Topography v:0.1 @profile:planning @intent:portable_contract]
{_topography

 strata: #[
  .{id=source, owns=#[glyph, token, trivia, span, line, column]},
  .{id=structure, owns=#[ast_path, container_pair, frame_path, named_depth]},
  .{id=relation, owns=#[root, reference, incoming, outgoing, graph_distance]},
  .{id=time, owns=#[revision, episode, observation, model_capability]},
  .{id=layout, owns=#[gap, indentation, alignment, cadence, surface_identity]},
  .{id=operation, owns=#[onf, port, fixity, effect, cost, trace]},
 ][reg=set]

 orientation: .{
  canonical = #[open, close, prefix, postfix, before, after, ingress, egress]
  render_only = #[left, right, accumulate, release, inward, outward]
  dialect_gate = `Any orientation that changes parse, ONF, evaluation, or effects requires a versioned dialect.`
 }[reg=facet]

 spacing: .{
  role = `syntax-sensitive source evidence; only verified differentials become soft topographic signals`
  measures = #[token_gap, newline_gap, blank_cadence, indent_delta, alignment_run]
  invariant = `layout-only status requires complete reparse and preservation of the declared structural or semantic projection`
  identity = #[semantic_or_plan, surface_or_layout]
 }[reg=facet]

 differential: .{
  identity = #[document_version, source_hash, dialect, profile_hash, exact_selection]
  kinds = #[layout, label, context, structural]
  ports = #[before_open, open_boundary, inside, close_boundary, after_close, surrounding_context]
  mutation_profile = #[layout, tokens, structure, labels, references, semantics, effects, reversibility]
  checks = #[complete_structured_parse, well_nested, projection_preserved, idempotent]
  rule = `Approximate matches suggest; exact parser-owned spans are the only edit targets.`
 }[reg=facet]

 indentation_pulse: ?<
  exact_select,
  measure,
  plan,
  preview,
  verify_preconditions,
  confirm_and_apply_one_S2_batch,
  reparse,
  compare,
  observe,
  stop_or_repeat
 >[reg=pipeline]

 transforms: .{
  view_rotations = #[outline, transpose, fold, graph, mirror]
  source_rewrites = #[indent, align, line_break, extract, reorder, wrap]
  profiles = #[reading, review, teaching, compact]
  contract = #[coordinate_map, inverse_or_loss, preserved_invariants, source_map, cost]
  diff_value = #[semantic_signal_per_hunk, stable_anchors, layout_noise, moved_region_trace, reviewer_time, reviewer_errors]
 }[reg=facet]

 coupling_family: .{
  status = proposed
  paired_members = #[scope_parens, frame_brackets, body_braces, capsule_angles, stream_angles, range_parens]
  explicit_operator = `<> is measured separately and may become a lowering target; it is not a delimiter pair in the current lexer or AST.`
  common = #[kind, pair_id, payload, boundary_ports, labels, source_map]
  math = `tagged recursive algebra first; colored operad as the compositional hypothesis`
  physics = `boundary conditions between interior and exterior, measured rather than assigned from glyph shape`
  rule = `semantic coupling family does not require one lexer token class`
 }[reg=facet]

 topography_instrument: .{
  status = implemented_read_only
  command = `npm run audit:topography -- --json <targets>`
  measures = #[seed_ast_depth, parsed_paired_container_depth, recognized_paired_container_counts, explicit_couple_operations, token_counts]
  evidence = #[parser_success, error_count, recovery_class, prose_fallback, lexical_closure, lex_profile, context_mode, reasons]
  rule = `Recovered-Prose node counts are partial recognized lower bounds; the instrument grants no selection or mutation authority.`
 }[reg=facet]

 scan: .{
  order = ?<hard_constraints, exact_tier, approximate_tier, diversity_rerank, explanation>
  match_features = #[operator, container, named_depth, token_trigram, sequence, subtree, relation, layout]
  separate_gradients = #[distance, discovery_priority, mutability, reversibility, authority, cost, uncertainty]
  rule = `No scalar may compensate for failed authority or effect constraints.`
 }[reg=facet]

 evidence_packet: .{
  identity = #[consumer_revision, workbench_revision, profile_hash, query_hash, source_span]
  payload = #[exact_hits, near_hits, counterexamples, contribution_trace, exclusions, cost, uncertainty]
  budgets = #[bytes, files, nodes, results, duration]
  privacy = #[consumer_authority, mounted_exclusion, no_machine_local_paths, no_unselected_upstream_copy]
 }[reg=facet]

 hydration: ?<
  abstract_sequence,
  typed_plan,
  validated_plan,
  capability_bound_plan,
  effect_preview,
  emitted_artifact_or_run,
  append_only_observation
 >[reg=pipeline]

 contracts: .{
  operator = #[ports, cardinality, determinism, fixity, effects]
  range = #[domain, bounds, inclusivity, step, unit, overflow]
  container = #[scope, isolation, lifetime, transaction]
  payload = #[schema, units, serialization, provenance]
  stream = #[ordering, laziness, backpressure, cancellation, error]
  artifact = #[plan_hash, target, source_map, generator_version]
 }[reg=facet]

 effect_grades: #[
  .{id=S0, meaning=`read and measure only`},
  .{id=S1, meaning=`in-memory or sandbox transformation`},
  .{id=S2, meaning=`workspace edit with preview, snapshot preconditions, and explicit apply authority`},
  .{id=S3, meaning=`external process, equipment, or material effect with explicit confirmation`},
 ][reg=set]

 epistemic_grades: #[
  .{id=E0, meaning=`deterministic observation from a named code path and declared parse state`},
  .{id=E1, meaning=`recomputable score with declared formula and profile`},
  .{id=E2, meaning=`explicit human interpretation or preference`},
 ][reg=set]

 familiarity: .{
  behavioral = #[time_to_orient, navigation_actions, selection_errors, edit_accuracy, recall]
  reported = #[familiarity, confidence, readability, preference]
  rule = `longitudinal person-task observation, never inferred directly from layout density`
  protocol = `.agents/plans/operational-topography/WHITESPACE-PHYSICS.md`
 }[reg=facet]

 idiom_learning: .{
  loop = ?<babble, candidate, exact_fixture, impact_packet, steward_review, promote_or_localize, migration_preview, observe>
  sandbox = #[S0, S1, bounded_corpus, reversible, lineage]
  impact = #[parse, structure, references, queries, projections, scripts, effects, tests, tools, cost]
  nuance = #[examples, near_misses, counterexamples, local_exceptions, promotion_reason]
  rule = `fun is explicitly reported; promotion requires exact targets, evidence, and declared S2 authority`
 }[reg=facet]

 trajectory: ?<
  repair_mount_authority,
  align_theory_with_runtime,
  ship_read_only_transect,
  test_exact_first_samples,
  preview_hydration,
  project_in_editors,
  learn_from_longitudinal_observations
 >[reg=pipeline]

 falsify: #[
  `A render-only profile changes semantic coordinates or effects.`,
  `Formatting-only edits change the semantic or plan identity.`,
  `A repeated layout profile is non-idempotent.`,
  `A rotation hides a semantic or effect delta.`,
  `An approximate hit outranks an exact hit without an explicit query rule.`,
  `An evidence packet cannot be reproduced from its revisions, profile, query, and spans.`,
  `Hydration performs an effect beyond its declared and confirmed grade.`,
 ][reg=set]

}_topography
