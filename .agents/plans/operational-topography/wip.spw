#>wonder_operational_topography_1
?["Which form-mobility rules are rotations, and which are one-way projections?"]{
 #:depth #!computational
 ~#hypothesis: "the 13 rules with no declared inverse are the lossy projections, and a receipt for them cannot report restoration exact"
 !probe{ "load MOBILITY_RULES from packages/spw-seed/src/canonical/form-geometry.ts and count rules with inverse set, dangling inverse ids and asymmetric pairs; on 2026-10-12 this gave 23 rules, 10 with an inverse, 0 dangling, 0 asymmetric, all 23 with apply" }
 $%[mobility.rule_count, mobility.inverse_count]
}
