#>plan_editor_inspection_instruments
#:plan #!projection_feedback
#:layer #!pragmatics

@["card"]{
 phase: #active
 gist: "VS Code, IntelliJ and Neovim each run the same inspection instruments from the CLI: source products, fingerprint, memory, performance and projection"
 touches: [~"extensions/vscode-spw/src/instruments", ~"extensions/intellij-spw/src/main/kotlin/com/spwashi/spw", ~"extensions/neovim-spw/lua/spw"]
 entry: ~"./PLAN.md"
 next: "~[parity_fixture]: one saved file and one selection through all five instruments in each editor, outputs diffed after stripping timings."
}

^["edges"]{
 supersedes: [~"../_archive/editor-cli-instruments/wip.spw"]
 shares: [~"../neovim-spw-surfaces/wip.spw", ~"../vscode-authoring-probe-loop/wip.spw", ~"../intellij-lsp4ij/wip.spw", ~"../vscode-lsp-roadmap/wip.spw"]
}

^["roots"]{
 @plan: ~".agents/plans/editor-inspection-instruments/PLAN.md"
 @canon: ~".spw/tooling/editor-instruments.spw"
 @inspect: ~"packages/spw-cli/src/inspect-source.ts"
 @fingerprint: ~"packages/spw-cli/src/fingerprint.ts"
 @mem: ~"packages/spw-cli/src/mem.ts"
 @parity: ~".spw/caches/tree/spw/hosts/host-parity-matrix.spw"
}

^["intent"]{
 ~#goal: "Intermediate representations, expression geometry, memory and cost are one command away in every editor, and every editor shows the same receipt"
 ~#taste: "the CLI owns the answer; each editor only chooses where to show it"
}

^["instruments"]{
 inspect_source = "spw inspect source <file> --through tokens|structure|trace, or --text for a selection: the progressive source products"
 fingerprint = "spw fingerprint --expr on a selection or line: node counts, the expression's geometry"
 memory = "spw inspect memory and spw mem status: what the runtime keeps"
 performance = "spw query --selector pathRefs --count --stats over the file's folder: walk and parse cost"
 projection = "a read-only, file-backed spw emit projection into an intermediate form"
}

^["open"]{
 # Unresolved questions. When resolved: log in stream, then move to ^["done"] as ~#resolved(label).
 ?[unsaved_buffers]: "File-backed instruments read the saved file; should every instrument take stdin so an unsaved buffer and a selection read the same as a file?"
 ?[receipt_parity]: "How is parity checked: one fixture whose instrument outputs the three editors must print identically, or a per-editor snapshot? Decides the shape of ~[parity_fixture]."
 ?[probe_transport]: "Does the buffer probe belong on the language server, or is the CLI --text enough if every client sends the buffer? Asked by a mounted consumer on 2026-10-25. Decides where ~[one_buffer_probe] lands."
}

^["commits"]{
 # Named, in order. Planned ~[name]; landed .[name](hash). Names are never reused.
 .[vscode_instruments](99e6d993): "&[vscode] — Inspect Source, Fingerprint Selection, Inspect Memory, Check Performance and Show Projection commands"
 .[intellij_instruments](155cfd57): "&[intellij] — the same five instruments as actions beside Form, Stack, Cache, Rename and Refactor Plan"
 .[neovim_instruments](1bb4f68d): "&[neovim] — :SpwInspect, :SpwFingerprint, :SpwMemory, :SpwPerf and :SpwProject in scratch splits"
 .[mounted_input_paths](ed606b3a): "&[cli] — a mounted run reads relative input paths from the consumer root, so file instruments work in consumer projects"
 ~[parity_fixture]: "![editors] — one fixture whose instrument outputs every editor prints the same"
 ~[readonly_reports]: "&[vscode] — instrument reports open through a read-only content provider, so closing them asks nothing (scorecard bug 7; host.ts 57, commands.ts, instruments/commands.ts 215)"
 ~[buffer_truth_rows]: ".[tooling] — record per editor and instrument whether it reads the saved file, the buffer, or a selection (hosts/jetbrains-instruments.spw guard); answers ?[unsaved_buffers]"
 ~[one_buffer_probe]: "&[lsp] — one probe takes the buffer text and answers form, stack, tokens, structure, and trace; Neovim and IntelliJ ship the bundled server (consumer rank 3)"
}

^["cache"]{
 ~#status: "active"
 ~#base_ref: "main@77599452"
