# service spec — spw-site-install

#:layer #!pragmatics

^["roots"]{
 @cluster: ~".agents/plans/plan-ecology-clustering/plan-ecology-clustering.spw"
 @governance: ~".agents/plans/ecosystem-surface-governance/ecosystem-surface-governance.spw"
 @workspace: ~".spw/workspace.spw"
 @mount: ~".spw/mount.spw"
 @submodule: ~".spw/conventions/submodule.spw"
 @cli: ~".spw/conventions/cli.spw"
}

^["cluster_role"]{
 lane: #execution_truth
 ladder: #service
 braid: [#install, #mount, #site_identity, #exchange]
 rule: "site installation should make the workbench mount explicit enough that CLI, editor, DX, and release surfaces can quote one boundary contract without improvising"
}

^["boundary_contract"]{
 consumer_root: ".spw/"
 consumer_owns: [".spw/index.spw", ".spw/workspace.spw", ".spw/mount.spw", ".spw/conventions/*", ".spw/audits/*"]
 workbench_root: ".spw/_workbench"
 workbench_owns: ["parser", "runtime", "LSP", "CLI", "spec library", "agent tooling"]
 install_shape: "git submodule add <workbench-url> .spw/_workbench"
 prefix_rule: "underscore means infrastructure, not site-authored canon content"
}

^["mount_protocol"]{
 surface: ".spw/mount.spw"
 must_record: ["tracked workbench version", "engaged surfaces", "resolution paths"]
 examples: [
  "~\"_workbench/lib/spw-v0.3.0/\"",
  "~\"_workbench/packages/spw-cli/\"",
  "~\"_workbench/packages/spw-lsp/\"",
 ]
 rule: "mount.spw describes how site canon engages the engine; it does not flatten engine internals into site identity"
}

^["engagement_model"]{
 selective: "sites engage only the spec subsystems, conventions, patterns, and tooling entrypoints they actually use"
 local_authority: "consumer-owned .spw files remain the canon root for content, naming, and deployment decisions"
 downstream_effect: "CLI init, editor detection, doctor output, and release docs should all reuse the same mount vocabulary"
}

^["exchange_model"]{
 contributes: ["dialects", "conventions", "canon extensions", "distilled evidence from real site usage"]
 rule: "exchange flows across the mount boundary by contribution, not by turning consumer repositories into copies of the workbench"
 gate: "a human selects what crosses upstream; review output and site canon do not flow automatically"
}

^["repo_local_review"]{
 caller_root: "consumer repository root"
 authority_order: ["consumer-owned .spw/index.spw and workspace.spw", "consumer-local conventions, claims, audits, and caches", "mounted _workbench protocols and instruments"]
 workbench_role: ["parser", "query engine", "review skills", "observation/probe conventions", "portable diagnostics"]
 output_owner: "the consumer repository"
 output_examples: [".spw/audits/*", ".spw/caches/*", "consumer-chosen evidence surfaces"]
 provenance: ["site revision", "mounted workbench revision", "review profile", "commands or probes run"]
 invariant: "mounted guidance may question site canon but cannot silently become site authority"
}

^["parallel_work"]{
 critical_path: [#submodule_boundary, #mount_protocol]
 parallelizable: [#cli_init, #cli_resolution, #editor_detection, #doctor, #docs]
 shared_hot_files: [@workspace, @submodule, @cli]
 merge_risks: [#boundary_drift, #resolution_drift, #release_copy_drift]
 handoff_artifacts: [@governance]
}

^["review_contract"]{
 sources: [@cluster, @governance, @workspace, @mount, @submodule, @cli]
 asks: [#site_ownership, #install_truth, #mount_legibility, #cross_surface_reuse, #review_provenance, #exchange_consent]
}

^["invariant"]{
 "The consumer owns .spw/; the workbench owns .spw/_workbench.",
 "Mount truth should be explicit enough that CLI, editor, DX, and release surfaces can repeat it without drift.",
 "Convenience layers may evolve later, but they must not replace the submodule-era boundary contract before it is stable.",
 "A repo-local review belongs to the site; only a deliberate contribution crosses back into the workbench.",
}

#>wonder_agents_plans_spwsiteinstall_artifact_1
?["Which fact makes the install model feel reversible rather than possessive?"]{
  #:depth #!educational // lens: ecological zone
  $^["boundary_contract"]@here => $^["exchange_model"]@here
  !probe{ "name the mounted path, the consumer-owned surfaces, and the contribution route back. if any of those blur, the ecology is no longer reversible." }
  ~<.agents/plans/spw-site-install/wip.spw>
}
