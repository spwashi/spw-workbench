}

^["intent"]{
 ~#goal: "Define and implement the submodule-based installation model: site codebases own .spw/ as their canon surface, with the workbench living at .spw/_workbench as infrastructure. Each repo is independently considered through a system of engagement and exchange."
 ~#taste: "clarity, layering — the site owns its surfaces, the workbench provides the engine, the boundary is the _ prefix"
}

^["development"]{
 lane: #execution_truth
 ladder: #service
 develops: [#mount_protocol, #site_independence, #install_truth, #exchange_model]
 review_surfaces: [@cluster, @plan, @workspace, @release]
