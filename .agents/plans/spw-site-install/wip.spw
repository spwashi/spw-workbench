}

^["concept_index"]{
 primary: [#submodule, #mount, #install, #site, #engagement, #exchange]
 surfaces: [#cli, #runtime, #editor, #docs, #sites]
 tensions: [#independence, #convenience, #resolution, #public_shape]
 transfers: [#service, #release]
}

^["recursive_improvement"]{
 loop: [
  "? reread site/install boundaries before adding more convenience layers",
  "< ship one mount, init, or doctor behavior that makes site ownership clearer",
  "$ record what became truer for a site repo entering the ecology",
  "^ feed the stable boundary language into CLI, docs, editor, and release surfaces",
  "% keep convenience claims narrower than the submodule protocol they depend on",
 ]
 gates: [#site_ownership, #mount_truth, #install_clarity]
}

^["parallel_work"]{
