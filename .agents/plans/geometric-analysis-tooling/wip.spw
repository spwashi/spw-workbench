^["intent"]{
 ~#goal: "Move the operator census and nesting off character scanning onto the AST, then build order (n-grams, depth profile) and shape (label-erased subtree fingerprints, anti-unification) on top, each z-scored against a corpus baseline."
 ~#taste: "correctness, expressiveness, layering"
 ~#defect: "inspectGeometry mixes two epistemologies — extractBraceProjection parses, censusOperators scans chars — and they contradict each other in the same report."
}

