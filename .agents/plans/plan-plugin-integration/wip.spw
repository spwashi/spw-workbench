^["intent"]{
 ~#goal: "Make the plan files themselves a first-class editor surface: cache facts, stream stamps, the done history and open questions arrive in every plugin as standard LSP products, computed once, not once per client and once more in bash."
 ~#taste: "one fact model; coordination over duplication; honest ownership"
}

