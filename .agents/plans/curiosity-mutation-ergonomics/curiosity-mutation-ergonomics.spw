# Curiosity · Mutation · Combinators
#
# Sustained curiosity via sigil×container combinatorics, profile families,
# high/low ergonomics. Glyph-first where possible; ids for constraints.
#:layer #!semantics
#:status #!proposed
@dialect:Spw.f

^seed[Spw.Plan.Curiosity.Mutation v:0.2 @profile:Spw.f @intent:combinator_walk]

^["roots"]{
 @plan: ~".agents/plans/curiosity-mutation-ergonomics/PLAN.md"
 @wip: ~".agents/plans/curiosity-mutation-ergonomics/wip.spw"
 @ecology: ~".agents/plans/shape-syntax-ecology/shape-syntax-ecology.spw"
 @mutation: ~"packages/spw-seed/src/canonical/mutation-automata.ts"
 @flow: ~"docs/theory/spw/mutation-flow-automata.spw"
 @devices: ~"docs/theory/spw/operational-devices.spw"
 @ladders: ~"packages/spw-seed/src/canonical/form-ladders.ts"
 @measure: ~".agents/plans/measure-invariant-generalization/measure-invariant-generalization.spw"
 @form_editor: ~".agents/plans/form-geometry-editor/form-geometry-editor.spw"
 @pulse_doc: ~"docs/runtime/md/pulse-mutate-beat.md"
 @syntax: ~".agents/plans/syntax-profile-stack/syntax-profile-stack.spw"
}

^["thesis"]{
 ~#claim: "Sustained curiosity is a combinatorial walk with memory: the workbench holds open dimensions a single mind cannot keep active, and offers reversible l0 plans to enter them."
 ~#taste: "fun under discipline — invitations not coercion; stabilize without killing vacuum"
 ~#non_goal: "game skin; auto-mutation; new OperatorKinds per circuit word"
}

^["anatomy"]{
 . {
  cell: .{ axes: #[sigil, boundary, occupancy, label, species, metrics] , visit: #[untouched, invited, visited, stabilized, refused] }
  N: .{ ports: #[before_open, open, inside, close, after_close] , graph: 1 , cast: #[] }
  phi: .{ families: #[hygiene, explore, stabilize, measure] , ceiling_explore: l0 }
  sigma: << ~ ; ? ; % ; ! ; * ; ^ >>
  =exp[ id: flow.phi , status: proposed , runtimeHook: lower ]
  =exp[ id: curiosity.visit_set , status: proposed , runtimeHook: none ]
 }
}

^["practice_circuit"]{
 ? : .{ role: vacuum }
 $ : .{ role: substrate }
 ~ : .{ role: potentiation }
 # : .{ role: clustering }
 & : .{ role: confluence }
 ! : .{ role: performance }
 % : .{ role: evaluation }
 // meta: claim / stream / mass on surface
}

^["profile_families"]{
 hygiene: .{ status: #implemented , examples: #[layout_canonical, layout_full, equiv_scripts] }
 explore: .{ status: #proposed , ceiling: effect.l0.measure , no_star: #yes }
 stabilize: .{ status: #proposed , path: << % ; ! ; * ; ^ ; =claim >> }
 measure: .{ status: #partial , examples: #[measure_only] , ceiling: effect.l0.measure }
}

^["high_low"]{
 high: .{ lang: #[species, dimension, walk, voice, thrift] , surface: #[explore_cli, atlas, plan_context] }
 low: .{ lang: #[ONF_site, span, rule_id, SourceEdit, mobility_receipt] , surface: #[pulse, form_geometry, code_action] }
 law: "high selection lowers to one differential kernel"
}

^["synergy"]{
 @ecology: ~".agents/plans/shape-syntax-ecology/shape-syntax-ecology.spw"
 measure: @measure
 form: @form_editor
 lsp: .{ invitations: proposed , dialect: Spw.f }
 nvim: .{ SpwExplore: proposed }
}

^["imagination"]{
 ide: "pulse measure_only on wonder file; list sparse cells mentally"
 shot: "?[…] !probe $% — dual-track halves"
 learn: "Spw.b then Spw.f; one φ without *"
 falsify: "explore writes disk; fun without AST filter"
}

^["falsify"]{
 #[
  "explore silent l2"
  "invalid combinator invitation"
  "grow pulse.ts / form-geometry.ts in place"
  "φ lower without catalog id"
 ]
}

#>wonder_curiosity_rich_1
?["Which combinator cell is this ecology never visiting?"]{
  #:species #!blind_spot
  !probe{ =id[p_sparse] }
  $%[file.frame_count, line.operator_density]
  ~<.agents/plans/curiosity-mutation-ergonomics/PLAN.md>
}
