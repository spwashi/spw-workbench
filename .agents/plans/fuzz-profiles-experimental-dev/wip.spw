#:layer #!pragmatics

^["intent"]{
  ~#goal: "Upgrade fuzz profiles from one-off lint toggles to composable experimental lenses with clearer intent and stricter shipping paths."
  ~#taste: "clarity + expressiveness"
}

^["stream"]{
  # Append entries chronologically. Never edit prior entries.
  # >>[YYYY-MM-DD HH:MM] <type> — <content>
  >>[2026-02-24 14:35] observe — Existing fuzz model is single-profile-only and docs frame it as static checks, not iterative experiment loops.
  >>[2026-02-24 14:38] decide — Introduce profile composition, stage aliases, and severity override while preserving current scripts for backward compatibility.
  >>[2026-02-24 14:40] hygiene — Pre-existing local drift in Writerside and package.json; isolate edits to fuzz-profile sections and related docs only.
  >>[2026-02-24 14:52] decide — Keep both exploration and release intent terms (`explore`, `ship`) and add intermediate aliases (`stabilize`, `refactor`).
  >>[2026-02-24 15:01] revise — Replaced single-profile FUZZ resolution with composable profile parsing + alias expansion + FUZZ_LEVEL severity control.
  >>[2026-02-24 15:06] taste — Updated docs to frame fuzz as an experiment loop, not just static quality checks.
  >>[2026-02-24 15:15] observe — Validation runs confirm alias/composition logging and expected rule activation; repo still has pre-existing lint debt.
  # Types: observe, decide, surprise, revise, blocked, taste, rebase, hygiene
}

^["open"]{
  # Unresolved questions. Remove when resolved (log resolution in stream first).
}

^["commits"]{
  # Planned commits in order. Use project sigil conventions.
  # ~[N]: "sigil[scope] — description"
  ~[1]: "#[fuzz] — make fuzz profiles composable and intent-oriented in ESLint config"
  ~[2]: "#[fuzz] — add experiment-stage npm commands for composed profiles"
  ~[3]: ".[fuzz-docs] — update audit and contributor docs for the new fuzz workflow"
}

