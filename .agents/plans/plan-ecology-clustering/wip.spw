# wip — plan-ecology-clustering
# Branch: feature/plan-ecology-clustering
# Started: 2026-03-27

#>plan_plan_ecology_clustering
#:plan #!principal_engineering
#:layer #!pragmatics

^["card"]{
 phase: #active
 gist: "Every plan carries a lane, a learning value, and a place in one legible direction spine."
 touches: [~".agents/plans", ~".spw/patterns/surface-identity.spw", ~".spw/tooling/editor-instruments.spw"]
 entry: ~"./plan-ecology-clustering.spw"
 next: "Keep the derived index truthful: primed tooling follows syntax-hardware-alignment and the two performance benches, and plan_map stays a reading rather than a second urgency queue."
}

^["edges"]{
 feeds: [~"../gap-affinity-tooling/wip.spw", ~"../package-iteration-radius/wip.spw"]
 shares: [~"../operational-topography/wip.spw"]
}

^["roots"]{
 @cluster: ~".agents/plans/plan-ecology-clustering/plan-ecology-clustering.spw"
 @plan: ~".agents/plans/plan-ecology-clustering/PLAN.md"
 @artifact: ~".agents/plans/plan-ecology-clustering/plan-ecology-clustering.spw"
 @pattern: ~".spw/patterns/literate-ui.spw"
 @topography: ~".agents/plans/operational-topography/operational-topography.spw"
 @gap_affinity: ~".agents/plans/gap-affinity-tooling/gap-affinity-tooling.spw"
 @package_radius: ~".agents/plans/package-iteration-radius/package-iteration-radius.spw"
 @editor_instruments: ~".spw/tooling/editor-instruments.spw"
}

^["intent"]{
 ~#goal: "Recluster the active plans so execution, contributor formation, research, and speculative work stop competing for one urgency queue. Each plan should gain a clearer learning value, discussion subject, and experimental question."
 ~#taste: "clarity, layering, naming, meaningfulness"
}

^["development"]{
 lane: #execution_truth
 ladder: #bridge
 develops: [#planning_judgment, #principal_engineering, #design_ladder, #ecology_taste]
 review_surfaces: [@cluster, @plan, @artifact, @pattern, @topography]
 snippet_routes: [#cluster_tag, #commit_bar, #review_loop, #ladder_note]
}

^["concept_index"]{
 primary: [#clustering, #planning, #urgency, #learning, #research, #principal_engineering]
 surfaces: [#plans, #artifacts, #governance, #release, #curriculum]
 tensions: [#decorative_taxonomy, #stale_paths, #priority_blur, #learning_drag]
 transfers: [#language, #component, #page, #service]
}

^["recursive_improvement"]{
 loop: [
  "? reread active plans, artifacts, and repo patterns before widening the taxonomy",
  "< ship one clustering rule that changes scheduling, review, or commit judgment",
  "$ record what became more discussable, teachable, or indexable",
  "^ propagate the surviving doctrine into local plan memory and artifacts",
  "% keep the cluster map operational rather than decorative",
 ]
 gates: [#specificity, #review_value, #transfer, #non_ornamental]
}

^["stream"]{
 >>[2026-03-27 15:04] observe — the active plan ecology mixes release-critical lanes, contributor curricula, public-interest probes, and stale rewrite-era recoveries under one undifferentiated sense of urgency.
 >>[2026-03-27 15:05] decide — the recluster should preserve curricular value rather than demote it; learning lanes need a better role, not a quieter one.
 >>[2026-03-27 15:07] decide — every active plan gets three added readings: what it teaches, what it creates for discussion, and what research or probe it enables.
 >>[2026-03-27 15:08] revise — canopy and release plans should explicitly consume the cluster map so tags and launch claims depend on execution truth lanes, while curricula and research lanes still feed heuristics and discussion into the work.
 >>[2026-03-27 15:09] taste — a well-considered commit should make something truer, teach something, and open a better subject for conversation even before external demand is obvious.
 >>[2026-03-27 15:44] decide — the cluster doctrine should explicitly serve principal engineering: deepen design taste, web linguistics, and applied learning science rather than only sorting urgency.
 >>[2026-03-27 15:45] revise — add a learning ladder from Spw language design into component, page, and service design so plans can be valued for how they develop judgment, not just what they ship.
 >>[2026-03-27 16:02] observe — `.spw/patterns/literate-ui.spw` introduces a denser pattern idiom: operator-coded maps, embedded facet blocks, and wonder frames carrying relational explanation.
 >>[2026-03-27 16:03] revise — restyle the cluster artifact toward that idiom: fewer long prose strings, more operator-grouped structure, tag sets, and wonder routes between research, curriculum, execution, and design ladders.
 >>[2026-03-27 16:18] decide — the cluster artifact should become a richer review instrument: it needs explicit surfaces for code-pattern review, web-ecosystem capability review, syntax testing, and snippet discovery.
 >>[2026-03-27 16:19] taste — depth here should not mean more narration alone; it should mean more places where the repo can be queried, compared, and learned from.
 >>[2026-03-27 16:43] revise — propagate the cluster doctrine into representative ladder plans so the taxonomy becomes local judgment: language (`register-phase-evolution`), component (`vscode-register-explorer`), page (`curriculum-html-css-mastery`), and service (`runtime-dx-foundation`).
 >>[2026-03-27 16:44] taste — the doctrine is only real if individual plans gain review surfaces, capability transfer, syntax discipline, and snippet routes that can steer actual commits.
 >>[2026-03-27 17:12] revise — extend the propagation into the lagging curriculum/audit/editor-future plans and into companion `.spw` artifacts so the doctrine touches both human-facing plans and machine-readable interaction specs.
 >>[2026-03-27 17:13] taste — the remaining risk is lore-era placeholder paths pretending to be immediate work; when no concrete target exists, the plan should say so and redirect energy into review surfaces, snippets, and reusable judgments.
 >>[2026-07-20 14:36] observe — mounted consumer corpora may contain richer claim, audit, convention, and language surfaces than editor-parity plans anticipate.
 >>[2026-07-20 14:37] decide — mounted-consumer review becomes the ecology's primary transfer test: repository-local models use the pinned workbench as an instrument, keep findings consumer-owned, and return only deliberately distilled improvements upstream.
 >>[2026-07-20 14:38] revise — prioritize `spw-site-install`, review protocol, claim/probe portability, and governance evidence; keep editor-specific parity and migrations speculative until repeated consumer reviews demonstrate their utility.
 >>[2026-07-20 15:14] revise — register `mounted-consumer-tooling` as the identity-free audit bridge across CLI, LSP, and editor plans; retire named-domain fixtures from active plan evidence.
 >>[2026-07-20 19:20] register — operational-topography becomes the neutral bridge for parser-owned coordinates, evidence/effect grades, exact-first discovery, and differential authority; garden and LSP roadmap consume it in their declared lanes.
 >>[2026-07-20 19:21] revise — temperature is a dated snapshot rather than a derived fact, and repository authority no longer requires a claim-shaped surface.
 >>[2026-07-27 13:18] observe — ecology sweep at main@61025640. 55 active plans became 50: archived bias-resolution-product (merged, 17 done entries), neovim-spw-surfaces (complete, landed in b1439e0a), v030-release-prep (closed, v0.3.0 tagged), lsp-lore-upstream-bridge and skills-instrumentation-utility (both explicitly closed in their own streams).
 >>[2026-07-27 13:18] decide — four plans independently named one object: onf.ts "semantic hash", spw-garden-geometry "ONF shape hash", geometric-analysis-tooling "shapeFingerprint", apposition-cache-granules "granule key". Wrote .spw/patterns/surface-identity.spw to hold the shared vocabulary, distinguishing content_hash, shape_fingerprint, and granule_key by their collision semantics, and cross-referenced it from all four.
 >>[2026-07-27 13:18] observe — collision found and recorded rather than resolved: apposition-cache-granules and spw-beat-diff-precipitation both edit packages/spw-lsp/src/server-index.ts and both add a config block to .spw/workspace.spw. surface-identity.spw rules one shared cache block; ordering is still open.
 >>[2026-07-27 13:18] observe — five plans are stranded on the deleted src/ui, src/core, and src/platform layout: refactor-import-sprawl, symmetry-explorer-instrument, audit-css-tokens, audit-ui-data-models, audit-data-attributes. Marked stranded rather than archived — they were never declared done, and the UI concerns may belong to a site repo. brand-core-ids is separate: relocatable to packages/, and still wanted.
 >>[2026-08-24 10:05] observe — current main carries a publishable product/disclosure spine, but the ecology still advertises landed foundations and archived release work as if they competed with current compatibility, intermediate-output, and evidence work.
 >>[2026-08-24 10:06] decide — publish one identity-free consumer reading order: compatibility, intermediate disclosure, mounted authority, evidence, then optional projection. Plans name capability contracts and observable states rather than the repositories that supplied pressure.
 >>[2026-08-24 10:07] revise — the current execution spine is canon rewrite, install/mount contract, CLI sense and mode composition, benchmark evidence, and syntax-profile compatibility; editor and metaphor experiments remain downstream projections unless runtime evidence promotes them.
 >>[2026-08-24 11:27] register — gap-affinity-tooling joins the hot execution spine at the compatibility/intermediate boundary: declared gaps, format-policy migrations, question-oriented products, and identity-free consumer exchange.
 >>[2026-08-24 11:28] register — package-iteration-radius joins the hot service spine: package truth, redacted environment receipts, leaf/public parity, onboarding, and measurable feedback radius.
 >>[2026-08-24 11:29] decide — mature consumer conversation starts with useful unannotated repositories, publishes capability and consequence receipts, and accepts identity-free gap evidence without turning any consumer ontology into workbench grammar.
 >>[2026-08-24 11:38] revise — consumer exchange also discloses whether a sidecar is authoritative, descriptive, or interpretive, and requires source back-references plus promotion state before a lens becomes shared implementation guidance.
 >>[2026-08-24 11:52] revise — the first gap-affinity increment is intentionally observational: exact gaps, dotted segments, disclosure policies, and progressive CLI projections may communicate before AssociationIR, formatter migrations, or inferred local style become release claims.
 >>[2026-08-24 14:36] register — webstorm-compatibility joins execution truth and the IntelliJ interaction target with independent Java, build-host, verified-host, declared-range, mounted-launcher, and three-depth Writerside coordinates; intellij-lsp4ij remains speculative until the 263 boundary requires a substrate decision.
 >>[2026-08-24 15:44] register — editor-cli-instruments joins execution truth as the shared Form → Stack → Cache → Rename → Refactor Plan contract; question parity and evidence receipts are common, while VS Code, IntelliJ/WebStorm, and Neovim preserve distinct creative contours.
 >>[2026-08-24 18:00] revise — recast the @ lane from speculative editor future to projection feedback. Hosts stay incomplete on purpose: they name cache layer, winning profile, and runtime cost rather than finishing an IDE.
 >>[2026-08-24 18:00] register — noun-postfix-containers joins the language ladder as the identifier-led noun contour.
 >>[2026-08-24 18:20] revise — hold depth and parity together. Hosts owe comparable truth density and respect question/evidence parity; native form may differ. Chrome mimicry is false parity; one deep host and shallow peers is false depth. Completeness is still not assumed.
 >>[2026-09-28 17:08] revise — ecology_temperature is superseded by .agents/plans/index.spw: phase frames derive from cards, cooling and status lag live in its drift frame. Card operators carry the cluster_operator_map glyphs; 44 of 75 cards appear in plan_map.
 >>[2026-09-30 16:54] decide — primed order is scrutiny then tooling. syntax-hardware-alignment and typescript-perf-audit-infra join planning. cli-benchmarking-infra leads measurement. cli-mode-overhaul, citation journeys, the spw/* matrix, Neovim wrappers, and LSP4IJ hold product work. vscode-plugin-performance and geometric-analysis-tooling stay dormant until a sample or the ops=3 repro makes them true.
 >>[2026-10-12 14:35] observe — reconciled against main: the doctrine commits ~[1]..~[4] landed together in 9c1ebc10 (2026-03-27 ecology propagation) and the lane-glyph cards plus derived index in da5189bb; they were never committed one per item. Measured now: plan_map in plan-ecology-clustering.spw has 44 rows against 78 plan directories holding a wip.spw, 34 without a row and none orphaned. ~[5] (verify) is open as ongoing maintenance, and spw:plan:index --check currently reports the index stale.
 >>[2026-10-12 14:35] revise — ~[1]..~[4] moved to ^[done]; ~[5] rewritten to concrete checks; ~[6] added to settle plan_map coverage; ?[plan_map_scope] opened because the card's next promises plan_map stays a reading, which needs a scope.
 >>[2026-10-12 14:48] observe — Dogfood pass 2026-10-12, spw pulse parse health over 70 edited wip.spw files against HEAD: complete_structured 6 to 6, recovered 49 to 44, invalid 15 to 20. Five flipped recovered to invalid (audit-fuzz-truthfulness, curriculum-html-css-mastery, naming-profile-convention-align, spw-garden-geometry, syntax-hardware-alignment). Cause is the stream: lines of the form arrow-stamp type dash prose carry unquoted hyphens, em dashes and apostrophes that tokenize as errors, and spw:plan:stream appends them unquoted. HEAD already had 9 to 119 recoverable errors per file from the same cause. Health is count-sensitive, not a validity verdict. Derived fields were consistent after the pass: open_count and last_stream drift 0 of 70, checked by script, not by a mutation verb.
 >>[2026-10-12 14:56] revise — Corrects the 2026-10-12 dogfood entry. The stream lexer rule already exists (readPlanStreamEntry, c855e832, dialect Spw.p). The health probe snapshotTopography in topography-probe.ts calls parse on the source with no path, so plan files without a dialect header are read as Spw.b and prose in stream lines tokenizes as errors. The writer is not at fault. Fix is tracked in plan-stream-parse-health. The recovered to invalid flips were an artifact of the pathless probe plus longer stream lines, not of the format.
}

^["open"]{
 ?[plan_map_scope]: "plan_map has 44 rows for 78 carded plans; should it cover every carded plan, or only active and landed ones (the index already lists the rest)? Decides whether ~[6] backfills 34 rows or prunes the claim."
}

^["commits"]{
 # ~[1]..~[4] landed — see ^["done"]
 ~[5]: "![plans] — verify: spw:plan:index --check clean, spw:plan:check across every slug, and lint:spw on plan-ecology-clustering.spw"
 ~[6]: ".[plans] — settle plan_map coverage per ?[plan_map_scope]: backfill the missing rows or state the covered phases in the frame header"
}

^["cache"]{
 ~#status: "active"
 ~#base_ref: "main@c46558ffbb29a10abb1fee11dbec8aa522cbc8b3"
 ~#rebased_at: "2026-08-24"
 ~#hygiene_split: "required-before-implementation"
 ~#files_hot: ".agents/plans/plan-ecology-clustering/plan-ecology-clustering.spw, .spw/tooling/editor-instruments.spw, .agents/plans/_archive/editor-cli-instruments/PLAN.md"
 ~#next_commit: "5"
 ~#open_count: "1"
 ~#last_stream: "2026-10-12 14:56"
 ~#taste_debt: "The directional spine is intentionally narrower than the full plan corpus. Archive or re-scope stranded site-era plans before treating them as executable, and keep scalar release labels from implying synchronized language, runtime, package, and consumer-profile compatibility."
}

^["done"]{
 # Written at merge time.
 ~#shipped: [
  "9c1ebc10 .[plans] =ecology[recursive-improvement] — align active plan surfaces (covers ~[1]..~[4])",
  "da5189bb .[plans] — card every live plan; derive the index; route readers to it",
 ]
}

#>wonder_agents_plans_planecologyclustering_1
?["What makes a plan valuable before it becomes urgent?"]{
  #:depth #!educational // lens: contributor formation
  ~#shape: "learning, discussion, experiment"
  !probe{ "for each active plan, can a reader name what it teaches, what it lets the team discuss, and what would count as evidence?" }
}

#>wonder_agents_plans_planecologyclustering_2
?["How does a commit become well-considered when external demand is unclear?"]{
  #:depth #!computational // lens: formal structure
  ~#hypothesis: "a commit is justified when it increases truth, learning, or probe quality without pretending to solve all three at once"
  !probe{ "which active plans can survive this bar, and which ones need a rewrite before they should move again?" }
}

#>wonder_plan_ecology_clustering_map_gap
?["Do the 34 carded plans missing from plan_map share a lane or phase, or are they scattered?"]{
  #:depth #!computational // lens: coverage
  ~#hypothesis: "the missing rows are mostly #stranded, #dormant, and #landed plans, so the 44 rows already track the live spine"
  !probe{ "list slugs with a wip.spw, subtract the row keys of plan_map in plan-ecology-clustering.spw (dashes to underscores), then read each missing plan's card phase and lane glyph" }
  $%[plan.commit_count, plan.phase_progress]
}
