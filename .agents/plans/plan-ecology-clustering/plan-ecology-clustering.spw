# Plan Ecology Clustering
#
# Cluster operators as planning navigation.
# Learning loops as design transfer.

#>spw_plan_ecology_clustering
#:layer #!pragmatics

^"roots"{
 @literate_ui: ~".spw/patterns/literate-ui.spw"
 @patterns: ~".spw/patterns/index.spw"
 @query_comp: ~".spw/patterns/query-composition.spw"
 @workspace: ~".spw/workspace.spw"
 @scoped_evolution: ~".spw/process/scoped-evolution.spw"
 @hot_reload: ~".spw/process/hot-reload-loop.spw"
 @selector_expr: ~"packages/spw-seed/src/query/selector-expr.ts"
 @spwq: ~"packages/spw-seed/src/query/spwq.ts"
 @selector_presets: ~"packages/spw-seed/src/query/presets.ts"
 @sigil_semantics: ~"extensions/vscode-spw/src/semantics.ts"
 @surface_governance: ~".agents/plans/ecosystem-surface-governance/ecosystem-surface-governance.spw"
}

^"cluster_operator_map"{
 '?': .{lane:#public_interest_research, commit:[#question, #surface, #exhibit], drift:[#unknown_interest], feeds:[#prompt, #theory, #instrument]}
 '~': .{lane:#curriculum_formation, commit:[#precedent, #heuristic, #transfer], drift:[#ornamental_curriculum], feeds:[#labs, #taste, #rehearsal]}
 '!': .{lane:#execution_truth, commit:[#adoption, #truth, #trust], drift:[#false_claim], feeds:[#install, #dx, #release, #query, #editor]}
 '@': .{lane:#speculative_editor_future, commit:[#rotation, #solo_ship, #thin_lane], drift:[#hot_file_fantasy], feeds:[#interaction, #explorer, #authoring]}
 '.': .{lane:#rewrite_recovery, commit:[#reground, #scope, #ownership], drift:[#legacy_memory], feeds:[#rewrite, #path_truth, #baseline_truth]}
 '^': .{lane:#principal_engineering, commit:[#taste, #linguistics, #design_transfer], drift:[#abstract_mission], feeds:[#language, #component, #page, #service]}
}

^"learning_cycle"{
 '?': .{role:#precedent, ask:"which spec, sibling system, or prior artifact teaches the move?"}
 '<': .{role:#exercise, ask:"what small artifact or patch expresses the lesson?"}
 '$': .{role:#reflection, ask:"what changed in Spw or web understanding?"}
 '^': .{role:#transfer, ask:"where does the lesson cash out next?"}
 '%': .{role:#negative_control, ask:"what should stay stable if the hypothesis is wrong?"}
 ~#sequence: "? -> < -> $ -> ^ -> %"
}

^"tag_sets"{
 learn: [#taste, #linguistics, #query, #naming, #dx, #telemetry, #theory, #prompt, #component, #page, #service, #governance, #state, #layout]
 discuss: [#compat, #verbs, #launch, #phase_vocab, #ownership, #editor_scope, #surface_fit, #interaction, #atmosphere, #preview]
 probe: [#corpus, #readability, #truth, #coherence, #latency, #fallback, #transfer, #a11y, #selector_success, #failure_locality, #interest]
}

^"review_surfaces"{
 patterns: .{
  roots: [@patterns, @literate_ui, @query_comp]
  asks: [#pattern_drift, #transfer, #composition, #operator_mapping]
  review_moves: [#read, #compare, #reverse_edge, #extract_invariant]
 }
 process: .{
  roots: [@workspace, @scoped_evolution, @hot_reload]
  asks: [#syntax_safety, #feedback_speed, #promotion_gate, #rollback]
  review_moves: [#trace_loop, #inspect_scope, #name_failure, #test_gate]
 }
 code: .{
  roots: [@selector_expr, @spwq, @selector_presets, @sigil_semantics]
  asks: [#operator_surface, #selector_native, #semantic_drift, #ui_language]
  review_moves: [#grep, #query, #smoke, #cross_read]
 }
}

^"web_linguistics"{
 document: [#html, #aria, #a11y_tree, #hierarchy]
 layout: [#containment, #grid, #query, #cascade, #rhythm]
 vector: [#viewBox, #path, #filter, #animation, #foreignObject]
 runtime: [#operators, #phase, #telemetry, #diagnostics, #prompt]
 interaction: [#tty, #editor, #preview, #service, #governance]
 ~#aim: [#rigor, #taste, #transfer]
}

^"web_capability_radar"{
 document: .{from:[#html, #aria, #a11y_tree], toward:[#component, #page], asks:[#meaning, #hierarchy, #legibility]}
 layout: .{from:[#containment, #grid, #query, #cascade], toward:[#component, #page], asks:[#density, #navigation, #rhythm]}
 vector: .{from:[#viewBox, #path, #filter, #animation], toward:[#component, #page, #exhibit], asks:[#shape, #motion, #atmosphere]}
 runtime: .{from:[#operators, #phase, #telemetry, #diagnostics], toward:[#language, #service], asks:[#truth, #traceability, #feedback]}
 interaction: .{from:[#tty, #editor, #preview, #service], toward:[#component, #page, #service], asks:[#gesture, #trust, #handoff]}
}

^"commit_bar"{
 '?': "what becomes truer?"
 '~': "what is learned?"
 '@': "what becomes discussable?"
 '$': "what becomes measurable?"
 '%': "what should stay stable if wrong?"
 ~#rule: "? + ~ + @ + $ + % should all be legible; one may dominate, none should vanish"
}

^"design_ladder"{
 language: .{op:"?", plans:["prompt-surface-align", "image-prompt-split", "precipitate-model-alignment", "register-phase-evolution", "lib-arch-spw-theory"], asks:[#semantics, #phase_vocab, #prompt, #theory], into:"*"}
 component: .{op:"*", plans:["audit-css-tokens", "audit-data-attributes", "audit-ui-data-models", "vscode-authoring-probe-loop", "vscode-register-explorer"], asks:[#state, #style, #operator_widget, #register], into:"."}
 page: .{op:".", plans:["curriculum-html-css-mastery", "curriculum-html-svg-mastery", "ecosystem-surface-governance", "symmetry-explorer-instrument"], asks:[#navigation, #layout, #atmosphere, #exhibit], into:"!"}
 service: .{op:"!", plans:["spw-site-install", "runtime-dx-foundation", "lsp-lore-upstream-bridge", "v030-release-prep"], asks:[#install, #diagnostics, #governance, #preview], into:"?"}
 bridge: .{op:"@", plans:["obsidian-spw", "intellij-lsp4ij", "neovim-spw-surfaces", "lsp-custom-request-completions"], asks:[#substrate, #transfer, #protocol, #failure_locality], into:"!"}
 ~#cycle: "? -> * -> . -> ! -> ?"
 ~#cross: "@ bridge plans straddle ! and ~ — they execute a port but learn the target substrate"
 ~#principal: "^ keeps the ladder permeable — local learning should rise into durable design judgment"
}

^"syntax_field"{
 stable: .{
  roots: [@workspace, @hot_reload]
  keeps: [#syntax_health, #error_context, #changed_path_scope]
  asks: [#parse_ok, #phase_hint, #next_action]
 }
 experimental: .{
  roots: [@scoped_evolution]
  keeps: [#scope_marker, #probe_coverage, #rollback]
  asks: [#semantic_drift, #promotion_gate, #aberration_risk]
 }
 selector_native: .{
  roots: [@selector_expr, @spwq, @selector_presets]
  keeps: [#query_surface, #portable_seed, #native_syntax]
  asks: [#operator_envelope, #brace_pair, #descend, #sequence]
 }
}

^"snippet_discovery"{
 sources: [@literate_ui, @surface_governance, @workspace, @query_comp]
 forms: [#seed, #title, #body, #projection, #reference, #tag]
 selectors: ["$~\"_\" | $@_", "$^[_]"]
 seeks: [#snippet_reuse, #concept_chip, #operator_shape, #projection_target, #tag_propagation]
 routes: {
  language: "? snippet candidate"
  component: "* snippet expands into operator-widget or state surface"
  page: ". snippet anchors navigation, literature, or exhibit flow"
  service: "! snippet becomes installable, queryable, or exchangeable"
 }
}

^"pattern_review_loops"{
 compare: .{from:[@literate_ui, @query_comp, @workspace], asks:[#shared_invariant, #missing_concept, #next_pattern]}
 syntax: .{from:[@scoped_evolution, @hot_reload, @selector_expr], asks:[#safe_experiment, #parse_signal, #rollback]}
 snippet: .{from:[@literate_ui, @surface_governance, @query_comp], asks:[#discover, #tag, #reference, #exchange]}
 capability: .{from:[@sigil_semantics, @workspace], asks:[#operator_role, #ui_language, #capability_surface]}
}

^"parallel_work"{
 critical_path: [#cluster_operator_map, #design_ladder, #plan_map]
 parallelizable: [#review_surfaces, #web_capability_radar, #syntax_field, #snippet_discovery]
 shared_hot_files: [@literate_ui, @query_comp, @surface_governance]
 merge_risks: [#lane_drift, #ornamental_taxonomy, #interest_inflation]
 handoff_artifacts: [@workspace, @literate_ui, @surface_governance]
}

^"supporting_documents"{
 must_ship: [@workspace, @literate_ui]
 helpful: [@query_comp, @surface_governance, @sigil_semantics]
 carries: [#cluster_reading, #ladder_map, #review_walk, #snippet_route]
}

^"interaction_depth"{
 subjects: [#judgment, #taste, #transfer, #interest, #discipline, #review]
 questions: [#what_is_blocking, #what_is_learning, #what_is_publicly_interesting, #what_should_wait]
 qualities: [#clarity, #reversibility, #composability]
}

^"cluster_flow"{
 '? -> !': .{requires:[#surface, #evidence, #interest]}
 '~ -> *': .{requires:[#precedent, #exercise, #transfer]}
 '* -> .': .{requires:[#composition, #navigation, #taste]}
 '. -> !': .{requires:[#install, #governance, #dx]}
 '! -> ?': .{requires:[#failure, #curiosity, #next_cycle]}
}

^"mounted_review_flow"{
 site_authority: [".spw/index.spw", ".spw/workspace.spw", ".spw/conventions/*", ".spw/claims/*", ".spw/audits/*"]
 mounted_instruments: ["parser", "spwq", "claim/probe protocols", "review skills", "diagnostics"]
 sequence: [#discover_site, #read_mount, #select_review_profile, #run_probes, #write_site_evidence, #offer_upstream_distillation]
 provenance: [#site_revision, #workbench_revision, #review_profile, #probe_commands]
 negative_controls: [#no_automatic_upstream_write, #no_mounted_root_as_site_authority, #no_private_site_fixture_copy]
 primary_plan: "spw-site-install"
 consumers: ["ecosystem-surface-governance", "lsp-lore-upstream-bridge", "intellij-plugin-integration", "vscode-workspace-atlas"]
}

^"plan_map"{
 '!': {
  absorb_spwq_cli: .{learn:[#truth, #query, #naming], discuss:[#compat, #verbs], probe:[#selector_success, #corpus]}
  audit_fuzz_truthfulness: .{learn:[#truth, #dx, #governance], discuss:[#launch, #ownership], probe:[#coherence, #readability]}
  commit_gate_redesign: .{learn:[#dx, #governance, #truth], discuss:[#ownership, #launch], probe:[#failure_locality, #coherence]}
  ecosystem_surface_governance: .{learn:[#governance, #page, #service], discuss:[#launch, #surface_fit], probe:[#coherence, #interest]}
  intellij_plugin_integration: .{learn:[#dx, #editor_scope], discuss:[#surface_fit, #ownership], probe:[#fallback, #latency]}
  lsp_lore_upstream_bridge: .{learn:[#dx, #service, #ownership], discuss:[#compat, #surface_fit], probe:[#fallback, #failure_locality]}
  lsp_custom_request_completions: .{learn:[#service, #query, #telemetry], discuss:[#surface_fit, #phase_vocab], probe:[#truth, #latency]}
  register_phase_evolution: .{learn:[#linguistics, #query, #naming], discuss:[#phase_vocab, #verbs], probe:[#truth, #coherence]}
  runtime_axis_traceability: .{learn:[#linguistics, #telemetry, #theory], discuss:[#ownership, #surface_fit], probe:[#readability, #coherence]}
  runtime_dx_foundation: .{learn:[#dx, #service, #telemetry], discuss:[#launch, #surface_fit], probe:[#latency, #failure_locality]}
  runtime_telemetry_canon: .{learn:[#telemetry, #service, #truth], discuss:[#ownership, #surface_fit], probe:[#coherence, #failure_locality]}
  spw_site_install: .{learn:[#service, #governance, #dx], discuss:[#ownership, #launch], probe:[#failure_locality, #interest]}
  v030_release_prep: .{learn:[#service, #governance, #truth], discuss:[#launch, #surface_fit], probe:[#readability, #interest]}
  vscode_lsp_integration: .{learn:[#dx, #editor_scope, #query], discuss:[#surface_fit, #ownership], probe:[#truth, #latency]}
  vscode_plugin_performance: .{learn:[#dx, #latency, #service], discuss:[#launch, #surface_fit], probe:[#latency, #truth]}
 }
 '?': {
  image_prompt_split: .{learn:[#prompt, #linguistics, #taste], discuss:[#surface_fit, #interaction], probe:[#readability, #interest]}
  lib_arch_spw_theory: .{learn:[#theory, #linguistics, #page], discuss:[#ownership, #surface_fit], probe:[#readability, #transfer]}
  precipitate_model_alignment: .{learn:[#theory, #telemetry, #linguistics], discuss:[#phase_vocab, #ownership], probe:[#coherence, #truth]}
  prompt_surface_align: .{learn:[#prompt, #linguistics, #query], discuss:[#phase_vocab, #surface_fit], probe:[#truth, #readability]}
  symmetry_explorer_instrument: .{learn:[#component, #page, #taste], discuss:[#interaction, #surface_fit], probe:[#interest, #transfer]}
 }
 '~': {
  audit_css_tokens: .{learn:[#taste, #component, #layout], discuss:[#atmosphere, #surface_fit], probe:[#coherence, #transfer]}
  audit_data_attributes: .{learn:[#state, #component, #a11y], discuss:[#ownership, #interaction], probe:[#coherence, #a11y]}
  audit_ui_data_models: .{learn:[#state, #component, #linguistics], discuss:[#ownership, #surface_fit], probe:[#truth, #transfer]}
  curriculum_html_css_mastery: .{learn:[#layout, #page, #taste], discuss:[#atmosphere, #surface_fit], probe:[#transfer, #interest]}
  curriculum_html_svg_mastery: .{learn:[#component, #page, #taste], discuss:[#interaction, #atmosphere], probe:[#transfer, #interest]}
  curriculum_logic_terminal_mastery: .{learn:[#service, #query, #linguistics], discuss:[#verbs, #interaction], probe:[#transfer, #interest]}
 }
 '@': {
  command_experience_tools: .{learn:[#interaction, #component, #state], discuss:[#editor_scope, #surface_fit], probe:[#interest, #transfer]}
  intellij_lsp4ij: .{learn:[#dx, #editor_scope, #service], discuss:[#surface_fit, #compat], probe:[#fallback, #transfer]}
  neovim_spw_surfaces: .{learn:[#editor_scope, #interaction, #dx], discuss:[#surface_fit, #atmosphere], probe:[#transfer, #latency]}
  obsidian_spw: .{learn:[#editor_scope, #interaction, #service, #failure_locality], discuss:[#surface_fit, #atmosphere, #ownership], probe:[#transfer, #latency, #interest, #fallback]}
  vscode_authoring_probe_loop: .{learn:[#editor_scope, #interaction, #linguistics], discuss:[#atmosphere, #phase_vocab], probe:[#latency, #interest]}
  vscode_cognitive_surface: .{learn:[#editor_scope, #interaction, #taste], discuss:[#surface_fit, #atmosphere], probe:[#interest, #transfer]}
  vscode_editor_contract: .{learn:[#editor_scope, #ownership, #linguistics], discuss:[#surface_fit, #ownership], probe:[#truth, #coherence]}
  vscode_register_explorer: .{learn:[#editor_scope, #state, #telemetry], discuss:[#interaction, #phase_vocab], probe:[#latency, #transfer]}
  vscode_workspace_atlas: .{learn:[#editor_scope, #page, #layout], discuss:[#interaction, #surface_fit], probe:[#transfer, #interest]}
 }
 '.': {
  brand_core_ids: .{learn:[#linguistics, #state, #ownership], discuss:[#surface_fit, #ownership], probe:[#truth, #transfer]}
  refactor_import_sprawl: .{learn:[#service, #ownership, #layout], discuss:[#ownership, #surface_fit], probe:[#coherence, #transfer]}
  skills_instrumentation_utility: .{learn:[#service, #dx, #ownership], discuss:[#compat, #verbs], probe:[#truth, #coherence]}
 }
}

^"interaction_target_cluster"{
 // Plans that share the "interaction target" abstraction — editor integrations that
 // transfer syntax, LSP, custom requests, and views across host substrates.
 // These plans should converge on shared vocabulary even though they ship independently.
 targets: {
  vscode: .{plans:["vscode-workspace-atlas", "vscode-register-explorer", "vscode-authoring-probe-loop", "vscode-plugin-performance", "vscode-editor-contract", "vscode-cognitive-surface"], contract:~"extensions/vscode-spw/src/context.ts"}
  intellij: .{plans:["intellij-lsp4ij", "intellij-plugin-integration"], contract:~"extensions/intellij-spw/src/main/kotlin/com/spwashi/spw/SpwLanguage.kt"}
  neovim: .{plans:["neovim-spw-surfaces"], contract:~"extensions/neovim-spw/syntax/spw.vim"}
  obsidian: .{plans:["obsidian-spw"], contract:~".agents/plans/obsidian-spw/references/interaction-targets.spw"}
 }
 shared_truth: [#sigil_semantics, #annotation_taxonomy, #custom_request_protocol, #root_map, #spirit_phases]
 adapts_per_target: [#syntax_mechanism, #lsp_client, #view_rendering, #file_watcher, #path_resolution]
 novel_per_target: {
  vscode: [#interaction_contract, #webview_panels, #multi_root_workspaces]
  intellij: [#psi_tree, #lsp4ij_migration, #tool_windows]
  neovim: [#buffer_keymaps, #quickfix_list, #treesitter_path]
  obsidian: [#vault_topology, #three_render_pipelines, #custom_lsp_client, #markdown_co_presence]
 }
}

^"ecology_temperature"{
 // Which plans are active, which are warm, which are cold.
 // Derived from cache status and last stream timestamps.
 // Useful for prioritization and staleness detection.
 hot: ["spw-site-install", "ecosystem-surface-governance", "audit-fuzz-truthfulness"]
 warm: ["commit-gate-redesign", "lib-arch-spw-theory", "prompt-surface-align", "absorb-spwq-cli", "intellij-plugin-integration", "vscode-workspace-atlas"]
 cold: ["intellij-lsp4ij", "obsidian-spw", "neovim-spw-surfaces", "symmetry-explorer-instrument", "image-prompt-split", "brand-core-ids", "command-experience-tools", "refactor-import-sprawl"]
 closed: ["v030-release-prep", "skills-instrumentation-utility", "lsp-lore-upstream-bridge"]
 // Review: plans in cold that declare dependencies on warm/hot plans may be ready to activate.
 // Plans in warm that haven't streamed in >14 days may be cooling.
}

#>wonder_agents_plans_planecologyclustering_artifact_1
?["How does ? public-interest research become ! execution truth?"]{
  #:depth #!computational // lens: transfer path
  ~#route: "? -> !"
  $^["cluster_flow"]@here => $^["plan_map"]@here
  !probe{ "trace one plan that can cross the route without losing its original question." }
  ~<.spw/patterns/literate-ui.spw>
}

#>wonder_agents_plans_planecologyclustering_artifact_2
?["How does ~ curriculum formation become * component or . page design?"]{
  #:depth #!educational // lens: applied learning science
  ~#route: "~ -> * -> ."
  $^["learning_cycle"]@here => $^["design_ladder"]@here
  !probe{ "pick one lab or audit plan and name the next component or page it should sharpen." }
  ~<.spw/patterns/index.spw>
}

#>wonder_agents_plans_planecologyclustering_artifact_3
?["Where does ^ principal engineering appear if no new feature ships?"]{
  #:depth #!stylistic // lens: taste formation
  ~#answer_shape: [#taste, #linguistics, #transfer, #discipline]
  !probe{ "identify the smallest commit that improves judgment, not just inventory." }
  $%[file.frame_count, file.annotation_density, file.brace_depth_max]
}

#>wonder_agents_plans_planecologyclustering_artifact_4
?["How should code patterns review planning patterns?"]{
  #:depth #!computational // lens: code-literature braid
  $^["review_surfaces"]@here => $^["pattern_review_loops"]@here
  !probe{ "trace one edge from pattern file to process file to code file; if the edge cannot be named, the review surface is ornamental." }
  ~<packages/spw-seed/src/query/selector-expr.ts>
}

#>wonder_agents_plans_planecologyclustering_artifact_5
?["Which web ecosystem capabilities should move from study into live surfaces first?"]{
  #:depth #!educational // lens: capability transfer
  $^["web_capability_radar"]@here => $^["design_ladder"]@here
  !probe{ "pick one document, layout, vector, runtime, and interaction capability; name the next component, page, or service each should sharpen." }
  ~<.spw/workspace.spw>
}

#>wonder_agents_plans_planecologyclustering_artifact_6
?["How does syntax testing stay curious without becoming reckless?"]{
  #:depth #!mathematical // lens: controlled evolution
  $^["syntax_field"]@here => $^["learning_cycle"]@here
  !probe{ "show one stable path, one experimental path, and one rollback path; if any one is missing, curiosity is under- or over-constrained." }
  ~<.spw/process/scoped-evolution.spw>
}

#>wonder_agents_plans_planecologyclustering_artifact_7
?["Where are snippet candidates hiding in the current workspace?"]{
  #:depth #!experiential // lens: discovery walk
  $^["snippet_discovery"]@here => $^["cluster_flow"]@here
  !probe{ "follow one selector into one snippet source, then ask whether the discovered form wants to stay seed, become component, anchor a page, or enter a service." }
  ~<.agents/plans/ecosystem-surface-governance/ecosystem-surface-governance.spw>
}
