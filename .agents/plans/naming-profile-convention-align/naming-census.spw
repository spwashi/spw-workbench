# Naming census
#
# Inventory of families and drift. Commit 3 freezes counts; stream updates after.

#>spw_plan_naming_census
#:audit #!naming
#:layer #!pragmatics

^"roots"{
 @plan: ~"./PLAN.md"
 @doctrine: ~"./naming-profile-convention-align.spw"
 @conventions_dir: ~"../../../.spw/conventions"
 @patterns_dir: ~"../../../.spw/patterns"
}

^"profile_families_found"{
 dialect_geometry: {
  ids: #[#Spw.b, #Spw.l, #Spw.m, #Spw.x, #Spw.o, #Spw.q, #Spw.t]
  owner: ~"../../../.spw/registries/dialect-spec.spw"
  surface_form: "@profile:Spw.* on seeds"
 }
 format: {
  ids: #[#pretty, #layout, #prose, #canonical, #wide, #equiv]
  owner: "packages/spw-seed resolveFormatProfile / spw format"
 }
 mutation: {
  ids: #[#layout_canonical, #measure_only, #equiv_scripts]
  owner: "MUTATION_PROFILES / spw pulse mutate"
 }
 emit_fractal: {
  ids: #[#pe_style_lock, #fractal_merge, #fractal_style_repo, #line_propagate, #pe_thrift_social]
  owner: "packages/spw-cli emit/fractal + prompts/sagas/profiles.spw"
 }
 form_geometry: {
  ids: #[#FORM_GEOMETRY_PROFILE, #FORM_MOBILITY_APPLICATION_PROFILE, #FORM_LADDER_PROFILE]
  owner: "pulse form paths"
 }
 syntax_review: {
  ids: #[#historical, #agent_surface, #canon_surface, #narrative_surface, #strict_surface]
  owner: "Agents.md / commit-review"
 }
 lens: {
  ids: #[#lens_profile]
  owner: ".spw/harness/memory-surface.spw"
 }
}

^"language_features"{
 particle: #canon
 apposition: #canon
 bias: #canon
 path_ref: #canon
 fragment: #canon
 content_hash: #canon
 shape_fingerprint: #declared
 granule_key: #declared
 effect_ladder: #canon
 cli_mode: #planned
 precipitate: #canon_concept
 derived_kind: #partial_expanded_only
}

^"constants_drift"{
 public: #[#effect.l0.measure, #effect.l1.memory, #effect.l2.workspace, #effect.l3.external]
 plan_local_grades: #[#S0, #S1, #S2]
 historical: #[#E0, #E1, #E2]
 non_ladder: #[#orchestrator]
}

^"convention_coverage"{
 indexed: #[#selection, #naming, #cli, #submodule, #packaging]
 live_unindexed: #[#file_physics, #hash_resonance, #styles]
 stale_claims: {
  cli_public_commands: "subset of COMMANDS"
  naming_command_stability: "tensions with cli-mode free-rename"
 }
}

^"findings"{
 F1: "seven profile families share head noun profile"
 F2: "conventions index incomplete"
 F3: "public grade slang still appears in plans"
 F4: "mode and profile will collide without alignment before cli-mode lands names"
 F5: "surface-identity solved three identity nouns; method not yet applied to profile"
}

^"stream"{
 >>[2026-07-27 16:50] observe — Initial census from conventions dir, dialect-spec, format/mutation/emit code paths, Agents.md review profiles, harness lens, effect ladder docs.
}
