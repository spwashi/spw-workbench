#>wonder_naming_profile_convention_align_1
?["How many profiles are in this sentence: run pulse with profile layout_canonical under Spw.b after format profile pretty?"]{
  #:depth #!computational
  ~#hypothesis: "a reader cannot tell three families (mutation, dialect, format) apart when the head noun is bare"
  !probe{ "npm run -s spw -- help | grep -ci profile; on 2026-10-12 this printed 3 (stack, mutate, profile), and the stack line already qualifies it as 'dialect, review, and format profile stack'" }
  $%[naming.family_count, naming.bare_profile_hits]
}

#>wonder_naming_profile_convention_align_2
?["Is 'public names stay stable' already true of the CLI because every renamed verb keeps an alias?"]{
  #:depth #!educational
  ~#hypothesis: "stability means alias retention, so the amended invariant is one sentence and renames of unused verbs stay free"
  !probe{ "run `npm run -s spw -- <alias> --help` for each name in command_aliases of .spw/conventions/cli.spw and `notacmd` as control; on 2026-10-12 all 24 aliases exited 0 and the control exited 2" }
  $%[cli.alias_count, cli.alias_resolving]
  @naming
  @cli_mode_plan
}
