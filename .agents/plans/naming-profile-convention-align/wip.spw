#:depth #!operational
#:template #!naming

#>naming_profile_convention_align
#:index #!alignment

^["roots"]{
 @plan: ~".agents/plans/naming-profile-convention-align/PLAN.md"
 @artifact: ~".agents/plans/naming-profile-convention-align/naming-profile-convention-align.spw"
 @census: ~".agents/plans/naming-profile-convention-align/naming-census.spw"
 @alignment: ~".spw/patterns/naming-alignment.spw"
 @surface_identity: ~".spw/patterns/surface-identity.spw"
 @conventions_index: ~".spw/conventions/index.spw"
 @naming: ~".spw/conventions/naming.spw"
 @cli_convention: ~".spw/conventions/cli.spw"
 @dialect: ~".spw/registries/dialect-spec.spw"
 @hot: ~".spw/hot.spw"
 @cli_mode_plan: ~".agents/plans/cli-mode-overhaul/PLAN.md"
 @hygiene_plan: ~".agents/plans/hygiene-index-consolidation/PLAN.md"
 @seed_roundness: ~".agents/plans/seed-roundness-grades/PLAN.md"
}

^["intent"]{
 ~#goal: "Keep language feature names, profile families, constants, and conventions one consistent mind — older designs indexed and aligned so they develop alongside CLI modes, identity kinds, and particles rather than forking head nouns."
 ~#taste: "naming + clarity + layering"
 ~#premise: "Bare profile and bare hash already failed once; the cure is family ownership and co-development, not a glossary essay."
 ~#non_goal: "Do not implement mode lattice or flow-cache; do not mass-rename MUTATION_PROFILES keys in commit 1."
}

^["development"]{
 lane: #execution_truth
 ladder: #service
 develops: [#taste, #linguistics, #governance]
 review_surfaces: [@plan, @census, @alignment, @surface_identity, @conventions_index, @dialect]
}

^["concept_index"]{
 primary: [
  #profile_family,
  #language_feature_noun,
  #constant_ladder,
  #convention_coverage,
  #co_development_rule,
  #head_noun_ban,
 ]
 secondary: [
  #dialect_vs_mutation_vs_format,
  #effect_l_public,
  #derived_kind_vocab,
  #cli_mode_not_profile,
 ]
 surfaces: [#conventions, #patterns, #registries, #cli_help, #plans]
 tensions: [
  #docs_first_vs_code_rename,
  #over_qualify_internals,
  #alignment_as_second_cache,
 ]
 transfers: [#language, #governance, #service]
}

^["profile_families"]{
 #:naming #!hygiene
 dialect: "Spw.b l m x o q t — geometry of authoring; @profile on seeds"
 format: "pretty layout prose canonical wide equiv — spw format"
 mutation: "layout_canonical measure_only equiv_scripts — pulse/mutate"
 emit: "pe_style_lock fractal_* line_propagate — emit fractal"
 form_geometry: "FORM_GEOMETRY FORM_LADDER — pulse form paths"
 review: "historical agent_surface canon_surface — commit review"
 lens: "harness memory-surface lens_profile"
 ~#rule: "public help always qualifies: mutation profile X, not the profile"
}

^["constants_ladders"]{
 public_effect: #[#effect.l0.measure, #effect.l1.memory, #effect.l2.workspace, #effect.l3.external]
 historical: #[#S0, #S1, #S2, #E0, #E1, #E2]
 non_ladder: #[#orchestrator]
 identity: #[#content_hash, #shape_fingerprint, #granule_key]
}

^["convention_gaps"]{
 indexed: #[#selection, #naming, #cli, #submodule, #packaging]
 live_unindexed: #[#file_physics, #hash_resonance, #styles]
 cross_link: #[#hot]
}

^["co_development"]{
 loop: [
  "? does this public name share a head noun with another family?",
  "< add alignment row + owner",
  "$ update convention or registry in same series",
  "^ cross-link older plan if it used the bare noun",
  "% dialect markers and effect.l* stay stable",
 ]
}

^["parallel_work"]{
 critical_path: [#census, #alignment_pattern, #convention_index, #profile_help_qualify]
 parallelizable: [#constants_map, #plan_cross_links]
 shared_hot_files: [
  ".spw/conventions/index.spw",
  ".spw/conventions/cli.spw",
  ".spw/patterns/index.spw",
  "packages/spw-cli/src/format.ts",
  "packages/spw-cli/src/pulse.ts",
 ]
 merge_risks: [#cli_mode_rename_wave]
 handoff_artifacts: [@plan, @artifact, @census, @alignment]
}

^["supporting_documents"]{
 must_ship: [@plan, @artifact, @census]
 helpful: [@surface_identity, @dialect, @hot, @cli_mode_plan]
 carries: [#census, #family_table, #deprecation_map]
 produces: [
  ~".spw/patterns/naming-alignment.spw",
 ]
}

^["risk_model"]{
 hard_failures: [#mutation_profile_rename_breaks_fixtures, #dialect_marker_churn]
 soft_failures: [#alignment_map_stale, #over_qualify_private_code]
 non_negotiables: [
  #hash_reserved_content_identity,
  #dialect_not_mutation_profile,
  #mode_not_profile,
 ]
}

^["validation"]{
 hypotheses: [
  "four or more profile families under bare profile in corpus",
  "conventions index misses file-physics hash-resonance styles",
  "after help pass, format and pulse help qualify profile family",
 ]
 negative_controls: [
  "Spw.b l m x markers unchanged",
  "mutation rule behavior unchanged without explicit alias commit",
  "lint:spw green on touched surfaces",
 ]
}

^["stream"]{
 >>[2026-07-27 16:49] observe — User: language feature naming, profile hygiene, constants/conventions audit for consistency; older designs must align and develop alongside new ones.
 >>[2026-07-27 16:49] observe — Profile families found: dialect @profile Spw.*, format profiles, MUTATION_PROFILES, FRACTAL_PROFILES / sagas profiles, form-geometry profiles in pulse, syntax-review profiles in agent harness, lens_profile in harness. All share head noun profile.
 >>[2026-07-27 16:49] observe — conventions/index omits file-physics, hash-resonance, styles though files exist. cli.spw public_commands already stale vs COMMANDS. naming.spw still says public command names stay stable — tensions with cli-mode free-rename; alignment must state when stability applies (dialect/effect) vs when free (unused CLI verbs).
 >>[2026-07-27 16:49] decide — Plan naming-profile-convention-align. Docs/help qualify profiles first; code renames optional later. Co-development rule: public names update alignment map in same series. surface-identity method generalizes to all head-noun families.
 >>[2026-07-27 16:50] decide — CLI mode is not a profile family; register as mode under language/CLI features. Constants: public effect.l* only.
 >>[2026-07-27 16:50] taste — Prefer qualified phrases in help over renaming every TypeScript symbol in one PR.
}

^["open"]{
 ?[code_rename_depth]: "Stop at help/docs qualification, or also FormatProfileId → keep id strings but rename exported type docs?"
 ?[naming_stability_vs_cli_rename]: "How to amend naming.spw invariant public command names stay stable given cli-mode free-rename?"
 ?[taste_gate]: "Wire forbidden bare-profile in public help as automated check, or checklist only?"
 ?[hot_location]: "Cross-link hot.spw from conventions index, or move a cli-effect convention under conventions/?"
}

^["commits"]{
 ~[1]: ".[plans] — file naming-profile-convention-align with naming census"
 ~[2]: ".[spw] — naming-alignment pattern: families, head-noun bans, co-development rule"
 ~[3]: "![spw] — freeze census: profiles, features, constants, convention gaps"
 ~[4]: "vocab[conventions] — index missing conventions; refresh naming + cli"
 ~[5]: "vocab[profile] — qualify profile families in help and public docs"
 ~[6]: "vocab[constants] — public effect.l* only; historical grade map"
 ~[7]: "vocab[identity] — cross-link surface-identity, modes, derived kinds"
 ~[8]: "![hygiene] — alignment checklist gate for new public names"
 ~[9]: ".[plans] — point related plans at alignment map"
 ~[10]: "![docs] — co-read smoke dialect, hot, naming, pulse-mutate-beat"
}

^["cache"]{
 ~#status: "planning"
 ~#base_ref: "main@0c7cdfb7"
 ~#rebased_at: ""
 ~#hygiene_split: "none for vocab-first; coordinate with cli-mode-overhaul rename wave"
