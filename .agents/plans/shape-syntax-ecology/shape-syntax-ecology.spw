// Shape - Syntax - Ecology
//
// Distilled lattice for human review and safe LLM play (IDE + screenshot).
// Optimistic anatomy: future runtime/plugin hooks as referenceable structure.
//
// @see .agents/plans/shape-syntax-ecology/PLAN.md
// @see packages/spw-seed/src/dialect/index.ts

#:layer #!pragmatics
#:status #!proposed
@dialect:Spw.p

^seed[Spw.Plan.ShapeSyntax.Ecology v:0.2 @profile:Spw.p @intent:ecology_map]

^["roots"]{
 @plan: ~".agents/plans/shape-syntax-ecology/PLAN.md"
 @wip: ~".agents/plans/shape-syntax-ecology/wip.spw"
 @syntax: ~".agents/plans/syntax-profile-stack/PLAN.md"
 @syntax_art: ~".agents/plans/syntax-profile-stack/syntax-profile-stack.spw"
 @curiosity: ~".agents/plans/curiosity-mutation-ergonomics/curiosity-mutation-ergonomics.spw"
 @refactor: ~".agents/plans/refactor-experiment-lifecycle/refactor-experiment-lifecycle.spw"
 @measure: ~".agents/plans/measure-invariant-generalization/measure-invariant-generalization.spw"
 @form: ~".agents/plans/form-geometry-editor/form-geometry-editor.spw"
 @flow: ~"docs/theory/spw/mutation-flow-automata.spw"
 @stack: ~"docs/theory/spw/syntax-profile-stack.spw"
 @dialect_reg: ~".spw/registries/dialect-spec.spw"
 @profile_reg: ~".spw/registries/syntax-profile-stack.spw"
 @bridge: ~"packages/spw-runtime/src/state/liminality-bridge.ts"
 @derived: ~"packages/spw-seed/src/derived-surface.ts"
 @roadmap: ~".agents/plans/vscode-lsp-roadmap/PLAN.md"
 @nvim: ~".agents/plans/neovim-spw-surfaces/PLAN.md"
 @authoring: ~".agents/plans/vscode-authoring-probe-loop/vscode-authoring-probe-loop.spw"
 @cognitive: ~".agents/plans/vscode-cognitive-surface/vscode-cognitive-surface.spw"
}

^["thesis"]{
 ~#claim: "Plans spark expertise when they name referenceable syntax, dual liminality, intermediate sigma-forms, and imagination plays under status discipline."
 ~#taste: "presence - practical use - glyph-first - imagination under evidence grades"
 ~#non_goal: "Metaphor as runtime; vision without AST; silent multi-file write; axis collapse."
 ~#value: "human judgment first; LLM via IDE/screenshot is fold-in, not authority"
}

// ── Anatomy (optimistic chambers for future tools) ───────────

^["anatomy"]{
 // brace material: each chamber is inspectable; payload = tool hooks
 . {
  seed: .{
   ports: #[parse, dialect, catalog, semantic_edit, form_geometry]
   payload: #[autoDialect, resolveSurfaceProfile, SourceEdit]
   =exp[ id: seed.dialect_stack , status: partial ]
  }
  runtime: .{
   ports: #[interpret, consolidate, beat, liminality_bridge, precipitate]
   payload: #[RegisterBank, memory_cache, effect.l1.memory]
   law: "surface liminal shapes != register LIMINALITY_ORDER"
   =exp[ id: runtime.bridge_only , status: implemented ]
  }
  lsp: .{
   ports: #[hover, codeAction, diagnostic, formContext, workspaceEdit]
   payload: #[stack_chip, exp_refs, mass_verdict, mobility_receipt]
   =exp[ id: lsp.stack_hover , status: proposed ]
  }
  cli: .{
   ports: #[profile_show, mass, pulse, explore, refactor, expand]
   payload: #[envelope, plan.json, receipt]
   =exp[ id: cli.profile_show , status: proposed ]
  }
  editor: .{
   ports: #[strip, lens, tree, statusline, screenshot_encode]
   clients: #[vscode, neovim, intellij]
   payload: #[semantic_tokens, dual_read_policy]
   =exp[ id: editor.gestalt_tokens , status: proposed ]
  }
  gen: .{
   ports: #[experiments, worktree, expanded, precipitated]
   payload: #[plan.id, contentHash, derived_kind]
   skip_index: #[expanded]
   =exp[ id: gen.experiments , status: proposed ]
  }
 }
}

// ── Ecology graph (path refs = referential spine) ────────────

^["ecology"]{
 #[]{
  ~".agents/plans/syntax-profile-stack/PLAN.md"
  ~".agents/plans/curiosity-mutation-ergonomics/PLAN.md"
  ~".agents/plans/refactor-experiment-lifecycle/PLAN.md"
  ~".agents/plans/measure-invariant-generalization/PLAN.md"
  ~".agents/plans/form-geometry-editor/PLAN.md"
  ~".agents/plans/vscode-lsp-roadmap/PLAN.md"
  ~".agents/plans/neovim-spw-surfaces/PLAN.md"
  ~".agents/plans/vscode-authoring-probe-loop/PLAN.md"
  ~".agents/plans/vscode-cognitive-surface/PLAN.md"
 }
 theory: #[
  ~"docs/theory/spw/mutation-flow-automata.spw"
  ~"docs/theory/spw/syntax-profile-stack.spw"
  ~"docs/theory/spw/form-geometry.spw"
  ~"docs/theory/spw/valence-architecture.spw"
  ~"docs/runtime/md/pulse-mutate-beat.md"
 ]
}

// ── Syntax depth: dialects as product surfaces ───────────────

^["dialect_curriculum"]{
 order: "<< Spw.b ; Spw.p ; Spw.q ; Spw.l ; Spw.m ; Spw.f ; Spw.x ; Spw.t >>"
 . {
  Spw.b: .{ ethos: "canon literacy" , geometry: block , hot: #no }
  Spw.p: .{ ethos: "episodic memory" , geometry: stream , hot: #agent }
  Spw.q: .{ ethos: "address" , geometry: pattern , preprocess: newlineAsSpace }
  Spw.l: .{ ethos: "compact search" , geometry: line , preprocess: newlineAsSpace }
  Spw.m: .{ ethos: "machine honesty" , geometry: skeleton , lint: machine }
  Spw.f: .{ ethos: "flow lab" , geometry: sigma_phi , ceiling: l0 }
  Spw.x: .{ ethos: "live organelle" , geometry: block , hot: #yes , measure_first: #yes }
  Spw.t: .{ ethos: "template mold" , geometry: holes , derived: #yes }
 }
}

// ── Intermediate sigma (shared mutation + refactor grammar) ──────

^["sigma"]{
 pipeline: "<< ~ ; ? ; % ; ! ; * ; ^ >>"
 . {
  ~ : .{ role: soft_plan , effect: l0 }
  ? : .{ role: branch_sel , effect: l0 }
  % : .{ role: inspect , effect: l0 , never_write: #yes }
  ! : .{ role: fire , charge: #[boon, bane, bone, bonk, honk] }
  * : .{ role: materialize , effect: #[l1_memory, l1_worktree] }
  ^ : .{ role: seal , names: #[step, receipt, fixed_point] }
 }
 use: #[mutation, refactor_intermediate, precipitation_story, curiosity_explore]
 =exp[ id: flow.sigma_chain , status: proposed , runtimeHook: lower ]
}

// ── Reference catalog (optimistic; greppable ids) ────────────

^["reference"]{
 landed: #[
  dialect.detect
  parse.autoDialect
  resolveSurfaceProfile
  machine_lint
  derived.expanded
  liminality.bridge
 ]
 proposed: #[
  syntax_catalog
  exp_hover
  phi_lower
  worktree_apply
  spw_profile_cli
  gestalt_token_contract
  dual_read_screenshot
  cache_key_dialect_preprocess
 ]
 . {
  catalog_path: ~"packages/spw-seed/src/experimental/syntax-catalog.ts"
  law: "reference != execute; proposed => runtimeHook none|lint|lower"
 }
}

// ── Practical use matrix ─────────────────────────────────────

^["use"]{
 refactor: .{ plan: @refactor , select: Spw.q , machine: Spw.m , intermediate: @sigma }
 measure: .{ plan: @measure , stage: % , schemes: #[exact, band, tol, profile, prior] }
 curiosity: .{ plan: @curiosity , dialect: Spw.f , explore_ceiling: l0 }
 form: .{ plan: @form , material: brace_ports , liminal: dual_axis }
 memory: .{ plan_stream: Spw.p , beat: Spw.x , gen: experiments , derived: expanded }
 selectors: .{ dialect: Spw.q , engine: semantic_edit }
 expand: .{ dialect: Spw.t , kind: expanded , skip_index: #yes }
 reduce: .{ dialect: Spw.m , views: #[ONF, shape_fingerprint, brace_projection] }
 tests: .{ seed: #[dialect, parse-dialect, self-mass] , next: #[catalog, plan_hash] }
 learning: .{ curriculum: @dialect_curriculum , profiles: reading }
}

// ── Plugin / runtime synergies (optimistic) ──────────────────

^["synergy"]{
 vscode: .{
  @plan: ~".agents/plans/vscode-lsp-roadmap/PLAN.md"
  hooks: #[hover_stack, mass_diag, formContext, plan_strip, exp_lens]
 }
 neovim: .{
  @plan: ~".agents/plans/neovim-spw-surfaces/PLAN.md"
  hooks: #[SpwProfile, statusline_dialect, code_action, quickfix]
 }
 runtime: .{
  hooks: #[beat_ttl, precipitate_policy, bridge_explicit, cache_tiers]
  @cache: ~"packages/spw-runtime/src/state/memory-cache.ts"
 }
 cli: .{
  hooks: #[profile_show, exp_list, explore, refactor_plan, mass]
 }
}

// ── Imagination contract ─────────────────────────────────────

^["imagination"]{
 ide: "<< dialect_hover ; plan_only_pulse ; probe_at_bang ; form_ports >>"
 shot: "<< brace_gestalt ; dual_read_AST ; refuse_vision_only_edit >>"
 learn: "<< Spw.b ; Spw.p ; Spw.q ; Spw.m ; Spw.f ; Spw.x ; Spw.t >>"
 human: "plans deepen judgment"
 llm: "fold-in via IDE or screenshot - never sole authority"
}

^["falsify"]{
 #[
  "exp catalog implies execute"
  "screenshot edit without plan/AST"
  "surface liminality = register liminality"
  "l/q preprocess missing from cache key"
  "Spw.b default silently becomes Spw.x write"
  "phoneme gloss sold as ONF"
 ]
}

