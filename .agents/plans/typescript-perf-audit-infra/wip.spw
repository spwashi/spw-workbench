#>wonder_typescript_perf_audit_infra_cold_warm
?["Does a cold-process typecheck row differ from a warm back-to-back one by more than the roughly 2 percent seen between warm runs?"]{
  #:depth #!computational // lens: measurement noise
  ~#hypothesis: "the first run after the machine has been idle is slower than the warm 6.2 s by more than the warm spread, so a single-run row needs a warm-up or a run count"
  !probe{ "after the machine has been idle, time npx tsc -p tsconfig.typecheck.json --noEmit once, then twice more back to back; compare the first to the mean of the next two" }
  $%[plan.commit_count, plan.phase_progress]
}
