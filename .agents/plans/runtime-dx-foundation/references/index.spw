# references — runtime-dx-foundation

#:layer #!reference

^["source_index"]{
 @lsp_317: "https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/"
 @vscode_lsp_guide: "https://code.visualstudio.com/api/language-extensions/language-server-extension-guide"
 @vscode_programmatic: "https://code.visualstudio.com/api/language-extensions/programmatic-language-features"
 @vscode_status_bar: "https://code.visualstudio.com/api/ux-guidelines/status-bar"
 @vscode_commands: "https://code.visualstudio.com/api/extension-guides/command"
}

^["signature"]{
 ~#profile: "support compression"
 ~#recognition: "every external protocol or editor surface should shorten the path from failure to next action"
}

^["topic_anchors"]{
 diagnostic_transport: [@lsp_317, @vscode_lsp_guide, #diagnostic_payload, #request_failure, #latency, #structured_error]
 editor_feedback: [@vscode_programmatic, @vscode_status_bar, #status_bar, #output_channel, #quiet_feedback, #visibility]
 command_recovery: [@vscode_commands, #doctor, #command_surface, #troubleshooting, #next_action]
}

^["operational_density"]{
 checks: [#greppable_code, #next_action, #calm_feedback, #station_alignment]
 drift_risks: [#debug_residue, #copy_drift, #noisy_status, #protocol_blur]
 release_implications: [#doctor_output, #health_check_copy, #support_glossary]
}

#>wonder_agents_plans_runtimedxfoundation_references_1
?["Which external contract most sharply constrains station language?"]{
  #:depth #!computational // lens: support surface
  &[@lsp_317, @vscode_programmatic, @vscode_status_bar] => $[#diagnostic_payload, #status_bar, #next_action]
  !probe{ "ask where the same failure wording must survive transport, status UI, and command output without mutation." }
  ~<.agents/plans/runtime-dx-foundation/wip.spw>
}

#>wonder_agents_plans_runtimedxfoundation_references_2
?["When does a helpful diagnostic become noise?"]{
  #:depth #!educational // lens: calm density
  $^["topic_anchors"]@here => $^["operational_density"]@here
  !probe{ "name the point where extra status or output text stops improving the next action." }
  ~<.agents/plans/runtime-dx-foundation/runtime-dx-foundation.spw>
}
