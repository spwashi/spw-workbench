#:layer #!pragmatics

^["intent"]{
  ~#goal: "Lay a DX foundation across runtime + editor integrations with structured diagnostics, instrumentation hooks, and clear troubleshooting paths."
  ~#taste: "clarity + correctness"
}

^["stream"]{
  # Append entries chronologically. Never edit prior entries.
  # >>[YYYY-MM-DD HH:MM] <type> — <content>
  >>[2026-02-23 11:15] observe — DX roadmap request includes plugin development, LSP/worker flow, and runtime instrumentation.
  >>[2026-02-23 11:18] decide — Start with a foundation plan: diagnostics contracts, instrumentation hooks, and editor UX affordances.
  # Types: observe, decide, surprise, revise, blocked, taste, rebase, hygiene
}

^["open"]{
  # Unresolved questions. Remove when resolved (log resolution in stream first).
  ?[dx-scope]: "Which runtime surfaces are highest priority for diagnostic IDs: parser, interpreter, worker bridge, or LSP server?"
}

^["commits"]{
  # Planned commits in order. Use project sigil conventions.
  # ~[N]: "sigil[scope] — description"
  ~[1]: "#[dx-runtime] — define DX instrumentation contract + diagnostic identifiers"
  ~[2]: "&[runtime] — wire structured diagnostics + logging hooks through runtime/infra"
  ~[3]: "&[lsp] — propagate diagnostics + performance telemetry via workers/LSP server"
  ~[4]: "&[editors] — refine plugin settings UX + add troubleshooting affordances"
  ~[5]: ".[docs] — add DX playbook, onboarding checkpoints, and instrumentation guide"
}

^["cache"]{
  ~#status: "planning"
  ~#base_ref: "main@591a86c631671ddced9716eb8f32380af0db8a0b"
  ~#rebased_at: "n/a (origin/main unavailable)"
  ~#hygiene_split: "unrelated local changes in package.json and spw-syntax-audit.sh; keep out of DX commits"
