# wip — runtime-dx-foundation
# Branch: feature/runtime-dx-foundation
# Started: 2026-02-23

#:layer #!pragmatics

^["roots"]{
 @cluster: ~".agents/plans/plan-ecology-clustering/plan-ecology-clustering.spw"
 @artifact: ~".agents/plans/runtime-dx-foundation/runtime-dx-foundation.spw"
 @references: ~".agents/plans/runtime-dx-foundation/references/index.spw"
 @governance: ~".agents/plans/ecosystem-surface-governance/ecosystem-surface-governance.spw"
 @runtime_foundation: ~"docs/runtime/spw/runtime-foundation.spw"
 @tooling: ~".spw/tooling/vscode-spw.spw"
 @hot_reload: ~".spw/process/hot-reload-loop.spw"
}

^["intent"]{
 ~#goal: "Lay a DX foundation across seed, runtime, LSP, CLI, and editor surfaces with one coherent diagnostic station model."
 ~#taste: "clarity, correctness, supportability"
}

^["development"]{
 lane: #execution_truth
 ladder: #service
 develops: [#diagnostic_language, #failure_locality, #install_truth, #support_judgment]
 review_surfaces: [@cluster, @artifact, @references, @governance, @runtime_foundation, @tooling, @hot_reload]
 snippet_routes: [#doctor_output, #station_code, #status_copy, #health_check, #troubleshooting_path]
}

^["concept_index"]{
 primary: [#diagnostics, #stations, #seed, #runtime, #lsp, #cli, #editor, #install]
 surfaces: [#parser, #runtime, #server, #terminal, #status_bar, #docs]
 tensions: [#signal_to_noise, #opt_in_telemetry, #claim_discipline, #cross_surface_drift]
 transfers: [#service, #release, #support]
}

^["recursive_improvement"]{
 loop: [
  "? reread station language across runtime, install, governance, and tooling surfaces",
  "< ship one user-visible diagnostic artifact per slice",
  "$ record what failure became searchable, localizable, or supportable",
  "^ propagate the winning vocabulary into CLI, editor, docs, and release literature",
  "% keep diagnostics cheaper than the confusion they remove",
 ]
 gates: [#greppable_code, #next_action, #support_truth, #cross_surface_alignment]
}

^["parallel_work"]{
 critical_path: [#station_model, #diagnostic_codes]
 parallelizable: [#seed, #runtime, #lsp, #cli, #editor, #docs]
 shared_hot_files: ["packages/spw-seed/src/parser.ts", "packages/spw-lsp/src/context.ts", "packages/spw-cli/src/main.ts", "extensions/vscode-spw/src/extension.ts"]
 merge_risks: [#station_drift, #copy_drift, #shared_hot_files]
 handoff_artifacts: [@artifact, @references, @governance, @runtime_foundation]
}

^["supporting_documents"]{
 must_ship: [@artifact, @governance, @runtime_foundation]
 helpful: [@tooling, @hot_reload, @references]
 carries: [#health_check_examples, #station_glossary, #support_flow, #troubleshooting_matrix, #source_map]
}

^["interaction_depth"]{
 subjects: [#failure_locality, #next_action, #verbosity, #visibility, #discoverability, #trust]
 questions: [#what_failed, #what_worked, #what_should_user_do_next]
 qualities: [#clarity, #actionability, #calm_feedback]
}

^["stream"]{
 # Append entries chronologically. Never edit prior entries.
 # >>[YYYY-MM-DD HH:MM] <type> — <content>
 # Types: observe, decide, surprise, revise, blocked, taste, rebase, hygiene, implement, verify, note
 >>[2026-02-23 11:15] observe — DX roadmap request includes plugin development, LSP/worker flow, and runtime instrumentation.
 >>[2026-02-23 11:18] decide — Start with a foundation plan: diagnostics contracts, instrumentation hooks, and editor UX affordances.
 >>[2026-03-27 00:55] observe — codebase restructured into packages/ since plan was filed. LSP in packages/spw-lsp/src/, seed in packages/spw-seed/src/, runtime in packages/spw-runtime/src/. Lore-era baseline no longer reachable.
 >>[2026-03-27 00:56] revise — rebase target updated to main@3b1747c4. File paths updated to packages/ layout. Expanded from 5 to 20 commits to create surface area for each DX station.
 >>[2026-03-27 00:57] decide — resolve dx-scope: priority order is seed diagnostics, LSP server, CLI troubleshooting, then deeper runtime instrumentation.
 >>[2026-03-27 00:58] decide — consumer repositories need a diagnostic mode that answers: is .spw installed correctly, can the parser load, can the LSP start, does the extension connect, and which station failed?
 >>[2026-03-27 00:59] taste — each commit should produce a concrete artifact an external developer can encounter: a code, a status item, a CLI flag, or a docs snippet.
 >>[2026-03-27 13:18] revise — reposition this branch as the DX contract lane inside the broader ecology. Commit 1 serializes station names so seed, LSP, CLI, and editor work can proceed in parallel without inventing separate vocabularies.
 >>[2026-03-27 13:19] taste — ecological invigoration here means a consumer repository encounters one station model across install, editor, CLI, and docs rather than four troubleshooting dialects.
 >>[2026-03-27 14:26] implement — rewrote the branch memory around roots, concept indexing, and recursive improvement; added an artifact surface so station language can be reviewed as Spw, not just as markdown prose.
 >>[2026-03-27 14:27] note — recursive improvement for DX should be measured by support compression: fewer words needed to tell a new user what failed, why, and what to do next.
 >>[2026-03-28 09:47] rebase — refreshed baseline to main@b41caa6b and added references/index.spw so LSP payload, VS Code language-extension, status-bar, and command-surface contracts can discipline station language.
 >>[2026-03-28 16:51] revise — runtime-telemetry-canon moved to archive as a landed precedent, and the current runtime hot surface remains packages/spw-runtime/src/pipeline/ rather than a diagnostics directory that does not exist yet.
}

^["open"]{
 ?[station_count]: "Do we want publish/release as a first-class station, or should release remain a downstream literature surface that quotes the same codes?"
 ?[doctor_depth]: "How much environment probing belongs in `spw doctor` before the command becomes noisy or brittle?"
}

^["commits"]{
 ~[1]: "#[dx-diagnostics] — define diagnostic ID registry and station attribution contract (SPW-SEED-*, SPW-RT-*, SPW-LSP-*, SPW-CLI-*, SPW-VSCODE-*)"
 ~[2]: "&[seed] — add parse timing hooks to spw-seed parser entry points"
 ~[3]: "&[seed] — add structured error codes to lexer and grammar failures"
 ~[4]: "![seed] — verify diagnostic codes appear in parse error output for malformed .spw files"
 ~[5]: "&[runtime] — wire diagnostic station hooks through pipeline and substrate"
 ~[6]: "&[runtime] — add resonance cycle instrumentation with opt-in timing"
 ~[7]: "![runtime] — verify diagnostic propagation through substrate event chain"
 ~[8]: "&[lsp] — propagate structured diagnostics from seed/runtime to LSP responses"
 ~[9]: "&[lsp] — add performance telemetry to LSP context (parse duration, response latency)"
 ~[10]: "![lsp] — smoke test: LSP diagnostic payloads carry station codes and timing"
 ~[11]: "&[cli] — add `spw doctor` subcommand for installation health check"
 ~[12]: "&[cli] — add `--diagnostics` flag to existing commands for verbose station output"
 ~[13]: "![cli] — verify `spw doctor` reports parser loaded, LSP reachable, and extension-connectable conditions"
 ~[14]: "&[vscode] — add Spw output channel with structured diagnostic log"
 ~[15]: "&[vscode] — add status bar indicator for LSP connection health and parse performance"
 ~[16]: "&[vscode] — add settings validation with actionable error messages"
 ~[17]: "![vscode] — verify output channel shows station-attributed diagnostics during editing"
 ~[18]: ".[docs] — write DX playbook: installation, health check, and troubleshooting flow"
 ~[19]: ".[docs] — write instrumentation guide: how to read station codes and where each station lives"
 ~[20]: ".[plans] — formalize the station model in runtime-dx-foundation.spw"
}

^["cache"]{
 ~#status: "planning"
 ~#base_ref: "main@b41caa6b"
 ~#rebased_at: "2026-03-28"
 ~#hygiene_split: "none; prior drift landed on main"
 ~#files_hot: "packages/spw-runtime/src/pipeline/, packages/spw-seed/src/parser.ts, packages/spw-lsp/src/context.ts, packages/spw-cli/src/main.ts, extensions/vscode-spw/src/extension.ts, .agents/plans/runtime-dx-foundation/, .agents/plans/runtime-dx-foundation/references/"
