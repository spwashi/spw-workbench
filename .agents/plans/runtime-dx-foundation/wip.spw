 ~[station_registry]: "#[dx-diagnostics] — station registry: station ids (seed, runtime, lsp, cli, vscode) and the SPW-<STATION>-<NNN> shape, with doctor's check ids as the first entries"
 ~[seed_rule_codes]: "&[seed] — a stable code per grammar rule on parse errors (ParseEvent carries rule and position today, no code)"
 ~[seed_code_fixtures]: "![seed] — malformed .spw fixtures show the code in parse error output"
 ~[lsp_diagnostic_code]: "&[lsp] — set Diagnostic.code and a next-action message from the station code in handlers/analysis.ts (it emits source 'spw' and the message '<rule>: parse error' today)"
 ~[doctor_lsp_check]: "&[cli] — spw doctor gains a check for LSP launch, with a case in doctor.test.ts (doctor.test.ts has no LSP case today)"
 ~[vscode_output_channel]: "&[vscode] — Spw output channel carrying station-attributed diagnostics (no output channel exists; the only status item is the context strip)"
}

