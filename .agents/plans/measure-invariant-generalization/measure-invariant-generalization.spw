# Measure · Invariant · Authority — generalization lattice
#
# Distilled design surface for measure-invariant-generalization.
# Status discipline: implemented | interpretive | proposed | measured.

#:layer #!semantics
#:status #!proposed
@dialect:Spw.b

^seed[Spw.Plan.Measure.Invariant v:0.2 @profile:Spw.b @intent:sample_under_scheme]

^["roots"]{
 @plan: ~".agents/plans/measure-invariant-generalization/PLAN.md"
 @wip: ~".agents/plans/measure-invariant-generalization/wip.spw"
 @ecology: ~".agents/plans/shape-syntax-ecology/shape-syntax-ecology.spw"
 @mass_impl: ~"packages/spw-seed/src/canonical/self-mass.ts"
 @authority_impl: ~"packages/spw-seed/src/canonical/authority.ts"
 @operators: ~"docs/theory/spw/operators.spw"
 @atlas: ~"docs/theory/spw/operator-atlas.spw"
 @claims: ~".spw/harness/claim-protocol.spw"
 @bridge: ~"lib/spw-v0.3.0/architecture/theory-bridge.spw"
 @file_physics: ~".spw/conventions/file-physics.spw"
 @flow: ~"docs/theory/spw/mutation-flow-automata.spw"
 @sigma_stage: %
}

^["thesis"]{
 ~#claim: "A surface earns trust when it declares measurements under a named evaluation scheme and survives declare → observe → reconcile without silent agreement."
 ~#taste: "exact where identity matters; fuzzy where living corpora breathe; metaphor never outranks status."
 ~#non_goal: "One universal operator physics. One host contract. One precision mood for all tests."
}

^["products_of_percent"]{
 # Same sigil, distinct products — do not collapse without a dialect.
 register_measure: .{
  status: #implemented
  site: "runtime interpreter %"
  meaning: "sample a register (optional scale)"
  shape: "scalar affinity; atlas may read ∈[0,1]"
 }
 declared_mass: .{
  status: #implemented
  site: "surface %mass + spw mass"
  meaning: "claim about a subject file's lines/bytes"
  shape: "integer counts; exact equality default"
 }
 generalized_measure: .{
  status: #proposed
  site: "%measure / scheme-bearing mass body"
  meaning: "claim about any host-supplied metric under EvalScheme"
  shape: "number + scheme → verdict"
 }
}

^["eval_scheme"]{
 exact: .{ status: #proposed, use: "identity invariants; --write allowed on drift" }
 band: .{ status: #proposed, use: "lo..hi inclusive budgets" }
 tol: .{ status: #proposed, use: "abs and/or rel nearness" }
 profile: .{ status: #proposed, use: "named precision table (host or .spw/tuning)" }
 prior: .{ status: #proposed, use: "corpus baseline / z; consumes geometry plan, does not own it" }
 honesty: #[
  "unknown scheme → scheme_mismatch",
  "unknown key → unmeasurable",
  "never silent pass",
 ]
}

^["loop"]{
 declare: "surface names @self and measure keys (+ scheme)"
 observe: "host measures subject (fs, AST, text, convention scan)"
 reconcile: "pure seed function → verdicts"
 apply: "only exact+drift may rewrite digits in place"
 sigma: << ~ ; ? ; % ; ! ; * ; ^ >>
 // % is the evaluation stage of the shared intermediate grammar
}

^["anatomy"]{
 . {
  declare: .{ @self: PathRef , mass: "%mass|{scheme}" }
  observe: .{ host: #[fs, ast, text, convention] }
  reconcile: .{ pure: #yes , seed: @mass_impl }
  apply: .{ write: exact_drift_only , effect: l2 }
  diagnostics: .{ codes: #[spw.mass.drift, spw.mass.undeclared, spw.mass.scheme_mismatch, spw.authority.leak] }
  =exp[ id: measure.eval_scheme , status: proposed , runtimeHook: lower ]
  =exp[ id: measure.lsp_diag , status: proposed , runtimeHook: lint ]
 }
}

^["authority_layers"]{
 claim_grammar: .{ status: #implemented, note: "!writes &joins !reads streams; portable parse" }
 observation: .{ status: #implemented, note: "ObservedAuthority { kind, name, sites }" }
 extractors: .{
  status: #proposed
  js: "existing CLI extract"
  text: "convention / plain-text observations"
  rule: "new hosts add extractors; no new OperatorKinds required"
 }
}

^["operator_ledger"]{
 # interpretive metaphors — not runtime law
 ? : .{ intent: "evaluation", interpretive: "wonder", metaphor: "vacuum", status: #interpretive }
 ! : .{ intent: "performance", interpretive: "action", metaphor: "catalyst", status: #interpretive }
 @ : .{ intent: "bind scope", interpretive: "perspective", metaphor: "standpoint", status: #interpretive }
 # : .{ intent: "extrinsic", interpretive: "resonance/set", metaphor: "category tag", status: #interpretive }
 . : .{ intent: "ground/access", interpretive: "ground", metaphor: "intrinsic reduction", status: #interpretive }
 _ : .{ intent: "intrinsic hole", interpretive: "ONF hole", metaphor: "open site", status: #proposed }
 & : .{ intent: "subject placeholder", interpretive: "confluence", metaphor: "material", status: #interpretive }
 ^ : .{ intent: "frame stance", interpretive: "integration", metaphor: "posture", status: #interpretive }
 ~ : .{ intent: "defer field", interpretive: "potential", metaphor: "field", status: #interpretive }
 * : .{ intent: "collapse", interpretive: "value", metaphor: "crystallization", status: #interpretive }
 % : .{ intent: "measure", interpretive: "measure", metaphor: "sample under scheme", status: #interpretive }
 alnum: .{ intent: "formula vs entropy", interpretive: "named recipes", status: #proposed }
 access_from_name: .{
  example: "spwashi.%"
  meaning: "overload operator behavior from a named perspective"
  status: #proposed
 }
}

^["audiences"]{
 author_sharp: .{
  value: "exact mass + authority leaks keep craft honest"
  measure: "drift rate on edited subjects"
 }
 prompt_fold: .{
  value: "structural budgets on intricate LLM surfaces"
  measure: "op_density, depth, path_refs under tol/band"
 }
 research_probe: .{
  value: "reproducible fuzzy invariants + claim chain"
  measure: "scheme-backed falsify thresholds"
 }
 creative: .{
  value: "file-physics thrift without CI cruelty"
  measure: "soft_miss as invitation, not shame"
 }
 clone_experience: .{
  value: "bundled .spw + plugins speak on first open"
  measure: "time-to-first-diagnostic; no host monorepo required"
  plugins: #[vscode, intellij, neovim]
 }
 editor_projection: .{
  status: #proposed
  owner: "spw-lsp measure-diagnostics"
  codes: #[spw.mass.drift, spw.mass.undeclared, spw.mass.scheme_mismatch, spw.authority.leak]
  write: "exact+drift only"
  vscode: ~"../../.agents/plans/vscode-authoring-probe-loop/PLAN.md"
  neovim: ~"../../.agents/plans/neovim-spw-surfaces/PLAN.md"
  roadmap: ~"../../.agents/plans/vscode-lsp-roadmap/PLAN.md"
 }
}

^["generalizability"]{
 must: #[
  "seed portable (no fs, no host AST)",
  "status discipline on every advertised op",
  "honest verdicts",
  "@self multi-subject grouping",
  "extractor plug points over glyph churn",
 ]
 must_not: #[
  "bake vacuum/catalyst into lexer defaults",
  "unify register-% and mass without dialect",
  "global exact-only or global fuzzy-only mood",
 ]
}

^["invariants"]{
 "Default scheme for %mass is exact — existing surfaces keep meaning.",
 "--write is effect.l2 and exact+drift only.",
 "Interpretive metaphors require status tags in any user-facing hover.",
 "Corpus priors are consumed, not reimplemented, when geometry baselines exist.",
}

^["synergy"]{
 @ecology: ~".agents/plans/shape-syntax-ecology/shape-syntax-ecology.spw"
 curiosity_stabilize: ~".agents/plans/curiosity-mutation-ergonomics/curiosity-mutation-ergonomics.spw"
 refactor_verify: ~".agents/plans/refactor-experiment-lifecycle/refactor-experiment-lifecycle.spw"
 lsp: #[vscode, neovim]
}

^["imagination"]{
 ide: "spw mass dry; intentional drift; scheme write refuse"
 shot: "%mass + @self pair; claim vs subject"
 learn: "exact vs band as precision mood"
 falsify: "register-% = surface mass"
}

^["open"]{
 ?[facet]: "single scheme-bearing % body vs %measure/%invariant split"
 ?[cli]: "extend mass vs new measure command"
 ?[profiles]: "home of named eval profiles"
}

#>wonder_measure_lattice_1
?["When does a metaphor become a measure?"]{
  #:depth #!computational
  !probe{ =id[p_measured] }
  $%[bridge.measured, scheme.kind]
  ~<.agents/plans/measure-invariant-generalization/PLAN.md>
}
