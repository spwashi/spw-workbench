#>wonder_measure_invariant_generalization_1
?["Is any surface in the corpus actually governed by a %mass facet?"]{
  #:depth #!computational
  ~#hypothesis: "%mass is documented and implemented but declared nowhere, so drift detection and the --write guard protect nothing yet"
  !probe{ "npm run -s spw -- measure <files that grep '%mass'>; on 2026-10-12 10 files mentioned %mass in prose and spw measure reported 0 subjects, 0 drifted ('no surfaces declare @self with a %mass facet')" }
  $%[mass.declared_subjects, mass.drift_count]
}
