^["intent"]{
 ~#goal: "Make Neovim a peer client of spw-lsp with the same truth density as VS Code via diagnostics, code actions, and :Spw* projections — no panel parity program."
 ~#taste: "native affordances, capability honesty, quiet feedback, thrift"
}

