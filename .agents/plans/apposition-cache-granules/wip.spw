 ~#server_index_size: "1234 lines, already double the 600-line craft guard — this plan must not grow it"
 ~#discarded_index: "buildReferenceGraph computes inbound: Map<string, Set<string>> and caches only the hubs/orphans report"
 ~#unmemoized: "resolveReferencePath is called per candidate per references request and cached nowhere"
 ~#kernel_drop: "ParseOutput carries duration, lexProfile, and events; ServerIndex keeps the AST and discards all three"
}

