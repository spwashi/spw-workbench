# references — curriculum-html-css-mastery

#:layer #!reference

^["source_index"]{
 @html_ls: "https://html.spec.whatwg.org/multipage/"
 @html_aria: "https://www.w3.org/TR/html-aria/"
 @css_grid_2: "https://drafts.csswg.org/css-grid-2/"
 @css_contain_3: "https://drafts.csswg.org/css-contain-3/"
 @selectors_4: "https://drafts.csswg.org/selectors-4/"
 @css_cascade_5: "https://drafts.csswg.org/css-cascade-5/"
 @css_scoping_1: "https://drafts.csswg.org/css-scoping-1/"
 @css_variables_1: "https://drafts.csswg.org/css-variables-1/"
 @css_values_4: "https://drafts.csswg.org/css-values-4/"
 @css_color_4: "https://drafts.csswg.org/css-color-4/"
 @scroll_animations_1: "https://drafts.csswg.org/scroll-animations-1/"
 @view_transitions_1: "https://drafts.csswg.org/css-view-transitions-1/"
}

^["signature"]{
 ~#profile: "web linguistics braid"
 ~#recognition: "document semantics, layout topology, value calculus, query logic, and temporal navigation should feel like one transferable language field"
}

^["topic_anchors"]{
 document_semantics: [@html_ls, @html_aria, #dom_semantics, #accessibility_tree, #implicit_roles, #document_flow]
 containment_and_layout: [@css_grid_2, @css_contain_3, #subgrid, #container_queries, #intrinsic_sizing, #containment]
 value_calculus: [@css_variables_1, @css_values_4, @css_color_4, #calc, #clamp, #oklch, #relative_color]
 query_language: [@selectors_4, @css_cascade_5, @css_scoping_1, #has, #attribute_selectors, #layer, #scope]
 temporal_navigation: [@scroll_animations_1, @view_transitions_1, #scroll_timeline, #view_timeline, #view_transitions, #state_machine]
}

^["operational_density"]{
 checks: [#precedent_quality, #page_transfer, #selector_reuse, #accessibility_reasoning, #browser_truth]
 drift_risks: [#spec_catalog, #js_escape_hatch, #support_overclaim, #selector_folklore]
 release_implications: [#page_heuristics, #component_patterns, #exhibit_motions, #governance_notes]
}

