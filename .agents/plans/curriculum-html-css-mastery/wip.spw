}

^["intent"]{
 ~#goal: "Design a rigorous, incremental curriculum focused on HTML/CSS spec mastery. Map established web precedents to innovative Spw design relationships, creating a sandbox for exercising web language muscles."
 ~#taste: "expressiveness, clarity, rigor"
}

^["development"]{
 lane: #curriculum_formation
 ladder: #page
 develops: [#layout_taste, #web_linguistics, #page_judgment, #transfer]
 review_surfaces: [@cluster, @plan, @pattern, @workspace]
 snippet_routes: [#lab_seed, #html_note, #css_pattern, #page_transfer]
}

^["concept_index"]{
 primary: [#html, #css, #layout, #semantics, #containment, #labs]
 surfaces: [#page, #dom, #css, #docs]
 tensions: [#precedent_vs_innovation, #scope, #transfer, #curriculum_bloat]
 transfers: [#component, #page, #service]
}

^["recursive_improvement"]{
 loop: [
  "? reread web precedents and existing patterns before adding more labs",
  "< ship one lab or reflection that sharpens a real page-design muscle",
  "$ record which web concept became easier to transfer into Spw",
  "^ feed the stable lesson into component, page, and service design work",
  "% keep curricula grounded in applied learning rather than catalog accumulation",
 ]
 gates: [#precedent_quality, #transfer, #applied_learning]
}

^["stream"]{
 >>[2026-02-20 02:22] observe — The user wants an incremental deep dive into HTML and CSS language specs to build web mastery, acting as a springboard for novel Spw relationships.
 >>[2026-02-20 02:22] decide — Structuring the plan into 5 focused 'Labs'. Each lab contrasts a raw web standard (the precedent) with a Spw paradigm (the innovation).
}

^["open"]{
}

