^["lab_format"]{
 # Shared by all three curricula. This plan owns it; the svg and logic-terminal plans link here and may not fork it without a revise entry here.
 ~#owner: "curriculum-html-css-mastery"
 ~#home: "docs/learn/labs/<curriculum>/ with <curriculum> one of html-css, html-svg, logic-terminal; docs/learn already holds path.md, cheat-sheet.md, worked-cli.md and index.spw, so labs join the learnability spine"
 ~#pair: "each lab is NN-slug.md plus NN-slug.check.test.ts in the same directory; a lab without its check does not ship"
 ~#sections: "Precedent, Spw reflection, Repo pattern reviewed, Experiment, Check (the five headings a format-lint test asserts, matching the PLAN.md scope rule of precedent plus reflection plus repo review plus one heuristic)"
 ~#protocol: "hypothesis, switch, probe, instrumentation follow .agents/skills/spw-css-dom-lab/references/experiment-protocol.md; that skill stays a protocol and is not the lab directory"
 ~#tiers: "a Check names its tier per claim: structural (jsdom DOM and selector facts), pure (plain TypeScript math or parsing), or browser (stated in prose and attested by hand, never auto-passed)"
 ~#runner: "npm run test:labs, a new vitest.labs.config.ts including docs/learn/labs/**/*.test.ts, jsdom by default with a per-file node environment override"
 ~#order: "html-css commits 1 and 2 first (they create the home and prove the pair); svg commit 2 and logic-terminal commit 2 may then run in parallel; later labs are independent inside each curriculum"
}

^["stream"]{
