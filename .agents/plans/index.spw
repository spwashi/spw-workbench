# Plans — flat index
#
# One routing table over the nested plan directories. Legend and doors are
# authored; every frame from ^["active"] down is derived from plan cards by
# `npm run spw:plan:index -- --write`. Edit the card, never a derived row.

#>plans_index
#:index #!plans
#:layer #!pragmatics

^["roots"]{
 @schema: ~"./_schema/wip.spw"
 @template: ~"./_schema/wip-template.spw"
 @ecology: ~"./plan-ecology-clustering/plan-ecology-clustering.spw"
 @archive: ~"./_archive"
 @canon: ~"../../.spw/index.spw"
 @learn: ~"../../docs/learn/index.spw"
 @roadmaps: ~"../../docs/plans/index.spw"
 @generator: ~"../../scripts/plans/plan-index.ts"
 @contours: ~"./relationship-contours/relationship-contours.spw"
}

^["legend"]{
 // A card's operator is its lane; the glyph groups rows below.
 '!': .{ lane = #execution_truth asks = "what becomes truer?" }
 '@': .{ lane = #projection_feedback asks = "what becomes discussable across hosts?" }
 '?': .{ lane = #public_interest_research asks = "what is worth asking?" }
 '~': .{ lane = #curriculum_formation asks = "what is learned?" }
 '^': .{ lane = #principal_engineering asks = "what doctrine rises?" }
 '.': .{ lane = #rewrite_recovery asks = "what must be regrounded?" }
 phases: [#active, #review, #landed, #planning, #seed, #dormant, #stranded, #done]
}

^["doors"]{
 // Arrive with a question; leave with the next file. Each door is at most four hops.
 first_visit: .{
  ask = "What is Spw, and what is being built right now?"
  route = ["legend", "active", "one card", "its entry"]
  then = [@learn, @canon]
 }
 returning: .{
  ask = "What moved while I was away?"
  run = "npm run spw:plan:index"
  route = ["stream age column", "drift.cooling", "a card's next"]
 }
 agent_resume: .{
  ask = "Where exactly was this plan left?"
  run = "npm run spw:plan:status -- --slug <slug>"
  route = ["card", "cache", "open", "last five stream entries"]
 }
 from_code: .{
  ask = "Which plans care about the file I am holding?"
  run = "npm run spw:plan:index -- --touch <path>"
  route = ["touches", "the card", "its edges"]
 }
 language_designer: .{
  ask = "Where is the language itself changing?"
  route = [@roadmaps, "'?' and '^' rows", "directive-lattice and shape-syntax-ecology cards", ~"../../.spw/registries/dialect-spec.spw"]
 }
 host_maintainer: .{
  ask = "What does my editor or client owe, and what do its peers already do?"
  route = ["'@' rows", "ecology interaction_target_cluster", ~"../../.spw/tooling/editor-instruments.spw"]
 }
 consumer: .{
  ask = "I mount the workbench in another repository — what is stable for me?"
  run = "npm run spw:doctor"
  route = ["mounted-consumer-tooling card", ~"../../.spw/conventions/submodule.spw"]
 }
 wanderer: .{
  ask = "Nothing urgent — what is worth reheating?"
  run = "npm run spw:plan:index -- --wander"
  route = ["kin", "a resting card", "one open question"]
 }
 steward: .{
  ask = "Is the ecology telling the truth?"
  run = "npm run spw:plan:index -- --check"
  route = ["drift", "/maintain-plans", @ecology, @contours]
 }
 next_work: .{
  ask = "What should be worked on next, and what waits on whom?"
  route = ["priority", "a card next", "its PLAN.md"]
 }
}

^["priority"]{
 // Authored, not derived. Refresh when a now row lands or an owner decision moves a row.
 // Ranked by risk first, then by how much a row unblocks.
 as_of: "2026-10-13"
 law: "a product move lands after a language sample names its wire and a retained sample names its cost (plan-ecology-clustering ^primed_scrutiny)"
 now: [
  "citation-navigation ~[root_anchor_refs] — the owner-chosen p8 form; lands with a resolve timing (186 s over the caches tree today)",
  "editor-reading-hierarchy ~[hierarchy_census] — the baseline every hierarchy fix is measured against"
 ]
 next: [
  "plan-plugin-integration ~[commit_ref_vscode_test] and ~[land_commit_action] — git hashes in VS Code landed in a80a5df7 and 00c6a56e; an extension-host test and completion when landing remain",
  "caches-living-tree ~[journal_entry_lens] and ~[journal_append_only]",
  "local-numbering-vcs ~[schema_numbering_rule]",
  "cli-mode-overhaul ~[collate_ceiling_test] — a ceiling lie measurable without a bench",
  "caches-cut-2026-09-30 ~[root_apparatus] — three planned panels",
  "plan-stream-parse-health ~[entry_figure_nodes]",
  "tooling-scripts-consolidation ~[suite_and_bundle] — test:all, lint:spw:strict, and a source bundle that includes packages",
  "tooling-scripts-consolidation ~[pin_analyzers] — hidden test failures join the suite"
 ]
 waiting_on_owner: [
  "caches-living-tree ?[samples_review] — p9 to p11",
  "caches-living-tree ?[handoff_name]",
  "editor-reading-hierarchy ?[bare_path_color] and ?[header_banner]",
  "intellij-lsp4ij ?[comment_form]",
  "refactor-experiment-lifecycle ?[hash_basis]",
  "local-numbering-vcs ?[jj_hooks]",
  "tooling-scripts-consolidation ?[reset_fate]"
 ]
 held_for_cost: [
  "vscode-plugin-performance — waits on a retained bench sample",
  "cli-mode-overhaul mode contract — waits on cli-benchmarking-infra",
  "intellij-lsp4ij substrate choice — waits on the 263 audit"
 ]
}

^["active"]{
 '!': {
  @caches_cut_2026_09_30: ~"./caches-cut-2026-09-30/wip.spw" "Turn the generated caches shelf into a dated, sourced, addressable reference cut that teaches how to structure a Spw graph."
  @caches_living_tree: ~"./caches-living-tree/wip.spw" "The caches become two layers, a living tree agents edit to keep true and an append-only journal of what was seen or made on a day, entered from one root and one door, with surfaces that carry less prose and address by anchor."
  @cli_sense_reorientation: ~"./cli-sense-reorientation/wip.spw" "Census, graph and query accept one shared glob selection; verb names and aliases already landed."
  @hygiene_index_consolidation: ~"./hygiene-index-consolidation/wip.spw" "Git status, doc refs, plan caches, and a plan index tell the truth without archaeology."
  @package_iteration_radius: ~"./package-iteration-radius/wip.spw" "Package manifests, environment receipts, and leaf tasks make each change's build radius visible."
  @parser_releases: ~"./parser-releases/wip.spw" "Every release day cuts a dated, immutable set of browser parser builds with a manifest, and spw.quest serves them for other sites to import"
  @plan_stream_parse_health: ~"./plan-stream-parse-health/wip.spw" "Line items (.. and >>) read the same in every dialect and carry mixed phrases, so parse health measures structure however a file is parsed."
  @refactor_experiment_lifecycle: ~"./refactor-experiment-lifecycle/wip.spw" "Multi-file refactors run as hash-gated experiments under one spw.refactor.plan/1 id."
 }
 '@': {
  @citation_navigation: ~"./citation-navigation/wip.spw" "Make an unfamiliar Spw workspace navigable by construct, evidence trail, and resumable inquiry."
  @editor_inspection_instruments: ~"./editor-inspection-instruments/wip.spw" "VS Code, IntelliJ and Neovim each run the same inspection instruments from the CLI: source products, fingerprint, memory, performance and projection"
  @editor_reading_hierarchy: ~"./editor-reading-hierarchy/wip.spw" "Every editor shows glyphs and errors first, one answer per hover second, and instruments on demand, all drawn from one parse-derived role stream, so a reader can scan a file's topography instead of its chrome."
  @onboarding_quest: ~"./onboarding-quest/wip.spw" "A newcomer meets Spw by playing in it: one quest every host draws, and a .spw folder of forks, experiments, shelves, wonders and asks"
  @plan_plugin_integration: ~"./plan-plugin-integration/wip.spw" "Editor plugins read and act on wip.spw plan facts through standard LSP products, one fact model."
 }
 '^': {
  @plan_ecology_clustering: ~"./plan-ecology-clustering/wip.spw" "Every plan carries a lane, a learning value, and a place in one legible direction spine."
  @relationship_contours: ~"./relationship-contours/wip.spw" "Give each kind of reader a first move; make every surface answer the same question alike."
 }
}

^["landed"]{
 '!': {
  @absorb_spwq_cli: ~"./absorb-spwq-cli/wip.spw" "One package-owned spw CLI owns truthful selector verbs; spwq survives only as a hidden alias."
  @audit_fuzz_truthfulness: ~"./audit-fuzz-truthfulness/wip.spw" "audit:* and fuzz:* names state what they scan and verify, with JSON output to rank and diff."
  @canon_rewrite_v2: ~"./canon-rewrite-v2/wip.spw" "Main carries lawful field coordinates, product identity, nested disclosure, and delta≠patch."
  @commit_gate_redesign: ~"./commit-gate-redesign/wip.spw" "The human authorizes a summarized commit; hook and poll-review share one review engine."
  @ecosystem_surface_governance: ~"./ecosystem-surface-governance/wip.spw" "Surface archetypes carry readiness evidence and stewardship, never a domain, owner, or deploy target"
  @gap_affinity_tooling: ~"./gap-affinity-tooling/wip.spw" "Token gaps and operator affinity become declared syntax products that formatting and tools preserve."
  @measure_invariant_generalization: ~"./measure-invariant-generalization/wip.spw" "Measures declare an evaluation scheme, so exact mass and fuzzy invariants share one reconcile loop."
  @mounted_consumer_tooling: ~"./mounted-consumer-tooling/wip.spw" "Any repo mounting .spw/_workbench gets audited CLI, LSP, and editor tooling without being named"
  @operational_topography: ~"./operational-topography/wip.spw" "Spw has one neutral, parser-owned contract for placement, nesting, orientation, and evidence."
  @query_profile: ~"./query-profile/wip.spw" "A slow or killed query names the source it entered and the stages that finished, on stderr."
  @runtime_axis_traceability: ~"./runtime-axis-traceability/wip.spw" "Runtime constants and stages carry @spw:axis traces that reviewers read back to design axes."
  @safety_commit_reconciliation: ~"./safety-commit-reconciliation/wip.spw" "Checkpoint a333db8d lands as dependency-ordered, independently verified commits."
  @seed_roundness_grades: ~"./seed-roundness-grades/wip.spw" "Living docs say effect.l0..l3 as differential.ts does; n-range and range-transform are round."
  @spw_cli_overhaul: ~"./spw-cli-overhaul/wip.spw" "The CLI routes through one package, parses flags fail-closed, and speaks a versioned JSON envelope."
  @spw_q_stabilization: ~"./spw-q-stabilization/wip.spw" "Spw.q is a versioned pre-v1 candidate whose evidence names provenance, not an ordinal ladder."
  @spw_site_install: ~"./spw-site-install/wip.spw" "A consumer mounts the workbench at .spw/_workbench and keeps its own .spw canon and review evidence"
  @syntax_profile_stack: ~"./syntax-profile-stack/wip.spw" "One dialect × surface-profile stack resolves once for parse, review, format, and editor hover."
  @vscode_lsp_roadmap: ~"./vscode-lsp-roadmap/wip.spw" "Editor clients and spw-lsp advance on one ordered ladder with honest capabilities and thin clients."
 }
 '@': {
  @form_geometry_editor: ~"./form-geometry-editor/wip.spw" "Editors show caret-local form geometry and offer only receipt-gated mobility edits from Seed."
  @vscode_workspace_atlas: ~"./vscode-workspace-atlas/wip.spw" "The Atlas tree renders consumer-owned roots, memory tiers, and cursor context from the manifest."
 }
 '^': {
  @directive_lattice: ~"./directive-lattice/wip.spw" "One lexed particle family ⟨stance⟩#⟨aim⟩name turns #> anchors into addressable fragment targets."
  @shape_syntax_ecology: ~"./shape-syntax-ecology/wip.spw" "Experimental syntax stays citable by catalog id and status in seed and LSP without becoming law."
 }
}

^["planning"]{
 '!': {
  @apposition_cache_granules: ~"./apposition-cache-granules/wip.spw" "LSP cache entries die with their document and invalidate per apposition granule, not per file."
  @audit_css_tokens: ~"./audit-css-tokens/wip.spw" "A season override re-themes every color in the installable-book preset, because no literal bypasses a token."
  @audit_data_attributes: ~"./audit-data-attributes/wip.spw" "Every data-* hook the installable-book preset writes has a reader, or sits in a declared inert set."
  @cli_benchmarking_infra: ~"./cli-benchmarking-infra/wip.spw" "Benchmarks retain raw samples and separate first output, completion, real spans, and env faults."
  @cli_mode_overhaul: ~"./cli-mode-overhaul/wip.spw" "Every CLI command declares its effect mode and ceiling, so no --write arrives as a surprise."
  @local_numbering_vcs: ~"./local-numbering-vcs/wip.spw" "Local ids follow one rule (labels are identity, ordinals are derived for display), and every version-control touchpoint reads the VCS from .spw/workspace.spw, detected by default, so plans, lexer, LSP, CLI, and hooks work in git, jj, or no VCS."
  @lsp_custom_request_completions: ~"./lsp-custom-request-completions/wip.spw" "Every spw/* method has one registry entry and a matrix row from handled through tested."
  @spw_beat_diff_precipitation: ~"./spw-beat-diff-precipitation/wip.spw" "LSP cache-tier TTLs are read from the cache.spw tiers authority instead of constants in server-index.ts."
  @tooling_scripts_consolidation: ~"./tooling-scripts-consolidation/wip.spw" "Every script and npm name states what it runs, Spw-native analyzers live inside spw verbs, dead and UI-era scripts are retired behind warnings, and nothing a hook, skill, or mounted consumer runs breaks on the way."
  @typescript_perf_audit_infra: ~"./typescript-perf-audit-infra/wip.spw" "Timed typecheck rows name compiler, config, and duration so upgrade claims become measurable."
 }
 '@': {
  @audit_ui_data_models: ~"./audit-ui-data-models/wip.spw" "The sigil semantics table is keyed by the closed OperatorKind union, with one owner and a coverage test."
  @intellij_lsp4ij: ~"./intellij-lsp4ij/wip.spw" "IntelliJ's LSP substrate (native API vs LSP4IJ) is chosen on mounted-consumer evidence before 263"
  @neovim_spw_surfaces: ~"./neovim-spw-surfaces/wip.spw" "Neovim is a builtins-first spw-lsp peer: honest :Spw* wrappers, projected diagnostics, :SpwInspect"
  @vscode_authoring_probe_loop: ~"./vscode-authoring-probe-loop/wip.spw" "Cursor probe sites (%mass, !probe, wonder, $%) get LSP actions that VS Code and Neovim both project."
 }
 '?': {
  @symmetry_explorer_instrument: ~"./symmetry-explorer-instrument/wip.spw" "An executable D4/Z4 group in the seed gives the .{sym:D4} application surfaces a tested meaning."
  @syntax_hardware_alignment: ~"./syntax-hardware-alignment/wip.spw" "Hardware-aligned syntax proposals p1 to p11 — each removes a duplicated wire or adds a missing one — staged as samples before any parser change."
 }
 '~': {
  @curriculum_html_css_mastery: ~"./curriculum-html-css-mastery/wip.spw" "Five HTML/CSS labs under docs/learn/labs, each paired with a jsdom check, own the shared lab format."
  @curriculum_html_svg_mastery: ~"./curriculum-html-svg-mastery/wip.spw" "Five hand-authored SVG labs under docs/learn/labs/html-svg turn geometry into checked Spw precedent."
  @curriculum_logic_terminal_mastery: ~"./curriculum-logic-terminal-mastery/wip.spw" "Five TTY, Prolog, Haskell and GQL labs under docs/learn/labs/logic-terminal feed the spw query and CLI."
 }
 '^': {
  @plan_tooling_design: ~"./plan-tooling-design/wip.spw" "Plan upkeep moves that are derivable become verbs with a plan-only delta, and the probes report why and where."
  @refactor_import_sprawl: ~"./refactor-import-sprawl/wip.spw" "The package DAG and the 12-import craft guard are checked by a script instead of only written down."
 }
}

^["dormant"]{
 '!': {
  @geometric_analysis_tooling: ~"./geometric-analysis-tooling/wip.spw" "spw geometry counts operators from the AST, not characters, and fingerprints recurring ONF shape."
  @register_phase_evolution: ~"./register-phase-evolution/wip.spw" "Selectors, spwq, and docs share the canonical register phases lex→parse→semantic→optimize→pragmatic."
  @runtime_dx_foundation: ~"./runtime-dx-foundation/wip.spw" "Seed, runtime, LSP, CLI, and editor failures share one greppable station code and a next action."
  @typescript_upgrade_ladder: ~"./typescript-upgrade-ladder/wip.spw" "The compiler climbs 5.9 → 6 → 7 in green rungs, with dual-install and no silent default flip."
  @vscode_plugin_performance: ~"./vscode-plugin-performance/wip.spw" "VS Code starts lean and stops paying for hidden surfaces, full rebuilds, and duplicate LSP calls."
 }
 '@': {
  @obsidian_spw: ~"./obsidian-spw/wip.spw" "Obsidian renders .spw files and markdown fences locally, with LSP-backed Concepts and Atlas views"
  @vscode_editor_contract: ~"./vscode-editor-contract/wip.spw" "Each editor payload names its owner, authority class, and invalidator; surfaces compose, not fork."
  @vscode_register_explorer: ~"./vscode-register-explorer/wip.spw" "A VS Code Register Explorer shows register phase, provenance, and resonance from a server snapshot."
 }
 '?': {
  @curiosity_mutation_ergonomics: ~"./curiosity-mutation-ergonomics/wip.spw" "Plan-only explore profiles invite underused combinator cells and stabilize relations that survive."
  @precipitate_model_alignment: ~"./precipitate-model-alignment/wip.spw" "Precipitate, substrate, assay, and resonance name checkable roles in the runtime pipeline."
  @spw_garden_geometry: ~"./spw-garden-geometry/wip.spw" "Hovers show only what reading cannot: true deltas, cross-file facts, and measured mechanics."
  @typescript_toolchain_observatory: ~"./typescript-toolchain-observatory/wip.spw" "TypeScript config, version, and bundle experiments become comparable JSON, Markdown, and .spw rows."
 }
 '^': {
  @lukewarm_backlog: ~"./lukewarm-backlog/wip.spw" "Lower-priority findings that are real but not hot sit here with evidence, a home plan and a reheat trigger."
  @naming_profile_convention_align: ~"./naming-profile-convention-align/wip.spw" "Each head noun (profile, hash, mode) has one owning family, indexed and co-developed across plans."
 }
}

^["touches"]{
 // package-sized regions → plans; `npm run spw:plan:index -- --touch <path>` answers finer paths
 ~".agents/plans": [@hygiene_index_consolidation, @plan_ecology_clustering, @plan_stream_parse_health, @relationship_contours]
 ~".agents/scripts": [@local_numbering_vcs, @plan_plugin_integration, @plan_tooling_design, @tooling_scripts_consolidation]
 ~".agents/skills": [@commit_gate_redesign, @lukewarm_backlog, @mounted_consumer_tooling, @tooling_scripts_consolidation]
 ~".agents/workflows": [@commit_gate_redesign]
 ~".gitignore": [@hygiene_index_consolidation]
 ~".spw/applications": [@symmetry_explorer_instrument]
 ~".spw/biome": [@spw_beat_diff_precipitation]
 ~".spw/caches": [@caches_cut_2026_09_30, @caches_living_tree, @syntax_hardware_alignment]
 ~".spw/conventions": [@absorb_spwq_cli, @curriculum_logic_terminal_mastery, @mounted_consumer_tooling, @naming_profile_convention_align, @spw_site_install]
 ~".spw/hot.spw": [@cli_mode_overhaul]
 ~".spw/patterns": [@curriculum_html_svg_mastery, @naming_profile_convention_align, @plan_ecology_clustering]
 ~".spw/registries": [@directive_lattice, @syntax_profile_stack]
 ~".spw/surfaces": [@ecosystem_surface_governance]
 ~".spw/tooling": [@mounted_consumer_tooling, @neovim_spw_surfaces, @plan_ecology_clustering, @vscode_lsp_roadmap]
 ~".spw/workspace.spw": [@caches_living_tree, @local_numbering_vcs]
 ~"docs/contributing": [@audit_fuzz_truthfulness]
 ~"docs/design": [@curriculum_html_css_mastery, @curriculum_html_svg_mastery, @spw_q_stabilization]
 ~"docs/learn": [@curriculum_html_css_mastery, @curriculum_html_svg_mastery, @curriculum_logic_terminal_mastery, @onboarding_quest]
 ~"docs/research": [@typescript_toolchain_observatory]
 ~"docs/runtime": [@curiosity_mutation_ergonomics, @parser_releases, @precipitate_model_alignment, @query_profile, @register_phase_evolution, @shape_syntax_ecology]
 ~"docs/specs": [@precipitate_model_alignment]
 ~"docs/theory": [@canon_rewrite_v2, @operational_topography, @plan_stream_parse_health, @seed_roundness_grades, @shape_syntax_ecology, @syntax_profile_stack]
 ~"docs/toc.spw": [@ecosystem_surface_governance]
 ~"extensions": [@obsidian_spw]
 ~"extensions/intellij-spw": [@editor_inspection_instruments, @intellij_lsp4ij, @onboarding_quest]
 ~"extensions/neovim-spw": [@editor_inspection_instruments, @editor_reading_hierarchy, @neovim_spw_surfaces, @spw_garden_geometry, @vscode_authoring_probe_loop]
 ~"extensions/obsidian-spw": [@obsidian_spw]
 ~"extensions/vscode-spw": [@audit_ui_data_models, @citation_navigation, @editor_inspection_instruments, @editor_reading_hierarchy, @form_geometry_editor, @lsp_custom_request_completions, @onboarding_quest, @safety_commit_reconciliation, @spw_garden_geometry, @typescript_upgrade_ladder, @vscode_authoring_probe_loop, @vscode_editor_contract, @vscode_plugin_performance, @vscode_register_explorer, @vscode_workspace_atlas]
 ~"package.json": [@audit_fuzz_truthfulness, @cli_benchmarking_infra, @lukewarm_backlog, @package_iteration_radius, @spw_cli_overhaul, @tooling_scripts_consolidation, @typescript_perf_audit_infra, @typescript_upgrade_ladder]
 ~"packages": [@refactor_import_sprawl]
 ~"packages/spw-cli": [@absorb_spwq_cli, @audit_css_tokens, @audit_data_attributes, @caches_cut_2026_09_30, @canon_rewrite_v2, @citation_navigation, @cli_mode_overhaul, @cli_sense_reorientation, @curiosity_mutation_ergonomics, @curriculum_logic_terminal_mastery, @gap_affinity_tooling, @geometric_analysis_tooling, @hygiene_index_consolidation, @measure_invariant_generalization, @mounted_consumer_tooling, @naming_profile_convention_align, @onboarding_quest, @package_iteration_radius, @plan_tooling_design, @query_profile, @refactor_experiment_lifecycle, @register_phase_evolution, @relationship_contours, @runtime_dx_foundation, @safety_commit_reconciliation, @spw_cli_overhaul, @spw_site_install]
 ~"packages/spw-lsp": [@apposition_cache_granules, @audit_ui_data_models, @caches_cut_2026_09_30, @caches_living_tree, @citation_navigation, @editor_reading_hierarchy, @form_geometry_editor, @geometric_analysis_tooling, @local_numbering_vcs, @lsp_custom_request_completions, @plan_plugin_integration, @runtime_dx_foundation, @safety_commit_reconciliation, @spw_beat_diff_precipitation, @spw_garden_geometry, @vscode_authoring_probe_loop, @vscode_lsp_roadmap, @vscode_plugin_performance, @vscode_register_explorer, @vscode_workspace_atlas]
 ~"packages/spw-runtime": [@lukewarm_backlog, @precipitate_model_alignment, @runtime_axis_traceability, @runtime_dx_foundation, @spw_site_install]
 ~"packages/spw-seed": [@absorb_spwq_cli, @apposition_cache_granules, @audit_ui_data_models, @canon_rewrite_v2, @cli_mode_overhaul, @cli_sense_reorientation, @curiosity_mutation_ergonomics, @curriculum_logic_terminal_mastery, @directive_lattice, @gap_affinity_tooling, @geometric_analysis_tooling, @local_numbering_vcs, @lukewarm_backlog, @measure_invariant_generalization, @onboarding_quest, @operational_topography, @package_iteration_radius, @plan_stream_parse_health, @refactor_experiment_lifecycle, @register_phase_evolution, @relationship_contours, @runtime_dx_foundation, @safety_commit_reconciliation, @seed_roundness_grades, @shape_syntax_ecology, @spw_q_stabilization, @symmetry_explorer_instrument, @syntax_hardware_alignment, @syntax_profile_stack]
 ~"schemas/spw-cli-envelope.v1.schema.json": [@spw_cli_overhaul]
 ~"scripts": [@cli_benchmarking_infra, @tooling_scripts_consolidation]
 ~"scripts/analyzers": [@audit_fuzz_truthfulness, @caches_cut_2026_09_30, @caches_living_tree, @hygiene_index_consolidation, @refactor_import_sprawl, @runtime_axis_traceability, @syntax_hardware_alignment, @typescript_perf_audit_infra, @typescript_toolchain_observatory]
 ~"scripts/bench": [@cli_benchmarking_infra]
 ~"scripts/commit-review": [@commit_gate_redesign]
 ~"scripts/plans": [@plan_plugin_integration, @plan_tooling_design, @relationship_contours]
 ~"scripts/pre-commit": [@commit_gate_redesign, @refactor_import_sprawl]
