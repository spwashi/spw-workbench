# Shapes
#
# The five commonest line shapes in a mounted consumer's expression lines, each written as a line of holes beside one line that fills it.

# Sample for proposal p17: a shape is the line with each word replaced by _.
# Counts are of 391 expression lines (journal 2026-11-09-reader-agreement).
# The line reader reads every shape below whole. The parser reads each _ as a
# Wildcard, but reads _._._ as five expressions where a.b.c is one name, and
# reads a mark before a hole (~_) as two terms; those two gaps are p17's needs.

#>sample_shapes
#:layer #!syntax

^["shapes"]{
 three_dotted: .{ shape: "_[_]{_._._}<_>", fills: "index[entry]{orient.dispatch.workbench}<bridge>", lines: 125 }
 one_part: .{ shape: "_[_]{_}", fills: "probe[instruction]{debut_placement}", lines: 101 }
 two_dotted: .{ shape: "_[_]{_._}<_>", fills: "roots[sigil]{consumer.first}<address>", lines: 47 }
 four_dotted: .{ shape: "_[_]{_._._._}<_>", fills: "workspace[roots]{authored.semantic.pragmatic.generated}<kernel>", lines: 39 }
 one_part_with_concept: .{ shape: "_[_]{_}<_>", fills: "audit[index]{reading_orders}<thorough>", lines: 18 }
}

^["isomers"]{
 # The same words in two shapes; a reader that keeps only words cannot tell them apart.
 company: "garden[care]{seed, water}<plot>"
 one_name: "garden[care]{seed.water}<plot>"
 topic_first: "<plot>garden[care]{seed, water}"
}

^["live"]{
 # The shapes as lines, unquoted, to show they lex and parse today.
 _[_]{_}
 _[_]{_}<_>
 _[_]{_, _}<_>
}
