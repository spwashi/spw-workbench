// Syntax - Hardware - Alignment
//
// Proposed syntax moves, each staged as a commented sample exhibit: p1 to p7
// from the shelf audit, p8 to p11 from the caches living tree (2026-10-13).
// Organizing metaphor: a header stack is a bus transaction — the anchor is the
// address lines, the lens the control lines, the focus the flag/strobe, the ~#
// stance the latched (volatile) state, $%[...] the readback register. Every proposal is
// tested against one invariant: one signal per wire.
//
// Samples stay in comment fences until they earn a lexer/parser spike; the
// current grammar must keep parsing this artifact clean.
//
// @see .agents/plans/syntax-hardware-alignment/PLAN.md
// @see packages/spw-seed/src/canonical/particles.ts
// @see scripts/analyzers/spw-cut-gate.ts

#:layer #!pragmatics
#:status #!proposed

^["roots"]{
 @plan: ~".agents/plans/syntax-hardware-alignment/PLAN.md"
 @wip: ~".agents/plans/syntax-hardware-alignment/wip.spw"
 @particles: ~"packages/spw-seed/src/canonical/particles.ts"
 @cut_gate: ~"scripts/analyzers/spw-cut-gate.ts"
 @cache_root: ~".spw/caches/journal/2026-09-30-gemini-shelf/index.spw"
 @ecology: ~".agents/plans/shape-syntax-ecology/shape-syntax-ecology.spw"
}

^["thesis"]{
 ~#claim: "Constructs grow more playable and more honest when every duplicated wire is removed (dispatch, lens triplets, path-in-anchor) and every missing wire is added (evidential, metric latch, refresh strobe)."
 ~#metaphor: "particle paradigm as memory-bus transaction: anchor=address, lens=control, focus=strobe, ~# stance=latch, metric=readback"
 ~#non_goal: "Metaphor as runtime; parser edits before samples are reviewed; new law without catalog entries."
}

// ── Proposal 1: derive routes from roots (#!route focus) ─────────────────
// The ^"roots" / ^"dispatch" pair duplicates a 30-entry memory map; the cut
// gate already bans ^"dispatch". Routes become a focus on the binding and
// tooling derives the table as a view — never edited, never stale.
//
#   ^"roots"{
#     @jetbrains: ~"./jetbrains/index.spw" #!route(overview)
#     @vscode:    ~"./vscode/index.spw"    #!route
#   }

^["p1_route_mood"]{
 ~#status: "proposed"
 ~#removes: "shadow register — dispatch tables duplicate the address decoder"
 ~#play: "LSP renders, folds, and queries the derived dispatch view"
 ~#gate_hook: "existing dispatch ban stays; derived views are exempt by construction"
}

// ── Proposal 2: metric latch slot ($%[handle = value @rev]) ──────────────
// A $% port today never latches. A fill-in-place form lets the cut gate
// --emit pass write back the measured value with provenance.
//
#   $%[cache.anchor_count]                      # port declared (tool: "unmeasured")
#   $%[cache.anchor_count = 412 @rev da5189bb]  # latched readback + provenance

^["p2_metric_latch"]{
 ~#status: "proposed"
 ~#adds: "latched readback with strobe timestamp — the document as oscilloscope"
 ~#play: "hover runs the S0 measurement against the reflexive-handle set and diffs the latch"
 ~#gate_hook: "latch diffing: re-measure and flag drift between latched and live values"
}

// ── Proposal 3: effect grades as probe privilege rings (!probe[S0]) ──────
// !probe{ "prose" } is opaque; S0-S3 effect grades surface grammatically as
// privilege rings, so read-only probes become auto-runnable by contract.
//
#   !probe[S0]{ "Count #> anchors across the cut; verify cross-refs resolve." }
#   !probe[S2]{ "Rewrite stale ~#as_of stamps." }   # requires apply authority

^["p3_probe_rings"]{
 ~#status: "proposed"
 ~#adds: "bus privilege level on the probe port"
 ~#play: "press play on a document: auto-run every S0 probe in a file"
 ~#gate_hook: "S0 probe bodies must not name write verbs — machine-checkable lint"
}

// ── Proposal 4: evidential particle (#~) ─────────────────────────────────
// The paradigm has anchor, lens, focus, the ~# stance — evidentiality (observed /
// derived / reported) is smuggled in as ordinary keys. A fourth-wall particle
// carries provenance with the word, like a parity bit on the data line.
//
#   #>spw_cache_jetbrains_index
#   #:layer #!pragmatics
#   #~derived(plugin.xml @rev 1f17c86e)     # evidential: how do I know this?

^["p4_evidential"]{
 ~#status: "proposed"
 ~#adds: "evidentiality as a particle aim — extends the ParticleNode.aim union"
 ~#play: "link-resolution extends naturally: a #~derived source newer than the file is a staleness finding"
 ~#open: "glyph choice — #~ may collide visually with the ~# stance in dense stacks"
}

// ── Proposal 5: temporal strobe for caches (era/season + ~#as_of) ────────
// Derived surfaces decay unless refreshed (DRAM). Standardize the refresh
// line so staleness renders as literal fade, and a domain cache with ~#as_of
// becomes a cut membership claim.
//
#   #:era #!2026-09
#   ~#as_of: "2026-09-30"

^["p5_refresh_strobe"]{
 ~#status: "proposed"
 ~#adds: "decay signal on cache surfaces — the missing bridge to dated cuts"
 ~#play: "editor dims by age; the 'caches are derived' invariant becomes physics"
 ~#gate_hook: "era/season already optional axes; ~#as_of older than source refs is a finding"
}

// ── Proposal 6: scoped anchors (base + offset addressing) ────────────────
// #>wonder_jetbrains_index_1 hand-encodes the file path (absolute address).
// Hierarchical anchors scope by the file's head anchor: segment + offset.
//
#   #>spw_cache_jetbrains_index      # segment base
#   ...
#   #>.wonder.1                      # resolves as spw_cache_jetbrains_index.wonder.1

^["p6_scoped_anchors"]{
 ~#status: "proposed"
 ~#removes: "path-in-anchor duplication"
 ~#play: "anchors short enough to type from memory; ~\"file#.wonder.1\" stays stable across renames of the prefix"
 ~#invariant: "deixisTable first-wins rule holds per segment"
}

// ── Proposal 7: fuse the lens gesture ────────────────────────────────────
// #:depth #!philosophical ~#lens(universal_lattice) splits one interpretive
// gesture across three marks on three wires; the lens carries its depth.
//
#   ~#lens(universal_lattice, depth: philosophical)

^["p7_lens_fuse"]{
 ~#status: "proposed"
 ~#removes: "three marks on three wires for one control word"
 ~#gate_hook: "lens/depth vocabulary checks collapse into a single site"
}

// ── Proposal 8: anchor-addressed refs (@root#anchor) ─────────────────────
// A ref spells the path to an anchor that is already unique in its layer.
// A named root plus a fragment addresses the anchor; the root's anchor index
// finds the file. Moves stop rewriting citations. Composes with p6.
//
//  before: source: ~"(a relative path to the registry file)#src_creator_epub33"
//  after:  source: @tree#src_creator_epub33
//  after:  lineage: [ @journal#spw_cache_indie_author_tools ]

^["p8_anchor_refs"]{
 ~#status: "proposed; the owner chose the root-plus-fragment form on 2026-10-13"
 ~#removes: "path-in-ref duplication: 9778 fragment refs in the caches tree, 356395 characters, about 7 percent of the tree"
 ~#lexes_today: "a root with a fragment, with or without a path between them, parses without error, but selectPathRefs and spw resolve do not read them as citations"
 ~#needs: "pathRefs, or a root-ref kind, for both forms; named-root lookup through .spw/workspace.spw in resolve, the LSP, and the cut gate; for a directory root with a bare fragment, a lookup in that directory's anchor index"
 ~#lsp_today: "the LSP already resolves a root followed by a path through workspace roots and reports one it cannot find; it also reads such forms inside strings, which p8 must not inherit"
 ~#gate_hook: "anchor uniqueness per layer is already enforced; resolve gains a named_root basis"
 ~#play: "move or split a file and no citation changes; go-to-definition lands on the anchor line through the server anchor index"
}

// ── Proposal 9: receipts as journal ledgers ─────────────────────────────
// Every surface repeats ^["receipts"] rows that are the same for a whole
// pass. A journal entry records the pass once and lists the surfaces by
// file anchor; the #:review axis keeps the summary. Composes with p4 if a
// one-line pointer is wanted: #~checked(@journal#journal_2026_10_02_receipts).
//
#   ^["receipts"]{ ^["r1"]{ event: #generated ... } ... ^["r6"]{ ... } }   // removed
#   journal/2026-10-02-receipts.spw: ^["rows"]{ ^["fact_checked"]{ ... files: [ @tree#authorship_toolchain ] } }

^["p9_journal_receipts"]{
 ~#status: "proposed"
 ~#removes: "5308 lines of per-surface receipt frames, about 6 percent of the tree's lines"
 ~#lexes_today: "yes; the ledger sample parses"
 ~#needs: "p8 for file-anchor lists; a gate check that each #:review value matches the highest-care passing row naming the surface"
 ~#play: "the LSP reference graph shows a surface's receipts as backlinks; a pass is reviewed as one entry instead of 437 diffs"
 ~#extends: "the same move turns as_of and checked strings into journal observations a claim cites"
}

// ── Proposal 10: a lean card ────────────────────────────────────────────
// The emit card restates the title comment, spells its proof as prose that
// names the sources the claims already cite, and writes the audience as a
// free phrase. Title and continuity derive; proof becomes refs; audience
// becomes a closed facet.
//
#   ~#title: "Author Toolchain"                                  // derived from the title comment
#   continuity: "Author Toolchain | every tool is a path"        // derived: title and the cold_open up to its first comma
#   ~#proof: [ @tree#src_creator_epub33, @tree#src_creator_kdp_mobi ]
#   #:audience #!makers

^["p10_lean_card"]{
 ~#status: "proposed"
 ~#removes: "title 12327 characters, continuity 20817, audience prose 32438, proof prose 63381, over 394 cards"
 ~#lexes_today: "yes"
 ~#needs: "emit derives title and continuity when absent; vocabulary gains a closed audience set; the gate stops requiring the derived fields"
 ~#keeps: "claim, door, and cold_open, which no tool can derive"
}

// ── Proposal 11: closed concepts ────────────────────────────────────────
// Every other axis draws from a closed set; concepts do not, so half the
// tags name one file and index nothing.
//
#   vocabulary.spw  ^["concepts"]{ set: #[ backlist, dated_receipt, feedback, file_format, ... ] }

^["p11_closed_concepts"]{
 ~#status: "proposed"
 ~#removes: "320 of 645 concept tags that occur once"
 ~#lexes_today: "yes; a conventions change"
 ~#needs: "a concept set in vocabulary.spw from the 325 recurring tags; each singleton maps to a recurring tag or is dropped; the gate fails a tag outside the set"
 ~#play: "every concept is a hub with at least two surfaces, so a concept query always returns a comparison"
}

// ── Proposal 12: a word is one token ───────────────────────────────────
// The lexer reads a letter-led word whole (q_2026_09_30, abc1234) but splits
// a digit-led one into a number and a name (16px, 2026q4, 551bb419,
// 3d_claymorphism_vibrant). The editor joined them in 8c745561 without
// touching the parse; this proposal is the lexer half.
//
//  before: 16px -> NUMBER(16) IDENTIFIER(px); 551bb419 -> NUMBER(551) IDENTIFIER(bb419)
//  after:  one token per run, its kind read from its shape

^["p12_alnum_words"]{
 ~#status: "proposed; the owner felt alphanumerics should be tokenized together (2026-10-13)"
 ~#census: "1328 .spw files: 79 digit-led runs split in code (40 number with unit such as 20s and 16px, 29 digit-led names such as 3d_claymorphism_vibrant, 7 short hex such as 4c, 3 hash-shaped such as 551bb419); 2218 names with digits already lex whole; no #-hex color appears outside a string"
 ~#kinds: "a digit-led run lexes as one token whose kind comes from its shape: hash (7 to 64 lowercase hex with a letter), hex (0x prefix or short hex), unit (digits then letters, such as 16px), name (anything with an underscore)"
 ~#hashes: "a hash kind in the lexer lets the CLI, the gate, and every client read hash-shaped runs the way the LSP strategy already does, instead of by a regex of its own"
 ~#hex_codes: "colors live in strings, so they stay text to the lexer; an editor color provider can show swatches for #rgb, #rrggbb, and #rrggbbaa inside strings; a bare #8800ff stays a #tag, as #ff8800 is"
 ~#open: "does a unit-kind run stay a NUMBER (with the unit as a property) or become a name, given the canon spelling 48<hours> for quantities; does a digit-led name keep IDENTIFIER"
 ~#needs: "a corpus negative control like 866826ff's: outside the 79 runs, every token is unchanged"
}

// Samples: samples/cut-surface.spw rewrites one tree surface with p8 to p11
// (97 lines and 4037 characters against 108 and 5244, statements and anchors
// identical); samples/receipts-ledger.spw is one p9 journal entry.

^["next_steps"]{
 ~[1]: "lexer/parser spike for #!route(...) payload and #~ evidential aim"
 ~[2]: "cut-gate additions: S0-probe verb lint, $%[… = …] latch diffing, #~derived staleness check"
 ~[3]: "wonder probe about the proposals in src/lang/seeds/probes/ — evolve syntax through the repo's own research loop"
 ~[4]: "owner review of p8 to p11 and their samples; caches-living-tree carries the conventions passes and the resolver work after it"
}

#>wonder_syntax_hardware_alignment_1
?["Which of the seven proposals survives contact with the lexer?"]{
  #:depth #!computational ~#lens(host_contour)
  ~#hypothesis: "The two particle-family extensions (#!route payload, #~ evidential) are cheap because ParticleNode.aim is already a union; the latch slot and probe rings need new payload grammar."
  !probe{ "Spike each proposal against the seed lexer on a branch; record which ones parse with only a token-table change versus a grammar production." }
  $%[proposal.spike_cost, proposal.gate_checkability, particle.aim_union_size]
}
