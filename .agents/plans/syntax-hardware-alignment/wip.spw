#:plan #!public_interest_research
#:layer #!pragmatics

?["card"]{
 phase: #planning
 gist: "Hardware-aligned syntax proposals p1 to p11 — each removes a duplicated wire or adds a missing one — staged as samples before any parser change."
 touches: [~"packages/spw-seed/src/canonical/particles.ts", ~"scripts/analyzers/spw-cut-gate.ts", ~".spw/caches/journal/2026-09-30-gemini-shelf/index.spw"]
 entry: ~"./PLAN.md"
 next: "~[p1_p7_verdicts]: one verdict per p1 to p7 citing tree anchors; the tree already reads p7 superseded, p5 a duplicate of provenance as_of, p3 overlapping probe ids and kinds, p2 blocked on $% parsing, p4 supported, p1 live; spike only p4."
}

^["edges"]{
 shares: [~"../shape-syntax-ecology/wip.spw", ~"../syntax-profile-stack/wip.spw", ~"../directive-lattice/wip.spw", ~"../lukewarm-backlog/wip.spw"]
 feeds: [~"../cli-mode-overhaul/wip.spw", ~"../cli-benchmarking-infra/wip.spw", ~"../apposition-cache-granules/wip.spw", ~"../citation-navigation/wip.spw", ~"../caches-living-tree/wip.spw"]
}

^["roots"]{
 @cluster: ~".agents/plans/plan-ecology-clustering/plan-ecology-clustering.spw"
 @plan: ~".agents/plans/syntax-hardware-alignment/PLAN.md"
 @artifact: ~".agents/plans/syntax-hardware-alignment/syntax-hardware-alignment.spw"
 @particles: ~"packages/spw-seed/src/canonical/particles.ts"
 @cut_gate: ~"scripts/analyzers/spw-cut-gate.ts"
 @cache_root: ~".spw/caches/journal/2026-09-30-gemini-shelf/index.spw"
 @ecology: ~".agents/plans/shape-syntax-ecology/shape-syntax-ecology.spw"
 @stack: ~".agents/plans/syntax-profile-stack/syntax-profile-stack.spw"
 @tree_theory: ~".spw/caches/tree/spw/theory/index.spw"
}

^["intent"]{
 ~#goal: "Evolve the particle paradigm along its own hardware reading (#> anchor=address, #: lens=control, #! focus=strobe, ~# stance=latch) so cache/cut surfaces stop duplicating wires (dispatch tables, path-in-anchor, lens triplets) and gain the missing ones (evidential, metric latch, refresh strobe)."
 ~#taste: "expressiveness and honesty — one signal per wire; playability through hoverable, runnable, derivable views"
}

^["development"]{
 lane: #public_interest_research
 ladder: #language
 develops: [#linguistics, #taste, #design_transfer]
 review_surfaces: [@cluster, @plan, @artifact]
 snippet_routes: [#example, #query, #snippet]
}

^["concept_index"]{
 primary: [#particle_paradigm, #bus_transaction, #evidentiality]
 surfaces: [#seed, #cut_gate, #editor]
 tensions: [#vocabulary_divergence, #banned_patterns, #cache_vs_cut]
 transfers: [#language, #tooling]
}

^["recursive_improvement"]{
 loop: [
  "? reread particles.ts and the cut gate before widening claims",
  "< land one proposal as a catalog-referenceable sample, not law",
  "$ record what the gate can newly check or the editor can newly render",
  "^ fold surviving syntax back into dialect catalog and contract vocabularies",
  "% keep the one-signal-per-wire invariant stable while experimenting",
 ]
 gates: [#claim_discipline, #snippet_reuse]
}

^["parallel_work"]{
 critical_path: [#particle_aim_union]
 parallelizable: [#gate_lints, #probe_authoring]
 shared_hot_files: ["packages/spw-seed/src/canonical/particles.ts", "scripts/analyzers/spw-cut-gate.ts"]
 merge_risks: [#hot_file, #vocabulary_drift]
 handoff_artifacts: [@plan, @artifact]
}

^["supporting_documents"]{
 must_ship: [@plan, @artifact]
 helpful: [@ecology, @stack]
 carries: [#examples, #glossary, #external_contracts]
}

