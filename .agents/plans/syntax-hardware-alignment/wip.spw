#>wonder_syntax_hardware_alignment_1
?["Would an S0 probe verb lint reject real probes, or only the ones nobody runs?"]{
  #:depth #!computational
  ~#hypothesis: "most write-verb hits inside !probe bodies are rhetorical prompts, so a lint on bare !probe{ } prose would drown in false positives and must key on the !probe[S0] form"
  !probe{ "extract single-line !probe{ \"...\" } bodies from .spw, docs and prompts, then count those naming rewrite|write|edit|apply|delete|mutate|patch|stamp|refresh|update|replace|fix; on 2026-10-12 this gave 79 of 1200, and the sampled hits were thinking prompts such as 'rewrite the root frame in biology vocabulary'" }
  $%[probe.body_count, probe.write_verb_hits]
}

#>wonder_syntax_hardware_alignment_spaced_equals
?["Should a spaced = in key position bind, as : does, while a tight =x stays bias?"]{
 #:depth #!syntax ~#lens(comparison)
 ~#hypothesis: "Authors already mean a binding when they space the =: no line in either corpus that opens key = value is a bias edge."
 ~#expect: "Among lines opening key = value, none has an operator-led value that a bias reading would need (=@node, =~\"path\"); the bias uses are all tight."
 ~#unblocks: "~[p13_spaced_equals_fixture]; citation-navigation ?[binding_key_fragments]; plan intake rows that tools can read"
 ~#tension: "= is the bias operator in this repo's canon, and a mark with two meanings by gap is a homonym unless the gap is the meaning, as gap-affinity already treats it"
 !probe{ "count lines opening key = value whose value starts with @ or ~ and compare with tight =@ and =~ uses, in both corpora" }
 $%[binding.spaced, bias.tight, conflict.lines]
}
