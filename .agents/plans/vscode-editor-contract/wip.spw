^["intent"]{
 ~#goal: "Define the VS Code editor contract as the boundary between semantic substrate truth and client surface composition. Name what the editor may ask, what the LSP must own, which payloads are authoritative vs inferred, and how invalidation/refresh should work before more UX surfaces or syntax are added."
 ~#taste: "clarity, layering, naming, claim discipline"
}

