 gist: "The label a brace pair already carries is read by an opt-in pass from either end of a text, beside the parser, with overlap allowed and its meaning held as trials"
 touches: [~"packages/spw-seed/src/experimental/pair-labels.ts", ~"packages/spw-seed/src/experimental/syntax-catalog.ts", ~".agents/plans/interpretation-trials/interpretation-trials.spw"]
 entry: ~"./PLAN.md"
 next: "The owner reads wonder_trial_pair_label, wonder_trial_underscore, wonder_trial_operator_label and wonder_trial_reader_modes. Until then the pass stays experimental and spw.pair-labels/1 may change."
}

^["edges"]{
 shares: [~"../interpretation-trials/wip.spw", ~"../brace-slot-reading/wip.spw", ~"../syntax-hardware-alignment/wip.spw"]
