#>wonder_cli_mode_overhaul_1
?["What is the difference between generate and write?"]{
  #:depth #!computational
  ~#generate: "derived only — scanners skip; sourceSurfaceOf recovers authoring"
  ~#write: "authoring tree — content_hash identity; canon walks include"
  !probe{ "expand --write must stay generate; mass --write is write; atlas HTML must pick one and label it." }
  @derived
}

#>wonder_cli_mode_overhaul_2
?["Where does a planned rewrite live between pulse and mutate?"]{
  #:depth #!experiential
  ~#today: "only in envelope plannedSource or host memory"
  ~#goal: "flow-cache keyed by contentHash+profile; optional *.planned.spw precipitate"
  !probe{ "if the host dies mid-HMR, is the plan recoverable without re-sensing the corpus?" }
  @hot
  @precipitates
}
