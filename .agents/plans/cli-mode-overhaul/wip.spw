^["mode_lattice"]{
 #:depth #!structural
 measure: "observe only — effect.l0.measure"
 preview: "would-be body or diff — l0 or l1.memory; no authoring write"
 stream: "ordered events or saga steps on stdout"
 precipitate: "stage or plan artifact as Spw/JSON intermediate"
 generate: "derived projection only — @gen or .<kind>.spw"
 patch: "addressable structural edit plan"
 write: "durable authoring-tree mutation — effect.l2.workspace"
 cadence: "clock only — no tree effect"
}

^["assumptions_overhaul"]{
 #:revise
 was: [
  "group blurbs imply cost but --write is scattered",
  "verb names stable for muscle memory",
  "JSON shape per command is fine",
  "hot loop re-parses every time",
  "only expanded is a derived kind",
  "plan tools live in bash",
 ]
 becomes: [
  "every command declares modes[] and ceiling",
  "rename free when usage is thin",
  "envelope v1 carries mode + ceiling + optional precipitates",
  "flow-cache holds planned body keyed by hash/profile",
  "derived kinds for planned/patch/precipitate as audit requires",
  "capabilities + plan status on spw binary",
 ]
}

