^["intent"]{
 ~#goal: "Overhaul the CLI around explicit effect modes, intermediate Spw precipitates, and flow caches for hot/patch loops — free to rename underused verbs; agents discover tools by mode and ceiling, not folklore."
 ~#taste: "correctness + clarity + agent affordance + expressiveness"
 ~#premise: "Muscle memory does not exist for unused tools; modes and artifacts must be first-class or every --write is a surprise."
 ~#non_goal: "Do not preserve invent/map/analyze names out of habit; do not touch LSP server-index feature spines here."
 ~#stance_rename: "free — aliases optional for one transition, not sacred"
}

