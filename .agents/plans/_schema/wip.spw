# wip.spw — convention
#
# Structured development stream for agent feature branches.
# Lives at: .agents/plans/<slug>/wip.spw
# Schema at: .agents/plans/_schema/
#
# Design roots:
# Memory management — sections are memory regions with access rules
# Projection design — same document, multiple read patterns
# Diffability — every entry has a stable identity in git

# ──────────────────────────────────────────────
# MEMORY MODEL
# ──────────────────────────────────────────────
#
# Each section maps to a memory region:
#
# working set ^["roots"] ^["intent"] ^["development"] ^["concept_index"] ^["recursive_improvement"] ^["parallel_work"] ^["supporting_documents"] ^["interaction_depth"] ^["risk_model"] ^["validation"] ^["open"] ^["commits"]
# Hot. Actively consulted. Mutable. Risk and validation frames are optional.
#
# stream ^["stream"]
# Append-only log. Warm. Grows monotonically.
#
# cache ^["cache"]
# Derived facts. Recomputed, not hand-edited.
# Enables fast agent context loading (~5 lines).
#
# cold ^["done"]
# Written once at merge. Becomes CHANGELOG source.
#
# Eviction rules:
# - Stream entries are never deleted, only annotated.
# - Open questions are removed when resolved — resolution logged in stream first.
# - Cache is recomputed — never hand-edited.

# ──────────────────────────────────────────────
# DEVELOPMENT FRAME
# ──────────────────────────────────────────────
#
# ^["development"] captures how a branch grows judgment, not just what files it edits.
#
# Standard keys:
# lane: #execution_truth | #public_interest_research | #curriculum_formation | #speculative_editor_future | #rewrite_recovery
# ladder: #language | #component | #page | #service | #bridge
# develops: [#taste, #linguistics, #design_transfer, ...]
# review_surfaces: [@root_ref, @artifact_ref, ...]
# snippet_routes: [#query, #example, #status_copy, ...]
#
# Keep this frame compact. It should read like a developmental contract, not a second plan file.

# ──────────────────────────────────────────────
# ROOTS
# ──────────────────────────────────────────────
#
# ^["roots"] names the files and artifacts that should be reread while the branch evolves.
#
# Standard roots:
# @cluster — the ecology map
# @artifact — the branch-local Spw artifact, if one exists
# @pattern — syntax/pattern source such as literate-ui
# @references — plan-local primary-source braid, typically .agents/plans/<slug>/references/index.spw
# @tooling / @selection / @runtime / @code — task-specific surfaces
#
# Prefer a small set of high-value references over a long inventory.

# ──────────────────────────────────────────────
# CONCEPT INDEX
# ──────────────────────────────────────────────
#
# ^["concept_index"] makes the branch queryable by stable tags rather than only prose.
#
# Standard keys:
# primary: [#main_concepts]
# surfaces: [#editor, #runtime, #docs, #cli, ...]
# tensions: [#risk, #tradeoff, #constraint]
# transfers: [#language, #component, #page, #service]
#
# This frame is where plans become indexable and comparable.

# ──────────────────────────────────────────────
# RECURSIVE IMPROVEMENT
# ──────────────────────────────────────────────
#
# ^["recursive_improvement"] makes the plan self-improving.
#
# Standard keys:
# loop: ["? ...", "< ...", "$ ...", "^ ...", "% ..."]
# gates: [#preview_truth, #snippet_reuse, #claim_discipline, ...]
#
# The loop should tell a contributor how this branch learns from its own changes.

# ──────────────────────────────────────────────
# PARALLEL WORK
# ──────────────────────────────────────────────
#
# ^["parallel_work"] exposes safe concurrency and known merge pressure.
#
# Standard keys:
# critical_path: [#shared_truth, #blocked_surface, ...]
# parallelizable: [#lane_a, #lane_b, ...]
# shared_hot_files: ["path/to/file.ts", ...]
# merge_risks: [#hot_file, #copy_drift, #naming_drift, ...]
# handoff_artifacts: [@artifact_ref, @doc_ref, ...]
#
# This frame should help contributors split work without inventing coordination from scratch.

# ──────────────────────────────────────────────
# SUPPORTING DOCUMENTS
# ──────────────────────────────────────────────
#
# ^["supporting_documents"] names the prose/spec/example surfaces that should evolve with implementation.
#
# Standard keys:
# must_ship: [@artifact, @doc, ...]
# helpful: [@guide, @pattern, @references, ...]
# carries: [#examples, #glossary, #review_notes, #screenshots, #source_map, #external_contracts, ...]
#
# This frame keeps companion literature and supporting surfaces explicit.

# ──────────────────────────────────────────────
# INTERACTION DEPTH
# ──────────────────────────────────────────────
#
# ^["interaction_depth"] forces the branch to name the design subjects worth real attention.
#
# Standard keys:
# subjects: [#navigation, #feedback, #preview, #latency, #trust, ...]
# questions: [#what_is_primary, #what_is_reversible, #what_is_visible, ...]
# qualities: [#clarity, #containment, #rhythm, ...]
#
# This frame is especially useful for editor, UI, CLI, and support surfaces, but can also sharpen language-design work.

# ──────────────────────────────────────────────
# RISK MODEL (optional)
# ──────────────────────────────────────────────
#
# ^["risk_model"] names failure modes before implementation encounters them.
#
# Standard keys:
# hard_failures: []     — prevents the feature from working
# soft_failures: []     — degraded states that need graceful handling
# recoveries: []        — what the system does in response
# non_negotiables: []   — invariants that must hold regardless
#
# This frame is optional but encouraged. Plans that own their failure surface
# before implementation tend to produce better recovery behavior.

# ──────────────────────────────────────────────
# VALIDATION (optional)
# ──────────────────────────────────────────────
#
# ^["validation"] names what the branch must prove, not just what it must build.
#
# Standard keys:
# hypotheses: []        — claims that need empirical verification
# negative_controls: [] — things that must remain unchanged
# demo_path: []         — sequence exercising the feature end-to-end
#
# This frame is especially useful for plans that affect multiple subsystems
# or that make non-obvious correctness claims.

# ──────────────────────────────────────────────
# STREAM SYNTAX
# ──────────────────────────────────────────────
#
# Append operator: >>
#
# >>[YYYY-MM-DD HH:MM] <type> — <content>
#
# Types:
# observe — something noticed in the code
# decide — a choice made (with rationale)
# surprise — something unexpected (the interesting part)
# revise — changing a prior decision (reference the original)
# blocked — waiting on external input
# taste — a craft quality observation (naming, layering, containment)
# rebase — branch rebase checkpoint and base-sha updates
# hygiene — isolation of unrelated drift or tooling-only cleanup
# implement — a concrete change or artifact was added
# verify — a claim was checked by tests, review, or direct inspection
# note — preserved context that should remain queryable but is not a decision
#
# The >> evokes shell append-redirect. Each entry is uniquely keyed
# by timestamp + type, producing clean single-line diffs.

# ──────────────────────────────────────────────
# OPEN QUESTION SYNTAX
# ──────────────────────────────────────────────
#
# ?[label]: "question text"
#
# Short stable key for cross-reference in stream entries.
# Removing a ?[label] line is a clean deletion in git diff.
# The paired >> entry in the stream provides the audit trail.

# ──────────────────────────────────────────────
# COMMIT SYNTAX
# ──────────────────────────────────────────────
#
# ~[N]: "sigil[scope] — human description"
#
# Sigils follow the project commit conventions (see commit-review workflow):
#
# &[scope] — integrate / merge / restructure
# ![scope] — test / verify
# .[scope] — documentation / .spw updates
# ^seed[scope] — new seed or probe
# vocab[scope] — type / naming refactor
# #[scope] — new spec or config
#
# The ~ operator conveys temporal flow — a commit plan is a sequence.
# Numeric keys [N] are stable across edits: reordering means renumbering.
#
# Amendments:
# # ~[N]: "DROPPED — reason"
# # ~[N]: "MERGED INTO ~[M] — reason"
# ~[N]: "wip[scope] — exploratory; may be squashed"

# ──────────────────────────────────────────────
# CACHE
# ──────────────────────────────────────────────
#
# Derived key-value facts — fast context loading for agents entering mid-task.
#
# Standard keys:
# ~#status: "planning | active | blocked | review | done"
# ~#base_ref: "main@<sha> used for branch baseline"
# ~#rebased_at: "timestamp of last successful rebase"
# ~#hygiene_split: "branch/ref used to isolate unrelated drift"
# ~#files_hot: "comma-separated list of files currently being modified"
# ~#next_commit: "N — the next ~[N] to be committed"
# ~#open_count: "number of unresolved ?[] entries"
# ~#last_stream: "timestamp of most recent >> entry"
# ~#taste_debt: "craft concerns noticed but deferred"

# ──────────────────────────────────────────────
# DONE
# ──────────────────────────────────────────────
#
# Written at merge time. Source for CHANGELOG craft entries.
#
# ~#shipped: [list of ~[N] that landed]
# ~#dropped: [list of ~[N] that were cut, with reasons]
# ~#surprised: "narrative of what changed the approach"
# ~#duration: "wall-clock time from first >> to merge"
# ~#taste: "what craft quality improved — naming, layering, containment, etc."

# ──────────────────────────────────────────────
# PROJECTIONS
# ──────────────────────────────────────────────
#
# The same wip.spw supports multiple read patterns:
#
# $["agent prompt"]
# reads: ^["roots"] + ^["intent"] + ^["development"] + ^["concept_index"] + ^["recursive_improvement"] + ^["parallel_work"] + ^["supporting_documents"] + ^["interaction_depth"] + ^["cache"] + ^["open"] + ^["commits"]
# skips: ^["stream"] (too verbose for context windows)
# purpose: agent enters mid-task, orients in ~40 lines
#
# $["human review"]
# reads: ^["roots"] + ^["intent"] + ^["development"] + ^["concept_index"] + ^["recursive_improvement"] + ^["parallel_work"] + ^["supporting_documents"] + ^["interaction_depth"] + ^["commits"] + ^["stream"] (filtered: decide + surprise + taste + verify)
# skips: ^["cache"]
# purpose: reviewer sees decisions, surprises, and craft observations
#
# $["timeline"]
# reads: ^["stream"] (all entries, chronological)
# purpose: replay the development narrative as literature
#
# $["changelog"]
# reads: ^["intent"] + ^["done"]
# purpose: auto-generate a CHANGELOG craft entry at merge time

# ──────────────────────────────────────────────
# TEMPLATE
# ──────────────────────────────────────────────
#
# Copy .agents/plans/_schema/wip-template.spw to .agents/plans/<slug>/wip.spw

#:layer #!pragmatics

#>wonder_agents_plans__schema_wip_1
?["What invariant holds across every frame in wip.spw — convention?"]{
  #:depth #!computational // lens: living system
  $^["_"]@here => %[shared.property]
  ~#hypothesis: "all frames in this file share ____"
  !probe{ "extract the property common to every frame in this file; if none exists, the file may lack cohesion or may be a deliberate collection." }
  $%[plan.commit_count, plan.phase_progress]
}

#>wonder_agents_plans__schema_wip_2
?["What was wip.spw — convention before it was this, and what could it become?"]{
  #:depth #!mathematical // lens: curated collection
  ~#past: "git log --oneline -- .agents/plans/_schema/wip.spw | head -3"
  ~#future: "what frame would you add next?"
  !probe{ "the file's git history IS its evolutionary record; the next natural frame reveals the author's trajectory." }
  $%[plan.commit_count, plan.phase_progress]
  ~<.agents/plans/_schema/wip-template.spw>  // nearest neighbor
}
