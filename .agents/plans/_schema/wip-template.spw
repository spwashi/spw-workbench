# wip — <slug>
# Branch: feature/<slug>
# Started: <YYYY-MM-DD>

#:layer #!pragmatics

^["roots"]{
 # Keep this frame small and queryable.
 # Use it to name the pattern, spec, code, and artifact surfaces that this branch should reread.
 @cluster: ~".agents/plans/plan-ecology-clustering/plan-ecology-clustering.spw"
 @plan: ~".agents/plans/<slug>/PLAN.md"
 @pattern: ~".spw/patterns/literate-ui.spw"
 # Add @references when the branch depends on external language, platform, or protocol contracts.
 # Recommended shape: .agents/plans/<slug>/references/index.spw
 # Add @artifact only once a distilled branch artifact exists.
}

^["intent"]{
 ~#goal: "<why this branch exists — 1-3 sentences>"
 ~#taste: "<which craft quality is being improved>"
}

^["development"]{
 # Keep short. This frame names how the branch grows judgment, not just what it ships.
 lane: #execution_truth
 ladder: #service
 develops: [#taste, #linguistics, #design_transfer]
 review_surfaces: [@cluster, @plan, @pattern]
 snippet_routes: [#example, #query, #snippet]
}

^["concept_index"]{
 # Favor tags and references over long prose.
 primary: [#core_concept]
 surfaces: [#editor, #runtime, #docs]
 tensions: [#drift, #latency, #scope]
 transfers: [#language, #component, #page, #service]
}

^["recursive_improvement"]{
 # The branch should teach a loop, not just accumulate edits.
 loop: [
  "? reread roots and live code before widening claims",
  "< ship one concept-sized artifact, patch, or snippet",
  "$ record what became clearer, indexable, or measurable",
  "^ fold the new truth back into plan, spec, docs, or tool surface",
  "% keep one invariant stable while experimenting",
 ]
 gates: [#preview_truth, #snippet_reuse, #claim_discipline]
}

^["parallel_work"]{
 # Name where safe concurrency exists and where it does not.
 critical_path: [#shared_truth]
 parallelizable: [#lane_a, #lane_b]
 shared_hot_files: ["path/to/file.ts"]
 merge_risks: [#hot_file, #naming_drift]
 handoff_artifacts: [@plan, @pattern]
}

^["supporting_documents"]{
 # Supporting surfaces that should evolve with the branch.
 must_ship: [@plan]
 helpful: [@pattern]
 carries: [#examples, #glossary, #review_notes, #source_map, #external_contracts]
}

^["interaction_depth"]{
 # Subjects that deserve deliberate interaction/design attention.
 subjects: [#navigation, #feedback, #preview, #legibility, #latency, #trust]
 questions: [#what_is_primary, #what_is_reversible, #what_is_visible]
 qualities: [#clarity, #rhythm, #containment]
}

^["stream"]{
 # Append entries chronologically. Never edit prior entries.
 # >>[YYYY-MM-DD HH:MM] <type> — <content>
 # Types: observe, decide, surprise, revise, blocked, taste, rebase, hygiene, implement, verify, note
}

^["open"]{
 # Unresolved questions. Remove when resolved (log resolution in stream first).
 # ?[label]: "question"
}

^["commits"]{
 # Planned commits in order. Use project sigil conventions.
 # ~[N]: "sigil[scope] — description"
 ~[1]: "<sigil>[<scope>] — <description>"
}

^["cache"]{
 ~#status: "planning"
 # Use `main@<sha>` only for current main lineage.
 # Use `historical@<sha>` or `historical-missing@<sha>` for preserved non-main baselines.
 ~#base_ref: "main@<sha>"
 ~#rebased_at: ""
 ~#hygiene_split: "none"
 ~#files_hot: ""
 ~#next_commit: "1"
 ~#open_count: "0"
 ~#last_stream: ""
 ~#taste_debt: ""
}

^["done"]{
 # Written at merge time.
 # ~#shipped: []
 # ~#dropped: []
 # ~#surprised: ""
 # ~#duration: ""
 # ~#taste: ""
}

#>wonder_agents_plans__schema_wiptemplate_1
?["What is the algebraic closure of stream (_schema/wip-template)?"]{
  #:depth #!computational // lens: formal structure
  $^["intent"]@biome => %[formula.measure]
  ~<.agents/plans/_schema/wip-template.spw> // introspect
  !probe{ "measure: how many distinct concepts does this frame bind? what is the ratio of structural operators to content — and what does that density reveal?" }
  $%[plan.commit_count, plan.phase_progress]
}

#>wonder_agents_plans__schema_wiptemplate_2
?["What is the felt rhythm of reading wip — <slug>?"]{
  #:depth #!mathematical // lens: material grain
  $%[line.operator_density, brace.nesting_rhythm] => ~#reading_feel
  ~#structure: "roots → intent → development → concept_index → recursive_improvement → parallel_work → supporting_documents → interaction_depth → stream → open" // frame flow
  !probe{ "read aloud for 30 seconds; where do you pause? pauses mark grain boundaries." }
  ~<.agents/plans/_schema/wip.spw>  // nearest neighbor
}
