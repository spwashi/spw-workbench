# wip — parser-releases
# Started: 2026-10-12

#>plan_parser_releases
#:plan #!execution_truth
#:layer #!pragmatics

!["card"]{
 phase: #active
 gist: "Every release day cuts a dated, immutable set of browser parser builds with a manifest, and spw.quest serves them for other sites to import"
 touches: [~"scripts/release", ~"docs/runtime/md"]
 entry: ~"./PLAN.md"
 next: "Deploy spw.quest and read the banner at ?parser=next; on the 13th, ~[first_release] cuts 2026.10.13 from the release revision and carries it."
}

^["edges"]{
 feeds: [~"../onboarding-quest/wip.spw"]
 shares: [~"../mounted-consumer-tooling/wip.spw", ~"../ecosystem-surface-governance/wip.spw"]
}

^["roots"]{
 @plan: ~".agents/plans/parser-releases/PLAN.md"
 @jsdist: ~"scripts/release/build-js-dist.ts"
 @lite: ~"packages/spw-seed/src/lite.ts"
 @parser: ~"packages/spw-seed/src/parser.ts"
}

^["intent"]{
 ~#goal: "A parser another site can import by a path that never changes, with the workbench revision, sizes and hashes stated beside it"
 ~#taste: "a few fixed rules instead of many paths: a name is a day with at most one suffix, published files never change, only aliases move"
}

^["layout"]{
 names = #[ `YYYY.MM.DD: the release, cut once`, `YYYY.MM.DD-pre.N: tried before the day`, `YYYY.MM.DD-patch.N: a fix to a published day` ]
 order = "within a day pre.N, then the release, then patch.N; across days by day; spw.quest orders names itself, since semver would put -patch.N before the day"
 index = "/parser/ and /parser/index.json: every release and patch, newest first"
 cut = "/parser/<name>/ and manifest.json: what was cut together from one workbench revision"
 file = "/parser/<name>/<variant>.<form>.js, with a .map beside each debug form"
 alias = "/parser/<name>/parser.js: the same bytes as full.min.js"
 latest = "/parser/latest.js: a short-cached redirect to the newest release or patch; for trying, not for importing"
 next = "/parser/next.js: the same for the newest prerelease"
 variants = #[ `full: parse, parseExpression, SPW_PARSER_BUILD`, `lite: the scanner, size-capped` ]
 forms = #[ `min`, `debug (with a source map)` ]
 headers = "dated paths cache for a year and never change; CORS open, cross-origin resource policy, text/javascript"
}

^["open"]{
 # Unresolved questions. When resolved: log in stream, then move to ^["done"] as ~#resolved(label).
 ?[grammar_version]: "The manifest's grammar field carries the spw-seed package version because seed has no grammar version of its own; should seed export one that changes only when the grammar does?"
 ?[more_variants]: "Which consumer would import a lexer-only or reader-kit variant? Each variant is a promise to keep cutting it every release."
 ?[storage]: "Releases sit in git-tracked worker assets and prereleases deploy from gitignored assets; at what size do releases move to R2 with only the manifests kept in git, and should prereleases move there first so any machine can deploy them?"
 ?[import_integrity]: "Integrity covers script and modulepreload tags but not import statements; should the release page recommend an import map, and which browsers honor its integrity section?"
}

^["commits"]{
 # Named, in order. Planned ~[name]; landed .[name](hash). Names are never reused.
 .[release_builder](17b0d6d7): "#[release] — npm run bundle:parser cuts full and lite in min and debug forms with an alias and a spw.parser-release/1 manifest; refuses a dirty tree and refuses to rewrite a published release"
 .[quest_parser_routes](55fb8f75): "+[quest] (site repo) — Serve dated parser releases from spw.quest, and lead the guide with a script you can change, copy or download"
 ~[first_release]: "+[quest] (site repo) — carry release 2026.10.13 from the workbench into spw.quest's assets and verify every hash"
 .[prerelease_builder](a6d69642): "#[release] — bundle:parser --pre cuts a prerelease keyed by revision, ready to try in production"
 .[release_names](749899ee): "#[release] — parser cuts are named for a day: YYYY.MM.DD, -pre.N or -patch.N"
 ~[stamp_matches_manifest]: "![release] — a test holds each file's SPW_PARSER_BUILD stamp to the manifest revision, name, kind, variant and form"
 .[prerelease_routes](051a5a7d): "+[quest] (site repo) — Name parser builds by day, try a prerelease with ?parser=next, and pin /init to a6d69642"
 .[production_parser_switch](051a5a7d): "+[quest] (site repo) — the same commit: ?parser=next|latest|<name> with a banner naming the build"
 .[reader_variant](603f6b59): "#[release] — reader.min.js and reader.debug.js ship the editor's role stream, outline, anchors, and highlightHtml, browser-safe through seed's reader slice"
 .[workbench_variant](b082d500): "#[release] — the parser release gains a workbench build: seed's whole API, the runtime, and the reader, for any page"
}

^["cache"]{
 ~#status: "active"
 ~#base_ref: "main@77599452"
 ~#rebased_at: "2026-10-12"
 ~#files_hot: "scripts/release/build-parser-release.ts, package.json"
