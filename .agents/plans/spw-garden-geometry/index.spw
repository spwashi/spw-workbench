# spw-garden-geometry — surface index
#
# Reading order and ownership for the garden geometry plan package.
# Canon grades: evidence E0|E1|E2 · effects S0|S1|S2|S3 (operational-topography).
# Garden/ecological vocabulary is optional profile language over neutral coordinates.

#:layer #!pragmatics
#:garden #!index

^seed[Spw.Garden.Geometry.Index v:0.1 @profile:Spw.b @intent:plan_surface_catalog]

^["roots"]{
 @plan: ~"./PLAN.md"
 @wip: ~"./wip.spw"
 @artifact: ~"./spw-garden-geometry.spw"
 @topography: ~"../operational-topography/operational-topography.spw"
 @roadmap: ~"../vscode-lsp-roadmap/PLAN.md"
}

^["grades"]{
 evidence: .{
  E0: "deterministic observation from named code path + parse state — may gate ship"
  E1: "recomputable score with published method — footnote required"
  E2: "human/agent judgment — wonder only; never ship gate"
 }
 effects: .{
  S0: "observe / present only"
  S1: "index or format material without semantic rewrite"
  S2: "parser-owned differential edit plan (exact selection)"
  S3: "mutate disk — explicit human/org gate"
 }
 rule: "E grades ≠ S grades; both required on claims that act"
}

^["surfaces"]{
 ~#order: "read plan → artifact → topography → specialized surfaces as needed"

 core: #[
  .{file="./PLAN.md", role="human scope, ladder, roadmap, validation"},
  .{file="./wip.spw", role="stream memory; do not rewrite history entries"},
  .{file="./spw-garden-geometry.spw", role="distilled doctrine index"},
  .{file="./index.spw", role="this catalog"},
 ]

 geometry_kernel: #[
  .{file="./editor-surface-physics.spw", role="prose kinds, brace format, select, cache, plugin"},
  .{file="./path-reference-enhancement.spw", role="ref forest, resolve packet, reverse index"},
  .{file="./register-token-config.spw", role="registers, tokens/colors, config menus/files"},
  .{file="./substrate-organelle-physics.spw", role="substrates, beats, liminal memory, blocks, portals"},
 ]

 domain_org: #[
  .{file="./phd-domain-topography.spw", role="discipline map + reference strata depth"},
  .{file="./org-static-llm-value.spw", role="static×LLM×org×harness value model"},
  .{file="./formula-variant-geometry-utility.spw", role="formula production, variant matrix, workflows"},
 ]

 related_plans: #[
  .{file="../operational-topography/PLAN.md", role="neutral coordinates and evidence law"},
  .{file="../vscode-lsp-roadmap/PLAN.md", role="editor ladder order"},
  .{file="../typescript-perf-audit-infra/PLAN.md", role="tsc measurement sibling"},
  .{file="../typescript-upgrade-ladder/PLAN.md", role="TS 5.9→6→7 pins"},
 ]

 theory: #[
  .{file="../../../docs/theory/spw/operator-brace-composition.spw", role="Act × Bound composition; <> complex"},
  .{file="../../../docs/theory/spw/coupling-constructors.spw", role="tagged boundary algebra"},
  .{file="../../../docs/theory/spw/operators.spw", role="canonical operator map"},
 ]
}

^["implementation_priority"]{
 P0: #[capability_honesty, true_delta, anti_echo_hover, config_settings_schema, resolve_packet_or_target_range]
 P1: #[shape_signature_index, compare_twins, reverse_ref_index, register_snapshot_real, semantic_tokens_v2]
 P2: #[pulse_sop_library, lens_preview, walk_tick, formula_matrix, portable_packets]
 P3: #[prime_packs, mcp_tools, multi_consumer_matrix]
 rule: "coordinates and E0 facts before chrome; S2 plans before multi-file mutation"
}

^["authority"]{
 seed: "parse, pair identity, exact selection, differentials"
 lsp: "revision-addressed observation packets, index, protocol"
 client: "presentation, visibility, menus — no second semantics"
 org_spw: "policy, beds, pulses, primes — not VS Code-only settings"
}
