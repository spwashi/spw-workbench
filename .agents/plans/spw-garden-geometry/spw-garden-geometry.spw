# spw-garden-geometry

#:layer #!pragmatics
#:garden #!geometry

^["roots"]{
 @catalog: ~"./index.spw"
 @plan: ~"./PLAN.md"
 @wip: ~"./wip.spw"
 @roadmap: ~"../vscode-lsp-roadmap/PLAN.md"
 @contract: ~"../vscode-editor-contract/PLAN.md"
 @topography: ~"../operational-topography/operational-topography.spw"
 @topography_docs: ~"../../../docs/theory/spw/operational-topography.spw"
 @cognitive: ~"../vscode-cognitive-surface/PLAN.md"
 @display: ~"../../../packages/spw-lsp/src/handlers/display.ts"
 @server_index: ~"../../../packages/spw-lsp/src/server-index.ts"
 @dialect: ~"../../../.spw/registries/dialect-spec.spw"
 @literate_ui: ~"../../../.spw/patterns/literate-ui.spw"
 @phd_domains: ~"./phd-domain-topography.spw"
 @editor_physics: ~"./editor-surface-physics.spw"
 @substrate_organelle: ~"./substrate-organelle-physics.spw"
 @org_value: ~"./org-static-llm-value.spw"
 @path_refs: ~"./path-reference-enhancement.spw"
 @register_token_config: ~"./register-token-config.spw"
 @formula_variant: ~"./formula-variant-geometry-utility.spw"
 @op_brace: ~"../../../docs/theory/spw/operator-brace-composition.spw"
}

^["orientation"]{
 lane: #public_interest_research
 ladder: #page
 rule: "popover shows what reading cannot; garden stats show how culture grows; handles train taste; metaphors require measures"
 authority: "Seed owns parse and structural truth; LSP assembles revision-addressed observations; garden profiles own presentation, not fact eligibility or effects"
}

^["anti_echo"]{
 suppress_when_visible: [#kind_label, #ambient_full, #onscreen_frame_name, #same_line_pairing_list]
 prefer: [#true_delta, #cross_file_support, #mechanics, #signature_rarity, #projection_stale]
}

^["delta"]{
 model: "deltaEnter = local ∖ parentAmbient; optional deltaExit on scope pop"
 atom_id: "sigil+name"
 compat: "deltaBraids aliases deltaEnter during migration"
 hover_order: [#title_rarity, #delta_enter, #mechanics, #offscreen, #actions]
 knobs: [#deltaMode, #deltaMinAtoms, #atomFormat, #pulse, #lens]
}

^["pulse"]{
 beat: "smallest measured transition"
 pulse: "configured beats on a scope"
 loop: "recurring pulse until stop"
 scopes: [#specific, #category, #lens, #workspace]
 cadence: [#on_save, #interval, #on_idle, #manual]
 budget: [#maxFilesPerBeat, #maxMsPerBeat, #maxConcurrent]
 grade_cap: "auto-run only up to pulse.grade; E2 never auto"
 align: ~".spw/process/hot-reload-loop.spw"
 invariant: "delegate edits to a parser-verified differential; never rewrite unrelated or approximate-only targets"
}

^["lens_query"]{
 query: "SpwPattern + nested structure templates"
 payload_optional: true
 payload_kinds: [#measure, #reindex, #diagnose, #format, #annotate_suggest, #projection_check, #pulse_attach, #noop]
 apply: [#preview, #incremental, #batch]
 batchSize: 8
 dryRun_default: true
 requests: [#lensPreview, #lensApplyTick, #lensCancel]
 safety: "workspace edit preview before mutate; E2 never auto-mutate"
}

^["popover_geometry"]{
 maxLines: 6
 sections: [#title_rarity, #delta, #mechanics, #geometry_offscreen, #actions]
 whenInlays: #mechanics_only
 whenLocalBlock: #delta_first
}

^["profiles"]{
 resolution: [#file_profile, #bed_profile, #workspace_default, #editor_override]
 spw_surface: "#:hover #!profile"
}

^["garden_features"]{
 tree: [#bed_coverage, #canopy_depth, #species_mix, #symmetry, #grain, #graft_points, #weather, #personality]
 file: [#signature_rarity, #pairing_rate, #projection_stale, #analyze_ms, #wonder_density]
}

^["handles"]{
 learnable: [
  #delta_read, #support_read, #pair_read, #brace_read, #cache_read, #cast_read,
  #grain_read, #bed_read, #wonder_read, #extend_read,
  #compare_read, #twin_search, #name_impact, #diff_walk,
  #pulse_run, #lens_preview, #lens_tick, #walk_tick,
  #select_unit_read, #cache_tier_read, #prose_kind_read
 ]
 portable: #lsp_first
 editors: [#vscode_commands, #neovim_commands]
}

^["mechanics"]{
 timing: [#analyze_ms, #scan_complete]
 cache: [#tier, #beatAge, #contentHash]
 projection: [#mold, #cast, #stale]
}

^["brace_symmetry"]{
 objective: [#parser_owned_pairing, #maxDepth, #openCloseCounts, #span, #plateauMax]
 semi: [#depthBudget_profile, #spanImbalance, #nestingEntropy, #nesting_rhythm, #sideMirror, #operator_brace_corhythm]
 taste: [#frame_bilateralism]
 handle: #brace_read
 popover: "depth only if not in inlay; prefer span imbalance and plateau"
 foothold: ~"packages/spw-lsp/src/handlers/analysis.ts"
}

^["measurement_utility"]{
 tests: [#actionability, #non_echo, #stability, #cost, #epistemic_class]
 ranks: {
  P0: [#brace_balance, #true_delta, #projection_stale, #cache_tier]
  P1: [#grain_entropy, #pairing_rate, #span_imbalance, #support]
  P2: [#bed_coverage, #canopy_depth, #personality]
  P3: [#noodle_wonder]
 }
}

^["probe_grades"]{
 E0_objective: "deterministic observation from a named code path and declared parse state"
 E1_semi: "recomputable score + open interpretation — hover with method footnote"
 E2_noodle: "human/agent judgment — wonder only; never ship gate"
 label_rule: "subjective projections must cite objective substrate or declare pure noodle"
}

^["projections"]{
 objective: #deterministic_map
 cached: #objective_plus_freshness
 semi: #score_plus_published_formula
 subjective: #framing_on_measures
}

^["light_tests"]{
 E0: [#brace_physics, #true_delta, #anti_echo_builder, #metric_grade_tags]
 E1: [#span_ranges, #pairing_rate, #entropy_contrast]
 E2: #never_gates_ship
 runner: "npm run test:lsp"
 fixtures: "packages/spw-lsp/src/__tests__/fixtures/garden/"
 reuse: [#analysis_brace_tests, #spw_ls_probe]
}

^["metaphor_bind"]{
 manufacturing: #projection_and_grain
 digital_analog: #ambient_vs_delta
 symmetry: [#pairing_rate, #brace_symmetry]
 higher_order: #named_handles_only
 learnability: #progressive_disclosure
 patterns: #signatures
 extension: #extend_read
 personality: #phase_and_entropy
 performance: #mechanics_section
}

^["culture"]{
 beds: "roots as plots with profiles"
 pruning: "anti-echo and monotony as taste"
 grafting: "path-refs and projections"
 phenology: "remeasure after episodes"
 seed_exchange: "profiles in .spw not editor-only state"
}

^["dev_axes"]{
 lyrical: "path as readable melody — spirit sequence, rhythm, wonder"
 compositional: "assembly — braces, frames, query composition, ONF skeleton"
 semantic: "binding — projection, layer, registers, meaning walks"
 principle: "each affordance answers ≥1 axis and emits a trace"
}

^["walks"]{
 forest: [#path_ref, #annotation_ref, #projection, #import_graft, #braid_pair, #query_hit, #onf_derive, #stage_derive]
 policies: [#melody, #assembly, #meaning, #novelty, #byproduct]
 requests: [#refTree, #walkPreview, #walkTick]
 fuel: [#probe_subjective, #metric_semi, #pattern_query, #spirit_path, #onf_stage]
}

^["traces"]{
 record: [#seed, #policy, #steps, #patternSignature, #noveltyScore, #byproducts]
 patterned: "repeated patternSignature → recipe"
 novel: "high noveltyScore walk"
 derivative: [#onf_child, #gen_cast, #stage_precipitate]
 byproduct: [#diagnostic, #impact_hint, #co_hit, #stale_neighbor]
 precipitate: "beat yields Precipitate {input, output, delta} into TraceRecord"
}

^["naming"]{
 layers: [#surface, #qualified, #signature, #shape, #role, #episode, #prime]
 rename: "coordinate change — name-impact = breakage + role drift"
 anti_echo: "do not restate visible surface name; show qualified address, support, and structural twins"
}

^["compositional_compare"]{
 axes: [#text, #name, #signature, #shape, #assembly, #lineage, #prime_gloss]
 handles: [#compare_read, #twin_search, #name_impact, #diff_walk]
 requests: [#compareLoci, #findTwins, #nameImpact]
 ui: "diff of coordinates not full file dump"
}

^["primes"]{
 rule: "gloss pack not second AST; an assertion needs a coordinate or remains E2 noodle"
 registry: [
  #physical, #chemical, #metaphysical, #alchemical, #biological,
  #geological, #linguistic, #mathematical, #social, #computational,
  #material, #botanical
 ]
 features: [#prime_hover, #prime_compare, #lens_packs, #walk_aliases, #translation_probe, #false_friends]
 footholds: [
  ~"docs/theory/spw/materials-ontology.spw",
  ~"packages/spw-runtime/src/pipeline/stages.ts",
  ~".spw/conventions/naming.spw",
 ]
}

^["phd_instruments"]{
 shared: [#structural_glossary, #method_as_pulse, #twin_related_work, #episode_archaeology, #evidence_grades, #portable_packet, #reference_transect]
 surface: @phd_domains
 disciplines_expanded: "see phd-domain-topography.spw — biology through library science, plus design, law, econ, education, neuroscience, …"
 reference_depth: "each domain elaborates source|structure|relation|time|layout|operation meaning of a reference"
 forbid: [#one_master_metaphor, #interpretation_as_ci, #hidden_uncertainty, #replace_domain_tools, #layout_as_structure]
}

^["domain_profiles"]{
 shared: {
  combinator: #op_brace_seq
  variant: #signature
  address: #frame_path
  selection: #lens_query
  protocol: #pulse
  materialization: #projection
  corpus_measure: #topography_summary
 }
 combinatoric_kb: [#lattice_query, #onf_identity, #recipe_lenses, #rarity_hover]
 longitudinal_craft: [#lineage, #pattern_delta, #selection_lens, #materialized_cast, #versioned_idiom]
 complex_ui: [#literate_ui, #visibility_budget, #component_projection, #incremental_redesign]
 applied_math: [#onf_rewrite, #typed_couplings, #symmetry_hypotheses, #entropy_grain, #graded_observations]
 playbook: [
  "publish combinators as lenses",
  "run bounded development pulses",
  "beds for UI vs math noise budgets",
  "population metrics over file essays",
  "incremental dryRun only",
  "shared handle curriculum",
 ]
 footholds: [
  ~".agents/skills/spw-operator-lattice/SKILL.md",
  ~".agents/skills/spw-math-algorithm-radar/SKILL.md",
  ~".spw/patterns/literate-ui.spw",
  ~".spw/applications/symmetry/symmetry-applications.spw",
 ]
}

^["probes"]{
 !probe{ "If the line already shows #:lens #!intent, does the popover still list them as news?" }
 !probe{ "Can Neovim and VS Code run the same grain-read payload?" }
 !probe{ "Does garden weather change after a week of commits in one bed?" }
}
