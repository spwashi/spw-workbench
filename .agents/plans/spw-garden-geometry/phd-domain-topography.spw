  relation: "precursor→product edges; catalyst as braid partner"
  time: "kinetics series; lab notebook episode"
  layout: "scheme layout not mechanism truth"
  operation: "wash/crystallize/refine/react as stage precipitates; purity via normalize"
 }
 ~#instruments: #[precipitate_trace, stage_pipeline, valence, lab_episode]
 ~#status: "proposed"
}

^["domain.materials"]{
