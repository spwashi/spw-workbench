// ═══════════════════════════════════════════════════════════════
// Shared PhD instruments (portable)
// ═══════════════════════════════════════════════════════════════

^["shared_instruments"]{
 structural_glossary: "surface + signature + shape + prime gloss"
 method_as_pulse: "reproducible assay list with grade and budget"
 related_work_twins: "shape/signature neighbors in garden or mount"
 revision_archaeology: "episode phenology not only git blame"
 evidence_labels: "E0/E1/E2 or topography status on every claim"
 portable_packet: "compare + trace + prime JSON for committee — editor-agnostic"
 reference_transect: "always state which strata a 'reference' includes"
}

^["forbid"]{
 one_master_metaphor: "do not force DNA or reaction or market on every field"
 interpretation_as_ci: "E2 never fails ship"
 hidden_uncertainty: "PhDs need visible grades"
 replace_domain_tools: "Spw coordinates theory/process notes; not ImageJ/R/ELN/field apps"
 layout_as_structure: "without explicit projection"
}

^["handles"]{
 name_impact: "rename as coordinate change"
 compare_read: "diff of naming/composition axes"
 twin_search: "population isomorphism search"
 diff_walk: "two seeds walk until divergence"
 brace_read: "lattice balance/rhythm"
 cast_read: "mold→expression freshness"
 pulse_run: "scoped method beats"
 lens_preview: "structure as query"
 walk_tick: "incremental trace precipitation"
}

// ═══════════════════════════════════════════════════════════════
// Wonder / probes
// ═══════════════════════════════════════════════════════════════

#>wonder_spw_garden_phd_domain_topography_1
?["What is the topographical depth of a single reference in this file?"]{
  #:depth #!computational // lens: formal structure
  ~#method: "pick domain.biology relation vs domain.math operation; list strata touched"
  !probe{ "for one citation in your dissertation draft, name source, structure, relation, time, layout, operation depths — which are empty?" }
  $%[reference_topography.strata]
}

