# PhD Domain Topography
#
# Expanded discipline map for garden/LSP instruments: naming layers,
# compositional comparison, prime gloss packs, and the *topographical depth*
# of a reference (what "this points to" means at each stratum).
#
# Status vocabulary (operational-topography):
#   implemented | measured | proposed | interpretive
#
# @see .agents/plans/spw-garden-geometry/PLAN.md
# @see docs/theory/spw/operational-topography.spw
# @see docs/theory/spw/materials-ontology.spw
# @see .spw/conventions/naming.spw

#:layer #!pragmatics
#:garden #!phd
#:topography #!reference

^seed[Spw.Garden.Phd.DomainTopography v:0.1 @profile:Spw.b @intent:interdisciplinary_reference_depth]

^["roots"]{
 @plan: ~"./PLAN.md"
 @artifact: ~"./spw-garden-geometry.spw"
 @topography: ~"../../../docs/theory/spw/operational-topography.spw"
 @naming: ~"../../../.spw/conventions/naming.spw"
 @materials: ~"../../../docs/theory/spw/materials-ontology.spw"
 @literate_ui: ~"../../../.spw/patterns/literate-ui.spw"
 @query_comp: ~"../../../.spw/patterns/query-composition.spw"
 @loop: ~"../../../.spw/process/loop-observation.spw"
}

// ═══════════════════════════════════════════════════════════════
// Shared topography of a *reference*
// ═══════════════════════════════════════════════════════════════

^["reference_topography"]{
 ~#definition: "A reference is not a single arrow; it is a transect through strata. Depth is multi-axial: source, structure, relation, time, layout, operation (operational-topography)."
 ~#status: "proposed"

 ~#strata: .{
  source: .{
   depth: "glyph → token → span → line/column"
   reference_means: "this text occurrence cites or embeds that span"
   phd_use: "quotation fidelity, figure callout, exact locus in manuscript"
   instruments: [#definition, #documentLink, #rename_surface]
  }
  structure: .{
   depth: "AST path → container pair → frame_path → parse_state"
   reference_means: "this locus is assembled inside that frame / brace topology"
   phd_use: "section nesting, lemma under theorem, specimen under clade frame"
   instruments: [#frame_outline, #assembly_walk, #brace_read]
  }
  relation: .{
   depth: "outgoing → incoming → graph_distance → support population"
   reference_means: "hop count and edge kind (path_ref, projection, braid_pair, …)"
   phd_use: "citation graph, homology map, related-work neighborhood"
   instruments: [#refTree, #walkPreview, #twin_search, #support_read]
  }
  time: .{
   depth: "revision → episode → observation → producer"
   reference_means: "same coordinate at another revision or episode"
   phd_use: "chapter history, assay re-run, fieldnote sequence"
   instruments: [#episode_phenology, #name_impact_over_time, #trace_compare]
  }
  layout: .{
   depth: "gap → indent → cadence → reading projection"
   reference_means: "presentational adjacency (not semantic identity)"
   phd_use: "close reading of lineation; score layout; figure placement"
   instruments: [#layout_observe, #melody_walk]
   caution: "layout depth must not be sold as structural identity"
  }
  operation: .{
   depth: "ONF → port/fixity → effect → cost → trace precipitate"
   reference_means: "derivative or byproduct of a transform (normalize, cast, pulse beat)"
   phd_use: "proof rewrite, process recipe, pipeline stage lineage"
   instruments: [#onf_derive, #stage_derive, #cast_read, #traceList]
  }
 }

 ~#naming_depth: .{
  surface: "string as typed"
  qualified: "framePath › atom"
  signature: "braid multiset + kind mix"
  shape: "ONF / op–brace skeleton hash"
  role: "lens/layer/dialect role"
  episode: "revision + surface hash"
  prime: "gloss pack id (not a second AST)"
 }

 ~#comparison_depth: .{
  E0: "exact name/shape/hash equality — committee-checkable"
  E1: "measured distance with published method — Jaccard, span profile, walk prefix"
  E2: "interpretive analogy — labeled noodle; never ship gate"
 }

 ~#invariant: "No depth axis substitutes for another without an explicit projection (operational-topography)."
}

// ═══════════════════════════════════════════════════════════════
// Prime registry (gloss packs)
// ═══════════════════════════════════════════════════════════════

^["primes"]{
 ~#rule: "Prime is a gloss over shared topography; claims need a coordinate or stay E2."
 ~#registry: #[
  physical, chemical, metaphysical, alchemical, biological, botanical,
  geological, linguistic, mathematical, social, computational, material,
  clinical, legal, economic, aesthetic, pedagogical, infrastructural
 ]
}

// ═══════════════════════════════════════════════════════════════
// Expanded PhD domains
// Each frame: concerns · primes · reference depth (by stratum) ·
// instruments · false_friends · status
// ═══════════════════════════════════════════════════════════════

^["domain.biology"]{
 ~#concerns: #[homology_vs_analogy, reproducibility, developmental_time, specimen_identity]
 ~#primes: #[biological, material]
 ~#reference_depth: .{
  source: "sequence locus, figure panel, methods line"
  structure: "taxon/clade/experiment frame nesting"
  relation: "homology edges vs co-citation; twin-search on trait signatures"
  time: "developmental series, passage number, assay episode"
  layout: "gel/figure adjacency is not homology"
  operation: "pipeline stages as protocol; cast = processed dataset"
 }
 ~#instruments: #[twin_search, expression_cast, phenology_pulse, evidence_grades]
 ~#false_friends: "selection ≠ optimization without shared fitness measure"
 ~#status: "proposed"
}

^["domain.botany"]{
 ~#concerns: #[growth_form, seasonal_sampling, graft_chimaera, canopy_structure]
 ~#primes: #[botanical, biological, geological]
 ~#reference_depth: .{
  source: "herbarium label, plot GPS note, photo id"
  structure: "organ/whorl/stand frames; graft junction as nested container"
  relation: "graft edges, bed adjacency, seed-exchange path-refs"
  time: "phenology seasons, growth rings as episode strata"
  layout: "field sketch spacing interpretive only"
  operation: "growth pulse; prune = anti-echo; canopy depth metric"
 }
 ~#instruments: #[garden_beds, graft_walk, canopy_depth, phenology]
 ~#status: "proposed"
}

^["domain.chemistry"]{
