# vscode-cognitive-surface

#:layer #!pragmatics

^["roots"]{
 @plan: ~".agents/plans/vscode-cognitive-surface/PLAN.md"
 @roadmap: ~".agents/plans/vscode-lsp-roadmap/PLAN.md"
 @contract: ~".agents/plans/vscode-editor-contract/PLAN.md"
 @topography: ~".agents/plans/operational-topography/operational-topography.spw"
 @strip: ~"extensions/vscode-spw/src/context-strip.ts"
 @ecology: ~".agents/plans/shape-syntax-ecology/shape-syntax-ecology.spw"
 @syntax: ~".agents/plans/syntax-profile-stack/syntax-profile-stack.spw"
 @form: ~".agents/plans/form-geometry-editor/form-geometry-editor.spw"
 @flow: ~"docs/theory/spw/mutation-flow-automata.spw"
 @valence: ~"docs/theory/spw/valence-architecture.spw"
}

^["orientation"]{
 lane: #speculative_editor_future
 ladder: #page
 rule: "make expert orientation cheaper; keep delight subordinate to truth and noise budget"
 evidence_rule: "familiarity, joy, readability, and preference are explicit reports or declared studies, never inferred directly from syntax density"
}

^["user_questions"]{
 primary: [
  "where am I in the workspace?",
  "what phase am I in?",
  "what changed?",
  "what is inherited vs local?",
  "what can I ignore right now?",
 ]
}

^["noise_budget"]{
 max_status_slots: 2
 prefer: [#reuse_surface, #badge_over_panel]
 avoid: [#second_console, #always_on_heatmap]
}

^["transform_profiles"]{
 view_only: [#reading, #review, #teaching, #compact]
 disclose: [#source_map, #inverse_or_loss, #omitted_information, #profile_hash]
 diff_value: [#semantic_signal_per_hunk, #stable_anchors, #layout_noise, #reviewer_time, #reviewer_errors]
}

^["idiom_learning"]{
 learner: [#bounded_babble, #questions, #explicit_enjoyment]
 steward: [#impact_explanation, #promotion_choice, #migration_preview]
 preserve: [#examples, #near_misses, #counterexamples, #local_exceptions]
}

// ── Ecology enrichment (2026-07-27) ──────────────────────────

^["shape_literacy"]{
 thesis: "Spw for people who recognize shapes more than phonemes"
 tokens: #[operator_gestalt, brace_kind, charge_tint, depth_luminance]
 dual_read: "vision proposes; AST/plan disposes"
 curriculum: << Spw.b ; Spw.p ; Spw.q ; Spw.m ; Spw.f ; Spw.x ; Spw.t >>
}

^["aerodynamics"]{
 // interpretive — not measured law
 drag: "depth × density × payload"
 lift: "charge × wonder_open"
 wake: "unsealed ∂ | stream_tail"
 status: #interpretive
}

^["anatomy"]{
 . {
  strip: @strip
  reading: #[author, prompt, research, creative]
  disclose: #[dialect, stack, liminal_axis_labels]
  =exp[ id: cognitive.gestalt_tokens , status: proposed , runtimeHook: none ]
  =exp[ id: cognitive.dual_read_policy , status: proposed , runtimeHook: lint ]
 }
}

^["imagination"]{
 ide: "flip reading profile; note disclosure without parse change"
 shot: "brace glow; attention filament; dual-read ports"
 learn: "shape-first day on Spw.b silhouettes"
 falsify: "joy from dwell alone; charge as ONF"
}
