^["intent"]{
 ~#goal: "Define the VS Code cognitive surface for Spw: what experienced engineers should notice, learn, infer, and enjoy when the editor reveals workspace structure, field state, phase, and change over time. Use this surface to turn semantic truth into legible orientation rather than noise."
 ~#taste: "legibility, delight, containment, cross-surface coherence"
}

