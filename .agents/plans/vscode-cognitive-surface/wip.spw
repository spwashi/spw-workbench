}

^["surface_stack"]{
 foundational_rule: "The cognitive surface may be expressive, but it must not invent semantic truth that the contract cannot justify."
 layers: [#substrate_truth, #editor_contract, #surface_composition, #copy, #motion, #comparison]
 active_surfaces: [#status_strip, #workspace_atlas, #concepts_tree]
 candidate_surfaces: [#diff_view, #hover_contract, #breadcrumbs, #comparison_panel, #phase_badges]
 expert_aim: "A programmer fluent in C-style languages should feel that Spw's primitive lexing and structural operators expose a different but coherent reading discipline, not arbitrary novelty."
}

^["alignment_prompts"]{
 ~#how_i_want_spw_to_feel_in_an_editor: "<fill: describe the feeling of editing Spw when the UX is working well>"
 ~#what_should_be_joyful: "<fill: what moments should feel unexpectedly good or clarifying for experienced engineers?>"
 ~#what_should_stay_quiet: "<fill: which kinds of information should rarely surface unless explicitly requested?>"
 ~#what_i_think_the_current_surfaces_teach_well: "<fill: which existing surfaces already point in the right direction?>"
 ~#what_i_think_the_current_surfaces_mis-teach: "<fill: where do the strip/tree/atlas currently imply the wrong ontology or wrong priority?>"
 ~#how_experts_should_read_diffs: "<fill: what should a seasoned engineer learn from a Spw-aware diff beyond inserted/deleted lines?>"
}

^["prompted_review"]{
 ?["What are the primary user questions of the cognitive surface?"]{
  #:depth #!experiential // lens: lived editor use
  !probe{ "Write the smallest set of recurring questions the editor should answer for you without making you context-switch into docs or source code spelunking." }
  ~#your_answer: "<fill>"
 }

 ?["Which current surfaces answer those questions well, poorly, or not at all?"]{
  #:depth #!comparative // lens: present-state audit
  ~#focus_files: "extensions/vscode-spw/src/context-strip.ts, extensions/vscode-spw/src/views/workspace-tree.ts, extensions/vscode-spw/src/views/concepts-tree.ts"
  !probe{ "For each surface: what does it teach, what does it overstate, what does it omit, and what noise does it introduce?" }
  ~#your_answer: "<fill>"
 }

 ?["How should the same truth appear differently across surfaces?"]{
  #:depth #!linguistic // lens: cross-surface composition
  !probe{ "Choose one truth such as cursor context or phase. Then describe the strip version, hover version, tree version, and diff version without changing the underlying ontology." }
  ~#your_answer: "<fill>"
 }

 ?["What should a Spw-aware diff emphasize?"]{
  #:depth #!temporal // lens: change over time
  !probe{ "List structural, semantic, or field-state changes that should read as more important than raw line churn." }
  ~#your_answer: "<fill>"
 }
}

^["review_tables"]{
 ~#surface_taxonomy: "<fill: surface -> primary question -> secondary question -> tolerated noise -> ownership>"
 ~#copy_direction: "<fill: preferred words/phrases, awkward words to avoid, and any provisional vocabulary>"
 ~#variant_comparisons: "<fill: compare alternative representations for strip, atlas, hover, breadcrumb, and diff>"
 ~#expert_personas: "<fill: note at least 2-3 reader types such as C-style systems engineer, language-tooling engineer, and design-language builder>"
 ~#capture_notes: "<fill: describe screenshots or recordings you want to capture later to compare variants>"
}

^["stream"]{
 >>[2026-04-01 00:00] observe — created this wip as a file-as-prompt surface so VS Code UX thinking can accumulate in-repo and be revised against code rather than disappearing into chat memory.
 >>[2026-04-01 00:00] observe — the existing strip, concepts tree, and atlas already expose distinct pieces of a cognitive surface, but they do not yet read as one taught experience.
 >>[2026-04-01 00:00] decide — use this branch to define the user questions, comparison language, and expert-facing delight criteria before broadening the editor surface area.
 >>[2026-04-01 00:00] taste — delight should come from sharper orientation and richer structural reading, not from decorative surface novelty.
 >>[2026-07-20 19:28] revise — operational-topography and editor-contract now own evidence eligibility and effects; cognitive profiles own words, disclosure, render-only rotations, and explicit familiarity or enjoyment studies.
 >>[2026-07-20 19:29] decide — learner babble stays bounded and reversible; steward surfaces explain downstream impact and promotion choices without erasing near misses, counterexamples, or local idioms.
}

^["open"]{
 ?[primary_questions]: "What are the smallest recurring editor questions that should govern the cognitive surface?"
 ?[surface_taxonomy]: "Which surfaces should remain lightweight glimpses and which deserve deeper structured inspection?"
