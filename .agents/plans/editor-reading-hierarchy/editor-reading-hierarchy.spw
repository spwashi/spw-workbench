# Editor Reading Hierarchy
#
# What a reader sees first, second, and on demand in every Spw editor, the cache evidence for each rule, and the owner of each displayed fact.

#>editor_reading_hierarchy
#:layer #!pragmatics

^["tiers"]{
 first: "glyphs, structure, and errors: the parse-derived roles and every lexer or parse error"
 second: "one hover answer about what is under the cursor, then its evidence"
 on_demand: "counts, geometry, runtime trials, and instruments, reached by a lens that acts or a command"
 care: ~".spw/caches/tree/spw/inspection-and-ir.spw#spw_ir_care_mapping"
}

^["rules"]{
 glyphs_first: .{ rule: "color adds only what the parse derives; prose keeps the default foreground", evidence: ~".spw/caches/tree/spw/tokens-and-roles.spw#spw_tokens_floor" }
 one_role_stream: .{ rule: "every layer reads the same role stream from the parse; no layer reads Spw on its own", evidence: ~".spw/caches/tree/spw/tokens-and-roles.spw#spw_tokens_rolespan" }
 anti_echo: .{ rule: "a surface earns space only by showing what the page does not; each fact has one owner", evidence: ~".spw/caches/tree/spw/plugin-theory.spw#spw_plugin_anti_echo" }
 honesty_first: .{ rule: "errors and omissions show before ornament, in every profile", evidence: ~".spw/caches/tree/spw/hosts/lsp-surface.spw#editor_hosts_lsp_diagnostics_gate" }
 declared_modes: .{ rule: "a mode is a declared filter over one role stream and never escalates on its own", evidence: ~".spw/caches/tree/spw/practice-modes.spw#spw_practice_modes" }
 no_hue_alone: .{ rule: "status and valence never ride on hue alone; valence is material, not merit", evidence: ~".spw/caches/tree/spw/hosts/vscode-rendering.spw#editor_hosts_vscode_rendering_merit" }
 lenses_act: .{ rule: "every lens has a unit and an action; every marker navigates", evidence: ~".spw/caches/tree/spw/hosts/lsp-surface.spw#editor_hosts_lsp_lens_labels" }
 derived_ordinals: .{ rule: "commit lines show a derived ordinal and a state role; labels stay the identity", evidence: ~"../local-numbering-vcs/local-numbering-vcs.spw#local_numbering_vcs" }
}

^["fact_owners"]{
 // Seed table; vscode-editor-contract ~[one_owner_per_fact] makes it complete.
 incoming_refs: "anchor lens that opens references; the inlay goes"
 resolved_path: "inlay only when resolution adds a parent hop, an alias, a mount, or an unresolved mark"
 wonder_metrics: "inlay only for facts from elsewhere; counts on the page are not repeated"
 register_phase: "an instrument, not a per-anchor lens"
 frame_counts: "a lens with noun, unit, and plural, or nothing"
 claim_status: "opt-in glyph, never hue"
 lens_action: "vscode-authoring-probe-loop ~[code_lens_commands] owns the executeCommand route for every lens kind"
 index_scope: "apposition-cache-granules owns which files the annotation index holds"
}

^["baseline"]{
 as_of: "2026-10-13"
 at: "e1d96002"
 screenshots: "citation-navigation/wip.spw and caches-cut-2026-09-30/wip.spw in VS Code, the repo-root index.spw in Neovim"
 census: "not yet run; ~[hierarchy_census] writes the numbers here"
}
