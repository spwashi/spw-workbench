# wip — editor-reading-hierarchy
# Branch: feature/editor-reading-hierarchy
# Started: 2026-10-13

#>plan_editor_reading_hierarchy
#:plan #!projection_feedback
#:layer #!pragmatics

@["card"]{
 phase: #active
 gist: "Every editor shows glyphs and errors first, one answer per hover second, and instruments on demand, all drawn from one parse-derived role stream, so a reader can scan a file's topography instead of its chrome."
 touches: [~"packages/spw-lsp/src/handlers/display.ts", ~"packages/spw-lsp/src/handlers/semantic-tokens.ts", ~"extensions/vscode-spw/syntaxes/spw.tmLanguage.json", ~"extensions/neovim-spw/lua/spw"]
 entry: ~"./PLAN.md"
 next: "~[hierarchy_census]: the census on one wip.spw and one theory surface, taken after c3ecbb34 (frame lenses, one incoming owner) and 55e79d2e (citation lenses, anchor trial off, generated banner); then ~[lexer_errors_first]. The role stream then moves to the lexer, ~[role_stream_parity] then ~[roles_from_lex], before any further regex fix to roleTokens."
}

^["edges"]{
 supersedes: [~"../_archive/vscode-cognitive-surface/wip.spw"]
 shares: [~"../vscode-editor-contract/wip.spw", ~"../vscode-authoring-probe-loop/wip.spw", ~"../spw-garden-geometry/wip.spw", ~"../vscode-plugin-performance/wip.spw", ~"../plan-plugin-integration/wip.spw", ~"../citation-navigation/wip.spw", ~"../apposition-cache-granules/wip.spw", ~"../neovim-spw-surfaces/wip.spw", ~"../plan-stream-parse-health/wip.spw"]
 needs: [~"../local-numbering-vcs/wip.spw", ~"../audit-ui-data-models/wip.spw"]
}

^["roots"]{
 @plan: ~".agents/plans/editor-reading-hierarchy/PLAN.md"
 @artifact: ~".agents/plans/editor-reading-hierarchy/editor-reading-hierarchy.spw"
 @display: ~"packages/spw-lsp/src/handlers/display.ts"
 @tokens: ~"packages/spw-lsp/src/handlers/semantic-tokens.ts"
 @grammar: ~"extensions/vscode-spw/syntaxes/spw.tmLanguage.json"
 @caches_hosts: ~".spw/caches/tree/spw/hosts/index.spw"
 @care_ladder: ~".spw/caches/tree/spw/inspection-and-ir.spw#spw_ir_care_mapping"
 @tokens_roles: ~".spw/caches/tree/spw/tokens-and-roles.spw#spw_tokens_rolespan"
}

^["intent"]{
 ~#goal: "A reader opening any .spw file in VS Code, Neovim, or IntelliJ sees structure and errors first, gets one answer per hover, and reaches counts and instruments only on demand; every lens acts, every marker navigates, and no fact is shown twice."
 ~#taste: "anti-echo and one role stream: a surface earns space only by showing what the page does not, and every layer reads the same parse"
}

^["development"]{
 lane: #projection_feedback
 ladder: #service
 develops: [#taste, #interaction, #a11y]
 review_surfaces: [@artifact, @caches_hosts, @care_ladder, @tokens_roles]
 snippet_routes: [#example, #query]
}

^["concept_index"]{
 primary: [#visual_hierarchy, #role_stream, #anti_echo, #noise_budget, #care_ladder]
 surfaces: [#semantic_tokens, #code_lens, #inlay_hints, #hover, #diagnostics, #textmate]
 tensions: [#chrome_vs_answer, #host_parity_vs_host_idiom, #derived_vs_authored]
 transfers: [#component, #service]
}

^["recursive_improvement"]{
 loop: [
  "? rerun the census on the same fixtures before and after each commit",
  "< remove or relocate one surface per commit; add a surface only with an owner and an action",
  "$ record lenses, inlays, and duplicate facts per 100 lines in the stream",
  "^ fold each settled rule into the artifact and the editor contract",
  "% keep capture mode able to switch every lens and inlay off and back exactly",
 ]
 gates: [#anti_echo, #one_owner_per_fact, #honesty_first]
}

^["parallel_work"]{
 critical_path: [#hierarchy_census, #honesty_tier, #stream_prose_text]
 parallelizable: [#frame_lens_units, #resolved_path_hint, #wonder_hint_offscreen, #status_and_palette]
 shared_hot_files: ["packages/spw-lsp/src/handlers/display.ts", "packages/spw-lsp/src/handlers/semantic-tokens.ts", "extensions/vscode-spw/syntaxes/spw.tmLanguage.json"]
 merge_risks: [#display_ts_size, #token_legend_drift, #vscode_plugin_performance_overlap]
 handoff_artifacts: [@plan, @artifact]
}

^["risk_model"]{
 hard_failures: [
  "a token change paints prose again in another host because one layer still reads Spw on its own",
  "a removed lens or inlay was the only route to a fact some workflow needs"
 ]
 soft_failures: [
  "hosts drift: VS Code gains a fix Neovim and IntelliJ do not show",
  "display.ts grows past its craft guard while surfaces move"
 ]
 recoveries: [
  "every removal names where the fact still lives (hover, instrument, or command)",
  "the census runs per host where the host exposes the LSP products"
 ]
 non_negotiables: [
  "errors and omissions are never hidden by a profile",
  "no status or valence is carried by hue alone",
  "capture mode restores every surface exactly"
 ]
}

^["validation"]{
 hypotheses: [
  "H1 lenses and inlays per 100 lines fall by at least half on the census fixtures with no fact lost",
  "H2 stream prose and inline # comments carry zero painted tokens in every host",
  "H3 every remaining lens has a unit and an action, and every fact has one owner"
 ]
 negative_controls: [
  "figures, anchors, and commit refs inside stream entries keep their roles",
  "capture mode toggles off and back with no diff in the surfaces shown"
 ]
 demo_path: [
  "open citation-navigation/wip.spw: stream lines render alike, prose is plain, commits scan by state and derived order",
  "hover an anchor: one answer, then evidence; the incoming count appears once, as a lens that opens references"
 ]
}

^["stream"]{
 >>[2026-10-13 11:53] observe — Owner screenshots in VS Code and Neovim on 2026-10-13: stream lines with identical bytes render plain in one region and colored in another; a method name and bare paths in prose take path color; frame lenses read 7 topic and 1 lens; incoming refs appear as a lens and again as an inlay, naming deleted worktree copies; a header lens reads pragmatics, runtime, 9^, 27#, d1; every root path carries a resolved-path inlay; every wonder carries [? 3 metrics].
 >>[2026-10-13 11:53] observe — A reader pass over the caches tree (spw/hosts, inspection-and-ir, tokens-and-roles, practice-modes, plugin-theory, machine-empathy) and the render and tokens studies, checked against code at e1d96002, traced each screenshot finding to code: the grammar leaves stream prose unscoped and colors any word with a slash (tmLanguage.json lines 422 and 608); a decoration mask opens at any apostrophe and runs across lines (surface-decorations.ts 89 to 109); lens and inlay run the same incoming lookup (display.ts 973 to 990, 1212 to 1234); frame lenses have no unit or plural (display.ts 957 to 969); the resolved-path inlay hides only when it equals the written path (display.ts 1105 to 1131); Neovim forces inlay hints on at attach (lsp.lua 124 to 125).
 >>[2026-10-13 11:53] observe — Honesty gaps sit above the cosmetic ones: lexer errors never reach diagnostics (analysis.ts 53), and the server parses without a file path, so plan dialects are off in the editor (server-index.ts 394).
 >>[2026-10-13 11:53] decide — The hierarchy the caches argue for becomes this plan's rule: errors and glyphs first, color only for what the parse derives, one hover answer before evidence, counts and instruments on demand, every lens acts, one owner per fact, modes as declared filters over one role stream. vscode-cognitive-surface's hierarchy commits move here; spw-garden-geometry keeps pulses and stats; vscode-editor-contract narrows to the gesture and owner tables.
 >>[2026-10-13 11:53] decide — The owner noted that the visual hierarchy of plan commits hides useful topography, and that numbered ~[N] lines once scanned by color while text labels are worth keeping. ~[commit_frame_roles] renders a derived ordinal and a state role for each commit line, by the rule in local-numbering-vcs; nothing in the source changes.
 >>[2026-10-13 15:06] note — commit_frame_roles takes the commit-ref token type from plan-plugin-integration commit_ref_token_type, escalated by the owner on 2026-10-13, so it lands after that commit.
 >>[2026-10-13 15:33] implement — Landed c3ecbb34 ahead of the census: frame lenses count by the syntax a reader sees (#tags, #: lenses, #! focuses, #> anchors, ##> prompt roots, readings) in the plural, and incoming refs show once, as the anchor lens. The header banner moves to its own commit under ?[header_banner]; the census baseline is taken after this commit and says so.
 >>[2026-10-13 17:16] observe — bdd48943 makes Neovim's forced inlay hints a setting (vim.g.spw_lsp_inlay_hints, on by default as before) and draws code lenses in Neovim for the first time, so the frame-lens fix from c3ecbb34 now shows there; wonder_hint_offscreen still owns what the wonder inlay shows.
 >>[2026-10-13 18:13] revise — Cited hashes now take a hashlike token (1ea9ac14) at the owner's request, revising the plan's stance that prose hashes take no color; the token is chosen by form, so tokens never wait on git, and a containing string or comment is cut around the hash instead of losing its role.
 >>[2026-10-13 18:22] implement — Landed 8c745561 at the owner's prompt: the token scanner reads a word as one unit, so 2218 names with digits stop showing numbers inside them, and digit-led runs such as 16px and 2026q4 are one token. Hex codes live in strings across the corpus; string_color_swatches is planned for them.
 >>[2026-10-13 19:17] implement — Landed on fix/concepts-tree-rows (cee49ed5): a Concepts row shows what its parents do not, so under a concept the plan that holds it leads instead of the concept again; the four title actions take icons, so the view name no longer reads C...; You Are Here shows the end of its path. The owner reported it from a screenshot of public_interest_research.
 >>[2026-10-13 19:50] revise — The archived vscode-cognitive-surface left its questions open. primary_questions and surface_taxonomy are answered by this plan's tiers (first: glyphs and errors; second: one hover answer; on demand: instruments). capture_decorations moves here as an open question. cross_surface_copy and expert_joy go to relationship-contours, which now holds Spirit as a contour.
 >>[2026-10-13 20:28] implement — On fix/concept-row-names: a Concepts row now leads with its file name and adds a parent folder only where a sibling shares the name; the folder in front trails the description. cee49ed5 had stripped a shared prefix, which failed when siblings sat in different roots: the owner's claim lens rows read .agents/plans/caches-cut-2026-09-30/refer... cut off before the part that differs.
 >>[2026-10-13 20:52] revise — Two rules from the owner's reading on 2026-10-13: names_first (a path shows its file name first and folders only where they tell siblings apart) and short_claims (one short claim per line or a short list, never hard-wrapped).
 >>[2026-10-13 22:04] note — one_role_stream gains a pure home on feature/reader-bundle: roleTokens(text, path) in semantic-tokens.ts, which the server and the parser release's reader both call.
 >>[2026-10-13 22:09] implement — The Concepts row naming merged to main as 60d40d44, rebased from 6b8026d7: file name first, folders only where siblings share a name, the rest in the description.
 >>[2026-10-13 22:33] note — module-trees plans lsp_display_split with this plan: display.ts (1343 lines) splits into hover, symbols, code-lens, inlay-hints, and highlight, one surface per commit.
 >>[2026-10-25 20:40] note — A mounted consumer asks (2026-10-25, rank 2, spw_in_host_files) for injection grammars where it writes Spw outside .spw files: the data-spw-semantic-expression attribute, a Spw fence in Markdown, and #[episode]{} in a commit message, each squiggled through the same lite scan. vscode-spw/package.json has no injectTo. The question was left open in the landed vscode-lsp-roadmap as ?[beyond_spw_files] and moves here, since this plan owns the grammar and the role stream; the commit view half goes to plan-plugin-integration.
 >>[2026-10-25 21:33] implement — Uncommitted on main 2026-10-25, for consumer ranks 9, 10 and 12: anchor_trial_off done, so no anchor carries a register lens and the trial cache in context.ts reruns on any text change instead of a 2 s TTL; the register count stays only in the sigil hover, named N runtime registers, written by = & * # @. New citation-lenses.ts reads a citation index kept by reference-graph.ts: line 0 reads cited by N files and M citations, a #> anchor reads its own key count, and the old annotation count reads N files repeat this name; a cold index shows nothing, then the server sends workspace/codeLens/refresh when the client supports it. New generated-lenses.ts: the generated banner offers open source (the file @page, else the registry source), rebuild (the registry status command typed into a terminal, never run), and spec. The consumer family file reads cited by 9 files and 17 citations where it read no cross-file refs.
 >>[2026-10-26 12:16] note — anchor_trial_off, citation_lenses and generated_banner_actions landed in 55e79d2e ahead of hierarchy_census, so the census baseline is taken after them and says so, as it already does for c3ecbb34.
 >>[2026-10-26 12:29] observe — Headless Neovim 0.11.6 against spw-lsp, 2026-10-26: semantic tokens draw at priority 125 over syntax/spw.vim, which keeps a group per sigil (spwSigAction, spwSigPotential, spwSigPerspective). The role stream gives ! and ? the type function, told apart only by borrowed modification and async modifiers, and gives ~ and @ the type variable, so potential and perspective paint alike. On line 2 of a backtick phrase a ! in prose paints as an action: lex() reads the phrase as one PHRASE token, while roleTokens and the Vim syntax (oneline) scan by line. About 50 such phrases sit in 22 files.
 >>[2026-10-26 12:29] observe — Seven tokenizers read Spw today: lex(), the lite scan, roleTokens (27 regex branches with no lexer import, feeding the server, the reader bundle and the consumer highlighter), the VS Code TextMate grammar, its IntelliJ copy (188 bytes apart at 17b3a4a2, copied rather than generated), the surface-decorations regex, and syntax/spw.vim. The tree-sitter queries would make eight, but no spw parser exists.
 >>[2026-10-26 12:29] measure — Cost sample 2026-10-26, mean of five runs after a warm-up: life-and-mind.spw (78 KB) lex 71 ms with events off and 84 ms with trace, roleTokens 14 ms; a 5.5 KB surface lex 12 ms, roleTokens 1.2 ms. In the server the lex is already paid, since sourceTokens reuses doc.parseResult.tokens when the parse is current and not dialect-preprocessed, so roles drawn from the parse cost no second lex. Only the reader bundle in a browser pays the full lex.
 >>[2026-10-26 12:29] decide — Tokenizer consolidation lives here, since the gist promises one parse-derived role stream and roleTokens is not one. roles_from_lex maps parse tokens to roles; stream_prose_text, inline_hash_comment and path_color_parsed_only then land as role mappings on that stream, not as new regex branches. Operator identity enters the legend as modifiers named from the audit-ui-data-models table, and neovim-spw-surfaces maps them to highlight groups.
 >>[2026-10-26 12:29] taste — A layer that knows more must not be painted over by one that knows less: per-sigil identity lives only in the regex layers today, and the parse-derived layer erases it on top.
 >>[2026-10-27 10:19] revise — The commit block now runs in the PLAN.md order, since order is block position: role_stream_parity and roles_from_lex follow path_aware_parse and precede the three role mappings (stream_prose_text, path_color_parsed_only, inline_hash_comment), then operator_modifiers and particle_roles, as decided 2026-10-26 12:29; citation_lenses and generated_banner_actions sit beside anchor_trial_off, which landed with them in 55e79d2e.
 >>[2026-10-27 10:22] revise — Correction to the 2026-10-26 12:29 tokenizer count: the IntelliJ TextMate grammar is not a hand copy. extensions/intellij-spw/scripts/sync-grammar.mjs generates it from the VS Code grammar since 17b3a4a2, and sync-grammar.mjs --check passes on 2026-10-27; the 188 bytes are the provenance comment the generator writes. Six tokenizers read Spw on their own, and the IntelliJ grammar follows the VS Code one.
 >>[2026-10-27 13:00] note — Honesty gap beside lexer_errors_first, found 2026-10-27: a parse that degrades to prose reports success with a warning the editor never shows (analysis.ts publishes only failed parses). degradation_diagnostic publishes it; severity follows plan-stream-parse-health ?[degradation_severity].
 >>[2026-10-27 13:29] decide — Line and block hints, filed at the owner request on 2026-10-27. A new hint states a fact the page does not (git, another frame, the parser reading), appears only when something has drifted or is far away, carries a fix when it reports drift, and derives from the parse, the outline ranges or git, never a new scanner; wrongness is a diagnostic, not a hint. On a healthy file the count falls: drift hints are zero, depth markers shrink to far-closer hints, path hints appear only on bare refs. hierarchy_census measures it before and after.
 >>[2026-10-27 13:29] revise — resolved_path_hint narrows to one owner: the basis a bare or root-relative path resolved through is citation-navigation path_basis_hint (2026-10-27), so this commit keeps only the unresolved-target hint and the settings rule, and the echoing => path label goes.
 >>[2026-10-27 13:52] observe — Owner screenshot of a mounted consumer plan in VS Code, 2026-10-27, reproduced with the workbench ServerIndex on that file: an open line holding ~./wip.spw#wonder_<label> shows the hint => .agents/plans/<slug>/wip.spw, the file the reader is in; the status strip reads facet #>wonder_<label> on a stream entry (line 21) that only mentions the anchor in prose, line 20 gets #folio-request the same way, and the question that #> anchor binds (line 40) shows no facet. lineContexts count a figure mentioned in prose as an active braid, and a bound node does not inherit its anchor.
}

^["open"]{
 ?[bare_path_color]: "In prose, does a word with a slash take no path color at all, or path color only when it names a file that exists in the workspace?"
 ?[header_banner]: "Does the header banner become plain words answering where am I, or go entirely?"
 ?[capture_decorations]: "Which decorations stay on camera in the capture profile: semantic colours and brace highlights only, or also the context strip? Carried from the archived vscode-cognitive-surface, where it was left open."
 ?[beyond_spw_files]: "Which host is first: a route attribute or the commit episode? Carried from vscode-lsp-roadmap and reheated by a mounted consumer on 2026-10-25."
 ?[generated_without_lenses]: "The edit warning learns a file is generated from its lenses, so capture mode or spw.codeLens.enabled=false silences it. Does a small request earn its place to remove that dependency?"
 ?[modifier_or_type]: "Does operator identity ride as a modifier on operator, so a theme that knows only operator still paints, or as one token type per operator, which reads simpler in theme rules but drops generic themes? Modifiers are the recommendation: 6 existing, 13 operators and 3 particles make 22 of the 32 a bitset holds."
 ?[dialect_tokens]: "A dialect-preprocessed parse has token offsets that no longer match the source: does the role stream lex the raw text there, or does the preprocessor carry a source map so plan files read through their dialect?"
 ?[far_closer_distance]: "How far below its opener must a closing brace sit before it names its frame: a fixed count such as 25 lines, or off-screen by the visible range the client sends with each inlay request? Decides far_closer_hint."
}

^["commits"]{
 .[plan](3ad13875): ".[plans] — editor-reading-hierarchy plans one reading hierarchy across editors"
 ~[hierarchy_census]: "![lsp] — census on one wip.spw and one theory surface: lenses, inlays, and duplicate facts per 100 lines, and tokens painted inside stream prose and # comments, per profile"
 ~[lexer_errors_first]: "&[lsp] — lexer errors reach diagnostics as the first tier (analysis.ts drops them today)"
 ~[path_aware_parse]: "&[lsp] — the server parses with the file path, so plan dialects and stream entries read as the CLI reads them"
 ~[role_stream_parity]: "![lsp] — a corpus check that no operator role falls inside a span the lexer reads as PHRASE, STRING or COMMENT, over every .spw file; the 22 files with multi-line phrases are its first failing fixtures"
 ~[roles_from_lex]: "&[lsp] — roleTokens maps the parse tokens (the server parseResult, else lex with events off) to roles in place of 27 line regexes; a multi-line phrase is one string; commit refs and hashlike still overlay; the reader bundle and the consumer highlighter inherit it"
 ~[stream_prose_text]: "&[lsp] — the token scanner reads plan streams as entries, so stream prose is text and only figures take a role; the decoration mask stops opening at apostrophes across lines"
 ~[path_color_parsed_only]: "&[grammar] — path color only on parsed path refs; the word-with-a-slash rule goes, per ?[bare_path_color]"
 ~[inline_hash_comment]: "&[lsp] — the token scanner treats inline # prose as a comment to the end of the line, as the grammar already does"
 ~[operator_modifiers]: "#[lsp] — the legend carries one modifier per OperatorKind, named from the operator table; every sigil token carries its operator, so clients paint action, wonder, potential and perspective apart instead of borrowing function, async and variable"
 ~[particle_roles]: "&[lsp] — #> anchor, #: lens and #! focus carry anchor, lens and focus modifiers over keyword and declaration"
 .[frame_lens_units](c3ecbb34): "&[lsp] — frame lenses name what they count, in the plural, and incoming refs show once, as the anchor lens"
 .[one_owner_incoming](c3ecbb34): "&[lsp] — frame lenses name what they count, in the plural, and incoming refs show once, as the anchor lens"
 ~[header_banner]: "&[lsp] — the header banner speaks plain words or goes, per ?[header_banner]; split from frame_lens_units, which landed the frame lenses only"
 .[anchor_trial_off](55e79d2e): "&[lsp] — anchor lenses stop running a runtime trial per anchor; register and phase move behind an instrument"
 .[citation_lenses](55e79d2e): "&[lsp] — line 0 and each #> anchor count the files that cite them by path and key from a warm citation index; the annotation count is the second count, named; cold shows nothing (consumer rank 9)"
 .[generated_banner_actions](55e79d2e): "&[lsp,vscode] — the generated banner opens the page a tree was read from and types its rebuild; the first edit to a generated file warns with both (consumer rank 12)"
 ~[resolved_path_hint]: "&[lsp] — the => path inlay goes; an unresolved target keeps a hint, the basis a bare or root-relative path took is citation-navigation path_basis_hint, and depth and incoming inlays obey the frames and annotations settings"
 ~[wonder_hint_offscreen]: "&[lsp] — the wonder inlay drops counts visible on the page and shows only facts from elsewhere; Neovim stops forcing inlay hints on at attach"
 ~[hover_layers]: "&[lsp] — hover answers what is under the cursor first, then evidence, then geometry, and never restates the hovered line (from vscode-editor-contract hover_answers_position and spw-garden-geometry anti_echo_hover)"
 ~[commit_frame_roles]: "&[lsp] — in ^[commits], a label takes a role by state (planned, landed, dropped), a derived ordinal shows before it, the commit id dims, and the description reads as text"
 ~[profiles_as_modes]: "#[lsp] — reading profiles are declared filters over one role stream, set by one server setting; VS Code capture mode becomes a client of it"
 ~[status_and_palette]: "&[vscode] — claim status as opt-in glyphs, never hue; a valence palette that passes WCAG AA and drops the hazard label for bane"
 ~[census_after]: "![lsp] — rerun the census; record the fall in lenses, inlays, duplicates, and painted prose against ~[hierarchy_census]"
 ~[string_color_swatches]: "&[lsp] — a documentColor provider shows swatches for #rgb, #rrggbb, and #rrggbbaa inside strings, where colors live; a bare #8800ff stays a #tag"
 ~[host_injections]: "&[grammar] — injection grammars for an HTML semantic-expression attribute, a Markdown spw fence, and a commit episode block, each read through the lite scan (consumer rank 2)"
 ~[degradation_diagnostic]: "&[lsp] — analysis.ts publishes parse warnings, prose-degradation first, at the position the structured parse stopped; today only a failed parse publishes (analysis.ts 51 to 75)"
 ~[far_closer_hint]: "&[lsp] — a closing brace far below its opener names the frame it closes, from the outline ranges; the depth-3 brace markers and countBracesOutsideStrings go"
 ~[degraded_region_roles]: "&[lsp] — after roles_from_lex and plan-stream-parse-health degradation_stop_position: the span after a prose-degradation stop paints as text, and the enclosing frame header carries one lens naming the stop line and token that jumps there"
 ~[redundant_stamp_fade]: "&[lsp] — a [reg=] stamp that restates its container default fades as unnecessary, with a fix that removes it; conditional on syntax-hardware-alignment ?[register_from_container]"
 ~[learner_first_use_hints]: "&[lsp] — under a learning profile only, the first use of each sigil and particle in a file carries its word from the operator table; after profiles_as_modes and audit-ui-data-models table_words_export"
 ~[same_file_ref_hint]: "&[lsp] — a ref into the same file hints its target line and, for a wonder, its question and what it unblocks; never the path of the file the reader is in"
 ~[context_bindings]: "&[lsp] — line context tells a particle declaration (a line-start run that binds forward) from a figure mentioned in prose: stream-entry figures stay links, not facets, and the node a #> anchor binds inherits it, so the status strip names what a line is under"
}

