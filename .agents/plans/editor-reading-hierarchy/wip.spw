^["intent"]{
 ~#goal: "A reader opening any .spw file in VS Code, Neovim, or IntelliJ sees structure and errors first, gets one answer per hover, and reaches counts and instruments only on demand; every lens acts, every marker navigates, and no fact is shown twice."
 ~#taste: "anti-echo and one role stream: a surface earns space only by showing what the page does not, and every layer reads the same parse"
}

^["development"]{
 lane: #projection_feedback
 ladder: #service
 develops: [#taste, #interaction, #a11y]
 review_surfaces: [@artifact, @caches_hosts, @care_ladder]
