}

^["concept_index"]{
 primary: [#visual_hierarchy, #role_stream, #anti_echo, #noise_budget, #care_ladder]
 surfaces: [#semantic_tokens, #code_lens, #inlay_hints, #hover, #diagnostics, #textmate]
 tensions: [#chrome_vs_answer, #host_parity_vs_host_idiom, #derived_vs_authored]
