#:layer #!pragmatics

^["roots"]{
 @cluster: ~".agents/plans/plan-ecology-clustering/plan-ecology-clustering.spw"
 @plan: ~".agents/plans/neovim-spw-surfaces/PLAN.md"
 @mount_plan: ~".agents/plans/mounted-consumer-tooling/PLAN.md"
 @lsp_plan: ~".agents/plans/lsp-custom-request-completions/PLAN.md"
 @topography: ~".agents/plans/operational-topography/operational-topography.spw"
 @audit: ~".spw/tooling/editor-surface-audit.spw"
