 @nvim_ftplugin: ~"extensions/neovim-spw/ftplugin/spw.vim"
 @nvim_readme: ~"extensions/neovim-spw/README.md"
}

^["intent"]{
 ~#goal: "Audit and strengthen Neovim's native LSP behavior from an identity-free mounted consumer; add semantic UI only where evidence demonstrates a gap."
 ~#taste: "native affordances, graceful degradation, evidence-led scope"
}

^["development"]{
 lane: #execution_truth
 ladder: #component
 develops: [#neovim_capability_evidence, #mounted_consumer_startup, #native_lsp_contract]
 review_surfaces: [@cluster, @plan, @mount_plan, @lsp_plan, @topography, @audit, @nvim_plugin]
 snippet_routes: [#headless_probe, #root_resolution, #failure_evidence]
}

^["concept_index"]{
 primary: [#startup, #root_discovery, #diagnostics, #navigation, #folding, #inlay_hints]
 surfaces: [#neovim, #native_lsp, #quickfix, #commands]
 tensions: [#graceful_degradation, #root_authority, #runtimepath_resolution, #parity_assumption]
 transfers: [#component, #language, #instrument]
}

^["recursive_improvement"]{
 loop: [
  "? inventory runtime loading, commands, LSP configuration, and tests",
  "< run a headless probe from an identity-free mounted consumer",
  "$ record configured, invoked, observed, and tested states",
  "^ close portability or documentation gaps with native APIs",
  "% add custom protocol surfaces only when the shared LSP audit earns them",
 ]
 gates: [#consumer_root_authority, #server_reachable, #failure_visible, #repeatable_test]
}

^["parallel_work"]{
 critical_path: [#surface_inventory, #mounted_consumer_probe]
 parallelizable: [#documentation_audit, #failure_mode_audit]
 shared_hot_files: ["extensions/neovim-spw/lua/spw-lsp.lua"]
 merge_risks: [#command_name_collision, #runtimepath_assumption, #client_server_drift]
 handoff_artifacts: [@plan, @nvim_readme]
}

^["supporting_documents"]{
 must_ship: [@plan, @nvim_readme]
 helpful: [@mount_plan, @lsp_plan, @audit]
 carries: [#capability_matrix, #headless_probe, #root_contract]
}

^["audit_surface"]{
 evidence_states: [#advertised, #configured, #invoked, #observed, #tested]
 standard_features: [#diagnostics, #definition, #references, #rename, #code_actions, #folding, #inlay_hints]
 existing_commands: [#restart, #stop, #open_ref, #peek_ref, #refs_quickfix, #code_action]
 conditional_surfaces: [#custom_requests, #native_float, #statusline_component]
}

^["stream"]{
 >>[2026-04-02 00:00] observe — the plugin already uses standard LSP methods and exposes restart, stop, navigation, quickfix, folding, inlay-hint, and code-action affordances.
 >>[2026-04-02 00:00] decide — earlier planning skipped verification of that baseline and jumped directly to speculative custom-request panels.
 >>[2026-07-20 15:24] revise — audit native behavior and mounted-consumer startup first; custom requests and presentation parity are now conditional on evidence.
 >>[2026-07-26 18:50] complete — modularized neovim-spw into lua/spw/ (init, lsp, navigation, commands, health); added :checkhealth spw provider; added headless smoke test.
}

^["open"]{
}

^["commits"]{
