^["intent"]{
 ~#goal: "Unify the `#` directive family — ⟨stance⟩#⟨aim⟩name — into one lexed, structured token lattice so #> anchors become addressable nodes: linguistic support for enhanced indexing, discoverable referential patterns, and new patterns for encoding structured relationships. Fragment resolution (~\"file#anchor\") rides on it."
 ~#taste: "expressiveness + cognitive modeling — constructs that invite wonder about language features; the lattice makes the combinatorics (prefix stance × postfix aim) legible and open instead of four special cases plus prose fallback"
}

^["concept_index"]{
 primary: [#directive_lattice, #anchor_node, #fragment_resolution, #stance_aim_slots]
