 tensions: [#prose_fallback, #roundtrip_safety, #rename_scope, #blast_radius]
 transfers: [#indexing, #module_exports, #macro_substrate, #deep_links]
}

^["survey"]{
 # Corpus usage counts, 2026-07-23 (grounding for design + renames):
 ~#anchor_marks: "#> ×593 — one per canonical file + wonder probes"
 ~#classify_marks: "#: ×1051 — top: layer(208) depth(172) status(30) template(22)"
 ~#assert_marks: "#! ×1026 — top: pragmatics(107) creative(67) experiential(41)"
