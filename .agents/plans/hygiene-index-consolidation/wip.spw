^["intent"]{
 ~#goal: "Close four honesty gaps — dirty trees, fragile docs, unindexed plans, and an ecology whose caches lag main — so agents and humans can trust status, refs, and next-commit without archaeology; make documentation referentiality checkable; align the CLI for verb honesty, composable JSON, Spw-nativity, and agent discovery."
 ~#taste: "correctness + clarity + layering + disclosure + resolution + agent affordance"
 ~#premise: "A claim about the workspace that nothing recomputes is fiction with good typesetting; a path that exists only in English is a rumor."
 ~#non_goal: "Do not implement feature spines (granules, shapeFingerprint, beat TTL) or Appendix A language products under this slug."
}

