// Four pillars — each a dimension with stance, measure, verb

^["pillars"]{
 #:depth #!structural

 hygiene: .{
  answers: "what must not appear as work?"
  over: "emit paths, ignore rules, scratch parks"
  collision: "noise — status becomes unreadable"
  machine: "tsconfig outDir + .gitignore + clean-tree gate"
  verbs: [#ignore, #relocate_emit, #delete_untracked, #document_rule]
  axis: #noise
 }

 documentation: .{
  answers: "do declared paths and fragments still resolve?"
  over: "tilde refs, root maps, writerside topics, archive moves, expression exhibits"
  collision: "silent rot — links look authoritative and land nowhere"
  machine: "spw-path-check + writerside-check + graded severity g0-g5"
  verbs: [#resolve, #grade, #fixture, #strict_gate, #exhibit]
  axis: #disclosure
  norms: [@referentiality, @references]
  grades: [#g0_parse, #g1_local_ref, #g2_fragment, #g3_inbound, #g4_shape, #g5_writerside]
  authoring_floor: "new docs ≥ path ref d1; indexes ≥ root alias d2"
 }

 indexing: .{
  answers: "where does a plan or surface live, and who depends on it?"
  over: "plan slug, cluster lane, inbound refs, hot files"
  collision: "two indexes for one fact — drift is guaranteed"
  machine: "plans/index.spw + refresh derivers + optional atlas view"
  verbs: [#route, #derive, #hub, #collide]
  axis: #resolution
 }

 consolidation: .{
  answers: "what is still active, and what is finished or stranded?"
  over: "status tokens, next_commit, archive, relocation"
  collision: "urgency theater — fifty plans compete as one queue"
  machine: "plan-ecology-clustering lanes + maintenance sweep + schedule notes"
  verbs: [#refresh, #archive, #relocate, #schedule, #close]
  axis: #stability
 }
}

^["dimensions"]{
 #:depth #!mathematical
 # Orthogonal axes that every pillar deforms. Named so a commit can cite one.

 resolution: .{
  ~#low: "whole-ecology blur — status is a feeling"
  ~#high: "per-slug status, next_commit, hot files, cluster lane"
  instruments: [#plan_index, #spw_refresh, #spw_plan_check]
 }

 disclosure: .{
  ~#low: "docs assume you already know the path"
  ~#high: "broken refs fail a gate; indexes name the entrypoint"
  instruments: [#path_check, #writerside, #canon_index]
 }

 stability: .{
  ~#low: "caches lie after every merge"
  ~#high: "refresh is a fixpoint; streams append; status tokens parse"
  instruments: [#cache_block, #status_vocab, #append_only_stream]
 }

 noise: .{
  ~#low: "git status is a signal"
  ~#high: "generated siblings drown real edits"
  instruments: [#gitignore, #outDir, #scratch_park]
 }

 affect: .{
  ~#low: "maintenance feels like bureaucracy"
  ~#high: "maintenance feels like the repo got quieter and more legible"
  instruments: [#demo_sequence, #before_after_status]
 }
}

^["status_vocab"]{
 #:naming #!token
 # Cache status values — one token, no prose paragraphs (seed-roundness lesson).

 planning: "filed; no implementation commits yet"
 active: "commits in flight on a feature branch or main slice"
 review: "implementation present; remainder or closeout needed"
 verifying: "gates running; claims under check"
 blocked: "explicit external blocker named in open"
 stranded: "predicted paths are ghosts; not declared done"
 needs_relocation: "intent lives; targets moved to packages era"
 done: "stream closed; archive eligible"
 archive: "under _archive; live refs must not point at old path"
}

^["consolidation_verbs"]{
 #:process #!maintenance

 refresh: .{
  does: "recompute derived cache fields from the surface"
  owns: [@refresh]
  must_not: "rewrite stream history"
 }

 archive: .{
  does: "move finished plans to _archive and repoint tilde refs"
  requires: "own stream says done, or every path is ghost and no relocation wanted"
 }

 relocate: .{
  does: "rewrite Files paths onto packages without changing goal"
  example: "brand-core-ids"
 }

 schedule: .{
  does: "record collision order without implementing either side"
  example: "apposition-cache-granules before spw-beat-diff-precipitation"
 }

 close: .{
  does: "mark review to done, write done block, archive in a follow-up commit"
 }

 recluster: .{
  does: "assign cluster lane without rewriting commit lists"
  owns: [@cluster]
 }
}

