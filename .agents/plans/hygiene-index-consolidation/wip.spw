 ~[plan_status_cli]: "&[cli] — ecology plan status/check on the spw binary with envelope-friendly --json (write-ceiling honesty in mass/refresh help is carried by cli-mode-overhaul ~[migrate_writers])"
 ~[ship_gate]: "![hygiene] — ship gate: clean status, refresh fixpoint, lint:docs:strict, spw plan status --json smoke"
}

^["cache"]{
 ~#status: "active"
 ~#base_ref: "main@551bb419"
 ~#rebased_at: "2026-10-12"
 ~#hygiene_split: "self — this plan is the hygiene split; feature spines stay out"
 ~#files_hot: ".gitignore, scripts/analyzers/spw-path-check.ts, packages/spw-cli/src/refresh.ts, packages/spw-cli/src/commands.ts, .agents/plans/directive-lattice/wip.spw, .agents/plans/index.spw"
 ~#next_commit: "align_cache_status"
 ~#open_count: "4"
 ~#last_stream: "2026-10-12 15:28"
 ~#taste_debt: "multi-plan status UX not designed — summary-by-status is a guess until ~[plan_status_cli] sketches output; Appendix A language products, full envelope migration, and capabilities/review remain out of scope but will keep tempting scope creep"
}

^["done"]{
 # Written at merge time.
 ~#resolved(d_ts_root_cause): "Are src/*.d.ts from a mis-invoked tsc (wrong rootDir) or an editor/tsserver emit? — a bare tsc run without the package project; the fix was ignore-only (.gitignore comment); evidence: 08e2bc1c and the 2026-10-12 revise stream entry"
 ~#dropped(ignore_scratch): "the .scratch half of the declaration-noise commit is moot: no .scratch directory exists and no ignore entry is needed; evidence: stream 2026-10-12 14:36 observe"
}

#>wonder_hygiene_index_consolidation_1
?["What is the algebraic closure of the four pillars?"]{
  #:depth #!computational
  $^["pillars"]@plan => %[formula.measure]
  ~<.agents/plans/hygiene-index-consolidation/wip.spw>
  !probe{ "measure: hygiene x docs x index x consolidation — which pairs commute? which require order? refresh before archive; ignore before index truth." }
  $%[plan.commit_count, plan.phase_progress, ecology.active_count]
}

#>wonder_hygiene_index_consolidation_2
?["Is spw refresh over .agents/plans a fixpoint, or does a second run still edit caches?"]{
  #:depth #!computational // lens: derived-fact stability
  ~#hypothesis: "a second spw refresh --write produces zero edits, because open_count and last_stream are pure functions of each plan's own frames"
  !probe{ "npm run spw:refresh -- .agents/plans (dry run, count plan files listed); apply --write to one copied plan directory only; rerun the dry run and compare the list" }
  $%[plan.commit_count, plan.phase_progress]
}

#>wonder_hygiene_index_consolidation_3
?["When does an index become a second cache that lies?"]{
  #:depth #!experiential
  ~#failure: "plans/index.spw copies status tokens by hand; wip.spw moves; index stays heroic"
  !probe{ "npm run spw:plan:index -- --check exits 1 when a card edit leaves the index stale; hand-change one status token in a row of a scratch copy of the index and confirm the check or a regeneration overwrites it" }
  @surface_identity: ~".spw/patterns/surface-identity.spw"
  %keep{ "collision semantics: index key collision is a namespace error, not a finding" }
}
