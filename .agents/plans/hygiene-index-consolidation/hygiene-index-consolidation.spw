# Hygiene Index Consolidation
#
# Maintenance grammar for a workbench that must tell the truth about itself.
# Four pillars share one ship gate and one ecology census.

#>spw_plan_hygiene_index_consolidation
#:pattern #!maintenance
#:layer #!pragmatics
#:depth #!operational

^"roots"{
 @plan: ~"./PLAN.md"
 @wip: ~"./wip.spw"
 @cluster: ~"../plan-ecology-clustering/plan-ecology-clustering.spw"
 @surface_identity: ~"../../../.spw/patterns/surface-identity.spw"
 @maintenance: ~"../../../.agents/skills/spw-plan-maintenance/SKILL.md"
 @path_check: ~"../../../scripts/analyzers/spw-path-check.ts"
 @refresh: ~"../../../packages/spw-cli/src/refresh.ts"
 @canon_index: ~"../../../.spw/index.spw"
 @references: ~"./references/index.spw"
 @referentiality: ~"./references/documentation-referentiality.spw"
 @cli_alignment: ~"./references/cli-verb-alignment.spw"
}

^"pillars"{
 #:depth #!structural

 hygiene: .{
  answers: "what must not appear as work?"
  over: "emit paths, ignore rules, scratch parks"
  collision: "noise"
  machine: "outDir + gitignore + clean-tree gate"
  axis: #noise
 }

 documentation: .{
  answers: "do declared paths and fragments still resolve?"
  over: "tilde refs, root maps, writerside topics, archive moves, expression exhibits"
  collision: "silent rot"
  machine: "path-check + writerside + grades g0 to g5"
  axis: #disclosure
  norms: ~"./references/documentation-referentiality.spw"
  ship_floor: "g1 local ref + g2 fragment + g5 writerside"
  authoring_floor: "docs at path-ref d1 or better; indexes at root-alias d2 or better"
 }

 indexing: .{
  answers: "where does a plan or surface live, and who depends on it?"
  over: "slug, cluster lane, inbound refs, hot files"
  collision: "two indexes for one fact"
  machine: "plans/index.spw + refresh derivers"
  axis: #resolution
 }

 consolidation: .{
  answers: "what is still active, finished, or stranded?"
  over: "status tokens, next_commit, archive, relocation"
  collision: "urgency theater"
  machine: "cluster lanes + maintenance verbs + schedule notes"
  axis: #stability
 }
}

^"verbs"{
 refresh: "recompute derived cache fields; never rewrite streams"
 archive: "move done or ghost plans; repoint tilde refs"
 relocate: "rewrite paths onto current layout; keep goal"
 schedule: "record collision order without implementing either side"
 close: "review to done to archive"
 recluster: "assign lane without rewriting commit lists"
}

^"status_tokens"{
 #:naming
 tokens: [
  #planning,
  #active,
  #review,
  #verifying,
  #blocked,
  #stranded,
  #needs_relocation,
  #done,
  #archive,
 ]
 ~#rule: "one token per status mark — prose lives in stream, not cache"
}

^"schedule_invariants"{
 apposition_before_beat: "eviction correctness before dynamic TTL on server-index.ts"
 one_workspace_cache_block: "surface-identity ownership — beat and granule policy share one cache block"
 no_feature_spines_here: "granules, shapeFingerprint, beat TTL stay on their slugs"
 stream_append_only: "consolidation never edits prior stream entries"
}

^"index_discipline"{
 durable: [#slug, #cluster_lane, #plan_path, #hot_files_declared]
 derived_aspect: [#status, #next_commit, #open_count, #last_stream]
 ~#rule: "derived fields are aspect marks; refresh owns recomputation; hand copies become fiction"
}

^"ship_gate"{
 '?': "what became truer about the workspace?"
 '~': "what maintenance lesson transfers?"
 '@': "what is now discussable without git archaeology?"
 '$': "what is measurable — clean status, fixpoint refresh, strict docs?"
 '%': "what stayed stable — feature spines, stream history, archive recoverability?"
}

^"language_brief"{
 #:appendix
 @plan_appendix: ~"./PLAN.md"
 ~#role: "PLAN.md Appendix A — language gaps and design conflicts; diagnosis only"
 ~#anti_loop: "soft host encoding outcompetes Spw structure; tools grow a second reader; authors trust the soft form"
 ~#gap_priority: "claim atoms, binding modality, hole contracts, organelle schema, guard ceilings"
 ~#conflict_core: "freeform maps, opaque strings, dual comments, parallel canons, second structural models, vocabulary forks"
 ~#not_this_plan: "no grammar products under this slug; maintenance pillars only"
}

^"documentation_brief"{
 #:appendix
 @appendix_b: ~"./PLAN.md"
 @exhibit: @referentiality
 ~#role: "PLAN.md Appendix B + documentation-referentiality.spw — robustness grades and expression goals"
 ~#stringless: "maximize claims that survive STRING erase; paths stay addresses, law stays structure"
 ~#dimensional: "when a string remains, attach resolution, modality, effect, identity axes"
 ~#ladder: "d0 bare string to d5 typed claim frame; authoring floor d1 docs, d2 indexes"
 ~#ship_floor: "g1 + g2 + g5 on commit 6; erase test is goal metric not hard fail for 2-5"
}

^"cli_brief"{
 #:appendix
 @appendix_c: ~"./PLAN.md"
 @exhibit: @cli_alignment
 ~#role: "PLAN.md Appendix C — verb alignment, composability, Spw-nativity, agent friendliness"
 ~#must: "relative paths, stable exit, --help, no silent write, write ceilings named"
 ~#should: "envelope v1 JSON, spw plan status/check, capabilities follow-on"
 ~#owned_here: "commit 7 ecology status on spw binary + help honesty"
 ~#follow_on: "cli-envelope-completion, cli-capabilities-review, spw-cli-overhaul remainder"
}

^"open"{
 ?[stranded_fate]: "archive, site-handoff, or packages-era relocate for the five ghost-path plans?"
 ?[index_root]: "plans/index.spw only, or also rooted from .spw/index.spw for mount consumers?"
}

#>wonder_hygiene_index_consolidation_doctrine
?["When does an index become a second cache that lies?"]{
  #:depth #!experiential
  ~#failure: "plans/index.spw copies status tokens by hand; wip.spw moves; index stays heroic"
  !probe{ "only route and cluster durable facts in the index; mark derived fields as aspect and recompute via refresh." }
  %keep{ "collision semantics: index key collision is a namespace error, not a finding" }
}
