# references — vscode-authoring-probe-loop

#:layer #!reference

^["source_index"]{
 @vscode_programmatic: "https://code.visualstudio.com/api/language-extensions/programmatic-language-features"
 @vscode_commands: "https://code.visualstudio.com/api/extension-guides/command"
 @vscode_quick_picks: "https://code.visualstudio.com/api/ux-guidelines/quick-picks"
 @vscode_status_bar: "https://code.visualstudio.com/api/ux-guidelines/status-bar"
 @vscode_tree_view: "https://code.visualstudio.com/api/extension-guides/tree-view"
}

^["signature"]{
 ~#profile: "cursor pedagogy"
 ~#recognition: "completion, hover, code lens, and status copy should each teach a real Spw relation without flooding the editor"
}

^["topic_anchors"]{
 authoring_surface: [@vscode_programmatic, #completion, #hover, #code_lens, #code_action, #document_link]
 command_choreography: [@vscode_commands, @vscode_quick_picks, #command_palette, #quick_pick, #preview_refactor, #query_pivot]
 quiet_feedback: [@vscode_status_bar, @vscode_tree_view, #status_bar, #reversibility, #focus, #solo_ship]
}

^["operational_density"]{
 checks: [#solo_ship, #preview_truth, #snippet_legibility, #authoring_pleasure]
 drift_risks: [#editor_noise, #status_bloat, #semantic_drift, #command_sprawl]
 release_implications: [#command_copy, #preview_examples, #status_phrasing]
}

#>wonder_agents_plans_vscodeauthoringprobeloop_references_1
?["Which editor affordances teach phase and relation most efficiently?"]{
  #:depth #!computational // lens: cursor pedagogy
  &[@vscode_programmatic, @vscode_status_bar, @vscode_quick_picks] => $[#completion, #hover, #code_lens, #preview_refactor]
  !probe{ "pick the surface that reveals the most real structure per unit of interruption." }
  ~<.agents/plans/vscode-authoring-probe-loop/wip.spw>
}

#>wonder_agents_plans_vscodeauthoringprobeloop_references_2
?["How should preview-rich refactors stay calmer than command sprawl?"]{
  #:depth #!educational // lens: action economy
  $^["topic_anchors"]@here => $^["operational_density"]@here
  !probe{ "trace when a refactor needs command-palette ceremony, quick-pick narrowing, or inline code-action brevity." }
  ~<.agents/plans/vscode-authoring-probe-loop/vscode-authoring-probe-loop.spw>
}
