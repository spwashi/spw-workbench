# interaction spec — vscode-authoring-probe-loop

#:layer #!pragmatics

^["roots"]{
 @cluster: ~".agents/plans/plan-ecology-clustering/plan-ecology-clustering.spw"
 @topography: ~".agents/plans/operational-topography/operational-topography.spw"
 @references: ~".agents/plans/vscode-authoring-probe-loop/references/index.spw"
 @selection: ~".spw/conventions/selection.spw"
 @tooling: ~".spw/tooling/vscode-spw.spw"
 @literate_ui: ~".spw/patterns/literate-ui.spw"
}

^["cluster_role"]{
 lane: #speculative_editor_future
 ladder: #component
 rule: "authoring should remain a local-solo surface first and grow into richer cross-surface cognition only when selection and preview language stay stable"
}

^["concept_index"]{
 primary: [#completion, #code_lens, #status, #phase, #materialization, #probe, #graph_query, #preview_refactor]
 surfaces: [#editor, #command_palette, #status_bar, #hover, #quick_pick]
 tensions: [#noise, #semantic_drift, #cheap_computation, #solo_ship]
 transfers: [#component, #page, #service]
}

^["completion"]{
 contexts: {
  metric: {
   trigger: "$%["
   source: "observable state + known runtime telemetry names"
   ranking: "live metrics first, known dormant metrics second"
  }
  root: {
   trigger: "@"
   source: "workspace atlas roots + manifest-derived roots + fallback static roots"
   ranking: "manifest roots before fallback roots"
  }
  selector: {
   trigger: "$"
   source: "indexed selectors, frames, and navigable workspace selectors"
   ranking: "same-file definitions before workspace definitions"
  }
  register_facet: {
   trigger: "[reg="
   source: "known facet qualifiers and registry-derived values"
   ranking: "current-file usage before global usage"
  }
 }
 reject_rules: [
  "do not show register-path suggestions when parse context is plain string content",
  "hide noisy workspace-wide suggestions when same-file candidates exist",
 ]
 formatting_awareness: "completion items that introduce structural forms should respect formatter expectations and avoid spellings the refactor actions would immediately rewrite"
}

^["code_lens"]{
 promote_actions: [
  "show registers",
  "show anchor backlinks",
  "open generated target",
  "open source spec",
  "run trial",
  "rotate perspective",
  "query graph neighborhood",
 ]
 action_model: "lens title is summary; click opens command scoped to line/file context"
 fallback: "if command data is unavailable, keep summary-only lens instead of broken click target"
}

^["formatting_refactors"]{
 contract: "consume one parser-verified differential plan; client previews and applies but does not derive edit semantics"
 formatting_actions: [
  "format current file",
  "format selected range",
  "normalize concise trait to structural binding",
  "normalize structural binding to concise trait when semantically safe",
 ]
 refactor_actions: [
  "reveal anchor backlinks before rename",
  "rename selector or root with preview",
  "rotate between equivalent views when inverse and source map are declared",
  "extract frame from deep nested block",
 ]
 inspection_before_refactor: "every non-trivial refactor command shows exact targets, affected files/edges, mutation profile, source map, verification, and effect grade before confirmation"
}

^["commands"]{
 command_palette: [
  "Spw: Trial Run Current File",
  "Spw: Show Registers For Active File",
  "Spw: Trace Selector At Cursor",
  "Spw: Open Harness Memory Surface",
  "Spw: Reveal Workspace Atlas",
  "Spw: Rotate Inspection Perspective",
  "Spw: Query Workspace Graph At Cursor",
  "Spw: Preview Semantic Refactor",
  ]
 editor_title: [
  "Run Trial",
  "Trace Selector",
 ]
 keybinding_candidates: [
  "cmd/ctrl+alt+r for trial run",
  "cmd/ctrl+alt+shift+r for register reveal",
  "cmd/ctrl+alt+g for graph query",
  "cmd/ctrl+alt+o for rotate perspective",
 ]
}

^["status"]{
 slots: [
  "active runtime phase",
  "register count",
  "observable state freshness",
  "last trial status",
 ]
 quiet_mode: "when no .spw editor is active, collapse to one dormant status item"
 warning_mode: "runtime failure or stale observable state swaps phase slot for warning label"
}

^["theming"]{
 states: [
  "quiet editing uses low-contrast semantic tinting",
  "stale probe or runtime warning promotes contrast but does not flash",
  "active inspection mode highlights selected lens or rotation context",
 ]
 formatting_feedback: "refactor/format previews use success, caution, and semantic-drift colors distinct from syntax highlighting"
}

^["flows"]{
 edit_to_trial: [
  "user edits .spw file",
  "status surface marks trial stale",
  "Run Trial command executes",
  "status updates with phase and register count",
  "user opens register explorer or diagnostics from result",
 ]
 selector_trace: [
  "cursor sits on selector or path reference",
  "Trace Selector command resolves source and target",
  "quick pick offers open target, copy path, or reveal atlas node",
 ]
 completion_accept: [
  "user types metric or root prefix",
  "completion list shows live-first ranked items",
  "accept inserts minimal surface spelling and preserves cursor in next editable segment",
 ]
 refactor_preview: [
  "user invokes Preview Semantic Refactor",
  "editor shows affected files, backlinks, and graph edges before applying edits",
  "user confirms or narrows scope before write",
 ]
 rotate_inspection: [
  "user invokes Rotate Inspection Perspective",
  "status bar, code lens, and quick pick rotate together between local, cross-file, tree, and graph views",
  "cursor stays anchored through a revision-addressed source map; information loss is disclosed",
 ]
 graph_query_flow: [
  "cursor sits on selector, anchor, frame, or root",
  "Query Workspace Graph At Cursor opens focused neighborhood query",
  "results allow open target, reveal atlas node, or launch rename/refactor preview",
 ]
}

^["diagnostic_affordances"]{
 inline_actions: [
  "rerun trial from runtime warning",
  "open target from unresolved root/path warning when a near match exists",
 ]
}

^["review_contract"]{
 sources: [@cluster, @references, @selection, @tooling, @literate_ui]
 asks: [#selection_language, #preview_truth, #completion_discipline, #snippet_legibility]
}

^["recursive_improvement"]{
 loop: [
  "? reread selection, tooling, and literate-ui before widening the authoring surface",
  "< ship one affordance that teaches a real Spw relation or phase change",
  "$ record the wording that survives completion, hover, status, and command copy",
  "^ promote the surviving pattern into shared tooling or cross-surface events",
  "% keep ordinary editing useful without atlas or register enrichments",
 ]
 gates: [#solo_ship, #cheap_status, #preview_truth, #snippet_legibility]
}

^["parallel_work"]{
 critical_path: [#completion, #preview_refactor, #status]
 parallelizable: [#code_lens, #commands, #theming, #graph_query]
 shared_hot_files: [@selection, @tooling, @literate_ui]
 merge_risks: [#copy_drift, #preview_drift, #noise]
 handoff_artifacts: [@cluster, @selection, @tooling]
}

^["supporting_documents"]{
 must_ship: [@tooling, @selection]
 helpful: [@literate_ui, @cluster, @references]
 carries: [#command_copy, #preview_examples, #status_phrasing, #selection_examples, #source_map]
}

^["interaction_depth"]{
 subjects: [#preview, #completion, #status, #phase_awareness, #reversibility, #focus]
 questions: [#what_should_appear_first, #what_can_be_applied_safely, #what_remains_local]
 qualities: [#legibility, #quiet_feedback, #reversibility]
}

^["snippet_routes"]{
 stable: [
  "completion examples",
  "trace-selector quick actions",
  "preview-refactor summaries",
  "status and code-lens copy",
 ]
 rule: "authoring snippets should survive movement between completion, status, code lens, quick pick, and docs without semantic drift"
}

^["non_goals"]{
 ~#not_now: [
  "embedded terminal replacement",
  "persistent run history UI",
  "full command choreography for every harness tool",
 ]
}
