?["When does an editor affordance actually teach Spw rather than decorate it?"]{
  #:depth #!educational // lens: component pedagogy
  $^["development"]@here => $^["recursive_improvement"]@here
  !probe{ "pick one completion, hover, or status phrase and ask whether it reveals a real operator or runtime relation." }
  $%[lsp.request_count, lsp.avg_response_ms]
}

#>wonder_agents_plans_vscodeauthoringprobeloop_wip_2
?["How should solo-ship value constrain recursive improvement in this branch?"]{
  #:depth #!computational // lens: interaction economics
  $^["concept_index"]@here => $^["commits"]@here
  !probe{ "if atlas and register surfaces disappeared tomorrow, which affordances would still justify the branch?" }
  ~<.agents/plans/vscode-authoring-probe-loop/vscode-authoring-probe-loop.spw>
