#>plan_spoken_form
#:plan #!execution_truth
#:layer #!pragmatics

!["card"]{
 phase: #active
 gist: "A line is said in the names of its mark, slots and join, and every brace has a click whose timbre follows its label, both from the browser reader; what either should be is held as trials"
 touches: [~"packages/spw-seed/src/experimental/spoken.ts", ~"packages/spw-seed/src/experimental/pair-sound.ts", ~"packages/spw-seed/src/reader.ts", ~"packages/spw-lsp/src/reader.ts", ~"packages/spw-seed/src/line/read.ts", ~"packages/spw-seed/src/canonical/geometry-inspect-position.ts"]
 entry: ~"./PLAN.md"
 next: "Someone listens: npm run sound:pairs writes a WAV file, and a screen reader on the owner's machine says what spokenLine gives a line as its name. Until then both stay experimental."
}

