# wip — line-kit
# Started: 2026-11-06

#>plan_line_kit
#:plan #!execution_truth
#:layer #!syntax

!["card"]{
 phase: #planning
 gist: "Seed gives interactive hosts one kit for a line: read, query, edit, wrap and describe, each edit byte-preserving"
 touches: [~"packages/spw-seed/src/line", ~"packages/spw-lsp/src/reader.ts"]
 entry: ~"./PLAN.md"
 next: "~[any_pair_leads] in the reader, then ~[kit_laws]: the laws as property tests over generated lines, failing first; then ~[slot_edits]."
}

^["edges"]{
 needs: [~"../brace-slot-reading/wip.spw"]
 feeds: [~"../onboarding-quest/wip.spw", ~"../ground-edge-reading/wip.spw", ~"../editor-reading-hierarchy/wip.spw"]
 shares: [~"../parser-releases/wip.spw", ~"../interpretation-trials/wip.spw", ~"../cli-sense-reorientation/wip.spw"]
}

^["roots"]{
 @plan: ~".agents/plans/line-kit/PLAN.md"
 @line: ~"packages/spw-seed/src/line/index.ts"
 @fixtures: ~"packages/spw-seed/src/line/fixtures.ts"
 @reader: ~"packages/spw-lsp/src/reader.ts"
 @trials: ~".agents/plans/interpretation-trials/interpretation-trials.spw"
}

^["intent"]{
 ~#goal: "Two hosts edit, search and wrap Spw lines the same way because they call the same kit, and no host keeps a slot writer of its own"
 ~#taste: "Every edit is a splice at spans the reading already holds; readings still on trial stay out of the kit"
}

^["design"]{
 # One reading, many uses (the owner: aim for cohesive design and resilient architecture, 2026-11-06).
 one_reading: "readLine is the only reader: a query, an edit, a wrap point, a feature and a renamed view are each a function of a SlotReading and the source it holds; nothing re-reads text its own way"
 query_is_a_line: "a query is read by readLine like any line, so {seed}, <receipt>, (atlas) and [pi*] are lead slots of a line with no word, and medium[*] is a word and a mode; a query and a line can never be read two ways"
 any_pair_leads: "every pair may be written before the word, as the scene and concept already may: [mode]home, {body}home; a moved slot is a lead slot, and the order it was written in is kept"
 contracts: "each product names its contract and version (line.reading/1, line.query/1, line.features/1, line.breaks/1), so a host can check what it holds and a change is a new version, not a silent shape"
 totality: "every function takes any string and returns; what it cannot read goes to rest, and no input throws"
 laws: "the laws run over the fixture table and over generated lines (any slot order, nesting, separators, joins, quotes, unclosed pairs): write-back identity, one-span edits, rest kept, query matches itself"
 agreement: "the line reader and the parser are held together by a law over the same generated lines: wherever both read a body, they find the same number of parts and the same marks; a form where they part is either fixed or named in a table of known partings with the trial that owns it, so a new parting fails a test and an old one is never silent"
 part_alone_or_in_company: "a part reads the same whether it is a body's only part or one of several; its mark, word and slots do not depend on its siblings"
 no_host_names: "seed carries no consumer's vocabulary; a host passes its own slot names to the record view, and SLOT_NAMES keeps only the reader names"
 digestible_features: "features are plain data with stable keys and plain-word names, a short description in words, and a Spw line of their own, so a shelf, a canvas or an agent can use them without reading seed"
 types_from_the_build: "hosts type the kit from types cut with the build (parser-releases typed_variants), never from a hand-copied file"
}

^["intake"]{
 # What each host's planned or landed work asks of the kit. Consumer-relative paths.
 region_moves_its_slot: .{ host: "factshift.center", source: "TOOLS.md, Regions: consequence, or quiet (G2)", home: "slot_edits: moveSlot" }
 drop_adds_a_part: .{ host: "factshift.center", source: "TOOLS.md (G3)", home: "slot_edits: addPart" }
 selection_rewrites_join: .{ host: "factshift.center", source: "TOOLS.md (G4)", home: "slot_edits: setSeparator, setJoinMark" }
 map_filter_as_slot_query: .{ host: "factshift.center", source: "TOOLS.md, Map and filter, Spw-native (M1, F1)", home: "slot_query" }
 body_part_by_link: .{ host: "spw.quest", source: "workers/spw-quest/src/pivot.js withBodyPart (584ac7eb)", home: "slot_edits: addPart" }
 front_mark: .{ host: "spw.quest", source: "workers/spw-quest/src/pivot.js withFrontMark (584ac7eb)", home: "slot_edits: setFrontMark" }
 shelf_search: .{ host: "spw.quest", source: "public/js/semantic/expression-query.js parseExpressionQuery, no scene slot", home: "slot_query" }
 wrap_where_spw_parts: .{ host: "spw.quest", source: "src/specimens.js breakable() and the plan lines' hanging indent (4e9ba912, cc047be5)", home: "wrap_points" }
 level_slider: .{ host: "spw.quest", source: "PLAN.md, Shelf, library and architecture (bad03f63)", home: "line_features" }
 guided_wonder: .{ host: "factshift.center", source: "interpretation-trials wonder_trial_guided_wonder", home: "line_features, slot_query" }
 one_codec: .{ host: "spw.quest, factshift.center", source: "the site's plane reports, quest.spw workbench_asks: toSpw64, fromSpw64 and #spw64= written four times (build.js, spw-talk.ts)", home: "line_codec" }
 top_level_split: .{ host: "factshift.center", source: "the site's plane reports, quest.spw workbench_asks: a file's top-level expressions counted by hand (spw-talk.ts)", home: "top_level_split" }
 body_join_reader: .{ host: "spw.quest", source: "the site's plane reports, quest.spw workbench_asks: one reader for body joins, FORMS rows (forms.js) as its conformance set", home: "line_features; with brace-slot-reading consumer_reader_parity" }
 one_reader_three_profiles: .{ host: "a second mounted consumer", source: "its review, 2026-11-08: six browser readers sharing no syntax tree, beside a vendored seed bundle", home: "kit_in_reader; with parser-releases reader_is_browser_build" }
 intermediate_forms: .{ host: "all four", source: "interpretation-trials wonder_trial_intermediate_forms (the owner, 2026-11-08)", home: "line_features, slot_query" }
 body_law_mark: .{ host: "factshift.center, a second mounted consumer", source: "the site's cache brace-literal-local-law-2026-11 (law, before_the_brace): the mark a word leads with is its body's law, and ~{warm_furrow} has a mark and no name", home: "mark_span" }
 owed_closers: .{ host: "factshift.center", source: "the same cache (particles, ion): the prompt paints the closers an open line owes and Tab writes them, from the host's own count", home: "line_features: owes" }
 fold_pairs: .{ host: "spw.quest, factshift.center", source: "the same cache (literal, accordion): a page that renders a file as nested details wants each pair's open and close as data", home: "top_level_split, wrap_points" }
 line_shape: .{ host: "factshift.center", source: "the same cache (molecule, formula): a line's shape with its words taken out, written ~·[]{,}<>, and like ~soup as a query for one shape (app d83863b)", home: "line_features: shape; slot_query; syntax-hardware-alignment p17" }
 lone_dot_part: .{ host: "factshift.center, a second mounted consumer", source: "the same cache (dot): kitchen{.bread{flour, water}} loses its mark; 38 level rows in the second consumer read the same way", home: "parts_as_parsed; syntax-hardware-alignment p15" }
 side_by_side_parts: .{ host: "a second mounted consumer", source: "230 of its 1,620 single-line bodies set terms side by side (journal 2026-11-09-reader-agreement)", home: "parts_as_parsed; syntax-hardware-alignment p16" }
 spoken_twin: .{ host: "spw.quest, the site consumer", source: "the site's cache read-aloud-typography-2026-11: a line said aloud as potential garden, mode care, body: seed, water", home: "line_features: describeFeatures gives the words a voice can say" }
 pivots: .{ host: "spw.quest", source: "workers/spw-quest/src/pivot.js pivotsOf and lineFrom: the lines one change away, by a turn or a drop", home: "pivots" }
 held_line_verbs: .{ host: "factshift.center", source: "its line-edit and line-joints modules: move a part, wrap a selection in a pair, close what the line owes, add or remove room, a seam or a mark between, all through one hub", home: "slot_edits; line_features: owes" }
 quest_local_kit: .{ host: "spw.quest", source: "only parse comes from the workbench build; its file kit, slot assembly, formatter, specimen reader and share codec are its own, and its dated build has no readLine", home: "kit_in_reader; line_codec; with parser-releases" }
 record_spells: .{ host: "a second mounted consumer", source: "a cast, an outcome and a projection are written out as spells by string templates, and pasted spells are routed by regular expression", home: "slot_edits: a line built from a reading, so a host writes a record without a template" }
 address_seats: .{ host: "spw.quest, factshift.center, the site consumer, a second mounted consumer", source: "the site's prime plugin-surface-prime-2026-11 (five seats: path, query, fragment, Accept, method; query caps of 200, 400 and 1,800 characters) and a second consumer's proposals for one address grammar and relative addresses", home: "line_codec; wonder_trial_address_line" }
 contact_sheet: .{ host: "spw.quest, a second mounted consumer", source: "an experiment as comparable stills, one per variant, and six seeded variations side by side, each with its own address", home: "pivots" }
}

^["open"]{
 # Unresolved questions. When resolved: log in stream, then move to ^["done"] as ~#resolved(label).
 ?[query_match]: "How does a query slot match: * any written slot, x* a prefix, x equal, a body's query parts each held among the line's parts; is an absent query slot no constraint, and does a query slot written empty ([ ]) ask that the line lack it?"
 ?[features_shape]: "Which features earn a stable key in line.features/1, and what does the short description say first: the order departures, the joins, or the depth?"
}

^["commits"]{
 # Named, in order. Planned ~[name]; landed .[name](hash). Names are never reused.
 ~[any_pair_leads]: "^seed[line] — the reader takes a mode or a body before the word as it takes a scene or a concept: [mode]home, {body}home; fixtures and laws updated, {chronicles} <of> (narnia) now leads with its body"
 ~[kit_laws]: "![line] — the laws as property tests over generated lines as well as the fixture table: write-back identity, one-span edits, rest kept, no input throws"
 ~[reader_parser_agreement]: "![line] — a law over generated lines and the fixture table: where the parser and the line reader both read a body, part counts and marks agree; known partings (the dot as seam or join, the gap, a bare mark before a body) sit in a named table citing their trials, and the test fails on any parting outside it"
 ~[parts_as_parsed]: "^seed[line] — the line reader's parts follow the grammar where no trial is open: a dot that opens a body leads its first part as a mark (p15); the gap as a separator (p16) lands only after wonder_trial_gap"
 ~[mark_span]: "^seed[line] — a reading gives the word's leading mark a span of its own beside the name, so ~soup is a mark and a name and ~{furrow} is a mark with no name; setFrontMark becomes a one-span edit (line.reading/2, since the word's shape changes)"
 ~[slot_edits]: "^seed[line] — moveSlot (to any place, before the word included), addPart, setSeparator, setFrontMark and setJoinMark over a reading, each a splice at spans the reading holds, returning the new text and its reading"
 ~[slot_query]: "^seed[line] — a query is a line: readLine reads it, and matchReading(query, reading) compares slot by slot, nested parts included; {seed} holds, <receipt> goes to, (atlas) scene, [pi*] lens prefix, medium[*] any lens (line.query/1, after ?[query_match])"
 ~[wrap_points]: "^seed[line] — breakPoints(reading): where a line may wrap (after a slot closes, before a pair opens, after a separator or a join mark; never inside a word or a string), and frameHang for a #> frame line; highlightHtml takes { breaks: true }"
 ~[line_features]: "^seed[line] — lineFeatures(reading) as line.features/1: plain data with stable keys (slots and their order, leads, departures from word-first order, joins and bonds, separators, depth, marks, unread), describeFeatures in a few plain words, and the features as a Spw line of their own; seed names no level (after ?[features_shape])"
 ~[slot_record_view]: "&[line] — viewReading(reading, names): a reading under a vocabulary the caller passes, so a consumer's reader can become a view of seed's and no consumer's names live in seed (the site column leaves SLOT_NAMES); with brace-slot-reading consumer_reader_parity"
 ~[kit_contracts]: ".[spec] — the line.* contracts written down beside the plugin protocol: what each product holds, its version, and the laws it keeps"
 ~[line_codec]: "^seed[line] — toSpw64, fromSpw64 and the #spw64= fragment grammar in seed, with the law that decoding an encoded line gives it back byte for byte; the codec is base64url, without padding, of the text's UTF-8 bytes behind #spw64=, as five implementations across three hosts already agree (probed 2026-11-09); they drop their copies (intake one_codec)"
 ~[top_level_split]: "^seed[line] — expressions(text) returns each top-level expression of a file with its span, from the same reading the kit uses, so no host counts braces by hand (intake top_level_split)"
 ~[kit_in_reader]: "&[reader] — the kit exported from seed's reader slice and the language server's reader, asserted on reader.min.js and reader.debug.js in test:parser-release"
 ~[pivots]: "^seed[line] — pivots(reading): the readings one edit away (a slot dropped, a mark turned, a part added or removed), each with the change that makes it, so a host offers the next lines without a writer of its own (line.pivots/1)"
}

^["stream"]{
 >>[2026-11-06 20:20] observe — In the 90 minutes after the canvas host moved to seed's reader, the consumer filed or built nine asks of a line: factshift.center's tools plan wants a slot query for map and filter, a writeAt rewrite for a cast, a region drag that moves its slot, a drop that adds a part and a selection that rewrites a join; spw.quest built a body part by a chosen link and a front mark by rebuilding the line from its own reader, wraps painted lines by regex, hangs plan lines from their frame, and proposes a level slider. Each is a line operation more than one host needs.
 >>[2026-11-06 20:20] decide — One plan for the kit beside the reader, rather than a commit each in brace-slot-reading: that plan keeps the parser's agreement, this one keeps the host-facing kit, and both share the fixture table.
 >>[2026-11-06 20:28] decide — The owner, 2026-11-06: a mode and a body may lead the word, as a scene and a concept may; a slot query should probably be read as a line; features should be made digestible downstream; aim for cohesive design and resilient architecture. The plan now reads one way through every product (one reader, the query a line), names a versioned contract for each, keeps consumers' vocabularies out of seed, runs its laws over generated lines, and leaves the level to hosts while making features plain to read. query_is_a_line is held as the owner's leaning ("probably"), reversible until slot_query lands.
 >>[2026-11-08 09:47] observe — Two hosts' asks fit the kit (2026-11-08). The site's plane reports ask for one codec (toSpw64, fromSpw64 and the #spw64= fragment, written four times today), one splitter for a file's top-level expressions (counted by hand in spw-talk.ts), and one reader for body joins with spw.quest's FORMS rows as its conformance set. A second mounted consumer runs six browser readers that share no syntax tree (selector, expression index, claims lines, a desk's spells, a map query, a projection spell) beside a vendored seed bundle, and asks for one reader with expression, record and prose profiles. Rows added to ^intake.
 >>[2026-11-08 10:07] note — The kit's laws have a floor reading (docs/theory/spw/exhibit-floor.spw ^exhibit_physics): write-back identity and one-span edits are what make an exhibit reversible, and a reset that moves a reading is a broken exhibit. wonder_trial_rest_state, homed here, asks whose rest a line returns to.
 >>[2026-11-09 17:07] observe — Read the site consumer since 2026-11-08 (its cache brace-literal-local-law-2026-11) and ran both seed readers over three corpora (journal 2026-11-09-reader-agreement). Six rows added to intake: the mark as a body law, owed closers, pairs as data for folds, a line shape, the lone dot part, and parts side by side. The parser and the line reader live in one package and part on a body: design gains agreement (one law over generated lines, with known partings named and owned by a trial) and part_alone_or_in_company. Commits gain reader_parser_agreement, parts_as_parsed and mark_span.
 >>[2026-11-09 18:12] observe — Five intake rows from both consumers, read 2026-11-09: a spoken twin of a line, pivots (the lines one change away), the canvas held-line verbs that all pass through one hub, the guide whose only workbench import is parse, and a second consumer that writes spells as records from string templates. pivots planned as a product of its own. The site consumer counted siblings side by side in bodies itself (850 and 243 in two corpora), which agrees with the gap finding of the same day.
 >>[2026-11-09 18:28] observe — Probed the share fragment read-only on 2026-11-09 (journal 2026-11-09-consumer-caches): five implementations across three hosts write or read base64url, without padding, of the text UTF-8 bytes behind one pattern; one consumer cache calls the fragment a serialized tree and no code does. line_codec now states the codec in one sentence. Two intake rows: the five seats of an address, and variations as a contact sheet, which is what pivots would feed. A consumer briefing names the line library and the share codec as the first sockets, each needing a doorway, three examples and a starter that fails loudly; the codec is the smaller of the two.
 >>[2026-11-10 23:02] observe — Read the canvas on 2026-11-10: its slot reader is now seed's readLine (line-slots.ts), so its line-anatomy is layout only, and the site plans still calling it a second reader are stale. It still parses casts by regular expression although readLine reads ~map[mode]{ care ~> rest } as a word, a mode and two parts, and wraps a body in a dummy word, _{body}, to read one. Both are slot_edits and a body entry point, not syntax.
}

^["cache"]{
 ~#status: "planning"
 ~#base_ref: "main@27fa1e3d"
 ~#rebased_at: ""
 ~#files_hot: "packages/spw-seed/src/line"
 ~#next_commit: "any_pair_leads"
 ~#open_count: "2"
 ~#last_stream: "2026-11-10 23:02"
}

^["done"]{
 ~#resolved(move_semantics): "May a mode or body lead the word? Yes: every pair may lead; a moved slot is a lead slot. Owner, 2026-11-06 20:28"
 ~#resolved(query_grammar): "Shelf grammar or a query read as a line? A line, probably: one reader for queries and lines. Owner, 2026-11-06 20:28; held reversible until slot_query lands"
 ~#resolved(features_not_level): "Features or a level? Features, made digestible downstream; hosts weigh their own levels. Owner, 2026-11-06 20:28"
}
