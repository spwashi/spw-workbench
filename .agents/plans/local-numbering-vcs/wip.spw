#>plan_local_numbering_vcs
#:plan #!execution_truth
#:layer #!pragmatics

!["card"]{
 phase: #active
 gist: "Local ids follow one rule (labels are identity, ordinals are derived for display), and every version-control touchpoint reads the VCS from .spw/workspace.spw, detected by default, so plans, lexer, LSP, CLI, and hooks work in git, jj, or no VCS."
 touches: [~".spw/workspace.spw", ~"packages/spw-seed/src/lexer/commit-ref.ts", ~"packages/spw-lsp/src/handlers/commit-refs.ts", ~".agents/scripts/agent-lib.sh"]
 entry: ~"./PLAN.md"
 next: "~[lsp_adapter] (upstream-bridge.ts still asks git itself), ~[scripts_adapter], ~[agent_lib_adapter]; then a commit ref that names its repository, since the ids git here does not hold are the site consumer's commits; IntelliJ token colours stand apart."
}

^["edges"]{
 shares: [~"../caches-living-tree/wip.spw", ~"../parser-releases/wip.spw", ~"../plan-tooling-design/wip.spw", ~"../hygiene-index-consolidation/wip.spw"]
 feeds: [~"../plan-stream-parse-health/wip.spw"]
}

^["roots"]{
 @plan: ~".agents/plans/local-numbering-vcs/PLAN.md"
 @artifact: ~".agents/plans/local-numbering-vcs/local-numbering-vcs.spw"
 @workspace: ~".spw/workspace.spw"
 @schema: ~".agents/plans/_schema/wip.spw"
 @commit_ref_lexer: ~"packages/spw-seed/src/lexer/commit-ref.ts"
 @commit_ref_lsp: ~"packages/spw-lsp/src/handlers/commit-refs.ts"
 @agent_lib: ~".agents/scripts/agent-lib.sh"
}

^["intent"]{
 ~#goal: "A reader can scan a plan's commits by state and order without anyone maintaining numbers, and find any numbered thing (p10, r3, a release, a tag) by searching its scope. A workspace that uses jj, an older git, or no VCS gets the same plans, refs, and tools, with gaps named rather than errors."
 ~#taste: "derive what can be derived: names and dates are authored, ordinals and colors are computed; one adapter owns the VCS"
}

