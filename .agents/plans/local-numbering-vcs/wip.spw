 merge_risks: [#hook_regression, #seed_portability]
 handoff_artifacts: [@plan, @artifact]
}

^["risk_model"]{
 hard_failures: [
  "a widened commit-ref pattern lexes ordinary hex-looking words in stream prose as ids",
  "the commit gate stops running in a git repo because detection picked the wrong kind"
 ]
 soft_failures: [
  "a jj or VCS-less workspace sees commit refs as unresolved ids",
  "a consumer mounting the workbench without git submodules cannot run the mount check"
 ]
 non_negotiables: [
  "with no workspace setting, a git repository behaves exactly as today",
  "packages/spw-seed stays portable: the lexer takes the id pattern as an option, it never reads workspace files",
  "no planned commit is ever given an authored number"
 ]
}

^["validation"]{
 hypotheses: [
  "H1 every direct git call outside the adapter can move behind it without changing output in this repository",
  "H2 a derived ordinal plus a state color makes a plan's commits scannable without authored numbers",
  "H3 one id pattern option covers git SHA-1 and SHA-256 ids and jj change ids without lexing prose words as ids"
 ]
 negative_controls: [
  "every .[name](hash) line in the plan corpus lexes and resolves as before",
  "spw doctor, plan:index, and the commit gate print the same output in this repository before and after"
 ]
 demo_path: [
  "run spw doctor in this repo, in a jj-colocated clone, and in a plain copy; each names its VCS and default branch",
  "open a plan and see its commits numbered by position and colored by state, with no number in the source"
 ]
}

^["stream"]{
 >>[2026-10-13 12:05] observe — Local numbering in the repo today: commits are labels (~[name] planned, .[name](hash) landed, since 90c58bbc); proposals p1 to p11 are authored and never reused but are hard to find (the owner asked where p10 is mentioned); receipts r1 to rN are positional per file; some next_steps lists still use ~[1] to ~[4]; stream stamps, journal dates, release cuts (YYYY.MM.DD, -pre.N, -patch.N), and tags (caches-cut/2026.09.30) are dates. The schema documents named commits at line 40 but still shows the numbered ~[N] form at lines 301 to 332.
 >>[2026-10-13 12:05] observe — The owner liked ~[N] as a prefix because the number took another color and the order could be scanned; predicted numbers were hard to maintain, and the text labels are worth keeping. 90c58bbc dropped numbers because range comments hid which commit was which: only 4 of 29 plans mapped numbers onto hashes.
 >>[2026-10-13 12:05] decide — Labels stay the identity of a commit. Any ordinal is derived for display from the frame order and colored by state (planned, landed, dropped); nobody authors or renumbers it. An authored number is allowed only where it is monotonic and never reused within a named scope, such as p10 in syntax-hardware-alignment or -pre.N in a release.
 >>[2026-10-13 12:05] observe — VCS touchpoints: the seed commit-ref lexer accepts 7 to 40 lowercase hex (commit-ref.ts:5), so SHA-256 git ids and jj change ids do not lex; the LSP shells out to git in handlers/commit-refs.ts and upstream-bridge.ts; the CLI in atlas.ts, doctor.ts, and init.ts (which installs .git/hooks/pre-commit and git submodules); agent-lib.sh hardcodes main for base refs; the commit gate, commit-review scripts, the parser release builder, and the episode corpus analyzer call git directly. Nothing reads a VCS setting.
 >>[2026-10-13 15:06] note — plan-plugin-integration escalated git hashes in VS Code on 2026-10-13 and lands links and a commit view on the current git calls in commit-refs.ts; lsp_adapter moves them behind the adapter later, and commit_ref_pattern widens the form to SHA-256 and jj ids without changing those affordances.
}

^["open"]{
 ?[jj_hooks]: "jj has no commit hooks; in a jj workspace, does the human-authorization gate become an explicit spw review command, or does the plan only document the gap?"
 ?[id_scope_search]: "Should every authored number carry its scope in a findable form, as an anchor such as #>sha_p10, or is the frame label p10_lean_card enough once workspace symbol search covers frame labels?"
 ?[submodule_mount]: "Consumers mount the workbench as a git submodule; is a copy or a jj workspace a supported mount, or only a documented exception?"
}

^["commits"]{
 .[plan](6068a378): ".[plans] — local-numbering-vcs plans one numbering rule and a workspace-configured VCS"
 ~[numbering_inventory]: ".[plans] — lands with ~[plan]: the artifact lists every local numbering scheme and VCS touchpoint with the rule it follows today"
 ~[schema_numbering_rule]: "#[plans] — the plan schema states the rule (labels are identity, ordinals are derived, authored numbers are monotonic per scope) and drops its stale ~[N] section"
 ~[vcs_settings]: "#[workspace] — .spw/workspace.spw gains ^[vcs] with kind auto (git, jj, hg, none), default_branch auto, and an id pattern; detection reads .git, .jj, and .hg"
 ~[vcs_adapter]: "&[cli] — one adapter (detect, head, default branch, is-ancestor, short id, status, log) behind spw vcs --json; spw doctor reports what it detected"
 ~[agent_lib_adapter]: "&[agents] — agent-lib.sh asks the adapter for the default branch and base sha instead of hardcoding main"
 ~[lsp_adapter]: "&[lsp] — commit-refs.ts and upstream-bridge.ts go through the adapter; with no VCS a commit ref shows as an unresolved id, not an error"
 ~[commit_ref_pattern]: "^seed[lexer] — the commit-ref id pattern is a lexer option (default hex 7 to 40, as today); callers pass hex 7 to 64 or the jj change-id alphabet from the workspace setting"
 ~[scripts_adapter]: "&[scripts] — the parser release builder and the episode corpus analyzer use the adapter; the commit-gate scripts stay git-only and say so"
 ~[vcs_fixtures]: "![vcs] — fixtures for a git repo, a jj-colocated repo, and a plain directory; the adapter, spw doctor, and plan:index agree on each"
}

