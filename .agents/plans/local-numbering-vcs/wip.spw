!["card"]{
 phase: #planning
 gist: "Local ids follow one rule (labels are identity, ordinals are derived for display), and every version-control touchpoint reads the VCS from .spw/workspace.spw, detected by default, so plans, lexer, LSP, CLI, and hooks work in git, jj, or no VCS."
 touches: [~".spw/workspace.spw", ~"packages/spw-seed/src/lexer/commit-ref.ts", ~"packages/spw-lsp/src/handlers/commit-refs.ts", ~".agents/scripts/agent-lib.sh"]
 entry: ~"./PLAN.md"
 next: "~[schema_numbering_rule]: state the rule in the plan schema and drop its stale ~[N] section; then ~[vcs_settings] and ~[vcs_adapter]."
}

