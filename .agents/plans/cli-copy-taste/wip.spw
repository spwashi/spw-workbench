# wip — cli-copy-taste
# Branch: codex/gap-affinity-tooling
# Started: 2026-08-24

#:layer #!pragmatics

^["roots"]{
 @plan: ~".agents/plans/cli-copy-taste/PLAN.md"
 @convention: ~".spw/conventions/cli.spw"
 @surface: ~"docs/runtime/spw/cli-command-surface.spw"
 @registry: ~"packages/spw-cli/src/commands.ts"
 @inspect: ~"packages/spw-cli/src/inspect.ts"
 @view: ~"packages/spw-cli/src/view.ts"
}

^["intent"]{
 ~#goal: "Make CLI language disclose outcome, work, output shape, and migration status without requiring the reader to decode internal architecture."
 ~#taste: "recognizable primary words, operationally precise lyrical handles, restrained metaphor, and copyable recovery paths"
}

^["development"]{
 lane: #execution_truth
 ladder: #service
 develops: [#taste, #linguistics, #design_transfer, #disclosure]
 review_surfaces: [@plan, @convention, @surface, @registry]
 snippet_routes: [#help_copy, #recommendation, #counterexample, #compatibility]
}

^["concept_index"]{
 primary: [#outcome_first, #cost_disclosure, #route_only_alias, #lyrical_handle]
 surfaces: [#cli, #docs, #conventions]
 tensions: [#lyricality_vs_precision, #public_voice_vs_ir_vocabulary, #compatibility_vs_learnability]
 transfers: [#language, #service, #community]
}

^["recursive_improvement"]{
 loop: [
  "? read the command as a newcomer before consulting implementation terms",
  "< state one observable outcome and one optional cost or disclosure consequence",
  "$ compare the same control across help, receipt, docs, and convention",
  "^ retain only metaphors whose mapping and limit can be stated",
  "% keep routing and machine products unchanged while editing the public voice",
 ]
 gates: [#implementation_truth, #counterexample, #copyable_recovery]
}

^["parallel_work"]{
 critical_path: [#copy_law, #registry_help, #convention_sync]
 parallelizable: []
 shared_hot_files: ["packages/spw-cli/src/commands.ts", "packages/spw-cli/src/inspect.ts", ".spw/conventions/cli.spw"]
 merge_risks: [#copy_drift, #naming_drift]
 handoff_artifacts: [@plan, @convention, @surface]
}

^["supporting_documents"]{
 must_ship: [@plan, @convention, @surface]
 helpful: [@view]
 carries: [#definitions, #examples, #review_notes, #counterexamples]
}

^["interaction_depth"]{
 subjects: [#help, #recommendation, #legibility, #trust]
 questions: [#what_is_primary, #what_work_is_authorized, #what_is_visible, #what_is_legacy]
 qualities: [#clarity, #rhythm, #recognizability, #restraint]
}

^["risk_model"]{
 hard_failures: [#copy_behavior_contradiction]
 soft_failures: [#metaphor_without_mapping, #compatibility_noise, #brittle_copy_test]
 recoveries: [#behavior_probe, #canonical_example, #counterexample]
 non_negotiables: [#route_only_aliases, #omission_disclosure, #exact_recovery, #no_person_inference]
}

^["validation"]{
 hypotheses: [#outcome_first_scanability, #shared_control_lexicon]
 negative_controls: [#routing_identity, #machine_schema_identity, #spread_mapping_identity]
 demo_path: [#root_help, #inspect_help, #census_help, #bounded_source_product]
}

^["stream"]{
 >>[2026-08-24 13:13] observe — root and command help alternate among plain outcomes, IR/effect addresses, metaphor, and compatibility status without always marking which register is speaking.
 >>[2026-08-24 13:14] decide — public copy follows outcome first, cost or disclosure second, compatibility last; implementation addresses remain available as supporting precision.
 >>[2026-08-24 13:15] taste — lyricality earns its place when a memorable token is immediately paired with an operational mapping and a stated limit.
 >>[2026-08-24 13:16] decide — treat parser/runtime/bundle changes as outside this editorial episode and keep every machine schema and execution default unchanged.
 >>[2026-08-24 13:20] observe — live root help made newcomers decode effect addresses, IR names, option spellings, and dual-read before several command outcomes became recognizable.
 >>[2026-08-24 13:21] revise — dual-read is not memorable public copy; teach Spw card as source-shaped output readable as text and parseable as Spw.
 >>[2026-08-24 13:22] implement — root summaries now lead with outcomes, canonical examples precede compatibility routes, shared corpus copy names the spread-to-profile mapping, and recommendations pair a question with cost.
 >>[2026-08-24 13:23] verify — 3b5b5d90 lands the CLI copy pass; all 223 CLI tests and the repository TypeScript build pass without routing, schema, or execution changes.
 >>[2026-08-24 13:24] observe — the CLI convention listed 12 of 37 canonical commands and omitted several route-only aliases; the durable audit must correct that inventory rather than polishing prose alone.
 >>[2026-08-24 13:25] decide — resolved [public_ir_terms]: retain effect/IR precision in deeper receipts and semantic docs, but root summaries state observable outcomes first.
 >>[2026-08-24 13:26] implement — the CLI convention now inventories all canonical commands and aliases, defines Spw card, and separates implemented, proposed, and interpretive claims with metaphor counterexamples.
 >>[2026-08-24 13:27] verify — plan schema, 375-file Spw validation, Writerside links, and naming audit pass; 56 unrelated corpus syntax warnings remain unchanged.
}

