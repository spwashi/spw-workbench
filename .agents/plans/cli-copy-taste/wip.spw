#>wonder_cli_copy_taste_1
?["When does a lyrical CLI word clarify work rather than decorate it?"]{
 ~#answer_shape: [#token, #operational_mapping, #counterexample]
 !probe{ "remove the explanatory copy; if two plausible costs remain, the lyric is not yet self-supporting." }
 $%[copy.outcome_clarity, copy.cost_disclosure]
}

#>wonder_cli_copy_taste_2
?["Can a newcomer distinguish what runs from what is merely shown?"]{
 ~#answer_shape: [#execution_horizon, #retention, #visible_sample, #exact_product]
 !probe{ "compare --through, --events, and --sample help; each must name one independent consequence and refuse the other two." }
 $%[help.control_consistency, help.counterexample_count]
}
