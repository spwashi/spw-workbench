# Sources: Materials and Engineering
#
# Bibliography anchors for the matter branch. Claims link here; each entry names a work a reader can find.

#>src_mateng_registry
#:layer #!reference
#:domain #!registry
#:form #!bibliography
#:level #!mixed
#:review #!spot_checked
#:valence #!bone

^"provenance"{
