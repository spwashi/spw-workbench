# Quantities: Materials and Engineering
#
# World metric cells for the matter branch. A handle names one cell; files read it instead of restating the number.

#>q_mateng_registry
#:layer #!reference
#:domain #!registry
#:form #!registry
#:level #!mixed
#:review #!sourced
#:valence #!bone

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5"
 lineage: #[ "new" ]
 method: #authored
}

^["family"]{
 id: mateng_water
 operator: "%"
 identifier: mateng.water
 plane: world
 scope: corpus
 keys: #[ cp_j_per_g_k, t_rho_max_c, rho_ice_g_cm3, rho_liquid_max_g_cm3, epsilon_r, dipole_debye, hoh_angle_deg, dh_vap_kj_per_mol ]
 scheme: tol
 algorithm: world.registry_lookup
 form: scalar
}

#>q_mateng_water
^"water"{
 %mateng.water.cp_j_per_g_k{
