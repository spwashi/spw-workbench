+      },
+      getWorkspaceSpwFiles: async () => files,
+      mapWithConcurrency: async <T, R>(items: T[], _c: number, fn: (item: T) => Promise<R>) =>
+        Promise.all(items.map(fn)),
+      resolveReferencePath: (
+        hit: SpwSelectorHit,
+        source: string,
+        docPath: string,
+        options?: { allowDirectory?: boolean },
