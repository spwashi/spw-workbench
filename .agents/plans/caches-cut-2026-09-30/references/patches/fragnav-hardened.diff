+    const peer = uriFromPath(path.join(root, 'c#lab', 'peer.spw'))
+    expect(result.map((loc) => `${loc.uri}:${loc.range.start.line}`).sort()).toEqual([
+      `${uriFromPath(citing)}:0`,
+      `${peer}:0`,
+      `${peer}:1`,
+    ].sort())
   })
 })
