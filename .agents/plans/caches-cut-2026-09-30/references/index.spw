# Caches Cut References
#
# Evidence shelf for the 2026-09-30 cut. Paths below are file-relative. Scratch paths in reports appear as <scratchpad>; the kept copies live here.

#>spw_caches_cut_references
#:layer #!pragmatics

^["review"]{
 scorecard: ~"./review/scorecard.md"
 raw_fixity: ~"./review/raw-fixity.txt"
 note: "two review rounds over every raw file: depth, independent value, script value, tree fit, accessibility, errors with line numbers, harms, verdicts"
}

^["understand"]{
 linking: ~"./understand/linking.md"
 metrics: ~"./understand/metrics.md"
 tags: ~"./understand/tags.md"
 lens_lsp: ~"./understand/lens_lsp.md"
 emit_bundle: ~"./understand/emit_bundle.md"
 ocean_cluster: ~"./understand/ocean_cluster.md"
 syntax_breadth: ~"./understand/syntax_breadth.md"
 plugin_theory: ~"./understand/plugin_theory.md"
 theory_state: ~"./understand/theory_state.md"
 note: "nine verified reports on what the parser, LSP, CLI, and emit actually do; each ends with recommendations and theory questions"
}

^["studies"]{
 persona: ~"./studies/persona.md"
 tokens_ast: ~"./studies/tokens.md"
 tokens_ast_synthesis: ~"./studies/tokens-synthesis.md"
 final_plan: ~"./panel/final-plan-v3.json"
 final_plan_v2: ~"./panel/final-plan-v2.json"
 spw_branch_plan: ~"./spw-branch/spw-plan.json"
 machine_empathy: ~"./spw-branch/machine-empathy.md"
 rendering_cli_synthesis: ~"./studies/render-synthesis.md"
 persona_synthesis: ~"./studies/persona-synthesis.json"
 critic: ~"./panel/critic.json"
 rendering_cli: ~"./studies/render.md"
 note: "raw agent outputs; persona holds twelve practitioner evaluations plus notation and canon verifications; synthesis passes were interrupted by usage limits and are being resumed"
}

^["panel"]{
 colon: ~"./panel/design-colon.json"
 propaedia: ~"./panel/design-propaedia.json"
 workshop: ~"./panel/design-workshop.json"
 verdicts: ~"./panel/verdicts.json"
 note: "three complete ontology designs with migration maps and writer packages; all three judges chose Colon with grafts from Workshop and Propaedia"
}

^["patches"]{
 lens: ~"./patches/lens.diff"
 lens_type_fallout: ~"./patches/lens-typefallout.diff"
 fragment_navigation: ~"./patches/fragnav.diff"
 fragment_navigation_hardened: ~"./patches/fragnav-hardened.diff"
 graph_fragments: ~"./patches/graphfrag.diff"
 note: "uncommitted tool fixes; see PLAN.md for review verdicts, hardening state, and the wire and cost each must name before landing"
}

^["staging"]{
 contract: ~"./staging/2026-09-30/contract.spw"
 vocabulary: ~"./staging/2026-09-30/vocabulary.spw"
 exemplar: ~"./staging/2026-09-30/physical/materials/water.spw"
 note: "the staged cut root; it passes scripts/analyzers/spw-cut-gate.ts and the brief emit gate"
}

^["workflows"]{
 writers: ~"./workflows/cut-writers.js"
 panel: ~"./workflows/caches-ontology-panel.js"
 understand: ~"./workflows/spw-caches-understand.js"
 tool_fixes: ~"./workflows/spw-tool-fixes-for-cut.js"
 harden_lsp: ~"./workflows/harden-lsp-patches.js"
 harden_graph: ~"./workflows/harden-graph-patch.js"
 persona: ~"./workflows/spw-persona-evaluation.js"
 tokens_ast: ~"./workflows/spw-tokens-ast-dialects.js"
 rendering_cli: ~"./workflows/spw-reading-and-transformation.js"
 note: "Claude Code workflow scripts; set the REPO and scratch constants at the top before re-running; cut-writers.js expects args with the plan path and packages"
}
