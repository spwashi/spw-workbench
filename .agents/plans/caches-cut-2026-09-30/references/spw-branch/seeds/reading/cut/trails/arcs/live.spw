# Live Session Arc
#
# One TikTok LIVE session as an arc a streamer can say aloud and a chat can join, from the opening question to the door into the next stream.

#>trail_live_session
#:layer #!pragmatics
#:domain #!meta
#:form #!trail
#:level #!practitioner
#:review #!unreviewed
#:valence #!boon

^"emit"{
 ~#title: "Live Session Arc"
 ~#claim: "A live session holds one question: the streamer asks it, samples the chat for guesses, runs one probe on camera, and closes by naming the next question."
 ~#proof: "The arc is the wonder arc with the chat guesses as the forecast step."
 ~#door: "Open the wonder arc for the six steps."
 ~#audience: "streamers and co-hosts"
 cold_open: "One question, your guesses in chat, one try on camera, and the question we ask next time."
 continuity: "Live Session Arc | chat"
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5"
 lineage: #[ "new" ]
 method: #authored
}

^["scope"]{
 platform: "TikTok LIVE; eligibility, gifts, and moderation tools change, so this arc names none of them"
 as_of: "2026-09-30"
}

^["edges"]{
 case_of: [ ~"./wonder.spw#arc_wonder_order" ]
 feeds: [ ~"./lesson.spw#arc_lesson" ]
}

^["archetype"]{
 of: ~".spw/surfaces/surface-archetypes.spw#spw_surface_archetypes"
 name: #ephemeral_portal
 cadence: #single_beat
}

#>arc_live_order
^["order"]{
 clock: "minute"
 schedule: << open ; ask ; torrent ; probe ; say ; close >>
 open: "the cold open, said in one breath"
 ask: "one question on screen and aloud"
 torrent: "read chat guesses aloud as they arrive; they become the forecast list"
 probe: "one try on camera"
 say: "the streamer says the result in one breath, then invites chat to say it back"
 close: "compare guesses with the result and name the next question"
}

#>arc_live_torrent
^["torrent"]{
 sample: "read one guess aloud per minute, chosen for difference from the last one read"
 keep: "guesses go on the forecast list as text, without names"
 refuse: "ranking or scoring chatters; a chat line is evidence of a guess, never of a person"
}

#>arc_live_close
^["close"]{
 reflect: "which guesses the probe supported, which it did not, and which it could not test"
 door: "the next question and the day the next live asks it"
 hands_off: ~"./lesson.spw#arc_lesson"
}
