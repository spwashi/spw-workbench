# Wonder Arc
#
# A six-step loop that turns a hunch into a question, a forecast, a probe, an observation, and a reflection that names the next question.

#>trail_wonder_arc
#:layer #!pragmatics
#:domain #!meta
#:form #!trail
#:level #!mixed
#:review #!unreviewed
#:valence #!boon

^"emit"{
 ~#title: "Wonder Arc"
 ~#claim: "A wonder arc asks, writes a forecast, probes, observes, and reflects, and its last step names the next question."
 ~#proof: "The order is the canon flow schedule, which already puts the measure before the act, so the forecast comes before the probe."
 ~#door: "Pick one wonder in the water surface and fill its arc."
 ~#audience: "readers, teachers, streamers, and families who want a question to become a loop"
 cold_open: "Say your hunch, ask the question, write your forecast, try it, look, and compare."
 continuity: "Wonder Arc | forecast"
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5"
 lineage: #[ "new" ]
 method: #authored
}

^["edges"]{
 grounds: [ ~"docs/theory/spw/flow-protocol-sigils.spw", ~"docs/theory/spw/apposition.spw#spw_apposition" ]
 see: [ ~"../../matter/water.spw#matter_water_ice_sink_q" ]
}

^["archetype"]{
 of: ~".spw/surfaces/surface-archetypes.spw#spw_surface_archetypes"
 name: #exploratory_biome
 cadence: #metastable_spiral
}

#>arc_wonder_order
^["order"]{
 schedule: << ~ ; ? ; % ; ! ; * ; ^ >>
 hunch: "potential: the reading you arrive with, said once in your own words"
 question: "wonder: the question the hunch raises"
 forecast: "measure: what you expect to see, written down before you look"
 probe: "action: the smallest act that could surprise you"
 observe: "value: what came back, copied before you interpret it"
 reflect: "integration: forecast against observation, then the next question"
 loop: "the reflect step writes the next question, and the next arc starts there"
}

#>arc_wonder_limits
^["limits"]{
 holds: "a question a reader can probe in under an hour with a try kit, a CLI command, or a lookup"
 fails: "questions that need a study; there the arc keeps a forecast and a source instead of an observation"
 metaphor: "operator names are reader vocabulary here; the arc is a checklist, and no tool executes or orders it"
}

#>arc_wonder_ice_sink
^["instance"]{
 of: ~"../../matter/water.spw#matter_water_ice_sink_q"
 hunch: "a frozen lake behaves like a lid"
 question: "If ice sank, would lakes freeze from the bottom up?"
 forecast: "ice would pile up on the bottom and some would survive the summer"
 probe: ~"../../matter/water.spw#water_try_density"
 observe: _
 reflect: _
 next: _
 ~#(the layered glass shows cold water sinking; it cannot show a hundred winters)
}
