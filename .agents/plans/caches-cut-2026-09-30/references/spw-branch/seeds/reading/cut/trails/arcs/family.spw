# Family Conversation Arc
#
# A kitchen-table arc across three generations: a remembered scene, a child question, a try, a round of one-breath lines, and a note left for next time.

#>trail_family_conversation
#:layer #!pragmatics
#:domain #!meta
#:form #!trail
#:level #!intro
#:review #!unreviewed
#:valence #!boon

^"emit"{
 ~#title: "Family Conversation Arc"
 ~#claim: "A family conversation arc starts from an elder story, lets the child ask, tries the question at the table, and ends with everyone saying it once in their own words."
 ~#proof: "Each role speaks at a named step; the say round is the one-breath line, youngest first."
 ~#door: "Leave one question on paper for the next conversation."
 ~#audience: "families across generations"
 cold_open: "Tell a story, ask, try it, everyone says it once, and keep one question for next time."
 continuity: "Family Conversation Arc | story"
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5"
 lineage: #[ "new" ]
 method: #authored
}

^["edges"]{
 case_of: [ ~"./wonder.spw#arc_wonder_order" ]
 see: [ ~"../../matter/water.spw#water_try_density" ]
}

^["archetype"]{
 of: ~".spw/surfaces/surface-archetypes.spw#spw_surface_archetypes"
 name: #coordination_protocol
 cadence: #serialized_turn_taking
}

^["roles"]{
 elder: "brings a remembered scene"
 parent: "bridges the scene to something the table can try"
 child: "asks the question and says first"
}

#>arc_family_order
^["order"]{
 clock: "turn"
 schedule: << story ; question ; try ; say_round ; reflect ; note >>
 story: "When did you see ice where you did not expect it?"
 question: "the child turns the story into a question"
 try: ~"../../matter/water.spw#water_try_density"
 say_round: "each person says what happened in one breath, youngest first"
 reflect: "what the story and the glass agree on, and where they part"
 note: "one question on paper where the family will see it"
}

^["try"]{
 safety: "use warm tap water, not boiling water"
 time: .{ n: 15, unit: "minutes" }
}

#>arc_family_note
^["note"]{
 keep: "one question and the date"
 hands_off: ~"./wonder.spw#arc_wonder_order"
}
