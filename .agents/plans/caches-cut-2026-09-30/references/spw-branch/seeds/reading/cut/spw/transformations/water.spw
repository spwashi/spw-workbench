# Water Recipes
#
# Verified commands that reduce, expand, compare, and fill the water surface, each with what it keeps, what it drops, and the check after.

#>meta_recipes_water
#:layer #!pragmatics
#:domain #!meta
#:form #!protocol
#:level #!practitioner
#:review #!spot_checked
#:valence #!bone

^"emit"{
 ~#title: "Water Recipes"
 ~#claim: "Each recipe names a command, what it keeps, what it drops, and the check to run after it."
 ~#proof: "Every command was run on a scratch copy of this cut on 2026-10-01."
 ~#door: "Run the card recipe first, then read the water surface beside it."
 ~#audience: "readers and writers of this cut"
 cold_open: "Each recipe says what it keeps and what it drops."
 continuity: "Water Recipes | keeps, drops"
}

^"provenance"{
 as_of: "2026-10-01"
 generator: "claude-opus-5.5"
 lineage: #[ "new" ]
 method: #authored
}

^["edges"]{
 see: [ ~"../../matter/water.spw#matter_water" ]
}

^["recipes"]{
 #>recipe_water_card
 ^["card"]{
  kind: #reduction
  command: "spw emit pack .spw/caches/2026-09-30/matter/water.spw --host brief"
  keeps: #[ title, audience, claim, proof, door ]
  drops: #[ status, provenance, as_of, limits ]
  check: "spw emit pack .spw/caches/2026-09-30/matter/water.spw --host brief --strict-continuity"
 }
 #>recipe_water_voice
 ^["voice"]{
  kind: #reduction
  command: "spw emit pack .spw/caches/2026-09-30/matter/water.spw --host audio --strict-continuity"
  keeps: #[ title, cold_open, door ]
  drops: #[ claim, numbers, sources, limits ]
  check: "say the cold_open aloud once, then reread the density claim it stands for"
 }
 #>recipe_water_outline
 ^["outline"]{
  kind: #reduction
  command: "spw outline .spw/caches/2026-09-30/matter/water.spw"
  keeps: #[ frames, traits, paths ]
  drops: #[ anchors, particles, claim_status, wonders, door, cold_open ]
  check: "read the closing wonder and every #:claim line by eye; the outline does not show them"
 }
}
