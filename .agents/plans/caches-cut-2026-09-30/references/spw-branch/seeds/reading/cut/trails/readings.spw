# Reader Readings
#
# How a reader keeps personal readings beside this cut without editing it: an overlay per surface, one anchored reading per claim, anonymous until a reading recurs.

#>trail_readings_protocol
#:layer #!pragmatics
#:domain #!meta
#:form #!protocol
#:level #!mixed
#:review #!unreviewed
#:valence #!boon

^"emit"{
 ~#title: "Reader Readings"
 ~#claim: "A reader keeps readings in an overlay that points at cut anchors, and the cut never points back."
 ~#proof: "Apposition canon: anonymous for a one-off reading, named the moment it recurs; spw readings counts both."
 ~#door: "Start an overlay for the water surface."
 ~#audience: "readers keeping personal notes on this cut"
 cold_open: "Point at the claim, say it your way, and name the reading once you hear it twice."
 continuity: "Reader Readings | overlay"
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5"
 lineage: #[ "new" ]
 method: #authored
}

^["edges"]{
 grounds: [ ~"docs/theory/spw/apposition.spw#spw_apposition", ~"docs/research/spw/navigable-focus.spw" ]
}

#>readings_overlay_rules
^["overlay"]{
 home: "a reader root outside the cut that mirrors cut paths, such as readers/reader_a/matter/water.spw"
 key: "each reading binds of: to a cut path and anchor, and carries its own anchor r_<anchor>_<n>"
 direction: "overlays point at the cut; the cut never links to an overlay; backlinks come from the reference graph only when the reader opts in"
 interprets: "subjective: a reading may rank and disclose; it never gates, edits, or scores"
 promote: "an anonymous reading that recurs becomes a named reading, such as an image or a lens"
 retire: "a reading is annotated, never deleted, the way plan stream entries are"
}

#>readings_shape
^["shape"]{
 reading: "a reading frame holds of, frame, at, one apposition, an optional say line, and optional forecast and checked lines"
 frames: #[ lesson, live, day, season, family, solo ]
 say: "the say apposition is the one-breath line in the reader voice"
 calibration: "forecast and checked are the reader record of a guess and of what the source said"
}
