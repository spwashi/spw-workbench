# Production Season 2026
#
# The October to January production season as three movements: reflection, crescendo, and celebration with reset.

#>trail_season_2026
#:layer #!pragmatics
#:domain #!meta
#:form #!calendar
#:level #!practitioner
#:review #!unreviewed
#:valence #!bone

^"emit"{
 ~#title: "Production Season 2026"
 ~#claim: "The season runs from 2026-10-01 to 2027-01-04 in three movements: reflection, crescendo, and celebration with reset."
 ~#proof: "Dates and movement names come from the owner; each movement names what a tool can count and where the name stops applying."
 ~#door: "Open the production day arc to see one day inside a movement."
 ~#audience: "the owner and collaborators planning the season"
 cold_open: "Look back in October, build to a crescendo through December, then celebrate and reset by January fourth."
 continuity: "Production Season 2026 | crescendo"
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5"
 lineage: #[ "new" ]
 method: #authored
}

^["edges"]{
 extends: [ ~"./wonder.spw#arc_wonder_order" ]
 feeds: [ ~"./day.spw#arc_day_order" ]
}

^["archetype"]{
 of: ~".spw/surfaces/surface-archetypes.spw#spw_surface_archetypes"
 name: #seasonal_exhibit
 cadence: #bounded_cycle
}

^["clock"]{
 unit: "week"
 starts: "2026-10-01"
 ends: "2027-01-04"
 law: "season weeks never share a name with session beats, request epochs, or live minutes"
 order: << reflection ; crescendo ; celebration_reset >>
}

#>season_2026_reflection
^["reflection"]{
 #:season #!reflection
 from: "2026-10-01"
 to: _
 ask: "What did the last season teach that this one should keep?"
 counts: "readings written, wonders reopened, drafts retired"
 limit: "reflection counts what was reread; it says nothing about how the owner feels about the work"
 ~#say(read back before you make more)
}

#>season_2026_crescendo
^["crescendo"]{
 #:season #!crescendo
 from: _
 to: _
 ask: "Which one question will every piece this month circle?"
 counts: "finished pieces and live sessions per week, rising week over week"
 limit: "crescendo counts output; it measures neither quality nor audience response"
 ~#say(one question, more takes, louder each week)
}

#>season_2026_reset
^["celebration_reset"]{
 #:season #!reset
 from: _
 to: "2027-01-04"
 ask: "What shipped, what do we celebrate, and which question waits for next season?"
 counts: "a named last output, a shelf of what shipped, one resume note"
 limit: "a reset clears the plan; it keeps every reading and every open question"
 hands_off: ~"./wonder.spw#arc_wonder_order"
 ~#say(name it, thank it, shelve it, leave one question)
}
