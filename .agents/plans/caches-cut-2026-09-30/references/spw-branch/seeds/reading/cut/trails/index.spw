# Trails
#
# Arcs that carry one question across a lesson, a live session, a production day, a season, and a family table.

#>trails_index
#:layer #!pragmatics
#:domain #!meta
#:form #!index
#:level #!mixed
#:review #!unreviewed
#:valence #!bone

^"emit"{
 ~#title: "Trails"
 ~#claim: "Every arc in this folder is the wonder arc in a different frame, and each one ends by handing its question to the next frame."
 ~#proof: "The handoff digest below transcludes the closing rung of every arc."
 ~#door: "Start with the wonder arc, then follow any handoff."
 ~#audience: "anyone planning a lesson, a stream, a day, a season, or a family conversation"
 cold_open: "One question, carried from frame to frame."
 continuity: "Trails | handoff"
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5"
 lineage: #[ "new" ]
 method: #authored
}

^["tree"]{
 wonder: ~"./arcs/wonder.spw"
 lesson: ~"./arcs/lesson.spw"
 live: ~"./arcs/live.spw"
 day: ~"./arcs/day.spw"
 season: ~"./arcs/season.spw"
 family: ~"./arcs/family.spw"
 readings: ~"./readings.spw"
}

#>trails_handoffs
^["bundle"]{
 ={ ~"./arcs/live.spw#arc_live_close" }
 ={ ~"./arcs/lesson.spw#arc_lesson" }
 ={ ~"./arcs/family.spw#arc_family_note" }
 ={ ~"./arcs/day.spw#arc_day_close" }
 ={ ~"./arcs/season.spw#season_2026_reset" }
}
