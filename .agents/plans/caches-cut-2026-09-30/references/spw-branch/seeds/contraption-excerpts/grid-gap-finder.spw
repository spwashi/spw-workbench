^["cells"]{
 #>grid_g6_8
 ^["g6_8"]{
  properties: .{ gist: "density as mass divided by volume" }
  change: _
  energy: .{ gist: "thermal energy moves from warm to cool" }
 }
}
#>grid_gap_q
?["Which empty cell can its neighbours predict?"]{
 #:depth #!mathematical ~#lens(formal structure)
 !probe{ "count filled neighbours of each hole along the row order and across columns" =id[p_grid_gap] =kind[calc] }
 breaks: "strands share a committee decision, not a periodic law"
}
