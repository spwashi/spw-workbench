#>lab_opcode_map
^["columns"]{
 #>col_angle
 angle: .{ clean: 2, prose: 2, swallows: 9 }
}
^["walls"]{
 #>wall_question_angle
 ^["question_angle"]{
  canon_at: "operator-atlas.spw:29"
  parser_says: "at the start of a line ?<a, b> is a question Operation with a prose payload"
 }
}
^["gaps"]{
 #>gap_star_bracket
 star_bracket: .{ form: "*[a, b]", parses: true, reading: "unnamed" }
 #>cell_hash_bracket
 hash_bracket: .{ form: "#[a, b]", reading: "category set", status: "proposed" }
}
