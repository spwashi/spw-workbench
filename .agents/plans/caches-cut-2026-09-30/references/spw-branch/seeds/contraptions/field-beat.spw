^["run_sheet"]{
 order: << cold_open ; intro ; deep_dive || poll_overlay ; audience_qa ; outro >>
 #>seg_cold_open
 ^["cold_open"]{
  length: .{ n: 2, unit: "minutes" }
  hook: true
 }
}
^["cadence"]{
 decay: .{ half_life: 12, unit: "minutes" }
 beat: << decay ; inject >>
 ~#(no diffuse step: segments are moments in time, not neighbouring places)
}
