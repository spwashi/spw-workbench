#>kern_bias_tight
^["bias_tight"]{
 =~"./kerning.spw#kern_target"[near]{ ~"./kerning.spw#kern_target" }
}
#>kern_bias_open
^["bias_open"]{
 =[near] ~"./kerning.spw" { ~"./kerning.spw#kern_target" }
 note: "canon documents this spaced form at flow-protocol-sigils.spw:37 and :66; readBias returns no edge for it"
}
^["couple"]{
 tight: <>[figure, ground]
 open: figure <> ground
}
^["rule_control"]{
 tight: .card{ radius: 8 }
 open: .card { radius: 8 }
}
#>kern_target
^["target"]{ note: "the landing anchor for the bias rows" }
