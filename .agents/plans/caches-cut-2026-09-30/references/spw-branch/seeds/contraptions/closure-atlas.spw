#>top_convention
^["convention"]{ separation: "regular and normal include T1, as in Munkres" }
#>top_imp_regular_lindelof
^["regular_lindelof"]{
 #:claim #!settled
 if: #[ regular, lindelof ]
 then: #[ normal ]
}
#>top_sp_sorgenfrey_plane
^["sorgenfrey_plane"]{
 has: #[ hausdorff, regular, first_countable, separable ]
 lacks: #[ normal, lindelof ]
}
