#>claim_density
^["density_max"]{
 #:claim #!settled
 statement: "liquid water is densest near 4 degrees C"
 source: ~"./coupling-map.spw#src_handbook"
}
#>claim_heat
^["heat_capacity"]{
 #:claim #!settled
 statement: "liquid water has a high specific heat"
 source: ~"./coupling-map.spw#src_handbook"
}
#>claim_hydraulic
^["hydraulic"]{
 #:claim #!contested
 statement: "large-scale irrigation drove early state formation"
 source: ~"./coupling-map.spw#src_wittfogel"
 counter: ~"./coupling-map.spw#src_scarborough"
}
^["sources"]{
 #>src_handbook
 handbook: .{ role: "secondary", genre: "handbook" }
 #>src_wittfogel
 wittfogel: .{ year: 1957, genre: "monograph" }
 #>src_scarborough
 scarborough: .{ year: 2003, genre: "monograph" }
}
