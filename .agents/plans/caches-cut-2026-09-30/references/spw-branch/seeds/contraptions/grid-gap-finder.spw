^["axes"]{
 rows: #[ k2, g3_5, g6_8, g9_12 ]
 columns: #[ properties, change, energy ]
 row_order: << k2 ; g3_5 ; g6_8 ; g9_12 >>
}
^["cells"]{
 #>grid_g3_5
 ^["g3_5"]{
  properties: .{ gist: "mass stays the same when ice melts" }
  change: .{ gist: "mixing and dissolving" }
  energy: .{ gist: "sunlight warms surfaces" }
 }
 #>grid_g6_8
 ^["g6_8"]{
  properties: .{ gist: "density as mass divided by volume" }
  change: _
  energy: .{ gist: "thermal energy moves from warm to cool" }
 }
 #>grid_g9_12
 ^["g9_12"]{
  properties: .{ gist: "bonding explains bulk properties" }
  change: .{ gist: "reaction rates and equilibrium" }
  energy: _
 }
}
#>grid_gap_q
?["Which empty cell can its neighbours predict?"]{
 #:depth #!mathematical ~#lens(formal structure)
 !probe{ "count filled neighbours of each hole along the row order and across columns" =id[p_grid_gap] =kind[calc] }
 breaks: "strands share a committee decision, not a periodic law; a gap may be empty because the content is unsafe, not untried"
}
