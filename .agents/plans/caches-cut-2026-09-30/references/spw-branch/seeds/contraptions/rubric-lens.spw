^["levels"]{
 order: << beginning ; developing ; proficient ; extending >>
 to_unit: .{ beginning: 0.25, developing: 0.5, proficient: 0.75, extending: 1.0 }
 ~#(this mapping asserts equal spacing; the rubric itself is ordinal)
}
#>rubric_profile_a
^["profile_a"]{ evidence: extending, reasoning: beginning, design: extending, communication: extending }
#>rubric_profile_b
^["profile_b"]{ evidence: proficient, reasoning: proficient, design: proficient, communication: proficient }
^["aggregators"]{
 compensatory: "arithmetic mean"
 conjunctive: "minimum"
 multiplicative: "geometric mean"
}
