^["calling"]{
 page_32: << ?[lx_45, sq_12, fly_3] ; ![lx_45] || ![sq_12] ; ![fly_3] >>
 ~#(one GO word fires lx_45 and sq_12 together, so count that GO as one event)
}
^["rule_order"]{
 =boon~"./order-counter.spw#rule_grimm"[feeding]{ ~"./order-counter.spw#rule_verner" }
 =bane~"./order-counter.spw#rule_stress"[feeding]{ ~"./order-counter.spw#rule_verner" }
 attested: << ~"./order-counter.spw#rule_grimm" ; ~"./order-counter.spw#rule_verner" ; ~"./order-counter.spw#rule_stress" >>
}
^["rules"]{
 #>rule_grimm
 grimm: "voiceless stops became fricatives: p t k became f, thorn, x"
 #>rule_verner
 verner: "a non-initial voiceless fricative became voiced unless the immediately preceding syllable carried the accent"
 #>rule_stress
 stress: "the accent moved to the first syllable of the root"
}
