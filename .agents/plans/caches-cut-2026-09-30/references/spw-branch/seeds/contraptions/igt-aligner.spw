#>igt_tl_bumili
^["tagalog_bumili"]{
 form: "b<um>ili"
 gloss: "<AV>buy"
 shape: b<um>ili
}
#>igt_tr_evlerimde
^["turkish_evlerimde"]{
 form: "ev-ler-im-de"
 gloss: "house-PL-1SG.POSS-LOC"
 translation: "in my houses"
 ~#form(ev-ler-im-de)
}
#>igt_index_q
?["Do glossed examples sort languages by synthesis and by exponence?"]{
 #:depth #!mathematical ~#lens(formal structure)
 !probe{ "count Leipzig boundaries from rules 2, 9 and 10 and grammatical labels per morpheme" =id[p_ling_exponence] =kind[calc] }
 breaks: "the indices measure one glosser's segmentation and word definition, not the language"
}
