# Cut Contract 2026-09-30
#
# How every surface in this cut is written: shape, anchors, links, claims, quantities, wonder, experiential kits, integrity, and the gate that checks them.

#>cut_contract
#:layer #!pragmatics
#:domain #!meta
#:form #!contract
#:level #!practitioner
#:review #!spot_checked
#:valence #!bane

^"emit"{
 ~#title: "Cut Contract"
 ~#claim: "A surface in this cut is a sourced, addressable, publishable card with claims a reader can follow and a tool can check."
 ~#proof: "The rules below are enforced by scripts/analyzers/spw-cut-gate.ts and the brief emit gate."
 ~#door: "Open the water exemplar to see every rule applied once."
 ~#audience: "writers and reviewers of this cut"
 continuity: "Cut Contract | sourced, addressable"
}

^"provenance"{
 as_of: "2026-09-30"
 generator: "claude-opus-5.5"
 lineage: #[ "new" ]
 method: #authored
 evidence: #[ "understand pass: linking, metrics, tags, lens, emit, clustering, syntax, plugin theory, theory state" ]
}

^["edges"]{
 grounds: [ ~"./vocabulary.spw#cut_vocabulary" ]
 see: [ ~"./matter/water.spw#matter_water" ]
}

^["scope"]{
 what: "a dated reference cut: generated by gemini-3.8-flash-high on 2026-09-30, then revised, sourced, and restructured"
 not_a_cache: "nothing here is recomputed from a source on a clock; cache.layer/1 names editor cache planes and does not apply"
 stewardship: "the cut aims to stay useful for years: every dated fact carries as_of, every keystone claim a status and a source"
 raw: "the unrevised generation is archived under provenance/ with a manifest mapping each raw file to its new home"
}

^["shape"]{
 order: << "title comment" ; "#> file anchor" ; "axis stack" ; "^emit card" ; "^provenance" ; "^edges" ; "^concepts" ; "content frames" ; "^try kits" ; "wonder blocks" >>
 title: "two or three # lines: a title, a blank #, and one sentence; no apostrophes in # lines"
 file_anchor: "the first code line; it binds to the emit card, so a bundle that cites the file anchor carries the card"
 size: "aim under 300 lines; split a surface before it passes 600"
 nesting: "nest ^ frames where the ontology is real; depth 5 to 7 is fine when each level names something"
 strings: "one claim per line; never wrap a string across lines"
}

^["axes"]{
 required: #[ layer, domain, form, level, review, valence ]
 optional: #[ era, season ]
 form: "#:axis #!value on its own line in the header stack, values from vocabulary.spw"
 honesty: "layer and review must be true of the surface; unreviewed is an honest value"
}

^["anchors"]{
 names: "domain slug first, then topic: matter_water, water_density_max; letters, digits, underscore, hyphen"
 unique: "unique across the whole cut; the gate rejects duplicates"
 placement: "directly before the ^ frame or binding it names; never inside #[ ] or .{ }; never trailing"
 keystones: "every keystone claim, glossary term, timeline rung, case, and wonder gets its own anchor"
}

^["links"]{
 tree: "an index routes children with ^[tree]{ key: ~./child.spw } and no fragment"
 bundle: "an index lists transcluded digests with ^[bundle]{ ={ ~./child.spw#child_anchor } }; spw expand follows these"
 edges: "typed pointers live in ^[edges]{ relation: [ ~path#anchor ] }; relations come from vocabulary.spw"
 canon: "links into repo canon use a root-relative path such as .spw/tooling/vscode-spw.spw#spw_tooling_vscode"
 neighbor: "inside a wonder, point at the nearest claim with a path ref followed by ~#neighbor(nearest)"
 direction: "children never link up to their own index; backlinks come from the LSP reference graph"
 banned: #[ "^dispatch tables", "bare @alias values", "tagged ~<tag> path forms", "quoted ~< > path forms", "fragment-less same-file refs" ]
}

^["claims"]{
 keystone: "#>anchor, then a ^[name] frame holding #:claim #!status, statement, source, and optional reads, counter, limits"
 status: "settled, contested, emerging, speculative, refuted, interpretive, superseded"
 source: "link a #>src_ anchor in registries/sources; an apposition ~#(author year) may add context but never replaces the link"
 limits: "a ^[limits]{ holds, fails } frame states where a claim stops being true"
 currency: "facts that change (prices, rules, platform policy, guidelines, dates) carry as_of and the version or edition they come from"
 no_invented_numbers: "no effect size, percentage, or rate without a source; a hypothesis states direction, not magnitude"
}

^["quantities"]{
 cell: "registries/quantities/<branch>.spw holds %ns.key{ value, unit, at, rel or abs, src, status } cells under a #>q_ns anchor"
 handle: "namespace.quantity_unit in lowercase; one cell per handle across the cut"
 reads: "a claim cites cells with reads: %[ns.key]; a wonder with $%[ns.key] carrying at most three handles"
 reflexive: "surface measures may use only the handles the gate lists, which spw census and spw form compute"
 numbers: "integers and decimals only as bare numbers; negatives, dates, units, and percentages go in strings"
}

^["wonder"]{
 anchor: "#>domain_topic_q before the ?[ ] block"
 first_line: "#:depth #!value ~#lens(phrase), both from vocabulary.spw"
 status: "#:claim #!speculative before the hypothesis unless the wonder asks about a settled mechanism"
 probe: "!probe{ short description =id[p_domain_topic] =kind[kind] } with a unique id"
 analogy: "a cross-domain wonder names where the analogy breaks in a breaks: binding"
}

^["try"]{
 purpose: "experiential access: a reader can do something with their hands, voice, or tools in under an hour"
 fields: "materials, steps as a << a ; b >> schedule, time, safety, and shows linking the claim it demonstrates"
 safety: "every activity names its hazard or states that it has none worth naming"
}

^["integrity"]{
 health: "health, nursing, and physiology surfaces are educational reference, never clinical instruction; they carry a ^[scope] frame that says so"
 guidelines: "every protocol names its guideline body, version, and year; superseded practice is marked superseded, not deleted"
 contraindications: "a drug or intervention named in a protocol lists its principal contraindications or links where they live"
 contested: "a contested finding says so and names the disagreement; replication failures are recorded as refuted or contested"
 generated: "anything carried over from the raw generation without checking stays review unreviewed"
}

^["inspection"]{
 receipts: "provenance holds a ^[receipts] frame: one nested frame per inspection with event, at, agent, care, and outcome"
 care_ladder: "glance, skim, read, audit, adversarial; a receipt names the care actually applied, not the care intended"
 honesty: "the #:review axis summarizes the highest care any receipt reports with a passing outcome"
 unpredictability: "readers bring unpredictable care; receipts let the next reader see what was already checked and start where care ran out"
}

^["ethics"]{
 disclosure: "provenance names the generator and the reviser of every surface; generated text is never presented as authored scholarship"
 attribution: "a named method, principle, framework, or quotation credits its originator, for example Thomas and Johnston for the twelve principles of animation"
 citation_integrity: "cite only works you can name exactly by title, author, year, and venue; never invent a source, and mark an unverified claim unreviewed instead"
 corrections: "every correction to the raw generation is listed in provenance corrections, so a reader who met the error elsewhere can see it fixed"
 dissent: "a contested or refuted claim keeps its counter-source in view; a known error is recorded as refuted, not silently deleted"
 origins: "credit where practices, genres, and knowledge come from, including non-Western and community sources; describe groups without stereotype"
 people: "name public figures and published authors only; internal case studies use the repository record and the owner in their own words"
 quotation: "quote briefly with attribution; paraphrase otherwise"
 privacy: "no local paths, emails, credentials, or private individuals in any surface or emitted pack"
 numbers: "a number without a source is a question for a wonder block, not a claim"
 gate: "the cut gate fails a sourced surface whose factual claims lack a source link, and any provenance that omits as_of, generator, or lineage"
}

^["graph"]{
 teaching: "this cut is also an example of how to structure a Spw graph; the idioms are written up in the graph idioms surface"
 tree: "one authored parent per surface; the tree is for finding, not for meaning"
 edges: "meaning lives in typed edges between anchors; an edge is a claim and should be defensible"
 bundles: "bundles gather digests for reading in one pass; they transclude, so keep them small"
 facets: "closed-vocabulary axes cut across the tree; a value that never recurs is noise"
 registries: "quantities and sources live once and are cited many times"
 clusters: "computed clusters are prompts to compare, never claims"
}

^["hazards"]{
 valence_keys: "boon, bane, bone, bonk, and honk are modifiers; as binding keys they degrade the whole surface to prose"
 comparisons: "comparison operators inside [ ] degrade the surface; write them in strings"
 medial_capsule: "a value like 48<hours> must end its line with a comma or closer, or it swallows the next line"
 empty_binding: "a key with no value on its line takes the next line as its value"
 arrow: "=> separates sequence steps; it does not bind"
 same_line_tags: "a #tag value followed by another key on the same line nests that key inside the tag; separate same-line bindings with commas or put each on its own line"
 dollar_percent: "$% parses as two operations; keep it to wonder metric lines"
 non_ascii: "keep non-ASCII characters, dashes, and apostrophes inside strings"
}

^["gate"]{
 structure: "node --import tsx scripts/analyzers/spw-cut-gate.ts .spw/caches/2026-09-30"
 publishing: "the same gate with --emit runs spw emit pack --host brief --strict-continuity --strict-positive on every card"
 links: "npm run spw -- resolve --from .spw/caches/2026-09-30 --warn"
 parse: "node --import tsx scripts/analyzers/spw-syntax-validate.ts -- .spw/caches/2026-09-30"
}
