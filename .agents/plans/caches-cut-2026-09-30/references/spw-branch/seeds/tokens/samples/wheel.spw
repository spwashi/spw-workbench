# Wheel
#
# Generator discs and a template for a wonder comprehension.

#>wheel
#:topic #!play

^"wheel"{
 #>lens_disc
 lens: #[ecological_zone ; molecular_binding ; formal_structure]
 #>era_disc
 era: #[newton ; laplace ; now]
}

#>wonder_tpl
?["How does the tide read through $lens, as of $era?"]{
 #:depth #!computational
 ~#lens($lens)
 ~#say(the tide, seen as $lens)
}

#>tide_wonders
=~"./wheel.spw#wonder_tpl"[comprehend]{ ~"./wheel.spw#lens_disc" ; ~"./wheel.spw#era_disc" }
