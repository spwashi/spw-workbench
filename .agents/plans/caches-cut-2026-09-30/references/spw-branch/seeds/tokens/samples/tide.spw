# Tide
#
# A small canon-shaped surface for transform probes.

#>tide
#:topic #!oceanography
#:status #!interpretive

^["card"]{
 gist: "Tides are the ocean answering the moon."
}

#>tide_claim
^"claim"{
 #:claim #!settled
 statement: "Two bulges; two highs a day."
 ~#source(Newton, Principia III)
}

#>wonder_tide_1
?["Where does the two-bulge picture stop being enough?"]{
  #:depth #!computational
  ~#lens(ecological zone)
  !probe{ "compare a basin with its resonant period near 12.4 hours" }
  =ref{ ~"./basin.spw#basin_resonance" }
  << ? ; ~ ; ! ; % ; ^ >>
}
