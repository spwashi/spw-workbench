# Readings, Sam
#
# Personal overlay. Never edits canon; binds by anchor.

#>readings_sam
#:overlay #!personal

=~"./tide.spw#wonder_tide_1"[reading]{ ~"./sam.spw#sam_tide_1" }
=~"./basin.spw#basin_resonance"[reading]{ ~"./sam.spw#sam_basin_1" }

#>sam_tide_1
^"reading"{
 ~#say(the moon pulls twice, and the basin answers once)
 ~#(a bathtub sloshing at the wrong tempo)
 beat: 3
}

#>sam_basin_1
^"reading"{
 ~#say(resonance is the basin agreeing too much)
}
