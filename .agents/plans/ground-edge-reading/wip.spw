# wip — ground-edge-reading
# Started: 2026-11-06

#>plan_ground_edge_reading
#:plan #!projection_feedback
#:layer #!semantics

@["card"]{
 phase: #seed
 gist: "Two forms read as their shared ground, the first slot where they part, and what each holds alone"
 touches: [~"packages/spw-cli/src/delta.ts", ~"packages/spw-cli/src/expand.ts", ~"packages/spw-cli/src/skim.ts"]
 entry: ~"./PLAN.md"
 next: "?[verb_or_flag]: the owner picks a delta flag or a verb of its own; then ~[sibling_fixture], two sibling files whose one edge is the name."
}

^["edges"]{
 needs: [~"../brace-slot-reading/wip.spw"]
 feeds: [~"../vscode-authoring-probe-loop/wip.spw"]
 shares: [~"../cli-sense-reorientation/wip.spw", ~"../citation-navigation/wip.spw"]
}

^["roots"]{
 @plan: ~".agents/plans/ground-edge-reading/PLAN.md"
 @delta: ~"packages/spw-cli/src/delta.ts"
 @expand: ~"packages/spw-cli/src/expand.ts"
 @skim: ~"packages/spw-cli/src/skim.ts"
 @change_report: ~"packages/spw-seed/src/canonical/change-report.ts"
}

^["intent"]{
 ~#goal: "The CLI answers the consumer's core question, where two understandings stop sharing ground, in a form that parses back as Spw and that the editor's compare lens can open"
 ~#taste: "Ground arrives short and the edge arrives whole; delta stays the revision reading"
}

^["intake"]{
 # The consumer asks this plan owns. Ranks are the consumer's; consumer-relative paths.
 source: "consumer .spw/reviews/upstream-workbench-recommendations/motions.spw, frame motions_asks; capabilities.spw, ground_edge_home; corpus-and-cli.spw, sibling_shapes"
 ground_then_edge: .{ rank = 1 home = @plan status = #owned }
 template_with_a_slot: .{ rank = 2 home = @plan status = #owned }
 reduction_names_its_residue: .{ rank = 3 home = @plan status = #owned }
 sibling_shapes: .{ home = @plan status = #owned }
 compare_in_the_editor: .{ rank = 13 home = ~"../vscode-authoring-probe-loop/wip.spw" status = #routed }
 consumer_reading: "scripts/spw-routes.mjs --diff (ground, first, edge, own; _family.spw shapes with saves and costs); spw.quest specimens compare two lines slot by slot"
 misrouted: "the consumer's ground_edge_home names spw-beat-diff-precipitation, which was rescoped to LSP cache TTLs; this plan is the home to send back"
}

^["open"]{
 # Unresolved questions. When resolved: log in stream, then move to ^["done"] as ~#resolved(label).
 ?[verb_or_flag]: "Is the sibling reading a flag on spw delta or a verb of its own, since the two surfaces are not revisions of each other?"
 ?[own_keeps_position]: "Should own keep its position as a stream, or stay a set that says how many parts it misplaces? (25 of 122 consumer routes hold an own section before or inside their shape)"
 ?[naming_bar]: "Is a positive saves count the bar for naming a shape? (17 of 32 consumer shapes would save tokens; 13 cost more than they save)"
 ?[anti_unifier]: ~"./wip.spw#wonder_ground_edge_reading_anti_unifier"
}

#>wonder_ground_edge_reading_anti_unifier
?["Is ground-then-edge an anti-unifier, the least general template two forms share, or only a per-slot shadow of one?"]{
 #:depth #!computational ~#lens(projection)
 ~#hypothesis: "Read one slot level deep, the ground is the anti-unifier's shape and the edge is its first variable; nesting is where the two readings part."
 ~#expect: "On the consumer's 32 family shapes, the one-level reading and a least-general generalization agree wherever the shape has one slot."
 ~#unblocks: "~[template_slot_value], and whether a reduction's residue is the substitution"
 !probe{ "compare the consumer's _family.spw shapes against a least-general generalization computed over the same members" }
 $%[shape.slots, lgg.variables, agree.count]
}

^["commits"]{
 # Named, in order. Planned ~[name]; landed .[name](hash). Names are never reused.
 ~[sibling_fixture]: "![cli] — two sibling fixtures that part only at the name, and two that part at four slots; the reading is red until it finds one edge and four"
 ~[ground_edge_reading]: "&[cli] — read two forms as ground (a shape handle or count), first (the slot where they part), edge and own; delta's revision output unchanged (after ?[verb_or_flag])"
 ~[reading_parses_back]: "![cli] — the reading prints Spw that seed parses, as the consumer's dual_read_roundtrip asks of every --spw card"
 ~[template_slot_value]: "&[cli] — expand takes a value for a template's slot at the edge; the consumer does not propose the syntax"
 ~[reduction_residue]: "&[cli] — skim and the reduction print what they dropped as a count and a citation, and expand-after-reduce reports what did not come back"
}

^["stream"]{
 >>[2026-11-06 17:24] observe — A mounted consumer filed ground_then_edge, template_with_a_slot and reduction_names_its_residue on 2026-10-25 and sent them, as ground_edge_home on 2026-10-27, to spw-beat-diff-precipitation. That plan had already been rescoped to cache TTLs, with its diff engine superseded by ChangeReport (its PLAN.md), so no workbench plan read the asks, and vscode-authoring-probe-loop's compare_lens waits on a reading nobody owned.
 >>[2026-11-06 17:24] decide — This plan owns the reading and the slot fill. The editor lens stays in vscode-authoring-probe-loop; the slot reader is shared with brace-slot-reading, so the CLI, the parser and the consumer's reader name the same slot for the same edge.
 >>[2026-11-06 17:24] note — Consumer measurements to reproduce, not trust: spw delta bane.land.spw boon.land.spw counts 52 lexical ops (insert 26, delete 3, replace 23) where the consumer's reading finds one edge at the name; /topics/slop/ against /about/ parts at the expression with four slots moved.
}

