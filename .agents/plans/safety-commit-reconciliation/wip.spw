}

^["recursive_improvement"]{
 loop: [
  "? compare one partition with its parent and declared episode",
  "< restore or improve one dependency-closed slice",
  "$ record tests, omissions, and intentional differences",
  "^ fold verified behavior into theory and commit literature",
  "% preserve Seed portability and the original checkout",
 ]
