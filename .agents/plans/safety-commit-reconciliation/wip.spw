}

^["risk_model"]{
 hard_failures: [#missing_file, #non_building_partition, #payload_loss, #layer_violation]
 soft_failures: [#temporary_doc_reference, #plan_cache_drift]
 recoveries: [#compare_checkpoint_tree, #reapply_partition, #stop_before_commit]
 non_negotiables: [#original_checkout_untouched, #no_hook_bypass, #explicit_effect_grade]
}

^["validation"]{
 hypotheses: [#dependency_ordered_history_preserves_intent]
 negative_controls: [#main_status_unchanged, #checkpoint_object_unchanged, #no_golden_drift]
 demo_path: [#manifest, #apply_without_commit, #partition, #focused_gate, #tree_compare, #human_gate]
}

^["pulse_trajectory"]{
 effect_slugs: ["effect.l0.measure", "effect.l1.memory", "effect.l2.workspace", "effect.l3.external"]
