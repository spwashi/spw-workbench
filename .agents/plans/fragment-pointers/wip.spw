^["intent"]{
 ~#goal: "Any span of Spw can be named by its content, compared by its form, and placed in another block by citation, transclusion, or evaluation, and every reader (CLI, LSP, editors, the gate) resolves the name the same way."
 ~#taste: "identity from content, similarity from form, and the boundary stated before anything is embedded"
}

