# wip — intellij-lsp4ij
# Branch: feature/intellij-lsp4ij
# Started: 2026-04-02

#:layer #!pragmatics

^["roots"]{
 @cluster: ~".agents/plans/plan-ecology-clustering/plan-ecology-clustering.spw"
 @plan: ~".agents/plans/intellij-lsp4ij/PLAN.md"
 @lsp_plan: ~".agents/plans/lsp-custom-request-completions/PLAN.md"
 @build: ~"extensions/intellij-spw/build.gradle.kts"
 @plugin_xml: ~"extensions/intellij-spw/src/main/resources/META-INF/plugin.xml"
 @server_support: ~"extensions/intellij-spw/src/main/kotlin/com/spwashi/spw/SpwLspServerSupportProvider.kt"
 @configurable: ~"extensions/intellij-spw/src/main/kotlin/com/spwashi/spw/settings/SpwLspConfigurable.kt"
 @settings: ~"extensions/intellij-spw/src/main/kotlin/com/spwashi/spw/settings/SpwLspSettings.kt"
 @custom_requests: ~"extensions/vscode-spw/src/lsp/custom-requests.ts"
}

^["intent"]{
 ~#goal: "Decide whether LSP4IJ is justified by repeated mounted-consumer review needs; if so, migrate only far enough to expose the narrow custom-request interactions that earn their utility."
 ~#taste: "clarity, layering, evidence — substrate migration follows demonstrated review value, not editor parity"
}

^["development"]{
 lane: #speculative_editor_future
 ladder: #component
 develops: [#lsp4ij_migration, #custom_request_bridge, #editor_surface_parity]
 review_surfaces: [@cluster, @plan, @lsp_plan, @build]
 snippet_routes: [#kotlin_interface, #lsp4ij_factory, #tool_window]
}

^["concept_index"]{
 primary: [#lsp4ij, #language_server_factory, #custom_server_interface, #workspace_service]
 surfaces: [#annotations_panel, #workspace_atlas_panel, #context_strip]
 tensions: [#native_api_vs_lsp4ij, #kotlin_java_interop, #build_toolchain_age]
 transfers: [#component, #service]
}

^["recursive_improvement"]{
 loop: [
  "? reread LSP4IJ DeveloperGuide before writing the factory class",
  "< fix the build first — nothing else moves without a clean ./gradlew buildPlugin",
  "$ record which LSP4IJ extension points map to the native API equivalents",
  "^ fold the stable migration pattern back into the factory and plugin.xml",
  "% keep surfaces thin — panels render, services own state",
 ]
 gates: [#build_clean, #lsp_starts, #custom_requests_callable, #surfaces_render]
}

^["parallel_work"]{
 critical_path: [#build_fix, #lsp4ij_migration, #custom_request_bridge]
 parallelizable: [#annotations_panel, #workspace_atlas_panel, #context_strip]
 shared_hot_files: [
  "extensions/intellij-spw/build.gradle.kts",
  "extensions/intellij-spw/src/main/resources/META-INF/plugin.xml",
  "extensions/intellij-spw/src/main/kotlin/com/spwashi/spw/SpwLspServerSupportProvider.kt",
 ]
 merge_risks: [#plugin_xml_conflict, #gradle_version_jump]
 handoff_artifacts: [@plan]
}

^["supporting_documents"]{
 must_ship: [@plan]
 helpful: [@lsp_plan, @custom_requests]
 carries: [#lsp4ij_migration_notes, #kotlin_data_classes, #tool_window_registration]
}

^["contract_axes"]{
 migration_from: #native_jetbrains_lsp_api
 migration_to: #lsp4ij
 bridge_method: #language_server_factory_get_server_interface
 surfaces: [#annotations_panel, #workspace_atlas_panel, #context_strip_widget]
 state_owner: #spw_workspace_service
 invalidators: [#file_save, #lsp_restart, #manifest_change]
}

^["phase_sequence"]{
 ~[1]: "audit — identify the 263 native replacement boundary and compare LSP4IJ"
 ~[2]: "migrate — swap native LSP API for LSP4IJ LanguageServerFactory"
 ~[3]: "bridge — SpwCustomServer @JsonRequest interface + SpwWorkspaceService"
 ~[4]: "surfaces — annotation panel, workspace atlas panel, context strip"
}

^["stream"]{
 >>[2026-04-02 00:00] observe — build currently fails on SpwLspConfigurable.kt due to unresolved TextFieldWithBrowseButton; must be fixed before any Gradle tasks run.
 >>[2026-04-02 00:00] observe — Gradle IntelliJ Plugin is at 2.1.0; minimum for 2026 targets is 2.13.1; upgrading is a prerequisite.
 >>[2026-04-02 00:00] decide — use LSP4IJ LanguageServerFactory.getServerInterface() with @JsonRequest annotations for the custom request bridge; this is the LSP4IJ-idiomatic approach.
 >>[2026-04-02 00:00] note — phases 3 and 4 depend on Plan A (lsp-custom-request-completions) landing first; bridge is useless until the server handlers exist.
 >>[2026-07-20 14:48] observe — the IntelliJ build now succeeds on the native JetBrains LSP API, while mounted-consumer startup and corpus-aligned claim navigation remain more immediate gaps than custom-request panel parity.
 >>[2026-07-20 14:49] revise — demote migration from decided execution to a speculative adapter choice. Activate only when mounted reviews demonstrate a repeated interaction that standard LSP/native IntelliJ surfaces cannot describe well.
 >>[2026-07-20 15:13] revise — use the shared editor-surface audit and an identity-free fixture as the activation gate; no consumer identifier or specific domain belongs in migration evidence.
 >>[2026-08-24 14:33] observe — WebStorm compatibility work now builds with IntelliJ Platform Gradle Plugin 2.18.1, verifies 242..262.*, and resolves mounted launchers without changing the client substrate.
 >>[2026-08-24 14:34] decide — Plugin Verifier's nine native LSP deprecations create a required decision before 263, while successful 262 verification keeps LSP4IJ speculative today.
 >>[2026-08-24 14:35] decide — resolved [community_vs_ultimate]: WebStorm is the supported and verified host product for the current plugin; broader Community-host distribution is a separate product decision, not a migration prerequisite.
}

^["open"]{
 ?[lsp4ij_version]: "Which LSP4IJ version to target? 0.14.0 was the last stable as of research; confirm latest before writing build.gradle.kts."
 # resolved: [community_vs_ultimate] — see stream 2026-08-24 14:35
 ?[configurable_replacement]: "Can LSP4IJ's built-in server settings UI cover work-dir + command fields, or do we need to keep SpwLspConfigurable with a fixed JBTextField approach?"
 ?[tool_window_api]: "Which IntelliJ Platform tool window registration API should the panels use — plugin.xml toolWindow extension point vs runtime registration?"
}

^["commits"]{
 ~[1]: "![intellij] *audit[native-lsp] — identify the 263 replacement boundary and compare LSP4IJ"
 ~[2]: "&[intellij] =migration[lsp4ij] — replace native LSP API with LSP4IJ LanguageServerFactory"
 ~[3]: "^seed[intellij] — add SpwCustomServer interface and WorkspaceService state caching"
 ~[4]: "&[intellij] =surface[panels] — add annotation panel, workspace atlas panel, context strip widget"
}

