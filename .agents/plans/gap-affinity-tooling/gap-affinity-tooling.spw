# Gap Affinity Tooling
# Distilled contract for significant spacing, association, formatting, and question-oriented parser products.

#>gap_affinity_tooling
#:layer #!semantics
#:status #!partial

^seed[Spw.Plan.Gap.Affinity.Tooling v:0.1 @profile:Spw.p @intent:gap_association_product]

^["roots"]{
 @plan: ~".agents/plans/gap-affinity-tooling/PLAN.md"
 @wip: ~".agents/plans/gap-affinity-tooling/wip.spw"
 @topography: ~"docs/theory/spw/operational-topography.spw"
 @fixity: ~"docs/theory/spw/fixity-brace-phrases.spw"
 @syntax_stack: ~"docs/theory/spw/syntax-profile-stack.spw"
 @identifier_lexer: ~"packages/spw-seed/src/lexer/matchers/identifiers.ts"
 @parse: ~"packages/spw-seed/src/parser/parse.ts"
 @parse_products: ~"packages/spw-seed/src/parser/products.ts"
 @progressive_ir: ~"packages/spw-seed/src/ir/progressive.ts"
 @runtime_trace: ~"packages/spw-runtime/src/interpreter/types.ts"
 @spacing_inspect: ~"packages/spw-cli/src/inspect-spacing.ts"
 @source_inspect: ~"packages/spw-cli/src/inspect-source.ts"
 @reader_note: ~"docs/runtime/md/spacing-and-progressive-inspection.md"
 @format: ~"packages/spw-seed/src/canonical/format-pulses.ts"
}

^["status"]{
 implemented: #[
  "lexer emits TokenGap products with exact raw intervals, trivia indices, spans, and tight/open/cadence/episode classes",
  "tight dotted identifiers retain IDENTIFIER compatibility and expose ordered segments",
  "trailing dot and repeated dot silhouettes remain explicit operator or connector products",
  "grammar observes adjacency in selected operator-label and inline-payload paths",
  "parse and lex products disclose none/diagnostics/trace retention with generated and retained counts",
  "runtime traces disclose none/stages/evaluation with generated and retained counts",
  "inspect.spacing/1 projects one observational product as table, Spw card, or JSON envelope",
  "spw.progressive-product/1 gives source stages a shared revision, sequence, completeness, omission, deferral, and elapsed-time receipt",
  "inspect.source/1 requests tokens, structure, or trace and projects the same stage records as human, Spw, JSON, or live NDJSON output",
  "tokens stops after lexing; structure reuses that lex pass; trace widens retained disclosure over the same parse",
  "format pulses disclose ordered string-rewrite capabilities",
 ]
 measured: #[
  "consumer-shaped probes found dot-heavy expressions and material parse-event volume",
  "docs/index.spw produced 335 classified gaps and 7563 generated parse events while diagnostics retained zero",
  "exact performance attribution remains a benchmark input, not language law",
 ]
 proposed: #[#association_ir, #index_product, #semantic_product, #workspace_format_policy, #format_profile_migration, #format_receipt, #consumer_exchange, #projection_budget_hint]
 interpretive: #[#spacing_resonance, #charge, #affect, #atmosphere]
}

^["terms"]{
 binding_affinity: "deterministic association derived from declared gap classes, line and bound ports, and operator rules"
 spacing_resonance: "a measured nonsemantic signal for ranking, formatting suggestions, folding, or projection"
 collapse: "a named projection that preserves an identity or reports its information loss"
 counterexample: "a minifier that turns a . b into a.b before parsing changes the association product and is not a layout-only collapse"
}

^["gap_algebra"]{
 classes: #[
  .{id=tight, surface=`no trivia gap`, collapse=`identity only`},
  .{id=open, surface=`one or more horizontal whitespace characters`, collapse=`width may normalize within open`},
  .{id=cadence, surface=`one newline boundary`, collapse=`dialect-declared only`},
  .{id=episode, surface=`blank-line boundary`, collapse=`dialect-declared only`},
 ]
 retains: #[#raw_text, #trivia_tokens, #source_span, #left_token, #right_token]
 excludes: "comments remain explicit trivia and are not reduced to anonymous whitespace"
}

^["affinity_matrix"]{
 tight_tight: .{association=compact, dot=`qualified path candidate`}
 open_open: .{association=infix, dot=`local edge chain candidate`}
 open_tight: .{association=prefix, rule=`operator-specific or diagnostic`}
 tight_open: .{association=postfix, rule=`operator-specific or diagnostic`}
 begin_line: .{association=prefix_candidate, authority=`declared operator rule`}
 end_line: .{association=postfix_candidate, authority=`declared operator rule`}
 precedence: #[#tight_lexical, #bound_completion, #prefix_postfix, #open_infix, #bound_separator]
}

^["dot_and_bound_products"]{
 qualified: .{surface=`a.b.c`, product=`QualifiedPath[a,b,c]`}
 edge: .{surface=`a . b . c`, product=`EdgeChain[a,b,c]`, association=chain}
 facet: .{surface=`.{a:b}`, product=`FacetConstructor`, reserved=true}
 ordinal: .{surface=`{ a ; b ; c }`, product=`OrdinalBody[a,b,c]`, owner=`nearest bound`}
 common: .{surface=`{ a , b , c }`, product=`CommonBody[a,b,c]`, owner=`nearest bound`}
 law: "separator geometry owns body slots; an edge chain may inhabit a slot but does not replace ordinal or common membership"
}

^["profile_boundary"]{
 semantic: .{id=`syntax.gap-affinity/1`, may_change=#[#tokens, #ast, #onf], must_disclose=#[#source, #revision, #resolver]}
 product: .{ids=#[tokens, structure, index, semantic, trace], may_change=#[#work, #completeness, #latency], preserves=#[#requested_product_identity]}
 events: .{ids=#[none, diagnostics, trace], may_change=#[#event_count, #memory, #latency], preserves=#[#semantic_product]}
 tooling: .{name=`spacing resonance`, may_change=#[#rank, #fold, #suggestion], preserves=#[#tokens, #ast, #onf, #effects]}
 projection: .{may_change=#[#disclosure, #atmosphere, #interaction], preserves=#[#semantic_baseline, #association_hash]}
}

^["observational_increment"]{
 surface: #inspect_spacing_1
 status: #implemented
 revisions: #[cdd0b40a ; 8d454ad6 ; 211d7653]
 preserves: #[#raw_gap, #token_type, #ast, #runtime_value, #register_semantics]
 discloses: #[#gap_class, #identifier_segments, #events_generated, #events_retained, #relative_path]
 projections: #[#table, #spw_card, #json_envelope]
 refuses: #[#association_semantics, #format_write, #workspace_style_inference]
 verification: #[#test_seed_701, #test_runtime_184, #test_cli_192, #typecheck, #spw_374, #writerside]
}

^["progressive_product_increment"]{
 protocol: `spw.progressive-product/1`
 surface: #inspect_source_1
 status: #implemented
 revision: deb9e226
 products: #[`source.tokens/1` ; `source.structure/1` ; `source.trace/1`]
 projections: #[#human_table ; #spw_card ; #json_bundle ; #live_ndjson]
 receipt: #[#product ; #revision ; #ir ; #sequence ; #stage ; #status ; #completeness ; #included ; #omitted ; #deferred ; #elapsed_ms]
 performance_law: "tokens stops before grammar work; live NDJSON publishes each record when its stage becomes available"
 refuses: #[#incremental_parse ; #index_product ; #semantic_product ; #generator_suppression ; #second_grammar]
 verification: #[#test_seed_704 ; #test_runtime_184 ; #test_cli_194 ; #typecheck ; #live_stage_order]
}

^["formatting_law"]{
 default: "normalize raw width only within the active gap class"
 semantic_migration: "crossing a gap class emits a distinct preview with before/after association hashes and explicit authority"
 receipt: #[#profile, #rule, #source_map, #gap_ids, #before_hash, #after_hash, #loss, #elapsed]
 checks: #[#complete_parse, #declared_profile, #idempotence, #requested_identity]
 range: "resolve enclosing parser context; isolated selected text is not sufficient evidence"
}

^["workspace_format_policy"]{
 status: proposed
 bootstrap: .{profile=`format-policy/1`, rule=`a policy cannot alter the grammar used to resolve itself during the same pass`}
 resolution: ?<built_in, workspace, scoped, invocation>[reg=pipeline]
 controls: #[#indent_unit, #continuation_indent, #gap_width, #operator_rendering, #line_port, #bound_layout, #cluster, #fold]
 transforms: #[
  .{class=surface, authority=`format`, preserves=#[#association, #structure]},
  .{class=structure_preserving, authority=`refactor`, preserves=#[#association, #semantic_hash]},
  .{class=semantic_migration, authority=`migration`, discloses=#[#before_hash, #after_hash, #compatibility]},
 ]
 receipt: #[#policy_revision, #winning_rule, #scope, #affected_spans, #before_hash, #after_hash, #compatibility, #elapsed]
 source_evidence: .{status=proposed_followon, authority=`explicit registration only`, filename_authority=false}
 cultural_affordance: "shareable profiles and migration receipts provide names for discussing conventions and consequences; they do not infer community identity or value"
 fallback: "an unresolved policy conflict produces a diagnostic and no edit"
 counterexample: "moving an unregistered document changes resolved format policy"
}

^["format_profile_migration"]{
 identity: #[#from_profile, #to_profile, #capability_revision, #workspace_revision, #migration_id]
 stages: ?<plan, apply, verify>[reg=pipeline]
 plan: #[#preconditions, #affected_files, #surface_deltas, #association_deltas, #compatibility_window, #reversibility]
 apply: .{authority=`explicit`, consumes=#plan, writes=#source}
 verify: #[#reparse, #idempotence, #semantic_hash, #receipt]
 developer_journey: ?<scaffold, explain, diff, plan, apply, verify>[reg=pipeline]
 documentation: #[#first_migration_guide, #policy_reference, #decision_notes]
 law: "planning is pure, repeated application is a no-op, and forward-only migrations announce that property before authority is requested"
}

^["question_products"]{
 tokens: .{answers=#[#glyph, #gap, #operator_count], skips=#[#ast, #onf, #runtime]}
 structure: .{answers=#[#bound, #fixity, #span, #association], skips=#[#onf, #runtime]}
 index: .{answers=#[#reference, #selector, #workspace_relation], derives_from=#structure}
 semantic: .{answers=#[#onf, #semantic_hash], derives_from=#structure}
 trace: .{answers=#[#rule_path, #backtrack, #diagnostic_provenance], derives_from=#structure}
 rule: "a tool requests the smallest complete product and discloses escalation"
}

^["projection_handoff"]{
 pipeline: ?<semantic_html, atmospheric_css, invited_js>[reg=pipeline]
 html: #[#bytes, #nodes, #attributes, #semantic_completeness]
 css: #[#bytes, #selectors, #declarations, #paint_risk, #delivery_tier]
 js: #[#bytes, #parse_ms, #mount_ms, #listeners, #observers, #memory, #schedule]
 degrade: ?<js_interaction, css_atmosphere, preserve_html>[reg=pipeline]
 rule: "consumer profiles own limits; Seed exports semantics and cost hints, not web policy"
}

^["consumer_exchange"]{
 publishes: #[#capabilities, #product_schema, #migration_plan, #cost_receipt, #omissions]
 returns: #[#gap_report, #workload_shape, #missing_question, #consumer_revision, #workbench_revision]
 authority: #[#consumer_owns_canon, #workbench_owns_kernel, #no_automatic_upstream_write]
 zero_annotation_floor: #[#lex, #inspect, #format_preview, #package_audit, #compatibility_report]
 optional_annotation: .{may_improve=#[#recognizability, #navigation, #projection], may_not_gate=#baseline_utility}
 privacy: #[#identity_free_fixture, #relative_path, #mount_excluded]
}

^["invariants"]{
 #[
  "a.b.c and a . b . c have different association identities under syntax.gap-affinity/1",
  "event policy and product projection never change a requested semantic product",
  "formatting within one gap class is idempotent and association-preserving",
  "workspace-sensitive semantic defaults appear in the resolved profile and cache key",
  "source offsets remain traceable through every dialect gap projection",
  "an unregistered source path contributes zero formatting-policy authority",
 ]
}

^["falsify"]{
 probes: #[
  `lex a.b.c | a . b . c | a. b | a .b | a..b | .name | .{a:b}`,
  `parse each fixture under compatibility and syntax.gap-affinity/1`,
  `format twice and compare gap, association, and source identities`,
  `run one query under none, diagnostics, and trace event policies`,
  `census consumer-owned roots while excluding .spw/_workbench`,
 ]
 reject_if: #[
  #gap_class_does_not_predict_association,
  #format_not_idempotent,
  #event_policy_changes_semantics,
  #source_map_missing,
  #consumer_specific_grammar_required,
 ]
}

#>wonder_gap_affinity_artifact_1
?["Can a gap collapse without collapsing meaning?"]{
  $^["gap_algebra"]@here => $^["formatting_law"]@here
  !probe{ "collapse an open run from three spaces to one, then attempt open to tight; the first is formatting, the second is a semantic migration." }
  $%[gap.class, association.hash, differential.loss]
}

#>wonder_gap_affinity_artifact_2
?["Does a faster parser answer a smaller question or a different question?"]{
  $^["question_products"]@here => $^["profile_boundary"]@here
  !probe{ "compare completeness and identity across product requests; a different answer is a bug, an omitted product is disclosed thrift." }
  $%[product.kind, product.complete, product.elapsed_ms]
}
