^["intent"]{
 ~#goal: "Make token gaps and operator affinity explicit semantic products, make formatting preserve them, and let tools pay only for the parse products and instrumentation needed by a question."
 ~#taste: "recognizable syntax, deterministic profiles, progressive disclosure, reversible formatting, and measured speed"
}

