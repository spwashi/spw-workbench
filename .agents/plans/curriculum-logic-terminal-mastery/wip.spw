}

^["commits"]{
 ~[lab_terminal_tty]: "^seed[curriculum] — logic-terminal/01-terminal-tty.md plus a node-environment check, opening with Lab 1.01; covers TTY buffers and ANSI escapes; standard streams and POSIX pipelines; REPL evaluation loops; curses and blessed UI constraints; terminal-as-continuous-spatial-compiler reflection"
 ~[lab_prolog_unification]: "^seed[curriculum] — logic-terminal/02-prolog-unification.md plus its check; covers Horn clauses and facts; unification and substitution; resolution, backtracking, cut; homoiconicity; unification-vs-semantic-pattern-matching reflection"
 ~[lab_haskell_purity]: "^seed[curriculum] — logic-terminal/03-haskell-purity.md plus its check; covers purity and the IO monad; lazy evaluation and thunks; algebraic data types; typeclasses and parametric polymorphism; purity-to-valence (bone vs boon) reflection"
 ~[lab_graph_gql]: "^seed[curriculum] — logic-terminal/04-graph-gql.md plus its check; covers property graph model; Cypher and GQL pattern syntax; recursive traversal and transitive closure; subgraph projection and isomorphism; traversal-to-semantic-resonance reflection"
 ~[lab_cli_synthesis]: "^seed[curriculum] — logic-terminal/05-cli-synthesis.md plus a runHeadlessCli check; covers polyglot AST interface; piped AST streams in bash; AST graphs in raw TTY; conversational prompt design; CLI-as-metacognitive-collaborator reflection"
 ~[rosetta_stone_artifact]: ".[docs] — write the Rosetta-stone .spw artifact translating one problem into Prolog, Haskell, GQL, and Spw"
}

