# Mounted Consumer Tooling

#>spw_mounted_consumer_tooling
#:layer #!pragmatics

^["vocabulary"]{
 consumer_repository: "an independent repository whose site-owned .spw root mounts this workbench at .spw/_workbench"
 consumer_root: "the repository root discovered at invocation time; never serialized as a machine-local absolute path"
 consumer_canon: "site-owned .spw surfaces excluding mounted infrastructure"
 mounted_workbench: "versioned tooling and literature infrastructure below .spw/_workbench"
 fixture: "a generated, identity-free repository shape used to test the mount protocol"
 surface_archetype: "a reusable interaction, governance, or attention pattern with no domain identifier and no implied deployment destination"
}

^["authority"]{
 first: [#consumer_index, #consumer_workspace, #consumer_mount, #consumer_conventions, #consumer_claims]
 second: [#mounted_protocols, #mounted_parser, #mounted_cli, #mounted_lsp, #mounted_skills]
 excluded_from_consumer_scan: [".spw/_workbench/**"]
 output_owner: #consumer_repository
 upstream_gate: #explicit_human_selection
}

^["audit_axes"]{
 task: [#discover, #navigate, #diagnose, #query, #edit, #review]
 layer: [#seed, #lsp, #cli, #client_native, #client_projection]
 evidence: [#advertised, #configured, #invoked, #observed, #tested]
 failure: [#missing_mount, #stale_mount, #server_unavailable, #unsupported_capability, #degraded_fallback]
 utility: [#question_answered, #interruption_cost, #recovery_quality, #cross_consumer_repeatability]
}

^["provenance"]{
 required: [#consumer_revision, #workbench_revision, #review_profile, #commands, #capability_snapshot, #verdict]
 forbidden: [#machine_local_absolute_path, #specific_domain, #consumer_identifier, #private_corpus_copy]
 normalization: "record paths relative to consumer root or mounted workbench root"
}

^["plan_routes"]{
 cli: [#root_discovery, #doctor_json, #capabilities, #review_orchestration]
 lsp: [#initialize_truth, #standard_requests, #custom_requests, #failure_transport]
 vscode: [#thin_client, #mounted_startup, #custom_views, #performance]
 intellij: [#native_lsp, #textmate, #structure, #gutter, #optional_custom_bridge]
 neovim: [#syntax, #lsp_config, #commands, #quickfix, #minimal_client]
}

^["invariants"]{
 "Consumer identity is irrelevant to mount conformance.",
 "Surface ethos may remain as an archetype without preserving a domain or ownership claim.",
 "Capability claims require observable evidence and an owning layer.",
 "Editor differences remain visible; the audit does not manufacture parity.",
 "Consumer output stays consumer-owned until explicitly distilled upstream.",
}
