^["intent"]{
 ~#goal: "Describe and audit any repository mounting the workbench at .spw/_workbench without naming the consumer, recording its local path, or confusing mounted infrastructure with consumer authority."
 ~#taste: "clarity, layering, portability, truthfulness"
}

^["development"]{
 lane: #execution_truth
 ladder: #service
 develops: [#mount_portability, #capability_truth, #audit_evidence, #tooling_judgment]
 review_surfaces: [@cluster, @plan, @artifact, @mount, @cli, @tooling]
 snippet_routes: [#consumer_contract, #capability_matrix, #audit_probe, #provenance]
}

^["concept_index"]{
 primary: [#consumer_repository, #mounted_workbench, #authority, #capability, #evidence, #surface_archetype]
 surfaces: [#canon, #cli, #lsp, #vscode, #intellij, #neovim, #skills]
 tensions: [#path_leakage, #specific_domain, #named_fixture, #feature_parity, #semantic_duplication, #unverified_claim]
 transfers: [#language, #component, #service, #governance]
}

^["recursive_improvement"]{
 loop: [
  "? inspect one consumer-shaped fixture and current capability declarations",
  "< run one deterministic CLI, LSP, or editor probe",
  "$ write consumer-owned evidence with consumer and workbench revisions",
  "^ promote only repeated protocol findings into workbench plans or contracts",
  "% keep consumer identity, location, and private corpus outside workbench fixtures",
 ]
 gates: [#authority_boundary, #revision_provenance, #capability_evidence, #privacy]
}

^["parallel_work"]{
 critical_path: [#mount_vocabulary, #audit_contract]
 parallelizable: [#cli_plan, #lsp_plan, #vscode_plan, #intellij_plan, #neovim_plan, #skill_contract]
 shared_hot_files: [".spw/index.spw", ".spw/workspace.spw", ".agents/plans/plan-ecology-clustering/plan-ecology-clustering.spw"]
 merge_risks: [#terminology_drift, #plan_cache_drift, #capability_overclaim]
 handoff_artifacts: [@artifact, @tooling]
}

^["supporting_documents"]{
 must_ship: [@plan, @artifact, @mount, @tooling]
 helpful: [@cli, @cluster]
 carries: [#vocabulary, #authority_order, #evidence_schema, #audit_matrix, #plan_routes]
}

^["interaction_depth"]{
 subjects: [#orientation, #navigation, #diagnostics, #review, #failure_recovery]
 questions: [#what_is_authoritative, #what_is_advertised, #what_is_observed, #what_is_useful]
 qualities: [#clarity, #portability, #low_noise, #inspectability]
}

^["risk_model"]{
 hard_failures: [#mounted_root_scanned_as_consumer, #local_path_emitted]
 soft_failures: [#advertised_without_probe, #parity_without_task, #client_semantic_fork]
 recoveries: [#exclude_mount, #redact_location, #downgrade_claim, #route_to_shared_lsp]
 non_negotiables: [#consumer_owns_output, #two_revision_provenance, #no_named_fixture]
}

^["validation"]{
 hypotheses: [#one_fixture_shape_crosses_consumers, #capability_matrix_exposes_drift]
 negative_controls: [#ethos_preserved_without_identifier, #consumer_canon_not_copied]
 demo_path: [#discover, #resolve_mount, #inventory, #probe, #record, #distill]
}

^["stream"]{
 >>[2026-07-20 14:56] observe — mount documentation is mostly substrate-oriented, but active plans still name individual consumers and editor comparison claims no longer match the LSP-backed implementation.
 >>[2026-07-20 14:57] decide — use `consumer repository`, `consumer-owned .spw`, and `mounted workbench` as the portable vocabulary; identifiers and local locations are never fixture requirements.
 >>[2026-07-20 14:58] decide — audit editor surfaces by author task, protocol capability, observed evidence, failure behavior, and ownership layer rather than feature parity.
 >>[2026-07-20 14:59] taste — CLI observability is the prerequisite: root discovery, mount health, capabilities, and machine-readable evidence should make editor audits reproducible instead of anecdotal.
 >>[2026-07-20 15:00] revise — remove specific domains from active code and canon, not only mounted-review examples; preserve reusable qualities as identity-free surface archetypes whose future deployment remains unspecified.
}

