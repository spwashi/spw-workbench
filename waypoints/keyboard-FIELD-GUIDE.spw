# keyboard/FIELD-GUIDE — Keyboard Geology Orientation
#
# After commits 15–19. The keyboard is no longer a flat list.

^["geology model"]{
  #[strata]: "keybindings are geological layers, not a shortcut table"

  ^["layers"]{
    @features/keyboard/geology/        — ~"strata rendering + key capture"
    @features/keyboard/vim-motions.ts   — ~"operator-aware AST navigation"
    @features/keyboard/shortcuts.ts     — ~"discoverable modal shortcuts"
  }

  ^["interaction model"]{
    .[key-capture]: "dormant bindings displayed until activated"
    .[context-hints]: "bindings adapt to current editing context"
    .[navigable-topography]: "browse key layers like terrain"
    .[learnability]: "walkthrough introduces one stratum at a time"
  }
}

^["what changed since genesis"]{
  15-roadmap     — ~"seed extracted as portable module"
  16-onboarding  — ~"tour renderer + disclosure gate"
  17-refactor    — ~"BoonHonk: CSS namespacing (.spw-ui-*, .spw-viz-*)"
  18-ux          — ~"a11y: screen readers, container queries, RovingTabindex"
  19-keyboard    — ~"vim motions + geology panel + dotted modifier chains"
}

#[resonance]: "keys are instruments, not shortcuts"
