# Dependencies
#
# Module relationships.

^["dependencies"]{
  infra > []
  lib/spw > []
  design > [infra]
  ui > [infra, design]
  lang > [infra, lib/spw]
  viz > [infra, lang]
  runtime > [infra, lang]
  features > [infra, ui, viz]
  debug > [infra, runtime]
  cli > [infra, lang, runtime]
  app > [infra, design, ui, lang, viz, features, runtime]
  platform > [app, infra, design, ui, features]
}

^["portability"]{
  ../src/lib/spw^portable.
  ../src/runtime/interpreter^portable.

  ../src/viz^bound.
  ../src/design^bound.
  ../src/app^bound.
}

^["direction"]{
  timing!       # Top-down
  domains!

  lifecycle?    # Bottom-up
  events?
}

^["wrappers"]{
  lang ~ lib/spw    # lang wraps lib/spw with hooks
}
