# Cultural Anchors
#
#>spw_anchors
#:anchors

# ---- recognition pipeline ----
# Anchors are cultural precipitates. They begin as
# improvisation in the writers room and, through
# repetition and audience engagement, crystallize
# into recognizable identity.
#
# improvisation → repetition → recognition → anchor → merchandise
#
# Not every improvisation becomes an anchor.
# The showrunner declares anchors as they emerge.

^"recognition"{
 #[levels]{ "improvised", "recurring", "emerging", "established", "iconic" }
}

# ---- anchor registry ----
# Declare anchors as they precipitate from the
# writers room. Each anchor carries a recognition
# level and an optional merchandise readiness.

^"characters"{
  # ^"the-archivist"{
  #   @name: "The Archivist"
  #   =[recognition]: "emerging"
  #   =[introduced]: "01-opening"
  #   .[merchandise]{ eligible: false }
  # }
}

^"motifs"{
  # ^"spiral-glyph"{
  #   @name: "the spiral glyph"
  #   =[recognition]: "established"
  #   =[first_seen]: "01-opening"
  #   .[merchandise]{ eligible: true, targets: ["apparel", "enamel-pin"] }
  # }
}

^"phrases"{
  # ^"field-remembers"{
  #   @text: "the field remembers"
  #   =[recognition]: "emerging"
  #   =[source]: "writers-room"
  # }
}

# ---- merchandise categories ----
# Abstract targets: what an anchor could become,
# without specifying vendor or production details.
# These exist as architecture before they exist
# as products. When recognition reaches threshold,
# the target materializes.

^"merchandise"{
 #[print]{ "poster", "art-print", "zine" }
 #[apparel]{ "t-shirt", "hoodie", "hat" }
 #[object]{ "enamel-pin", "sticker", "figure", "mug" }
 #[digital]{ "wallpaper", "nft", "soundtrack" }
}
