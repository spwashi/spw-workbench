# Workspace
#
#>spw_workspace
#:workspace

^"roots"{
  @index: ~"./index.spw"
  @mount: ~"./mount.spw"
  @spw: ~"."
  @site: ~".."
  @content: ~"../content"
  @public: ~"../public"
  @assets: ~"../public/assets"
  @chapters: ~"../public/chapters"
  @places: ~"../public/places"
  @items: ~"../public/items"
  @artifacts: ~"../public/artifacts"
  @http: ~"../public/http"
  @http_get: ~"../public/http/get"
  @manifest: ~"../public/manifest.webmanifest"
  @offline: ~"../public/offline.html"
  @llms: ~"../public/llms.txt"
  @templates: ~"../public/fragments"
}

^"settings"{
  ~#language: "spw"
  ~#dialect: "v0.3.0"
  ~#site_kind: "installable-book"
  ~#preset: "installable-book"
}

^"lsp"{
  ~#roots: [~"./", ~"./index.spw", ~"./mount.spw", ~"../content", ~"../public", ~"../public/http/get"]
}
