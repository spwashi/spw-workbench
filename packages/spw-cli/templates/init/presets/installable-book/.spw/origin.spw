# Show Origin
#
#>spw_show_origin
#:origin

# ---- the seed ----
# Every show begins somewhere — a painting, an NFT,
# a phrase overheard, a feeling that won't dissolve.
# The origin is the condensation nucleus around which
# narrative, visual identity, and production rhythm
# crystallize.

^"seed"{
 =[type]: "concept"
 =[medium]: "text"
 @title: "Untitled Show"
 @premise: "A story that begins with an open book and a warm field line."
}

# ---- chromatic seed ----
# Visual identity derives from the origin.
# These values feed the season layer and substrate
# token overrides. When the origin is a painting or
# NFT, extract the palette from the artifact.
# When it is a concept, choose a palette that
# carries the affect.

^"palette"{
 @ground: "oklch(95% 0.02 80)"
 @figure: "oklch(99% 0.01 80)"
 @accent: "oklch(55% 0.15 45)"
 @ink: "oklch(25% 0.02 80)"
 @muted: "oklch(55% 0.02 80)"
 @line: "oklch(85% 0.02 80)"
}

# ---- provenance ----
# If the origin is a traceable artifact
# (NFT, published work, registered IP),
# declare its chain of custody here.
# This feeds the show's identity and can
# surface in metadata, credits, and
# merchandise attribution.

^"provenance"{
 =[chain]: "none"
 # =[chain]: "ethereum"
 # @contract: "0x..."
 # @token_id: 0
 # @image: ~"../public/assets/origin.png"
 # @creator: "artist-handle"
 # @minted: "2026-01-01"
}

# ---- affect ----
# The origin's emotional signature.
# Tradition names from the valence pentad:
#
#   boon  — growth, warmth, invitation
#   bane  — tension, danger, gravity
#   bone  — structure, neutrality, scaffolding
#   bonk  — surprise, disruption, error
#   honk  — delight, absurdity, play
#
# These are branding tradition, not functional
# constraints. They carry history and can inform
# season layer choices, but they don't enforce
# visual rules.

=[affect]: "bone"
