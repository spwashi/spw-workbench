{
  "site_kind": "installable-book",
  "pwa": {
    "manifest": "/manifest.webmanifest",
    "service_worker": "/sw.js",
    "offline_fallback": "/offline.html"
  },
  "route_families": {
    "chapters":  { "pattern": "/chapters/:slug/",     "lifecycle": "permanent"  },
    "places":    { "pattern": "/places/:slug/",        "lifecycle": "permanent"  },
    "items":     { "pattern": "/items/:slug/",         "lifecycle": "seasonal"   },
    "artifacts": { "pattern": "/artifacts/:slug.html", "lifecycle": "ephemeral"  },
    "seasons":   { "pattern": "/seasons/:number/",     "lifecycle": "archivable" }
  },
  "http_get": [
    "/http/get/site.json",
    "/http/get/show.json",
    "/http/get/routes.json",
    "/http/get/chapters.json",
    "/http/get/chapters/01-opening.json",
    "/http/get/places.json",
    "/http/get/items.json",
    "/http/get/artifacts.json"
  ],
  "agent_surfaces": [
    "/llms.txt",
    "/http/get/site.json",
    "/http/get/show.json"
  ]
}
