{
  "site_kind": "installable-book",
  "pwa": {
    "manifest": "/manifest.webmanifest",
    "service_worker": "/sw.js",
    "offline_fallback": "/offline.html"
  },
  "route_families": {
    "chapters": "/chapters/:chapter-slug/",
    "places": "/places/:place-slug/",
    "items": "/items/:item-slug/",
    "artifacts": "/artifacts/:artifact-slug.html"
  },
  "http_get": [
    "/http/get/site.json",
    "/http/get/book.json",
    "/http/get/routes.json",
    "/http/get/chapters.json",
    "/http/get/chapters/01-opening.json",
    "/http/get/places.json",
    "/http/get/items.json",
    "/http/get/artifacts.json"
  ],
  "agent_surfaces": [
    "/llms.txt",
    "/http/get/site.json"
  ]
}
