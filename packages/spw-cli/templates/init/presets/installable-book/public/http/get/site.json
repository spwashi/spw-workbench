{
  "site_kind": "installable-book",
  "rendering": "plain-html-with-progressive-enhancement",
  "css_architecture": {
    "layers": ["reset", "substrate", "structure", "region", "component", "season", "override"],
    "substrate_tokens": "/assets/substrate.css",
    "season_layer": "/assets/season.css"
  },
  "editing": {
    "preferred_mode": "edit-html-directly",
    "shared_fragments": [
      "/fragments/site-nav.html",
      "/fragments/site-footer.html"
    ],
    "editable_pages": [
      "/",
      "/chapters/",
      "/chapters/01-opening/",
      "/places/",
      "/items/",
      "/artifacts/"
    ]
  },
  "pwa": {
    "manifest": "/manifest.webmanifest",
    "service_worker": "/sw.js",
    "offline_fallback": "/offline.html",
    "cache_strategy": "network-first-for-pages, stale-while-revalidate-for-shell-assets"
  },
  "spw_surfaces": {
    "index": "/.spw/index.spw",
    "workspace": "/.spw/workspace.spw",
    "mount": "/.spw/mount.spw",
    "origin": "/.spw/origin.spw",
    "containers": "/.spw/containers.spw",
    "anchors": "/.spw/anchors.spw"
  },
  "agents": {
    "llms": "/llms.txt",
    "site_api": "/http/get/site.json",
    "show_api": "/http/get/show.json"
  }
}
