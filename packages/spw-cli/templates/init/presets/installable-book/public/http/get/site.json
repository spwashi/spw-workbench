{
  "site_kind": "installable-book",
  "rendering": "plain-html-with-progressive-enhancement",
  "editing": {
    "preferred_mode": "edit-html-directly",
    "shared_fragments": [
      "/fragments/site-nav.html",
      "/fragments/site-footer.html"
    ],
    "editable_pages": [
      "/",
      "/chapters/",
      "/chapters/01-opening/",
      "/places/",
      "/items/",
      "/artifacts/"
    ]
  },
  "pwa": {
    "manifest": "/manifest.webmanifest",
    "service_worker": "/sw.js",
    "offline_fallback": "/offline.html",
    "cache_strategy": "network-first-for-pages, stale-while-revalidate-for-shell-assets"
  },
  "agents": {
    "llms": "/llms.txt"
  }
}
