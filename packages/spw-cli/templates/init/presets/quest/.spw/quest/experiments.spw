# Experiments — syntax the workbench is still deciding
#
# Each entry cites the workbench's experimental catalog by id, so tools can
# tell an experiment from a mistake. Status is the catalog's: implemented,
# partial or proposed. Today is what the parser does with the form now.
# Try one, then put what you notice on a shelf.

#>quest_experiments
#:quest #!experiment
#:layer #!semantics

^["fixity_dual"]{
 cite = `=exp[id: fixity.prefix_postfix_dual]`
 status = "partial"
 try = `door~`
 today = "Expression=2 Identifier=1 Operation=1 Sequence=1: the mark does not bind to the word before it"
 proposal = "postfix as the dual of prefix: the word first, then the act discharges; door~! would read as !(~(door))"
}

^["sigma_chain"]{
 cite = `=exp[id: flow.sigma_chain]`
 status = "proposed"
 try = `<< ~ ; ? ; % ; ! ; * ; ^ >>`
 today = "Expression=7 Operation=6 Sequence=1 Stream=1: a stream of six bare marks, in order"
 proposal = "a thought passing through potential, wonder, measure, action, value and ascension, one step at a time"
}

^["crawl"]{
 cite = `=exp[id: crawl.verb_set]`
 status = "partial"
 try = `{sow}.{tend}.{harvest}`
 today = "Body=3 Expression=6 Identifier=3 Operation=2 Sequence=4: the dots between whole braces are real operations"
 proposal = "named crawl verbs for that walk: potentiate, accumulate, distribute, confluence, collate, discharge"
}

^["capture_shield"]{
 cite = `=exp[id: brace.capture_vs_shield]`
 status = "proposed"
 try = `door[closed]{hinge, key}<threshold>`
 today = "parses as one expression; nothing yet says whether the braces pull the parts in or wall them off"
 proposal = "a brace pair either captures (draws its parts in) or shields (a wall around a channel)"
}

^["yours"]{
 // Found a form the parser reads in a way you did not expect? Write it here with today's fingerprint, then ask.
}
