# Asks — what you want from the workbench
#
# When a tool could not do what you wanted, write it here. Every ask keeps
# the same slots in the same order, so asks from many repositories read side
# by side: rank, claim, exists, gap, measured, recommendation, replaces,
# probe, question. Leave a slot empty rather than guess. Send one ask, or
# the file, upstream as an issue at github.com/spwashi/spw-workbench.

#>quest_asks
#:quest #!ask
#:layer #!pragmatics

^["asks"]{
 postfix_binding: .{
  rank = 1
  claim = "A mark written after a word does not bind to it."
  exists = "Prefix binds: ~door is one operation on door."
  gap = "door~ parses as two neighbours, so a postfix reading cannot be checked, hovered or measured."
  measured = "spw fingerprint --expr 'door~' printed Expression=2 Identifier=1 Operation=1 Sequence=1"
  recommendation = "bind a postfix mark to the word before it and mark it postfix, as the fixity_dual experiment proposes"
  replaces = "writing the mark before the word when the thought arrives after it"
  probe = "npm --prefix .spw/_workbench run spw -- fingerprint --expr 'door~'"
  question = "Should door~! read as !(~(door))?"
 }[reg=facet]

 separator_projection: .{
  rank = 2
  claim = "A fingerprint cannot tell company from schedule."
  exists = "The parser keeps which mark sat between the parts."
  gap = "spw fingerprint counts nodes only, so door{hinge, frame, key} and door{hinge; frame; key} print the same projection."
  measured = "both printed Body=1 Expression=4 Identifier=4 Sequence=1"
  recommendation = "print the separators beside the node counts"
  replaces = "reading the source again to see which mark was written"
  probe = "npm --prefix .spw/_workbench run spw -- fingerprint --expr 'door{hinge; frame; key}' --json"
  question = "Should a projection name the separators, or only count them?"
 }[reg=facet]
}

^["yours"]{
 // Copy an ask above, give it a new name, and fill every slot you can.
}
