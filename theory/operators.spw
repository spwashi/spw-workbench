# Operators Canonical Reference
#
# Canonical "13 operators + 4 containers" map for current docs and UI tokens.

^"intent"{
  goal: "Keep symbolic semantics stable while runtime naming evolves",
  shape: "operator meaning + container roles + migration aliases",
  note: "Canonical names are language-facing; renderer aliases remain backward compatible.",
}

^"operators"{
  "~": "potential"
  "#": "vibration"
  ".": "ground"
  "?": "wonder"
  "!": "action"
  "*": "value"
  "&": "subject"
  "@": "perspective"
  "^": "ascension"
}

^"containers"{
  "<>": "concept"
  "()": "scene"
  "[]": "mode"
  "{}": "definition"
}

^"compositional_form"{
  "<concept>(scene)[mode]{body}": "primary layered authoring bundle",
  "flow": "concept -> scene -> mode -> definition",
  emphasis: "Prefer container stack for scoped semantics over ad-hoc prose markers.",
}

^"runtime_aliases"{
  purpose: "Bridge canonical semantics to existing UI/operator color token names",
  map: {
    action: "inject"
    perspective: "tap"
    potential: "wave"
    concept: "couple"
    wonder: "probe"
    ascension: "branch"
    subject: "bias"
    definition: "emit"
    vibration: "reflect"
  }
}

^"lsp_dap_prep"{
  lsp: "Use canonical names in diagnostics/hover text to reduce vocabulary drift.",
  dap: "Emit canonical operator labels in step events for stable debug narration.",
  sheaf: "Cache subset parses by container stack key: <>()[]{} + operator signature.",
}

^"notes"{
  "LoD should gate visibility of semantic layers, not globally dim most UI.",
  "Stage should modulate atmosphere and motion intensity, not core readability.",
  "Context panel should surface canonical operator labels when showing action packets.",
}
