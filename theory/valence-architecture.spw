# Valence Architecture
#
# The five-fold material lens for component gardening.
# Each valence is a plane of reality describing a unique spread of matter.
# Treat this doc as a root: all component .spw files link back here.

^["roots"]{
  @src: ~"../src"
  @core: ~"../src/core"
  @runtime: ~"../src/runtime"
  @components: ~"../src/app/components"
  @design: ~"../src/design"
  @timing: ~"../src/infra/timing"
  @publishing: ~"../src/publishing"
}

^["meta"]{
  @domain: design
  @kind: architecture
  @description: "Five-fold valence lens for component material development"
  @version: "0.1.0"
}

^["pentad"]{
  # The five valences are charge-neutral — they describe material quality,
  # not moral judgment. Like electron charge, each is a useful property.

  ~#boon{
    material: "generative, luminous"
    effect: "glow, expansion, warmth"
    charge: "positive but not merely 'success' — offering, creation, flow"
    css_var: "--quality-boon"
    quality_fn: @core/quality.ts::boon
    spread_character: "Each component's boon is its way of opening, welcoming, growing"
  }

  ~#bane{
    material: "constrained, stark, distilled"
    effect: "boundary, edge, reduction"
    charge: "negative but not merely 'failure' — useful constraint, orbital boundary"
    css_var: "--quality-bane"
    quality_fn: @core/quality.ts::bane
    spread_character: "Each component's bane is its way of tightening, focusing, distilling"
  }

  ~#bone{
    material: "structural, neutral"
    effect: "rest, foundation, grid"
    charge: "neutral — the ground state, skeleton, idle"
    css_var: "--quality-bone"
    quality_fn: @core/quality.ts::bone
    spread_character: "Each component's bone is its resting shape, its structural truth"
  }

  ~#bonk{
    material: "precipitative, catalytic"
    effect: "transform, ignition, phase-change"
    charge: "dynamic — exists only in Valence, not Quality (the fifth element)"
    css_var: "--quality-bonk"
    runtime: @runtime/state/types.ts::Valence
    spread_character: "Each component's bonk is its catalyst — the moment of shift"
  }

  ~#honk{
    material: "assertive, signal"
    effect: "pulse, ring, declaration"
    charge: "declarative — demands attention without judgment"
    css_var: "--quality-honk"
    quality_fn: @core/quality.ts::honk
    spread_character: "Each component's honk is its voice — what it says when it needs to be heard"
  }
}

^["colocation"]{
  ~#pattern: "Each component directory contains a valence/ subfolder with per-quality CSS"
  ~#structure{
    component_dir: "[component-name]/"
    component_spw: "[component-name].spw"
    valence_dir: "[component-name]/valence/"
    valence_files: ["boon.css", "bane.css", "bone.css", "bonk.css", "honk.css"]
  }
  ~#material_fingerprint: "The combination of all five valence materials
    across a component creates its material fingerprint — like a spectral signature.
    No two components should have identical fingerprints."
}

^["emergence"]{
  ~#boonhonk: "Not a declared genre. Emerges when boon and honk materials
    are populated per-component and genre blending oscillates between them.
    The coincidence IS the genre."
  ~#spread: "Each component's unique combination of five valence materials
    is its material fingerprint — like a spectral signature."
  ~#timing: "Phase-clustered updates (sync → rAF → idle) give the oscillation
    rhythm. The bbbh-pass provides bonk/honk overlays."
}

^["integration"]{
  ~#quality: @core/quality.ts
  ~#valence: @runtime/state/types.ts
  ~#bbbh_pass: @timing/bbbh-pass.ts
  ~#cascade: @design/themes/manager/cascade.ts
  ~#genre: @publishing/genre/types.ts
  ~#component_defs: @design/component-definitions.ts
  ~#valence_map: @components/_shared/valence-map.ts
}

^["principles"]{
  ~#charge_neutrality: "No valence is inherently good or bad.
    Bane is not failure — it is the useful constraint that gives form.
    Bonk is not destruction — it is the catalyst that enables change."
  ~#unique_spread: "Each component must develop its own material expression
    for each valence. Copy-pasting another component's boon.css
    defeats the purpose."
  ~#coincidence_over_declaration: "Genre-level concepts emerge from
    the consistent application of the lens, not from top-down naming."
}

^["shader_reading"]{
  # Under the navigation perspective, valence IS a shader system.
  # Each component's five valence files are fragment programs:
  #
  # boon.css → emission shader   (how it glows when generating)
  # bane.css → boundary shader   (how it constrains when limiting)
  # bone.css → structure shader  (how it rests in ground state)
  # bonk.css → transition shader (how it transforms between states)
  # honk.css → signal shader     (how it pulses when asserting)
  #
  # The genre blender is a compositor that mixes these shaders.
  # boonhonk emerges when emission + signal shaders overlap.

  ~<spirit>"./spirit-sequence.spw"
  ~<dom>"../src/runtime/docs/dom-semantics.spw"
}

^["wonder"]{
  ?["Is valence measurable?"]
    ~#answer: "Yes. %[component.boon] measures how much generative
      material a component has developed. A component with all 5
      valence CSS files populated has %[valence] → 1.0."

  ?["Can an agent navigate by valence?"]
    ~#answer: "Yes. An agent can sort components by %[component.valence]
      to find the most or least developed. Components with
      %[valence] < 0.2 are candidates for cultivation."

  ?["Is boonhonk a shader blend mode?"]
    ~#answer: "Structurally, yes. It's 'additive blending' of
      the emission (boon) and signal (honk) shaders.
      The genre system is a real-time compositor."

  ~<calculus>"./library/wonder-calculus.spw"
  ~<library>"./library/library.spw"
}
