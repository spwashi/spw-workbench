# Materials Science Ontology Prototype
#
# A proof-of-concept demonstrating Spw's utility as a rigorous academic notation 
# for physical sciences, mapping core MSE concepts to Spw operators and structures.

^"roots"{
  @here: ~"."
  @theory: ~".."
}

^"domain:crystallography"{
  # Lattices are modeled as sets of symmetrical basis vectors
  lattices: #[
    "simple_cubic"
    "body_centered_cubic" (bcc)
    "face_centered_cubic" (fcc)
    "hexagonal_close_packed" (hcp)
  ]

  # A crystal is a resonated (grounded) lattice structure
  # #crystal ≡ ?lattice (observation collapses potential to a specific structure)
  .{
    unit_cell = ?lattices.bcc
    basis = #[Fe, Fe]
  }[reg=crystal_structure]
}

^"domain:defects"{
  # Defects are the friction (bane) that give materials their strength (bone)
  
  # Point defects (0D)
  vacancies: ~atom        # A missing atom is a potential site
  interstitials: !atom    # An extra atom forced into the lattice

  # Line defects (1D)
  dislocations: .{
    edge   = `Extra half-plane of atoms`
    screw  = `Helical displacement offset`
    burger = `Vector denoting the distortion`
  }[reg=defect]

  # Planar defects (2D)
  grain_boundaries: &[grain_A, grain_B]  # Emergent property of two mismatched lattices meeting
}

^"domain:thermodynamics_and_phases"{
  # The complement operator (~) perfectly models latent heat and enthalpy
  
  # Melting: Solid + Heat -> Liquid
  melt: *#solid -> ~liquid  # The grounded solid absorbs potential (*) to become fluid (~)
  
  # Solidification / Nucleation
  crystallize: *~liquid -> #solid  # Fluid potential collapses into a grounded structure

  # Phase Diagrams / Eutectics
  # Alloying is not additive but emergent
  alloy: &[element_A, element_B]
  bronze: &[copper, tin]
}

^"domain:mechanics"{
  # Stress and Strain tensors represented as facets
  
  .{
    # Stress tensor (sigma)
    sigma_xx = 100
    sigma_yy = 0
    sigma_zz = 0
    tau_xy   = 25
  }[reg=stress_tensor]

  # Yield strength is a normalization threshold (%)
  yield_threshold: %stress > 0.002  # 0.2% offset yield
  
  # Fracture is the ultimate system bonk
  fracture: !bonk
}

^"domain:characterization"{
  # The meta-operator ($) models analytical techniques that measure the structure itself
  
  XRD: $(#crystal)     # X-Ray Diffraction measures the grounded lattice spacing
  SEM: $(grain_boundaries) # Scanning Electron Microscopy observes the emergent boundaries
  EDS: ?(alloy.composition) # Energy Dispersive Spectroscopy queries the atomic makeup
}
