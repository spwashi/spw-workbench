# Lens Walk Guide
#
# Prompting guide for stepping through dimensions.

^["roots"]{
  @docs: ~"."
  @src: ~"../src"
  @examples: ~"../examples"
}

^["intent"]{
  ~#goal: "Use the codebase as a blackboard instrument"
  ~#audience: "Computational linguistics enthusiasts and physical chemists"
  ~#tone: "Cognitively stimulating, philosophical bubble-breaker"
}

^["references"]{
  ~"./phasor.spw"
  ~"./semantics-physics.spw"
  ~"./onboarding-flow.spw"
}

^["loop"]{
  ~#sequence: "observe -> perturb -> compare -> reframe -> log"
  ~#rule: "Change one variable at a time"
  ~#output: "One paragraph per lens"
}

^["lenses"]{
  syntactic: "form, tokens, structure"
  semantic: "meaning, relations, constraints"
  pragmatic: "effect, runtime, output"
}

^["boards"]{
  !["Instrument boards"]

  ?["Tokens board"]{
    ~#lens: syntactic
    ~#anchor: @src/lib/spw/lexer/
    ~#view: @src/viz/tokens/
    ~#sample: @examples/basic/operators.spw
    ~#prompt: "What is the smallest change that flips token boundaries?"
    ~#break: "Assume whitespace binds; what breaks?"
  }

  ?["AST board"]{
    ~#lens: syntactic
    ~#anchor: @src/lib/spw/parser/
    ~#view: @src/viz/ast/
    ~#sample: @examples/basic/containers.spw
    ~#prompt: "Which container choices keep structure stable?"
    ~#break: "Swap one container type; how does the tree rewire?"
  }

  ?["Semantics board"]{
    ~#lens: semantic
    ~#anchor: @src/lang/semantic/
    ~#view: @src/viz/flow/
    ~#sample: @examples/patterns/data-flow.spw
    ~#prompt: "Which relations feel primary vs derived?"
    ~#break: "Erase a label; does meaning stay coherent?"
  }

  ?["Runtime board"]{
    ~#lens: pragmatic
    ~#anchor: @src/runtime/interpreter/
    ~#view: @src/viz/steps/
    ~#sample: @examples/test-suite/error-recovery.spw
    ~#prompt: "Where does execution decide to stop or continue?"
    ~#break: "Force an error; what still produces value?"
  }
}

^["tracks"]{
  ?["Computational linguistics"]{
    ~#focus: "form -> grammar -> meaning"
    ~#prompt-1: "Treat operators as grammatical markers; what is the minimal grammar that fits?"
    ~#prompt-2: "Map tokens to a small tagset; where does ambiguity persist?"
    ~#prompt-3: "Compare AST structure to dependency arcs; which relations are missing?"
  }

  ?["Physical chemistry"]{
    ~#focus: "state -> transition -> energy landscape"
    ~#prompt-1: "Treat containers as phases; what is the phase boundary?"
    ~#prompt-2: "Model modifiers as energy shifts; where does the system lower energy?"
    ~#prompt-3: "Track a reaction coordinate across lenses; where is the barrier?"
  }
}

^["card-template"]{
  ~#lens: "syntactic | semantic | pragmatic"
  ~#artifact: "tokens | ast | flow | runtime"
  ~#action: "transform | compare | invert"
  ~#question: "What assumption does this encoding make?"
  ~#counterexample: "How could it fail or mislead?"
  ~#reframe: "Describe it in the other track's language"
}

^["outputs"]{
  ~#log: "Record one contradiction and one stable invariant per session"
  ~#share: "Attach the seed file and the lens order you used"
}
