{
  "name": "spw-workbench",
  "private": true,
  "version": "0.2.0-alpha.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "analyze:patterns": "npm run audit:md",
    "analyze:perturb": "node --import tsx scripts/analyzers/perturbation-scan.ts",
    "audit": "node --import tsx scripts/analyzers/spw-marker-audit.ts",
    "audit:async": "node --import tsx scripts/analyzers/spw-marker-audit.ts --tag=async",
    "audit:context-panel": "node --import tsx scripts/analyzers/ui-contract-audit.ts --mode=context-panel",
    "audit:debt": "node --import tsx scripts/analyzers/spw-marker-audit.ts --tag=debt",
    "audit:json": "node --import tsx scripts/analyzers/spw-marker-audit.ts --format=json",
    "audit:md": "node --import tsx scripts/analyzers/spw-marker-audit.ts --format=md",
    "audit:spw-garden": "npm run lint:spw",
    "audit:types": "node --import tsx scripts/analyzers/spw-marker-audit.ts --tag=types",
    "audit:ui-selectors": "node --import tsx scripts/analyzers/ui-contract-audit.ts --mode=ui-selectors",
    "audit:ui-selectors:update": "node --import tsx scripts/analyzers/ui-contract-audit.ts --mode=ui-selectors --update",
    "build": "npx tsc -p tsconfig.json --noEmit",
    "spw": "node --import tsx scripts/spw.ts",
    "lsp": "node --import tsx scripts/lsp/stdio-upstream-bridge.ts",
    "lsp:smoke": "node --import tsx scripts/lsp/smoke-navigation.ts",
    "spw:format": "node --import tsx scripts/spw-format.ts .spw",
    "spw:format:check": "node --import tsx scripts/spw-format.ts .spw --check",
    "spw:format:equiv": "node --import tsx scripts/spw-format.ts .spw --mode equiv",
    "spw:reset": "bash scripts/spw-reset.sh --force",
    "spw:dev": "node --import tsx scripts/spw-dev.ts",
    "spw:mem:dump": "node --import tsx scripts/spw-mem.ts dump",
    "spw:mem:load": "node --import tsx scripts/spw-mem.ts load",
    "spw:mem:list": "node --import tsx scripts/spw-mem.ts list",
    "spw:mount": "node --import tsx scripts/spw-mount.ts check",
    "spw:mount:init": "node --import tsx scripts/spw-mount.ts init",
    "spw:ls": "node --import tsx scripts/spw-ls.ts",
    "spw:seq": "node --import tsx scripts/spw-seq.ts",
    "spwq": "node --import tsx scripts/spwq.ts",
    "bundle:docs": "bash scripts/release/bundle-docs.sh",
    "bundle:extensions": "bash scripts/release/bundle-extensions.sh",
    "bundle:release": "bash scripts/release/bundle-release.sh",
    "bundle:srcdist": "bash scripts/release/bundle-srcdist.sh",
    "fuzz": "npm run fuzz:stabilize",
    "fuzz:all": "npm run fuzz:types && npm run fuzz:runtime",
    "fuzz:async": "npm run test:runtime",
    "fuzz:boonhonk": "npm run test:runtime",
    "fuzz:complexity": "npm run audit:md",
    "fuzz:dead": "npm run audit:md",
    "fuzz:naming": "npm run audit:md",
    "fuzz:runtime": "npm run test:runtime",
    "fuzz:stabilize": "npm run test:runtime",
    "fuzz:types": "npx tsc -p tsconfig.json --noEmit",
    "lint": "npm run lint:spw && npm run lint:docs",
    "lint:changed": "npm run lint:spw",
    "lint:v020": "node --import tsx scripts/analyzers/v020-core-stub-check.ts",
    "lint:v020:architecture": "node --import tsx scripts/analyzers/v020-lib-architecture-check.ts",
    "lint:v020:runtime": "node --import tsx scripts/analyzers/v020-runtime-stub-check.ts && node --import tsx scripts/analyzers/runtime-filename-check.ts",
    "lint:spw": "node --import tsx scripts/analyzers/spw-syntax-validate.ts -- --exclude .agents",
    "lint:writerside": "node --import tsx scripts/analyzers/writerside-check.ts",
    "lint:docs": "node --import tsx scripts/analyzers/writerside-check.ts",
    "lint:docs:strict": "node --import tsx scripts/analyzers/spw-path-check.ts && node --import tsx scripts/analyzers/writerside-check.ts",
    "build:vscode": "cd extensions/vscode-spw && npm install && npm run compile",
    "build:intellij": "cd extensions/intellij-spw && ./gradlew buildPlugin",
    "build:extensions": "npm run build:vscode && npm run build:intellij",
    "test:run": "npm run test:runtime && npm run test:dom",
    "test:runtime": "vitest --config vitest.runtime.config.ts run",
    "test:dom": "vitest --config vitest.dom.config.ts run",
    "test:dom:watch": "vitest --config vitest.dom.config.ts"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
