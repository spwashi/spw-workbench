{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/spwashi/spw-workbench/main/schemas/spw-cli-envelope.v1.schema.json",
  "title": "Spw CLI Envelope",
  "description": "Version 1 wire envelope for structured Spw CLI output.",
  "type": "object",
  "required": [
    "$schema",
    "surface",
    "schemaVersion",
    "producer",
    "command",
    "timestamp",
    "ok",
    "data"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/spwashi/spw-workbench/main/schemas/spw-cli-envelope.v1.schema.json"
    },
    "surface": {
      "const": "spw.cli.envelope"
    },
    "schemaVersion": {
      "const": 1
    },
    "producer": {
      "$ref": "#/definitions/producer"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ok": {
      "type": "boolean"
    },
    "summary": {
      "type": "object"
    },
    "error": {
      "$ref": "#/definitions/error"
    },
    "data": true
  },
  "oneOf": [
    {
      "properties": {
        "ok": {
          "const": true
        }
      },
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "#/definitions/error"
        },
        "data": {
          "type": "null"
        }
      },
      "not": {
        "required": [
          "summary"
        ]
      }
    }
  ],
  "additionalProperties": false,
  "definitions": {
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "@spwashi/spw-cli"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
