# seed docs
#
# Map for src/seed/.

#:layer #!grammar

^["roots"]{
  @here: ~".."
}

^["inherit"]{
  .. ~"../../index.spw"
}

meta: .{
  domain    = `seed`
  initOrder = `-1`
  kind      = `stratum-map`
  note      = `Extractable core — zero workbench dependencies`
}[reg=facet]

purpose: .{
  role       = `The portable parser — can run anywhere without the workbench`
  invariant  = `Zero imports from any @/ path. Must work in browser, Node, and as standalone npm.`
  philosophy = `seed is the language itself. Everything else is tooling around it.`
}[reg=facet]

folder: .{
  path = `src/seed`
  docs = `./README.md`
}[reg=facet]

files: #[
  @here/index.ts
  @here/lexer.ts
  @here/parser.ts
  @here/grammar.ts
  @here/types.ts
  @here/normalize.ts
][reg=set]

folders: #[
  @here/canonical/
  @here/combinators/
  @here/docs/
  @here/grammar/
  @here/instrumentation/
  @here/lexer/
  @here/parser/
  @here/types/
  @here/__tests__/
][reg=set]

patterns: .{
  combinator-parser   = `Parser combinators in combinators/ — pure functions that compose. Each combinator handles one grammar rule.`
  lexer-tokenizer     = `lexer/ produces a flat token stream. 12 operator sigils, backtick strings, guillemets, holes.`
  grammar-definition  = `grammar/ defines containers (<>()[]{}), operators (!^~?*=@#.&$%), and modifiers (bone/boon/bane/bonk/honk).`
  golden-snapshots    = `__tests__/snapshots/phase-4-golden/ contains 5 canonical parse outputs. Changes here need explicit approval.`
  instrumentation     = `instrumentation/ provides debug/trace hooks that are no-ops in production. Zero-cost when not attached.`
}[reg=facet]

garden: .{
  is            = `A working 12-operator parser with Gen 3 syntax support`
  could_become  = `@spw/seed npm package — the shareable parser core`
  connects_to   = `lang/ wraps it with workbench hooks. runtime/ evaluates its output.`
  growth_risk   = `Accidentally importing workbench code. Losing portability.`
}[reg=facet]

valence: .{
  boon = `Complete portability — runs anywhere JavaScript runs`
  bane = `Cannot use any workbench convenience (state, timing, events)`
  bone = `Golden snapshots enforce parse stability across changes`
  bonk = `Grammar changes affect every downstream consumer`
  honk = `The combinator architecture makes adding new syntax compositional`
}[reg=quality]

?["What parse-time guarantee does this surface provide?"]
  #:scope #!file
  ~#probe: "trace references to this surface"

