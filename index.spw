# Spw Workbench (Rewrite Canon)

#:layer #!pragmatics

^seed[Spw.Workbench.Canon v:0.0.0 @profile:Spw.b]

^['roots']{
  @docs: ~'./docs'
  @docs_seed: ~'./docs/seed'
  @spec: ~'./lib/spw-v0.2.0-alpha'
  @seed: ~'./src/seed'
}

^['start']{
  .. @docs/toc.spw
}

?["How does this surface orient the developer's workflow?"]
  #:scope #!file
  ~#probe: "trace references to this surface"

