# Documentation Index
#
# Top-level map for docs/.

^["roots"]{
  @src:  ~"../src"
  @here: ~"."
}

^["inherit"]{
  .. ~"../index.spw"
}

^["files"]{
  !["Docs files"]
  .. ~"./toc.spw"                   # Table of contents (start here)
  .. ~"./architecture-map.md"
  .. ~"./architecture.spw"
  .. ~"./dependencies.spw"
  .. ~"./design-research.spw"
  .. ~"./directions.spw"
  .. ~"./domains.spw"
  .. ~"./feature-registry.spw"
  .. ~"./hud-runtime.spw"
  .. ~"./lens-walk.spw"
  .. ~"./onboarding.spw"
  .. ~"./onboarding-flow.spw"
  .. ~"./patterns.spw"
  .. ~"./phasor.spw"
  .. ~"./quality.spw"
  .. ~"./README.md"
  .. ~"./research.spw"
  .. ~"./lens-walk-research.spw"
  .. ~"./spec-alignment.spw"
  .. ~"./web-apis.spw"
}

^["folders"]{
  !["Docs folders"]
  .. ~"./contributing"
  .. ~"./design"
  .. ~"./lang"
}

^["src-indexes"]{
  !["Per-layer indexes"]
  .. @src/core/docs/index.spw
  .. @src/platform/docs/index.spw
  .. @src/app/docs/index.spw
  .. @src/infra/docs/index.spw
  .. @src/lang/docs/index.spw
  .. @src/lib/docs/index.spw
  .. @src/runtime/docs/index.spw
  .. @src/viz/docs/index.spw
  .. @src/ui/docs/index.spw
  .. @src/design/docs/index.spw
  .. @src/features/docs/index.spw
  .. @src/debug/docs/index.spw
  .. @src/cli/docs/index.spw
  .. @src/semantics/docs/index.spw
  .. @src/styles/docs/index.spw
}
