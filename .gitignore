dist/
/release/
.DS_Store
*.log

# Gradle/IDE build outputs
.gradle/
**/.gradle/
**/.intellijPlatform/
**/build/
extensions/vscode-spw/*.vsix
extensions/intellij-spw/gradle.properties

# tooling — claude code
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/
