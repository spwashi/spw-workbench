# captured tool/command output parked at the repo root
/.output.txt
/*.output.txt

# Accidental tsc declaration emit next to sources.
# Package tsconfigs use outDir under node_modules/.cache/tsbuild/*;
# colocated *.d.ts usually means a bare `tsc` ran without that project.
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
