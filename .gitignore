# IDE
.idea/
.vscode/

# .spw generated projections (runtime/build outputs; invent/map skip all of gen/)
.spw/gen/build/
.spw/gen/cache/
.spw/gen/lens/
.spw/gen/session/
.spw/gen/geometry/
