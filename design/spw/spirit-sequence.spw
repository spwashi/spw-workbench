# Spirit Sequence
#
# ?~<#.>@(#.)&[#.]*{#.}^ — a six-phase interpreter cycle.
# The programmable spirit of scripting automata.

^"source_files"{
  ~<operators>"../../src/runtime/interpreter/operators.ts"
  ~<register>"../../src/runtime/state/register-bank.ts"
  ~<affinities>"../../src/runtime/state/type-affinities.ts"
}

^"sequence"{
  raw: "?~<#.>@(#.)&[#.]*{#.}^"

  # Parse into six phases:
  phase_1: { tokens: "?~",      read: "probe into superposition"           }
  phase_2: { tokens: "<#.>",    read: "name the coupling (concept)"        }
  phase_3: { tokens: "@(#.)",   read: "observe the ground truth (capsule)" }
  phase_4: { tokens: "&[#.]",   read: "merge categorized truths (frame)"   }
  phase_5: { tokens: "*{#.}",   read: "materialize properties (scope)"     }
  phase_6: { tokens: "^",       read: "integrate upward"                   }
}

^"invariant"{
  # The kernel #. (resonance.ground) threads through every container type.
  # Same grounded truth, four different projections:

  '<#.>' { container: "<>", projection: "named — the coupling identifies it"     }
  '(#.)' { container: "()", projection: "scoped — observed from a perspective"   }
  '[#.]' { container: "[]", projection: "categorized — parts are enumerated"     }
  '{#.}' { container: "{}", projection: "propertied — structure is explicit"     }

  reads_as: "#. is the atom; containers are the lens"
}

^"automata"{
  # A naive interpreter walks this sequence per-node.
  # Each phase uses a different operator + container pair.

  cycle: [
    { phase: 1, operator: "?", container: "none", action: "probe — is there something here?"           }
    { phase: 2, operator: "~", container: "<>",   action: "defer — name the concept coupling"           }
    { phase: 3, operator: "@", container: "()",   action: "observe — push a perspective scope"          }
    { phase: 4, operator: "&", container: "[]",   action: "merge — combine with context frame"          }
    { phase: 5, operator: "*", container: "{}",   action: "value — collapse scope to concrete result"   }
    { phase: 6, operator: "^", container: "none", action: "integrate — bind upward to parent scope"     }
  ]

  loop: "phase 6 (^) feeds back into phase 1 (?) of the next cycle"
  termination: "when ? returns falsy — nothing more to process"
}

^"projections"{
  # Each container form is a different view of the same data.
  # The spirit sequence visits all four projections per cycle.

  photonics: {
    '?': "measurement",    '~': "wavefunction",  '@': "observer",
    '&': "entanglement",   '*': "collapse",       '^': "emission"
  }

  cognition: {
    '?': "inquiry",        '~': "possibility",   '@': "perspective",
    '&': "synthesis",      '*': "knowledge",      '^': "insight"
  }

  gardening: {
    '?': "survey",         '~': "seed",          '@': "tend",
    '&': "graft",          '*': "harvest",        '^': "compost"
  }
}

^"implementation"{
  # The spirit sequence maps to existing runtime functions:

  '?~'    { fn: "applyWonder → applyPotential", creates: "deferred probe"           }
  '<#.>'  { fn: "applyExchange(resonate, access)", creates: "concept-coupled ground" }
  '@(#.)' { fn: "applyPerspective(observe)", creates: "sheaf section"               }
  '&[#.]' { fn: "applyConfluence(confluent)", creates: "merged frame"               }
  '*{#.}' { fn: "applyValue(access)", creates: "collapsed scope"                    }
  '^'     { fn: "applyIntegration", creates: "parent binding"                       }
}

^"notes"{
  "The spirit sequence is a spec, not just research.",
  "Naive interpreters can iterate Spw scripts by walking this cycle.",
  "Advanced interpreters may skip phases or run them in parallel.",
  "The #. kernel ensures type safety: every projection has a ground truth.",
  "Operator repetition (##, .., @@) increases depth within a phase.",
  "The sequence reads left-to-right as objective→subjective flow.",
}
