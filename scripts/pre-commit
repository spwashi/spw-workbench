#!/usr/bin/env bash
# ─── Human-in-the-Loop Pre-Commit Gate ───────────────────────────────────────
#
# BLOCKS commits until the human authorizes via Touch ID.
# Agents write the commit messages; humans sign off biometrically.
#
# Authorization methods:
#   1. Touch ID prompt (primary — works for both agent and interactive commits)
#   2. Interactive y/N fallback (if Touch ID is unavailable)
#   3. Skip all checks: git commit --no-verify
#
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Remove:  rm .git/hooks/pre-commit

# ── Config ───────────────────────────────────────────────────────────────────

# ── Agent Identification ─────────────────────────────────────────────────────

detect_agent() {
  if [ -n "${SPW_AGENT:-}" ]; then
    echo "$SPW_AGENT"
  elif [ -n "${CLAUDE_SESSION_ID:-}" ] || [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    echo "claude"
  elif [ -n "${GEMINI_SESSION_ID:-}" ] || [ -n "${GOOGLE_API_KEY:-}" ]; then
    echo "gemini"
  elif [ -n "${GITHUB_COPILOT:-}" ]; then
    echo "copilot"
  elif [ -n "${ANTIGRAVITY_SESSION:-}" ]; then
    echo "antigravity"
  else
    echo "human"
  fi
}

AGENT=$(detect_agent)

# ── Staged File Collection ───────────────────────────────────────────────────

STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -z "$STAGED_ALL" ]; then
  exit 0
fi

TOTAL=$(echo "$STAGED_ALL" | wc -l | tr -d ' ')

# ── Helper ───────────────────────────────────────────────────────────────────

cgrep() {
  local content="$1" pattern="$2" n
  n=$(printf '%s\n' "$content" | grep -c "$pattern" 2>/dev/null) || n=0
  echo "$n"
}

# ── Run Checks ───────────────────────────────────────────────────────────────

WARNINGS=0
ERRORS=0
REPORT=""

# --- Layer boundary violations (TS/JS) ---
ts_files=$(echo "$STAGED_ALL" | grep -E '\.(ts|tsx|js|jsx)$' || true)
if [ -n "$ts_files" ]; then
  for f in $ts_files; do
    content=$(git show ":$f" 2>/dev/null || true)
    [ -z "$content" ] && continue
    if echo "$f" | grep -q 'lib/spw/'; then
      bad=$(cgrep "$content" "from '@/")
      if [ "$bad" -gt 0 ]; then
        REPORT="${REPORT}  ⛔ ${f} — lib/spw imports from @/ (${bad}×)\n"
        ERRORS=$((ERRORS + bad))
      fi
    fi
  done
fi

# --- Spw syntax generation (*.spw) ---
# .agents/ files (plans, schemas, wip) use ~# deliberately — exempt from Gen 2 checks
spw_files=$(echo "$STAGED_ALL" | grep '\.spw$' | grep -v '__tests__/snapshots/' || true)
agent_spw=$(echo "$spw_files" | grep '\.agents/' || true)
strata_spw=$(echo "$spw_files" | grep -v '\.agents/' || true)

# Agent planning files — report without syntax generation warnings
if [ -n "$agent_spw" ]; then
  ac=$(echo "$agent_spw" | sed '/^$/d' | wc -l | tr -d ' ')
  REPORT="${REPORT}  ── .agents plans ($ac) ──\n"
  for f in $agent_spw; do
    content=$(git show ":$f" 2>/dev/null || true)
    [ -z "$content" ] && continue
    hs=$(cgrep "$content" '^\^');   hc=$(cgrep "$content" '^#')
    hw=$(cgrep "$content" '^>>');   ho=$(cgrep "$content" '^?')
    REPORT="${REPORT}  ✓  ${f} (sections:${hs} stream:${hw} open:${ho})\n"
  done
fi

# Strata .spw files — full syntax generation audit
if [ -n "$strata_spw" ]; then
  sc=$(echo "$strata_spw" | sed '/^$/d' | wc -l | tr -d ' ')
  REPORT="${REPORT}  ── .spw ($sc) ──\n"
  for f in $strata_spw; do
    content=$(git show ":$f" 2>/dev/null || true)
    [ -z "$content" ] && continue
    fw=""
    g1=$(cgrep "$content" '^\^"');        [ "$g1" -gt 0 ] && fw="${fw}    ⚠  Gen 1: ${g1}× ^\"\n" && WARNINGS=$((WARNINGS+g1))
    gm=$(cgrep "$content" '@domain:');    [ "$gm" -gt 0 ] && fw="${fw}    ○  Gen 2 meta: ${gm}× @domain:\n" && WARNINGS=$((WARNINGS+gm))
    gv=$(cgrep "$content" '~#');          [ "$gv" -gt 0 ] && fw="${fw}    ○  Gen 2 valence: ${gv}× ~#\n" && WARNINGS=$((WARNINGS+gv))
    if [ -n "$fw" ]; then
      REPORT="${REPORT}  📄 ${f}\n${fw}"
    else
      hf=$(cgrep "$content" '\. *{'); hs=$(cgrep "$content" '#\[')
      hb=$(cgrep "$content" ' = ');  hr=$(cgrep "$content" '\[reg=')
      g3=""
      [ "$hf" -gt 0 ] || [ "$hs" -gt 0 ] && g3=" (.{}×${hf} #[]×${hs} =×${hb} [reg=]×${hr})"
      REPORT="${REPORT}  ✓  ${f}${g3}\n"
    fi
  done
fi

# --- Golden snapshot protection ---
golden=$(echo "$STAGED_ALL" | grep '__tests__/snapshots/' || true)
if [ -n "$golden" ]; then
  gc=$(echo "$golden" | wc -l | tr -d ' ')
  REPORT="${REPORT}  ⚠  Golden snapshots modified: ${gc} file(s)\n"
  WARNINGS=$((WARNINGS + gc))
fi

# --- Pluggable checks ---
CHECKS_DIR="$(git rev-parse --git-dir)/hooks/checks.d"
if [ -d "$CHECKS_DIR" ]; then
  for cs in "$CHECKS_DIR"/*.sh; do
    [ -f "$cs" ] || continue
    mn=$(basename "$cs" .sh)
    mo=$(STAGED_ALL="$STAGED_ALL" AGENT="$AGENT" bash "$cs" 2>&1) || true
    [ -n "$mo" ] && REPORT="${REPORT}  ── ${mn} ──\n${mo}\n"
  done
fi

# ── Display Report ───────────────────────────────────────────────────────────

echo ""
echo "┌──────────────────────────────────────────────────────┐"
echo "│  Pre-Commit Gate  [$TOTAL file(s)]  agent=$AGENT     │"
echo "└──────────────────────────────────────────────────────┘"
echo ""
printf '%b' "$REPORT"

if [ "$ERRORS" -gt 0 ]; then
  echo ""
  echo "  ⛔ $ERRORS error(s) found."
fi
if [ "$WARNINGS" -gt 0 ]; then
  echo "  ⚠  $WARNINGS warning(s) found."
fi
echo ""

# ── Authorization Gate (Touch ID) ────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
TOUCHID_HELPER="$SCRIPT_DIR/scripts/touchid-authorize.swift"

if [ -f "$TOUCHID_HELPER" ]; then
  echo "  🔐 Touch ID authorization required..."
  swift "$TOUCHID_HELPER" "Authorize git commit ($TOTAL files, agent=$AGENT)"
  AUTH_RESULT=$?

  if [ "$AUTH_RESULT" -eq 0 ]; then
    echo "  ✓ Authorized via Touch ID."
    echo ""
    exit 0
  elif [ "$AUTH_RESULT" -eq 2 ]; then
    echo "  ⚠  Touch ID unavailable, falling back to interactive prompt."
    # Fall through to interactive prompt below
  else
    echo ""
    echo "  ✗ Commit denied."
    echo ""
    exit 1
  fi
fi

# Fallback: interactive y/N prompt (only reached if Touch ID is unavailable)
if [ ! -t 0 ]; then
  echo "  ⛔ Non-interactive terminal and Touch ID unavailable."
  echo "     Cannot authorize this commit."
  echo ""
  echo "     Options:"
  echo "       git commit --no-verify                # Skip all hooks"
  echo ""
  exit 1
fi

echo "  Authorize this commit? [y/N] "
read -r REPLY < /dev/tty
case "$REPLY" in
  y|Y|yes|YES)
    echo ""
    echo "  ✓ Authorized."
    echo ""
    exit 0
    ;;
  *)
    echo ""
    echo "  ✗ Commit aborted by user."
    echo ""
    exit 1
    ;;
esac
