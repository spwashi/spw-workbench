#!/usr/bin/env bash
# ─── Human-in-the-Loop Pre-Commit Gate ───────────────────────────────────────
#
# BLOCKS commits until the human authorizes via Touch ID.
# Agents write the commit messages; humans sign off biometrically.
#
# Authorization methods:
#   1. Touch ID prompt (primary — works for both agent and interactive commits)
#   2. Interactive y/N fallback (if Touch ID is unavailable)
#   3. Skip all checks: git commit --no-verify
#
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Remove:  rm .git/hooks/pre-commit

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$HOOK_DIR")" = "hooks" ]; then
  REPO_ROOT="$(cd "$HOOK_DIR/../.." && pwd)"
else
  REPO_ROOT="$(cd "$HOOK_DIR/.." && pwd)"
fi

# shellcheck source=/dev/null
source "$REPO_ROOT/scripts/commit-review/run-review.sh"
# shellcheck source=/dev/null
source "$REPO_ROOT/scripts/commit-review/render-review.sh"
# shellcheck source=/dev/null
source "$REPO_ROOT/scripts/commit-review/authorize-commit.sh"

spw_commit_review_run

AGENT="$REVIEW_AGENT"
TOTAL="$REVIEW_TOTAL"
WARNINGS="$REVIEW_WARNINGS"
ERRORS="$REVIEW_ERRORS"
REPORT="$REVIEW_REPORT"

if [ "$TOTAL" -eq 0 ]; then
  exit 0
fi

spw_render_commit_review

if [ "$ERRORS" -gt 0 ]; then
  echo "  Commit blocked until the reported errors are fixed."
  echo ""
  exit 1
fi

spw_authorize_commit "$REPO_ROOT" "Authorize git commit ($TOTAL files, $WARNINGS warnings, agent=$AGENT)"
