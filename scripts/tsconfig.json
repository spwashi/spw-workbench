{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "incremental": true,
    "outDir": "../node_modules/.cache/tsbuild/scripts",
    "tsBuildInfoFile": "../node_modules/.cache/tsbuildinfo/scripts.tsbuildinfo"
  },
  "include": [
    "**/*.ts"
  ],
  "references": [
    {
      "path": "../packages/spw-seed"
    },
    {
      "path": "../packages/spw-runtime"
    },
    {
      "path": "../packages/spw-cli"
    },
    {
      "path": "../packages/spw-lsp"
    }
  ]
}
