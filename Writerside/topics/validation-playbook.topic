<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic
        SYSTEM "https://resources.jetbrains.com/writerside/1.0/xhtml-entities.dtd">
<topic xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd"
       title="Validation Playbook" id="validation-playbook">
    <p>This playbook defines the standard verification sequence before staging and committing changes in the canon repo.</p>

    <tabs>
        <tab title="Fast loop (canon)">
            <code-block lang="bash">npm run lint:spw
npm run lint:writerside
npm run lint:docs</code-block>
        </tab>
        <tab title="Strict refs (when applicable)">
            <code-block lang="bash">npm run lint:docs:strict</code-block>
        </tab>
        <tab title="Syntax generations (optional)">
            <code-block lang="bash">bash .agents/skills/spw-commit-review/scripts/spw-syntax-audit.sh</code-block>
        </tab>
    </tabs>

    <procedure title="Run a complete local validation pass" id="run-complete-local-validation-pass">
        <step>
            <p>Run Spw parser validation and Writerside integrity:</p>
            <code-block lang="bash">npm run lint:spw
npm run lint:writerside</code-block>
        </step>
        <step>
            <p>Run canon docs check:</p>
            <code-block lang="bash">npm run lint:docs</code-block>
        </step>
        <step>
            <p>Optional: run strict reference integrity if you are touching `.spw` references across broader workbench surfaces:</p>
            <code-block lang="bash">npm run lint:docs:strict</code-block>
        </step>
        <step>
            <p>Review changed paths and ensure they match your stated intent:</p>
            <code-block lang="bash">git status --short
git diff --name-only</code-block>
        </step>
    </procedure>

    <p>Use this sequence as the default gate for docs, kernel, spec, and tooling changes.</p>

