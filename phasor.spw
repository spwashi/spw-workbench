# Phasor Model
#
# Interpretive layers as phase angles.
# @see ../src/core/layers/

^["phasor"]{
  #metaphor: "Same phenomenon, different phase angles"
  #origin: "ECE phasors: V = |V|e^(jθ)"

  syntactic.    # Structure, grammar, tokens
  semantic.     # Meaning, types, relations
  pragmatic.    # Use, context, effects
}

^["rotation"]{
  # Keyboard: Ctrl+1, Ctrl+2, Ctrl+3
  # Tab cycles views within layer

  ?[Ctrl+1]{ @syntactic }
  ?[Ctrl+2]{ @semantic }
  ?[Ctrl+3]{ @pragmatic }
}

^["views"]{
  syntactic: [tokens, ast, grammar]
  semantic: [types, flow, relations]
  pragmatic: [runtime, effects, output]
}

^["metaphor"]{
  # Like looking at same circuit:
  # - Time domain (syntactic)
  # - Frequency domain (semantic)
  # - Power analysis (pragmatic)

  # Rotate perspective, same content
}
